@model BOS_ERP.Models.Factura
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 10px;
            color: #1a1a1a;
            line-height: 1.3;
            margin: 0;
            padding: 0;
        }

        .header-container {
            width: 100%;
            border-bottom: 3px solid #d32f2f;
            padding-bottom: 10px;
            margin-bottom: 5px;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .logo-cell {
            width: 20%;
            vertical-align: top;
            padding-right: 10px;
        }

            .logo-cell img {
                width: 120px;
                max-height: 90px;
                display: block;
            }

        .emisor-cell {
            width: 50%;
            vertical-align: top;
            padding: 0 10px;
            border-left: 2px solid #e0e0e0;
            border-right: 2px solid #e0e0e0;
        }

        .factura-cell {
            width: 30%;
            vertical-align: top;
            text-align: right;
            padding-left: 10px;
        }

        .header-title {
            font-size: 16px;
            font-weight: bold;
            color: #d32f2f;
            margin: 0 0 6px 0;
            text-transform: uppercase;
        }

        .factura-title {
            font-size: 16px;
            font-weight: bold;
            color: #1976d2;
            margin: 0 0 6px 0;
        }

        .emisor-info {
            font-size: 9px;
            line-height: 1.5;
        }

            .emisor-info div {
                margin: 2px 0;
            }

            .emisor-info strong {
                color: #1976d2;
                font-weight: bold;
            }

        .factura-info {
            font-size: 9px;
            line-height: 1.5;
        }

            .factura-info div {
                margin: 2px 0;
            }

            .factura-info strong {
                color: #333;
                font-weight: bold;
            }
    </style>
</head>
<body>
    <div class="header-container">
        <table class="header-table">
            <tr>
                <!-- Logo -->
                <td class="logo-cell">
                    <img src="@Url.Content("~/content/img/logo.png")" alt="Logo Empresa" />
                </td>

                <!-- Información del Emisor -->
                <td class="emisor-cell">
                    <div class="header-title">Factura de Arrendamiento</div>
                    <div class="emisor-info">
                        <div><strong>RFC:</strong> @Model.RfcEmisor</div>
                        <div><strong>Razón Social:</strong> @Model.RsoEmisor</div>
                        <div><strong>Régimen Fiscal:</strong> @Model.Rege -- @Model.regimenEText</div>
                        <div><strong>Dirección Fiscal:</strong> @Model.CpR</div>
                    </div>
                </td>

                <!-- Datos de la Factura -->
                <td class="factura-cell">
                    <div class="factura-title">Factura CFDI 4.0</div>
                    <div class="factura-info">
                        <div><strong>Folio Fiscal:</strong> @Model.UUID</div>
                        <div><strong>Fecha:</strong> @Model.Fecha</div>
                        <div><strong>Tipo:</strong> @Model.TipoDeComprobante</div>
                        <div><strong>Timbrado:</strong> @Model.FechaTimbrado</div>
                        <div><strong>Serie:</strong> @Model.Serie</div>
                        <div><strong>Folio:</strong> @Model.Folio</div>
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>