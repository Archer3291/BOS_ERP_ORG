@model LoginViewModel
@{
    ViewBag.Title = "Iniciar Sesión";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>Iniciar Sesión — BOS ERP</title>
    <link rel="shortcut icon" href="~/content/img/logo.png" />
    <link href="~/content/fontawesome-pro-6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;400;500;600&display=swap" />
    <link href="~/css/login.css" rel="stylesheet" />
</head>

<body>
    <canvas id="canvas-bg"></canvas>
    <div class="page-wrapper">
        <div class="auth-card">
            <div class="panel-brand">
                <div class="brand-divider"></div>
                <div class="logo-stage">
                    <div class="ring ring-1"></div>
                    <div class="ring ring-2"></div>
                    <div class="ring ring-3"></div>
                    <img class="brand-logo" src="~/content/img/intro_erp.png" alt="BOS ERP — Business Operation System" />
                </div>
            </div>

            <div class="panel-form">
                <div class="form-eyebrow">Bienvenido</div>
                <div class="form-heading">Iniciar sesión</div>
                <div class="form-subheading">Accede a tu cuenta corporativa de BOS ERP</div>

                <form asp-action="Login" asp-controller="Account" method="post" role="form" autocomplete="off">
                    <div class="col">
                        <span class="text-red fs-3 text-nowrap">@Html.ValidationMessage("LoginError")</span>
                    </div>
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors">
                    </div>
                    <div class="field-group">
                        <label asp-for="NombreUsuario"></label>
                        <div class="field-inner">
                            <i class="fa-solid fa-user field-icon"></i>
                            <input asp-for="NombreUsuario" id="NombreUsuario" placeholder="Ingresa tu usuario" autocomplete="username" />
                        </div>
                        <span asp-validation-for="NombreUsuario" class="field-validation-error"></span>
                    </div>

                    <div class="field-group">
                        <label asp-for="Contrasena"></label>
                        <div class="field-inner">
                            <i class="fa-solid fa-lock field-icon"></i>
                            <input asp-for="Contrasena" type="password" id="Contrasena" placeholder="••••••••" autocomplete="current-password" />
                            <button type="button" class="toggle-pass" id="toggle-pass-btn" aria-label="Mostrar u ocultar contraseña">
                                <i class="fa-solid fa-eye" id="toggle-pass-icon"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Contrasena" class="field-validation-error"></span>
                    </div>

                    <button type="submit" class="btn-login">
                        <i class="fa-solid fa-right-to-bracket"></i> Iniciar sesión
                    </button>

                    <div class="form-links">
                        <a href="#!">¿Olvidaste tu contraseña?</a>

                        <a asp-action="Register" asp-controller="Register" class="link-register"> Regístrate aquí </a>
                    </div>
                </form>
            </div>

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/bundles/jqueryval"></script>
    <script src="~/js/login.js"></script>
</body>
</html>
