@model List<BOS_ERP.Models.SettingsManagement>

@{
    ViewBag.Title = "Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .sf-wrapper {
        padding: 2rem 1.5rem;
        background: var(--bg-gray);
        min-height: 100%;
    }

    .sf-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 2rem;
    }

    .sf-header-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        background: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        flex-shrink: 0;
    }

        .sf-header-icon svg {
            width: 20px;
            height: 20px;
        }

    .sf-header-text h2 {
        margin: 0;
        font-size: 18px;
        font-weight: 600;
        color: var(--text-dark);
        line-height: 1.2;
    }

    .sf-header-text p {
        margin: 2px 0 0;
        font-size: 13px;
        color: var(--text-light);
    }

    .sf-card {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .sf-section-label {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--text-light);
        padding: 1.1rem 1.5rem 0.6rem;
        border-bottom: 1px solid var(--border-light);
        background: var(--bg-gray);
    }

    .sf-field {
        display: grid;
        grid-template-columns: 1fr 2fr;
        align-items: center;
        gap: 1rem;
        padding: 1rem 1.5rem;
        border-bottom: 1px solid var(--border-light);
        transition: background var(--transition-fast);
    }

        .sf-field:last-of-type {
            border-bottom: none;
        }

        .sf-field:hover {
            background: var(--very-light-blue);
        }

    .sf-label {
        font-size: 13.5px;
        font-weight: 500;
        color: var(--text-dark);
    }

    .sf-input {
        width: 100%;
        box-sizing: border-box;
        padding: 8px 12px;
        font-size: 14px;
        color: var(--text-dark);
        background: var(--bg-light);
        border: 1.5px solid var(--border-light);
        border-radius: 8px;
        outline: none;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

        .sf-input:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
        }

        .sf-input:hover:not(:focus) {
            border-color: var(--secondary-blue);
        }

    .sf-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 1.1rem 1.5rem;
        background: var(--bg-gray);
        border-top: 1px solid var(--border-light);
    }

    .sf-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 20px;
        font-size: 14px;
        font-weight: 500;
        border-radius: 8px;
        cursor: pointer;
        border: none;
        transition: background var(--transition-fast), transform var(--transition-fast);
        text-decoration: none;
    }

    .sf-btn-ghost {
        background: transparent;
        color: var(--text-light);
        border: 1.5px solid var(--border-light);
    }

        .sf-btn-ghost:hover {
            background: var(--light-blue);
            color: var(--text-dark);
        }

    .sf-btn-primary {
        background: var(--primary-blue);
        color: #fff;
    }

        .sf-btn-primary:hover {
            background: var(--primary-blue-dark);
            transform: translateY(-1px);
        }

        .sf-btn-primary:active {
            transform: none;
        }
    /* Badges de tipo */
    .sf-badge {
        display: inline-block;
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        padding: 2px 7px;
        border-radius: 20px;
        margin-left: 6px;
        vertical-align: middle;
    }

    .sf-badge-text {
        background: #e1e7ef;
        color: #475569;
    }

    .sf-badge-number {
        background: #dbeafe;
        color: #1e40af;
    }

    .sf-badge-password {
        background: #fce7f3;
        color: #9d174d;
    }

    .sf-badge-checkbox {
        background: #d1fae5;
        color: #065f46;
    }

    /* Password con ojo */
    .sf-input-password-wrap {
        position: relative;
        width: 100%;
    }

        .sf-input-password-wrap .sf-input {
            padding-right: 40px;
            font-family: monospace;
            letter-spacing: .1em;
        }

    .sf-eye {
        position: absolute;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        background: none;
        border: none;
        cursor: pointer;
        color: var(--text-light);
        padding: 2px;
        display: flex;
        align-items: center;
        transition: color var(--transition-fast);
    }

        .sf-eye:hover {
            color: var(--text-dark);
        }

        .sf-eye svg {
            width: 17px;
            height: 17px;
        }

    /* Toggle switch */
    .sf-toggle-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .sf-toggle {
        position: relative;
        width: 44px;
        height: 24px;
        flex-shrink: 0;
    }

        .sf-toggle input {
            opacity: 0;
            width: 0;
            height: 0;
            position: absolute;
        }

    .sf-track {
        display: block;
        width: 44px;
        height: 24px;
        background: var(--border-light);
        border-radius: 12px;
        cursor: pointer;
        transition: background var(--transition-med);
    }

    .sf-toggle input:checked + .sf-track {
        background: var(--accent-blue);
    }

    .sf-thumb {
        position: absolute;
        top: 3px;
        left: 3px;
        width: 18px;
        height: 18px;
        background: #fff;
        border-radius: 50%;
        box-shadow: 0 1px 3px rgba(0,0,0,.2);
        transition: transform var(--transition-med);
        pointer-events: none;
    }

    .sf-toggle input:checked ~ .sf-thumb {
        transform: translateX(20px);
    }

    .sf-toggle-label {
        font-size: 13px;
        color: var(--text-light);
    }
</style>

<section class="sf-wrapper">
    <div class="sf-header">
        <div class="sf-header-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 20a8 8 0 1 0 0-16 8 8 0 0 0 0 16z" />
                <path d="M12 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z" />
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
            </svg>
        </div>
        <div class="sf-header-text">
            <h2>Configuración del sistema</h2>
            <p>Personaliza los parámetros de tu instalación</p>
        </div>
    </div>

    <form asp-action="Settings" method="post" autocomplete="off">
        @Html.AntiForgeryToken()

        <div class="sf-card">
            <div class="sf-section-label">Parámetros generales</div>

            @for (int i = 0; i < Model.Count; i++)
            {
                @Html.HiddenFor(m => m[i].settingName)
                @Html.HiddenFor(m => m[i].settingType)

                var type = Model[i].settingType?.ToLower() ?? "text";

        <div class="sf-field">
            <label class="sf-label" for="field_@i">
                @Model[i].displayName
                <span class="sf-badge sf-badge-@type">@type</span>
            </label>

            @switch (type)
            {
                case "number":
                    @Html.TextBoxFor(m => m[i].settingValue, new { type = "number", @class = "sf-input", id = "field_" + i })
                    break;

                case "password":
                    <div class="sf-input-password-wrap">
                        @Html.Password($"[{i}].settingValue", Model[i].settingValue, new { @class = "sf-input", id = "field_" + i })
                        <button type="button" class="sf-eye" onclick="togglePwd(this)" aria-label="Mostrar contraseña">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        </button>
                    </div>
                    break;

                case "checkbox":
                    <div class="sf-toggle-wrap">
                        <label class="sf-toggle">
                            @Html.CheckBox($"[{i}].settingValue", Model[i].settingValue == "true", new { id = "field_" + i, onchange = "updateToggleLabel(this)" })
                            <span class="sf-track"></span>
                            <span class="sf-thumb"></span>
                        </label>
                        <span class="sf-toggle-label">
                            @(Model[i].settingValue == "true" ? "Activado" : "Desactivado")
                        </span>
                    </div>
                    break;

                case "datetime-local":
                    @Html.TextBox(
                        $"[{i}].settingValue",
                        Model[i].settingValue,
                        new
                        {
                            type = "datetime-local",
                            @class = "sf-input",
                            id = "field_" + i
                        })
                    break;

                default:
                    @Html.TextBoxFor(m => m[i].settingValue, new { @class = "sf-input", id = "field_" + i })
                    break;
            }
        </div>
            }

            <div class="sf-footer">
                <div class="sf-toast" id="sf-toast">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M20 6L9 17l-5-5" />
                    </svg>
                    Cambios guardados
                </div>
                <a href="@Url.Action("Settings", "Settings")" class="sf-btn sf-btn-ghost">Cancelar</a>
                <button class="sf-btn sf-btn-primary" type="submit">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                        <path d="M19 21H5a2 2 0 01-2-2V5a2 2 0 012-2h11l5 5v11a2 2 0 01-2 2z" />
                        <polyline points="17 21 17 13 7 13 7 21" />
                        <polyline points="7 3 7 8 15 8" />
                    </svg>
                    Guardar cambios
                </button>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        function togglePwd(btn) {
            const inp = btn.previousElementSibling;
            const showing = inp.type === 'text';
            inp.type = showing ? 'password' : 'text';
            btn.innerHTML = showing
                ? `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>`
                : `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="17" height="17"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>`;
        }

        function updateToggleLabel(chk) {
            chk.closest('.sf-toggle-wrap')
                .querySelector('.sf-toggle-label')
                .textContent = chk.checked ? 'Activado' : 'Desactivado';
        }
    </script>
}