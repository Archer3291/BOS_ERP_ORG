                        </div>
                        <p class="pi-help-text" style="margin-top:.4rem">
                            El cambio de layout se aplica al <strong>guardar</strong> (la página se recarga).
                        </p>
                    </div>

                    <div class="pi-color-grid">
                        <div class="pi-color-field">
                            <label><i class="fas fa-arrows-left-right"></i> Posición</label>
                            <div style="display:flex;gap:.5rem" id="sb_posicion_wrap">
                                @foreach (var pos in new[] { ("left", "← Izquierda"), ("right", "Derecha →") })
                                {
                                    <button type="button"
                                            class="pi-preset-btn @(sb?.SidebarPosicion == pos.Item1 ? "active" : "")"
                                            data-sbpos="@pos.Item1" onclick="selectSbPos(this)">
                                        @pos.Item2
                                    </button>
