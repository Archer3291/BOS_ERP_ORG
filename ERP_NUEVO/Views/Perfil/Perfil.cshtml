                    </div>

                    <div class="pi-pass-group" style="margin-top:.9rem">
                        <div class="pi-pass-label">
                            <i class="fas fa-ruler-horizontal"></i> Ancho
                            <span id="sb_ancho_val" style="margin-left:6px;font-weight:700;color:var(--accent-blue)">
                                @(sb?.SidebarAncho ?? "285")px
                            </span>
                        </div>
                        <input type="range" id="sb_ancho" min="220" max="400" step="5" value="@(sb?.SidebarAncho ?? "285")" style="width:100%;accent-color:var(--accent-blue)" oninput="document.getElementById('sb_ancho_val').textContent=this.value+'px'; previewSb()" />
                    </div>

                    <details class="pi-advanced">
                        <summary><i class="fas fa-sliders"></i> Iconos, animaciones y colores (avanzado)</summary>

                        <div class="pi-pass-group" style="margin-top:.9rem">
                            <div class="pi-pass-label"><i class="fas fa-icons"></i> Estilo de íconos</div>
                            <div style="display:flex;gap:.5rem;flex-wrap:wrap" id="sb_icon_wrap">
                                @foreach (var est in new[] {
                            ("duotone","fa-duotone","Duotone"),
                            ("solid","fa-solid","Solid"),
                            ("regular","fa-regular","Regular"),
                            ("light","fa-light","Light")
                        })
                                {
                                    <button type="button"
                                            class="pi-preset-btn @(sb?.SidebarIconStyle == est.Item1 ? "active" : "")"
                                            data-sbicon="@est.Item1" onclick="selectSbIcon(this)">
                                        <i class="@est.Item2 fa-house" style="font-size:.9rem"></i> @est.Item3
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="pi-pass-group" style="margin-top:.9rem">
                            <div class="pi-pass-label"><i class="fas fa-wand-magic-sparkles"></i> Efecto hover</div>
                            <div style="display:flex;gap:.5rem;flex-wrap:wrap" id="sb_hover_wrap">
                                @foreach (var ef in new[] {
                            ("slide","↔ Slide"),
                            ("glow","✨ Glow"),
                            ("fill","▣ Fill"),
                            ("none","— Ninguno")
                        })
                                {
                                    <button type="button"
                                            class="pi-preset-btn @(sb?.SidebarHoverEfecto == ef.Item1 ? "active" : "")"
                                            data-sbhover="@ef.Item1" onclick="selectSbHover(this)">
                                        @ef.Item2
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="pi-color-grid" style="margin-top:.9rem">
                            @foreach (var (campo, label, valor) in new[] {
                        ("sb_bg_color",          "Fondo",              sb?.SidebarBgColor         ?? "#ffffff"),
                        ("sb_link_color",        "Links",              sb?.SidebarLinkColor       ?? "#64748b"),
                        ("sb_active_color",      "Fondo activo",       sb?.SidebarActiveColor     ?? "#e1e7ef"),
                        ("sb_active_link_color", "Texto activo",       sb?.SidebarActiveLinkColor ?? "#0f1729"),
                        ("sb_header_bg",         "Header (color base)",sb?.SidebarHeaderBg        ?? "#1e3a5f"),
                    })
                            {
                                <div class="pi-color-field">
                                    <label>@label</label>
                                    <div class="pi-color-row">
                                        <input type="color" class="color-picker-sb" id="cp_@campo" value="@valor" data-campo="@campo" />
                                        <input type="text" class="color-hex-sb" id="hex_@campo" value="@valor" maxlength="7" />
