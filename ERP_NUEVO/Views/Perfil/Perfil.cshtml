@* /perfil-page*@


@section scripts {
    <script src="~/lib/signature_pad/signature_pad.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        /* ── Tabs ───────────────────────────────────────────────────────── */
        function switchTab(name) {
            document.querySelectorAll('.perfil-tab').forEach(t =>
                t.classList.toggle('active', t.dataset.tab === name));
            document.querySelectorAll('.perfil-panel').forEach(p =>
                p.classList.toggle('active', p.id === 'panel-' + name));
        }

        /* ── Toggle password ────────────────────────────────────────────── */
        document.querySelectorAll('.toggle-pass').forEach(btn => {
            btn.addEventListener('click', function () {
                const input = document.getElementById(this.getAttribute('data-target'));
                const icon = this.querySelector('i');
                if (input.type === 'password') {
                    input.type = 'text';
                    icon.classList.replace('fa-eye', 'fa-eye-slash');
                } else {
                    input.type = 'password';
                    icon.classList.replace('fa-eye-slash', 'fa-eye');
                }
            });
        });

        /* ── Gráfica de actividad ───────────────────────────────────────── */
        (function buildChart() {
            const rawData = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(ViewBag.ActividadGrafica));

            if (!rawData || rawData.length === 0) {
                const wrap = document.querySelector('.pi-chart-wrap');
                if (wrap) wrap.innerHTML =
                    '<p class="text-muted text-center mt-4" style="font-size:.82rem">Sin actividad registrada en los últimos 14 días.</p>';
                return;
            }

            const totalesPorDia = {};
            rawData.forEach(r => {
                const dia = r.dia ? r.dia.substring(0, 10) : '?';
                totalesPorDia[dia] = (totalesPorDia[dia] || 0) + parseInt(r.total || 0);
            });

            const labels = Object.keys(totalesPorDia).sort();
            const valores = labels.map(d => totalesPorDia[d]);
            const labelsX = labels.map(d => { const [, m, day] = d.split('-'); return `${day}/${m}`; });

            const ctx = document.getElementById('chartActividad').getContext('2d');
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labelsX,
                    datasets: [{
                        label: 'Acciones',
                        data: valores,
                        backgroundColor: 'rgba(59, 130, 246, 0.2)',
                        borderColor: 'rgba(59, 130, 246, 0.85)',
                        borderWidth: 1.5,
                        borderRadius: 5,
                        borderSkipped: false
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                title: items => `Día: ${items[0].label}`,
                                label: item => ` ${item.raw} acciones`
                            }
                        }
                    },
                    scales: {
                        x: { grid: { display: false }, ticks: { font: { size: 11 } } },
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0, font: { size: 11 } },
                            grid: { color: 'rgba(0,0,0,0.04)' }
                        }
                    }
                }
            });
        })();

        /* ── Cambiar contraseña ─────────────────────────────────────────── */
        function guardarNuevaContrasena() {
            const contrasenaActual = document.getElementById('contrasenaActual').value;
            const nuevaContrasena = document.getElementById('nuevaContrasena').value;
            const confirmarContrasena = document.getElementById('confirmarContrasena').value;

            if (!contrasenaActual || !nuevaContrasena || !confirmarContrasena) {
                _Swal.fire({
                    icon: 'warning', title: 'Campos incompletos',
                    text: 'Por favor completa todos los campos antes de continuar.'
                });
                return;
            }
            if (nuevaContrasena.length < 6) {
                _Swal.fire({
                    icon: 'warning', title: 'Contraseña muy corta',
                    text: 'La nueva contraseña debe tener al menos 6 caracteres.'
                });
                return;
            }
            if (nuevaContrasena !== confirmarContrasena) {
                _Swal.fire({
                    icon: 'error', title: 'Las contraseñas no coinciden',
                    text: 'Verifica que la nueva contraseña y su confirmación sean iguales.'
                });
                return;
            }
            if (contrasenaActual === nuevaContrasena) {
                _Swal.fire({
                    icon: 'info', title: 'Contraseña idéntica',
                    text: 'La nueva contraseña no puede ser igual a la actual.'
                });
                return;
            }

            _Swal.fire({
                icon: 'question', title: '¿Cambiar contraseña?',
                text: 'Estás a punto de actualizar tu contraseña.',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-lock me-1"></i> Sí, cambiar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#3085d6',
                cancelButtonColor: '#d33'
            }).then(result => {
                if (!result.isConfirmed) return;

                _Swal.fire({
                    title: 'Actualizando...', allowOutsideClick: false,
                    allowEscapeKey: false, showConfirmButton: false,
                    didOpen: () => Swal.showLoading()
                });

                GetData({
                    path: '/Perfil/CambiarContrasena',
                    data: { contrasenaActual, nuevaContrasena, confirmarContrasena }
                })
                    .then(res => {
                        if (res.success) {
                            ['contrasenaActual', 'nuevaContrasena', 'confirmarContrasena']
                                .forEach(id => document.getElementById(id).value = '');
                            _Swal.fire({
                                icon: 'success', title: '¡Contraseña actualizada!',
                                timer: 3000, timerProgressBar: true
                            });
                        } else {
                            _Swal.fire({
                                icon: 'error', title: 'No se pudo actualizar',
                                text: res.message || 'Ocurrió un error, intenta nuevamente.'
                            });
                        }
                    }).catch(() => {
                        _Swal.fire({
                            icon: 'error', title: 'Error inesperado',
                            text: 'No se pudo conectar con el servidor.'
                        });
                    });
            });
        }

        /* ── Cerrar sesión individual ───────────────────────────────────── */
        function cerrarSesion(deviceId) {
            _Swal.fire({
                icon: 'warning', title: 'Cerrar sesión',
                text: '¿Deseas cerrar esta sesión remota?',
                showCancelButton: true,
                confirmButtonText: 'Sí, cerrar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#dc2626'
            }).then(result => {
                if (!result.isConfirmed) return;
                GetData({ path: '/Account/CerrarSesion', data: { deviceId } })
                    .then(res => {
                        if (res.success) toastMixinReload({ icon: 'success', title: 'Sesión cerrada' });
                        else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    });
            });
        }

        /* ── Cerrar todas las otras sesiones ────────────────────────────── */
        function cerrarTodasSesiones() {
            _Swal.fire({
                icon: 'warning', title: 'Cerrar todas las otras sesiones',
                text: 'Se cerrarán todas las sesiones excepto la actual.',
                showCancelButton: true,
                confirmButtonText: 'Sí, cerrar todas',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#dc2626'
            }).then(result => {
                if (!result.isConfirmed) return;
                GetData({ path: '/Account/CerrarTodasSesiones', data: {} })
                    .then(res => {
                        if (res.success) toastMixinReload({ icon: 'success', title: 'Sesiones cerradas' });
                        else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    });
            });
        }

        /* ── Firma digital ──────────────────────────────────────────────── */
        function changeSignature() {
            const firma = '@Context.Session.GetString("Firma")';

            if (!firma || firma === 'null' || firma.trim() === '') {
                _Swal.fire({
                    icon: 'warning', title: 'Sin firma registrada',
                    text: 'No se encontró una firma registrada.',
                    confirmButtonText: 'Agregar firma',
                    showCancelButton: true, cancelButtonText: 'Cancelar'
                }).then(r => { if (r.isConfirmed) abrirFirma(); });
            } else {
                _Swal.fire({
                    title: 'Tu firma actual',
                    html: `<img src="${firma}" alt="Firma" style="max-width:100%;border:1px solid #e2e8f0;border-radius:.5rem" />`,
                    confirmButtonText: 'Actualizar firma',
                    showCancelButton: true, cancelButtonText: 'Cancelar'
                }).then(r => { if (r.isConfirmed) abrirFirma(); });
            }

            function abrirFirma() {
                _Swal.fire({
                    title: 'Dibuja tu firma',
                    html: `<canvas id="signature-pad" width="400" height="200"
                        style="border:1px solid #e2e8f0;border-radius:.5rem;touch-action:none"></canvas>
                        <div style="margin-top:10px">
                        <button id="clearBtn" class="btn btn-sm btn-outline-secondary">Limpiar</button>
                        </div>`,
                    confirmButtonText: 'Guardar firma',
                    showCancelButton: true, cancelButtonText: 'Cancelar',
                    didOpen: () => {
                        const canvas = document.getElementById('signature-pad');
                        const sp = new SignaturePad(canvas, {
                            penColor: 'rgb(0,0,0)', minWidth: 0.5, maxWidth: 1.0
                        });
                        document.getElementById('clearBtn').addEventListener('click', () => sp.clear());
                        Swal.__signaturePad = sp;
                    },
                    preConfirm: () => {
                        const sp = Swal.__signaturePad;
                        if (sp.isEmpty()) {
                            Swal.showValidationMessage('Por favor dibuja tu firma.');
                            return false;
                        }
                        return sp.toDataURL('image/png', 0.5);
                    }
                }).then(result => {
                    if (!result.isConfirmed || !result.value) return;
                    _Swal.fire({
                        title: 'Guardando firma...', allowOutsideClick: false,
                        showConfirmButton: false, didOpen: () => Swal.showLoading()
                    });
                    GetData({ path: '/Account/ActualizarFirma', data: { firma: result.value } })
                        .then(res => {
                            if (res.success) toastMixinReload({ icon: 'success', title: 'Firma actualizada' });
                            else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                        });
                });
            }
        }

        /* ── Color pickers (tema) ───────────────────────────────────────── */
        const campoACssVar = {
            primary_blue: '--primary-blue',
            primary_blue_hover: '--primary-blue-dark',
            secondary_blue: '--secondary-blue',
            light_blue: '--light-blue',
            very_light_blue: '--very-light-blue',
            dark_blue_light: '--dark-blue',
            accent_blue: '--accent-blue',
            bg_light: '--bg-light',
            bg_gray: '--bg-gray',
            text_dark: '--text-dark',
            text_light: '--text-light',
            border_light: '--border-light',
        };

        const campoDarkACssVar = {
            dark_primary_blue: '--primary-blue',
            dark_blue_hover: '--primary-blue-dark',
            dark_secondary_blue: '--secondary-blue',
            dark_light_blue: '--light-blue',
            dark_very_light_blue: '--very-light-blue',
            dark_dark_blue: '--dark-blue',
            dark_accent_blue: '--accent-blue',
            dark_bg_light: '--bg-light',
            dark_bg_gray: '--bg-gray',
            dark_text_dark: '--text-dark',
            dark_text_light: '--text-light',
            dark_border_light: '--border-light',
        };

        document.querySelectorAll('.color-picker').forEach(picker => {
            const hexInput = document.getElementById('hex_' + picker.dataset.campo);
            picker.addEventListener('input', () => {
                hexInput.value = picker.value;
                previsualizarColor(picker.dataset.campo, picker.value);
            });
            hexInput.addEventListener('input', () => {
                if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
                    picker.value = hexInput.value;
                    previsualizarColor(picker.dataset.campo, hexInput.value);
                }
            });
        });

        function previsualizarColor(campo, valor) {
            const isDark = campo.startsWith('dark_');
            if (!isDark) {
                const cssVar = campoACssVar[campo];
                if (cssVar) document.documentElement.style.setProperty(cssVar, valor);
            } else {
                const cssVar = campoDarkACssVar[campo];
                if (cssVar && document.documentElement.getAttribute('data-theme') === 'dark')
                    document.documentElement.style.setProperty(cssVar, valor);
            }
        }

        function previsualizarTema() {
            document.querySelectorAll('.color-picker').forEach(p =>
                previsualizarColor(p.dataset.campo, p.value));
            toastMixin.fire({ icon: 'info', title: 'Previsualización activa — guarda para conservar los cambios' });
        }

        function recolectarTema() {
            return {
                modo: document.documentElement.getAttribute('data-theme') || 'light',
                // Light
                primaryBlue: document.getElementById('hex_primary_blue').value,
                primaryBlueHover: document.getElementById('hex_primary_blue_hover').value,
                secondaryBlue: document.getElementById('hex_secondary_blue').value,
                lightBlue: document.getElementById('hex_light_blue').value,
                veryLightBlue: document.getElementById('hex_very_light_blue').value,
                darkBlueLight: document.getElementById('hex_dark_blue_light').value,
                accentBlue: document.getElementById('hex_accent_blue').value,
                bgLight: document.getElementById('hex_bg_light').value,
                bgGray: document.getElementById('hex_bg_gray').value,
                textDark: document.getElementById('hex_text_dark').value,
                textLight: document.getElementById('hex_text_light').value,
                borderLight: document.getElementById('hex_border_light').value,
                // Dark
                darkPrimaryBlue: document.getElementById('hex_dark_primary_blue').value,
                darkBlueHover: document.getElementById('hex_dark_blue_hover').value,
                darkSecondaryBlue: document.getElementById('hex_dark_secondary_blue').value,
                darkLightBlue: document.getElementById('hex_dark_light_blue').value,
                darkVeryLightBlue: document.getElementById('hex_dark_very_light_blue').value,
                darkDarkBlue: document.getElementById('hex_dark_dark_blue').value,
                darkAccentBlue: document.getElementById('hex_dark_accent_blue').value,
                darkBgLight: document.getElementById('hex_dark_bg_light').value,
                darkBgGray: document.getElementById('hex_dark_bg_gray').value,
                darkTextDark: document.getElementById('hex_dark_text_dark').value,
                darkTextLight: document.getElementById('hex_dark_text_light').value,
                darkBorderLight: document.getElementById('hex_dark_border_light').value,

                particulasActivas: document.getElementById('part_activas').checked,
                particulasCantidad: parseInt(document.getElementById('part_cantidad').value),
                particulasForma: document.querySelector('#part_formas .active')?.dataset.forma ?? 'circle',
                particulasPreset: document.querySelector('#part_presets .active')?.dataset.ppreset ?? 'theme',
                presetNombre: null
            };
        }
        function selectForma(btn) {
            document.querySelectorAll('#part_formas .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }

        function selectPartPreset(btn) {
            document.querySelectorAll('#part_presets .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
        function guardarTema() {
            const tema = recolectarTema();

            // Solo validar las propiedades que son colores hex
            const camposColor = [
                'primaryBlue', 'primaryBlueHover', 'secondaryBlue', 'lightBlue', 'veryLightBlue',
                'darkBlueLight', 'accentBlue', 'bgLight', 'bgGray', 'textDark', 'textLight', 'borderLight',
                'darkPrimaryBlue', 'darkBlueHover', 'darkSecondaryBlue', 'darkLightBlue', 'darkVeryLightBlue',
                'darkDarkBlue', 'darkAccentBlue', 'darkBgLight', 'darkBgGray', 'darkTextDark', 'darkTextLight', 'darkBorderLight'
            ];

            const invalidos = camposColor.filter(k => {
                const v = tema[k];
                return v && !/^#[0-9A-Fa-f]{6}$/.test(v);
            });

            if (invalidos.length > 0) {
                _Swal.fire({
                    icon: 'warning', title: 'Color inválido',
                    text: 'Todos los colores deben estar en formato #RRGGBB'
                });
                return;
            }
            GetData({ path: '/Account/GuardarTema', data: tema })
                .then(res => {
                    if (res.success) toastMixinReload({ icon: 'success', title: 'Tema guardado correctamente' });
                    else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                });
        }

        function aplicarPreset(nombre) {
            _Swal.fire({
                icon: 'question', title: `¿Aplicar tema "${nombre}"?`,
                showCancelButton: true, confirmButtonText: 'Sí, aplicar'
            }).then(result => {
                if (!result.isConfirmed) return;
                GetData({ path: '/Account/AplicarPreset', data: { preset: nombre } })
                    .then(res => {
                        if (res.success) toastMixinReload({ icon: 'success', title: 'Tema aplicado' });
                        else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                    });
            });
        }

        /* ══════════════════════════════════════════════════════════════
        SIDEBAR PERSONALIZACIÓN
        ══════════════════════════════════════════════════════════════ */

        // Color pickers sidebar
        document.querySelectorAll('.color-picker-sb').forEach(picker => {
            const hexInput = document.getElementById('hex_' + picker.dataset.campo);
            picker.addEventListener('input', () => {
                hexInput.value = picker.value;
                previewSb();
            });
            hexInput.addEventListener('input', () => {
                if (/^#[0-9A-Fa-f]{6}$/.test(hexInput.value)) {
                    picker.value = hexInput.value;
                    previewSb();
                }
            });
        });

        function selectSbPos(btn) {
            document.querySelectorAll('#sb_posicion_wrap .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            previewSb();
        }

        function selectSbIcon(btn) {
            document.querySelectorAll('#sb_icon_wrap .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            previewSb();
        }

        function selectSbHover(btn) {
            document.querySelectorAll('#sb_hover_wrap .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            previewSb();
        }

        function selectLayout(btn) {
            document.querySelectorAll('#sb_layout_wrap .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            // El layout no se previsualiza en vivo: se aplica al guardar (recarga).
        }

        function recolectarSidebar() {
            return {
                layoutTipo: document.querySelector('#sb_layout_wrap .active')?.dataset.layout ?? 'sidebar',
                sidebarPosicion: document.querySelector('#sb_posicion_wrap .active')?.dataset.sbpos ?? 'left',
                sidebarAncho: document.getElementById('sb_ancho').value,
                sidebarIconStyle: document.querySelector('#sb_icon_wrap .active')?.dataset.sbicon ?? 'duotone',
                sidebarHoverEfecto: document.querySelector('#sb_hover_wrap .active')?.dataset.sbhover ?? 'slide',
                sidebarModo: document.querySelector('#sb_modo_wrap .active')?.dataset.sbmodo ?? 'normal',
                sidebarBgColor: document.getElementById('hex_sb_bg_color').value,
                sidebarLinkColor: document.getElementById('hex_sb_link_color').value,
                sidebarActiveColor: document.getElementById('hex_sb_active_color').value,
                sidebarActiveLinkColor: document.getElementById('hex_sb_active_link_color').value,
                sidebarHeaderBg: document.getElementById('hex_sb_header_bg').value,
            };
        }

        function previewSb() {
            const sb = recolectarSidebar();
            const root = document.documentElement;
            const sidebarEl = document.getElementById('sidebar');
            sidebarEl.classList.toggle('icon-mode', sb.sidebarModo === 'iconos');
            document.body.classList.toggle('sb-icon-mode', sb.sidebarModo === 'iconos');
            // Ancho
            root.style.setProperty('--sb-width', sb.sidebarAncho + 'px');

            // Colores
            if (/^#[0-9A-Fa-f]{6}$/.test(sb.sidebarBgColor))
                root.style.setProperty('--sb-bg', sb.sidebarBgColor);
            if (/^#[0-9A-Fa-f]{6}$/.test(sb.sidebarLinkColor))
                root.style.setProperty('--sb-link-color', sb.sidebarLinkColor);
            if (/^#[0-9A-Fa-f]{6}$/.test(sb.sidebarActiveColor))
                root.style.setProperty('--sb-active-bg', sb.sidebarActiveColor);
            if (/^#[0-9A-Fa-f]{6}$/.test(sb.sidebarActiveLinkColor))
                root.style.setProperty('--sb-active-color', sb.sidebarActiveLinkColor);
            if (/^#[0-9A-Fa-f]{6}$/.test(sb.sidebarHeaderBg))
                root.style.setProperty('--sb-header-bg', sb.sidebarHeaderBg);

            // Posición
            const isRight = sb.sidebarPosicion === 'right';
            sidebarEl.classList.toggle('sb-right', isRight);
            document.body.classList.toggle('sb-right-mode', isRight);

            // 👇 esto es lo que faltaba — resincronizar el layout del header/main
            if (typeof applyLayout === 'function') {
                applyLayout(sidebarEl.classList.contains('collapsed'));
            }


            // Hover effect: quita clases anteriores, añade la nueva
            ['sb-hover-slide', 'sb-hover-glow', 'sb-hover-fill', 'sb-hover-none'].forEach(c =>
                sidebar.classList.remove(c));
            sidebar.classList.add('sb-hover-' + sb.sidebarHoverEfecto);

            // Estilo de íconos: reemplaza fa-duotone/fa-solid/etc en todos los íconos del sidebar
            sidebar.querySelectorAll('i[class*="fa-"]').forEach(ico => {
                ['fa-duotone', 'fa-solid', 'fa-regular', 'fa-light'].forEach(s => ico.classList.remove(s));
                ico.classList.add('fa-' + sb.sidebarIconStyle);
            });
        }

        function guardarSidebar() {
            const data = { ...recolectarSidebar(), ...recolectarTema() }; // manda todo junto
            GetData({ path: '/Account/GuardarTema', data })
                .then(res => {
                    if (res.success) toastMixinReload({ icon: 'success', title: 'Sidebar guardado' });
                    else _Swal.fire({ icon: 'error', title: 'Error', text: res.message });
                });
        }

        function selectSbModo(btn) {
            document.querySelectorAll('#sb_modo_wrap .pi-preset-btn')
                .forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            previewSb();
        }

        function resetSidebar() {
            _Swal.fire({
                icon: 'question', title: '¿Restaurar sidebar por defecto?',
                showCancelButton: true, confirmButtonText: 'Sí, restaurar'
            }).then(r => {
                if (!r.isConfirmed) return;
                // Devuelve a defaults
                document.getElementById('sb_ancho').value = '285';
                document.getElementById('sb_ancho_val').textContent = '285px';
                document.getElementById('hex_sb_bg_color').value = '#ffffff';
                document.getElementById('cp_sb_bg_color').value = '#ffffff';
                document.getElementById('hex_sb_link_color').value = '#64748b';
                document.getElementById('cp_sb_link_color').value = '#64748b';
                document.getElementById('hex_sb_active_color').value = '#e1e7ef';
                document.getElementById('cp_sb_active_color').value = '#e1e7ef';
                document.getElementById('hex_sb_active_link_color').value = '#0f1729';
                document.getElementById('cp_sb_active_link_color').value = '#0f1729';
                document.getElementById('hex_sb_header_bg').value = '#1e3a5f';
                document.getElementById('cp_sb_header_bg').value = '#1e3a5f';

                document.querySelector('[data-sbpos="left"]')?.classList.add('active');
                document.querySelector('[data-sbpos="right"]')?.classList.remove('active');
                document.querySelector('[data-sbicon="duotone"]')?.classList.add('active');
                document.querySelector('[data-sbhover="slide"]')?.classList.add('active');

                previewSb();
                guardarSidebar();
            });
        }

        /* ── Sub-tabs de Apariencia ─────────────────────────────────────── */
        function switchSubTab(name) {
            document.querySelectorAll('.pi-subtab').forEach(t =>
                t.classList.toggle('active', t.dataset.subtab === name));
            document.querySelectorAll('.pi-subpanel').forEach(p =>
                p.classList.toggle('active', p.id === 'subtema-' + name));
        }

        /* ── Switch modo claro/oscuro dentro de Colores ────────────────── */
        function switchColorMode(mode) {
            document.querySelectorAll('.pi-mode-btn').forEach(b =>
                b.classList.toggle('active', b.dataset.mode === mode));
            document.querySelectorAll('.pi-color-mode-panel').forEach(p =>
                p.classList.toggle('active', p.id === 'colormode-' + mode));
        }

        /* ── Habilitar/deshabilitar opciones de partículas según switch ── */
        document.getElementById('part_activas')?.addEventListener('change', function () {
            const opciones = document.getElementById('part_opciones');
            opciones.style.opacity = this.checked ? '1' : '.4';
            opciones.style.pointerEvents = this.checked ? 'auto' : 'none';
        });

    </script>
}
