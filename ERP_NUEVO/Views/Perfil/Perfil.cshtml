                            </div>
                        </div>

                        <div class="pi-color-field">
                            <label><i class="fas fa-list"></i> Modo de visualización</label>
                            <div style="display:flex;gap:.5rem" id="sb_modo_wrap">
                                @foreach (var m in new[] { ("normal", "📋 Normal"), ("iconos", "🔲 Solo iconos") })
                                {
                                    <button type="button"
                                            class="pi-preset-btn @(sb?.SidebarModo == m.Item1 ? "active" : "")"
                                            data-sbmodo="@m.Item1" onclick="selectSbModo(this)">
