                    </details>

                    <div class="pi-btn-row">
                        <button class="pi-btn pi-btn-primary" onclick="guardarSidebar()">
                            <i class="fas fa-save me-1"></i> Guardar barra lateral
                        </button>
                        <button class="pi-btn" onclick="previewSb()">
                            <i class="fas fa-eye me-1"></i> Previsualizar
                        </button>
                        <button class="pi-btn pi-btn-danger" onclick="resetSidebar()">
