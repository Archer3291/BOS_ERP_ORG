@using BOS_ERP.Controllers
@using BOS_ERP.Models
@{
    ViewData["Title"] = "Perfil";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@functions {
    public static string ObtenerTiempoRelativo(DateTime fecha)
    {
        var ahora = DateTime.Now;
        var diferencia = ahora - fecha;
        if (diferencia.TotalMinutes < 1) return "Hace unos segundos";
        if (diferencia.TotalMinutes < 60) return $"Hace {Math.Floor(diferencia.TotalMinutes)} minuto(s)";
        if (diferencia.TotalHours < 24) return $"Hace {Math.Floor(diferencia.TotalHours)} hora(s)";
        if (diferencia.TotalDays < 2) return $"Ayer a las {fecha:hh:mm tt}";
        return $"Hace {Math.Floor(diferencia.TotalDays)} día(s)";
    }
}

@section styles {
    <style>
        /* ── Contenedor principal ─────────────────────────────────────────── */
        .perfil-page {
            max-width: 980px;
            margin: 0 auto;
            padding: 1.5rem 1rem;
        }

        /* ── Hero ─────────────────────────────────────────────────────────── */
        .perfil-hero {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 1.25rem;
            padding: 1.5rem;
            margin-bottom: 0;
            display: flex;
            gap: 1.25rem;
            align-items: flex-start;
            position: relative;
        }

        .perfil-avatar {
            width: 68px;
            height: 68px;
            border-radius: 50%;
            background: var(--light-blue);
            color: var(--primary-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.5rem;
            font-weight: 700;
            flex-shrink: 0;
            border: 2px solid var(--border-light);
        }

        .perfil-hero-info {
            flex: 1;
            min-width: 0;
        }

        .perfil-hero-name {
            font-size: 1.3rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 3px;
        }

        .perfil-hero-role {
            font-size: 0.82rem;
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 5px;
            margin-bottom: 0.85rem;
        }

        .perfil-stats {
            display: flex;
            gap: 0.5rem;
            flex-wrap: wrap;
        }

        .perfil-stat {
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            border-radius: 0.75rem;
            padding: 7px 14px;
            text-align: center;
            min-width: 88px;
        }

        .perfil-stat-n {
            display: block;
            font-size: 1.2rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1;
        }

        .perfil-stat-l {
            font-size: 0.72rem;
            color: var(--text-light);
            margin-top: 2px;
        }

        .perfil-hero-actions {
            display: flex;
            gap: 0.4rem;
            flex-shrink: 0;
        }

        .perfil-icon-btn {
            width: 34px;
            height: 34px;
            border: 1px solid var(--border-light);
            border-radius: 0.6rem;
            background: var(--bg-light);
            color: var(--text-light);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            font-size: 0.9rem;
            transition: background 0.15s, color 0.15s;
        }

            .perfil-icon-btn:hover {
                background: var(--bg-gray);
                color: var(--text-dark);
            }

        /* ── Tabs ─────────────────────────────────────────────────────────── */
        .perfil-tabs-wrap {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-top: none;
            border-radius: 0 0 1.25rem 1.25rem;
            overflow: hidden;
        }

        .perfil-tabs {
            display: flex;
            border-bottom: 1px solid var(--border-light);
            padding: 0 1.25rem;
            overflow-x: auto;
            scrollbar-width: none;
        }

            .perfil-tabs::-webkit-scrollbar {
                display: none;
            }

        .perfil-tab {
            padding: 0.75rem 1rem;
            font-size: 0.82rem;
            color: var(--text-light);
            cursor: pointer;
            border-bottom: 2px solid transparent;
            margin-bottom: -1px;
            display: flex;
            align-items: center;
            gap: 5px;
            white-space: nowrap;
            transition: color 0.15s;
            font-weight: 500;
            background: none;
            border-top: none;
            border-left: none;
            border-right: none;
        }

            .perfil-tab.active {
                color: var(--primary-blue);
                border-bottom-color: var(--primary-blue);
            }

            .perfil-tab:hover:not(.active) {
                color: var(--text-dark);
            }

        .perfil-panel {
            display: none;
            padding: 1.25rem;
        }

            .perfil-panel.active {
                display: block;
            }

        /* ── Grid 2 columnas ──────────────────────────────────────────────── */
        .perfil-grid2 {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .perfil-grid2-full {
            grid-column: 1 / -1;
        }

        @@media (max-width: 680px) {
            .perfil-grid2 {
                grid-template-columns: 1fr;
            }

            .perfil-grid2-full {
                grid-column: auto;
            }

            .perfil-hero {
                flex-direction: column;
                gap: 1rem;
            }

            .perfil-hero-actions {
                position: absolute;
                top: 1rem;
                right: 1rem;
            }
        }

        /* ── Card interna ─────────────────────────────────────────────────── */
        .pi-card {
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            border-radius: 1rem;
            padding: 1.1rem;
        }

        .pi-card-title {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 0.85rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ── Filas de campo ───────────────────────────────────────────────── */
        .pi-field {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 0;
            border-bottom: 1px solid var(--border-light);
            font-size: 0.82rem;
        }

            .pi-field:last-child {
                border-bottom: none;
            }

        .pi-field-label {
            color: var(--text-light);
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .pi-field-val {
            font-weight: 600;
            color: var(--text-dark);
            text-align: right;
            max-width: 55%;
        }

        /* ── Badges ───────────────────────────────────────────────────────── */
        .pi-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .pi-badge-success {
            background: #dcfce7;
            color: #15803d;
        }

        .pi-badge-warn {
            background: #fef9c3;
            color: #854d0e;
        }

        .pi-badge-info {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .pi-badge-danger {
            background: #fee2e2;
            color: #b91c1c;
        }

        /* ── Sesiones ─────────────────────────────────────────────────────── */
        .pi-session {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--border-light);
        }

            .pi-session:last-child {
                border-bottom: none;
            }

        .pi-session-icon {
            width: 34px;
            height: 34px;
            border-radius: 0.6rem;
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.9rem;
            color: var(--text-light);
            flex-shrink: 0;
        }

        .pi-session-meta {
            flex: 1;
            min-width: 0;
        }

        .pi-session-device {
            font-size: 0.78rem;
            font-weight: 600;
            font-family: monospace;
            color: var(--text-dark);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .pi-session-time {
            font-size: 0.72rem;
            color: var(--text-light);
            margin-top: 1px;
        }

        /* ── Actividad ────────────────────────────────────────────────────── */
        .pi-act {
            display: flex;
            align-items: flex-start;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--border-light);
        }

            .pi-act:last-child {
                border-bottom: none;
            }

        .pi-act-dot {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            color: var(--text-light);
            flex-shrink: 0;
            margin-top: 1px;
        }

        .pi-act-text {
            font-size: 0.82rem;
            color: var(--text-dark);
            line-height: 1.45;
        }

        .pi-act-time {
            font-size: 0.72rem;
            color: var(--text-light);
            margin-top: 2px;
        }

        /* ── Documentos ───────────────────────────────────────────────────── */
        .pi-doc {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 0;
            border-bottom: 1px solid var(--border-light);
        }

            .pi-doc:last-child {
                border-bottom: none;
            }

        .pi-doc-icon {
            width: 32px;
            height: 32px;
            border-radius: 0.5rem;
            background: #fef9c3;
            color: #854d0e;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.85rem;
            flex-shrink: 0;
        }

        .pi-doc-id {
            font-size: 0.82rem;
            font-weight: 700;
            color: var(--primary-blue);
        }

        .pi-doc-date {
            font-size: 0.72rem;
            color: var(--text-light);
            margin-top: 1px;
        }

        .pi-doc-link {
            width: 28px;
            height: 28px;
            border: 1px solid var(--border-light);
            border-radius: 0.5rem;
            background: var(--bg-light);
            color: var(--text-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.82rem;
            text-decoration: none;
            transition: background 0.15s;
            flex-shrink: 0;
        }

            .pi-doc-link:hover {
                background: var(--bg-gray);
                color: var(--primary-blue);
            }

        /* ── Gráfica de barras ────────────────────────────────────────────── */
        .pi-chart-wrap {
            position: relative;
            height: 200px;
            margin-top: 0.5rem;
        }

        /* ── Contraseña ───────────────────────────────────────────────────── */
        .pi-pass-group {
            margin-bottom: 0.9rem;
        }

        .pi-pass-label {
            font-size: 0.78rem;
            color: var(--text-light);
            font-weight: 600;
            margin-bottom: 0.35rem;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        /* ── Tema / Color pickers ─────────────────────────────────────────── */
        .pi-color-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
            gap: 0.75rem;
            margin-bottom: 1.1rem;
        }

        .pi-color-field label {
            font-size: 0.72rem;
            color: var(--text-light);
            display: block;
            margin-bottom: 0.3rem;
            font-weight: 600;
        }

        .pi-color-row {
            display: flex;
            gap: 6px;
            align-items: center;
        }

            .pi-color-row input[type="color"] {
                width: 32px;
                height: 30px;
                border: 1px solid var(--border-light);
                border-radius: 0.4rem;
                cursor: pointer;
                background: none;
                padding: 2px;
                flex-shrink: 0;
            }

            .pi-color-row input[type="text"] {
                flex: 1;
                min-width: 0;
                border: 1px solid var(--border-light);
                border-radius: 0.4rem;
                padding: 5px 8px;
                font-size: 0.75rem;
                font-family: monospace;
                background: var(--bg-light);
                color: var(--text-dark);
                outline: none;
            }

                .pi-color-row input[type="text"]:focus {
                    border-color: var(--accent-blue);
                }

        .pi-presets {
            display: flex;
            gap: 0.4rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
        }

        .pi-preset-btn {
            padding: 5px 14px;
            border: 1px solid var(--border-light);
            border-radius: 20px;
            font-size: 0.78rem;
            cursor: pointer;
            background: var(--bg-light);
            color: var(--text-light);
            font-weight: 500;
            transition: all 0.15s;
        }

            .pi-preset-btn:hover,
            .pi-preset-btn.active {
                background: var(--primary-blue);
                color: #fff;
                border-color: var(--primary-blue);
            }

        /* ── Botones de acción ────────────────────────────────────────────── */
        .pi-btn-row {
            display: flex;
            gap: 0.5rem;
            margin-top: 0.9rem;
            flex-wrap: wrap;
        }

        .pi-btn {
            padding: 7px 16px;
            border: 1px solid var(--border-light);
            border-radius: 0.6rem;
            font-size: 0.82rem;
            font-weight: 600;
            cursor: pointer;
            background: var(--bg-light);
            color: var(--text-dark);
            transition: background 0.15s;
        }

            .pi-btn:hover {
                background: var(--bg-gray);
            }

        .pi-btn-primary {
            background: var(--primary-blue);
            color: #fff;
            border-color: var(--primary-blue);
        }

            .pi-btn-primary:hover {
                background: var(--primary-blue-dark);
            }

        .pi-btn-danger {
            background: #fee2e2;
            color: #b91c1c;
            border-color: #fca5a5;
        }

            .pi-btn-danger:hover {
                background: #fecaca;
            }

        /* ── Separador de sección ─────────────────────────────────────────── */
        .pi-section-divider {
            border: none;
            border-top: 1px solid var(--border-light);
            margin: 1rem 0;
        }

        /* ── Animación de entrada ─────────────────────────────────────────── */
        @@keyframes pi-fadein {
            from {
                opacity: 0;
                transform: translateY(12px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .perfil-panel.active {
            animation: pi-fadein 0.25s ease-out;
        }

        /* ── Sub-tabs internos ──────────────────────────────────────────── */
        .pi-subtabs {
            display: flex;
            gap: .4rem;
            flex-wrap: wrap;
            margin-bottom: 1rem;
            border-bottom: 1px solid var(--border-light);
            padding-bottom: .75rem;
        }

        .pi-subtab {
            padding: 6px 14px;
            border-radius: 0.6rem;
            border: 1px solid var(--border-light);
            background: var(--bg-light);
            color: var(--text-light);
            font-size: .8rem;
            font-weight: 600;
            cursor: pointer;
            display: flex;
            align-items: center;
            gap: 6px;
            transition: all .15s;
        }

            .pi-subtab.active {
                background: var(--primary-blue);
                color: #fff;
                border-color: var(--primary-blue);
            }

            .pi-subtab:hover:not(.active) {
                background: var(--bg-gray);
            }

        .pi-subpanel {
            display: none;
        }

            .pi-subpanel.active {
                display: block;
                animation: pi-fadein .2s ease-out;
            }

        /* ── Texto de ayuda ─────────────────────────────────────────────── */
        .pi-help-text {
            font-size: .8rem;
            color: var(--text-light);
            margin-bottom: 1rem;
            line-height: 1.4;
        }

        /* ── Grid de presets como tarjetas ──────────────────────────────── */
        .pi-preset-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
            gap: .75rem;
            margin-bottom: 1rem;
        }

        .pi-preset-card {
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            padding: 1rem .5rem;
            border: 2px solid var(--border-light);
            border-radius: 1rem;
            background: var(--bg-gray);
            cursor: pointer;
            transition: all .15s;
        }

            .pi-preset-card:hover {
                border-color: var(--accent-blue);
                transform: translateY(-2px);
            }

            .pi-preset-card.active {
                border-color: var(--primary-blue);
                background: var(--light-blue);
            }

        .pi-preset-emoji {
            font-size: 1.8rem;
        }

        .pi-preset-name {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .pi-preset-check {
            position: absolute;
            top: 6px;
            right: 6px;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--primary-blue);
            color: #fff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .6rem;
        }

        /* ── Switch modo claro/oscuro ───────────────────────────────────── */
        .pi-mode-switch {
            display: flex;
            gap: .5rem;
            margin-bottom: 1rem;
        }

        .pi-mode-btn {
            padding: 6px 16px;
            border-radius: 20px;
            border: 1px solid var(--border-light);
            background: var(--bg-light);
            color: var(--text-light);
            font-size: .8rem;
            font-weight: 600;
            cursor: pointer;
        }

            .pi-mode-btn.active {
                background: var(--primary-blue);
                color: #fff;
                border-color: var(--primary-blue);
            }

        .pi-color-mode-panel {
            display: none;
        }

            .pi-color-mode-panel.active {
                display: block;
            }

        /* ── Color grid simplificado (esenciales) ───────────────────────── */
        .pi-color-grid-simple {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: .85rem;
            margin-bottom: 1rem;
        }

        .pi-color-field-simple {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: .6rem;
            border: 1px solid var(--border-light);
            border-radius: .75rem;
            background: var(--bg-gray);
        }

            .pi-color-field-simple input[type="color"] {
                width: 38px;
                height: 38px;
                border-radius: 50%;
                border: 2px solid var(--border-light);
                padding: 0;
                cursor: pointer;
                flex-shrink: 0;
            }

        .pi-color-field-info {
            flex: 1;
            min-width: 0;
        }

            .pi-color-field-info label {
                display: block;
                font-size: .72rem;
                color: var(--text-light);
                font-weight: 600;
                margin-bottom: 2px;
            }

            .pi-color-field-info input[type="text"] {
                width: 100%;
                border: 1px solid var(--border-light);
                border-radius: .4rem;
                padding: 3px 6px;
                font-size: .72rem;
                font-family: monospace;
                background: var(--bg-light);
                color: var(--text-dark);
            }

        /* ── Sección avanzada colapsable ────────────────────────────────── */
        .pi-advanced {
            margin-top: .5rem;
            border: 1px solid var(--border-light);
            border-radius: .75rem;
            padding: .25rem .75rem;
        }

            .pi-advanced summary {
                cursor: pointer;
                font-size: .8rem;
                font-weight: 600;
                color: var(--text-light);
                padding: .6rem 0;
                list-style: none;
            }

                .pi-advanced summary::-webkit-details-marker {
                    display: none;
                }

            .pi-advanced[open] summary {
                color: var(--primary-blue);
            }

            .pi-advanced .pi-color-grid {
                padding-bottom: .75rem;
            }

        /* ── Toggle switch ───────────────────────────────────────────────── */
        .pi-toggle-row {
            display: flex;
            align-items: center;
            gap: 12px;
            margin-bottom: 1.2rem;
        }

        .pi-toggle-switch {
            position: relative;
            display: inline-block;
            width: 44px;
            height: 24px;
            flex-shrink: 0;
        }

            .pi-toggle-switch input {
                opacity: 0;
                width: 0;
                height: 0;
            }

        .pi-toggle-slider {
            position: absolute;
            cursor: pointer;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background-color: var(--border-light);
            border-radius: 24px;
            transition: .2s;
        }

            .pi-toggle-slider::before {
                content: "";
                position: absolute;
                height: 18px;
                width: 18px;
                left: 3px;
                bottom: 3px;
                background-color: #fff;
                border-radius: 50%;
                transition: .2s;
            }

        .pi-toggle-switch input:checked + .pi-toggle-slider {
            background-color: var(--primary-blue);
        }

            .pi-toggle-switch input:checked + .pi-toggle-slider::before {
                transform: translateX(20px);
            }

        .pi-toggle-label {
            font-size: .85rem;
            font-weight: 600;
            color: var(--text-dark);
        }
    </style>
}

@{
    string nombreCompleto = Context.Session.GetString("NombreCompleto") ?? "";
    string[] partes = nombreCompleto.Split(' ');
    string iniciales = partes.Length >= 2
        ? $"{partes[0][0]}{partes[1][0]}".ToUpper()
        : nombreCompleto.Length > 0 ? nombreCompleto[0].ToString().ToUpper() : "?";

    var tema = ViewBag.TemaUsuario as UsuarioTema;
    var presets = TemaPresets.Presets;

    var camposLight = new[] {
    ("primary_blue",       "Azul primario",         tema?.PrimaryBlue      ?? "#1e3a5f"),
    ("primary_blue_hover", "Hover / active",         tema?.PrimaryBlueHover ?? "#0f1729"),
    ("secondary_blue",     "Azul secundario",        tema?.SecondaryBlue    ?? "#475569"),
    ("light_blue",         "Azul claro",             tema?.LightBlue        ?? "#e1e7ef"),
    ("very_light_blue",    "Azul muy claro",         tema?.VeryLightBlue    ?? "#f8fafc"),
    ("dark_blue_light",    "Azul oscuro",            tema?.DarkBlueLight    ?? "#0f1729"),
    ("accent_blue",        "Acento",                 tema?.AccentBlue       ?? "#3b82f6"),
    ("bg_light",           "Fondo",                  tema?.BgLight          ?? "#ffffff"),
    ("bg_gray",            "Fondo gris",             tema?.BgGray           ?? "#f8fafc"),
    ("text_dark",          "Texto oscuro",           tema?.TextDark         ?? "#0f172a"),
    ("text_light",         "Texto claro",            tema?.TextLight        ?? "#64748b"),
    ("border_light",       "Bordes",                 tema?.BorderLight      ?? "#e2e8f0"),
};

    var camposDark = new[] {
    ("dark_primary_blue",   "Azul primario",         tema?.DarkPrimaryBlue   ?? "#475569"),
    ("dark_blue_hover",     "Hover / active",         tema?.DarkBlueHover     ?? "#334155"),
    ("dark_secondary_blue", "Azul secundario",        tema?.DarkSecondaryBlue ?? "#64748b"),
    ("dark_light_blue",     "Azul claro",             tema?.DarkLightBlue     ?? "#334155"),
    ("dark_very_light_blue","Azul muy claro",         tema?.DarkVeryLightBlue ?? "#8191a7"),
    ("dark_dark_blue",      "Azul oscuro",            tema?.DarkDarkBlue      ?? "#cbd5e1"),
    ("dark_accent_blue",    "Acento",                 tema?.DarkAccentBlue    ?? "#60a5fa"),
    ("dark_bg_light",       "Fondo",                  tema?.DarkBgLight       ?? "#0f172a"),
    ("dark_bg_gray",        "Fondo gris",             tema?.DarkBgGray        ?? "#1e293b"),
    ("dark_text_dark",      "Texto oscuro",           tema?.DarkTextDark      ?? "#f1f5f9"),
    ("dark_text_light",     "Texto claro",            tema?.DarkTextLight     ?? "#cbd5e1"),
    ("dark_border_light",   "Bordes",                 tema?.DarkBorderLight   ?? "#475569"),
};
}

<div class="perfil-page">


    @* ═══ HERO ═══*@

    <div class="perfil-hero">

        <div class="perfil-avatar d-none">@iniciales</div>
        <img translate="no" class="perfil-avatar" src="https://ui-avatars.com/api/?name=@Context.Session.GetString("NombreCompleto")&background=1e3a8a&color=fff&rounded=true&size=48&format=svg&bold=true" alt="@Context.Session.GetString("NombreCompleto")" />

        <div class="perfil-hero-info">
            <div class="perfil-hero-name">@Context.Session.GetString("NombreCompleto")</div>
            <div class="perfil-hero-role">
                <i class="fas fa-briefcase"></i>
                @Utilities.GetAreaName(User.Identity.Name)
            </div>
            <div class="perfil-stats">
                <div class="perfil-stat">
                    <span class="perfil-stat-n">@ViewBag.Completados</span>
                    <span class="perfil-stat-l">Completados</span>
                </div>
                <div class="perfil-stat">
                    <span class="perfil-stat-n">@ViewBag.Pendientes</span>
                    <span class="perfil-stat-l">Pendientes</span>
                </div>
                @if (ViewBag.Sesiones != null)
                {
                    <div class="perfil-stat">
                        <span class="perfil-stat-n">@ViewBag.Sesiones.Count</span>
                        <span class="perfil-stat-l">Sesiones</span>
                    </div>
                }
            </div>
        </div>

        <div class="perfil-hero-actions">
            <button class="perfil-icon-btn" onclick="changeSignature()" title="Firma digital">
                <i class="fa-solid fa-signature"></i>
            </button>
            <button class="perfil-icon-btn" onclick="switchTab('seguridad')" title="Cambiar contraseña">
                <i class="fas fa-lock"></i>
            </button>
            <button class="perfil-icon-btn" onclick="switchTab('tema')" title="Personalizar tema">
                <i class="fas fa-palette"></i>
            </button>
        </div>
    </div>
    <br />

    @* ═══ TABS ═══*@

    <div class="perfil-tabs-wrap">
        <div class="perfil-tabs" role="tablist">
            <button class="perfil-tab active" data-tab="info" onclick="switchTab('info')" role="tab">
                <i class="fas fa-user"></i> Información
            </button>
            <button class="perfil-tab" data-tab="actividad" onclick="switchTab('actividad')" role="tab">
                <i class="fas fa-history"></i> Actividad
            </button>
            <button class="perfil-tab" data-tab="documentos" onclick="switchTab('documentos')" role="tab">
                <i class="fas fa-file-invoice"></i> Documentos
            </button>
            <button class="perfil-tab" data-tab="seguridad" onclick="switchTab('seguridad')" role="tab">
                <i class="fas fa-shield-alt"></i> Seguridad
            </button>
            <button class="perfil-tab" data-tab="tema" onclick="switchTab('tema')" role="tab">
                <i class="fas fa-palette"></i> Tema
            </button>
        </div>


        @* ─── Panel: Información ───*@

        <div class="perfil-panel active" id="panel-info" role="tabpanel">
            <div class="perfil-grid2">

                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-id-badge"></i> Datos personales</div>
                    <div class="pi-field">
                        <span class="pi-field-label"><i class="fas fa-envelope"></i> Email</span>
                        <span class="pi-field-val">@Context.Session.GetString("Correo")</span>
                    </div>
                    <div class="pi-field">
                        <span class="pi-field-label"><i class="fas fa-users"></i> Área</span>
                        <span class="pi-field-val">@Utilities.GetAreaName(User.Identity.Name)</span>
                    </div>
                    <div class="pi-field">
                        <span class="pi-field-label"><i class="fas fa-user-shield"></i> Rol</span>
                        <span class="pi-field-val">@Context.Session.GetInt32("Rol")</span>
                    </div>
                    <div class="pi-field">
                        <span class="pi-field-label"><i class="fas fa-building"></i> Empresa</span>
                        <span class="pi-field-val">@Context.Session.GetString("EmpresaFactura")</span>
                    </div>
                    <div class="pi-field">
                        <span class="pi-field-label"><i class="fas fa-circle"></i> Estado</span>
                        <span class="pi-field-val">
                            <span class="pi-badge pi-badge-success">
                                <i class="fas fa-check" style="font-size:.65rem"></i> Activo
                            </span>
                        </span>
                    </div>
                </div>

                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-laptop"></i> Sesiones activas</div>
                    @if (ViewBag.Sesiones != null && ViewBag.Sesiones.Count > 0)
                    {
                        string cookieActual = Context.Request.Cookies["DeviceIdentifier"] ?? "";
                        foreach (var s in ViewBag.Sesiones)
                        {
                            string deviceId = s["deviceidentifier"]?.ToString() ?? "Desconocido";
                            string lastAct = ((DateTime)s["lastactivity"]).ToString("dd/MM/yyyy HH:mm");
                            bool esCurrent = deviceId == cookieActual;
                            string deviceShort = deviceId.Length > 16
                                ? deviceId.Substring(0, 8) + "…" + deviceId.Substring(deviceId.Length - 8)
                                : deviceId;
                            <div class="pi-session">
                                <div class="pi-session-icon">
                                    <i class="fas fa-desktop"></i>
                                </div>
                                <div class="pi-session-meta">
                                    <div class="pi-session-device">@deviceShort</div>
                                    <div class="pi-session-time">
                                        <i class="fas fa-clock" style="font-size:.65rem"></i> @lastAct
                                    </div>
                                </div>
                                @if (esCurrent)
                                {
                                    <span class="pi-badge pi-badge-success" style="font-size:.7rem">
                                        <i class="fas fa-circle" style="font-size:.5rem"></i> Este dispositivo
                                    </span>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center mt-3" style="font-size:.82rem">
                            No hay sesiones activas registradas.
                        </p>
                    }
                </div>

            </div>
        </div>


        @* ─── Panel: Actividad ───*@

        <div class="perfil-panel" id="panel-actividad" role="tabpanel">
            <div class="perfil-grid2">

                <div class="pi-card perfil-grid2-full">
                    <div class="pi-card-title"><i class="fas fa-chart-bar"></i> Mi actividad — últimos 14 días</div>
                    <div class="pi-chart-wrap">
                        <canvas id="chartActividad"></canvas>
                    </div>
                </div>

                <div class="pi-card perfil-grid2-full">
                    <div class="pi-card-title"><i class="fas fa-history"></i> Actividad reciente</div>
                    @if (ViewBag.Movimientos != null && ViewBag.Movimientos.Count > 0)
                    {
                        foreach (var mov in ViewBag.Movimientos)
                        {
                            <div class="pi-act">
                                <div class="pi-act-dot">
                                    <i class="fas fa-cogs"></i>
                                </div>
                                <div>
                                    <div class="pi-act-text">
                                        @Html.Encode(mov["accion"]) en <strong>@Html.Encode(mov["modulo"])</strong>
                                    </div>
                                    <div class="pi-act-time">
                                        <i class="fas fa-clock" style="font-size:.65rem"></i>
                                        @Html.Encode(ObtenerTiempoRelativo((DateTime)mov["fecha"]))
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center" style="font-size:.82rem; padding:1rem 0">
                            No hay actividades recientes.
                        </p>
                    }
                </div>

            </div>
        </div>


        @* ─── Panel: Documentos ───*@

        <div class="perfil-panel" id="panel-documentos" role="tabpanel">
            <div class="pi-card">
                <div class="pi-card-title"><i class="fas fa-file-invoice"></i> Documentos pendientes</div>
                @if (ViewBag.Documentos != null && ViewBag.Documentos.Count > 0)
                {
                    foreach (var doc in ViewBag.Documentos)
                    {
                        string docId = doc["id_encabezado"]?.ToString() ?? "-";
                        string fecha = ((DateTime)doc["fch"]).ToString("dd/MM/yyyy");
                        string estatusId = doc["estatus_id"]?.ToString() ?? "-";

                        <div class="pi-doc">
                            <div class="pi-doc-icon">
                                <i class="fas fa-file-invoice"></i>
                            </div>
                            <div style="flex:1; min-width:0">
                                <div class="pi-doc-id">#@docId</div>
                                <div class="pi-doc-date">
                                    <i class="fas fa-calendar-alt" style="font-size:.65rem"></i> @fecha
                                </div>
                            </div>
                            <span class="pi-badge pi-badge-warn">Estatus @estatusId</span>
                            <a href="/Documentos/Ver/@docId" class="pi-doc-link" title="Ver documento">
                                <i class="fas fa-eye"></i>
                            </a>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center" style="font-size:.82rem; padding:1rem 0">
                        <i class="fas fa-check-circle text-success me-1"></i>
                        No tienes documentos pendientes.
                    </p>
                }
            </div>
        </div>


        @* ─── Panel: Seguridad ───*@

        <div class="perfil-panel" id="panel-seguridad" role="tabpanel">
            <div class="perfil-grid2">


                @* Cambiar contraseña*@

                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-lock"></i> Cambiar contraseña</div>

                    <div class="pi-pass-group">
                        <div class="pi-pass-label"><i class="fas fa-key"></i> Contraseña actual</div>
                        <div class="input-group">
                            <input type="password" id="contrasenaActual" class="form-control form-control-sm"
                                   placeholder="Ingresa tu contraseña actual" />
                            <button class="btn btn-outline-secondary btn-sm toggle-pass"
                                    type="button" data-target="contrasenaActual">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="pi-pass-group">
                        <div class="pi-pass-label"><i class="fas fa-lock"></i> Nueva contraseña</div>
                        <div class="input-group">
                            <input type="password" id="nuevaContrasena" class="form-control form-control-sm"
                                   placeholder="Mínimo 6 caracteres" />
                            <button class="btn btn-outline-secondary btn-sm toggle-pass"
                                    type="button" data-target="nuevaContrasena">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="pi-pass-group">
                        <div class="pi-pass-label"><i class="fas fa-check-circle"></i> Confirmar contraseña</div>
                        <div class="input-group">
                            <input type="password" id="confirmarContrasena" class="form-control form-control-sm"
                                   placeholder="Repite la nueva contraseña" />
                            <button class="btn btn-outline-secondary btn-sm toggle-pass"
                                    type="button" data-target="confirmarContrasena">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                    </div>

                    <div class="pi-btn-row">
                        <button class="pi-btn pi-btn-primary" onclick="guardarNuevaContrasena()">
                            <i class="fas fa-save me-1"></i> Guardar contraseña
                        </button>
                    </div>
                </div>


                @* Gestión de sesiones*@

                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-shield-alt"></i> Gestión de sesiones</div>

                    @if (ViewBag.Sesiones != null && ViewBag.Sesiones.Count > 0)
                    {
                        string cookieActual2 = Context.Request.Cookies["DeviceIdentifier"] ?? "";
                        bool hayOtras = false;
                        foreach (var s in ViewBag.Sesiones)
                        {
                            string deviceId2 = s["deviceidentifier"]?.ToString() ?? "Desconocido";
                            string lastAct2 = ((DateTime)s["lastactivity"]).ToString("dd/MM/yyyy HH:mm");
                            bool esCurrent2 = deviceId2 == cookieActual2;
                            string deviceShort2 = deviceId2.Length > 16
                                ? deviceId2.Substring(0, 8) + "…" + deviceId2.Substring(deviceId2.Length - 8)
                                : deviceId2;

                            if (!esCurrent2) { hayOtras = true; }

                            <div class="pi-session">
                                <div class="pi-session-icon">
                                    <i class="fas fa-desktop"></i>
                                </div>
                                <div class="pi-session-meta">
                                    <div class="pi-session-device">@deviceShort2</div>
                                    <div class="pi-session-time">
                                        <i class="fas fa-clock" style="font-size:.65rem"></i> @lastAct2
                                    </div>
                                </div>
                                @if (esCurrent2)
                                {
                                    <span class="pi-badge pi-badge-success" style="font-size:.7rem">Actual</span>
                                }
                                else
                                {
                                    <button class="pi-btn pi-btn-danger"
                                            style="padding:3px 10px; font-size:.72rem"
                                            onclick="cerrarSesion('@deviceId2')">
                                        Cerrar
                                    </button>
                                }
                            </div>
                        }
                        if (hayOtras)
                        {
                            <div class="pi-btn-row">
                                <button class="pi-btn pi-btn-danger" onclick="cerrarTodasSesiones()">
                                    <i class="fas fa-sign-out-alt me-1"></i> Cerrar todas las otras sesiones
                                </button>
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted text-center" style="font-size:.82rem; padding:1rem 0">
                            No hay otras sesiones activas.
                        </p>
                    }
                </div>

            </div>
        </div>

        @* ─── Panel: Apariencia (Tema + Sidebar fusionados) ───*@
        <div class="perfil-panel" id="panel-tema" role="tabpanel">

            @* Sub-tabs internos *@
            <div class="pi-subtabs" role="tablist">
                <button class="pi-subtab active" data-subtab="rapido" onclick="switchSubTab('rapido')">
                    <i class="fas fa-bolt"></i> Estilo rápido
                </button>
                <button class="pi-subtab" data-subtab="colores" onclick="switchSubTab('colores')">
                    <i class="fas fa-droplet"></i> Colores
                </button>
                <button class="pi-subtab" data-subtab="efectos" onclick="switchSubTab('efectos')">
                    <i class="fas fa-sparkles"></i> Efectos
                </button>
                <button class="pi-subtab" data-subtab="sidebar" onclick="switchSubTab('sidebar')">
                    <i class="fas fa-table-columns"></i> Barra lateral
                </button>
            </div>

            @* ═══ SUB-TAB: ESTILO RÁPIDO ═══ *@
            <div class="pi-subpanel active" id="subtema-rapido">
                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-magic"></i> Elige un estilo predefinido</div>
                    <p class="pi-help-text">Aplica una combinación completa de colores con un clic. Puedes ajustarla después en "Colores".</p>

                    <div class="pi-preset-grid">
                        @foreach (var preset in presets)
                        {
                            string iconoPreset = preset.Key switch
                            {
                                "navidad" => "🎄",
                                "verano" => "☀️",
                                "aurora" => "🌌",
                                "bosque" => "🌿",
                                "amanecer" => "🌄",
                                "oceano" => "🌊",
                                "anochecer" => "🔮",
                                "carbon" => "🖤",
                                _ => "🔵"
                            };
                            string activeClass = tema?.PresetNombre == preset.Key ? "active" : "";
                            <button class="pi-preset-card @activeClass" onclick="aplicarPreset('@preset.Key')">
                                <span class="pi-preset-emoji">@iconoPreset</span>
                                <span class="pi-preset-name">@System.Globalization.CultureInfo.CurrentCulture.TextInfo.ToTitleCase(preset.Key)</span>
                                @if (activeClass == "active")
                                {
                                    <span class="pi-preset-check"><i class="fas fa-check"></i></span>
                                }
                            </button>
                        }
                    </div>

                    <div class="pi-btn-row">
                        <button class="pi-btn pi-btn-danger" onclick="aplicarPreset('default')">
                            <i class="fas fa-undo me-1"></i> Restaurar valores por defecto
                        </button>
                    </div>
                </div>
            </div>

            @* ═══ SUB-TAB: COLORES ═══ *@
            <div class="pi-subpanel" id="subtema-colores">
                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-droplet"></i> Personalizar colores</div>
                    <p class="pi-help-text">Estos son los colores más visibles de tu interfaz. Haz clic en el círculo para elegir un color nuevo.</p>

                    @* Modo claro / oscuro como sub-sub-tabs simples *@
                    <div class="pi-mode-switch">
                        <button class="pi-mode-btn active" data-mode="light" onclick="switchColorMode('light')">
                            <i class="fas fa-sun"></i> Modo claro
                        </button>
                        <button class="pi-mode-btn" data-mode="dark" onclick="switchColorMode('dark')">
                            <i class="fas fa-moon"></i> Modo oscuro
                        </button>
                    </div>

                    @* ── Colores esenciales (modo claro) ── *@
                    <div class="pi-color-mode-panel active" id="colormode-light">
                        <div class="pi-color-grid-simple">
                            @{
                                var esencialesLight = camposLight.Where(c =>
                                    c.Item1 == "primary_blue" || c.Item1 == "accent_blue" ||
                                    c.Item1 == "bg_light" || c.Item1 == "text_dark");
                            }
                            @foreach (var (campo, label, valor) in esencialesLight)
                            {
                                <div class="pi-color-field-simple">
                                    <input type="color" class="color-picker" id="cp_@campo"
                                           value="@valor" data-campo="@campo" />
                                    <div class="pi-color-field-info">
                                        <label>@label</label>
                                        <input type="text" class="color-hex" id="hex_@campo"
                                               value="@valor" maxlength="7" />
                                    </div>
                                </div>
                            }
                        </div>

                        <details class="pi-advanced">
                            <summary><i class="fas fa-sliders"></i> Más opciones de color (avanzado)</summary>
                            <div class="pi-color-grid">
                                @{
                                    var avanzadosLight = camposLight.Where(c =>
                                        c.Item1 != "primary_blue" && c.Item1 != "accent_blue" &&
                                        c.Item1 != "bg_light" && c.Item1 != "text_dark");
                                }
                                @foreach (var (campo, label, valor) in avanzadosLight)
                                {
                                    <div class="pi-color-field">
                                        <label>@label</label>
                                        <div class="pi-color-row">
                                            <input type="color" class="color-picker" id="cp_@campo"
                                                   value="@valor" data-campo="@campo" />
                                            <input type="text" class="color-hex" id="hex_@campo"
                                                   value="@valor" maxlength="7" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </details>
                    </div>

                    @* ── Colores (modo oscuro) ── *@
                    <div class="pi-color-mode-panel" id="colormode-dark">
                        <div class="pi-color-grid-simple">
                            @{
                                var esencialesDark = camposDark.Where(c =>
                                    c.Item1 == "dark_primary_blue" || c.Item1 == "dark_accent_blue" ||
                                    c.Item1 == "dark_bg_light" || c.Item1 == "dark_text_dark");
                            }
                            @foreach (var (campo, label, valor) in esencialesDark)
                            {
                                <div class="pi-color-field-simple">
                                    <input type="color" class="color-picker" id="cp_@campo"
                                           value="@valor" data-campo="@campo" />
                                    <div class="pi-color-field-info">
                                        <label>@label</label>
                                        <input type="text" class="color-hex" id="hex_@campo"
                                               value="@valor" maxlength="7" />
                                    </div>
                                </div>
                            }
                        </div>

                        <details class="pi-advanced">
                            <summary><i class="fas fa-sliders"></i> Más opciones de color (avanzado)</summary>
                            <div class="pi-color-grid">
                                @{
                                    var avanzadosDark = camposDark.Where(c =>
                                        c.Item1 != "dark_primary_blue" && c.Item1 != "dark_accent_blue" &&
                                        c.Item1 != "dark_bg_light" && c.Item1 != "dark_text_dark");
                                }
                                @foreach (var (campo, label, valor) in avanzadosDark)
                                {
                                    <div class="pi-color-field">
                                        <label>@label</label>
                                        <div class="pi-color-row">
                                            <input type="color" class="color-picker" id="cp_@campo"
                                                   value="@valor" data-campo="@campo" />
                                            <input type="text" class="color-hex" id="hex_@campo"
                                                   value="@valor" maxlength="7" />
                                        </div>
                                    </div>
                                }
                            </div>
                        </details>
                    </div>

                    <div class="pi-btn-row">
                        <button class="pi-btn pi-btn-primary" onclick="guardarTema()">
                            <i class="fas fa-save me-1"></i> Guardar colores
                        </button>
                        <button class="pi-btn" onclick="previsualizarTema()">
                            <i class="fas fa-eye me-1"></i> Previsualizar
                        </button>
                    </div>
                </div>
            </div>

            @* ═══ SUB-TAB: EFECTOS (Partículas) ═══ *@
            <div class="pi-subpanel" id="subtema-efectos">
                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-sparkles"></i> Partículas de fondo</div>
                    <p class="pi-help-text">Agrega un efecto visual animado de fondo en toda la plataforma.</p>

                    <div class="pi-toggle-row">
                        <label class="pi-toggle-switch">
                            <input type="checkbox" id="part_activas"
                            @(tema?.ParticulasActivas == true ? "checked" : "")
                                   onchange="previewParticulas()" />
                            <span class="pi-toggle-slider"></span>
                        </label>
                        <span class="pi-toggle-label">Activar partículas</span>
                    </div>

                    <div id="part_opciones" style="@(tema?.ParticulasActivas == true ? "" : "opacity:.4;pointer-events:none;")">

                        <div class="pi-pass-group">
                            <div class="pi-pass-label">
                                <i class="fas fa-sort-amount-up"></i> Cantidad
                                <span id="part_cantidad_val" style="margin-left:6px;font-weight:700;color:var(--accent-blue)">
                                    @(tema?.ParticulasCantidad ?? 200)
                                </span>
                            </div>
                            <input type="range" id="part_cantidad" min="50" max="500" step="10"
                                   value="@(tema?.ParticulasCantidad ?? 200)"
