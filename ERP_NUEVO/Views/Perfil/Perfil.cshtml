                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;" id="part_formas">
                                @foreach (var f in new[] {
                            ("circle","Círculo","fa-circle"),
                            ("star","Estrella","fa-star"),
                            ("triangle","Triángulo","fa-play"),
                            ("square","Cuadrado","fa-square"),
                            ("plus","Cruz","fa-plus"),
                        })
                                {
                                    <button type="button"
                                            class="pi-preset-btn @(tema?.ParticulasForma == f.Item1 ? "active" : "")"
                                            data-forma="@f.Item1"
                                            onclick="selectForma(this)">
                                        <i class="fas @f.Item3"></i> @f.Item2
                                    </button>
                                }
                            </div>
                        </div>

                        <div class="pi-pass-group">
                            <div class="pi-pass-label"><i class="fas fa-palette"></i> Color de partículas</div>
                            <div style="display:flex;gap:.5rem;flex-wrap:wrap;" id="part_presets">
                                @foreach (var p in new[] {
                            ("theme","🎨 Tema actual"),
                            ("snow","❄️ Nieve"),
                            ("fire","🔥 Fuego"),
                            ("matrix","💚 Matrix"),
