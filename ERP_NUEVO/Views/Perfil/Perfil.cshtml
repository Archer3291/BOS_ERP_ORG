                                    <button type="button"
                                            class="pi-preset-btn @(tema?.ParticulasPreset == p.Item1 ? "active" : "")"
                                            data-ppreset="@p.Item1"
                                            onclick="selectPartPreset(this)">
                                        @p.Item2
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="pi-btn-row">
                        <button class="pi-btn pi-btn-primary" onclick="guardarTema()">
                            <i class="fas fa-save me-1"></i> Guardar efectos
                        </button>
                    </div>
                </div>
            </div>

            @* ═══ SUB-TAB: SIDEBAR ═══ *@
            @{
                var sb = tema;
            }
            <div class="pi-subpanel" id="subtema-sidebar">
                <div class="pi-card">
                    <div class="pi-card-title"><i class="fas fa-table-columns"></i> Barra lateral</div>
                    <p class="pi-help-text">Ajusta cómo se ve y se comporta el menú lateral.</p>

                    <div class="pi-pass-group" style="margin-bottom:.9rem">
                        <div class="pi-pass-label"><i class="fas fa-table-cells-large"></i> Tipo de layout</div>
                        <div style="display:flex;gap:.5rem;flex-wrap:wrap" id="sb_layout_wrap">
                            @foreach (var lay in new[] {
                                ("sidebar", "fa-table-columns",   "Barra lateral"),
                                ("hybrid",  "fa-window-restore",  "Híbrido (header + lateral)"),
                                ("compact", "fa-ellipsis-vertical","Compacto (iconos)"),
                                ("topbar",  "fa-window-maximize", "Barra superior")
                            })
                            {
                                <button type="button"
                                        class="pi-preset-btn @((sb?.LayoutTipo ?? "sidebar") == lay.Item1 ? "active" : "")"
                                        data-layout="@lay.Item1" onclick="selectLayout(this)">
                                    <i class="fa-solid @lay.Item2" style="font-size:.9rem"></i> @lay.Item3
                                </button>
