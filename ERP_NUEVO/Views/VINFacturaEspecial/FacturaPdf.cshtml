        /* ESTILOS PARA SECCIÓN DE COMERCIO EXTERIOR */

/* ============================================
   COMERCIO EXTERIOR - DISEÑO LIMPIO Y PROFESIONAL
   ============================================ */

.comercio-exterior-box {
    background: #ffffff;
    border: 3px solid #1976d2;
    border-radius: 6px;
    padding: 0;
    margin: 20px 0;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    page-break-inside: avoid;
}

/* Header del complemento */
.comercio-exterior-title {
    font-size: 14px;
    color: #0d47a1;
    background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
    margin: 0;
    padding: 12px 15px;
    font-weight: bold;
    text-transform: uppercase;
    letter-spacing: 0.8px;
    border-bottom: 4px solid #1976d2;
    border-top: 2px solid #1976d2;
}

.comercio-exterior-title::before {
    margin-right: 8px;
    font-size: 16px;
}

/* Contenedor de datos generales */
.ce-datos-generales {
    padding: 15px;
    background-color: #fafafa;
    border-bottom: 2px solid #e0e0e0;
}

.ce-datos-generales table {
    width: 100%;
    font-size: 10px;
    border-collapse: collapse;
}

.ce-datos-generales tr {
    background-color: white;
}

        .ce-datos-generales td {
            padding: 5px 10px; /* bajar de 8px a 5px */
            border: 1px solid #e0e0e0;
        }

.ce-datos-generales td:nth-child(odd) {
    background-color: #e3f2fd;
    font-weight: 700;
    color: #0d47a1;
    width: 25%;
}

.ce-datos-generales td:nth-child(even) {
    width: 25%;
    color: #1a1a1a;
}

.ce-datos-generales strong {
    color: #0d47a1;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    display: block;
}

/* Subsecciones */
.ce-subsection {
    margin: 0;
    padding: 15px;
    background-color: #fafafa;
    border-top: 2px solid #e0e0e0;
}

.ce-subsection-title {
    font-weight: bold;
    color: #0d47a1;
    background: linear-gradient(90deg, #e3f2fd 0%, #bbdefb 100%);
    margin: -15px -15px 15px -15px;
    padding: 10px 15px;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-left: 5px solid #1976d2;
    border-bottom: 2px solid #1976d2;
}

.ce-subsection-title::before {
    margin-right: 6px;
    font-size: 14px;
    color: #1976d2;
}

/* Tablas dentro de subsecciones */
.ce-subsection table {
    width: 100%;
    font-size: 10px;
    border-collapse: collapse;
    background-color: white;
}

.ce-subsection tr {
    background-color: white;
}

        .ce-subsection td {
            padding: 5px 10px; /* bajar de 8px a 5px */
            border: 1px solid #e0e0e0;
            color: #1a1a1a;
        }

.ce-subsection td:nth-child(odd) {
    background-color: #e3f2fd;
    font-weight: 700;
    color: #0d47a1;
    width: 20%;
}

.ce-subsection td:nth-child(even) {
    width: 30%;
}

.ce-subsection strong {
    color: #0d47a1;
    font-size: 9px;
    text-transform: uppercase;
    display: block;
}

/* Tabla de mercancías estilizada */
.ce-subsection .productos {
    margin-top: 10px;
    border: 2px solid #1976d2;
    border-radius: 4px;
    overflow: hidden;
    background-color: white;
}

.ce-subsection .productos thead {
    background: linear-gradient(135deg, #1976d2 0%, #1565c0 100%);
}

.ce-subsection .productos th {
    background: #0d47a1;
    color: #ffffff;
    padding: 8px 10px;
    font-size: 9px;
    text-transform: uppercase;
    letter-spacing: 0.3px;
    font-weight: bold;
    border: none;
}

.ce-subsection .productos tbody tr {
    background-color: white;
}

.ce-subsection .productos tbody tr:nth-child(even) {
    background-color: #f5f5f5;
}

.ce-subsection .productos td {
    font-size: 9px;
    padding: 7px 10px;
    border: 1px solid #e0e0e0;
    border-left: none;
    border-right: none;
    color: #1a1a1a;
}

/* Valores destacados */
.ce-valor-destacado {
    color: #0d47a1;
    font-weight: bold;
    font-size: 10px;
    background-color: #e3f2fd;
    padding: 2px 6px;
    border-radius: 3px;
    border-left: 3px solid #1976d2;
    display: inline-block;
}

/* Badge para moneda */
.ce-badge-moneda {
    display: inline-block;
    background: linear-gradient(135deg, #43a047 0%, #66bb6a 100%);
    color: #ffffff;
    padding: 2px 7px;
    border-radius: 3px;
    font-size: 8px;
    font-weight: bold;
    text-transform: uppercase;
    margin-left: 4px;
    box-shadow: 0 1px 3px rgba(67, 160, 71, 0.3);
}

/* Info boxes */
.ce-info-box {
    background-color: #fff8e1;
    border-left: 5px solid #ffa726;
    padding: 10px;
    margin: 10px 0;
    border-radius: 3px;
    font-size: 10px;
    color: #1a1a1a;
}

.ce-info-box strong {
    color: #e65100;
}

/* Iconos decorativos */
.ce-icon-moneda::before {
    margin-right: 5px;
}

/* Responsive para impresión */
@@media print {
    .comercio-exterior-box {
        page-break-inside: avoid;
        box-shadow: none;
        border-radius: 0;
    }

    .ce-subsection {
        page-break-inside: avoid;
    }

    /* Asegurar que los colores se impriman correctamente */
    .comercio-exterior-title {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .ce-subsection-title {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }

    .ce-subsection .productos th {
        -webkit-print-color-adjust: exact;
        print-color-adjust: exact;
    }
}
    </style>
</head>
<body>
    <!-- DATOS COMPROBANTE -->
    <div class="section-title">Datos de importador</div>
    <table>
        <tr>
            <td style="width: 18%;"><strong>Fecha de Emisión:</strong></td>
            <td style="width: 32%;">@DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td style="width: 18%;"><strong>Tipo de Comprobante:</strong></td>
            <td style="width: 32%;">@Model.TipoDeComprobante</td>
        </tr>
        <tr>
            <td><strong>Forma de Pago:</strong></td>
            <td>@Model.IdTipoPago -- @Model.formaPagoTexto</td>
            <td><strong>Método de Pago:</strong></td>
            <td>@Model.metodoPagoTexto -- @Model.MdpFactura</td>
        </tr>
        <tr>
            <td><strong>Moneda:</strong></td>
            <td>@Model.Moneda</td>
            <td><strong>Tipo de Cambio:</strong></td>
            <td>@Model.TipoCambio</td>
        </tr>
    </table>

    <!-- RECEPTOR -->
    <div class="section-title">Receptor</div>
    <div class="info-box">
        <table style="width: 100%;">
            <tr>
                <td style="width: 18%;"><strong>RFC:</strong></td>
                <td style="width: 32%;">@Model.RfcCliente</td>
                <td style="width: 18%;"><strong>Régimen Fiscal:</strong></td>
                <td style="width: 32%;">@Model.Regc</td>
            </tr>
            <tr>
                <td style="width: 18%;"><strong>Razón Social:</strong></td>
                <td style="width: 32%;">@Model.RsoCliente</td>
                <td style="width: 18%;"><strong>Uso CFDI:</strong></td>
                <td style="width: 32%;">@Model.IdUsoCFDI -- @Model.CFDIText</td>
            </tr>
            <tr>
                <td style="width: 18%; vertical-align:top;"><strong>Dirección:</strong></td>
                <td style="width: 32%; white-space: pre-line;">@Model.DireccionReceptor</td>
                <td style="width: 18%; vertical-align:top;"><strong>Domicilio Fiscal (C.P.):</strong></td>
                <td style="width: 32%; vertical-align:top;">@Model.CpR</td>
            </tr>
        </table>
    </div>

    <!-- CONCEPTOS -->
    <div class="section-title">Conceptos</div>
    <table class="productos">
        <thead class="table-light">
            <tr>
                <th style="width: 10%;">No. Identificación</th>
                <th style="@(tieneClavesCliente ? "width: 48%;" : "width: 96%;")">Descripción</th>
                @if (tieneClavesCliente)
                {
                    <th style="width: 38%;">Cve. Cliente</th>
                }
                <th style="width: 10%;">Cantidad</th>
                <th style="width: 10%;">Unidad</th>
                <th style="width: 14%;">Precio Unitario</th>
                <th style="width: 18%;">Importe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Tproductos.Rows)
            {
                <tr>
                    <td class="numero">@row["numero"]</td>
                    <td class="descripcion">
                        <strong>@row["descripcion"]</strong>
                        <br><small style="color: #888;">
                            Clave Prod/Serv: @row["claveProdServ"] |
                            Clave Unidad: @row["claveUnidad"] |
                            Objeto Imp: @row["objetoImp"]
                        </small>
                        @if (!string.IsNullOrWhiteSpace(row["comentario"]?.ToString()))
                        {
                            <br><small style="color: #555; font-style: italic;">
                                @row["comentario"]
                            </small>
                        }
                        @if (!string.IsNullOrWhiteSpace(row["pedimento"]?.ToString()))
                        {
                            <br><small style="color: #0d47a1; font-weight: bold; background-color: #e3f2fd; padding: 2px 5px; border-radius: 3px; display: inline-block; margin-top: 3px;">
                                Pedimento: @row["pedimento"]
                            </small>
                        }
                    </td>
                    @if (tieneClavesCliente)
                    {
                        <td class="descripcion">@row["clave_cliente"]</td>
                    }
                    @{
                        double descPct = row.Table.Columns.Contains("descuento")
                            ? Convert.ToDouble(row["descuento"]) : 0.0;
                        double cantidad = Convert.ToDouble(row["cantidad"]);
                        double precioUnit = Convert.ToDouble(row["precioUnit"]);
                        double importeBruto = cantidad * precioUnit;
                        double montoDescuento = Math.Round(importeBruto * descPct / 100, 2);
                        double importeNeto = importeBruto - montoDescuento;
                        // Precio unitario ya con el descuento aplicado; el desglose del
                        // descuento vive unicamente en el bloque de totales.
                        double precioUnitNeto = precioUnit * (1 - descPct / 100);
                    }

                    <td class="cantidad">@string.Format("{0:N2}", row["cantidad"])</td>
                    <td class="numero">@row["unidad"]</td>
                    <td class="precio">@string.Format("{0:C2}", precioUnitNeto)</td>
                    <td class="importe">@string.Format("{0:C2}", importeNeto)</td>
                </tr>
            }

            @* Flete si existe *@
            @if (Model.Flete > 0)
            {
                <tr class="flete-row">
                    <td class="numero">FLETE</td>
                    <td class="descripcion">
                        <strong>Servicio de flete</strong>
                        <br><small style="color: #888;">Clave Prod/Serv: 78101800 | Clave Unidad: E48 | Objeto Imp: 02</small>
                    </td>
                    @if (tieneClavesCliente)
                    {
                        <td class="descripcion"></td>
                    }
                    <td class="cantidad">1.00</td>
                    <td class="numero">Servicio</td>
                    <td class="precio">@string.Format("{0:C2}", Model.Flete)</td>
                    <td class="importe">@string.Format("{0:C2}", Model.Flete)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- COMERCIO EXTERIOR - DISEÑO DINÁMICO SIN ESPACIOS VACÍOS -->
    @if (Model.ComercioExterior != null)
    {
        var ce = Model.ComercioExterior;
        <div class="comercio-exterior-box">
            <div class="comercio-exterior-title">Complemento de Comercio Exterior v@(ce.Version ?? "2.0")</div>

            <!-- DATOS GENERALES - LAYOUT COMPLETAMENTE DINÁMICO -->
            <div class="ce-datos-generales">
                <table>
                    @{
                        // Crear lista de campos con datos
                        var camposGenerales = new List<(string Label, string Valor)>();

                        if (!string.IsNullOrEmpty(ce.MotivoTraslado))
                        { camposGenerales.Add(("Motivo Traslado", ce.MotivoTraslado)); }

                        if (!string.IsNullOrEmpty(ce.ClaveDePedimento))
                        { camposGenerales.Add(("Clave Pedimento", ce.ClaveDePedimento)); }

                        if (!string.IsNullOrEmpty(ce.Incoterm))
                        { camposGenerales.Add(("Incoterm", ce.Incoterm)); }

                        if (!string.IsNullOrEmpty(ce.CertificadoOrigen))
                        { camposGenerales.Add(("Certificado Origen", ce.CertificadoOrigen + (!string.IsNullOrEmpty(ce.NumCertificadoOrigen) ? $" - {ce.NumCertificadoOrigen}" : ""))); }

                        if (!string.IsNullOrEmpty(ce.NumeroExportadorConfiable))
                        { camposGenerales.Add(("Exportador Confiable", ce.NumeroExportadorConfiable)); }

                        if (ce.TipoCambioUSD > 0)
                        { camposGenerales.Add(("Tipo Cambio USD", ce.TipoCambioUSD.ToString("N4"))); }

                        // Renderizar en filas de 2 columnas
                        for (int i = 0; i < camposGenerales.Count; i += 2)
                        {
                            <tr>
                                <td style="width: 25%;"><strong>@camposGenerales[i].Label</strong></td>
                                <td style="width: 25%;">@camposGenerales[i].Valor</td>

                                @if (i + 1 < camposGenerales.Count)
                                {
                                    <td style="width: 25%;"><strong>@camposGenerales[i + 1].Label</strong></td>
                                    <td style="width: 25%;">@camposGenerales[i + 1].Valor</td>
                                }
                                else
                                {
                                    <td colspan="2" style="border: none; background: transparent;"></td>
                                }
                            </tr>
                        }

                        // Fila especial de totales USD. El complemento se timbra sobre el
                        // importe BRUTO, asi que se muestran los dos: el total del complemento
                        // y ese mismo total ya con el descuento aplicado.
                        if (ce.TipoCambioUSD > 0)
                        {
                            decimal totalUsdConDescuento = Math.Round(
                                ce.TotalUSD * (decimal)factorDescuentoGlobal,
                                2, MidpointRounding.AwayFromZero);

                            <tr style="background: linear-gradient(to right, #e8f5e9 0%, #c8e6c9 100%) !important;">
                                <td><strong class="ce-icon-moneda">Total USD</strong></td>
                                <td>
                                    <span class="ce-valor-destacado">$@ce.TotalUSD.ToString("N2")</span>
                                    <span class="ce-badge-moneda">USD</span>
                                </td>
                                <td><strong class="ce-icon-moneda">Total USD con Descuento</strong></td>
                                <td>
                                    <span class="ce-valor-destacado">$@totalUsdConDescuento.ToString("N2")</span>
                                    <span class="ce-badge-moneda">USD</span>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>

            <!-- DOMICILIO EMISOR - COMPLETAMENTE DINÁMICO -->
            @if (ce.DomicilioEmisor != null)
            {
                var domE = ce.DomicilioEmisor;
                var camposDomEmisor = new List<(string Label, string Valor)>();

                if (!string.IsNullOrEmpty(domE.Calle))
                { camposDomEmisor.Add(("Calle", domE.Calle)); }

                if (!string.IsNullOrEmpty(domE.NumeroExterior))
                { camposDomEmisor.Add(("Número", domE.NumeroExterior)); }

                if (!string.IsNullOrEmpty(domE.Colonia))
                { camposDomEmisor.Add(("Colonia", domE.Colonia)); }

                if (!string.IsNullOrEmpty(domE.CodigoPostal))
                { camposDomEmisor.Add(("C.P.", domE.CodigoPostal)); }

                if (!string.IsNullOrEmpty(domE.Localidad))
                { camposDomEmisor.Add(("Localidad", domE.Localidad)); }

                if (!string.IsNullOrEmpty(domE.Municipio))
                { camposDomEmisor.Add(("Municipio", domE.Municipio)); }

                if (!string.IsNullOrEmpty(domE.Estado))
                { camposDomEmisor.Add(("Estado", domE.Estado)); }

                if (!string.IsNullOrEmpty(domE.Pais))
                { camposDomEmisor.Add(("País", domE.Pais)); }

                if (camposDomEmisor.Any())
                {
                    <div class="ce-subsection">
                        <div class="ce-subsection-title">Cliente/Importador</div>
                        <table>
                            @for (int i = 0; i < camposDomEmisor.Count; i += 2)
                            {
                                <tr>
                                    <td style="width: 20%;"><strong>@camposDomEmisor[i].Label</strong></td>
                                    <td style="width: 30%;">@camposDomEmisor[i].Valor</td>

                                    @if (i + 1 < camposDomEmisor.Count)
                                    {
                                        <td style="width: 20%;"><strong>@camposDomEmisor[i + 1].Label</strong></td>
                                        <td style="width: 30%;">@camposDomEmisor[i + 1].Valor</td>
                                    }
                                    else
                                    {
                                        <td colspan="2" style="border: none; background: transparent;"></td>
                                    }
                                </tr>
                            }
                        </table>
                    </div>
                }
            }

            <!-- DESTINATARIO - COMPLETAMENTE DINÁMICO -->
            @if (!string.IsNullOrEmpty(ce.NumRegIdTrib) || ce.DomicilioDestinatario != null)
            {
                var hayDatosDestinatario = false;
                var camposDomDestinatario = new List<(string Label, string Valor)>();

                if (ce.DomicilioDestinatario != null)
                {
                    var domD = ce.DomicilioDestinatario;

                    if (!string.IsNullOrEmpty(domD.Calle))
                    { camposDomDestinatario.Add(("Calle", domD.Calle)); }

                    if (!string.IsNullOrEmpty(domD.NumeroExterior))
                    { camposDomDestinatario.Add(("Número", domD.NumeroExterior)); }

                    if (!string.IsNullOrEmpty(domD.Colonia))
                    { camposDomDestinatario.Add(("Colonia", domD.Colonia)); }

                    if (!string.IsNullOrEmpty(domD.CodigoPostal))
                    { camposDomDestinatario.Add(("C.P.", domD.CodigoPostal)); }

                    if (!string.IsNullOrEmpty(domD.Localidad))
                    { camposDomDestinatario.Add(("Localidad", domD.Localidad)); }

                    if (!string.IsNullOrEmpty(domD.Municipio))
                    { camposDomDestinatario.Add(("Municipio", domD.Municipio)); }

                    if (!string.IsNullOrEmpty(domD.Estado))
                    { camposDomDestinatario.Add(("Estado", domD.Estado)); }

                    if (!string.IsNullOrEmpty(domD.Pais))
                    { camposDomDestinatario.Add(("País", domD.Pais)); }

                    hayDatosDestinatario = camposDomDestinatario.Any();
                }

                if (!string.IsNullOrEmpty(ce.NumRegIdTrib) || hayDatosDestinatario)
                {
                    <div class="ce-subsection">
                        <div class="ce-subsection-title">Cliente</div>

                        @if (!string.IsNullOrEmpty(ce.NumRegIdTrib))
                        {
                            <div class="ce-info-box">
                                <strong>Registro ID Tributario:</strong> @ce.NumRegIdTrib
                            </div>
                        }

                        @if (hayDatosDestinatario)
                        {
                            <table>
                                @for (int i = 0; i < camposDomDestinatario.Count; i += 2)
                                {
                                    <tr>
                                        <td style="width: 20%;"><strong>@camposDomDestinatario[i].Label</strong></td>
                                        <td style="width: 30%;">@camposDomDestinatario[i].Valor</td>

                                        @if (i + 1 < camposDomDestinatario.Count)
                                        {
                                            <td style="width: 20%;"><strong>@camposDomDestinatario[i + 1].Label</strong></td>
                                            <td style="width: 30%;">@camposDomDestinatario[i + 1].Valor</td>
                                        }
                                        else
                                        {
                                            <td colspan="2" style="border: none; background: transparent;"></td>
                                        }
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                }
            }

            <!-- MERCANCÍAS -->
            @if (ce.Mercancias != null && ce.Mercancias.Any())
            {
                <div class="ce-subsection">
                    <div class="ce-subsection-title">Detalle de Mercancías</div>
                    <table class="productos">
                        <thead>
                            <tr>
                                <th style="width: 12%;">No. Ident.</th>
                                <th style="width: 14%;">Fracción Arancelaria</th>
                                <th style="width: 10%;">Cantidad</th>
                                <th style="width: 10%;">Unidad</th>
                                <th style="width: 14%;">Valor Unit.</th>
                                <th style="width: 14%;">Valor USD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var merc in ce.Mercancias)
                            {
                                // ValorUnitarioAduana viene bruto; se netea para que cuadre
                                // con el Valor USD de la partida, que ya trae el descuento.
                                decimal valorUnitConDesc = Math.Round(
                                    merc.ValorUnitarioAduana * (decimal)factorDescuento(merc.NoIdentificacion),
                                    2, MidpointRounding.AwayFromZero);

                                <tr>
                                    <td class="numero">@merc.NoIdentificacion</td>
                                    <td class="numero">@merc.FraccionArancelaria</td>
                                    <td class="cantidad">@merc.CantidadAduana.ToString("N2")</td>
                                    <td class="numero">@merc.UnidadAduana</td>
                                    <td class="precio">$@valorUnitConDesc.ToString("N2")</td>
                                    <td class="importe">
                                        <span class="ce-valor-destacado">$@merc.ValorDolares.ToString("N2")</span>
                                        <span class="ce-badge-moneda">USD</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- ANTICIPOS RELACIONADOS -->
    @if (Model.TAnticipos != null && Model.TAnticipos.Rows.Count > 0)
    {
        <div class="section-title">CFDIs Relacionados (Anticipos Aplicados)</div>
        <table class="productos">
            <thead>
                <tr>
                    <th>UUID del CFDI</th>
                    <th>Fecha de Aplicación</th>
                    <th>Saldo Antes</th>
                    <th>Monto Aplicado</th>
                    <th>Saldo Después</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.TAnticipos.Rows)
                {
                    <tr style="background-color:#f0f8ff;">
                        <td>@row["uuid"]</td>
                        <td>@Convert.ToDateTime(row["fecha"]).ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="text-align:right;">@string.Format("{0:C2}", row["saldo_antes"])</td>
                        <td style="text-align:right; color:#2e7d32; font-weight:bold;">@string.Format("{0:C2}", row["monto_aplicado"])</td>
                        <td style="text-align:right;">@string.Format("{0:C2}", row["saldo_despues"])</td>
                    </tr>
                }

                <!-- Total de anticipos -->
                <tr style="background-color:#e3f2fd; font-weight:bold;">
                    <td colspan="3" style="text-align:right;">TOTAL ANTICIPOS APLICADOS:</td>
                    <td colspan="2" style="text-align:right; color:#d32f2f;">
                        @string.Format("{0:C2}", Model.TAnticipos.AsEnumerable().Sum(r => Convert.ToDecimal(r["monto_aplicado"])))
                    </td>
                </tr>
            </tbody>
        </table>
    }


    <!-- OBSERVACIONES -->
    @if (!string.IsNullOrEmpty(Model.Observaciones))
    {
        <div class="observaciones-box">
            <strong>Observaciones:</strong> @Model.Observaciones
        </div>
    }

    @{
        decimal totalAnticipos = 0;
        if (Model.TAnticipos != null && Model.TAnticipos.Rows.Count > 0)
        {
            totalAnticipos = Model.TAnticipos.AsEnumerable().Sum(r => Convert.ToDecimal(r["monto_aplicado"]));
        }
        decimal totalNeto = Model.Total - totalAnticipos;
    }

    <!-- TOTALES MEJORADOS -->
    <table class="totales-table" style="width: 100%; margin-top: 20px; border-collapse: collapse;">
        <tr>
            <!-- TOTAL CON LETRA -->
            <td style="width: 60%; vertical-align: top; padding-right: 20px;">
                <strong>Total con Letra:</strong><br>
                @{
                    string texto = char.ToUpper(Model.TotalTexto[0]).ToString() + Model.TotalTexto.Substring(1);
                }
                @(totalAnticipos > 0 ? texto + " (antes de anticipos)" : texto) @Model.Moneda
            </td>

            <!-- TOTALES NUMÉRICOS -->
            <td style="width: 40%; vertical-align: top;">
                <table style="width: 100%; border-collapse: collapse;">
                    <tr>
                        <td style="text-align: right; width: 60%;"><strong>Subtotal:</strong></td>
                        <td style="text-align: right; width: 40%;">@string.Format("{0:C2}", Model.Subtotal)</td>
                    </tr>
                    @if (Model.Descuento > 0)
                    {
                        <tr style="color: #e65100;">
                            <td style="text-align: right;">
                                <strong>Descuento:</strong>
                            </td>
                            <td style="text-align: right;">
                                (@string.Format("{0:C2}", Model.Descuento))
                            </td>
                        </tr>
                        <tr>
                            <td style="text-align: right;"><strong>Subtotal Neto:</strong></td>
                            <td style="text-align: right;">@string.Format("{0:C2}", Model.Subtotal - Model.Descuento)</td>
                        </tr>
                    }
                    <tr>
                        <td style="text-align: right;"><strong>IVA (0%):</strong></td>
                        <td style="text-align: right;">@string.Format("{0:C2}", Model.IVA)</td>
                    </tr>

                    @if (totalAnticipos > 0)
                    {
                        <tr>
                            <td style="text-align: right; color: #2e7d32;"><strong>Anticipos Aplicados:</strong></td>
                            <td style="text-align: right; color: #2e7d32;">@(totalAnticipos)</td>
                        </tr>
                        <tr style="border-top: 2px solid #000; font-size: 1.1em;">
                            <td style="text-align: right;"><strong>TOTAL:</strong></td>
                            <td style="text-align: right;"><strong>@Model.Moneda @string.Format("{0:C2}", Model.Total)</strong></td>
                        </tr>
                    }
                    else
                    {
                        <tr style="border-top: 2px solid #000; font-size: 1.1em;">
                            <td style="text-align: right;"><strong>TOTAL:</strong></td>
                            <td style="text-align: right;"><strong>@Model.Moneda @string.Format("{0:C2}", Model.Total)</strong></td>
                        </tr>
                    }
                </table>
            </td>
        </tr>
    </table>



    <!-- SELLOS Y QR EN COLUMNAS -->
    <div class="section-title" style="margin-top: 25px;">Sellos y Cadena Original</div>
    <table>
        <tr>
            <!-- Columna Sellos -->
            <td style="width: 75%; vertical-align: top;">
                <p style="margin: 5px 0 3px 0;"><strong>No. de Serie del Certificado del SAT:</strong></p>
                <div class="sello">@Model.NoCertificadoSAT</div>

                <p style="margin: 8px 0 3px 0;"><strong>No de Serie del CSD del Emisor:</strong></p>
                <div class="sello">@Model.NoCertificado</div>

                <p style="margin: 8px 0 3px 0;"><strong>Sello CFDI:</strong></p>
                <div class="sello">@Model.SelloCFDI</div>

                <p style="margin: 8px 0 3px 0;"><strong>Sello SAT:</strong></p>
                <div class="sello">@Model.SelloSAT</div>

                <p style="margin: 8px 0 3px 0;"><strong>Cadena Original:</strong></p>
                <div class="sello">@Model.CadenaOriginal</div>
            </td>

            <!-- Columna QR -->
            @if (!string.IsNullOrEmpty(Model.RutaQr))
            {
                <td style="width: 25%; text-align: center; vertical-align: top; padding-left: 10px;">
                    <strong style="display: block; margin-bottom: 8px;">Código QR</strong>
                    <img src="@Url.Content(Model.RutaQr)" alt="QR CFDI" style="width: 150px; height: 150px; border: 1px solid #ccc; padding: 5px; background: white;" />
                    <br><small style="color: #666;">Verificación SAT</small>
                </td>
            }
        </tr>
    </table>

    <!-- Footer simple -->
    <div style="text-align: center; margin-top: 25px; padding-top: 10px; border-top: 1px solid #ccc; font-size: 10px; color: #666;">
        <strong>Este documento es una representación impresa de un CFDI</strong><br>
        Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

</body>
</html>