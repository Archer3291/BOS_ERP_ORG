@section Scripts {
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Credito_Cobranza/aplicacion_notas_credito.js"></script>
    <script src="~/Scripts/Facturas/manejo-respuestas.js"></script>
    <script>
        let tomManagerNC;
        tomManagerNC = new TomSelectManager();

        GetData({ path: '/DatosGenerales/DatosSelect' }).then((_res) => {
            const monedas    = _res.monedas;
            const cfdi       = _res.usocfdi;
            const sucursales = _res.sucursales;
            const almacenes  = _res.almacenes;
            const bancos     = _res.bancos;
            const tasas      = _res.tasas;

            // MONEDA
            tomManagerNC.create('vi-nc-moneda', {
                selector: '#vi-nc-moneda',
                options: monedas,
                valueField: 'id', displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione una moneda...',
                maxItems: 1, create: false,
                render: {
                    option: (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)} (${e(d.id)})</div>`,
                    item:   (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)}</div>`
                },
                onChange: (value) => {
                    let v = value === "PESOS" ? "peso" : value === "EURO" ? "euro" : value === "DLLS" ? "dolar" : null;
                    const tasaData = tasas?.[0];
                    if (!tasaData || !v) { document.getElementById('vi-nc-paridad').value = ''; return; }
                    const tasa = tasaData[v];
                    document.getElementById('vi-nc-paridad').value = tasa !== undefined ? tasa : '';
                }
            });

            // USO CFDI
            tomManagerNC.create('vi-nc-uso-cfdi', {
                selector: '#vi-nc-uso-cfdi',
                options: cfdi,
                valueField: 'id', displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione el CFDI...',
                maxItems: 1, create: false,
                render: {
                    option: (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)} (${e(d.id)})</div>`,
                    item:   (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)}</div>`
                }
            });

            // BANCO
            tomManagerNC.create('vi-nc-banco', {
                selector: '#vi-nc-banco',
                options: bancos,
                valueField: 'id', displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione banco...',
                maxItems: 1, create: false,
                render: {
                    option: (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)} (${e(d.id)})</div>`,
                    item:   (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)}</div>`
                }
            });

            // SUCURSAL
            tomManagerNC.create('vi-nc-sucursal', {
                selector: '#vi-nc-sucursal',
                options: sucursales,
                valueField: 'id', displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione sucursal...',
                maxItems: 1, create: false,
                render: {
                    option: (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)} (${e(d.id)})</div>`,
                    item:   (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)}</div>`
                },
                onChange: (sucursalId) => {
                    const filtrados = almacenes.filter(a => a.sucursal_id == sucursalId);
                    const inst = tomManagerNC.getInstance('vi-nc-almacen');
                    if (!inst) return;
                    inst.clear();
                    inst.clearOptions();
                    inst.addOptions(filtrados);
                    inst.refreshOptions(false);
                }
            });

            // ALMACÉN
            tomManagerNC.create('vi-nc-almacen', {
                selector: '#vi-nc-almacen',
                options: [],
                valueField: 'id', displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione almacén...',
                maxItems: 1, create: false,
                render: {
                    option: (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)} (${e(d.id)})</div>`,
                    item:   (d, e) => `<div style="color:var(--text-dark)">${e(d.nombre)}</div>`
                }
            });

            // Valores por defecto
            tomManagerNC.getInstance('vi-nc-sucursal').setValue(@Context.Session.GetInt32("Sucursal"), false);
            tomManagerNC.getInstance('vi-nc-almacen').setValue("1", false);
            tomManagerNC.getInstance('vi-nc-moneda').setValue("PESOS", false);
            tomManagerNC.getInstance('vi-nc-uso-cfdi').setValue("CP01", false);
        });
    </script>
}
