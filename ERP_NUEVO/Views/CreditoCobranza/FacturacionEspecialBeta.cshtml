@{
    ViewBag.Title = "Zonas";
    ViewBag.PageTitle = "Facturacion Especial";
}
@section styles {
    <link href="~/content/Facturacion/facturacion-especial.css" rel="stylesheet" />
<link href="~/content/Site.css" rel="stylesheet" />
}

<div class="container my-4">
    <!-- Selector de tipo de formulario -->
    <div class="form-selection-section">
        <div class="section-header">
            <h3><i class="fas fa-clipboard-list me-2"></i>Seleccionar Tipo de Facturación</h3>
            <p class="mb-0 text-muted">Elige el tipo de facturación que mejor se adapte a tus necesidades</p>
        </div>
        <div class="form-types">
            <div class="form-type-card active" data-form="cuenta-predial">
                <div class="form-type-icon">
                    <i class="fas fa-building"></i>
                </div>
                <div class="form-type-title">Cuenta Predial por Concepto</div>
                <div class="form-type-description">Facturación con cuenta predial específica por cada concepto. Ideal para rentas y servicios inmobiliarios con múltiples propiedades.</div>
            </div>

            <div class="form-type-card" data-form="servicios-publicos">
                <div class="form-type-icon">
                    <i class="fas fa-plug"></i>
                </div>
                <div class="form-type-title">Servicios Públicos</div>
                <div class="form-type-description">Para facturación de agua, luz, gas y otros servicios públicos con tarifas especiales y complementos específicos del sector.</div>
            </div>

            <div class="form-type-card" data-form="honorarios">
                <div class="form-type-icon">
                    <i class="fas fa-user-tie"></i>
                </div>
                <div class="form-type-title">Honorarios Profesionales</div>
                <div class="form-type-description">Facturación de servicios profesionales con retenciones específicas y complementos para profesionistas independientes.</div>
            </div>

            <div class="form-type-card" data-form="construccion">
                <div class="form-type-icon">
                    <i class="fas fa-hard-hat"></i>
                </div>
                <div class="form-type-title">Servicios de Construcción</div>
                <div class="form-type-description">Para obras y servicios de construcción con complementos específicos del sector y manejo de subcontratación.</div>
            </div>
        </div>
    </div>

    <!-- Formulario principal - Cuenta Predial -->
    <form id="cfdiForm" class="main-form active" data-form-type="cuenta-predial">
        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-file-alt"></i>
                Datos del Comprobante
            </h4>
            <div class="row g-4">
                <div class="col-md-3">
                    <div class="input-group-modern">
                        <i class="fas fa-hashtag input-icon"></i>
                        <input id="serie" name="Serie" class="input-modern" placeholder="Ingrese la serie">
                        <label class="input-label">Serie</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group-modern">
                        <i class="fas fa-barcode input-icon"></i>
                        <input id="folio" name="Folio" class="input-modern" placeholder="Ingrese el folio">
                        <label class="input-label">Folio</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group-modern">
                        <i class="fas fa-credit-card input-icon"></i>
                        <select id="formaPago" class="select-modern">
                            <option value="01">01 - Efectivo</option>
                            <option value="03" selected>03 - Transferencia</option>
                            <option value="99">99 - Por definir</option>
                        </select>
                        <label class="input-label">Forma de Pago</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group-modern">
                        <i class="fas fa-dollar-sign input-icon"></i>
                        <input id="moneda" name="Moneda" class="input-modern" placeholder="MXN" value="MXN">
                        <label class="input-label">Moneda</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-map-marker-alt input-icon"></i>
                        <input id="lugarExpedicion" name="LugarExpedicion" class="input-modern" placeholder="Código postal de expedición">
                        <label class="input-label">Lugar de Expedición (CP)</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-tag input-icon"></i>
                        <select id="usoCfdi" name="IdUsoCFDI" class="select-modern">
                            <option value="P01">P01 - Por definir</option>
                            <option value="G01">G01 - Adquisición de mercancías</option>
                            <option value="G02">G02 - Devoluciones, descuentos o bonificaciones</option>
                            <option value="G03">G03 - Gastos en general</option>
                            <option value="I01">I01 - Construcciones</option>
                        </select>
                        <label class="input-label">Uso CFDI</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-building"></i>
                Datos del Emisor
            </h4>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-id-card input-icon"></i>
                        <input id="rfcEmisor" name="RfcEmisor" class="input-modern" placeholder="RFC del emisor">
                        <label class="input-label">RFC Emisor</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="input-group-modern">
                        <i class="fas fa-user input-icon"></i>
                        <input id="nombreEmisor" name="RsoEmisor" class="input-modern" placeholder="Razón social del emisor">
                        <label class="input-label">Razón Social Emisor</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="input-group-modern">
                        <i class="fas fa-clipboard input-icon"></i>
                        <select id="regimenFiscal" name="Rege" class="select-modern">
                            <option value="601">601 - General de Ley Personas Morales</option>
                            <option value="612">612 - Persona Física con Actividad Empresarial</option>
                            <option value="605">605 - Sueldos y Salarios e Ingresos Asimilados</option>
                            <option value="606">606 - Arrendamiento</option>
                            <option value="608">608 - Demás ingresos</option>
                        </select>
                        <label class="input-label">Régimen Fiscal</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-user-friends"></i>
                Datos del Receptor
            </h4>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-id-card input-icon"></i>
                        <input id="rfcReceptor" name="RfcCliente" class="input-modern" placeholder="RFC del receptor">
                        <label class="input-label">RFC Receptor</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-user input-icon"></i>
                        <input id="nombreReceptor" name="RsoCliente" class="input-modern" placeholder="Razón social del receptor">
                        <label class="input-label">Razón Social Receptor</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group-modern">
                        <i class="fas fa-home input-icon"></i>
                        <input id="domFiscalReceptor" name="CpR" class="input-modern" placeholder="CP del receptor">
                        <label class="input-label">CP Receptor</label>
                    </div>
                </div>
                <div class="col-md-2">
                    <div class="input-group-modern">
                        <i class="fas fa-building input-icon"></i>
                        <select id="regimenFiscalReceptor" name="RegimenFiscalReceptor" class="select-modern">
                            <option value="601">601 - General de Ley Personas Morales</option>
                            <option value="612">612 - Persona Física con Actividad Empresarial</option>
                            <option value="605">605 - Sueldos y Salarios e Ingresos Asimilados</option>
                            <option value="606">606 - Arrendamiento</option>
                            <option value="608">608 - Demás ingresos</option>
                        </select>
                        <label class="input-label">Régimen Fiscal Receptor</label>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-list"></i>
                Conceptos y Servicios
            </h4>

            <div class="table-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h6><i class="fas fa-shopping-cart me-2"></i>Lista de Conceptos</h6>
                        <small class="text-muted">Agrega los productos o servicios a facturar</small>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" id="addRow" class="btn btn-primary-custom btn-custom">
                            <i class="fas fa-plus"></i>
                            Agregar Concepto
                        </button>
                        <button type="button" id="clearRows" class="btn btn-secondary-custom btn-custom">
                            <i class="fas fa-trash"></i>
                            Limpiar Todo
                        </button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table id="conceptosTable" class="table table-sm align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:50px">#</th>
                                <th style="width:120px">Clave Prod/Serv</th>
                                <th style="width:100px">Clave Unidad</th>
                                <th>Descripción</th>
                                <th style="width: 100px">Cantidad</th>
                                <th style="width: 130px">Precio Unit.</th>
                                <th style="width: 130px">Importe</th>
                                <th style="width: 110px">Objeto Imp.</th>
                                <th style="width: 150px">Cuenta Predial</th>
                                <th style="width: 70px">Acciones</th>
                            </tr>
                        </thead>
                        <tbody id="conceptosBody">
                            <!-- Filas dinámicas -->
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="totals-section">
                <div class="totals-grid">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-calculator fa-3x text-primary me-3"></i>
                        <div>
                            <h5 class="mb-1 text-primary">Resumen de Totales</h5>
                            <p class="text-muted mb-0">Calculado automáticamente</p>
                        </div>
                    </div>
                    <div class="totals-display">
                        <div class="total-row">
                            <span><i class="fas fa-minus me-2"></i>Subtotal:</span>
                            <strong id="subtotalTxt">$0.00</strong>
                        </div>
                        <div class="total-row">
                            <span><i class="fas fa-percentage me-2"></i>IVA (16%):</span>
                            <strong id="ivaTxt">$0.00</strong>
                        </div>
                        <div class="total-row">
                            <span><i class="fas fa-equals me-2"></i>Total:</span>
                            <strong id="totalTxt">$0.00</strong>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-actions">
            <div class="d-flex gap-2">
                <div class="file-input-wrapper">
                    <input type="file" id="loadXML" accept=".xml" class="file-input-hidden">
                    <button type="button" id="btnLoadXML" class="btn btn-file-custom btn-custom">
                        <i class="fas fa-upload"></i>
                        Cargar XML
                    </button>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button type="button" id="btnSave" class="btn btn-secondary-custom btn-custom">
                    <i class="fas fa-save"></i>
                    Guardar XML
                </button>
                <button type="submit" class="btn btn-success-custom btn-custom">
                    <i class="fas fa-stamp"></i>
                    Generar y Timbrar
                </button>
            </div>
        </div>
    </form>

    <!-- Formularios adicionales (ocultos inicialmente) -->
    <div class="main-form" data-form-type="servicios-publicos">
        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-plug"></i>
                Configuración para Servicios Públicos
            </h4>
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-3"></i>
                <strong>Próximamente:</strong> Este formulario está en desarrollo. Contendrá campos específicos para facturación de servicios públicos como agua, luz, gas, con complementos especializados del sector.
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-wrench input-icon"></i>
                        <select class="select-modern">
                            <option>Seleccionar tipo de servicio</option>
                            <option>Agua potable</option>
                            <option>Energía eléctrica</option>
                            <option>Gas natural</option>
                            <option>Telecomunicaciones</option>
                        </select>
                        <label class="input-label">Tipo de Servicio</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-tachometer-alt input-icon"></i>
                        <input class="input-modern" placeholder="Número de medidor">
                        <label class="input-label">Número de Medidor</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main-form" data-form-type="honorarios">
        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-user-tie"></i>
                Configuración para Honorarios Profesionales
            </h4>
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-3"></i>
                <strong>Próximamente:</strong> Este formulario incluirá campos para retenciones específicas, honorarios profesionales y complementos para profesionistas independientes.
            </div>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-briefcase input-icon"></i>
                        <select class="select-modern">
                            <option>Seleccionar tipo de honorario</option>
                            <option>Servicios profesionales</option>
                            <option>Consultoría</option>
                            <option>Asesoría técnica</option>
                        </select>
                        <label class="input-label">Tipo de Honorario</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-percentage input-icon"></i>
                        <input class="input-modern" placeholder="Porcentaje">
                        <label class="input-label">% Retención ISR</label>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="input-group-modern">
                        <i class="fas fa-percentage input-icon"></i>
                        <input class="input-modern" placeholder="Porcentaje">
                        <label class="input-label">% Retención IVA</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="main-form" data-form-type="construccion">
        <div class="form-section">
            <h4 class="form-section-title">
                <i class="fas fa-hard-hat"></i>
                Configuración para Servicios de Construcción
            </h4>
            <div class="alert alert-info">
                <i class="fas fa-info-circle me-3"></i>
                <strong>Próximamente:</strong> Este formulario contendrá complementos específicos del sector construcción, manejo de subcontratación y obras públicas.
            </div>
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-hammer input-icon"></i>
                        <select class="select-modern">
                            <option>Seleccionar tipo de obra</option>
                            <option>Obra pública</option>
                            <option>Obra privada</option>
                            <option>Mantenimiento</option>
                            <option>Remodelación</option>
                        </select>
                        <label class="input-label">Tipo de Obra</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="input-group-modern">
                        <i class="fas fa-file-contract input-icon"></i>
                        <input class="input-modern" placeholder="Número de contrato">
                        <label class="input-label">Número de Contrato</label>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



@section Scripts {
    <script>
        // =====================================
        // CONFIGURACIÓN Y CONSTANTES
        // =====================================
        const CONFIG = {
            productosComunes: {
                '80131500': 'Servicios de alquiler o arrendamiento',
                '81112503': 'Servicios de consultoria en administracion',
                '83111801': 'Servicios de contabilidad',
                '85101803': 'Servicios de capacitacion en administracion',
                '93141501': 'Servicios de limpieza de edificios'
            },
            taxRate: 0.16,
            animations: {
                fadeOut: 'all 0.4s cubic-bezier(0.4, 0, 0.2, 1)',
                scaleUp: 'all 0.3s ease'
            }
        };

        // =====================================
        // VARIABLES GLOBALES
        // =====================================
        let rowIndex = 0;
        const conceptosBody = document.getElementById('conceptosBody');

        // =====================================
        // UTILIDADES
        // =====================================
        const Utils = {
            formatCurrency(value) {
                const num = parseFloat(value) || 0;
                return '$' + num.toLocaleString('es-MX', {
                    minimumFractionDigits: 2,
                    maximumFractionDigits: 2
                });
            },

            parseCurrency(text) {
                return parseFloat(text.replace(/[$,]/g, '')) || 0;
            },

            validateRFC(rfc) {
                return /^[A-ZÑ&]{3,4}\d{6}[A-V1-9][A-Z0-9]{2}$/.test(rfc) || rfc === 'XAXX010101000';
            },

            validateCP(cp) {
                return /^\d{5}$/.test(cp);
            },

            debounce(func, wait) {
                let timeout;
                return function executedFunction(...args) {
                    const later = () => {
                        clearTimeout(timeout);
                        func(...args);
                    };
                    clearTimeout(timeout);
                    timeout = setTimeout(later, wait);
                };
            },

            moveCaretToEnd(element) {
                const range = document.createRange();
                const selection = window.getSelection();
                range.selectNodeContents(element);
                range.collapse(false);
                selection.removeAllRanges();
                selection.addRange(range);
            }
        };

        // =====================================
        // GESTIÓN DE LA TABLA DE CONCEPTOS
        // =====================================
        const TableManager = {
            getCellValue(tr, fieldName) {
                const element = tr.querySelector(`[data-field="${fieldName}"]`);
                if (!element) return '';

                if (element.tagName === 'SELECT') {
                    return element.value;
                }

                let value = element.textContent.trim();
                if (fieldName === 'precio' || fieldName === 'importe') {
                    value = value.replace(/[$,]/g, '');
                }
                return value;
            },

            setCellValue(tr, fieldName, value) {
                const element = tr.querySelector(`[data-field="${fieldName}"]`);
                if (!element) return;

                if (element.tagName === 'SELECT') {
                    element.value = value;
                } else {
                    if (fieldName === 'precio' || fieldName === 'importe') {
                        element.textContent = Utils.formatCurrency(value);
                    } else {
                        element.textContent = value;
                    }
                    this.updatePlaceholder(element);
                }
            },

            createRow(data = {}) {
                rowIndex++;
                const tr = document.createElement('tr');
                tr.dataset.index = rowIndex;
                tr.classList.add('fade-in-up');

                tr.innerHTML = this.generateRowHTML(rowIndex, data);
                conceptosBody.appendChild(tr);

                this.setupRowEvents(tr);
                this.applyPlaceholders(tr);
                this.recalcRow(tr);

                return tr;
            },

            generateRowHTML(index, data) {
                return `
            <td class="align-middle text-center">
                <div class="row-number-badge bg-primary text-white rounded-circle">${index}</div>
            </td>
            <td contenteditable="true" 
                data-field="articulo" 
                data-placeholder="80131500"
                title="Código del SAT para el producto/servicio">${data.articulo || ''}</td>
            <td contenteditable="true" 
                data-field="ClaveUnidad" 
                data-placeholder="E48"
                title="Unidad de medida según catálogo SAT">${data.ClaveUnidad || ''}</td>
            <td contenteditable="true" 
                data-field="descripcion" 
                data-placeholder="Descripción detallada del servicio"
                title="Descripción completa del producto o servicio"
                style="white-space: pre-wrap;">${data.descripcion || ''}</td>
            <td contenteditable="true" 
                data-field="Cantidad" 
                data-placeholder="1"
                title="Cantidad del producto/servicio"
                class="numeric-field">${data.Cantidad || 1}</td>
            <td contenteditable="true" 
                data-field="precio" 
                data-placeholder="0.00"
                title="Precio unitario sin impuestos"
                class="numeric-field">${Utils.formatCurrency(data.precio || 0)}</td>
            <td contenteditable="false" 
                data-field="importe" 
                title="Importe calculado automáticamente"
                class="numeric-field"
                style="background-color: #f8f9fa; cursor: not-allowed;">${Utils.formatCurrency(0)}</td>
            <td>
                <select class="form-select table-input" 
                        data-field="objeto" 
                        title="Objeto de impuesto según normatividad">
                    <option value="01" ${data.objeto === '01' ? 'selected' : ''}>01 - Exento</option>
                    <option value="02" ${data.objeto !== '01' ? 'selected' : ''}>02 - Con impuesto</option>
                    <option value="03">03 - Con y sin impuesto</option>
                </select>
            </td>
            <td contenteditable="true" 
                data-field="predial" 
                data-placeholder="1234567890123"
                title="Número de cuenta predial del inmueble">${data.predial || ''}</td>
            <td class="text-center">
                <button type="button" class="btn btn-danger-custom btn-sm remove-row"
                        title="Eliminar concepto"
                        style="width: 40px; height: 40px; padding: 0; border-radius: 50%;">
                    <i class="fas fa-trash" style="font-size: 0.8rem;"></i>
                </button>
            </td>
        `;
            },

            setupRowEvents(tr) {
                // Eliminar fila
                tr.querySelector('.remove-row').addEventListener('click', () => this.removeRow(tr));

                // Campos editables
                tr.querySelectorAll('td[contenteditable="true"]').forEach(cell => {
                    cell.addEventListener('input', () => this.handleCellInput(cell, tr));
                    cell.addEventListener('blur', () => this.handleCellBlur(cell, tr));
                    cell.addEventListener('focus', () => this.handleCellFocus(cell));

                    if (cell.classList.contains('numeric-field')) {
                        cell.addEventListener('keypress', this.allowNumericInput);
                    }
                });

                // Select de objeto
                tr.querySelector('[data-field="objeto"]').addEventListener('change', () => this.recalcRow(tr));
            },

            handleCellInput(cell, tr) {
                const fieldName = cell.dataset.field;

                if (cell.classList.contains('numeric-field')) {
                    this.processNumericField(cell, fieldName);
                }

                if (fieldName === 'Cantidad' || fieldName === 'precio') {
                    this.recalcRow(tr);
                    Calculator.recalcAll();
                }

                // Autocompletar productos
                if (fieldName === 'articulo') {
                    this.autoCompleteProduct(tr, cell.textContent.trim());
                }

                this.updatePlaceholder(cell);
            },

            processNumericField(cell, fieldName) {
                let value = cell.textContent;

                if (fieldName === 'precio') {
                    value = value.replace(/[^0-9.]/g, '');
                    if (value) {
                        cell.textContent = Utils.formatCurrency(parseFloat(value) || 0);
                        Utils.moveCaretToEnd(cell);
                    }
                } else {
                    value = value.replace(/[^0-9.]/g, '');
                    cell.textContent = value;
                    Utils.moveCaretToEnd(cell);
                }
            },

            handleCellBlur(cell, tr) {
                const fieldName = cell.dataset.field;

                if (cell.classList.contains('numeric-field')) {
                    const value = parseFloat(this.getCellValue(tr, fieldName)) || 0;
                    if (fieldName === 'precio') {
                        cell.textContent = Utils.formatCurrency(value);
                    } else if (fieldName === 'Cantidad') {
                        cell.textContent = value.toString();
                    }
                }

                this.updatePlaceholder(cell);
                this.recalcRow(tr);
                Calculator.recalcAll();
            },

            handleCellFocus(cell) {
                if (cell.classList.contains('placeholder-active')) {
                    cell.textContent = '';
                    cell.style.opacity = '';
                    cell.style.fontStyle = '';
                    cell.classList.remove('placeholder-active');
                }
            },

            allowNumericInput(event) {
                const char = String.fromCharCode(event.which);
                if (!/[0-9.]/.test(char)) {
                    event.preventDefault();
                    return false;
                }

                const currentValue = event.target.textContent.replace(/[$,]/g, '');
                if (char === '.' && currentValue.includes('.')) {
                    event.preventDefault();
                    return false;
                }

                return true;
            },

            autoCompleteProduct(tr, codigo) {
                if (CONFIG.productosComunes[codigo]) {
                    const descripcionElement = tr.querySelector('[data-field="descripcion"]');
                    if (!descripcionElement.textContent.trim()) {
                        descripcionElement.textContent = CONFIG.productosComunes[codigo];
                        this.updatePlaceholder(descripcionElement);
                    }
                }
            },

            removeRow(tr) {
                if (conceptosBody.children.length <= 1) {
                    UIManager.showAlert('Debe mantener al menos un concepto en la factura', 'warning');
                    return;
                }

                tr.style.transition = CONFIG.animations.fadeOut;
                tr.style.transform = 'translateX(-100%) scale(0.8)';
                tr.style.opacity = '0';

                setTimeout(() => {
                    tr.remove();
                    Calculator.recalcAll();
                    this.renumberRows();
                }, 400);
            },

            recalcRow(tr) {
                const qty = parseFloat(this.getCellValue(tr, 'Cantidad')) || 0;
                const price = parseFloat(this.getCellValue(tr, 'precio')) || 0;
                const importe = qty * price;

                this.setCellValue(tr, 'importe', importe.toFixed(2));

                // Efecto visual
                const importeCell = tr.querySelector('[data-field="importe"]');
                importeCell.style.background = '#e3f2fd';
                setTimeout(() => {
                    importeCell.style.background = '#f8f9fa';
                }, 300);
            },

            renumberRows() {
                const rows = conceptosBody.querySelectorAll('tr');
                rows.forEach((row, index) => {
                    const badge = row.querySelector('.row-number-badge');
                    if (badge) {
                        badge.textContent = index + 1;
                    }
                    row.dataset.index = index + 1;
                });
                rowIndex = rows.length;
            },

            applyPlaceholders(tr) {
                tr.querySelectorAll('td[contenteditable="true"]').forEach(cell => {
                    this.updatePlaceholder(cell);
                });
            },

            updatePlaceholder(element) {
                const placeholder = element.dataset.placeholder;
                const content = element.textContent.trim().replace(/[$,]/g, '');

                if (!content && placeholder) {
                    element.style.opacity = '0.6';
                    element.style.fontStyle = 'italic';
                    element.classList.add('placeholder-active');
                } else {
                    element.style.opacity = '';
                    element.style.fontStyle = '';
                    element.classList.remove('placeholder-active');
                }
            },

            clearAllRows() {
                const rows = [...conceptosBody.querySelectorAll('tr')];
                rows.forEach((row, index) => {
                    setTimeout(() => {
                        row.style.transition = 'all 0.3s ease';
                        row.style.transform = 'translateX(-100%)';
                        row.style.opacity = '0';
                    }, index * 50);
                });

                setTimeout(() => {
                    conceptosBody.innerHTML = '';
                    rowIndex = 0;
                    Calculator.recalcAll();
                    this.createRow();
                    Calculator.recalcAll();
                }, rows.length * 50 + 300);
            },

            getTableData() {
                const rows = conceptosBody.querySelectorAll('tr');
                return Array.from(rows).map(tr => ({
                    articulo: this.getCellValue(tr, 'articulo'),
                    ClaveUnidad: this.getCellValue(tr, 'ClaveUnidad'),
                    descripcion: this.getCellValue(tr, 'descripcion'),
                    Cantidad: parseFloat(this.getCellValue(tr, 'Cantidad')) || 0,
                    precio: parseFloat(this.getCellValue(tr, 'precio')) || 0,
                    importe: parseFloat(this.getCellValue(tr, 'importe')) || 0,
                    objeto: this.getCellValue(tr, 'objeto'),
                    predial: this.getCellValue(tr, 'predial')
                }));
            }
        };

        // =====================================
        // CALCULADORA DE TOTALES
        // =====================================
        const Calculator = {
            recalcAll() {
                let subtotal = 0;
                const rows = conceptosBody.querySelectorAll('tr');

                rows.forEach(tr => {
                    const importe = parseFloat(TableManager.getCellValue(tr, 'importe')) || 0;
                    subtotal += importe;
                });

                const iva = subtotal * CONFIG.taxRate;
                const total = subtotal + iva;

                this.animateValue(document.getElementById('subtotalTxt'), subtotal);
                this.animateValue(document.getElementById('ivaTxt'), iva);
                this.animateValue(document.getElementById('totalTxt'), total);
            },

            animateValue(element, newValue) {
                element.style.transform = 'scale(1.1)';
                element.style.color = '#0d6efd';

                setTimeout(() => {
                    element.textContent = Utils.formatCurrency(newValue);
                    element.style.transform = 'scale(1)';
                    element.style.color = '';
                }, 150);
            }
        };

        // =====================================
        // GESTIÓN DE INTERFAZ DE USUARIO
        // =====================================
        const UIManager = {
            showAlert(message, type = 'info') {
                // Remover alertas existentes
                document.querySelectorAll('.alert').forEach(alert => alert.remove());

                const alertDiv = document.createElement('div');
                alertDiv.className = `alert alert-${type} alert-dismissible fade show`;
                alertDiv.style.cssText = `
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 9999;
            max-width: 400px;
            box-shadow: var(--shadow-xl);
            transform: translateX(100%);
            transition: transform 0.3s ease;
        `;

                const icons = {
                    success: 'fas fa-check-circle',
                    danger: 'fas fa-exclamation-circle',
                    warning: 'fas fa-exclamation-triangle',
                    info: 'fas fa-info-circle'
                };

                alertDiv.innerHTML = `
            <i class="${icons[type]} me-2"></i>
            <span>${message}</span>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        `;

                document.body.appendChild(alertDiv);

                // Animación de entrada
                setTimeout(() => {
                    alertDiv.style.transform = 'translateX(0)';
                }, 10);

                // Auto-remover
                setTimeout(() => {
                    if (alertDiv.parentNode) {
                        alertDiv.classList.remove('show');
                        setTimeout(() => alertDiv.remove(), 150);
                    }
                }, 6000);
            },

            createConfirmModal(title, message, onConfirm) {
                const modalHTML = `
            <div class="modal fade" tabindex="-1">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header bg-warning text-dark">
                            <h5 class="modal-title">${title}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body">
                            <p>${message}</p>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">Cancelar</button>
                            <button type="button" class="btn btn-warning confirm-btn">Confirmar</button>
                        </div>
                    </div>
                </div>
            </div>
        `;

                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = modalHTML;
                const modalElement = tempDiv.firstElementChild;
                document.body.appendChild(modalElement);

                const modal = new bootstrap.Modal(modalElement);
                modalElement.querySelector('.confirm-btn').addEventListener('click', () => {
                    onConfirm();
                    modal.hide();
                });

                modalElement.addEventListener('hidden.bs.modal', () => {
                    modalElement.remove();
                });

                return modal;
            }
        };

        // =====================================
        // VALIDADOR DE FORMULARIOS
        // =====================================
        const Validator = {
            validateForm() {
                const errors = [];

                // Validar datos básicos
                this.validateBasicData(errors);
                this.validateConceptos(errors);

                return errors;
            },

            validateBasicData(errors) {
                const rfcEmisor = document.getElementById('rfcEmisor').value?.trim();
                const rfcReceptor = document.getElementById('rfcReceptor').value?.trim();
                const nombreEmisor = document.getElementById('nombreEmisor').value?.trim();
                const nombreReceptor = document.getElementById('nombreReceptor').value?.trim();
                const lugarExpedicion = document.getElementById('lugarExpedicion').value?.trim();

                if (!rfcEmisor) {
                    errors.push('RFC del emisor es obligatorio');
                } else if (!Utils.validateRFC(rfcEmisor)) {
                    errors.push('RFC del emisor tiene formato incorrecto');
                }

                if (!rfcReceptor) {
                    errors.push('RFC del receptor es obligatorio');
                } else if (!Utils.validateRFC(rfcReceptor)) {
                    errors.push('RFC del receptor tiene formato incorrecto');
                }

                if (!nombreEmisor) errors.push('Nombre del emisor es obligatorio');
                if (!nombreReceptor) errors.push('Nombre del receptor es obligatorio');

                if (!lugarExpedicion) {
                    errors.push('Lugar de expedición (CP) es obligatorio');
                } else if (!Utils.validateCP(lugarExpedicion)) {
                    errors.push('Código postal debe tener 5 dígitos');
                }
            },

            validateConceptos(errors) {
                const productos = TableManager.getTableData();

                if (productos.length === 0) {
                    errors.push('Debe agregar al menos un concepto');
                    return;
                }

                productos.forEach((producto, index) => {
                    const num = index + 1;
                    if (!producto.articulo) errors.push(`Concepto ${num}: Clave de producto/servicio es obligatoria`);
                    if (!producto.ClaveUnidad) errors.push(`Concepto ${num}: Clave de unidad es obligatoria`);
                    if (!producto.descripcion) errors.push(`Concepto ${num}: Descripción es obligatoria`);
                    if (producto.Cantidad <= 0) errors.push(`Concepto ${num}: Cantidad debe ser mayor a 0`);
                    if (producto.precio <= 0) errors.push(`Concepto ${num}: Precio debe ser mayor a 0`);
                });
            },

            setupRealTimeValidation() {
                // RFC validation
                ['rfcEmisor', 'rfcReceptor'].forEach(id => {
                    const input = document.getElementById(id);
                    if (input) {
                        input.addEventListener('input', Utils.debounce((e) => {
                            const rfc = e.target.value.toUpperCase();
                            e.target.value = rfc;
                            this.validateRFCVisual(e.target, rfc);
                        }, 300));
                    }
                });

                // CP validation
                const cpInput = document.getElementById('lugarExpedicion');
                if (cpInput) {
                    cpInput.addEventListener('input', Utils.debounce((e) => {
                        const cp = e.target.value;
                        this.validateCPVisual(e.target, cp);
                    }, 300));
                }
            },

            validateRFCVisual(input, rfc) {
                if (rfc.length >= 12) {
                    if (Utils.validateRFC(rfc)) {
                        input.classList.remove('is-invalid');
                        input.classList.add('is-valid');
                    } else {
                        input.classList.remove('is-valid');
                        input.classList.add('is-invalid');
                    }
                } else {
                    input.classList.remove('is-valid', 'is-invalid');
                }
            },

            validateCPVisual(input, cp) {
                if (cp.length === 5 && Utils.validateCP(cp)) {
                    input.classList.remove('is-invalid');
                    input.classList.add('is-valid');
                } else if (cp.length > 0) {
                    input.classList.remove('is-valid');
                    input.classList.add('is-invalid');
                } else {
                    input.classList.remove('is-valid', 'is-invalid');
                }
            }
        };

        // =====================================
        // MANEJADOR DE FACTURAS
        // =====================================
        const FacturaManager = {
            buildFacturaFromForm() {
                const factura = {};

                // Datos del comprobante
                factura.Serie = document.getElementById('serie').value?.trim() || '';
                factura.Folio = document.getElementById('folio').value?.trim() || '';
                factura.IdTipoPago = document.getElementById('formaPago').value;
                factura.Moneda = document.getElementById('moneda').value || 'MXN';
                factura.CpE = document.getElementById('lugarExpedicion').value?.trim() || '';

                // Emisor
                factura.RfcEmisor = document.getElementById('rfcEmisor').value?.trim().toUpperCase() || '';
                factura.RsoEmisor = document.getElementById('nombreEmisor').value?.trim() || '';
                factura.Rege = document.getElementById('regimenFiscal').value;

                // Receptor
                factura.RfcCliente = document.getElementById('rfcReceptor').value?.trim().toUpperCase() || '';
                factura.RsoCliente = document.getElementById('nombreReceptor').value?.trim() || '';
                factura.CpR = document.getElementById('domFiscalReceptor').value?.trim() || '';
                factura.IdUsoCFDI = document.getElementById('usoCfdi').value;
                factura.RegimenFiscalReceptor = document.getElementById('regimenFiscalReceptor')?.value || '';

                // Productos
                const productos = TableManager.getTableData().map((item, index) => ({
                    NoIdentificacion: (index + 1).toString().padStart(3, '0'),
                    articulo: item.articulo,
                    ClaveUnidad: item.ClaveUnidad,
                    descripcion: item.descripcion,
                    Cantidad: item.Cantidad,
                    precio: item.precio,
                    importe: +item.importe.toFixed(2),
                    objeto: item.objeto,
                    predial: item.predial,
                    iva: +(item.importe * CONFIG.taxRate).toFixed(2),
                    ValorUnitario: item.precio,
                    Descuento: 0
                }));

                factura.Tproductos = productos;

                // Totales
                const subtotal = Utils.parseCurrency(document.getElementById('subtotalTxt').innerText);
                const iva = Utils.parseCurrency(document.getElementById('ivaTxt').innerText);
                const total = Utils.parseCurrency(document.getElementById('totalTxt').innerText);

                factura.Subtotal = +subtotal.toFixed(2);
                factura.IVA = +iva.toFixed(2);
                factura.Total = +total.toFixed(2);

                // Campos adicionales
                Object.assign(factura, {
                    TipoCambio: 1,
                    FechaCreacion: new Date().toISOString(),
                    TipoFacturacion: 'CuentaPredial',
                    LugarExpedicion: factura.CpE,
                    MetodoPago: 'PUE',
                    TipoDeComprobante: 'I',
                    Version: '4.0'
                });

                return factura;
            },

            buildXMLFromFactura(factura) {
                const fecha = new Date().toISOString();

                let xml = `<?xml version="1.0" encoding="UTF-8"?>
<cfdi:Comprobante
    xmlns:cfdi="http://www.sat.gob.mx/cfd/4"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.sat.gob.mx/cfd/4 http://www.sat.gob.mx/sitio_internet/cfd/4/cfdv40.xsd"
    Version="4.0"
    Serie="${factura.Serie}"
    Folio="${factura.Folio}"
    Fecha="${fecha}"
    FormaPago="${factura.IdTipoPago}"
    NoCertificado="00001000000505521838"
    Certificado=""
    CondicionesDePago=""
    SubTotal="${factura.Subtotal}"
    Descuento="0.00"
    Moneda="${factura.Moneda}"
    TipoCambio="${factura.TipoCambio}"
    Total="${factura.Total}"
    TipoDeComprobante="${factura.TipoDeComprobante}"
    MetodoPago="${factura.MetodoPago}"
    LugarExpedicion="${factura.CpE}"
    Exportacion="01"
    Sello=""
    NoCertificadoSAT=""
    SelloSAT="">

    <cfdi:Emisor
        Rfc="${factura.RfcEmisor}"
        Nombre="${factura.RsoEmisor}"
        RegimenFiscal="${factura.Rege}" />

    <cfdi:Receptor
        Rfc="${factura.RfcCliente}"
        Nombre="${factura.RsoCliente}"
        DomicilioFiscalReceptor="${factura.CpR}"
        RegimenFiscalReceptor="${factura.RegimenFiscalReceptor}"
        UsoCFDI="${factura.IdUsoCFDI}" />

    <cfdi:Conceptos>`;

                factura.Tproductos.forEach(producto => {
                    xml += `
        <cfdi:Concepto
            ClaveProdServ="${producto.articulo}"
            NoIdentificacion="${producto.NoIdentificacion}"
            Cantidad="${producto.Cantidad}"
            ClaveUnidad="${producto.ClaveUnidad}"
            Unidad="Servicio"
            Descripcion="${producto.descripcion}"
            ValorUnitario="${producto.precio}"
            Importe="${producto.importe}"
            Descuento="0.00"
            ObjetoImp="${producto.objeto}">`;

                    if (producto.predial) {
                        xml += `
            <cfdi:InformacionAduanera>
                <cfdi:CuentaPredial Numero="${producto.predial}"/>
            </cfdi:InformacionAduanera>`;
                    }

                    if (producto.objeto === "02") {
                        xml += `
            <cfdi:Impuestos>
                <cfdi:Traslados>
                    <cfdi:Traslado Base="${producto.importe}" Impuesto="002" TipoFactor="Tasa" TasaOCuota="0.160000" Importe="${producto.iva}" />
                </cfdi:Traslados>
            </cfdi:Impuestos>`;
                    }

                    xml += `
        </cfdi:Concepto>`;
                });

                xml += `
    </cfdi:Conceptos>

    <cfdi:Impuestos TotalImpuestosTrasladados="${factura.IVA}">
        <cfdi:Traslados>
            <cfdi:Traslado Base="${factura.Subtotal}" Impuesto="002" TipoFactor="Tasa" TasaOCuota="0.160000" Importe="${factura.IVA}" />
        </cfdi:Traslados>
    </cfdi:Impuestos>

</cfdi:Comprobante>`;

                return xml;
            },

            async saveAsXML() {
                const errors = Validator.validateForm();
                if (errors.length > 0) {
                    UIManager.showAlert('Corrija los siguientes errores antes de guardar:<br>• ' + errors.join('<br>• '), 'warning');
                    return;
                }

                const factura = this.buildFacturaFromForm();
                const xmlString = this.buildXMLFromFactura(factura);

                const blob = new Blob([xmlString], { type: 'text/xml' });
                const url = URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;

                const fecha = new Date().toISOString().slice(0, 10);
                const serie = factura.Serie || 'CFDI';
                const folio = factura.Folio || '001';
                a.download = `${serie}_${folio}_${fecha}.xml`;

                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);

                UIManager.showAlert('XML guardado exitosamente como ' + a.download, 'success');
            },

            loadDataFromXML(xmlString) {
                try {
                    const parser = new DOMParser();
                    const xmlDoc = parser.parseFromString(xmlString, 'text/xml');

                    const parseError = xmlDoc.querySelector('parsererror');
                    if (parseError) {
                        throw new Error('XML mal formado');
                    }

                    const comprobante = xmlDoc.querySelector('Comprobante') || xmlDoc.querySelector('cfdi\\:Comprobante');
                    if (!comprobante) {
                        throw new Error('No se encontró el elemento Comprobante en el XML');
                    }

                    this.loadComprobanteData(comprobante);
                    this.loadEmisorData(xmlDoc);
                    this.loadReceptorData(xmlDoc);
                    this.loadConceptosData(xmlDoc);

                    Calculator.recalcAll();

                } catch (error) {
                    throw new Error('Error al procesar el XML: ' + error.message);
                }
            },

            loadComprobanteData(comprobante) {
                const fields = {
                    serie: 'Serie',
                    folio: 'Folio',
                    formaPago: 'FormaPago',
                    moneda: 'Moneda',
                    lugarExpedicion: 'LugarExpedicion'
                };

                Object.entries(fields).forEach(([elementId, attribute]) => {
                    const element = document.getElementById(elementId);
                    if (element) {
                        element.value = comprobante.getAttribute(attribute) || (elementId === 'formaPago' ? '03' : '');
                    }
                });
            },

            loadEmisorData(xmlDoc) {
                const emisor = xmlDoc.querySelector('Emisor') || xmlDoc.querySelector('cfdi\\:Emisor');
                if (emisor) {
                    const fields = {
                        rfcEmisor: 'Rfc',
                        nombreEmisor: 'Nombre',
                        regimenFiscal: 'RegimenFiscal'
                    };

                    Object.entries(fields).forEach(([elementId, attribute]) => {
                        const element = document.getElementById(elementId);
                        if (element) {
                            element.value = emisor.getAttribute(attribute) || (elementId === 'regimenFiscal' ? '601' : '');
                        }
                    });
                }
            },

            loadReceptorData(xmlDoc) {
                const receptor = xmlDoc.querySelector('Receptor') || xmlDoc.querySelector('cfdi\\:Receptor');
                if (receptor) {
                    const fields = {
                        rfcReceptor: 'Rfc',
                        nombreReceptor: 'Nombre',
                        domFiscalReceptor: 'DomicilioFiscalReceptor',
                        usoCfdi: 'UsoCFDI'
                    };

                    Object.entries(fields).forEach(([elementId, attribute]) => {
                        const element = document.getElementById(elementId);
                        if (element) {
                            element.value = receptor.getAttribute(attribute) || (elementId === 'usoCfdi' ? 'P01' : '');
                        }
                    });

                    const regimenReceptor = receptor.getAttribute('RegimenFiscalReceptor');
                    if (regimenReceptor) {
                        const element = document.getElementById('regimenFiscalReceptor');
                        if (element) element.value = regimenReceptor;
                    }
                }
            },

            loadConceptosData(xmlDoc) {
                const conceptos = xmlDoc.querySelectorAll('Concepto') || xmlDoc.querySelectorAll('cfdi\\:Concepto');

                conceptosBody.innerHTML = '';
                rowIndex = 0;

                if (conceptos.length > 0) {
                    conceptos.forEach(concepto => {
                        const conceptoData = {
                            articulo: concepto.getAttribute('ClaveProdServ') || '',
                            ClaveUnidad: concepto.getAttribute('ClaveUnidad') || '',
                            descripcion: concepto.getAttribute('Descripcion') || '',
                            Cantidad: parseFloat(concepto.getAttribute('Cantidad')) || 1,
                            precio: parseFloat(concepto.getAttribute('ValorUnitario')) || 0,
                            objeto: concepto.getAttribute('ObjetoImp') || '02'
                        };

                        const cuentaPredial = concepto.querySelector('CuentaPredial') || concepto.querySelector('cfdi\\:CuentaPredial');
                        if (cuentaPredial) {
                            conceptoData.predial = cuentaPredial.getAttribute('Numero') || '';
                        }

                        TableManager.createRow(conceptoData);
                    });
                } else {
                    TableManager.createRow();
                }
            },

            async submitForm(e) {
                e.preventDefault();

                const submitBtn = e.target.querySelector('[type="submit"]');
                const originalHTML = submitBtn.innerHTML;

                const errors = Validator.validateForm();
                if (errors.length > 0) {
                    UIManager.showAlert('Corrija los siguientes errores:<br>• ' + errors.join('<br>• '), 'danger');
                    return;
                }

                const factura = this.buildFacturaFromForm();

                try {
                    submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Procesando...';
                    submitBtn.disabled = true;
                    submitBtn.classList.add('loading');

                    // Simular delay de procesamiento (remover en producción)
                    await new Promise(resolve => setTimeout(resolve, 2000));

                    const response = await fetch('/GenerarXml', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: JSON.stringify(factura)
                    });

                    if (!response.ok) {
                        const errorText = await response.text();
                        throw new Error(`Error ${response.status}: ${errorText}`);
                    }

                    const result = await response.json();

                    if (result && result.Success === false) {
                        throw new Error(result.Message || 'Error desconocido en el servicio');
                    }

                    UIManager.showAlert('¡Factura timbrada exitosamente!<br>UUID: ' + (result.UUID || 'N/A'), 'success');
                    console.log('Resultado completo:', result);

                } catch (error) {
                    console.error('Error detallado:', error);
                    UIManager.showAlert('Error al procesar la factura:<br>' + error.message, 'danger');
                } finally {
                    submitBtn.innerHTML = originalHTML;
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('loading');
                }
            }
        };

        // =====================================
        // INICIALIZACIÓN Y EVENT LISTENERS
        // =====================================
        const AppInitializer = {
            init() {
                document.addEventListener('DOMContentLoaded', () => {
                    this.initializeFormSelection();
                    this.initializeTooltips();
                    this.setupEventListeners();
                    this.setupGlobalEventListeners();

                    // Crear fila inicial con datos de ejemplo
                    TableManager.createRow({
                        articulo: '80131500',
                        ClaveUnidad: 'E48',
                        descripcion: 'Renta mensual de inmueble',
                        Cantidad: 1,
                        precio: 15000.00,
                        predial: '1234567890123'
                    });

                    Calculator.recalcAll();
                    Validator.setupRealTimeValidation();
                });
            },

            initializeFormSelection() {
                const formCards = document.querySelectorAll('.form-type-card');
                const forms = document.querySelectorAll('.main-form');

                formCards.forEach(card => {
                    card.addEventListener('click', function () {
                        const formType = this.dataset.form;

                        formCards.forEach(c => {
                            c.classList.remove('active');
                            c.style.transform = 'scale(0.98)';
                            setTimeout(() => c.style.transform = 'scale(1)', 100);
                        });

                        this.classList.add('active');

                        forms.forEach(form => {
                            form.classList.remove('active');
                            if (form.dataset.formType === formType) {
                                form.classList.add('active');
                            }
                        });
                    });
                });
            },

            initializeTooltips() {
                const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                tooltipTriggerList.map(function (tooltipTriggerEl) {
                    return new bootstrap.Tooltip(tooltipTriggerEl);
                });
            },

            setupEventListeners() {
                // Botones principales
                const addRowBtn = document.getElementById('addRow');
                if (addRowBtn) {
                    addRowBtn.addEventListener('click', () => {
                        TableManager.createRow();
                        setTimeout(() => {
                            const newRow = conceptosBody.lastElementChild;
                            newRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                        }, 100);
                    });
                }

                const clearRowsBtn = document.getElementById('clearRows');
                if (clearRowsBtn) {
                    clearRowsBtn.addEventListener('click', () => {
                        const confirmModal = UIManager.createConfirmModal(
                            'Confirmar limpieza',
                            '¿Está seguro de eliminar todos los conceptos? Esta acción no se puede deshacer.',
                            () => TableManager.clearAllRows()
                        );
                        confirmModal.show();
                    });
                }

                // Botones de archivo
                const btnSave = document.getElementById('btnSave');
                if (btnSave) {
                    btnSave.addEventListener('click', () => FacturaManager.saveAsXML());
                }

                const btnLoadXML = document.getElementById('btnLoadXML');
                if (btnLoadXML) {
                    btnLoadXML.addEventListener('click', () => {
                        document.getElementById('loadXML').click();
                    });
                }

                const loadXML = document.getElementById('loadXML');
                if (loadXML) {
                    loadXML.addEventListener('change', async (e) => {
                        const file = e.target.files[0];
                        if (!file) return;

                        if (!file.name.toLowerCase().endsWith('.xml')) {
                            UIManager.showAlert('Por favor seleccione un archivo XML válido', 'warning');
                            return;
                        }

                        try {
                            const text = await file.text();
                            FacturaManager.loadDataFromXML(text);
                            UIManager.showAlert('XML cargado exitosamente', 'success');
                        } catch (error) {
                            console.error('Error al cargar XML:', error);
                            UIManager.showAlert('Error al cargar el archivo XML: ' + error.message, 'danger');
                        }

                        e.target.value = '';
                    });
                }

                // Formulario principal
                const cfdiForm = document.getElementById('cfdiForm');
                if (cfdiForm) {
                    cfdiForm.addEventListener('submit', (e) => FacturaManager.submitForm(e));
                }
            },

            setupGlobalEventListeners() {
                // Eventos globales para placeholders
                document.addEventListener('focus', function (e) {
                    if (e.target.hasAttribute('contenteditable') && e.target.classList.contains('placeholder-active')) {
                        e.target.innerHTML = '';
                        e.target.style.opacity = '';
                        e.target.style.fontStyle = '';
                        e.target.classList.remove('placeholder-active');
                    }
                }, true);

                document.addEventListener('blur', function (e) {
                    if (e.target.hasAttribute('contenteditable')) {
                        if (e.target.classList.contains('numeric-field')) {
                            const fieldName = e.target.dataset.field;
                            const value = parseFloat(e.target.textContent.replace(/[$,]/g, '')) || 0;
                            if (fieldName === 'precio') {
                                e.target.textContent = Utils.formatCurrency(value);
                            } else {
                                e.target.textContent = value.toString();
                            }
                        }
                        TableManager.updatePlaceholder(e.target);
                    }
                }, true);
            }
        };

        // =====================================
        // EXPOSICIÓN DE FUNCIONES GLOBALES
        // =====================================
        window.getTableData = () => TableManager.getTableData();

        // =====================================
        // INICIALIZAR APLICACIÓN
        // =====================================
        AppInitializer.init();
    </script>
}