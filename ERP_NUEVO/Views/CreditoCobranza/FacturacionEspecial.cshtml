@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfoGroup
@{
    ViewBag.Title = "Zonas";
    ViewBag.PageTitle = "Facturacion Especial";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <style>
        .purchase-mode-toggle {
            background: linear-gradient(135deg, var(--very-light-blue), var(--light-blue));
            border-radius: 12px;
            padding: 1rem;
            margin-bottom: 2rem;
            border: 1px solid var(--border-light);
        }

        .modern-switch {
            width: 60px;
            height: 24px;
            border-radius: 12px;
            transition: all 0.3s ease;
        }

            .modern-switch:checked {
                background-color: var(--primary-blue);
                border-color: var(--primary-blue);
            }

        .form-switch .form-check-input {
            width: 3em;
        }

        .switch-label {
            font-weight: 500;
            color: var(--text-dark);
            cursor: pointer;
        }

        .switch-icon {
            font-size: 1.2rem;
            margin-right: 0.5rem;
        }

        .product-card {
            background: var(--bg-light);
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 1rem;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

            .product-card:hover {
                border-color: var(--primary-blue);
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

            .product-card.selected {
                border-color: var(--primary-blue);
                background: var(--light-blue);
            }

            .product-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--primary-blue), var(--accent-blue), var(--secondary-blue));
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .product-card.selected::before {
                opacity: 1;
            }

            .product-card.selected .product-icon {
                color: var(--primary-blue-dark);
            }

        .product-title {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
        }

        .product-card-corner {
            background: var(--bg-light);
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 1.5rem;
            margin-bottom: 2rem;
            transition: all 0.3s ease;
            cursor: pointer;
            position: relative;
            overflow: hidden;
        }

            .product-card-corner:hover {
                border-color: var(--primary-blue);
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

            .product-card-corner::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 4px;
                background: linear-gradient(90deg, var(--primary-blue), var(--accent-blue), var(--secondary-blue));
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .product-card-corner:hover::before {
                opacity: 1;
            }

        .corner-icon {
            position: absolute;
            top: 0.5rem;
            right: 0.5rem;
            background: var(--very-light-blue);
            border-radius: 50%;
            padding: 0.50rem;
            transition: all 0.3s ease;
        }

            .corner-icon svg {
                fill: var(--primary-blue);
                transition: all 0.3s ease;
            }

        .product-card-corner:hover .corner-icon {
            background: var(--primary-blue);
            transform: scale(1.1);
        }

            .product-card-corner:hover .corner-icon svg {
                fill: white;
            }

        .product-description {
            color: var(--text-light);
            font-size: 0.9rem;
            line-height: 1.4;
        }

        .product-features {
            margin-top: 1rem;
            padding-top: 1rem;
            border-top: 1px solid var(--border-light);
        }

        .feature-item {
            display: flex;
            align-items: center;
            margin-bottom: 0.5rem;
            color: var(--text-light);
            font-size: 0.85rem;
        }

            .feature-item i {
                color: var(--primary-blue);
                margin-right: 0.5rem;
                width: 16px;
            }

        .btn-check {
            position: absolute;
            clip: rect(0, 0, 0, 0);
            pointer-events: none;
        }

        .invalid-feedback {
            display: block;
            width: 100%;
            margin-top: 0.25rem;
            font-size: 0.875rem;
            color: #dc3545;
        }

        .form-actions {
            text-align: center;
            margin-top: 2rem;
            padding-top: 2rem;
            border-top: 1px solid var(--border-light);
        }

        @@media (max-width: 768px) {
            .form-container {
                margin: 1rem;
                padding: 1.5rem;
            }

            .product-card {
                padding: 1rem;
            }
        }

        .info-panel {
            background: linear-gradient(135deg, #fef3c7, #fde68a);
            border: 1px solid #f59e0b;
            border-radius: 8px;
            padding: 1rem;
            margin-bottom: 1.5rem;
        }

            .info-panel .info-title {
                color: #92400e;
                font-weight: 600;
                margin-bottom: 0.5rem;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .info-panel .info-text {
                color: #92400e;
                margin: 0;
                font-size: 0.9rem;
            }

        .card-resumen {
            background-color: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 0.75rem;
            box-shadow: var(--shadow);
            padding: 1.25rem 1.5rem;
            transition: background 0.3s ease;
        }

            .card-resumen h6 {
                color: var(--text-light);
                font-size: 0.85rem;
                margin-bottom: 0.5rem;
            }

            .card-resumen p {
                color: var(--text-dark);
                font-size: 1rem;
            }

        .badge-tag {
            background-color: var(--light-blue);
            color: var(--primary-blue);
            font-weight: 600;
            padding: 0.35rem 0.75rem;
            border-radius: 0.5rem;
            font-size: 0.875rem;
        }

        .table-resumen {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

            .table-resumen th {
                background-color: var(--very-light-blue);
                color: var(--dark-blue);
                text-align: left;
                padding: 0.6rem;
                border-bottom: 1px solid var(--border-light);
            }

            .table-resumen td {
                padding: 0.6rem;
                color: var(--text-dark);
                border-bottom: 1px solid var(--border-light);
            }

            .table-resumen tbody tr:nth-child(even) {
                background-color: var(--bg-gray);
            }

        .alert-info-resumen {
            background-color: var(--light-blue);
            color: var(--dark-blue);
            border: 1px solid var(--accent-blue);
            border-radius: 0.75rem;
            padding: 1rem 1.25rem;
            margin-bottom: 1.5rem;
            font-size: 0.95rem;
            box-shadow: var(--shadow);
        }
    </style>

}

