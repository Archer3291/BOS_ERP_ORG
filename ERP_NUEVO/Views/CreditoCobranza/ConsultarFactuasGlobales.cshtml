            // Función auxiliar para formatear fechas
            function formatDate(dateString) {
                if (!dateString) return 'N/A';
                try {
                    const date = new Date(dateString);
                    const options = {
                        year: 'numeric',
                        month: 'long',
                        day: 'numeric',
                        hour: '2-digit',
                        minute: '2-digit'
                    };
                    return date.toLocaleDateString('es-MX', options);
                } catch (error) {
                    return dateString;
                }
            }

            // Función para obtener la clase CSS del estado
            function getStatusClass(status) {
                if (!status || status === '0' || status === 0) return 'pendiente';
                const statusStr = status.toString().toLowerCase();
                if (statusStr === '1' || statusStr === 'pagada') return 'pagada';
                if (statusStr === '2' || statusStr === 'cancelada') return 'cancelada';
                if (statusStr === '3' || statusStr === 'vencida') return 'vencida';
                return 'pendiente';
            }

            // Función para obtener el texto del estado
            function getStatusText(status) {
                if (!status || status === '0' || status === 0) return 'Pendiente';
                const statusStr = status.toString().toLowerCase();
                if (statusStr === '1' || statusStr === 'pagada') return 'Pagada';
                if (statusStr === '2' || statusStr === 'cancelada') return 'Cancelada';
                if (statusStr === '3' || statusStr === 'vencida') return 'Vencida';
                return 'Pendiente';
            }

            // Funciones para las acciones (puedes implementarlas según tus necesidades)
            function printFactura(id) {
                const url = `../Facturacion/facturas/${id}.pdf`;
                console.log('Imprimir factura:', id);
                // Implementa la lógica de impresión
                window.open(url, '_blank');
            }

            function downloadFactura(id) {
                const url = `../Facturacion/xml_timbrados/${id}.xml`;
                // Abrir en nueva pestaña
                window.open(url, '_blank');

                // Forzar descarga simultáneamente
                const a = document.createElement('a');
                a.href = url;
                a.download = `${id}.xml`;
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }


