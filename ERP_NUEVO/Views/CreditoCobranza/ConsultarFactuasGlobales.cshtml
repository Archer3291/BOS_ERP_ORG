                } else {
                    // Finalizar proceso
                    Swal.fire({
                        icon: 'success',
                        title: '<i class="fas fa-check-circle"></i> Proceso Completado',
                        html: '<p>El proceso de cancelación y refacturación ha finalizado.</p>',
                        background: 'var(--bg-light)',
                        confirmButtonText: '<i class="fas fa-check"></i> Aceptar',
                        buttonsStyling: false,
                        customClass: {
                            confirmButton: 'custom-swal-confirm'
                        }
                    }).then(() => {
                        location.reload();
                    });
                }
            }

            // Cuenta bancaria del proceso. Se pregunta una sola vez: la nominativa del
            // cliente y la global de reemplazo cobran contra la misma cuenta, que es donde
            // entró el dinero de la venta original. Sin ella el servidor no puede armar la
            // póliza del documento CXC del cobro y aborta el proceso.
            async function obtenerCuentaBancoProceso() {
                if (window.cuentaBancoProceso) return window.cuentaBancoProceso;

                const { value: cuenta } = await Swal.fire({
                    title: 'Cuenta bancaria del cobro',
                    html: `
                        <div class="mb-2 text-start">
                            <label class="form-label">Cuenta donde se registrará el cobro</label>
                            <select id="swal-cuenta-banco-global" class="swal2-select w-100">
                                <option value="">Cargando cuentas...</option>
                            </select>
                        </div>`,
                    showCancelButton: true,
                    confirmButtonText: 'Continuar',
                    cancelButtonText: 'Cancelar',
                    background: 'var(--bg-light)',
                    focusConfirm: false,
                    didOpen: async () => {
                        const select = document.getElementById('swal-cuenta-banco-global');
                        try {
                            const resp = await fetch('/DatosGenerales/DatosBancos').then(r => r.json());
                            select.innerHTML = '<option value="">-- Selecciona --</option>';

                            if (resp.success && resp.result?.length) {
                                resp.result.forEach(c => {
                                    select.innerHTML += `<option value="${c.codigo}">${c.codigo} - ${c.nombre}</option>`;
                                });
                            } else {
                                select.innerHTML = '<option value="">No hay cuentas</option>';
                            }
                        } catch (err) {
                            console.error('Error cargando cuentas:', err);
                            select.innerHTML = '<option value="">Error al cargar</option>';
                        }
                    },
                    preConfirm: () => {
                        const cuenta = document.getElementById('swal-cuenta-banco-global').value;
                        if (!cuenta) {
                            Swal.showValidationMessage('Selecciona una cuenta bancaria');
                            return false;
                        }
                        return cuenta;
                    }
                });

                if (cuenta) window.cuentaBancoProceso = cuenta;
                return cuenta;
            }

            // Función para procesar la factura global
            async function procesarFacturaGlobal() {
                const { seleccionados } = selectionResult;

                // Antes del modal de progreso: si se pidiera después, el diálogo de la
                // cuenta reemplazaría al indicador de carga y lo dejaría muerto.
                const cuentaBanco = await obtenerCuentaBancoProceso();
                if (!cuentaBanco) return;

                Swal.fire({
                    title: '<i class="fas fa-spinner fa-spin"></i> Generando Factura Global',
                    html: '<p style="color: #6c757d;">Procesando documentos seleccionados...</p>',
                    background: 'var(--bg-light)',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => Swal.showLoading()
                });

                try {
                    const formData = new FormData();
                    formData.append('documentos', JSON.stringify(seleccionados));
                    const ids = seleccionados.map(x => x.id_hijo);
                    formData.append("ids", ids.join(","));
                    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (token) {
                        formData.append('__RequestVerificationToken', token);
                    }
                    formData.append("global", encabezadoId);
                    formData.append("banco", cuentaBanco);


                    const response = await fetch('/FacturaGlobalConsulta/ProcesarDocumentosAsync', {
                        method: 'POST',
                        body: formData
                    });

                    const result = await response.json();

                    if (result.success) {
                        await Swal.fire({
                            icon: 'success',
                            title: '<i class="fas fa-check-circle"></i> Factura Global Generada',
                            html: `
<div style="text-align: center; padding: 10px;">
    <div style="background: #d4edda; border: 2px solid var(--success-color); border-radius: 12px; padding: 25px; margin-bottom: 20px;">
        <h4 style="margin: 0 0 15px 0; color: #155724; font-size: 1.2em;">
            <i class="fas fa-check-double"></i> ¡Proceso Completado Exitosamente!
        </h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px;">
            <div style="background: rgba(255,255,255,0.7); padding: 15px; border-radius: 8px;">
                <div style="color: #155724; font-size: 0.85em; margin-bottom: 5px; font-weight: 600;">Documentos Agrupados</div>
                <div style="font-size: 2em; font-weight: 700; color: var(--success-color);">${seleccionados.length}</div>
            </div>
            <div style="background: rgba(255,255,255,0.7); padding: 15px; border-radius: 8px;">
                <div style="color: #155724; font-size: 0.85em; margin-bottom: 5px; font-weight: 600;">Factura Global</div>
                <div style="font-size: 1.3em; font-weight: 700; color: var(--primary-blue);">
                    <i class="fas fa-file-invoice"></i> Generada
                </div>
            </div>
        </div>
    </div>

    ${result.uuid ? `
    <div style="background: var(--very-light-blue); border: 2px solid var(--accent-blue); border-radius: 8px; padding: 15px; margin-bottom: 20px;">
        <div style="color: var(--text-dark); font-weight: 600; margin-bottom: 8px;">
            <i class="fas fa-barcode"></i> UUID Generado:
        </div>
        <div style="var(--bg-light); padding: 12px; border-radius: 6px; font-family: monospace; font-size: 0.9em; color: var(--primary-blue); word-break: break-all;">
            ${result.uuid}
        </div>
    </div>
    ` : ''}

    <div style="background: #d1ecf1; border: 1px solid #bee5eb; border-radius: 8px; padding: 15px;">
        <p style="margin: 0; color: #0c5460; font-size: 0.9em;">
            <i class="fas fa-info-circle" style="color: #17a2b8;"></i>
            La factura global ha sido generada correctamente con todos los documentos seleccionados.
        </p>
    </div>
</div>
`,
                            width: '700px',
                            background: 'var(--bg-light)',
                            confirmButtonText: '<i class="fas fa-check"></i> Finalizar',
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: 'custom-swal-confirm'
                            }
                        });

                        // Recargar la página para actualizar la tabla
                        location.reload();

                    } else {
                        throw new Error(result.message || 'Error al generar la factura global');
                    }

                } catch (error) {
                    console.error('Error:', error);

                    const errorResult = await Swal.fire({
                        icon: 'error',
                        title: '<i class="fas fa-times-circle"></i> Error en Factura Global',
                        html: `
<div style="padding: 10px;">
    <div style="background: #f8d7da; border: 2px solid var(--danger-color); padding: 20px; border-radius: 8px; margin-bottom: 20px;">
        <h4 style="margin: 0 0 10px 0; color: var(--danger-color);">
            <i class="fas fa-exclamation-triangle"></i> No se pudo generar la factura global
        </h4>
        <p style="color: #721c24; margin: 0; word-break: break-word;">${error.message}</p>
    </div>
    
    <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 8px; padding: 15px;">
        <p style="margin: 0; color: #856404; font-size: 0.9em;">
            <i class="fas fa-info-circle"></i> Puede intentar nuevamente o finalizar el proceso.
        </p>
    </div>
</div>
`,
                        width: '600px',
                        background: 'var(--bg-light)',
                        showCancelButton: true,
                        showDenyButton: true,
                        confirmButtonText: '<i class="fas fa-redo"></i> Reintentar',
                        denyButtonText: '<i class="fas fa-times"></i> Finalizar sin Factura Global',
                        cancelButtonText: '<i class="fas fa-arrow-left"></i> Volver',
                        buttonsStyling: false,
                        customClass: {
                            popup: 'custom-swal-popup',
                            confirmButton: 'custom-swal-confirm',
                            denyButton: 'custom-swal-cancel',
                            cancelButton: 'custom-swal-cancel'
                        }
                    });

                    if (errorResult.isConfirmed) {
                        // Reintentar
                        return await procesarFacturaGlobal();
                    } else if (errorResult.isDenied) {
                        // Finalizar sin factura global
                        Swal.fire({
                            icon: 'info',
                            title: '<i class="fas fa-info-circle"></i> Proceso Finalizado',
                            html: `
<div style="padding: 10px;">
    <div style="background: #fff3cd; border: 2px solid #ffc107; border-radius: 8px; padding: 20px;">
        <p style="margin: 0; color: #856404;">
            <i class="fas fa-exclamation-triangle"></i>
            El proceso de cancelación y refacturación individual se completó, pero no se generó la factura global.
        </p>
    </div>
</div>
`,
                            width: '600px',
                            background: 'var(--bg-light)',
                            confirmButtonText: '<i class="fas fa-check"></i> Aceptar',
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: 'custom-swal-confirm'
                            }
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        // Volver al paso anterior
                        return await paso7();
                    }
                }
            }
                // Iniciar el flujo desde el paso 1
                await verificarYCancelarSAT();
            }
        </script>
    }