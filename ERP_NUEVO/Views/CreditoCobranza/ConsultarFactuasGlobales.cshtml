@{
    ViewBag.Title = "Facturas";
    ViewBag.PageTitle = "Facturas Globales";
}
@section styles {
    <style>

        div:where(.swal2-container) .swal2-select {


            background: var(--bg-light) !important;

        }

        select {
            padding: 11px 20px;
            border: 1px solid var(--border-light);
            border-radius: 10px;
            font-size: 14px;
            cursor: pointer;
            background: var(--bg-light);
            color: var(--text-dark);
            font-weight: 500;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 24px 40px;
            background: var(--very-light-blue);
            border-bottom: 1px solid var(--border-light);
        }

        .stat-card {
            background: var(--bg-light);
            padding: 20px 24px;
            border-radius: 12px;
            border-left: 4px solid var(--accent-blue);
            box-shadow: var(--shadow);
        }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

        .stat-label {
            font-size: 0.8em;
            color: var(--text-light);
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-value {
            font-size: 1.75em;
            font-weight: 700;
            color: var(--text-dark);
        }



        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8em;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pagada {
            background: #d1fae5;
            color: var(--success-color);
        }

        .status-pendiente {
            background: #fef3c7;
            color: var(--warning-color);
        }

        .status-cancelada, .status-vencida {
            background: #fee2e2;
            color: var(--danger-color);
        }

        .btn-icon {
            background: transparent;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            padding: 6px 8px;
            font-size: 1.2em;
            border-radius: 6px;
        }

            .btn-icon:hover {
                background: var(--very-light-blue);
                color: var(--accent-blue);
            }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 41, 0.6);
            overflow: auto;
        }

            .modal.active {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: var(--bg-light);
            border-radius: 16px;
            max-width: 920px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            padding: 24px 32px;
            display: flex;
            justify-content: space-between;
        }

            .modal-header h2 {
                font-size: 1.5em;
                font-weight: 700;
            }

        .close-btn {
            background: rgba(255,255,255,0.15);
            border: none;
            color: white;
            font-size: 1.5em;
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
        }

        .modal-body {
            padding: 32px;
        }

        .detail-section {
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 1.1em;
            color: var(--primary-blue);
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--border-light);
            font-weight: 700;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .info-item {
            background: var(--very-light-blue);
            padding: 14px 18px;
            border-radius: 10px;
            border-left: 3px solid var(--accent-blue);
        }

        .info-label {
            font-size: 0.75em;
            color: var(--text-light);
            margin-bottom: 6px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .info-value {
            font-size: 0.95em;
            color: var(--text-dark);
            font-weight: 600;
        }

        .detail-table {
            width: 100%;
            margin-top: 16px;
            border: 1px solid var(--border-light);
            border-radius: 10px;
            overflow: hidden;
        }

            .detail-table th {
                background: var(--very-light-blue);
                padding: 12px 16px;
                font-size: 0.8em;
            }

            .detail-table td {
                padding: 12px 16px;
                border-bottom: 1px solid var(--border-light);
            }

        .totals-box {
            background: var(--very-light-blue);
            padding: 24px;
            border-radius: 12px;
            margin-top: 20px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
        }

            .total-row.final {
                font-size: 1.4em;
                font-weight: 700;
                color: var(--primary-blue);
                border-top: 2px solid var(--border-light);
                padding-top: 16px;
                margin-top: 12px;
            }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 2px solid var(--border-light);
        }

            .modal-actions button {
                padding: 11px 20px;
                background: var(--accent-blue);
                color: white;
                border: none;
                border-radius: 10px;
                cursor: pointer;
                font-weight: 600;
            }

        /* Estilos personalizados para SweetAlert2 */
        .custom-swal-popup {
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
        }

        .custom-swal-title {
            font-size: 24px;
            font-weight: 700;
            padding: 20px 20px 10px;
        }

        .custom-swal-confirm {
            background-color: var(--primary-blue) !important;
            color: white !important;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 4px rgba(30, 58, 95, 0.2);
            margin: 0 8px;
        }

            .custom-swal-confirm:hover {
                background-color: var(--primary-blue-dark) !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(30, 58, 95, 0.3);
            }

            .custom-swal-confirm:active {
                transform: translateY(0);
            }

        .custom-swal-cancel {
            background-color: var(--bg-gray) !important;
            color: var(--text-dark) !important;
            border: 2px solid var(--border-light);
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 0 8px;
        }

            .custom-swal-cancel:hover {
                background-color: var(--border-light) !important;
                border-color: var(--secondary-blue);
            }

        /* Estilos para el mensaje de validación */
        .swal2-validation-message {
            background-color: var(--danger-color);
            color: white;
            border-radius: 6px;
            padding: 10px 15px;
            font-size: 14px;
        }

        /* Estilos para el loader */
        .swal2-loader {
            border-color: var(--accent-blue) transparent var(--accent-blue) transparent;
        }

        /* Iconos de éxito y error */
        .swal2-icon.swal2-success [class^='swal2-success-line'] {
            background-color: var(--success-color);
        }

        .swal2-icon.swal2-success .swal2-success-ring {
            border-color: rgba(5, 150, 105, 0.3);
        }

        .swal2-icon.swal2-error {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }
        .custom-swal-confirm-danger {
            background-color: var(--danger-color) !important;
            color: white !important;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2);
            margin: 0 8px;
        }

            .custom-swal-confirm-danger:hover {
                background-color: #c82333 !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
            }

            .custom-swal-confirm-danger:active {
                transform: translateY(0);
            }
    </style>
    <link href="~/content/TableBuilder.css" rel="stylesheet" />
}
    <form>
        @Html.AntiForgeryToken()
    </form>

    <div class="stats d-none">
        <div class="stat-card">
            <div class="stat-label">Total Facturas</div>
            <div class="stat-value" id="totalInvoices">0</div>
        </div>
        <div class="stat-card success">
            <div class="stat-label">Pagadas</div>
            <div class="stat-value" id="paidInvoices">0</div>
        </div>
        <div class="stat-card warning">
            <div class="stat-label">Pendientes</div>
            <div class="stat-value" id="pendingInvoices">0</div>
        </div>
        <div class="stat-card danger">
            <div class="stat-label">Monto Total</div>
            <div class="stat-value" id="totalAmount">$0.00</div>
        </div>
    </div>
    <div class="toolbar d-none">
        <select id="statusFilter">
            <option value="">Todos los estados</option>
            <option value="pagada">Pagadas</option>
            <option value="pendiente">Pendientes</option>
            <option value="cancelada">Canceladas</option>
            <option value="vencida">Vencidas</option>
        </select>
        <select id="dateFilter">
            <option value="">Todas las fechas</option>
            <option value="today">Hoy</option>
            <option value="week">Esta semana</option>
            <option value="month">Este mes</option>
            <option value="year">Este año</option>
        </select>
    </div>

    <div class="table-wrapper">
        <div class="table-responsive">
            <div id="facturas">

            </div>
        </div>
    </div>
    <div id="detailModal" class="modal">
        <div class="modal-content">
            <div class="modal-header">
                <h2 id="modalTitle">Detalle de Factura</h2>
                <button class="close-btn" onclick="closeModal()">×</button>
            </div>
            <div class="modal-body" id="modalBody"></div>
        </div>
    </div>
    @section scripts {
        <script src="~/Scripts/TableBuilder.js"></script>
        <script src="~/lib/jquery/jquery.min.js"></script>

        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const facturasTabla = createTable({
                    selector: '#facturas',
                    path: '/FacturaGlobalConsulta/ObtenerFacturas',
                    searchPlaceholder: 'Buscar facturas...',
                    columns: [
                        { title: 'Numero de factura', data: 'folio' },
                        { title: 'Cliente', data: 'rsocliente' },
                        { title: 'Fecha de emisión', data: 'fechatimbrado', formatter: (v) => dateFormatter(v) },
                        { title: 'Sucursal', data: 'suc' },
                        { title: 'Monto', data: 'total', formatter: data => `$${Number(data ?? 0).toFixed(2)}` },
                        { title: 'Estatus', data: 'statusfactura' },
                    ],
                    actions: [
                        { icon: "fa-eye", color: "cyan-500", title: "Ver Detalles", onClick: row => showDetail(row.encabezado_id) },
                        { icon: "fa-file-pdf", color: "red-500", title: "Ver PDF", onClick: row => printFactura(row.uuid) },
                        { icon: "fa-file-code", color: "blue-500", title: "Descargar XML", onClick: row => downloadFactura(row.uuid) },
                        { icon: "fa-envelope", color: "emerald-500", title: "Enviar por correo", onClick: row => sendFactura(row.uuid) },
                        { icon: "fa-ban", color: "yellow-500", title: "Cancelar Factura", onClick: row => cancelFactura(row.uuid, row.encabezado_id, row.rfcemisor) }
                    ]
                })
            });

            // Función para mostrar el detalle de la factura
            function showDetail(id) {
                const modal = document.getElementById('detailModal');
                const modalBody = document.getElementById('modalBody');

                modal.classList.add('active');
                modalBody.innerHTML = '<div style="text-align: center; padding: 40px;"><i class="fa fa-spinner fa-spin" style="font-size: 2em; color: var(--primary-blue);"></i><p style="margin-top: 16px; color: var(--text-light);">Cargando detalles...</p></div>';

                fetch(`/FacturaGlobalConsulta/FacturaDetail?id=${id}`)
                    .then(response => {
                        if (!response.ok) {
                            throw new Error('Error al cargar los detalles');
                        }
                        return response.json();
                    })
                    .then(data => {
                        console.log('Data recibida:', data); // Para debug

                        // El backend devuelve un array con un objeto que contiene documento como string
                        if (data && data.length > 0 && data[0].documento) {
                            // El documento viene como string JSON, necesitamos parsearlo
                            const documento = JSON.parse(data[0].documento);
                            console.log('Documento parseado:', documento); // Para debug
                            renderDocumentosDetail(documento);
                        } else {
                            throw new Error('No se encontraron datos');
                        }
                    })
                    .catch(error => {
                        console.error('Error:', error);
                        modalBody.innerHTML = `
                <div style="text-align: center; padding: 40px;">
                    <i class="fa fa-exclamation-circle" style="font-size: 2em; color: var(--danger-color);"></i>
                    <p style="margin-top: 16px; color: var(--text-dark);">Error al cargar los detalles</p>
                    <p style="color: var(--text-light); font-size: 0.9em;">${error.message}</p>
                </div>
            `;
                    });
            }

            // Función para renderizar el detalle de la factura
            function renderDocumentosDetail(documentos) {
                const modalBody = document.getElementById('modalBody');

                // Una factura sin documentos ligados no es un error de carga: es una factura
                // cuyos documentos origen no quedaron marcados con encabezado_hijo.
                if (!Array.isArray(documentos) || documentos.length === 0) {
                    modalBody.innerHTML = `
                <div style="text-align: center; padding: 40px;">
                    <i class="fa fa-folder-open" style="font-size: 2em; color: var(--text-light);"></i>
                    <p style="margin-top: 16px; color: var(--text-dark);">Esta factura no tiene documentos ligados</p>
                    <p style="color: var(--text-light); font-size: 0.9em;">No se encontraron ventas asociadas a este comprobante.</p>
                </div>`;
                    return;
                }

                let totalGeneral = 0;
                let totalPartidas = 0;

                documentos.forEach(doc => {
                    (doc.partidas || []).forEach(p => {
                        totalGeneral += p.imp_part || 0;
                        totalPartidas++;
                    });
                });
                totalGeneral += (totalGeneral * .16)
                let html = `
    <!-- Resumen General -->
    <div class="detail-section" style="margin-bottom: 24px;">
        <div class="section-title" style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%); color: white; padding: 16px 20px; border-radius: 12px; margin-bottom: 16px; box-shadow: var(--shadow-lg);">
            <i class="fa fa-chart-bar"></i> Resumen General
        </div>
        <div class="info-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px;">
            <div class="info-item" style="background: var(--bg-light); border: 2px solid var(--border-light); border-radius: 10px; padding: 20px; text-align: center; transition: all 0.3s ease; box-shadow: var(--shadow);">
                <div class="info-label" style="font-size: 0.85em; color: var(--text-light); margin-bottom: 8px; font-weight: 600; text-transform: uppercase;">
                    <i class="fa fa-file"></i> Total Documentos
                </div>
                <div class="info-value" style="font-size: 2em; font-weight: 700; color: var(--primary-blue);">${documentos.length}</div>
            </div>
            <div class="info-item" style="background: var(--bg-light); border: 2px solid var(--border-light); border-radius: 10px; padding: 20px; text-align: center; transition: all 0.3s ease; box-shadow: var(--shadow);">
                <div class="info-label" style="font-size: 0.85em; color: var(--text-light); margin-bottom: 8px; font-weight: 600; text-transform: uppercase;">
                    <i class="fa fa-list"></i> Total Partidas
                </div>
                <div class="info-value" style="font-size: 2em; font-weight: 700; color: var(--accent-blue);">${totalPartidas}</div>
            </div>
            <div class="info-item" style="background: linear-gradient(135deg, var(--success-color) 0%, #10b981 100%); border: none; border-radius: 10px; padding: 20px; text-align: center; transition: all 0.3s ease; box-shadow: var(--shadow-lg);">
                <div class="info-label" style="font-size: 0.85em; color: rgba(255,255,255,0.9); margin-bottom: 8px; font-weight: 600; text-transform: uppercase;">
                    <i class="fa fa-dollar-sign"></i> Importe Total
                </div>
                <div class="info-value" style="font-size: 2em; font-weight: 700; color: white;">$${totalGeneral.toFixed(2)}</div>
            </div>
        </div>
    </div>
    
    <!-- Documentos -->
    <div class="detail-section">
        <div class="section-title" style="background: var(--bg-light); color: var(--text-dark); padding: 14px 20px; border-radius: 10px; margin-bottom: 20px; border-left: 5px solid var(--accent-blue); box-shadow: var(--shadow);">
            <i class="fa fa-file-alt"></i> Documentos (${documentos.length})
        </div>
        ${documentos.map((doc, index) => {
                    const totalDoc = doc.partidas.reduce((sum, p) => sum + (p.imp_part || 0), 0);

                    return `
            <div style="background: var(--bg-light); border: 2px solid var(--border-light); border-radius: 16px; padding: 0; margin-bottom: 24px; overflow: hidden; box-shadow: var(--shadow-lg); transition: all 0.3s ease;">
                
                <!-- Encabezado del Documento con Color -->
                <div style="background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%); color: white; padding: 20px 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
                    <div style="flex: 1; min-width: 250px;">
                        <div style="display: inline-block; background: rgba(255,255,255,0.15); padding: 6px 12px; border-radius: 6px; font-size: 0.75em; font-weight: 600; margin-bottom: 8px; text-transform: uppercase; letter-spacing: 0.5px;">
                            Documento #${index + 1}
                        </div>
                        <h3 style="margin: 0 0 8px 0; font-size: 1.4em; font-weight: 700;">
                            <i class="fa fa-file-invoice"></i> ${doc.gen}-${doc.nat}-${doc.folio}
                        </h3>
                        <p style="margin: 0; opacity: 0.9; font-size: 0.95em;">
                            <i class="fa fa-calendar"></i> ${formatDate(doc.fecha)}
                        </p>
                    </div>
                    <div style="text-align: right; background: rgba(255,255,255,0.1); padding: 16px 24px; border-radius: 10px; backdrop-filter: blur(10px);">
                        <div style="font-size: 0.8em; opacity: 0.9; margin-bottom: 4px; text-transform: uppercase; letter-spacing: 0.5px;">Total Documento</div>
                        <div style="font-size: 1.8em; font-weight: 700; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">
                            $${totalDoc.toFixed(2)}
                        </div>
                    </div>
                </div>
                
                <!-- Contenido del Documento -->
                <div style="padding: 24px;">
                    
                    <!-- Info del Cliente -->
                    <div style="background: var(--very-light-blue); border-left: 4px solid var(--accent-blue); padding: 16px 20px; border-radius: 10px; margin-bottom: 24px;">
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <div style="background: var(--accent-blue); color: white; width: 40px; height: 40px; border-radius: 50%; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                                <i class="fa fa-user"></i>
                            </div>
                            <div style="flex: 1;">
                                <div style="font-size: 0.75em; color: var(--text-light); margin-bottom: 4px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">
                                    Cliente
                                </div>
                                <div style="font-weight: 600; color: var(--text-dark); font-size: 1.05em;">${doc.cliente}</div>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Partidas Header -->
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 2px solid var(--border-light);">
                        <h4 style="margin: 0; color: var(--text-dark); font-size: 1.1em;">
                            <i class="fa fa-boxes"></i> Partidas (${doc.partidas.length})
                        </h4>
                    </div>
                    
                    <!-- Tabla de Partidas -->
                    <div style="overflow-x: auto; border-radius: 10px; border: 1px solid var(--border-light);">
                        <table style="width: 100%; border-collapse: collapse; font-size: 0.95em;">
                            <thead>
                                <tr style="background: var(--primary-blue); color: white;">
                                    <th style="padding: 14px 12px; text-align: center; font-weight: 600; width: 50px; border-right: 1px solid rgba(255,255,255,0.1);">#</th>
                                    <th style="padding: 14px 16px; text-align: left; font-weight: 600; border-right: 1px solid rgba(255,255,255,0.1);">Clave</th>
                                    <th style="padding: 14px 16px; text-align: left; font-weight: 600; border-right: 1px solid rgba(255,255,255,0.1);">Descripción</th>
                                    <th style="padding: 14px 12px; text-align: center; font-weight: 600; width: 90px; border-right: 1px solid rgba(255,255,255,0.1);">Cantidad</th>
                                    <th style="padding: 14px 12px; text-align: center; font-weight: 600; width: 70px; border-right: 1px solid rgba(255,255,255,0.1);">UDM</th>
                                    <th style="padding: 14px 16px; text-align: right; font-weight: 600; width: 120px; border-right: 1px solid rgba(255,255,255,0.1);">P. Unit.</th>
                                    <th style="padding: 14px 16px; text-align: right; font-weight: 600; width: 130px;">Importe</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${doc.partidas.map((partida, idx) => `
                                    <tr style="background: ${idx % 2 === 0 ? 'var(--bg-light)' : 'var(--very-light-blue)'}; transition: all 0.2s ease;">
                                        <td style="padding: 14px 12px; text-align: center; color: var(--text-light); font-weight: 600; border-bottom: 1px solid var(--border-light);">
                                            ${idx + 1}
                                        </td>
                                        <td style="padding: 14px 16px; font-family: 'Courier New', monospace; font-size: 0.9em; font-weight: 600; color: var(--secondary-blue); border-bottom: 1px solid var(--border-light);">
                                            ${partida.cve_prod}
                                        </td>
                                        <td style="padding: 14px 16px; border-bottom: 1px solid var(--border-light);">
                                            <strong style="color: var(--text-dark);">${partida.descr_prod}</strong>
                                        </td>
                                        <td style="padding: 14px 12px; text-align: center; font-weight: 600; color: var(--text-dark); border-bottom: 1px solid var(--border-light);">
                                            ${partida.cant_ud}
                                        </td>
                                        <td style="padding: 14px 12px; text-align: center; color: var(--text-light); font-size: 0.9em; border-bottom: 1px solid var(--border-light);">
                                            ${partida.ud}
                                        </td>
