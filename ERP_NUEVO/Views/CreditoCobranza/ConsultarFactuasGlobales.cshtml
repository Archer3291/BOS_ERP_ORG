                                confirmButton: 'custom-swal-confirm'
                            }
                        });
                        return null;
                    }
                }

                // ============================================
                // NUEVA FUNCIÓN: Ejecutar cancelación en SAT
                // ============================================
                async function ejecutarCancelacionSAT() {
                    Swal.fire({
                        title: '<i class="fas fa-spinner fa-spin"></i> Cancelando en SAT',
                        html: '<p style="color: #6c757d;">Procesando cancelación ante el SAT...</p>',
                        background: 'var(--bg-light)',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        didOpen: () => Swal.showLoading()
                    });

                    try {
                        // El paso 3 pide el motivo y lo valida, pero aquí iba '04' fijo:
                        // lo que el usuario elegía se descartaba en silencio (y el folio de
                        // sustitución del motivo 01 nunca se enviaba). Para este proceso el
                        // 04 sigue siendo el correcto, y es el que viene preseleccionado.
                        const motivoCancelacion = (formValues && formValues.motivo) || '04';
                        const folioSust = (formValues && formValues.folioSustitucion) || '';

                        const formData = new FormData();
                        formData.append('rfcEmisor', rfcEmisor);
                        formData.append('uuid', uuid);
                        formData.append('motivo', motivoCancelacion);
                        formData.append('folioSustitucion', folioSust);
                        formData.append('encabezadoId', encabezadoId);

                        // Si ya existe un procesoId, enviarlo
                        if (window.procesoIdActual) {
                            formData.append('procesoId', window.procesoIdActual);
                        }

                        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                        if (token) {
                            formData.append('__RequestVerificationToken', token);
                        }

                        const response = await fetch('/FacturaGlobalConsulta/CancelarFactura', {
                            method: 'POST',
                            body: formData
                        });

                        const result = await response.json();

                        if (!result.success) {
                            throw new Error(result.message || 'Error al cancelar en el SAT');
                        }

                        // Guardar procesoId
                        window.procesoIdActual = result.procesoId;

                        // Mostrar éxito y continuar
                        await Swal.fire({
                            icon: 'success',
                            title: '<i class="fas fa-check-circle"></i> Cancelación Exitosa',
                            html: `
<div style="padding: 15px;">
            <div style="background: var(--very-light-blue); border-left: 4px solid var(--success-color); padding: 15px; border-radius: 8px; margin-bottom: 15px;">
        <p style="margin: 0; color: var(--text-dark); font-weight: 600;">
            <i class="fas fa-check-circle" style="color: var(--success-color);"></i>
            Ya cancelado en el SAT
        </p>
        <p style="margin: 5px 0 0 24px; font-size: 0.9em; color: var(--text-light);">
            Acuse disponible: <a href="${acuseURL}" target="_blank" style="color: var(--accent-blue);">Ver acuse</a>
        </p>
    </div>

    <div style="background: #d4edda; border: 2px solid var(--success-color); border-radius: 12px; padding: 20px; margin-bottom: 15px;">
        <p style="margin: 0; color: #155724; font-weight: 600;">
            <i class="fas fa-check-circle"></i> La factura fue cancelada exitosamente ante el SAT
        </p>
    </div>
    <div style="background: var(--very-light-blue); padding: 12px; border-radius: 8px;">
        <p style="margin: 0; color: var(--text-dark); font-size: 0.9em;">
            Ahora puede continuar con el proceso de refacturación
        </p>
    </div>
</div>
`,
                            width: '550px',
                            background: 'var(--bg-light)',
                            confirmButtonText: '<i class="fas fa-arrow-right"></i> Continuar',
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: 'custom-swal-confirm'
                            }
                        });

                        // Continuar con el flujo
                        return await paso5();

                    } catch (error) {
                        console.error('Error:', error);
                        await Swal.fire({
                            icon: 'error',
                            title: '<i class="fas fa-times-circle"></i> Error al Cancelar',
                            html: `
<div style="padding: 10px;">
    <div style="background: #f8d7da; border: 2px solid var(--danger-color); padding: 20px; border-radius: 8px;">
        <p style="color: #721c24; margin: 0; word-break: break-word;">
            ${error.message}
        </p>
    </div>
</div>
`,
                            width: '500px',
                            background: 'var(--bg-light)',
                            confirmButtonText: '<i class="fas fa-check"></i> Cerrar',
                            buttonsStyling: false,
                            customClass: {
                                confirmButton: 'custom-swal-confirm'
                            }
                        });
                        return null;
                    }
                }

                // PASO 1: Cargar documentos
                async function paso1() {
                    Swal.fire({
                        title: '<i class="fas fa-spinner fa-spin"></i> Cargando Información',
                        html: '<p style="color: #6c757d;">Obteniendo detalles de la factura...</p>',
                        background: 'var(--bg-light)',
                        allowOutsideClick: false,
                        allowEscapeKey: false,
                        showConfirmButton: false,
                        didOpen: () => Swal.showLoading()
                    });

                    try {
                        // Con procesoId el backend descarta los documentos que ya se le
                        // facturaron al cliente en este proceso: sólo quedan los pendientes.
                        const urlDetalle = window.procesoIdActual
                            ? `/FacturaGlobalConsulta/FacturaDetail?id=${encabezadoId}&procesoId=${window.procesoIdActual}`
                            : `/FacturaGlobalConsulta/FacturaDetail?id=${encabezadoId}`;

                        const response = await fetch(urlDetalle);
                        if (!response.ok) throw new Error('Error al cargar los detalles');

                        const data = await response.json();
                        if (!data || data.length === 0 || !data[0].documento) {
                            throw new Error('No se encontraron datos');
                        }

                        documentos = JSON.parse(data[0].documento);

                        // Si ya hay documentos con su factura nominativa emitida, esto es la
                        // continuación de un proceso: lo que queda va completo a la global.
                        continuandoProceso = (data[0].ya_refacturados || 0) > 0;

                        return await paso2();

                    } catch (error) {
                        console.error('Error:', error);
                        Swal.fire({
                            icon: 'error',
                            title: '<i class="fas fa-times-circle"></i> Error',
                            html: `<div style="padding: 10px;"><div style="background: #f8d7da; padding: 20px; border-radius: 8px;"><p style="color: #721c24; margin: 0;">${error.message}</p></div></div>`,
                            width: '500px',
                            background: 'var(--bg-light)',
                            confirmButtonText: '<i class="fas fa-check"></i> Cerrar',
                            buttonsStyling: false,
                            customClass: { confirmButton: 'custom-swal-confirm' }
                        });
                    }
                }

                // PASO 2: Selección de documentos
                async function paso2() {
                    const result = await Swal.fire({
                        title: '<i class="fas fa-list-check"></i> Seleccionar Documentos a Cancelar',
                        html: `
<div style="text-align:left; padding: 10px;">
    <div style="background: #f8f9fa; padding: 12px; border-radius: 8px; margin-bottom: 15px; border-left: 4px solid var(--primary-blue);">
        <p style="margin: 3px 0; color: #495057; font-size: 0.85em;">
            <i class="fas fa-hashtag" style="color: var(--primary-blue); width: 18px;"></i>
            <strong>UUID:</strong> <span style="font-family: monospace; font-size: 0.9em;">${uuid}</span>
        </p>
        <p style="margin: 3px 0; color: #495057; font-size: 0.85em;">
            <i class="fas fa-building" style="color: var(--primary-blue); width: 18px;"></i>
            <strong>RFC Emisor:</strong> <span style="font-family: monospace;">${rfcEmisor}</span>
        </p>
    </div>

    <div style="background: #fff3cd; border: 1px solid #ffc107; border-radius: 6px; padding: 10px; margin-bottom: 15px;">
        <p style="margin: 0; color: #856404; font-size: 0.85em;">
            <i class="fas fa-info-circle" style="color: #ffc107;"></i>
            ${continuandoProceso ? `
            <strong>Continuación del proceso:</strong> las facturas nominativas del cliente ya se emitieron
            y esos documentos ya no aparecen aquí. Marque los que deben integrar la
            <strong>nueva factura global</strong> — normalmente, todos.
            ` : `
            <strong>Instrucciones:</strong> Marque los documentos que deben <strong>seguir en la factura global</strong>.
            Los que deje <strong>sin marcar</strong> se le facturarán de forma nominativa al cliente.
            La factura global actual se cancela completa y se vuelve a emitir sólo con los marcados.
            `}
        </p>
    </div>

    <div style="margin-bottom: 12px;">
        <div style="position: relative; margin-bottom: 10px;">
            <i class="fas fa-search" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--text-light);"></i>
            <input type="text" 
                   id="searchInput" 
                   placeholder="Buscar por folio, cliente o fecha..."
                   style="width: 100%; padding: 10px 12px 10px 38px; border: 2px solid var(--border-light); border-radius: 8px; font-size: 0.9em; transition: all 0.2s ease;">
        </div>
        
        <div style="display: flex; gap: 8px; justify-content: space-between; align-items: center; flex-wrap: wrap;">
            <div style="display: flex; gap: 8px;">
                <button id="selectAllBtn" class="btn-selection" style="padding: 6px 12px; background: var(--primary-blue); color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85em; font-weight: 600;">
                    <i class="fas fa-check-double"></i> Todos
                </button>
                <button id="deselectAllBtn" class="btn-selection" style="padding: 6px 12px; background: var(--bg-gray); color: var(--text-dark); border: 2px solid var(--border-light); border-radius: 6px; cursor: pointer; font-size: 0.85em; font-weight: 600;">
                    <i class="fas fa-times"></i> Ninguno
                </button>
            </div>
            <div id="selectionCounter" style="font-weight: 600; color: var(--primary-blue); font-size: 0.9em;">
                <i class="fas fa-check-circle"></i> 0 de ${documentos.length}
            </div>
        </div>
    </div>

    <div id="documentosContainer" style="max-height: 500px; overflow-y: auto; border: 2px solid var(--border-light); border-radius: 8px; padding: 12px; background: var(--bg-light); display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 10px;">
        ${documentos.map((doc, index) => {
                            const totalDoc = doc.partidas.reduce((sum, p) => sum + (p.imp_part || 0), 0);
                            return `
                <div class="documento-item" data-index="${index}" style="background: var(--bg-light); border: 2px solid var(--border-light); border-radius: 10px; padding: 12px; cursor: pointer; transition: all 0.2s ease; display: flex; flex-direction: column; height: 100%;">
                    <div style="display: flex; align-items: start; gap: 10px; margin-bottom: 10px;">
                        <input type="checkbox" 
                               class="doc-checkbox" 
                               id="doc_${index}" 
                               data-doc-index="${index}"
                               ${selectionResult && selectionResult.seleccionados.some(s => s.folio === doc.folio) ? 'checked' : ''}
                               style="width: 20px; height: 20px; cursor: pointer; accent-color: var(--primary-blue); margin-top: 2px; flex-shrink: 0;">
                        
                        <div style="flex: 1; min-width: 0;">
                            <h4 style="margin: 0 0 4px 0; color: var(--primary-blue); font-size: 1em; font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                <i class="fas fa-file-invoice" style="font-size: 0.9em;"></i> ${doc.gen}-${doc.nat}-${doc.folio}
                            </h4>
                            <p style="margin: 0 0 8px 0; color: var(--text-light); font-size: 0.8em;">
                                <i class="fas fa-calendar" style="font-size: 0.9em;"></i> ${formatDate(doc.fecha)}
                            </p>
                        </div>
                    </div>
                    
                    <div style="background: var(--very-light-blue); padding: 8px; border-radius: 6px; margin-bottom: 8px;">
                        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                            <i class="fas fa-user" style="color: var(--accent-blue); font-size: 0.85em; flex-shrink: 0;"></i>
                            <span style="font-weight: 600; color: var(--text-dark); font-size: 0.85em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="${doc.cliente}">${doc.cliente}</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <i class="fas fa-boxes" style="color: var(--accent-blue); font-size: 0.85em;"></i>
                            <span style="font-size: 0.8em; color: var(--text-dark);"><strong>${doc.partidas.length}</strong> partidas</span>
                        </div>
                    </div>

                    <div style="margin-top: auto; text-align: right; background: var(--bg-light); padding: 8px 10px; border-radius: 6px;">
                        <div style="font-size: 0.7em; color: var(--text-light); margin-bottom: 2px; text-transform: uppercase; font-weight: 600;">Total</div>
                        <div style="font-size: 1.15em; font-weight: 700; color: var(--primary-blue); font-family: monospace;">$${totalDoc.toFixed(2)}</div>
                    </div>
                </div>
            `;
                        }).join('')}
    </div>
</div>
`,
                        width: '1000px',
                        background: 'var(--bg-light)',
                        showCancelButton: true,
                        confirmButtonText: '<i class="fas fa-arrow-right"></i> Continuar',
                        cancelButtonText: '<i class="fas fa-times"></i> Cancelar',
                        buttonsStyling: false,
                        customClass: {
                            popup: 'custom-swal-popup',
                            title: 'custom-swal-title',
                            confirmButton: 'custom-swal-confirm',
                            cancelButton: 'custom-swal-cancel'
                        },
                        didOpen: () => {
                            const checkboxes = document.querySelectorAll('.doc-checkbox');
                            const selectAllBtn = document.getElementById('selectAllBtn');
                            const deselectAllBtn = document.getElementById('deselectAllBtn');
                            const counter = document.getElementById('selectionCounter');
                            const documentosItems = document.querySelectorAll('.documento-item');
                            const searchInput = document.getElementById('searchInput');

                            function updateCounter() {
                                const visibleCheckboxes = Array.from(checkboxes).filter(cb => {
                                    const docItem = cb.closest('.documento-item');
                                    return docItem.style.display !== 'none';
                                });
                                const selectedCount = visibleCheckboxes.filter(cb => cb.checked).length;
                                const visibleCount = visibleCheckboxes.length;
                                counter.innerHTML = `<i class="fas fa-check-circle"></i> ${selectedCount} de ${visibleCount}`;
                            }

                            function filterDocuments() {
                                const searchTerm = searchInput.value.toLowerCase().trim();
                                let visibleCount = 0;

                                documentosItems.forEach(item => {
                                    const index = item.dataset.index;
                                    const doc = documentos[index];
                                    const folio = `${doc.gen}-${doc.nat}-${doc.folio}`.toLowerCase();
                                    const cliente = doc.cliente.toLowerCase();
                                    const fecha = formatDate(doc.fecha).toLowerCase();

                                    const matches = folio.includes(searchTerm) ||
                                        cliente.includes(searchTerm) ||
                                        fecha.includes(searchTerm);

                                    if (matches) {
                                        item.style.display = 'flex';
                                        visibleCount++;
                                    } else {
                                        item.style.display = 'none';
                                    }
                                });

                                updateCounter();

                                if (visibleCount === 0) {
                                    const container = document.getElementById('documentosContainer');
                                    if (!document.getElementById('noResultsMsg')) {
                                        const msg = document.createElement('div');
                                        msg.id = 'noResultsMsg';
                                        msg.style.cssText = 'grid-column: 1/-1; text-align: center; padding: 40px; color: var(--text-light);';
                                        msg.innerHTML = '<i class="fas fa-search" style="font-size: 3em; opacity: 0.3; margin-bottom: 10px;"></i><br><strong>No se encontraron documentos</strong><br><span style="font-size: 0.9em;">Intenta con otro término de búsqueda</span>';
                                        container.appendChild(msg);
                                    }
                                } else {
                                    const noResultsMsg = document.getElementById('noResultsMsg');
                                    if (noResultsMsg) noResultsMsg.remove();
                                }
                            }

                            searchInput.addEventListener('input', filterDocuments);

                            searchInput.addEventListener('focus', function () {
                                this.style.borderColor = 'var(--primary-blue)';
                                this.style.boxShadow = '0 0 0 3px rgba(30, 58, 95, 0.1)';
                            });

                            searchInput.addEventListener('blur', function () {
                                this.style.borderColor = 'var(--border-light)';
                                this.style.boxShadow = 'none';
                            });

                            function updateDocumentStyle(checkbox) {
                                const docItem = checkbox.closest('.documento-item');
                                if (checkbox.checked) {
                                    docItem.style.borderColor = 'var(--success-color)';
                                    docItem.style.background = '#f0fdf4';
                                    docItem.style.boxShadow = '0 3px 8px rgba(5, 150, 105, 0.15)';
                                    docItem.style.transform = 'translateY(-2px)';
                                } else {
                                    docItem.style.borderColor = 'var(--border-light)';
                                    docItem.style.background = 'white';
                                    docItem.style.boxShadow = 'none';
                                    docItem.style.transform = 'translateY(0)';
                                }
                            }

                            checkboxes.forEach(checkbox => {
                                checkbox.addEventListener('change', () => {
                                    updateCounter();
                                    updateDocumentStyle(checkbox);
                                });
                                updateDocumentStyle(checkbox);
                            });

                            documentosItems.forEach(item => {
                                item.addEventListener('click', (e) => {
                                    if (e.target.classList.contains('doc-checkbox')) return;
                                    const checkbox = item.querySelector('.doc-checkbox');
                                    checkbox.checked = !checkbox.checked;
                                    updateCounter();
                                    updateDocumentStyle(checkbox);
                                });

                                item.addEventListener('mouseenter', () => {
                                    if (!item.querySelector('.doc-checkbox').checked) {
                                        item.style.borderColor = 'var(--primary-blue)';
                                        item.style.boxShadow = '0 3px 8px rgba(30, 58, 95, 0.12)';
                                        item.style.transform = 'translateY(-2px)';
                                    }
                                });

                                item.addEventListener('mouseleave', () => {
                                    const checkbox = item.querySelector('.doc-checkbox');
                                    if (!checkbox.checked) {
                                        item.style.borderColor = 'var(--border-light)';
                                        item.style.boxShadow = 'none';
                                        item.style.transform = 'translateY(0)';
                                    }
                                });
                            });

                            selectAllBtn.addEventListener('click', () => {
                                const visibleCheckboxes = Array.from(checkboxes).filter(cb => {
                                    const docItem = cb.closest('.documento-item');
                                    return docItem.style.display !== 'none';
                                });
                                visibleCheckboxes.forEach(cb => {
                                    cb.checked = true;
                                    updateDocumentStyle(cb);
                                });
                                updateCounter();
                            });

                            deselectAllBtn.addEventListener('click', () => {
                                const visibleCheckboxes = Array.from(checkboxes).filter(cb => {
                                    const docItem = cb.closest('.documento-item');
                                    return docItem.style.display !== 'none';
                                });
                                visibleCheckboxes.forEach(cb => {
                                    cb.checked = false;
                                    updateDocumentStyle(cb);
                                });
                                updateCounter();
                            });

                            updateCounter();
                        },
                        preConfirm: () => {
                            const checkboxes = document.querySelectorAll('.doc-checkbox');
                            const documentosSeleccionados = [];
                            const documentosNoSeleccionados = [];

                            checkboxes.forEach((checkbox, index) => {
                                if (checkbox.checked) {
                                    documentosSeleccionados.push(documentos[index]);
                                } else {
                                    documentosNoSeleccionados.push(documentos[index]);
                                }
                            });

                            // Sólo aplica en la selección inicial: hay que apartar el
                            // documento que se le facturará al cliente. Al continuar un
                            // proceso, esa factura ya se emitió y su documento ni siquiera
                            // aparece en la lista, así que todo lo que queda va a la global.
                            if (!continuandoProceso && documentosNoSeleccionados.length === 0) {
                                Swal.showValidationMessage('<i class="fas fa-exclamation-circle"></i> Deje al menos un documento sin marcar: es el que se facturará al cliente');
                                return false;
                            }

                            // Sin documentos marcados no hay global que reemitir, y el paso 7
                            // fallaba con "No se recibieron IDs válidos" cuando la factura ya
                            // estaba cancelada en el SAT y las nominativas ya timbradas.
                            if (documentosSeleccionados.length === 0) {
                                Swal.showValidationMessage('<i class="fas fa-exclamation-circle"></i> Marque al menos un documento: sin ellos no hay factura global que volver a emitir');
                                return false;
                            }

                            return {
                                seleccionados: documentosSeleccionados,
                                noCancelados: documentosNoSeleccionados
                            };
                        }
                    });

                    if (result.isConfirmed) {
                        selectionResult = result.value;
                        return await paso3();
                    }
                    return null;
                }

                // PASO 3: Resumen y motivo
                async function paso3() {
                    const { seleccionados, noCancelados } = selectionResult;

                    const result = await Swal.fire({
                        title: '<i class="fas fa-clipboard-check"></i> Confirmar Selección',
                        html: `
<div style="text-align:left; padding: 10px;">
    <div style="background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue)); color: white; padding: 20px; border-radius: 12px; margin-bottom: 20px; box-shadow: var(--shadow-lg);">
        <h4 style="margin: 0 0 15px 0; font-size: 1.2em;">
            <i class="fas fa-chart-pie"></i> Resumen de Selección
        </h4>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 15px;">
            <div style="background: rgba(255,255,255,0.15); padding: 15px; border-radius: 10px; backdrop-filter: blur(10px);">
                <div style="font-size: 0.85em; opacity: 0.9; margin-bottom: 5px;">Documentos a Mantener</div>
                <div style="font-size: 2em; font-weight: 700;">${seleccionados.length}</div>
            </div>
            <div style="background: rgba(255,255,255,0.15); padding: 15px; border-radius: 10px; backdrop-filter: blur(10px);">
                <div style="font-size: 0.85em; opacity: 0.9; margin-bottom: 5px;">Documentos a Cancelar</div>
                <div style="font-size: 2em; font-weight: 700;">${noCancelados.length}</div>
            </div>
        </div>
    </div>

    ${seleccionados.length > 0 ? `
    <div style="margin-bottom: 20px;">
        <h5 style="color: var(--success-color); margin-bottom: 10px;">
            <i class="fas fa-check-circle"></i> Documentos que se Mantendrán (${seleccionados.length})
        </h5>
        <div style="max-height: 150px; overflow-y: auto; background: var(--very-light-blue); padding: 10px; border-radius: 8px; border-left: 4px solid var(--success-color);">
            ${seleccionados.map(doc => `
                <div style="padding: 8px; margin-bottom: 5px; background: var(--bg-light); border-radius: 6px; font-size: 0.9em;">
                    <strong>${doc.gen}-${doc.nat}-${doc.folio}</strong> - ${doc.cliente}
                </div>
            `).join('')}
        </div>
    </div>
    ` : ''}

    <div style="margin-bottom: 20px;">
        <h5 style="color: var(--danger-color); margin-bottom: 10px;">
            <i class="fas fa-ban"></i> Documentos que se Cancelarán (${noCancelados.length})
        </h5>
        <div style="max-height: 150px; overflow-y: auto; background: #fee2e2; padding: 10px; border-radius: 8px; border-left: 4px solid var(--danger-color);">
            ${noCancelados.map(doc => `
                <div style="padding: 8px; margin-bottom: 5px; background: var(--bg-light); border-radius: 6px; font-size: 0.9em;">
                    <strong>${doc.gen}-${doc.nat}-${doc.folio}</strong> - ${doc.cliente}
                </div>
            `).join('')}
        </div>
