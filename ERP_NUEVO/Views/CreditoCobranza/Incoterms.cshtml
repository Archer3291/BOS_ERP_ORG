@{
    ViewBag.Title = "Incoterms";
    ViewBag.PageTitle = "Incoterms";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<script>window.document.title = 'Incoterms'</script>
<div class="container-fluid py-4">
    <div class="contenedor-tabla">
        <div class="card-body">
            <div class="row">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="button" class="btn btn-outline-primary mb-3 blue-500" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms" id="btnAddIncoterm" onclick="createIncoterm()">
                        <i class="fa-duotone fa-solid fa-plus fa-beat"></i> Nuevo Incoterm
                    </button>
                </div>
            </div>
            <div class="table-responsive-sm">
                <table id="incotermsTable" class="modern-table" style="width:100%">
                    <thead class="bg-secondary">
                        <tr>
                            <th>Clave</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar incoterm -->
<div class="modal fade animate__animated animate__bounceIn" id="incotermModal" tabindex="-1" aria-labelledby="incotermModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="incotermModalLabel">Registrar Nuevo Incoterm</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="incotermForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="action" value="add">
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-key trailing"></i>
                        <input type="text" id="Clave" class="form-control form-icon-trailing" name="Clave" />
                        <label class="form-label" for="c1">Ingresar clave</label>
                    </div>
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                        <input type="text" id="Descripcion" class="form-control form-icon-trailing" name="Descripcion" />
                        <label class="form-label" for="c2">Ingresar descripción</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-mdb-ripple-init data-mdb-ripple-color="danger" data-mdb-ripple-duration="1000ms" data-bs-dismiss="modal">
                    <i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar
                </button>
                <button type="button" class="btn btn-outline-success" data-mdb-ripple-init data-mdb-ripple-color="success" data-mdb-ripple-duration="1000ms" id="btnSaveIncoterm" onclick="sendForm()">
                    <i class="fa-duotone fa-solid fa-floppy-disk fa-beat"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Credito_Cobranza/incoterms.js"></script>
}
