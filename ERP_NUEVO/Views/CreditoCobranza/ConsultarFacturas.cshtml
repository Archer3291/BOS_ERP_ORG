                    <label style="display:block;font-weight:600;margin-bottom:6px;color:#374151;font-size:0.9rem;">
                        <i class="fas fa-calendar-check"></i> Fecha de carga al portal *
                    </label>
                    <input type="date" id="fechaCargaInput"
                        value="${hoy}" max="${hoy}"
                        style="width:100%;padding:0.75rem;border:2px solid #e5e7eb;border-radius:8px;font-size:0.95rem;box-sizing:border-box;"/>
                    <small style="color:#6b7280;font-size:0.78rem;margin-top:3px;display:block;">
                        <i class="fas fa-info-circle"></i> A partir de esta fecha inicia el conteo del plazo.
                    </small>
