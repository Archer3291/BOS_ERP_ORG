                    <div id="fechaVencimientoEstimada" style="color:#047857;font-size:1.05rem;font-weight:700;margin-top:4px;"></div>
                    <div id="diasAlertaLabel" style="margin-top:4px;font-size:0.8rem;"></div>
                </div>

                <!-- Observaciones -->
                <textarea id="obsPortal" rows="2" placeholder="Observaciones opcionales..."
                    style="width:100%;padding:0.75rem;border:2px solid #e5e7eb;border-radius:8px;
                           font-family:inherit;resize:vertical;font-size:0.88rem;box-sizing:border-box;"></textarea>
            </div>`,
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-save"></i> Registrar',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#7c3aed',
                width: '600px',
                didOpen: () => {
                    const calcular = () => {
                        const fecha = document.getElementById('fechaCargaInput').value;
                        const selectVal = document.getElementById('diasCreditoSelect').value;
                        const dias = selectVal === 'custom'
                            ? parseInt(document.getElementById('diasCreditoCustom').value) || 0
                            : parseInt(selectVal);

                        if (fecha && dias) {
                            const venc = new Date(fecha + 'T12:00:00');
                            venc.setDate(venc.getDate() + dias);
                            const hoyDate = new Date();
                            const diffMs = venc - hoyDate;
                            const diasRestantes = Math.ceil(diffMs / (1000 * 60 * 60 * 24));

                            document.getElementById('fechaVencimientoEstimada').textContent =
                                venc.toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' });

                            const alertaEl = document.getElementById('diasAlertaLabel');
                            if (diasRestantes < 0) {
                                alertaEl.innerHTML = `<span style="color:#dc2626;font-weight:600;"><i class="fas fa-exclamation-triangle"></i> ¡Ya vencida! (${Math.abs(diasRestantes)} días atrás)</span>`;
                            } else if (diasRestantes <= 5) {
                                alertaEl.innerHTML = `<span style="color:#d97706;font-weight:600;"><i class="fas fa-clock"></i> Por vencer en ${diasRestantes} día${diasRestantes !== 1 ? 's' : ''}</span>`;
                            } else {
                                alertaEl.innerHTML = `<span style="color:#059669;"><i class="fas fa-check"></i> ${diasRestantes} días restantes</span>`;
                            }
                        }
                    };

                    document.getElementById('fechaCargaInput').addEventListener('change', calcular);
                    document.getElementById('diasCreditoSelect').addEventListener('change', function () {
                        const customInput = document.getElementById('diasCreditoCustom');
                        customInput.style.display = this.value === 'custom' ? 'block' : 'none';
                        if (this.value !== 'custom') customInput.value = '';
                        calcular();
                    });
                    document.getElementById('diasCreditoCustom').addEventListener('input', calcular);
                    calcular(); // ejecutar al abrir
                },
                preConfirm: () => {
                    const fecha = document.getElementById('fechaCargaInput').value;
                    const selectVal = document.getElementById('diasCreditoSelect').value;
                    const dias = selectVal === 'custom'
                        ? parseInt(document.getElementById('diasCreditoCustom').value)
                        : parseInt(selectVal);
                    const obs = document.getElementById('obsPortal').value.trim();

                    if (!fecha) { Swal.showValidationMessage('La fecha es obligatoria'); return false; }
                    if (!dias || dias < 1) { Swal.showValidationMessage('Los días de crédito son obligatorios'); return false; }

                    return { fecha, dias, obs };
                }
            }).then(async result => {
                if (!result.isConfirmed) return;

                const { fecha, dias, obs } = result.value;
                const formData = new FormData();
                formData.append('uuid', uuid);
                formData.append('fechaCargaPortal', fecha);
                formData.append('diasCredito', dias);
                formData.append('observaciones', obs);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) formData.append('__RequestVerificationToken', token);

                const resp = await fetch('/FacturaConsulta/RegistrarCargaPortal', { method: 'POST', body: formData });
                const data = await resp.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Carga registrada',
                        html: `<div style="text-align:center">
                    <p>Fecha de carga: <strong>${data.fechaCarga}</strong></p>
                    <p>Vencimiento: <strong>${data.fechaVencimiento}</strong></p>
                    <p style="color:${data.diasRestantes < 0 ? '#dc2626' : '#059669'};font-weight:600;">
                        ${data.diasRestantes >= 0 ? `${data.diasRestantes} días restantes` : '⚠️ VENCIDA'}
                    </p>
                </div>`,
                        confirmButtonColor: '#7c3aed'
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error', text: data.message });
                }
            });
        }


        // ============================================
        // CANCELAR FACTURA
        // ============================================
        async function cancelFactura(uuid, rfcEmisor) {
            const { value: formValues } = await Swal.fire({
                title: '<i class="fas fa-ban"></i> Cancelar Factura',
                html: `
                    <div style="text-align:left;padding:10px;">
                        <div style="background:#f8f9fa;padding:15px;border-radius:8px;margin-bottom:20px;border-left:4px solid var(--primary-blue);">
                            <p style="margin:5px 0;color:#495057;"><strong>UUID:</strong> <span style="font-family:monospace;font-size:0.9em;">${uuid}</span></p>
                            <p style="margin:5px 0;color:#495057;"><strong>RFC Emisor:</strong> <span style="font-family:monospace;">${rfcEmisor}</span></p>
                        </div>
                        <div style="margin-bottom:20px;">
