﻿@using BOS_ERP.Controllers

@{
    ViewBag.Title = "Pedimentos";
    ViewBag.PageTitle = "Facturas";
}

@* ============================================
    PERMISOS DEL USUARIO (se calculan una vez en Razor)
    ============================================ *@
@{
    bool puedeVerEspecial = Utilities.DoesUserHasRight(User.Identity.Name, "facturacion_especial");
    bool puedeVerNormal = Utilities.DoesUserHasRight(User.Identity.Name, "facturacion_normal");
    bool puedeVerGlobal = Utilities.DoesUserHasRight(User.Identity.Name, "facturacion_global");
    bool puedeComplemento = Utilities.DoesUserHasRight(User.Identity.Name, "complemento_pago");
    bool puedeCancelar = Utilities.DoesUserHasRight(User.Identity.Name, "cancelar_factura");
}

@section styles {
    <style>
        .toolbar {
            padding: 24px 40px;
            background: var(--bg-light);
            border-bottom: 1px solid var(--border-light);
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
        }

        select {
            padding: 11px 20px;
            border: 1px solid var(--border-light);
            border-radius: 10px;
            font-size: 14px;
            cursor: pointer;
            background: var(--bg-light);
            color: var(--text-dark);
            font-weight: 500;
        }

        .stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 24px 40px;
            background: var(--very-light-blue);
            border-bottom: 1px solid var(--border-light);
        }

        .stat-card {
            background: var(--bg-light);
            padding: 20px 24px;
            border-radius: 12px;
            border-left: 4px solid var(--accent-blue);
            box-shadow: var(--shadow);
        }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

        .stat-label {
            font-size: 0.8em;
            color: var(--text-light);
            margin-bottom: 8px;
            text-transform: uppercase;
            font-weight: 600;
        }

        .stat-value {
            font-size: 1.75em;
            font-weight: 700;
            color: var(--text-dark);
        }

        .status-badge {
            display: inline-block;
            padding: 6px 14px;
            border-radius: 20px;
            font-size: 0.8em;
            font-weight: 600;
            text-transform: uppercase;
        }

        .status-pagada {
            background: #d1fae5;
            color: var(--success-color);
        }

        .status-pendiente {
            background: #fef3c7;
            color: var(--warning-color);
        }

        .status-cancelada,
        .status-vencida {
            background: #fee2e2;
            color: var(--danger-color);
        }

        .btn-icon {
            background: transparent;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            padding: 6px 8px;
            font-size: 1.2em;
            border-radius: 6px;
        }

            .btn-icon:hover {
                background: var(--very-light-blue);
                color: var(--accent-blue);
            }

        .modal {
            display: none;
            position: fixed;
            z-index: 1000;
            left: 0;
            top: 0;
            width: 100%;
            height: 100%;
            background: rgba(15, 23, 41, 0.6);
            overflow: auto;
        }

            .modal.active {
                display: flex;
                align-items: center;
                justify-content: center;
            }

        .modal-content {
            background: var(--bg-light);
            border-radius: 16px;
            max-width: 920px;
            width: 90%;
            max-height: 90vh;
            overflow-y: auto;
        }

        .modal-header {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            padding: 24px 32px;
            display: flex;
            justify-content: space-between;
        }

            .modal-header h2 {
                font-size: 1.5em;
                font-weight: 700;
            }

        .close-btn {
            background: rgba(255,255,255,0.15);
            border: none;
            color: white;
            font-size: 1.5em;
            cursor: pointer;
            width: 36px;
            height: 36px;
            border-radius: 50%;
        }

        .modal-body {
            padding: 32px;
        }

        .detail-section {
            margin-bottom: 32px;
        }

        .section-title {
            font-size: 1.1em;
            color: var(--primary-blue);
            margin-bottom: 16px;
            padding-bottom: 12px;
            border-bottom: 2px solid var(--border-light);
            font-weight: 700;
        }

        .info-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 16px;
        }

        .info-item {
            background: var(--very-light-blue);
            padding: 14px 18px;
            border-radius: 10px;
            border-left: 3px solid var(--accent-blue);
        }

        .info-label {
            font-size: 0.75em;
            color: var(--text-light);
            margin-bottom: 6px;
            font-weight: 600;
            text-transform: uppercase;
        }

        .info-value {
            font-size: 0.95em;
            color: var(--text-dark);
            font-weight: 600;
        }

        .detail-table {
            width: 100%;
            margin-top: 16px;
            border: 1px solid var(--border-light);
            border-radius: 10px;
            overflow: hidden;
        }

            .detail-table th {
                background: var(--very-light-blue);
                padding: 12px 16px;
                font-size: 0.8em;
            }

            .detail-table td {
                padding: 12px 16px;
                border-bottom: 1px solid var(--border-light);
            }

        .totals-box {
            background: var(--very-light-blue);
            padding: 24px;
            border-radius: 12px;
            margin-top: 20px;
        }

        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 10px 0;
        }

            .total-row.final {
                font-size: 1.4em;
                font-weight: 700;
                color: var(--primary-blue);
                border-top: 2px solid var(--border-light);
                padding-top: 16px;
                margin-top: 12px;
            }

        .modal-actions {
            display: flex;
            gap: 12px;
            margin-top: 24px;
            padding-top: 24px;
            border-top: 2px solid var(--border-light);
            flex-wrap: wrap;
        }

            .modal-actions button {
                padding: 11px 20px;
                background: var(--accent-blue);
                color: white;
                border: none;
                border-radius: 10px;
                cursor: pointer;
                font-weight: 600;
            }

        /* SweetAlert2 custom styles */
        .custom-swal-popup {
            border-radius: 12px;
            box-shadow: var(--shadow-lg);
        }

        .custom-swal-title {
            font-size: 24px;
            font-weight: 700;
            padding: 20px 20px 10px;
        }

        .custom-swal-confirm {
            background-color: var(--primary-blue) !important;
            color: white !important;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 4px rgba(30, 58, 95, 0.2);
            margin: 0 8px;
        }

            .custom-swal-confirm:hover {
                background-color: var(--primary-blue-dark) !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(30, 58, 95, 0.3);
            }

        .custom-swal-cancel {
            background-color: var(--bg-gray) !important;
            color: var(--text-dark) !important;
            border: 2px solid var(--border-light);
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            margin: 0 8px;
        }

            .custom-swal-cancel:hover {
                background-color: var(--border-light) !important;
                border-color: var(--secondary-blue);
            }

        .swal2-validation-message {
            background-color: var(--danger-color);
            color: white;
            border-radius: 6px;
            padding: 10px 15px;
            font-size: 14px;
        }

        .swal2-loader {
            border-color: var(--accent-blue) transparent var(--accent-blue) transparent;
        }

        .swal2-icon.swal2-success [class^='swal2-success-line'] {
            background-color: var(--success-color);
        }

        .swal2-icon.swal2-success .swal2-success-ring {
            border-color: rgba(5, 150, 105, 0.3);
        }

        .swal2-icon.swal2-error {
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        .custom-swal-confirm-danger {
            background-color: var(--danger-color) !important;
            color: white !important;
            border: none;
            padding: 12px 28px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 2px 4px rgba(220, 53, 69, 0.2);
            margin: 0 8px;
        }

            .custom-swal-confirm-danger:hover {
                background-color: #c82333 !important;
                transform: translateY(-1px);
                box-shadow: 0 4px 8px rgba(220, 53, 69, 0.3);
            }

        .semaforo-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 20px;
            font-size: 0.78em;
            font-weight: 700;
            white-space: nowrap;
        }

        .sem-vigente {
            background: #d1fae5;
            color: #065f46;
        }

        .sem-por-vencer {
            background: #fef3c7;
            color: #92400e;
        }

        .sem-vencida {
            background: #fee2e2;
            color: #991b1b;
        }

        .sem-sin-datos {
            background: #f1f5f9;
            color: #94a3b8;
        }
        /* ── Pestañas por estatus ───────────────────────────────────────── */
        .tabs-estatus {
            display: flex;
            gap: .4rem;
            flex-wrap: wrap;
            margin: 0 0 .75rem;
        }

        .tab-estatus {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            padding: .5rem 1rem;
            border: 2px solid #e5e7eb;
            border-radius: 8px;
            background: #fff;
            color: #6b7280;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all .15s ease;
        }

            .tab-estatus:hover { border-color: #c7d2fe; color: #4f46e5; }

            .tab-estatus.activo {
                background: #4f46e5;
                border-color: #4f46e5;
                color: #fff;
            }

        .tab-conteo {
            background: rgba(0, 0, 0, .08);
            border-radius: 999px;
            padding: 0 .45rem;
            font-size: .78rem;
            min-width: 1.4rem;
            text-align: center;
        }

        .tab-estatus.activo .tab-conteo { background: rgba(255, 255, 255, .25); }
    </style>
    <link href="~/content/TableBuilder.css" rel="stylesheet" />
    <link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
}

<form>@Html.AntiForgeryToken()</form>

<div style="padding: 12px 40px; border-bottom: 1px solid var(--border-light);
            background: var(--bg-light); display:flex; gap:10px; align-items:center; flex-wrap:wrap;">

    <button onclick="exportarCSV()"
            style="padding:9px 18px; background:#059669; color:white; border:none;
                   border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;
                   display:flex; align-items:center; gap:6px;">
        <i class="fa fa-file-csv"></i> Exportar CSV
    </button>

    <!-- NUEVO: Botón modo selección masiva -->
    <button id="btnToggleSeleccion" onclick="toggleModoSeleccion()"
            style="padding:9px 18px; background:#7c3aed; color:white; border:none;
                   border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;
                   display:flex; align-items:center; gap:6px;">
        <i class="fa fa-paper-plane"></i> Envío masivo
    </button>

    <!-- NUEVO: Botón enviar (visible solo en modo selección) -->
    <button id="btnEnvioMasivo" onclick="iniciarEnvioMasivo()" disabled
            style="display:none; padding:9px 18px; background:#1d4ed8; color:white; border:none;
                   border-radius:8px; font-size:14px; font-weight:600; cursor:pointer;
                   align-items:center; gap:6px; opacity:0.5;">
        <i class="fa fa-send"></i> Enviar seleccionadas
    </button>

    <!-- NUEVO: Contador de selección -->
    <span id="contadorSeleccion"
          style="display:none; padding:6px 14px; background:#7c3aed; color:white;
                 border-radius:20px; font-size:13px; font-weight:700;">
        0 seleccionadas
    </span>

    @if (Utilities.DoesUserHasRight(User.Identity.Name, "asdf"))
    {
        <input type="text" id="filtroUsuarioCSV"
               placeholder="Filtrar por usuario (usr_doc)..."
               style="padding:9px 14px; border:1px solid var(--border-light); border-radius:8px;
                      font-size:14px; min-width:240px;" value="@User.Identity.Name" />
    }
</div>

<div class="stats d-none">
    <div class="stat-card">
        <div class="stat-label">Total Facturas</div>
        <div class="stat-value" id="totalInvoices">0</div>
    </div>
    <div class="stat-card success">
        <div class="stat-label">Pagadas</div>
        <div class="stat-value" id="paidInvoices">0</div>
    </div>
    <div class="stat-card warning">
        <div class="stat-label">Pendientes</div>
        <div class="stat-value" id="pendingInvoices">0</div>
    </div>
    <div class="stat-card danger">
        <div class="stat-label">Monto Total</div>
        <div class="stat-value" id="totalAmount">$0.00</div>
    </div>
</div>

<div class="toolbar d-none">
    <select id="statusFilter">
        <option value="">Todos los estados</option>
        <option value="pagada">Pagadas</option>
        <option value="pendiente">Pendientes</option>
        <option value="cancelada">Canceladas</option>
        <option value="vencida">Vencidas</option>
    </select>
    <select id="dateFilter">
        <option value="">Todas las fechas</option>
        <option value="today">Hoy</option>
        <option value="week">Esta semana</option>
        <option value="month">Este mes</option>
        <option value="year">Este año</option>
    </select>
</div>

@* Pestañas por estatus. "Todas" existe a propósito: además de timbradas y canceladas
   hay comprobantes en estados intermedios del proceso de cancelación, y sin esta
   pestaña no aparecerían en ninguna. *@
<div class="tabs-estatus">
    <button type="button" class="tab-estatus activo" data-estatus="todas" onclick="cambiarEstatus(this)">
        Todas <span class="tab-conteo" id="cnt-todas"></span>
    </button>
    <button type="button" class="tab-estatus" data-estatus="timbradas" onclick="cambiarEstatus(this)">
        <i class="fa fa-check-circle"></i> Timbradas <span class="tab-conteo" id="cnt-timbradas"></span>
    </button>
    <button type="button" class="tab-estatus" data-estatus="canceladas" onclick="cambiarEstatus(this)">
        <i class="fa fa-ban"></i> Canceladas <span class="tab-conteo" id="cnt-canceladas"></span>
    </button>
</div>

<div class="table-wrapper">
    <div class="table-responsive">
        <div id="facturas"></div>
    </div>
</div>

<div id="detailModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 id="modalTitle">Detalle de Factura</h2>
            <button class="close-btn" onclick="closeModal()">×</button>
        </div>
        <div class="modal-body" id="modalBody"></div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/TableBuilder.js"></script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script>
        // ============================================
        // PERMISOS (inyectados desde Razor, solo lectura)
        // ============================================
        const PERMISOS = {
            verEspecial : @puedeVerEspecial.ToString().ToLower(),
            verNormal   : @puedeVerNormal.ToString().ToLower(),
            verGlobal   : @puedeVerGlobal.ToString().ToLower(),
            complemento : @puedeComplemento.ToString().ToLower(),
            cancelar    : @puedeCancelar.ToString().ToLower()
        };

        // ============================================
        // PESTAÑAS POR ESTATUS
        // ============================================
        let estatusActual = 'todas';
        let tablaFacturas = null;

        function cambiarEstatus(btn) {
            document.querySelectorAll('.tab-estatus').forEach(b => b.classList.remove('activo'));
            btn.classList.add('activo');

            estatusActual = btn.dataset.estatus;
            tablaFacturas?.reload();   // vuelve a la página 1 con el filtro nuevo
        }

        async function cargarConteosEstatus() {
            try {
                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                const fd = new FormData();
                if (token) fd.append('__RequestVerificationToken', token);

                const r = await fetch('/FacturaConsulta/ContarPorEstatus', { method: 'POST', body: fd });
                const d = await r.json();
                if (!d.success) return;

                document.getElementById('cnt-todas').textContent = d.todas;
                document.getElementById('cnt-timbradas').textContent = d.timbradas;
                document.getElementById('cnt-canceladas').textContent = d.canceladas;
            } catch { /* los conteos son informativos: su fallo no debe romper la pantalla */ }
        }

        // ============================================
        // TABLA
        // ============================================
        document.addEventListener('DOMContentLoaded', function () {
            cargarConteosEstatus();

            const acciones = [
                { icon: "fa-eye",       color: "cyan-500",    title: "Ver Detalles",       onClick: row => showDetail(row.encabezado_id) },
                { icon: "fa-file-pdf",  color: "red-500",     title: "Ver PDF",            onClick: row => printFactura(row.uuid) },
                { icon: "fa-file-code", color: "blue-500",    title: "Descargar XML",      onClick: row => downloadFactura(row.uuid) },
                { icon: "fa-envelope", color: "emerald-500", title: "Enviar por correo", onClick: row => sendFactura(row.uuid) },
                {
                    icon: "fa-upload",
                    color: "purple-500",
                    title: "Registrar carga al portal",
                    visible: row => row.tipo === 'PPD' || row.mdpfactura === 'PPD' || row.mdpfactura === 'Pago en parcialidades o diferido',
                    onClick: row => registrarCargaPortal(row.uuid, row.rsocliente)
                }
            ];

            // ✅ Botón cancelar solo si tiene permiso
            if (PERMISOS.cancelar) {
                acciones.push({
                    icon: "fa-ban",
                    color: "yellow-500",
                    title: "Cancelar Factura",
                    onClick: row => cancelFactura(row.uuid, row.rfcemisor)
                });
            }
            function semaforoCredito(diasRestantes, row) {
                // Sin registro de carga al portal
                if (diasRestantes === null || diasRestantes === undefined) {
                    const esPPD = row.mdpfactura === 'PPD'
                        || row.mdpfactura === 'Pago en parcialidades o diferido';
                    if (!esPPD) return '<span style="color:#cbd5e1;font-size:0.8em;">—</span>';
                    return `<span class="semaforo-badge sem-sin-datos">
                    <i class="fa fa-circle-dot"></i> Sin registrar
                </span>`;
                }

                const dias = Math.floor(Number(diasRestantes));

                if (dias < 0) {
                    return `<span class="semaforo-badge sem-vencida">
                    <i class="fa fa-circle-xmark"></i> Vencida hace ${Math.abs(dias)}d
                </span>`;
                }
                if (dias <= 5) {
                    return `<span class="semaforo-badge sem-por-vencer">
                    <i class="fa fa-clock"></i> Vence en ${dias}d
                </span>`;
                }
                return `<span class="semaforo-badge sem-vigente">
                <i class="fa fa-circle-check"></i> ${dias} días
            </span>`;
            }


            const columnaSaldoPago = {
                title: 'Saldo / Pago',
                data: 'saldo',
                formatter: (v, row) => {
                    const total = parseFloat(row.total || 0);
                    const saldo = parseFloat(v || 0);
                    const pagado = total - saldo;
                    const pct = total > 0 ? Math.min(Math.round((pagado / total) * 100), 100) : 0;
                    const esPPD = row.mdpfactura === 'PPD' || row.mdpfactura === 'Pago en parcialidades o diferido';

                    const colorBarra = pct >= 100 ? '#059669' : pct >= 50 ? '#f59e0b' : '#ef4444';

                    // Badges de señales
                    const badgeComp = row.tiene_complemento
                        ? `<span style="display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:20px;
                            font-size:10px;font-weight:700;background:#dbeafe;color:#1e40af;margin-right:4px;"
                title="${row.complementos_count} complemento(s) de pago">
                 <i class="fa fa-file-invoice-dollar" style="font-size:9px;"></i>
                 ${row.complementos_count} CP
               </span>`
                        : '';

                    const badgeAnt = row.tiene_anticipo
                        ? `<span style="display:inline-flex;align-items:center;gap:3px;padding:2px 7px;border-radius:20px;
                            font-size:10px;font-weight:700;background:#ede9fe;color:#5b21b6;margin-right:4px;"
                title="Anticipo aplicado: $${parseFloat(row.saldo_anticipo_aplicado || 0).toFixed(2)}">
                 <i class="fa fa-circle-dollar-to-slot" style="font-size:9px;"></i> ANT
               </span>`
                        : '';

                    // Mini semáforo PPD
                    const semaforo = esPPD
                        ? semaforoCredito(row.dias_credito_restantes, row)
                        : '';

                    return `
        <div style="min-width:130px;">
            <div style="font-family:'IBM Plex Mono',monospace;font-size:12px;font-weight:600;
                        color:${saldo <= 0 ? '#059669' : '#0f172a'};">
                $${saldo.toFixed(2)}
                ${saldo <= 0 ? '<i class="fa fa-check-circle" style="color:#059669;font-size:10px;margin-left:3px;"></i>' : ''}
            </div>
            <div style="background:#e2e8f0;height:3px;border-radius:2px;margin:4px 0;overflow:hidden;">
                <div style="height:100%;width:${pct}%;background:${colorBarra};border-radius:2px;
                            transition:width .3s;"></div>
            </div>
            <div style="font-size:9px;color:#94a3b8;font-family:'IBM Plex Mono',monospace;margin-bottom:4px;">
                $${total.toFixed(2)} total · ${pct}% pagado
            </div>
            ${badgeComp}${badgeAnt}
            ${semaforo}
        </div>`;
                }
            };

            tablaFacturas = createTable({
                selector: '#facturas',
                path: '/FacturaConsulta/ObtenerFacturas',
                searchPlaceholder: 'Buscar facturas...',
                // Función, no objeto: se evalúa en cada petición, así el cambio de pestaña
                // se aplica también al buscar y al paginar.
                data: () => ({ estatus: estatusActual }),
                columns: [
                    { title: 'Número de factura', data: 'folio' },
                    { title: 'Cliente', data: 'rsocliente' },
                    { title: 'Fecha de emisión', data: 'fecha', formatter: v => dateFormatter(v) },
                    { title: 'Tipo', data: 'tipo' },
                    columnaSaldoPago,
                    {
                        title: 'Crédito / Vencimiento',
                        data: 'dias_credito_restantes',
                        formatter: (v, row) => semaforoCredito(v, row)
                    },
                    // ── NUEVO: columna invisible que porta el UUID ──────────────────
                    {
                        title: '',
                        data: 'uuid',
                        className: 'd-none',
                        formatter: v => v ? `<span class="uuid-val" data-uuid="${v}"></span>` : ''
                    }
                ],
                actions: acciones,
             });
        });

        // ============================================
        // MODAL DE DETALLE
        // ============================================
        function showDetail(id) {
            const modal = document.getElementById('detailModal');
            const modalBody = document.getElementById('modalBody');

            modal.classList.add('active');
            modalBody.innerHTML = `
        <div style="text-align:center;padding:40px;">
            <i class="fa fa-spinner fa-spin" style="font-size:2em;color:var(--primary-blue);"></i>
            <p style="margin-top:16px;color:var(--text-light);">Cargando detalles...</p>
        </div>`;

            fetch(`/FacturaConsulta/FacturaDetail?id=${id}`)
                .then(r => {
                    if (!r.ok) throw new Error('Error al cargar los detalles');
                    return r.json();
                })
                .then(data => {
                    if (data && data.documento) {
                        renderFacturaDetail(
                            JSON.parse(data.documento[0].documento),
                            data.complementos || [],   // NUEVO
                            data.anticipos || [],   // NUEVO
                            data.creditoInfo || null,  // NUEVO
                            data.remisiones || [],     // NUEVO — remisiones de origen
                            data.refactura || null     // NUEVO — sustitución/refactura
                        );
                    } else {
                        throw new Error('No se encontraron datos');
                    }
                })
                .catch(error => {
                    modalBody.innerHTML = `
                <div style="text-align:center;padding:40px;">
                    <i class="fa fa-exclamation-circle" style="font-size:2em;color:var(--danger-color);"></i>
                    <p style="margin-top:16px;color:var(--text-dark);">Error al cargar los detalles</p>
                    <p style="color:var(--text-light);font-size:.9em;">${error.message}</p>
                </div>`;
                });
        }

        function renderFacturaDetail(documento, complementos, anticipos, creditoInfo, remisiones, refactura) {
            const modalBody = document.getElementById('modalBody');
            const encabezado = documento.encabezado;
            const facturas = documento.facturas;
            const factura = facturas && facturas.length > 0 ? facturas[0] : null;

            if (!factura) {
                modalBody.innerHTML = '<p style="text-align:center;padding:40px;">No se encontraron detalles de factura</p>';
                return;
            }

            const productos = factura.productos || [];

            const btnCancelar = (typeof PERMISOS !== 'undefined' && PERMISOS.cancelar)
                ? `<button onclick="cancelFactura('${factura.uuid}', '${factura.rfcemisor}')" style="background:var(--danger-color);">
               <i class="fa fa-ban"></i> Cancelar
           </button>`
                : '';

            const html = `
        ${buildRefacturaBanner(factura, refactura, encabezado)}
        ${buildEstadoPagoSection(factura, complementos || [], anticipos || [], creditoInfo)}

        <div class="detail-section">
            <div class="section-title"><i class="fa fa-file-invoice"></i> Información de la factura</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Serie - Folio</div>
                    <div class="info-value">${factura.serie || ''} - ${factura.folio || ''}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">UUID</div>
                    <div class="info-value" style="font-size:.75em;word-break:break-all;">${factura.uuid || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Fecha emisión</div>
                    <div class="info-value">${factura.fecha}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Fecha vencimiento</div>
                    <div class="info-value">${factura.fecha_vencimiento? factura.fecha_vencimiento: '—'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Estado</div>
                    <div class="info-value">
                        <span class="status-badge status-${getStatusClass(factura.statusfactura)}">
                            ${getStatusText(factura.statusfactura)}
                        </span>
                    </div>
                </div>
                <div class="info-item">
                    <div class="info-label">Moneda</div>
                    <div class="info-value">${factura.moneda || 'MXN'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Método de pago</div>
                    <div class="info-value">${factura.mdpfactura || encabezado.mdp || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Forma de pago</div>
                    <div class="info-value">${encabezado.f_pago || 'N/A'}</div>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <div class="section-title"><i class="fa fa-user"></i> Información del cliente</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Razón Social</div>
                    <div class="info-value">${factura.rsocliente || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">RFC</div>
                    <div class="info-value">${factura.rfccliente || 'N/A'}</div>
                </div>
                ${factura.oc ? `<div class="info-item"><div class="info-label">Orden de compra</div><div class="info-value">${factura.oc}</div></div>` : ''}
            </div>
        </div>

        <div class="detail-section">
            <div class="section-title"><i class="fa fa-building"></i> Información del emisor</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Razón Social</div>
                    <div class="info-value">${factura.rsoemisor || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">RFC</div>
                    <div class="info-value">${factura.rfcemisor || 'N/A'}</div>
                </div>
            </div>
        </div>

        <div class="detail-section">
            <div class="section-title"><i class="fa fa-box"></i> Productos (${productos.length})</div>
            <div style="overflow-x:auto;">
                <table class="detail-table">
                    <thead>
                        <tr>
                            <th>Clave</th><th>Descripción</th><th>Cantidad</th>
                            <th>UDM</th><th>Precio unitario</th><th>Descuento</th><th>Subtotal</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${productos.map(p => {
                const sub = (p.cantidad * p.precio) - (p.descuento_partida || 0);
                return `<tr>
                                <td>${p.claveprod || p.idproducto}</td>
                                <td>
                                    <strong>${p.descripcion || 'N/A'}</strong>
                                    ${p.claveprodserv ? `<br><small style="color:var(--text-light);">SAT: ${p.claveprodserv}</small>` : ''}
                                    ${p.clave_cliente ? `<br><small style="color:var(--text-light);">Cliente: ${p.clave_cliente}</small>` : ''}
                                </td>
                                <td>${p.cantidad}</td>
                                <td>${p.udm || '—'}</td>
                                <td>$${(p.precio || 0).toFixed(2)}</td>
                                <td>$${(p.descuento_partida || 0).toFixed(2)}</td>
                                <td><strong>$${sub.toFixed(2)}</strong></td>
                            </tr>`;
            }).join('')}
                    </tbody>
                </table>
            </div>
        </div>

        <div class="detail-section">
            <div class="totals-box">
                <div class="total-row"><span>Subtotal:</span><strong>$${(factura.subtotal || 0).toFixed(2)}</strong></div>
                ${factura.descuento > 0 ? `<div class="total-row"><span>Descuento:</span><strong style="color:var(--danger-color);">-$${factura.descuento.toFixed(2)}</strong></div>` : ''}
                <div class="total-row"><span>IVA:</span><strong>$${(factura.iva || 0).toFixed(2)}</strong></div>
                <div class="total-row final"><span>TOTAL:</span><span>$${(factura.total || 0).toFixed(2)} ${factura.moneda || 'MXN'}</span></div>
            </div>
        </div>

        ${buildComplementosSection(complementos || [])}
        ${buildAnticiposSection(anticipos || [])}
        ${buildRemisionesSection(remisiones || [])}

        <div class="modal-actions">
            <button onclick="printFactura('${factura.uuid}')">
                <i class="fa fa-print"></i> Imprimir
            </button>
            <button onclick="downloadFactura('${factura.uuid}')" style="background:var(--success-color);">
                <i class="fa fa-download"></i> Descargar XML
            </button>
            <button onclick="sendFactura('${factura.uuid}')" style="background:var(--accent-blue);">
                <i class="fa fa-envelope"></i> Enviar por email
            </button>
            ${btnCancelar}
        </div>`;

            modalBody.innerHTML = html;
        }

        // ── Banner de refactura / sustitución (relación CFDI 04) ──
        // Muestra si esta factura sustituyó a otra (es refactura) y/o fue sustituida.
        function buildRefacturaBanner(factura, refactura, encabezado) {
            const cancelada = (factura.statusfactura || '').toLowerCase().includes('cancel');
            const pendiente = (factura.statusfactura || '').toLowerCase().includes('pendiente');
            let bloques = '';

            // Estado del CFDI (siempre que no esté vigente/timbrada limpia)
            if (cancelada || pendiente) {
                const motivo = (encabezado && encabezado.coment_aut) ? encabezado.coment_aut : '';
                bloques += `
                <div style="display:flex;align-items:flex-start;gap:10px;padding:12px 16px;border-radius:10px;margin-bottom:8px;
                            background:${pendiente ? '#fef3c7' : '#fee2e2'};border:1px solid ${pendiente ? '#fcd34d' : '#fecaca'};">
                    <i class="fa ${pendiente ? 'fa-clock' : 'fa-ban'}" style="color:${pendiente ? '#b45309' : '#b91c1c'};font-size:1.2em;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:${pendiente ? '#92400e' : '#991b1b'};">
                            ${pendiente ? 'Cancelación pendiente ante el SAT' : 'CFDI cancelado'}
                        </div>
                        ${motivo ? `<div style="font-size:.85em;color:#7f1d1d;margin-top:2px;">Motivo: ${motivo}</div>` : ''}
                    </div>
                </div>`;
            }

            const sa = refactura && refactura.sustituyeA;
            const sp = refactura && refactura.sustituidaPor;
            const tipoTxt = (r) => r.tipo_refacturacion ? ` · tipo: <strong>${r.tipo_refacturacion}</strong>` : '';
            const linkFactura = (r) => r.encabezado_id
                ? `<a href="#" onclick="event.preventDefault();showDetail(${r.encabezado_id});"
                     style="color:#1d4ed8;font-weight:600;">${(r.serie||'')}${r.folio||''} · ${(r.uuid||'').substring(0,8)}…</a>`
                : `<span style="font-family:monospace;">${(r.uuid||'').substring(0,8)}…</span>`;

            if (sa) {
                bloques += `
                <div style="display:flex;align-items:flex-start;gap:10px;padding:12px 16px;border-radius:10px;margin-bottom:8px;
                            background:#eff6ff;border:1px solid #bfdbfe;">
                    <i class="fa fa-rotate" style="color:#1d4ed8;font-size:1.2em;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#1e3a8a;">Esta factura es una REFACTURA (sustituto CFDI, rel. 04)${tipoTxt(sa)}</div>
                        <div style="font-size:.85em;color:#1e40af;margin-top:2px;">
                            Sustituye a: ${linkFactura(sa)} ${sa.fecha ? '· ' + dateFormatter(sa.fecha) : ''}
                        </div>
                    </div>
                </div>`;
            }
            if (sp) {
                bloques += `
                <div style="display:flex;align-items:flex-start;gap:10px;padding:12px 16px;border-radius:10px;margin-bottom:8px;
                            background:#f5f3ff;border:1px solid #ddd6fe;">
                    <i class="fa fa-arrow-right-arrow-left" style="color:#6d28d9;font-size:1.2em;margin-top:2px;"></i>
                    <div>
                        <div style="font-weight:700;color:#5b21b6;">Sustituida por otra factura${tipoTxt(sp)}</div>
                        <div style="font-size:.85em;color:#6d28d9;margin-top:2px;">
                            Reemplazada por: ${linkFactura(sp)} ${sp.fecha ? '· ' + dateFormatter(sp.fecha) : ''}
                        </div>
                    </div>
                </div>`;
            }

            return bloques ? `<div style="margin-bottom:12px;">${bloques}</div>` : '';
        }

        // ── Remisiones de origen (documentos que crearon la factura) ──
        function buildRemisionesSection(remisiones) {
            if (!remisiones || remisiones.length === 0) return '';

            const estBadge = (e) => {
                const cancel = e == 27;
                return `<span style="background:${cancel ? '#fee2e2' : '#d1fae5'};color:${cancel ? '#991b1b' : '#065f46'};
                        padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;">
                        ${cancel ? 'Cancelada' : 'Vigente'}</span>`;
            };

            const cards = remisiones.map(r => {
                let partidas = [];
                try { partidas = typeof r.partidas === 'string' ? JSON.parse(r.partidas) : (r.partidas || []); }
                catch (e) { partidas = []; }

                const filas = partidas.map(p => `
                    <tr>
                        <td style="font-family:monospace;">${p.cve_prod || ''}</td>
                        <td style="text-align:right;">${parseFloat(p.cantidad || 0).toFixed(2)}</td>
                        <td style="text-align:right;">$${parseFloat(p.precio || 0).toFixed(2)}</td>
                        <td style="text-align:right;">$${parseFloat(p.importe || 0).toFixed(2)}</td>
                    </tr>`).join('');

                return `
                <div style="border:1px solid var(--border-color,#e5e7eb);border-radius:10px;padding:12px;margin-bottom:10px;">
                    <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;">
                        <i class="fa fa-truck-ramp-box" style="color:#0e7490;"></i>
                        <strong>Remisión ${r.folio || ('#' + r.encabezado)}</strong>
                        ${r.fecha ? `<span style="color:var(--text-light);font-size:.85em;">${dateFormatter(r.fecha)}</span>` : ''}
                        ${estBadge(r.estatus_id)}
                    </div>
                    ${filas ? `
                    <table style="width:100%;font-size:.85em;border-collapse:collapse;">
                        <thead><tr style="color:var(--text-light);text-align:left;">
                            <th>Clave</th><th style="text-align:right;">Cant.</th>
                            <th style="text-align:right;">P.U.</th><th style="text-align:right;">Importe</th>
                        </tr></thead>
                        <tbody>${filas}</tbody>
                    </table>` : '<div style="color:var(--text-light);font-size:.85em;">Sin partidas registradas.</div>'}
                </div>`;
            }).join('');

            return `
        <div class="detail-section">
            <div class="section-title"><i class="fa fa-truck-ramp-box"></i> Remisiones de origen (${remisiones.length})</div>
            ${cards}
        </div>`;
        }

        function buildComplementosSection(complementos) {
            if (!complementos || complementos.length === 0) return '';

            const rows = complementos.map(c => {
                const estBadge = c.estatus === 'Cancelada'
                    ? `<span style="background:#fee2e2;color:#991b1b;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;">Cancelado</span>`
                    : `<span style="background:#d1fae5;color:#065f46;padding:3px 10px;border-radius:20px;font-size:10px;font-weight:700;">Timbrado</span>`;

                return `
        <tr>
            <td style="font-family:'IBM Plex Mono',monospace;font-weight:600;">
                ${c.serie || ''}${c.folio || '—'}
            </td>
            <td>${dateFormatter(c.fecha_pago)}</td>
            <td style="font-family:'IBM Plex Mono',monospace;font-weight:600;color:#1e40af;">
                $${parseFloat(c.monto_pagado || 0).toFixed(2)}
            </td>
            <td>${c.metodo_pago || c.forma_pago || '—'}</td>
            <td>${estBadge}</td>
            <td>
                <button onclick="printFactura('${c.uuid}')" class="btn-icon" title="Ver PDF">
                    <i class="fa fa-file-pdf" style="color:#dc2626;"></i>
                </button>
                <button onclick="downloadFactura('${c.uuid}')" class="btn-icon" title="Descargar XML">
                    <i class="fa fa-file-code" style="color:#059669;"></i>
                </button>
            </td>
        </tr>`;
            }).join('');

            const totalCP = complementos.reduce((s, c) => s + parseFloat(c.monto_pagado || 0), 0);

            return `
    <div class="detail-section" style="margin-top:24px;">
        <div class="section-title"><i class="fa fa-file-invoice-dollar"></i> Complementos de pago vinculados (${complementos.length})</div>
        <div style="overflow-x:auto;">
            <table class="detail-table">
                <thead>
                    <tr>
                        <th>Folio CC</th>
                        <th>Fecha pago</th>
                        <th>Monto pagado</th>
                        <th>Forma pago</th>
                        <th>Estatus</th>
                        <th>Archivos</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
                <tfoot>
                    <tr style="background:#eff6ff;font-weight:600;">
                        <td colspan="2" style="text-align:right;color:#1e40af;">Total pagado por complementos:</td>
                        <td style="font-family:'IBM Plex Mono',monospace;color:#1e40af;">$${totalCP.toFixed(2)}</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>`;
        }

        // ──────────────────────────────────────────────────────────────────
        //  D) TAB DE ANTICIPOS APLICADOS
        // ──────────────────────────────────────────────────────────────────
        function buildAnticiposSection(anticipos) {
            if (!anticipos || anticipos.length === 0) return '';

            const rows = anticipos.map(a => `
    <tr>
        <td style="font-family:'IBM Plex Mono',monospace;font-weight:600;">
            <a onclick="printFactura('${a.anticipo_uuid}')" href="#" style="color:#7c3aed;text-decoration:none;">
                ${a.anticipo_serie || ''}${a.anticipo_folio || '—'}
            </a>
        </td>
        <td>${dateFormatter(a.anticipo_fecha)}</td>
        <td style="font-family:'IBM Plex Mono',monospace;">
            $${parseFloat(a.anticipo_monto_original || 0).toFixed(2)}
        </td>
        <td style="font-family:'IBM Plex Mono',monospace;color:#5b21b6;font-weight:600;">
            $${parseFloat(a.monto_aplicado || 0).toFixed(2)}
        </td>
        <td style="font-family:'IBM Plex Mono',monospace;font-size:11px;color:#64748b;">
            $${parseFloat(a.saldo_antes || 0).toFixed(2)} → $${parseFloat(a.saldo_despues || 0).toFixed(2)}
        </td>
        <td>${dateFormatter(a.fecha_aplicacion)}</td>
        <td style="font-size:11px;color:#64748b;">${a.observaciones || '—'}</td>
    </tr>`).join('');

            const totalAnt = anticipos.reduce((s, a) => s + parseFloat(a.monto_aplicado || 0), 0);

            return `
    <div class="detail-section" style="margin-top:24px;">
        <div class="section-title"><i class="fa fa-circle-dollar-to-slot"></i> Anticipos aplicados (${anticipos.length})</div>
        <div style="overflow-x:auto;">
            <table class="detail-table">
                <thead>
                    <tr>
                        <th>Folio anticipo</th>
                        <th>Fecha anticipo</th>
                        <th>Monto original</th>
                        <th>Aplicado a esta factura</th>
                        <th>Saldo antes → después</th>
                        <th>Fecha aplicación</th>
                        <th>Observaciones</th>
                    </tr>
                </thead>
                <tbody>${rows}</tbody>
                <tfoot>
                    <tr style="background:#faf5ff;font-weight:600;">
                        <td colspan="3" style="text-align:right;color:#5b21b6;">Total anticipos aplicados:</td>
                        <td style="font-family:'IBM Plex Mono',monospace;color:#5b21b6;">$${totalAnt.toFixed(2)}</td>
                        <td colspan="3"></td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>`;
        }

        function closeModal() {
            document.getElementById('detailModal').classList.remove('active');
        }

        window.onclick = function(event) {
            const modal = document.getElementById('detailModal');
            if (event.target === modal) closeModal();
        };

        // ============================================
        // HELPERS DE FECHA Y ESTADO
        // ============================================

        function getStatusClass(status) {
            if (!status || status === '0' || status === 0) return 'pendiente';
            const s = status.toString().toLowerCase();
            if (s === '1' || s === 'pagada')    return 'pagada';
            if (s === '2' || s === 'cancelada') return 'cancelada';
            if (s === '3' || s === 'vencida')   return 'vencida';
            return 'pendiente';
        }

        function getStatusText(status) {
            if (!status || status === '0' || status === 0) return 'Pendiente';
            const s = status.toString().toLowerCase();
            if (s === '1' || s === 'pagada')    return 'Pagada';
            if (s === '2' || s === 'cancelada') return 'Cancelada';
            if (s === '3' || s === 'vencida')   return 'Vencida';
            return 'Pendiente';
        }

        // ============================================
        // ACCIONES DE ARCHIVOS
        // ============================================
        function printFactura(id) {
            window.open(`../Facturacion/facturas/${id}.pdf`, '_blank');
        }

        function downloadFactura(id) {
            const url = `../Facturacion/xml_timbrados/${id}.xml`;
            window.open(url, '_blank');
            const a = document.createElement('a');
            a.href = url; a.download = `${id}.xml`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

        // ============================================
        // ENVIAR FACTURA POR CORREO
        // ============================================
        function sendFactura(uuid) {
            Swal.fire({
                title: '<i class="fas fa-spinner fa-spin"></i> Cargando...',
                html: '<p>Obteniendo información del cliente...</p>',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            fetch(`/FacturaConsulta/ObtenerCorreosCliente?uuid=${uuid}`)
                .then(r => r.json())
                .then(data => mostrarModalEnvioCorreoConsulta(uuid, data.success ? data.correos : []))
                .catch(() => mostrarModalEnvioCorreoConsulta(uuid, []));
        }

        function mostrarModalEnvioCorreoConsulta(uuid, correosCliente) {
            const hayCorreos = correosCliente && correosCliente.length > 0;
            const opcionesCorreos = hayCorreos
                ? correosCliente.map(c => ({ email: c.correo || c.Correo, id: c.id || c.Id }))
                : [];

            Swal.fire({
                title: '<i class="fas fa-envelope"></i> Enviar Factura por Correo',
                html: `
                    <div style="text-align:left;padding:1rem;">
                        <div style="background:linear-gradient(135deg,#ede9fe 0%,#ddd6fe 100%);padding:1.25rem;border-radius:12px;margin-bottom:1.5rem;border-left:4px solid #7c3aed;">
                            <div style="font-size:0.9rem;color:#5b21b6;margin-bottom:0.5rem;font-weight:600;"><i class="fas fa-file-invoice"></i> UUID</div>
