                <!-- Días de crédito -->
                <div style="margin-bottom:1.25rem;">
                    <label style="display:block;font-weight:600;margin-bottom:6px;color:#374151;font-size:0.9rem;">
                        <i class="fas fa-clock"></i> Días de crédito *
                    </label>
                    <select id="diasCreditoSelect"
                        style="width:100%;padding:0.75rem;border:2px solid #e5e7eb;border-radius:8px;font-size:0.9rem;box-sizing:border-box;">
                        ${opcionesSelect}
                        <option value="custom" ${customSelected}>Personalizado...</option>
                    </select>
                    <!-- Input custom: visible si el cliente tiene días no estándar o si elige "Personalizado" -->
                    <input type="number" id="diasCreditoCustom" min="1" max="365"
                        placeholder="Ingrese los días manualmente"
                        value="${tieneCredito && !esOpcionEstandar ? diasCredito : ''}"
                        style="display:${tieneCredito && !esOpcionEstandar ? 'block' : 'none'};
                               width:100%;margin-top:8px;padding:0.75rem;
                               border:2px solid #7c3aed;border-radius:8px;
