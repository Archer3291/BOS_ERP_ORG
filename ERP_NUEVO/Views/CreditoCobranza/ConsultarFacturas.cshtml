                            </small>
                        </div>
                        <div style="background:#f8fafc;padding:1rem;border-radius:10px;margin-bottom:1rem;border:1px solid #e2e8f0;">
                            <div style="color:#374151;font-weight:600;margin-bottom:0.75rem;font-size:0.9rem;"><i class="fas fa-paperclip"></i> Archivos adjuntos:</div>
                            <label style="display:flex;align-items:center;gap:0.5rem;margin-bottom:0.5rem;cursor:pointer;">
                                <input type="checkbox" id="incluirPDFConsulta" checked style="width:18px;height:18px;">
                                <span style="color:#6b7280;font-size:0.9rem;"><i class="fas fa-file-pdf" style="color:#dc2626;"></i> PDF</span>
                            </label>
                            <label style="display:flex;align-items:center;gap:0.5rem;cursor:pointer;">
                                <input type="checkbox" id="incluirXMLConsulta" checked style="width:18px;height:18px;">
                                <span style="color:#6b7280;font-size:0.9rem;"><i class="fas fa-file-code" style="color:#059669;"></i> XML</span>
                            </label>
                        </div>
                        <div style="margin-bottom:1rem;">
                            <label style="display:block;color:#374151;font-weight:600;margin-bottom:0.5rem;font-size:0.95rem;">
                                <i class="fas fa-comment"></i> Mensaje adicional (opcional)
                            </label>
                            <textarea id="mensajeAdicionalConsulta" rows="3" placeholder="Agregue un mensaje personalizado..."
                                style="width:100%;padding:0.75rem;border:2px solid #e5e7eb;border-radius:8px;font-size:0.9rem;resize:vertical;font-family:inherit;"></textarea>
                        </div>
                    </div>`,
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-paper-plane"></i> Enviar',
                cancelButtonText: '<i class="fas fa-times"></i> Cancelar',
                confirmButtonColor: '#3b82f6',
                cancelButtonColor: '#6b7280',
                width: '650px',
                focusConfirm: false,
                didOpen: () => inicializarTomSelectCorreosConsulta(opcionesCorreos),
                preConfirm: () => {
                    const ts     = document.getElementById('emailDestinoConsulta').tomselect;
                    const emails = ts.getValue();
                    const asunto = document.getElementById('asuntoInput').value.trim();
                    const incluirPDF = document.getElementById('incluirPDFConsulta').checked;
                    const incluirXML = document.getElementById('incluirXMLConsulta').checked;
                    const mensaje = document.getElementById('mensajeAdicionalConsulta').value.trim();

                    if (!asunto)                              { Swal.showValidationMessage('El asunto es obligatorio'); return false; }
                    if (!emails || emails.length === 0)       { Swal.showValidationMessage('Seleccione o agregue al menos un correo'); return false; }
                    if (!incluirPDF && !incluirXML)           { Swal.showValidationMessage('Seleccione al menos un archivo para adjuntar'); return false; }

                    return { emails: Array.isArray(emails) ? emails : [emails], asunto, incluirPDF, incluirXML, mensaje };
                }
            }).then(result => {
                if (result.isConfirmed && result.value)
                    enviarFacturaPorCorreoConsulta(uuid, result.value);
            });
        }

        function inicializarTomSelectCorreosConsulta(opcionesCorreos) {
            const REGEX_EMAIL = '([a-z0-9!#$%&\'*+/=?^_`{|}~-]+(?:\\.[a-z0-9!#$%&\'*+/=?^_`{|}~-]+)*@@(?:[a-z0-9](?:[a-z0-9-]*[a-z0-9])?\\.)+[a-z0-9](?:[a-z0-9-]*[a-z0-9])?)';

            const ts = new TomSelect('#emailDestinoConsulta', {
                persist: false, maxItems: null,
                valueField: 'email', labelField: 'email', searchField: ['email'],
                placeholder: 'Seleccione o escriba correos...',
                options: opcionesCorreos,
                render: {
                    item:   (item, e) => `<div><span class="email">${e(item.email)}</span></div>`,
                    option: (item, e) => `<div><span class="label">${e(item.email)}</span></div>`
                },
                createFilter: input => new RegExp('^' + REGEX_EMAIL + '$', 'i').test(input),
                create: input => {
                    if (new RegExp('^' + REGEX_EMAIL + '$', 'i').test(input)) return { email: input };
                    Swal.showValidationMessage('Formato de correo inválido: ' + input);
                    return false;
                },
                plugins: ['remove_button'],
                onItemAdd() { this.setTextboxValue(''); this.refreshOptions(); }
            });

            if (opcionesCorreos && opcionesCorreos.length > 0)
                opcionesCorreos.forEach(o => ts.addItem(o.email, true));
        }

        async function enviarFacturaPorCorreoConsulta(uuid, opciones) {
            const { emails, asunto, incluirPDF, incluirXML, mensaje } = opciones;

            Swal.fire({
                title: 'Enviando correo...',
                html: `<div style="text-align:center;padding:1rem;">
                    <p style="color:#6b7280;">Enviando a <strong>${emails.length}</strong> destinatario${emails.length > 1 ? 's' : ''}</p>
                    <p style="color:#9ca3af;font-size:0.85rem;margin-top:0.5rem;">${emails.join(', ')}</p>
                </div>`,
                showConfirmButton: false,
                allowOutsideClick: false
            });

            try {
                const formData = new FormData();
                formData.append('emails',      emails.join(','));
                formData.append('facturaId',   uuid);
                formData.append('asunto',      asunto);
                formData.append('mensaje',     mensaje);
                formData.append('incluirPDF',  incluirPDF);
                formData.append('incluirXML',  incluirXML);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) formData.append('__RequestVerificationToken', token);

                const response = await fetch('/FacturaConsulta/EnviarEmailDesdeConsulta', { method: 'POST', body: formData });
                if (!response.ok) throw new Error(`Error HTTP: ${response.status}`);

                const result = await response.json();
                if (result.success) {
                    Swal.fire({
                        icon: 'success',
                        title: '✅ Correo enviado',
                        html: `<div style="text-align:center;padding:1rem;">
                            <p style="color:#374151;">Factura enviada exitosamente a:</p>
                            <div style="background:#f0fdf4;padding:1rem;border-radius:8px;margin-top:1rem;border-left:3px solid #10b981;">
                                ${emails.map(e => `<div style="color:#059669;font-weight:600;padding:0.25rem 0;"><i class="fas fa-check-circle"></i> ${e}</div>`).join('')}
                            </div>
                        </div>`,
                        confirmButtonText: '<i class="fas fa-check"></i> Aceptar',
                        confirmButtonColor: '#059669'
                    });
                } else {
                    throw new Error(result.message || 'Error al enviar');
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Error al enviar', text: error.message, confirmButtonColor: '#dc2626' });
            }
        }

        function buildEstadoPagoSection(factura, complementos, anticipos, creditoInfo) {
            const total = parseFloat(factura.total || 0);
            const saldo = parseFloat(creditoInfo?.saldo_actual ?? 0) || 0;
            const pagado = total - saldo;
            const pct = total > 0 ? Math.min(Math.round((pagado / total) * 100), 100) : 0;
            const esPPD = ['PPD', 'PAGO EN PARCIALIDADES O DIFERIDO']
                .some(v => (factura.mdpfactura || '').toUpperCase().includes(v));

            const colorBarra = pct >= 100 ? '#059669' : pct >= 50 ? '#f59e0b' : '#ef4444';

            // ── Cards de señales ──────────────────────────────────────────
            const cardSaldo = `
<div style="flex:1;min-width:180px;padding:16px;border-radius:10px;
            border-left:4px solid ${saldo <= 0 ? '#059669' : '#f59e0b'};
            background:${saldo <= 0 ? '#f0fdf4' : '#fffbeb'};">
    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                letter-spacing:.06em;color:#64748b;margin-bottom:6px;">
        Saldo pendiente
    </div>
    <div style="font-size:22px;font-weight:700;font-family:'IBM Plex Mono',monospace;
                color:${saldo <= 0 ? '#059669' : '#b45309'};">
        $${saldo.toFixed(2)}
    </div>
    <div style="margin:8px 0 4px;background:#e2e8f0;height:5px;border-radius:3px;overflow:hidden;">
        <div style="height:100%;width:${pct}%;background:${colorBarra};border-radius:3px;"></div>
    </div>
    <div style="font-size:11px;color:#64748b;font-family:'IBM Plex Mono',monospace;">
        $${pagado.toFixed(2)} / $${total.toFixed(2)} (${pct}%)
    </div>
    ${saldo <= 0 ? '<div style="margin-top:6px;font-size:11px;color:#059669;font-weight:600;"><i class="fa fa-check-circle"></i> Totalmente pagada</div>' : ''}
</div>`;

            // Card anticipos
            const montoAnt = anticipos.reduce((s, a) => s + parseFloat(a.monto_aplicado || 0), 0);
            const cardAnt = anticipos.length > 0 ? `
<div style="flex:1;min-width:180px;padding:16px;border-radius:10px;
            border-left:4px solid #7c3aed;background:#faf5ff;">
    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                letter-spacing:.06em;color:#64748b;margin-bottom:6px;">
        Anticipo aplicado
    </div>
    <div style="font-size:22px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:#5b21b6;">
        $${montoAnt.toFixed(2)}
    </div>
    <div style="font-size:11px;color:#6b21a8;margin-top:4px;">
        ${anticipos.length} anticipo${anticipos.length > 1 ? 's' : ''} aplicado${anticipos.length > 1 ? 's' : ''}
    </div>
    ${anticipos.map(a =>
                `<div style="font-size:10px;color:#7c3aed;font-family:'IBM Plex Mono',monospace;margin-top:3px;">
            ${a.anticipo_serie || ''}${a.anticipo_folio || ''} · $${parseFloat(a.monto_aplicado).toFixed(2)}
         </div>`
            ).join('')}
</div>` : '';

            // Card complementos
            const montoCP = complementos.reduce((s, c) => s + parseFloat(c.monto_pagado || 0), 0);
            const cardComp = complementos.length > 0 ? `
<div style="flex:1;min-width:180px;padding:16px;border-radius:10px;
            border-left:4px solid #1d4ed8;background:#eff6ff;">
    <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                letter-spacing:.06em;color:#64748b;margin-bottom:6px;">
        Complemento${complementos.length > 1 ? 's' : ''} de pago
    </div>
    <div style="font-size:22px;font-weight:700;font-family:'IBM Plex Mono',monospace;color:#1e40af;">
        $${montoCP.toFixed(2)}
    </div>
    <div style="font-size:11px;color:#1d4ed8;margin-top:4px;">
        ${complementos.length} CFDI${complementos.length > 1 ? 's' : ''} CC vinculado${complementos.length > 1 ? 's' : ''}
    </div>
    ${complementos.map(c =>
                `<div style="font-size:10px;color:#1e40af;font-family:'IBM Plex Mono',monospace;margin-top:3px;">
            ${c.serie || ''}${c.folio || ''} · $${parseFloat(c.monto_pagado).toFixed(2)}
            <span style="color:#64748b;"> · ${dateFormatter(c.fecha_pago)}</span>
         </div>`
            ).join('')}
</div>` : '';

            // Card crédito PPD
            let cardCredito = '';
            if (esPPD && creditoInfo) {
                const diasR = parseInt(creditoInfo.dias_restantes || 0);
                const color = diasR < 0 ? '#dc2626' : diasR <= 5 ? '#d97706' : '#059669';
                const semTxt = diasR < 0
                    ? `Vencida hace ${Math.abs(diasR)} días`
                    : diasR <= 5
                        ? `Vence en ${diasR} días`
                        : `${diasR} días restantes`;

                cardCredito = `
    <div style="flex:1;min-width:180px;padding:16px;border-radius:10px;
                border-left:4px solid ${color};background:${diasR < 0 ? '#fef2f2' : diasR <= 5 ? '#fffbeb' : '#f0fdf4'};">
        <div style="font-size:10px;font-weight:700;text-transform:uppercase;
                    letter-spacing:.06em;color:#64748b;margin-bottom:6px;">
            Crédito PPD
        </div>
        <div style="font-size:14px;font-weight:700;color:${color};">${semTxt}</div>
        <div style="font-size:11px;color:#64748b;margin-top:4px;">
            Vence: ${creditoInfo.fecha_vencimiento
                        ? new Date(creditoInfo.fecha_vencimiento).toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' })
                        : '—'}
        </div>
        <div style="font-size:11px;color:#64748b;">
            Días pactados: ${creditoInfo.dias_credito || '—'}
        </div>
        ${parseFloat(creditoInfo.pagado_con_complementos || 0) > 0
                        ? `<div style="font-size:11px;color:#1e40af;margin-top:4px;font-weight:600;">
                   Abonado por CP: $${parseFloat(creditoInfo.pagado_con_complementos).toFixed(2)}
               </div>`
                        : ''}
    </div>`;
            }

            return `
<div class="detail-section">
    <div class="section-title"><i class="fa fa-circle-dollar-to-slot"></i> Estado de pago</div>
    <div style="display:flex;gap:12px;flex-wrap:wrap;">
        ${cardSaldo}
        ${cardAnt}
        ${cardComp}
        ${cardCredito}
    </div>
</div>`;
        }

        function registrarCargaPortal(uuid, cliente) {
            // Primero cargar días de crédito del cliente
            Swal.fire({
                title: '<i class="fas fa-spinner fa-spin"></i> Cargando...',
                html: '<p>Obteniendo información del cliente...</p>',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            fetch(`/FacturaConsulta/ObtenerDiasCredito?uuid=${uuid}`)
                .then(r => r.json())
                .then(data => {
                    if (data.success) {
                        mostrarModalCargaPortal(uuid, cliente, data);
                    } else {
                        // Si falla el fetch, abrir modal sin datos
                        mostrarModalCargaPortal(uuid, cliente, { diasCredito: 0, tieneCredito: false });
                    }
                })
                .catch(() => mostrarModalCargaPortal(uuid, cliente, { diasCredito: 0, tieneCredito: false }));
        }

        function mostrarModalCargaPortal(uuid, cliente, creditoInfo) {
            const hoy = new Date().toISOString().split('T')[0];
            const { diasCredito, tieneCredito, cargaPrevia, fechaCargaAnterior, diasCargaAnterior, estatusCarga } = creditoInfo;

            // Banner de carga previa (si ya fue registrada antes)
            const bannerCargaPrevia = cargaPrevia ? `
        <div style="background:#fef3c7;padding:0.85rem 1rem;border-radius:8px;margin-bottom:1.25rem;border-left:4px solid #f59e0b;display:flex;align-items:center;gap:0.75rem;">
            <i class="fas fa-exclamation-triangle" style="color:#d97706;font-size:1.2rem;"></i>
            <div>
                <div style="color:#92400e;font-weight:600;font-size:0.9rem;">Ya existe una carga registrada</div>
                <div style="color:#78350f;font-size:0.8rem;">
                    Fecha anterior: <strong>${fechaCargaAnterior}</strong> ·
                    Días: <strong>${diasCargaAnterior}</strong> ·
                    Estatus: <strong>${estatusCarga}</strong>
                </div>
                <div style="color:#92400e;font-size:0.8rem;margin-top:2px;">Al guardar se sobreescribirá el registro anterior.</div>
            </div>
        </div>` : '';

            // Banner de alerta si no tiene días configurados
            const bannerSinCredito = !tieneCredito ? `
        <div style="background:#fee2e2;padding:0.85rem 1rem;border-radius:8px;margin-bottom:1.25rem;border-left:4px solid #dc2626;display:flex;align-items:center;gap:0.75rem;">
            <i class="fas fa-exclamation-circle" style="color:#dc2626;font-size:1.2rem;"></i>
            <div>
                <div style="color:#991b1b;font-weight:600;font-size:0.9rem;">Cliente sin días de crédito configurados</div>
                <div style="color:#7f1d1d;font-size:0.8rem;">Seleccione manualmente los días de plazo para esta factura.</div>
            </div>
        </div>` : `
