                        </div>
                        <div id="folioContainer" style="margin-bottom:20px;display:none;">
                            <label style="display:block;font-weight:600;margin-bottom:8px;color:var(--text-dark);font-size:14px;">Folio fiscal que sustituye *</label>
                            <input type="text" id="folioInput" class="swal2-input" placeholder="UUID de la factura sustituta (36 caracteres)" maxlength="36"
                                style="width:100%;margin:0;padding:12px 16px;border:2px solid var(--border-light);border-radius:8px;font-size:14px;font-family:monospace;"/>
                        </div>
                        <div style="background:#fff3cd;border:1px solid #ffc107;border-radius:8px;padding:12px;margin-top:20px;">
                            <p style="margin:0;color:#856404;font-size:0.9em;">
                                <i class="fas fa-exclamation-triangle"></i>
                                <strong>Importante:</strong> La cancelación es irreversible.
                            </p>
                        </div>
                    </div>`,
                icon: 'warning', width: '600px',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-arrow-right"></i> Continuar',
                cancelButtonText:  '<i class="fas fa-times"></i> Cancelar',
                buttonsStyling: false,
                customClass: { popup: 'custom-swal-popup', title: 'custom-swal-title', confirmButton: 'custom-swal-confirm', cancelButton: 'custom-swal-cancel' },
                didOpen: () => {
                    const motivoSelect   = document.getElementById('motivoSelect');
                    const folioContainer = document.getElementById('folioContainer');
                    const folioInput     = document.getElementById('folioInput');

                    motivoSelect.addEventListener('change', () => {
                        folioContainer.style.display = motivoSelect.value === '01' ? 'block' : 'none';
                        if (motivoSelect.value !== '01') folioInput.value = '';
                    });

                    folioInput.addEventListener('input', e => {
                        e.target.value = e.target.value.toUpperCase();
                        const ok = /^[A-F0-9-]*$/.test(e.target.value);
                        e.target.style.borderColor = !ok ? 'var(--danger-color)' : e.target.value.length === 36 ? 'var(--success-color)' : 'var(--border-light)';
                    });
                },
                preConfirm: () => {
                    const motivo          = document.getElementById('motivoSelect').value;
                    const folioSustitucion = document.getElementById('folioInput').value.trim().toUpperCase();
                    if (!motivo)                                          { Swal.showValidationMessage('Debe seleccionar un motivo'); return false; }
                    if (motivo === '01' && !folioSustitucion)             { Swal.showValidationMessage('Debe ingresar el folio sustituto'); return false; }
                    if (motivo === '01' && folioSustitucion.length !== 36){ Swal.showValidationMessage('El UUID debe tener 36 caracteres'); return false; }
                    return { motivo, folioSustitucion };
                }
            });

            if (!formValues) return;

            const { motivo, folioSustitucion } = formValues;

            const { value: aceptacion } = await Swal.fire({
                title: '<i class="fas fa-check-circle"></i> Confirmar Cancelación',
                html: `
                    <div style="text-align:left;padding:10px;">
                        <div style="background:#f8d7da;border:1px solid #f5c6cb;border-radius:8px;padding:15px;margin-bottom:20px;">
                            <p style="margin:0 0 10px 0;color:#721c24;font-weight:600;"><i class="fas fa-exclamation-triangle"></i> Advertencia</p>
                            <ul style="margin:0;padding-left:20px;color:#721c24;font-size:0.9em;">
                                <li>Esta acción es <strong>irreversible</strong></li>
                                <li>La factura será cancelada permanentemente ante el SAT</li>
                            </ul>
                        </div>
                        <div style="border:2px solid var(--primary-blue);border-radius:8px;padding:15px;">
                            <label style="display:flex;align-items:center;cursor:pointer;user-select:none;">
                                <input type="checkbox" id="aceptacionCheck" style="width:20px;height:20px;margin-right:12px;accent-color:var(--primary-blue);">
                                <span style="color:var(--text-dark);font-size:0.95em;"><strong>He revisado la información y autorizo la cancelación.</strong></span>
                            </label>
                        </div>
                    </div>`,
                icon: 'question', width: '550px',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-ban"></i> Cancelar Factura',
                cancelButtonText:  '<i class="fas fa-arrow-left"></i> Regresar',
                buttonsStyling: false,
                customClass: { popup: 'custom-swal-popup', title: 'custom-swal-title', confirmButton: 'custom-swal-confirm-danger', cancelButton: 'custom-swal-cancel' },
                preConfirm: () => {
                    if (!document.getElementById('aceptacionCheck').checked) {
                        Swal.showValidationMessage('Debe aceptar los términos para continuar');
                        return false;
                    }
                    return true;
                }
            });

            if (!aceptacion) return;

            Swal.fire({
                title: '<i class="fas fa-spinner fa-spin"></i> Procesando Cancelación',
                html: '<p style="color:#6c757d;margin-top:15px;">Cancelando factura, por favor espere...</p>',
                allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            const formData = new FormData();
            formData.append('rfcEmisor',        rfcEmisor);
            formData.append('uuid',             uuid);
            formData.append('motivo',           motivo);
            formData.append('folioSustitucion', folioSustitucion || '');

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);

            try {
                const response = await fetch('/FacturaConsulta/CancelarFactura', { method: 'POST', body: formData });
                const data = await response.json();

                if (data.success) {
                    await Swal.fire({
                        icon: 'success',
                        title: '<i class="fas fa-check-circle"></i> Cancelación Exitosa',
                        html: `<div style="text-align:center;padding:10px;">
                            <p style="color:#155724;font-weight:500;">${data.message}</p>
                            <a href="${data.acusePath}" target="_blank"
                               style="display:inline-block;margin-top:1rem;padding:12px 24px;text-decoration:none;border-radius:8px;font-weight:600;background-color:var(--success-color);color:white;">
                                <i class="fas fa-download"></i> Descargar Acuse XML
                            </a>
                        </div>`,
                        confirmButtonText: '<i class="fas fa-check"></i> Aceptar',
                        buttonsStyling: false,
                        customClass: { confirmButton: 'custom-swal-confirm' }
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Error al Cancelar', text: data.message, confirmButtonColor: '#dc2626' });
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Error Inesperado', text: error.message, confirmButtonColor: '#dc2626' });
            }
        }



        // ============================================
        // EXPORTAR CSV
        // ============================================
        function exportarCSV() {
            const searchInput = document.querySelector('#facturas input[type="search"], #facturas input[type="text"]');
            const nombre = searchInput ? encodeURIComponent(searchInput.value.trim()) : '';
            const usuarioInput = document.getElementById('filtroUsuarioCSV');
            const usuario = usuarioInput ? encodeURIComponent(usuarioInput.value.trim()) : '';

            const url = `/FacturaConsulta/ExportarFacturasCSV?nombre=${nombre}&usuarioFiltro=${usuario}`;

            // Feedback visual mientras descarga
            Swal.fire({
                title: '<i class="fas fa-spinner fa-spin"></i> Generando CSV...',
                html: '<p style="color:#6b7280;">Esto puede tardar unos segundos según el volumen de facturas.</p>',
                allowOutsideClick: false,
                showConfirmButton: false,
                timer: 1500,          // se cierra solo; el browser ya tomó la descarga
                didOpen: () => Swal.showLoading()
            });

            // Dispara la descarga creando un <a> temporal
            const a = document.createElement('a');
            a.href = url;
            a.download = '';      // el nombre viene del servidor en Content-Disposition
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

// ============================================
// ENVÍO MASIVO POR CLIENTE
// ============================================
let seleccionMasiva = new Set();
let modoSeleccion   = false;

// Lee el UUID de la fila usando la columna oculta que inyectamos
function getUuidDeFila(tr) {
    const span = tr.querySelector('.uuid-val');
    return span ? span.dataset.uuid : null;
}

function toggleModoSeleccion() {
    modoSeleccion = !modoSeleccion;
    seleccionMasiva.clear();

    const btnMasivo = document.getElementById('btnEnvioMasivo');
    const btnToggle = document.getElementById('btnToggleSeleccion');
    const contador  = document.getElementById('contadorSeleccion');

    if (modoSeleccion) {
        btnToggle.innerHTML        = '<i class="fa fa-xmark"></i> Cancelar selección';
        btnToggle.style.background = '#dc2626';
        btnMasivo.style.display    = 'inline-flex';
        contador.style.display     = 'inline-flex';
        contador.textContent       = '0 seleccionadas';
        insertarCheckboxes();
        iniciarObservador();
    } else {
        btnToggle.innerHTML        = '<i class="fa fa-paper-plane"></i> Envío masivo';
        btnToggle.style.background = '#7c3aed';
        btnMasivo.style.display    = 'none';
        contador.style.display     = 'none';
        detenerObservador();
        quitarCheckboxes();
    }
}

// ── MutationObserver: re-inserta checkboxes cuando la tabla repagina ─
let _observer = null;

function iniciarObservador() {
    const tbody = document.querySelector('#facturas table tbody');
    if (!tbody) return;

    _observer = new MutationObserver(() => {
        // Pequeño delay para que el DOM esté estable tras el render
        setTimeout(insertarCheckboxes, 30);
    });
    _observer.observe(tbody, { childList: true });
}

function detenerObservador() {
    if (_observer) { _observer.disconnect(); _observer = null; }
}

function insertarCheckboxes() {
    // ── Encabezado ──────────────────────────────────────────────────
    const thead = document.querySelector('#facturas table thead tr');
    if (thead && !thead.querySelector('.th-masivo')) {
        const th = document.createElement('th');
        th.className = 'th-masivo';
        th.style.cssText = 'width:40px;text-align:center;';
        th.innerHTML = `<input type="checkbox" id="cbTodos" title="Seleccionar todas"
            style="width:16px;height:16px;cursor:pointer;accent-color:#7c3aed;">`;
        th.querySelector('input').addEventListener('change', function () {
            toggleTodos(this);
        });
        thead.insertBefore(th, thead.firstChild);
    }

    // ── Filas del cuerpo ─────────────────────────────────────────────
    document.querySelectorAll('#facturas table tbody tr').forEach(tr => {
        if (tr.querySelector('.cb-masivo')) return; // ya tiene checkbox

        const uuid = getUuidDeFila(tr);
        if (!uuid) return; // fila sin UUID (no es una fila de datos)

        const td = document.createElement('td');
        td.className = 'td-masivo';
        td.style.cssText = 'width:40px;text-align:center;vertical-align:middle;';
        td.innerHTML = `<input type="checkbox" class="cb-masivo" data-uuid="${uuid}"
            style="width:16px;height:16px;cursor:pointer;accent-color:#7c3aed;"
            ${seleccionMasiva.has(uuid) ? 'checked' : ''}>`;

        td.querySelector('input').addEventListener('change', function () {
            toggleSeleccion(this);
        });

        tr.insertBefore(td, tr.firstChild);
    });

    // Sincronizar estado del "seleccionar todos"
    sincronizarCbTodos();
}

function quitarCheckboxes() {
    document.querySelectorAll('.td-masivo').forEach(td => td.remove());
    document.querySelector('.th-masivo')?.remove();
}

function toggleSeleccion(cb) {
    const uuid = cb.dataset.uuid;
    if (!uuid) return;
    if (cb.checked) {
        seleccionMasiva.add(uuid);
    } else {
        seleccionMasiva.delete(uuid);
    }
    sincronizarCbTodos();
    actualizarContador();
}

function toggleTodos(cbTodos) {
    // Solo afecta las filas visibles en la página actual
    document.querySelectorAll('.cb-masivo').forEach(cb => {
        const uuid = cb.dataset.uuid;
        if (!uuid) return;
        cb.checked = cbTodos.checked;
        if (cbTodos.checked) {
            seleccionMasiva.add(uuid);
        } else {
            seleccionMasiva.delete(uuid);
        }
    });
    actualizarContador();
}

// Marca/desmarca el checkbox "todos" según el estado de los visibles
function sincronizarCbTodos() {
    const cbTodos = document.getElementById('cbTodos');
    if (!cbTodos) return;
    const todos   = document.querySelectorAll('.cb-masivo');
    const checked = document.querySelectorAll('.cb-masivo:checked');
    cbTodos.indeterminate = checked.length > 0 && checked.length < todos.length;
    cbTodos.checked       = todos.length > 0 && checked.length === todos.length;
}

function actualizarContador() {
    const n        = seleccionMasiva.size;
    const contador = document.getElementById('contadorSeleccion');
    if (contador) {
        contador.textContent      = `${n} seleccionada${n !== 1 ? 's' : ''}`;
        contador.style.background = n > 0 ? '#7c3aed' : '#94a3b8';
    }
    const btnMasivo = document.getElementById('btnEnvioMasivo');
    if (btnMasivo) {
        btnMasivo.style.opacity = n > 0 ? '1' : '0.5';
        btnMasivo.disabled      = n === 0;
    }
}

async function iniciarEnvioMasivo() {
    if (seleccionMasiva.size === 0) {
        Swal.fire({ icon: 'warning', title: 'Sin selección', text: 'Seleccione al menos una factura.' });
        return;
    }

    Swal.fire({
        title: '<i class="fa fa-spinner fa-spin"></i> Analizando selección...',
        allowOutsideClick: false,
        showConfirmButton: false,
        didOpen: () => Swal.showLoading()
    });

    const formPreview = new FormData();
    formPreview.append('uuids', [...seleccionMasiva].join(','));
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (token) formPreview.append('__RequestVerificationToken', token);

    let resumen;
    try {
        const resp = await fetch('/FacturaConsulta/ObtenerResumenSeleccion', { method: 'POST', body: formPreview });
        if (!resp.ok) throw new Error(`Error HTTP ${resp.status}`);
        resumen = await resp.json();
    } catch (e) {
        Swal.fire({ icon: 'error', title: 'Error al obtener resumen', text: e.message });
        return;
    }

    if (!resumen.success) {
        Swal.fire({ icon: 'error', title: 'Error', text: resumen.message });
        return;
    }

    mostrarModalEnvioMasivo(resumen);
}

function mostrarModalEnvioMasivo(resumen) {
    const { grupos, totalFacturas } = resumen;

    const htmlGrupos = grupos.map(g => {
        const tieneCorreos = g.correos && g.correos.length > 0;
        const badgeCorreos = tieneCorreos
            ? `<span style="background:#d1fae5;color:#065f46;padding:2px 8px;border-radius:20px;
                           font-size:10px;font-weight:700;">
                 <i class="fa fa-envelope"></i> ${g.correos.length} correo${g.correos.length > 1 ? 's' : ''}
               </span>`
            : `<span style="background:#fee2e2;color:#991b1b;padding:2px 8px;border-radius:20px;
                           font-size:10px;font-weight:700;">
                 <i class="fa fa-exclamation-triangle"></i> Sin correos
               </span>`;

        const listaFacs = g.facturas.map(f =>
            `<div style="font-size:10px;color:#64748b;font-family:'IBM Plex Mono',monospace;padding:1px 0;">
                ${f.serie}${f.folio} · $${parseFloat(f.total).toFixed(2)}
             </div>`
        ).join('');

        return `
        <div style="border:1px solid #e2e8f0;border-radius:10px;padding:12px 14px;margin-bottom:10px;
                    background:${tieneCorreos ? '#f8fafc' : '#fef2f2'};">
            <div style="display:flex;justify-content:space-between;align-items:center;
                        margin-bottom:6px;flex-wrap:wrap;gap:6px;">
                <div>
                    <div style="font-weight:700;color:#0f172a;font-size:0.9rem;">${g.cliente}</div>
                    <div style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:#64748b;">${g.rfc}</div>
                </div>
                <div style="text-align:right;">
                    ${badgeCorreos}
                    <div style="font-size:11px;color:#334155;font-weight:600;margin-top:3px;">
                        ${g.facturas.length} factura${g.facturas.length > 1 ? 's' : ''} ·
                        $${parseFloat(g.totalGrupo).toFixed(2)} ${g.moneda}
                    </div>
                </div>
            </div>
            <details>
                <summary style="font-size:11px;color:#64748b;cursor:pointer;list-style:none;">
                    <i class="fa fa-chevron-right" style="font-size:9px;"></i> Ver facturas incluidas
                </summary>
                <div style="margin-top:6px;padding-left:8px;border-left:2px solid #e2e8f0;">
                    ${listaFacs}
                </div>
            </details>
            ${tieneCorreos
                ? `<div style="margin-top:8px;font-size:10px;color:#475569;">
                     <i class="fa fa-envelope" style="color:#059669;"></i> ${g.correos.join(' · ')}
                   </div>`
                : `<div style="margin-top:8px;font-size:10px;color:#991b1b;font-weight:600;">
                     <i class="fa fa-exclamation-circle"></i> No se enviará — sin correos registrados
                   </div>`}
        </div>`;
    }).join('');

    const totalConCorreo = grupos.filter(g => g.correos && g.correos.length > 0).length;

    Swal.fire({
        title: `<i class="fa fa-paper-plane"></i> Envío Masivo — ${totalFacturas} factura${totalFacturas > 1 ? 's' : ''}`,
        html: `
        <div style="text-align:left;">
            <div style="display:flex;gap:10px;margin-bottom:16px;flex-wrap:wrap;">
                <div style="flex:1;min-width:100px;background:#eff6ff;border-radius:8px;
                            padding:10px 14px;border-left:3px solid #3b82f6;">
                    <div style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;">Clientes</div>
                    <div style="font-size:22px;font-weight:700;color:#1e40af;">${grupos.length}</div>
                </div>
                <div style="flex:1;min-width:100px;background:#f0fdf4;border-radius:8px;
                            padding:10px 14px;border-left:3px solid #10b981;">
                    <div style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;">Con correo</div>
                    <div style="font-size:22px;font-weight:700;color:#059669;">${totalConCorreo}</div>
                </div>
                <div style="flex:1;min-width:100px;background:#faf5ff;border-radius:8px;
                            padding:10px 14px;border-left:3px solid #7c3aed;">
                    <div style="font-size:10px;font-weight:700;color:#64748b;text-transform:uppercase;">Facturas</div>
                    <div style="font-size:22px;font-weight:700;color:#5b21b6;">${totalFacturas}</div>
                </div>
            </div>

            <div style="max-height:220px;overflow-y:auto;margin-bottom:14px;padding-right:4px;">
                ${htmlGrupos}
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-weight:600;font-size:0.85rem;color:#374151;margin-bottom:5px;">
                    <i class="fa fa-heading"></i> Asunto *
                </label>
                <input id="asuntoMasivo" type="text" value="Facturas Electrónicas"
                    style="width:100%;padding:9px 12px;border:2px solid #e5e7eb;
                           border-radius:8px;font-size:0.9rem;box-sizing:border-box;"/>
            </div>

            <div style="margin-bottom:12px;">
                <label style="display:block;font-weight:600;font-size:0.85rem;color:#374151;margin-bottom:5px;">
                    <i class="fa fa-plus-circle"></i> CC adicional (opcional)
                </label>
                <select id="correosAdicionalesMasivo" multiple
                        placeholder="Agregar correos en copia..."></select>
                <small style="font-size:0.75rem;color:#94a3b8;">
                    Escriba y presione Enter — se incluirán en TODOS los envíos
                </small>
            </div>

            <div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;
                        padding:10px 14px;margin-bottom:12px;">
                <div style="font-weight:600;font-size:0.85rem;color:#374151;margin-bottom:8px;">
                    <i class="fa fa-paperclip"></i> Adjuntos por factura
                </div>
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;
                              cursor:pointer;font-size:0.85rem;">
                    <input type="checkbox" id="pdfMasivo" checked
                           style="width:15px;height:15px;accent-color:#7c3aed;">
                    <i class="fa fa-file-pdf" style="color:#dc2626;"></i> PDF (español)
                </label>
                <label style="display:flex;align-items:center;gap:8px;margin-bottom:6px;
                              cursor:pointer;font-size:0.85rem;">
                    <input type="checkbox" id="pdfEnMasivo"
                           style="width:15px;height:15px;accent-color:#7c3aed;">
                    <i class="fa fa-file-pdf" style="color:#2563eb;"></i> PDF (inglés)
                </label>
                <label style="display:flex;align-items:center;gap:8px;cursor:pointer;font-size:0.85rem;">
                    <input type="checkbox" id="xmlMasivo" checked
                           style="width:15px;height:15px;accent-color:#7c3aed;">
                    <i class="fa fa-file-code" style="color:#059669;"></i> XML
                </label>
            </div>

            <textarea id="mensajeMasivo" rows="2" placeholder="Mensaje adicional (opcional)..."
                style="width:100%;padding:9px 12px;border:2px solid #e5e7eb;border-radius:8px;
                       font-family:inherit;resize:vertical;font-size:0.85rem;
                       box-sizing:border-box;"></textarea>
        </div>`,
        width: '680px',
        showCancelButton: true,
        confirmButtonText: `<i class="fa fa-paper-plane"></i> Enviar a ${totalConCorreo} cliente${totalConCorreo !== 1 ? 's' : ''}`,
        cancelButtonText: 'Cancelar',
        confirmButtonColor: '#7c3aed',
        focusConfirm: false,
        didOpen: () => {
            new TomSelect('#correosAdicionalesMasivo', {
                persist: false,
                maxItems: null,
                valueField: 'email',
                labelField: 'email',
                searchField: ['email'],
                options: [],
                createFilter: input => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(input),
                create: input => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(input)
                    ? { email: input }
                    : false,
                plugins: ['remove_button'],
                onItemAdd() { this.setTextboxValue(''); this.refreshOptions(); }
            });
        },
        preConfirm: () => {
            const asunto       = document.getElementById('asuntoMasivo').value.trim();
            const incluirPDF   = document.getElementById('pdfMasivo').checked;
            const incluirXML   = document.getElementById('xmlMasivo').checked;
            const incluirPDFEN = document.getElementById('pdfEnMasivo').checked;

            if (!asunto) {
                Swal.showValidationMessage('El asunto es obligatorio');
                return false;
            }
            if (!incluirPDF && !incluirXML) {
                Swal.showValidationMessage('Seleccione al menos un tipo de archivo');
                return false;
            }

            // Leer TomSelect de forma segura
            const selectEl = document.getElementById('correosAdicionalesMasivo');
            const tsInstance = selectEl && selectEl.tomselect;
            const correosAdicionales = tsInstance
                ? (Array.isArray(tsInstance.getValue())
                    ? tsInstance.getValue()
                    : [tsInstance.getValue()].filter(Boolean))
                : [];

            return {
                asunto,
                incluirPDF,
                incluirXML,
                incluirPDFEN,
                correosAdicionales,
                mensaje: document.getElementById('mensajeMasivo').value.trim()
            };
        }
    }).then(async result => {
        if (!result.isConfirmed || !result.value) return;
        await ejecutarEnvioMasivo(result.value);
    });
}

async function ejecutarEnvioMasivo({ asunto, incluirPDF, incluirXML, incluirPDFEN, correosAdicionales, mensaje }) {
    Swal.fire({
        title: '<i class="fa fa-spinner fa-spin"></i> Enviando facturas...',
        html: `<div style="text-align:center;padding:1rem;">
                   <p style="color:#64748b;">Procesando ${seleccionMasiva.size} factura(s)...</p>
                   <p style="color:#94a3b8;font-size:0.8rem;">Esto puede tomar unos segundos</p>
               </div>`,
        allowOutsideClick: false,
        showConfirmButton: false,
        didOpen: () => Swal.showLoading()
    });

    const formData = new FormData();
    formData.append('uuids',              [...seleccionMasiva].join(','));
    formData.append('asunto',             asunto);
    formData.append('mensaje',            mensaje);
    formData.append('incluirPDF',         incluirPDF);
    formData.append('incluirXML',         incluirXML);
    formData.append('incluirPDFEN',       incluirPDFEN);
    formData.append('correosAdicionales', JSON.stringify(correosAdicionales));

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (token) formData.append('__RequestVerificationToken', token);

    try {
        const resp   = await fetch('/FacturaConsulta/EnviarMasivoCliente', { method: 'POST', body: formData });
        if (!resp.ok) throw new Error(`HTTP ${resp.status}`);
        const result = await resp.json();

        const htmlResultados = (result.resultados || []).map(r => `
        <div style="display:flex;align-items:center;gap:10px;padding:8px 12px;border-radius:8px;
                    margin-bottom:6px;background:${r.success ? '#f0fdf4' : '#fef2f2'};
                    border-left:3px solid ${r.success ? '#10b981' : '#ef4444'};">
            <i class="fa ${r.success ? 'fa-check-circle' : 'fa-times-circle'}"
               style="color:${r.success ? '#059669' : '#dc2626'};font-size:1.1em;"></i>
            <div style="flex:1;min-width:0;">
                <div style="font-weight:600;font-size:0.85rem;color:#0f172a;
                            white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                    ${r.cliente}
                </div>
                <div style="font-size:10px;color:#64748b;">
                    ${r.facturas} factura(s) · ${r.message}
                </div>
            </div>
        </div>`).join('');

        Swal.fire({
            icon: result.success ? 'success' : 'error',
            title: result.success ? '✅ Envío completado' : '❌ Envío con errores',
            html: `<p style="color:#475569;margin-bottom:14px;">${result.message}</p>
                   <div style="max-height:280px;overflow-y:auto;text-align:left;">
                       ${htmlResultados}
                   </div>`,
            confirmButtonText: 'Aceptar',
            confirmButtonColor: '#7c3aed'
        });

        if (result.success) toggleModoSeleccion();

    } catch (e) {
        Swal.fire({ icon: 'error', title: 'Error inesperado', text: e.message });
    }
}
    </script>
}