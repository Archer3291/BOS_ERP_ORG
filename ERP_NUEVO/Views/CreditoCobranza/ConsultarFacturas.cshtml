            // Construir opciones del select resaltando la del cliente si existe
            const opcionesSelect = [30, 45, 60, 90].map(d => {
                const selected = tieneCredito && d === diasCredito ? 'selected' : '';
                const badge = tieneCredito && d === diasCredito
                    ? ' <span style="font-size:0.75em;background:#d1fae5;color:#065f46;padding:1px 6px;border-radius:10px;margin-left:4px;">cliente</span>'
                    : '';
                return `<option value="${d}" ${selected}>${d} días${badge}</option>`;
