<!-- Modal Buscar Factura -->
<div class="modal fade" id="vi-fac-modalBuscarFacturasCP" tabindex="-1" aria-labelledby="vi-fac-modalBuscarFacturasCPLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <!-- HEADER -->
            <div class="modal-header" style="background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue)); color: white;">
                <h5 class="modal-title" id="vi-fac-modalBuscarFacturasCPLabel">
                    <i class="fas fa-file-invoice-dollar me-2"></i>
                    Buscar Factura (CFDI) para Complemento de Pago
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <!-- TABS -->
                <ul class="nav nav-tabs mb-3" id="facturaTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="buscar-tab" data-bs-toggle="tab"
                                data-bs-target="#buscar-panel" type="button">
                            <i class="fas fa-search me-2"></i>Buscar Factura
                        </button>
                    </li>
                    <li class="nav-item d-none" role="presentation">
                        <button class="nav-link" id="manual-tab" data-bs-toggle="tab"
                                data-bs-target="#manual-panel" type="button">
                            <i class="fas fa-edit me-2"></i>Ingresar Manualmente
                        </button>
                    </li>
                </ul>

                <!-- TAB CONTENT -->
                <div class="tab-content" id="facturaTabContent">

                    <!-- PANEL BÚSQUEDA (código existente) -->
                    <div class="tab-pane fade show active" id="buscar-panel">
                        <div class="input-group mb-3">
                            <input type="text" id="vi-fac-inputBuscarFactura" class="form-control"
                                   placeholder="Buscar por folio, UUID, cliente, fecha o monto">
                            <button type="button" class="btn btn-outline-secondary" id="vi-fac-btnLimpiarFacturas">
                                <i class="fas fa-eraser"></i> Limpiar
                            </button>
                        </div>

                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-middle">
                                <thead class="table-primary"></thead>
                                <tbody id="vi-fac-listaResultadosFacturas">
                                    <tr class="vi-fac-empty-state">
                                        <td colspan="7" class="text-center py-4">
                                            <i class="fas fa-file-invoice-dollar d-block fs-2"></i>
                                            <div class="fw-bold">No hay facturas disponibles</div>
                                            <small>Realiza una búsqueda para comenzar</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- PANEL INGRESO MANUAL (NUEVO) -->
                    <div class="tab-pane fade" id="manual-panel">
                        <div class="card">
                            <div class="card-body">
                                <form id="vi-fac-formFacturaManual">
                                    <div class="row g-3">
                                        <!-- NUEVO CAMPO: Serie -->
                                        <div class="col-md-6">
                                            <label class="form-label">
                                                <i class="fas fa-hashtag text-primary me-1"></i>
                                                Serie <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" id="vi-fac-manual-serie"
                                                   placeholder="Ej: A, B, FAC"
                                                   maxlength="10"
                                                   required>
                                            <small class="text-muted">Serie de la factura</small>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">
                                                <i class="fas fa-file-invoice text-primary me-1"></i>
                                                Folio <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" id="vi-fac-manual-folio"
                                                   placeholder="Ej: 1234" required>
                                        </div>

                                        <div class="col-md-12">
                                            <label class="form-label">
                                                <i class="fas fa-hashtag text-primary me-1"></i>
                                                UUID <span class="text-danger">*</span>
                                            </label>
                                            <input type="text" class="form-control" id="vi-fac-manual-uuid"
                                                   placeholder="Ej: 12345678-1234-1234-1234-123456789012"
                                                   maxlength="36" required>
                                            <small class="text-muted">36 caracteres</small>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                <i class="fas fa-calendar text-primary me-1"></i>
                                                Fecha <span class="text-danger">*</span>
                                            </label>
                                            <input type="date" class="form-control" id="vi-fac-manual-fecha" required>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                <i class="fas fa-money-bill-wave text-primary me-1"></i>
                                                Total Factura <span class="text-danger">*</span>
                                            </label>
                                            <input type="number" class="form-control" id="vi-fac-manual-total"
                                                   placeholder="0.00" step="0.01" min="0.01" required>
                                        </div>

                                        <div class="col-md-4">
                                            <label class="form-label">
                                                <i class="fas fa-dollar-sign text-primary me-1"></i>
                                                Saldo Pendiente <span class="text-danger">*</span>
                                            </label>
                                            <input type="number" class="form-control" id="vi-fac-manual-saldo"
                                                   placeholder="0.00" step="0.01" min="0.01" required>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">
                                                <i class="fas fa-coins text-primary me-1"></i>
                                                Moneda <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-select" id="vi-fac-manual-moneda" required>
                                                <option value="MXN">MXN - Peso Mexicano</option>
                                                <option value="USD">USD - Dólar Americano</option>
                                                <option value="EUR">EUR - Euro</option>
                                            </select>
                                        </div>

                                        <div class="col-md-6">
                                            <label class="form-label">
                                                <i class="fas fa-credit-card text-primary me-1"></i>
                                                Método de Pago <span class="text-danger">*</span>
                                            </label>
                                            <select class="form-select" id="vi-fac-manual-metodo" required>
                                                <option value="PPD">PPD - Pago en Parcialidades</option>
                                                <option value="PUE">PUE - Pago en Una Exhibición</option>
                                            </select>
                                        </div>

                                        <div class="col-12">
                                            <div class="alert alert-info">
                                                <i class="fas fa-info-circle me-2"></i>
                                                <strong>Nota:</strong> Estos datos se usarán para generar el complemento de pago.
                                                Asegúrate de que coincidan con la factura original.
                                            </div>
                                        </div>

                                        <div class="col-12 text-end">
                                            <button type="button" class="btn btn-secondary me-2" id="vi-fac-btn-limpiar-manual">
                                                <i class="fas fa-eraser me-1"></i>Limpiar
                                            </button>
                                            <button type="submit" class="btn btn-primary">
                                                <i class="fas fa-plus me-1"></i>Agregar Factura Manual
                                            </button>
                                        </div>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer flex-column">

                <!-- Info de paginación -->
                <div class="w-100 d-flex justify-content-between align-items-center mb-2">
                    <span>
                        Mostrando <strong id="vi-fac-recordsFromFacturas">0</strong>
                        a <strong id="vi-fac-recordsToFacturas">0</strong>
                        de <strong id="vi-fac-totalRecordsFacturas">0</strong>
                    </span>

                    <div class="d-flex gap-2 align-items-center">
                        <select id="vi-fac-pageSizeFacturas" class="form-select form-select-sm">
                            <option value="25">25</option>
                            <option value="50" selected>50</option>
                            <option value="100">100</option>
                        </select>
                        <div id="vi-fac-spinnerFacturas" class="spinner-border spinner-border-sm text-primary d-none"></div>
                    </div>
                </div>

                <!-- Pagination -->
                <nav class="w-100">
                    <ul class="pagination justify-content-center mb-0" id="vi-fac-paginationFacturas"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Credito_Cobranza/complemento_pago.js"></script>
    <script src="~/Scripts/Facturas/manejo-respuestas.js"></script>
    <script>
        let tomManager;
        tomManager = new TomSelectManager();
        GetData({
            path: '/DatosGenerales/DatosSelect',
        }).then((_res) => {
            const vendedores = _res.vendedores;
            const monedas = _res.monedas;
            const cfdi = _res.usocfdi;
            const fpago = _res.formaspago;
            const incoterms = _res.incoterms;
            const tasas = _res.tasas;
            const sucursales = _res.sucursales;
            const almacenes = _res.almacenes;
            const banco = _res.bancos;
                           
            tomManager.create('vi-fac-moneda', {
                selector: '#vi-fac-moneda',
                options: monedas,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione una moneda...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    console.log("Moneda seleccionada:", value);

                    let v;
                    if (value === "PESOS") {
                        v = "peso";
                    } else if (value === "EURO") {
                        v = "euro";
                    } else if (value === "DLLS") {
                        v = "dolar";
                    }

                    // Aseguramos que exista tasas[0]
                    const tasaData = tasas?.[0];
                    if (!tasaData || !v) {
                        document.getElementById('vi-fac-paridad').value = '';
                        return;
                    }

                    // Obtener la tasa correspondiente
                    const tasaSeleccionada = tasaData[v];

                    // Actualizar el input si existe la tasa
                    if (tasaSeleccionada !== undefined) {
                        document.getElementById('vi-fac-paridad').value = tasaSeleccionada;
                    } else {
                        document.getElementById('vi-fac-paridad').value = '';
                    }
                }
            });
            tomManager.create('vi-fac-uso-cfdi', {
                selector: '#vi-fac-uso-cfdi',
                options: cfdi,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione el cfdi...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    console.log("CFDI seleccionado:", value);
                }
            });

            tomManager.create('vi-fac-banco', {
                selector: '#vi-fac-banco',
                options: banco,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione el banco...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    console.log("CFDI seleccionado:", value);
                }
            });
            tomManager.create('vi-fac-forma-pago', {
                selector: '#vi-fac-forma-pago',
                options: fpago,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione la forma de pago...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    console.log("Forma de pago seleccionada:", value);
                }
            });
            tomManager.create('vi-fac-incoterm', {
                selector: '#vi-fac-incoterm',
                options: incoterms,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione el incoterm...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    console.log("Forma de pago seleccionada:", value);
                }
            });

            // Crear TomSelect de sucursales
            const sucursalSelect3 = tomManager.create('vi-fac-sucursal', {
                selector: '#vi-fac-sucursal',
                options: sucursales,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione la sucursal...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">
                    ${escape(data.nombre)} (ID: ${escape(data.id)})
                </div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">
                    ${escape(data.nombre)}
                </div>`
                },
                onChange: (sucursalId) => {
                    console.log("Sucursal seleccionada:", sucursalId);

                    // Filtrar almacenes de esa sucursal
                    const almacenesFiltrados = almacenes.filter(a => a.sucursal_id == sucursalId);

                    // Obtener la instancia del TomSelect de almacén
                    const almacenInstance = tomManager.getInstance('vi-fac-almacen');
                    if (!almacenInstance) return;

                    // Limpiar y recargar opciones
                    almacenInstance.clear();         // Quita el valor seleccionado
                    almacenInstance.clearOptions();  // Limpia las opciones anteriores
                    almacenInstance.addOptions(almacenesFiltrados); // Agrega solo los almacenes de esa sucursal
                    almacenInstance.refreshOptions(false); // Refresca el desplegable

                    console.log("Almacenes disponibles:", almacenesFiltrados);
                }
            });
            // Crear TomSelect de almacenes
            tomManager.create('vi-fac-almacen', {
                selector: '#vi-fac-almacen',
                options: [], // inicialmente vacío, se llenará según la sucursal
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione el almacén...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div class="vi-fac-custom-option" style="color: var(--text-dark);">
                    ${escape(data.nombre)} (ID: ${escape(data.id)})
                </div>`,
                    item: (data, escape) =>
                        `<div class="vi-fac-custom-item" style="color: var(--text-dark);">
                    ${escape(data.nombre)}
                </div>`
                },
                onChange: (value) => {
                    console.log("Almacén seleccionado:", value);
                }
            });
            const suc = tomManager.getInstance('vi-fac-sucursal');
            suc.setValue(@Context.Session.GetInt32("Sucursal"), false);
            const alm = tomManager.getInstance('vi-fac-almacen');
            alm.setValue("1", false);
            const moneda = tomManager.getInstance('vi-fac-moneda');
            moneda.setValue("PESOS", false);
            const cfdii = tomManager.getInstance('vi-fac-uso-cfdi');
            cfdii.setValue("CP01", false);
        });
    </script>

}

