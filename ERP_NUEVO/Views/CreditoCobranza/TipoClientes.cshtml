@{
    ViewBag.Title = "Tipo de Clientes";
    ViewBag.PageTitle = "Tipo de Clientes";
}
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<script>window.document.title = 'Tipo de Clientes'</script>
<div class="container-fluid py-4">
    <div class="contenedor-tabla">
            <div class="card-body">
                <div class="row">
                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="button" class="btn btn-outline-primary mb-3 blue-500" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms" id="btnAdd" onclick="addTypeClient()">
                            <i class="fa-duotone fa-solid fa-plus"></i> Nuevo Tipo de Cliente
                        </button>
                    </div>
                </div>

                <div class="table-responsive-sm">
                    <table id="typeclientsTable" class="modern-table" style="width:100%">
                        <thead class="bg-secondary">
                            <tr>
                                <th>Clave</th>
                                <th>Descripción</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
        </div>
    </div>
</div>
<!-- Modal para agregar/editar -->
<div class="modal fade animate__animated animate__bounceIn" id="typeclientModal" tabindex="-1" aria-labelledby="typeclientModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="typeclientModalLabel">Registrar Nuevo Tipo de Cliente</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="typeclientForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-key trailing"></i>
                        <input type="number" id="clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                        <label class="form-label" for="clave">Ingresar clave</label>
                    </div>
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                        <input type="text" id="descripcion" class="form-control form-icon-trailing" name="descripcion" />
                        <label class="form-label" for="descripcion">Ingresar descripción</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-mdb-ripple-init data-mdb-ripple-color="danger" data-mdb-ripple-duration="1000ms" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-outline-success" data-mdb-ripple-init data-mdb-ripple-color="success" data-mdb-ripple-duration="1000ms" onclick="sendForm()">
                        <i class="fa-duotone fa-solid fa-floppy-disk fa-beat"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script src="~/Scripts/Credito_Cobranza/typeclients.js"></script>
}
