    <div class="predial-form-actions">
        <div class="d-flex gap-2 d-none">
            <div class="predial-file-wrapper">
                <input type="file" id="loadPredialXML" accept=".xml" class="predial-file-input">
                <button type="button" id="btnLoadPredialXML" class="btn predial-btn-file">
                    <i class="fas fa-upload"></i>
                    Cargar XML Predial
                </button>
            </div>
        </div>
        <div class="d-flex gap-2">
            <button type="button" id="btnSavePredial" class="btn predial-btn-secondary d-none">
                <i class="fas fa-save"></i>
                Guardar XML
            </button>
            <button type="button" id="btnGeneratePredial" class="btn predial-btn-success">
                <i class="fas fa-file-invoice-dollar"></i>
                Generar Factura Predial
