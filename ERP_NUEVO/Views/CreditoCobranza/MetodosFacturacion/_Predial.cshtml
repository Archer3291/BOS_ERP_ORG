@using BOS_ERP.Models;
@using System;
@using System.Collections.Generic;
@using System.Collections.Specialized;
@using System.Configuration;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;
@using System.Linq;
@using System.Net;
@using System.Net.Mail;
@using System.Threading.Tasks;
@using Microsoft.AspNetCore.Mvc;
@using System.Windows;
@using BOS_ERP.Controllers
@using Microsoft.AspNetCore.Http;
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
<style>
    /* Label estático para campos con TomSelect */
    .predial-label--static {
        position: static !important;
        display: block;
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--predial-primary, #2d6a4f);
        margin-bottom: 4px;
        padding-left: 2rem; /* alinea con el icono */
        transform: none !important;
        pointer-events: auto;
    }

    /* Asegura que el contenedor con TomSelect no apile mal */
    .predial-input-group:has(.predial-tom-select) {
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
    }

        /* El ícono queda alineado con el label, no flotando sobre el select */
        .predial-input-group:has(.predial-tom-select) .predial-icon {
            position: static;
            align-self: flex-start;
            margin-top: 0.2rem;
            margin-right: 0.4rem;
        }

    /* Ajuste del wrapper para ícono + label en línea */
    .predial-input-group:has(.predial-tom-select) {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
    }

        .predial-input-group:has(.predial-tom-select) .predial-label--static {
            flex: 1 1 100%;
            order: -1;
            padding-left: 0;
            margin-bottom: 6px;
        }

        .predial-input-group:has(.predial-tom-select) .predial-icon {
            order: 0;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            pointer-events: none;
            z-index: 10;
        }

        .predial-input-group:has(.predial-tom-select) .ts-wrapper {
            flex: 1 1 100%;
            order: 1;
        }
</style>
<!-- Formulario principal - Cuenta Predial -->
<form id="predialForm" class="predial-form active" data-form-type="impuesto-predial">
    @Html.AntiForgeryToken()
    <div class="predial-section">
        <h4 class="predial-section-title">
            <i class="fas fa-home"></i>
            Datos del Comprobante Predial
        </h4>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="predial-input-group">
                    <i class="fas fa-hashtag predial-icon"></i>
                    <input id="serie" name="Serie" class="predial-input" placeholder="Ingrese la serie" value="FAR">
                    <label class="predial-label">Serie</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="predial-input-group">
                    <i class="fas fa-barcode predial-icon"></i>
                    <input id="folio" name="Folio" class="predial-input" placeholder="Ingrese el folio" value="@Model.Folio">
                    <label class="predial-label">Folio</label>
                </div>
            </div>
            <div class="col-md-4">
                <div class="predial-input-group">
                    <i class="fas fa-dollar-sign predial-icon"></i>
                    <input id="moneda" name="Moneda" class="predial-input" placeholder="MXN" value="MXN" readonly>
                    <label class="predial-label">Moneda</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-map-marker-alt predial-icon"></i>
                    <input id="lugarExpedicion" name="LugarExpedicion" class="predial-input" placeholder="Código postal de expedición" value="78394" readonly>
                    <label class="predial-label">Lugar de Expedición (CP)</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-receipt predial-icon"></i>
                    <select id="usoCfdi" name="IdUsoCFDI" class="predial-select">
                        <option value="P01" selected>P01 - Por definir</option>
                        <option value="G01">G01 - Adquisición de mercancías</option>
                        <option value="G02">G02 - Devoluciones, descuentos o bonificaciones</option>
                        <option value="G03" selected>G03 - Gastos en general</option>
                    </select>
                    <label class="predial-label">Uso CFDI</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <label class="predial-label predial-label--static">Forma de Pago</label>
                    <select id="formaPago" class="predial-tom-select" placeholder="Selecciona forma de pago">
                    </select>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <label class="predial-label predial-label--static">Método de Pago</label>
                    <select id="metodoPago" class="predial-tom-select" placeholder="Selecciona método de pago">
                    </select>
                </div>
            </div>
        </div>
    </div>
    @{
      
    var perfil = Convert.ToBoolean(Utilities.GetSetting("perfil_factura"))
        ? HttpContextAccessor.HttpContext.Session.GetString("EmpresaFactura")
        : "pruebas";

        var emisoresSection = Configuration.GetSection($"Emisores:{perfil}");
        <div class="predial-section">
            <h4 class="predial-section-title">
                <i class="fas fa-university"></i>
                Datos del Emisor
            </h4>
            <div class="row g-4">
                <div class="col-md-4">
                    <div class="predial-input-group">
                        <i class="fas fa-id-card predial-icon"></i>
                        <input id="rfcEmisor" name="RfcEmisor" class="predial-input" placeholder="RFC del gobierno municipal" value="@emisoresSection["Rfc"]" readonly>
                        <label class="predial-label">RFC Gobierno Municipal</label>
                    </div>
                </div>
                <div class="col-md-5">
                    <div class="predial-input-group">
                        <i class="fas fa-building predial-icon"></i>
                        <input id="nombreEmisor" name="RsoEmisor" class="predial-input" placeholder="Nombre del municipio" value="@emisoresSection["RazonSocial"]" readonly>
                        <label class="predial-label">Nombre del Municipio</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="predial-input-group">
                        <i class="fas fa-clipboard predial-icon"></i>
                        <select id="regimenFiscal" name="Rege" class="predial-select" readonly>
                            <option value="601" selected>601 - General de Ley Personas Morales</option>
                            <option value="603">603 - Personas Morales con Fines no Lucrativos</option>
                        </select>
                        <label class="predial-label">Régimen Fiscal</label>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="predial-section">
        <h4 class="predial-section-title">
            <i class="fas fa-user"></i> Datos del Receptor
        </h4>

        <!-- Select de búsqueda de cliente -->
        <div class="row g-4 mb-3">
            <div class="col-12">
                <div class="client-search-container">
                    <i class="fas fa-search search-icon"></i>
                    <select id="documentSearch" class="form-select client-search-select">
                        <option value="0" disabled selected>Selecciona un cliente</option>
                    </select>
                    <label class="search-label">Buscar Cliente</label>
                    <i class="fas fa-spinner fa-spin loading-indicator" id="loadingIndicator"></i>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-id-card predial-icon"></i>
                    <input id="rfcReceptor" name="RfcCliente" class="predial-input" placeholder="RFC del propietario">
                    <label class="predial-label">RFC Propietario</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-user predial-icon"></i>
                    <input id="nombreReceptor" name="RsoCliente" class="predial-input" placeholder="Nombre del propietario">
                    <label class="predial-label">Nombre del Propietario</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-home predial-icon"></i>
                    <input id="domFiscalReceptor" name="CpR" class="predial-input" placeholder="CP del propietario">
                    <label class="predial-label">CP Propietario</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="predial-input-group">
                    <i class="fas fa-building predial-icon"></i>
                    <select id="regimenFiscalReceptor" name="RegimenFiscalReceptor" class="predial-select">
                        <option value="612">612 - Persona Física con Actividad Empresarial</option>
                        <option value="605">605 - Sueldos y Salarios e Ingresos Asimilados</option>
                        <option value="606">606 - Arrendamiento</option>
                        <option value="608">608 - Demás ingresos</option>
                        <option value="601" selected>601 - General de Ley Personas Morales</option>
                    </select>
                    <label class="predial-label">Régimen Fiscal</label>
                </div>
            </div>
        </div>
    </div>

    <div class="predial-section">
        <h4 class="predial-section-title">
            <i class="fas fa-calculator"></i>
            Conceptos de Impuesto Predial
        </h4>

        <div class="predial-table-section">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div>
                    <h6><i class="fas fa-home me-2"></i>Impuestos Prediales a Pagar</h6>
                    <small class="text-muted">Agregue los conceptos de impuesto predial del inmueble</small>
                </div>
                <div class="d-flex gap-2">
                    <button type="button" id="addPredialRow" class="btn predial-btn-primary">
                        <i class="fas fa-plus"></i>
                        Agregar Concepto Predial
                    </button>
                    <button type="button" id="clearPredialRows" class="btn predial-btn-secondary">
                        <i class="fas fa-trash" style="margin-left: 12px;"></i>
                        Limpiar Todo
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table id="predialTable" class="table table-sm align-middle mb-0 predial-table">
                    <thead class="predial-table-header">
                        <tr>
                            <th style="width:50px">#</th>
                            <th style="width:120px">Clave Prod/Serv</th>
                            <th style="width:100px">Clave Unidad</th>
                            <th>Descripción del Impuesto</th>
                            <th style="width: 100px">Cantidad</th>
                            <th style="width: 130px">Precio Unit.</th>
                            <th style="width: 130px">Importe</th>
