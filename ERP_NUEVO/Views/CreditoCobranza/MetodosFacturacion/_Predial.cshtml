        <div class="predial-totals-section">
            <div class="predial-totals-grid">
                <div class="d-flex align-items-center">
                    <i class="fas fa-calculator fa-3x text-success me-3"></i>
                    <div>
                        <h5 class="mb-1 text-success">Total Impuesto Predial</h5>
                        <p class="text-muted mb-0">Calculado automáticamente</p>
                    </div>
                </div>
                <div class="predial-totals-display">
                    <div class="predial-total-row">
                        <span><i class="fas fa-minus me-2"></i>Subtotal:</span>
                        <strong id="subtotalTxt">$0.00</strong>
                    </div>
                    <div class="predial-total-row">
                        <span><i class="fas fa-percentage me-2"></i>IVA (16%):</span>
                        <strong id="ivaTxt">$0.00</strong>
                    </div>
                    <div class="predial-total-row">
                        <span><i class="fas fa-equals me-2"></i>Total a Pagar:</span>
