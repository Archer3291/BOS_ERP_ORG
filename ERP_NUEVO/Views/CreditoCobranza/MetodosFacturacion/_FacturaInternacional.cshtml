<script>
        const vendedor = "@User.Identity.Name";
        const sucursal = @sucursal;
        const sucursalText = "@Utilities.GetSucursalName(User.Identity.Name)";
        const sucursalUsuario = @sucursal;
        let suc;
        let alm;

    let paymentStates2Factura = ['contado', 'credito', 'anticipo'];
    let currentStateIndex2Factura = 0;

    function toggleCreditoContadoFactura() {
        const toggle = document.getElementById('vin-fac-toggle-pago');
        const tipoEmoji = document.getElementById('vin-fac-tipo-emoji');
        const camposCredito = document.getElementById('vin-fac-campos-credito');
        const camposAnticipo = document.getElementById('vin-fac-campos-anticipo');
        const seccionProductos = document.getElementById('vin-fac-seccion-productos');
        const fleteval = document.getElementById('vin-fac-flete-val');
        const tAnticipo = document.getElementById('tabla-anticipo');
        const btnAnticipo = document.getElementById('btn-anticipos');
        const totalAnticipo = document.getElementById('total-anticipo');

        // Avanzar al siguiente estado
        currentStateIndex2Factura = (currentStateIndex2Factura + 1) % paymentStates2Factura.length;
        const newState = paymentStates2Factura[currentStateIndex2Factura];

        // Actualizar el toggle
        toggle.setAttribute('data-state', newState);

        // Ocultar todos los campos
        camposCredito.style.display = 'none';
        camposAnticipo.style.display = 'none';

        // Mostrar campos según el estado
        if (newState === 'contado') {
            limpiarCamposFactura();
            seccionProductos.style.display = '';
            tAnticipo.style.display = '';
            btnAnticipo.style.display = '';
            totalAnticipo.style.display = '';
        } else if (newState === 'credito') {
            camposCredito.style.display = 'block';
            tAnticipo.style.display = 'none';
            btnAnticipo.style.display = 'none';
            totalAnticipo.style.display = 'none';
            limpiarCamposAnticipoFactura();
            seccionProductos.style.display = '';
        } else if (newState === 'anticipo') {
            camposAnticipo.style.display = 'block';
            limpiarCamposCreditoFactura();
            seccionProductos.style.display = 'none';
            tAnticipo.style.display = 'none';
            btnAnticipo.style.display = 'none';
            totalAnticipo.style.display = 'none';
            fleteval.value = 0;
        }
    }

    function limpiarCamposFactura() {
        limpiarCamposCreditoFactura();
        limpiarCamposAnticipoFactura();
    }

    function limpiarCamposCreditoFactura() {
        document.getElementById('vin-fac-limite-credito').value = '0.00';
        document.getElementById('vin-fac-plazo').value = '';
        document.getElementById('vin-fac-fecha-pago').value = '';
    }

    function limpiarCamposAnticipoFactura() {
        document.getElementById('vin-fac-porcentaje-anticipo').value = '';
        document.getElementById('vin-fac-monto-anticipo').value = '';
        document.getElementById('vin-fac-saldo-pendiente').value = '';
        document.getElementById('vin-fac-fecha-anticipo').value = '';
        document.getElementById('vin-fac-fecha-pago-final').value = '';
    }

    function calcularAnticipoFactura() {
        const porcentaje = parseFloat(document.getElementById('vin-fac-porcentaje-anticipo').value) || 0;
        // Obtener el total desde tu campo de importe total
        const totalVenta = parseFloat(document.getElementById('vin-fac-importe').value) || 0;

        const montoAnticipo = (totalVenta * porcentaje) / 100;
        const saldoPendiente = totalVenta - montoAnticipo;

        document.getElementById('vin-fac-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vin-fac-saldo-pendiente').value = saldoPendiente.toFixed(2);
    }
</script>
<script>
    function actualizarVistaPreviaFactura() {
        console.log('Modal abierto - actualizando vista previa...');

        // === Helpers ===
        const getValue = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            return (el?.value ?? '').toString().trim() || defaultVal;
        };

        const getSelectedText = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            const selected = el?.options?.[el.selectedIndex];
            return selected?.text?.trim() || defaultVal;
        };

        const setText = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        };

        const getDisplayValue = (id, defaultVal = '$0.00') => {
            const el = document.getElementById(id);
            return el?.textContent?.trim() || defaultVal;
        };

        // === TomSelect helper ===
        const getTomValueText = (key) => {
            const inst = tomManager.getInstance(key);
            const val = inst?.getValue();
            return inst?.getItem(val)?.textContent?.trim() || '';
        };

        const textVendedor = getTomValueText('vin-fac-vendedor');
        const textMoneda = getTomValueText('vin-fac-moneda');
        const textIncoterm = getTomValueText('vin-fac-incoterm');
        const textCFDI = getTomValueText('vin-fac-uso-cfdi');
        const textForma = getTomValueText('vin-fac-forma-pago');

        // === Info general y cliente ===
        setText('vin-fac-preview-folio', getValue('vin-fac-folio', 'Sin asignar'));
        setText('vin-fac-preview-sucursal', getSelectedText('vin-fac-sucursal', 'CEDIS'));
        const hoy = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' });
        setText('vin-fac-preview-fecha', hoy);

        setText('vin-fac-preview-cliente', getValue('vin-fac-cliente'));
        setText('vin-fac-preview-rfc', getValue('vin-fac-rfc'));
        setText('vin-fac-preview-vendedor', textVendedor);
        setText('vin-fac-preview-moneda', textMoneda);
        setText('vin-fac-preview-incoterm', textIncoterm);
        setText('vin-fac-preview-concepto', getValue('vin-fac-concepto'));

        // === Productos: helpers que permiten re-render seguro ===
        const productosTable = document.getElementById('vin-fac-productosTable');
        // seccionProductos: contenedor general donde están la tabla/tbody de preview y la vista de anticipo
        const previewProductos = document.getElementById('vin-fac-preview-productos');

        // Buscar o crear un contenedor para el mensaje de anticipo (no sobrescribe el DOM principal)
        const seccionProductos = previewProductos ? previewProductos.closest('div') : document.getElementById('vin-fac-preview-productos-container') || null;
        let anticipoDiv = seccionProductos ? seccionProductos.querySelector('.vin-fac-anticipo-info') : null;

        if (seccionProductos && !anticipoDiv) {
            // crear anticipoDiv (inserta al principio del contenedor, oculto por defecto)
            anticipoDiv = document.createElement('div');
            anticipoDiv.className = 'vin-fac-anticipo-info';
            anticipoDiv.style.display = 'none';
            seccionProductos.insertBefore(anticipoDiv, seccionProductos.firstChild);
        }

        // función que renderiza la tabla/tbody de productos desde productosTable
        function renderProductosPreview() {
            // Asegurarnos de que exista previewProductos; si no existe, intentar crearlo (tbody dentro de una tabla)
            let preview = document.getElementById('vin-fac-preview-productos');
            if (!preview && seccionProductos) {
                // crear una tabla simple con tbody#vin-fac-preview-productos
                const table = document.createElement('table');
                table.className = 'table table-sm';
                table.style.width = '100%';
                const thead = document.createElement('thead');
                thead.innerHTML = `<tr>
                <th>Clave</th><th>Descripción</th><th>Cant.</th><th>UM</th><th>Precio</th><th>% Desc</th><th>Importe</th>
            </tr>`;
                table.appendChild(thead);
                const tbody = document.createElement('tbody');
                tbody.id = 'vin-fac-preview-productos';
                table.appendChild(tbody);
                seccionProductos.appendChild(table);
                preview = tbody;
            }

            if (!preview) return; // no hay donde renderizar

            // Vaciar y volver a generar
            preview.innerHTML = '';

            if (!productosTable) {
                preview.innerHTML = `
                <tr>
                    <td colspan="7" style="padding:2rem; text-align:center; color:#999; border:1px solid #ddd">
                        No hay productos agregados
                    </td>
                </tr>`;
                return;
            }

            const rows = Array.from(productosTable.querySelectorAll('tr')).filter(r => !r.classList.contains('vin-fac-empty-state'));
            if (rows.length === 0) {
                preview.innerHTML = `
                <tr>
                    <td colspan="7" style="padding:2rem; text-align:center; color:#999; border:1px solid #ddd">
                        No hay productos agregados
                    </td>
                </tr>`;
                return;
            }

            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                if (cols.length >= 8) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td style="padding:.5rem; border:1px solid #ddd;">${cols[0]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; border:1px solid #ddd;">${cols[1]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; text-align:center; border:1px solid #ddd;">${cols[3]?.querySelector('input')?.value || '0'}</td>
                    <td style="padding:.5rem; text-align:center; border:1px solid #ddd;">${cols[4]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">$${cols[5]?.querySelector('input')?.value || '0.00'}</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">${cols[6]?.querySelector('input')?.value || '0'}%</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">${cols[7]?.textContent?.trim() || '$0.00'}</td>
                `;
                    preview.appendChild(tr);
                }
            });
        }

        // === Totales ===
        setText('vin-fac-preview-subtotal1', getDisplayValue('vin-fac-total-subtotal1-display'));
        setText('vin-fac-preview-descuento', getDisplayValue('vin-fac-total-descuento-display'));
        setText('vin-fac-preview-flete', getDisplayValue('vin-fac-total-flete-display'));
        setText('vin-fac-preview-subtotal2', getDisplayValue('vin-fac-total-subtotal2-display'));
        setText('vin-fac-preview-iva', getDisplayValue('vin-fac-iva-display'));
        setText('vin-fac-preview-total', getDisplayValue('vin-fac-importe-display'));

        // === Condiciones de pago ===
        setText('vin-fac-preview-forma-pago', textForma);
        setText('vin-fac-preview-metodo-pago', getSelectedText('vin-fac-metodo-pago'));
        setText('vin-fac-preview-plazo', getValue('vin-fac-plazo'));
        setText('vin-fac-preview-fecha-pago', getValue('vin-fac-fecha-pago'));
        setText('vin-fac-preview-uso-cfdi', textCFDI);

        // === Comentarios ===
        const comentarios = getValue('vin-fac-comentarios', '');
        const comentariosSection = document.getElementById('vin-fac-preview-comentarios-section');
        const comentariosText = document.getElementById('vin-fac-preview-comentarios');
        if (comentarios && comentariosSection && comentariosText) {
            comentariosSection.style.display = 'block';
            comentariosText.textContent = comentarios;
        } else if (comentariosSection) {
            comentariosSection.style.display = 'none';
        }

        // === Tipo de factura y comportamiento ===
        const tipoFactura = document.getElementById('vin-fac-toggle-pago')?.getAttribute('data-state') || 'contado';

        const campoPlazo = document.querySelector('#vin-fac-preview-plazo')?.parentElement || null;
        const campoFechaPago = document.querySelector('#vin-fac-preview-fecha-pago')?.parentElement || null;
        const campoFormaPago = document.querySelector('#vin-fac-preview-forma-pago')?.parentElement || null;

        // Mostrar todo por defecto
        [campoPlazo, campoFechaPago, campoFormaPago].forEach(c => { if (c) c.style.display = ''; });
        if (seccionProductos) seccionProductos.style.display = '';

        // ocultar anticipo div por defecto y luego lo mostraremos sólo si aplica
        if (anticipoDiv) anticipoDiv.style.display = 'none';

        if (tipoFactura === 'contado') {
            if (campoPlazo) campoPlazo.style.display = 'none';
            if (campoFechaPago) campoFechaPago.style.display = 'none';
            // mostrar productos
            if (seccionProductos) {
                // asegurarse de que la tabla de productos esté visible y actualizada
                renderProductosPreview();
                if (previewProductos) previewProductos.style.display = '';
            }
        } else if (tipoFactura === 'anticipo') {
            // ocultar campos de plazo/fecha
            if (campoPlazo) campoPlazo.style.display = 'none';
            if (campoFechaPago) campoFechaPago.style.display = 'none';

            // mostrar mensaje de anticipo y ocultar la tabla de productos
            const montoAnt = parseFloat(getValue('vin-fac-monto-anticipo') || 0);
            if (anticipoDiv && seccionProductos) {
                anticipoDiv.innerHTML = `
                <div class="text-center my-4 p-4 border rounded shadow-sm bg-light">
                    <h5 class="fw-bold text-success mb-2">💰 Anticipo registrado</h5>
                    <p class="fs-5 mb-0" style="color:black">
                        Monto del anticipo: <strong>$${montoAnt.toLocaleString('es-MX', { minimumFractionDigits: 2 })} MXN</strong>
                    </p>
                </div>
            `;
                anticipoDiv.style.display = '';
            }
            // ocultar la tabla de productos si existe
            if (previewProductos) previewProductos.style.display = 'none';
        } else {
            // otro tipo: mostrar productos de nuevo
            renderProductosPreview();
            if (previewProductos) previewProductos.style.display = '';
        }

        console.log('Vista previa actualizada correctamente para tipo:', tipoFactura);
    }

</script>
<script>
    const chkFleteFactura = document.getElementById("vin-fac-flete");
    const inputFleteFactura = document.getElementById("vin-fac-flete-val");
    chkFleteFactura.addEventListener("change", () => {
        if (chkFleteFactura.checked) {
            inputFleteFactura.classList.remove("d-none"); // mostrar
        } else {
