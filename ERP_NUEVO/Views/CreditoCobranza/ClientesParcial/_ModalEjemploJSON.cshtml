@*
    Modal de ayuda con un template JSON de ejemplo para addendas.
    El ejemplo se define una sola vez en JS y desde ahí se pinta el
    <pre> y se copia al textarea, para que nunca se desincronicen.
*@
<div class="modal fade cli-modal" id="modalEjemploJSON" tabindex="-1" aria-labelledby="modalEjemploJSONLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cli-icon">
                    <i class="fa-solid fa-code"></i>
                </div>
                <div>
                    <h5 class="modal-title" id="modalEjemploJSONLabel">Ejemplo de template JSON</h5>
                    <span class="modal-subtitle">Estructura de referencia para una addenda típica.</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <pre class="cli-code"><code id="ejemploJsonAddenda"></code></pre>

                <div class="cli-note mt-3 mx-0">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>
                        Puedes personalizar la estructura según lo que pida cada cliente.
                        Los valores se rellenan automáticamente al generar las facturas.
                    </span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="cli-btn cli-btn-ghost" data-bs-dismiss="modal">
                    Cerrar
                </button>
                <button type="button" class="cli-btn cli-btn-primary" onclick="copiarEjemploJSON()">
                    <i class="fa-solid fa-copy"></i>Copiar al template
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        let _modal = null;

        /* ── Única fuente de verdad del ejemplo ───────────────────── */
        const EJEMPLO = {
            "entrega": {
                "calle": "AV. INDUSTRIA 456",
                "noExterior": "45",
                "noInterior": "B",
                "colonia": "INDUSTRIAL",
                "codigoPostal": "01234",
                "municipio": "CIUDAD",
                "estado": "ESTADO",
                "pais": "México",
                "plantaEntrega": "PLANTA01"
            },
            "proveedor": {
                "codigo": "PROV123456",
                "nombre": "Mi Empresa SA de CV"
            },
            "pedido": {
                "numeroOrden": "PO-12345",
                "fechaOrden": "2026-01-27",
                "almacen": "ALM-001"
            },
            "tipoDocumento": "FACTURA",
            "observaciones": "Entrega en horario matutino"
        };

        window.mostrarEjemploJSON = function () {
            _modal.show();
        };

        window.copiarEjemploJSON = function () {
            document.getElementById('addenda_template').value = JSON.stringify(EJEMPLO, null, 2);
            _modal.hide();

            toastMixin.fire({
                icon: 'success',
                title: 'Ejemplo copiado al template'
            });
        };

        document.addEventListener('DOMContentLoaded', () => {
            _modal = new bootstrap.Modal(document.getElementById('modalEjemploJSON'));
            document.getElementById('ejemploJsonAddenda').textContent = JSON.stringify(EJEMPLO, null, 2);
        });
    })();
</script>
