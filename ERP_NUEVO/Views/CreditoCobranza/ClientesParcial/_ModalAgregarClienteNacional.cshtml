@*
    Modal de ALTA de cliente nacional.
    Sólo captura los datos mínimos; el resto (facturación, contacto,
    addendas) se completa después desde el modal de edición.
*@
<div class="modal fade cli-modal" id="modalAgregarClienteNacional" tabindex="-1" aria-labelledby="modalAgregarClienteNacionalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cli-icon">
                    <i class="fa-solid fa-flag"></i>
                </div>
                <div>
                    <h5 class="modal-title" id="modalAgregarClienteNacionalLabel">Nuevo cliente nacional</h5>
                    <span class="modal-subtitle">Los datos fiscales y de contacto se completan después, desde la edición.</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAgregarClienteNacional" autocomplete="off">

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Identificación</legend>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="nacional_cve_cli" class="form-label required">Código Cliente</label>
                                <input type="text" class="form-control" id="nacional_cve_cli" name="cve_cli" required readonly>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label for="nacional_n_cli" class="form-label required">Nombre</label>
                                <input type="text" class="form-control" id="nacional_n_cli" name="n_cli" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-0">
                                <label for="nacional_rfc" class="form-label required">RFC</label>
                                <input type="text" class="form-control" id="nacional_rfc" name="rfc" maxlength="13" required>
                            </div>
                            <div class="col-md-6 mb-0">
                                <label for="nacional_curp_cli" class="form-label required">CURP</label>
                                <input type="text" class="form-control" id="nacional_curp_cli" name="curp_cli" maxlength="18" required>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Dirección</legend>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="nacional_est" class="form-label required">Estado</label>
                                <input type="text" class="form-control" id="nacional_est" name="estado" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="nacional_mun" class="form-label required">Municipio</label>
                                <input type="text" class="form-control" id="nacional_mun" name="municipio" autocomplete="off" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="nacional_cp" class="form-label required">Código Postal</label>
                                <input type="text" class="form-control" id="nacional_cp" name="cp" maxlength="10" required autocomplete="off">
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="nacional_col" class="form-label required">Colonia</label>
                                <input type="text" class="form-control" id="nacional_col" name="colonia" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-0">
                                <label for="nacional_dir" class="form-label required">Dirección</label>
                                <input type="text" class="form-control" id="nacional_dir" name="dir" required>
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="nacional_num_int" class="form-label">Número Interior</label>
                                <input type="number" class="form-control" id="nacional_num_int" name="numero_int">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="nacional_num_ext" class="form-label required">Número Exterior</label>
                                <input type="number" class="form-control" id="nacional_num_ext" name="numero_ext" required>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Asignaciones</legend>

                        <div class="row">
                            <div class="col-md-3 mb-0">
                                <label for="nacional_cve_vdr" class="form-label">Vendedor</label>
                                <input type="text" class="form-control" id="nacional_cve_vdr" name="cve_vdr">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="nacional_cve_gpo" class="form-label">Grupo</label>
                                <input type="text" class="form-control" id="nacional_cve_gpo" name="cve_gpo">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="nacional_lim_crd" class="form-label">Límite de Crédito</label>
                                <input type="number" class="form-control" id="nacional_lim_crd" name="lim_crd" step="0.01" value="0">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="nacional_pl_dias" class="form-label">Plazo de días</label>
                                <input type="number" class="form-control" id="nacional_pl_dias" name="pl_dias" step="0.01" value="0">
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="cli-btn cli-btn-ghost" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>Cancelar
                </button>
                <button type="button" class="cli-btn cli-btn-success" onclick="guardarClienteNacional()">
                    <i class="fa-solid fa-floppy-disk"></i>Guardar cliente
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        /* ── Deja el formulario y sus Tom Select en blanco ─────────── */
        window.limpiarModalNacional = function () {
            ClientesState.limpiarSelectsDeModal('#modalAgregarClienteNacional');
            ClientesState.destruirManager(ClientesState.tom.crearNacional);
            document.getElementById('formAgregarClienteNacional').reset();
        };

        /* ── Abre el modal ya inicializado ────────────────────────── */
        window.abrirModalNacional = async function () {
            limpiarModalNacional();

            ClientesState.tom.crearNacional = new TomSelectManager();
            const manager = ClientesState.tom.crearNacional;

            // Consecutivo sugerido para el nuevo cliente
            const nvo_cve = await GetData({ path: '/Clientes/GetSiguienteCodigo' });
            document.getElementById('nacional_cve_cli').value = nvo_cve;

            await cargarDireccion(direccionConfigNacional, null, "create", "estado", null, { instanceName: manager });
            await cargarDireccion(direccionConfigNacional, null, "create", "vendedores", null, { instanceName: manager });

            new bootstrap.Modal(document.getElementById('modalAgregarClienteNacional')).show();
        };

        /* ── Valida con las reglas del propio <form> y envía ───────── */
        window.guardarClienteNacional = function () {
            const form = document.getElementById('formAgregarClienteNacional');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const data = {};
            new FormData(form).forEach((value, key) => { data[key] = value; });
            data.es_internacional = false;

            GetData({
                path: '/Clientes/CrearCliente',
                data: data,
                swalResponse: true,
                swalPath: '/CreditoCobranza/Clientes',
                swalType: 'modal'
            });
        };

        document.addEventListener('DOMContentLoaded', () => {
            document
                .getElementById('modalAgregarClienteNacional')
                .addEventListener('hidden.bs.modal', limpiarModalNacional);
        });
    })();
</script>
