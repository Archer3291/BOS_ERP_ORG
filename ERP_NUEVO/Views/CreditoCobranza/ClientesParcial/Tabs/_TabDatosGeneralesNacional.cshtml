@*
    Pestaña Datos Generales del cliente NACIONAL:
    identificación, dirección (cascada estado → municipio → cp → colonia)
    y asignaciones (vendedor, grupo, crédito).
*@
<div class="tab-pane fade show active" id="datos-generales-nacional" role="tabpanel">
    <form id="formEditarClienteNacional" autocomplete="off">
        <input type="hidden" id="edit_id_cliente_nacional" name="id_cliente">

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Identificación</legend>

            <div class="row">
                <div class="col-md-2 mb-3">
                    <label for="edit_cve_cli_nacional" class="form-label required">Código Cliente</label>
                    <input type="text" class="form-control" id="edit_cve_cli_nacional" name="cve_cli" required readonly>
                </div>
                <div class="col-md-6 mb-3">
                    <label for="edit_n_cli_nacional" class="form-label required">Nombre</label>
                    <input type="text" class="form-control" id="edit_n_cli_nacional" name="n_cli" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="edit_clasificacion_nacional" class="form-label">Clasificación</label>
                    <select id="edit_clasificacion_nacional" name="clasificacion" class="form-select">
                        <option value="">-- Sin clasificación --</option>
                        <option value="bueno">Bueno</option>
                        <option value="regular">Regular</option>
                        <option value="malo">Malo</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="edit_rfc_nacional" class="form-label required">RFC</label>
                    <input type="text" class="form-control" id="edit_rfc_nacional" name="rfc" maxlength="13">
                </div>
                <div class="col-md-4 mb-3">
                    <label for="edit_curp_cli_nacional" class="form-label required">CURP</label>
                    <input type="text" class="form-control" id="edit_curp_cli_nacional" name="curp_cli" maxlength="18">
                </div>
                <div class="col-md-4 mb-0">
                    <label for="edit_estatus_nacional" class="form-label">Estatus</label>
                    <select id="edit_estatus_nacional" name="estatus_cliente" class="form-select">
                        <option value="activo">Activo</option>
                        <option value="inactivo">Inactivo</option>
                        <option value="suspendido">Suspendido</option>
                    </select>
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Dirección registrada</legend>
            <div id="detalles_direccion_nacional"></div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Editar dirección</legend>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="edit_cve_est_nacional" class="form-label required">Estado</label>
                    <select id="edit_cve_est_nacional" name="estado" class="form-control" required></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_mpio_nacional" class="form-label required">Municipio</label>
                    <select id="edit_mpio_nacional" name="municipio" class="form-control" required></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_cp_nacional" class="form-label required">Código Postal</label>
                    <select id="edit_cp_nacional" name="cp" class="form-control" required></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_col_nacional" class="form-label required">Colonia</label>
                    <select id="edit_col_nacional" name="colonia" class="form-control" required></select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-0">
                    <label for="edit_dir_nacional" class="form-label required">Dirección</label>
                    <input type="text" class="form-control" id="edit_dir_nacional" name="dir" required>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_num_int_nacional" class="form-label">Número Interior</label>
                    <input type="number" class="form-control" id="edit_num_int_nacional" name="numero_int">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_num_ext_nacional" class="form-label required">Número Exterior</label>
                    <input type="number" class="form-control" id="edit_num_ext_nacional" name="numero_ext" required>
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Asignaciones</legend>

            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="edit_cve_vdr_nacional" class="form-label">Vendedor</label>
                    <select id="edit_cve_vdr_nacional" name="cve_vdr" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_cve_gpo_nacional" class="form-label">Grupo</label>
                    <input type="text" class="form-control" id="edit_cve_gpo_nacional" name="cve_gpo">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_lim_crd_datos_nacional" class="form-label">Límite de Crédito</label>
                    <input type="number" class="form-control" id="edit_lim_crd_datos_nacional" name="lim_crd" step="0.01" value="0">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_pl_dias_nacional" class="form-label">Plazo de días</label>
                    <input type="number" class="form-control" id="edit_pl_dias_nacional" name="pl_dias" step="0.01" value="0">
                </div>
            </div>
        </fieldset>
    </form>
</div>
