@*
    Pestaña Datos de Facturación del cliente NACIONAL:
    régimen fiscal, uso CFDI, forma de pago y dirección fiscal.
*@
<div class="tab-pane fade" id="facturacion-nacional" role="tabpanel">
    <form id="formFacturacionNacional" autocomplete="off">

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Información fiscal</legend>

            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="fact_raz_soc_nacional" class="form-label required">Razón social</label>
                    <input type="text" id="fact_raz_soc_nacional" name="fact_razon" class="form-control">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_reg_soc_nacional" class="form-label required">Régimen fiscal</label>
                    <select id="fact_reg_soc_nacional" name="fact_regimen" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_uso_sug_nacional" class="form-label required">Uso sugerido</label>
                    <select id="fact_uso_sug_nacional" name="fact_sugerido" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_forma_pago_nacional" class="form-label required">Forma de pago</label>
                    <select id="fact_forma_pago_nacional" name="fact_forma" class="form-control"></select>
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Dirección de facturación</legend>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="fact_cve_est_nacional" class="form-label required">Estado</label>
                    <select id="fact_cve_est_nacional" name="fact_estado" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_mpio_nacional" class="form-label required">Municipio</label>
                    <select id="fact_mpio_nacional" name="fact_municipio" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_cp_nacional" class="form-label required">Código Postal</label>
                    <select id="fact_cp_nacional" name="fact_cp" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_col_nacional" class="form-label required">Colonia</label>
                    <select id="fact_col_nacional" name="fact_colonia" class="form-control"></select>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-0">
                    <label for="fact_dir_nacional" class="form-label required">Dirección</label>
                    <input type="text" class="form-control" id="fact_dir_nacional" name="fact_dir">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_num_int_nacional" class="form-label">Número Interior</label>
                    <input type="text" class="form-control" id="fact_num_int_nacional" name="fact_numero_int">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_num_ext_nacional" class="form-label required">Número Exterior</label>
                    <input type="text" class="form-control" id="fact_num_ext_nacional" name="fact_numero_ext" required>
                </div>
            </div>
        </fieldset>
    </form>
</div>
