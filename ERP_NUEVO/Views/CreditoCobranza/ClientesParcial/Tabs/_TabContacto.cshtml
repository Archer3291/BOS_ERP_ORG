@*
    Pestaña Contacto: correos y teléfonos del cliente.
    Reutilizada por el modal de edición nacional y el internacional.
    @model  "Nacional" | "Internacional"
*@
@model string
@{
    var tipo = Model;
    var sufijo = tipo.ToLower();
}

<div class="tab-pane fade" id="contacto-@sufijo" role="tabpanel">

    <fieldset class="cli-fieldset">
        <legend class="cli-legend">
            Correos electrónicos
            <button type="button" class="cli-btn cli-btn-soft cli-btn-sm cli-legend-action" onclick="agregarCorreo('@tipo')">
                <i class="fa-solid fa-plus"></i> Agregar
            </button>
        </legend>
        @* Los paréntesis son obligatorios: sin ellos Razor lee
           "Correos@tipo" como una dirección de correo y lo emite literal. *@
        <ul class="cli-list" id="listaCorreos@(tipo)"></ul>
    </fieldset>

    <fieldset class="cli-fieldset">
        <legend class="cli-legend">
            Teléfonos
            <button type="button" class="cli-btn cli-btn-soft cli-btn-sm cli-legend-action" onclick="agregarTelefono('@tipo')">
                <i class="fa-solid fa-plus"></i> Agregar
            </button>
        </legend>
        <ul class="cli-list" id="listaTelefonos@(tipo)"></ul>
    </fieldset>
</div>
