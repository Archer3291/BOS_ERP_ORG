@*
    Pestaña Datos Generales del cliente INTERNACIONAL:
    identificación fiscal (Tax ID / VAT / incoterm), dirección
    (cascada país → estado → ciudad) y asignaciones.
*@
<div class="tab-pane fade show active" id="datos-generales-internacional" role="tabpanel">
    <form id="formEditarClienteInternacional" autocomplete="off">
        <input type="hidden" id="edit_id_cliente_internacional" name="id_cliente">

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Identificación</legend>

            <div class="row">
                <div class="col-md-2 mb-3">
                    <label for="edit_cve_cli_internacional" class="form-label required">Código Cliente</label>
                    <input type="text" class="form-control" id="edit_cve_cli_internacional" name="cve_cli" required readonly>
                </div>
                <div class="col-md-4 mb-3">
                    <label for="edit_n_cli_internacional" class="form-label required">Nombre</label>
                    <input type="text" class="form-control" id="edit_n_cli_internacional" name="n_cli" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_clasificacion_internacional" class="form-label">Clasificación</label>
                    <select id="edit_clasificacion_internacional" name="clasificacion" class="form-select">
                        <option value="">-- Sin clasificación --</option>
                        <option value="bueno">Bueno</option>
                        <option value="regular">Regular</option>
                        <option value="malo">Malo</option>
                    </select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_estatus_internacional" class="form-label">Estatus</label>
                    <select id="edit_estatus_internacional" name="estatus_cliente" class="form-select">
                        <option value="activo">Activo</option>
                        <option value="inactivo">Inactivo</option>
                        <option value="suspendido">Suspendido</option>
                    </select>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-0">
                    <label for="edit_tax_id_internacional" class="form-label">Tax ID / Número Fiscal</label>
                    <input type="text" class="form-control" id="edit_tax_id_internacional" name="tax_id">
                </div>
                <div class="col-md-4 mb-0">
                    <label for="edit_vat_internacional" class="form-label">RFC</label>
                    <input type="text" class="form-control" id="edit_vat_internacional" name="vat">
                </div>
                <div class="col-md-4 mb-0">
                    <label for="edit_incot_internacional" class="form-label">Incoterm</label>
                    <input type="text" class="form-control" id="edit_incot_internacional" name="incot">
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Dirección registrada</legend>
            <div id="detalles_direccion_internacional"></div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Editar dirección</legend>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="edit_pais_internacional" class="form-label">País</label>
                    <select id="edit_pais_internacional" name="pais" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_estado_internacional" class="form-label">Estado/Provincia</label>
                    <select id="edit_estado_internacional" name="estado" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_municipio_internacional" class="form-label">Ciudad</label>
                    <select id="edit_municipio_internacional" name="municipio" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="edit_cp_internacional" class="form-label">Código Postal</label>
                    <input type="text" class="form-control" id="edit_cp_internacional" name="cp" maxlength="10">
                </div>
            </div>

            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="edit_col_internacional" class="form-label">Colonia</label>
                    <input type="text" class="form-control" id="edit_col_internacional" name="col">
                </div>
                <div class="col-md-5 mb-0">
                    <label for="edit_dir_internacional" class="form-label required">Dirección</label>
                    <input type="text" class="form-control" id="edit_dir_internacional" name="dir" required>
                </div>
                <div class="col-md-2 mb-0">
                    <label for="edit_num_int_internacional" class="form-label">Número Interior</label>
                    <input type="number" class="form-control" id="edit_num_int_internacional" name="numero_int">
                </div>
                <div class="col-md-2 mb-0">
                    <label for="edit_num_ext_internacional" class="form-label required">Número Exterior</label>
                    <input type="number" class="form-control" id="edit_num_ext_internacional" name="numero_ext" required>
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Asignaciones</legend>

            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="edit_cve_vdr_internacional" class="form-label">Vendedor</label>
                    <select id="edit_cve_vdr_internacional" name="cve_vdr" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_cve_gpo_internacional" class="form-label">Grupo</label>
                    <input type="text" class="form-control" id="edit_cve_gpo_internacional" name="cve_gpo">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_lim_crd_datos_internacional" class="form-label">Límite de Crédito</label>
                    <input type="number" class="form-control" id="edit_lim_crd_datos_internacional" name="lim_crd" step="0.01" value="0">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="edit_pl_dias_internacional" class="form-label">Plazo de días</label>
                    <input type="number" class="form-control" id="edit_pl_dias_internacional" name="pl_dias" step="0.01" value="0">
                </div>
            </div>
        </fieldset>
    </form>
</div>
