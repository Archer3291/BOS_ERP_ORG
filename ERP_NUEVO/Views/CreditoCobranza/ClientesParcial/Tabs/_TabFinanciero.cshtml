@*
    Pestaña Financiero: crédito, descuentos, cuentas bancarias y comentarios.
    Reutilizada por el modal de edición nacional y el internacional.
    @model  "Nacional" | "Internacional"
*@
@model string
@{
    var tipo = Model;
    var sufijo = tipo.ToLower();
}

<div class="tab-pane fade" id="financiero-@sufijo" role="tabpanel">
    @* Paréntesis obligatorios: "Financiero@tipo" se leería como correo *@
    <form id="formFinanciero@(tipo)" autocomplete="off">

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Crédito y descuentos</legend>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label for="edit_lim_crd_@sufijo" class="form-label">Límite de Crédito</label>
                    <input type="number" class="form-control" id="edit_lim_crd_@sufijo" name="lim_crd" step="0.01">
                </div>
                <div class="col-md-4 mb-3">
                    <label for="edit_pl_crd_@sufijo" class="form-label">Plazo Crédito (días)</label>
                    <input type="number" class="form-control" id="edit_pl_crd_@sufijo" name="pl_crd">
                </div>
                <div class="col-md-4 mb-3">
                    <label for="edit_com_por_@sufijo" class="form-label">Comisión %</label>
                    <input type="number" class="form-control" id="edit_com_por_@sufijo" name="com_por" step="0.01">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-0">
                    <label for="edit_dto_@sufijo" class="form-label">Descuento 1</label>
                    <input type="text" class="form-control" id="edit_dto_@sufijo" name="dto">
                </div>
                <div class="col-md-6 mb-0">
                    <label for="edit_dto2_@sufijo" class="form-label">Descuento 2</label>
                    <input type="text" class="form-control" id="edit_dto2_@sufijo" name="dto2">
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Cuentas bancarias</legend>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="edit_bco_cli1_@sufijo" class="form-label">Banco 1</label>
                    <input type="text" class="form-control" id="edit_bco_cli1_@sufijo" name="bco_cli1">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="edit_cta_bco_cli1_@sufijo" class="form-label">Cuenta 1</label>
                    <input type="text" class="form-control" id="edit_cta_bco_cli1_@sufijo" name="cta_bco_cli1">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="edit_bco_cli2_@sufijo" class="form-label">Banco 2</label>
                    <input type="text" class="form-control" id="edit_bco_cli2_@sufijo" name="bco_cli2">
                </div>
                <div class="col-md-6 mb-3">
                    <label for="edit_cta_bco_cli2_@sufijo" class="form-label">Cuenta 2</label>
                    <input type="text" class="form-control" id="edit_cta_bco_cli2_@sufijo" name="cta_bco_cli2">
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-0">
                    <label for="edit_bco_cli3_@sufijo" class="form-label">Banco 3</label>
                    <input type="text" class="form-control" id="edit_bco_cli3_@sufijo" name="bco_cli3">
                </div>
                <div class="col-md-6 mb-0">
                    <label for="edit_cta_bco_cli3_@sufijo" class="form-label">Cuenta 3</label>
                    <input type="text" class="form-control" id="edit_cta_bco_cli3_@sufijo" name="cta_bco_cli3">
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Comentarios</legend>

            <label for="edit_coment1_@sufijo" class="form-label">Comentario 1</label>
            <textarea class="form-control" id="edit_coment1_@sufijo" name="coment1" rows="3"
                      placeholder="Notas internas sobre el cliente (máx. 500 caracteres)"></textarea>
        </fieldset>
    </form>
</div>
