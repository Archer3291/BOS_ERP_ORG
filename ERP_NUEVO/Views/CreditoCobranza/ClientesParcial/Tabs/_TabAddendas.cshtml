@*
    Pestaña Addendas CFDI: listado de addendas configuradas del cliente.
    El CRUD vive en ClientesParcial/_ModalAddenda.cshtml.
*@
<div class="tab-pane fade" id="addendas-section" role="tabpanel">
    <fieldset class="cli-fieldset">
        <legend class="cli-legend">
            Addendas configuradas
            <button type="button" class="cli-btn cli-btn-soft cli-btn-sm cli-legend-action" onclick="abrirModalAgregarAddenda()">
                <i class="fa-solid fa-plus"></i> Nueva addenda
            </button>
        </legend>

        <div id="listaAddendas" class="row g-3">
            <!-- Las addendas se cargan aquí dinámicamente -->
        </div>

        <div id="sinAddendas" class="cli-empty" style="display: none;">
            <i class="fa-solid fa-file-code"></i>
            No hay addendas configuradas para este cliente.<br>
            Usa <strong>Nueva addenda</strong> para crear una.
        </div>
    </fieldset>
</div>
