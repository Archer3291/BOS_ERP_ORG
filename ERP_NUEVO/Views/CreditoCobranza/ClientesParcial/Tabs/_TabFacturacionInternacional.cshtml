@*
    Pestaña Datos de Facturación del cliente INTERNACIONAL:
    régimen fiscal, uso CFDI, forma de pago y dirección fiscal
    en el extranjero (país → estado → ciudad).
*@
<div class="tab-pane fade" id="facturacion-internacional" role="tabpanel">
    <form id="formFacturacionInternacional" autocomplete="off">

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Información fiscal</legend>

            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="fact_raz_soc_edit_int" class="form-label required">Razón social</label>
                    <input type="text" id="fact_raz_soc_edit_int" name="fact_razon_int" class="form-control">
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_reg_soc_edit_int" class="form-label required">Régimen fiscal</label>
                    <select id="fact_reg_soc_edit_int" name="fact_regimen_int" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_uso_sug_edit_int" class="form-label required">Uso sugerido</label>
                    <select id="fact_uso_sug_edit_int" name="fact_sugerido_int" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-0">
                    <label for="fact_forma_pago_edit_int" class="form-label required">Forma de pago</label>
                    <select id="fact_forma_pago_edit_int" name="fact_forma_int" class="form-control"></select>
                </div>
            </div>
        </fieldset>

        <fieldset class="cli-fieldset">
            <legend class="cli-legend">Dirección de facturación</legend>

            <div class="row">
                <div class="col-md-3 mb-3">
                    <label for="fact_pais_edit" class="form-label required">País</label>
                    <select id="fact_pais_edit" name="fact_pais" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_est_edit_int" class="form-label required">Estado/Provincia</label>
                    <select id="fact_est_edit_int" name="fact_estado" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_mpio_edit_int" class="form-label">Ciudad</label>
                    <select id="fact_mpio_edit_int" name="fact_municipio" class="form-control"></select>
                </div>
                <div class="col-md-3 mb-3">
                    <label for="fact_cp_edit_int" class="form-label required">Código Postal</label>
                    <input type="text" class="form-control" id="fact_cp_edit_int" name="fact_cp" maxlength="10">
                </div>
            </div>
            <div class="row">
                <div class="col-md-3 mb-0">
                    <label for="fact_col_edit_int" class="form-label">Colonia</label>
                    <input type="text" class="form-control" id="fact_col_edit_int" name="fact_colonia">
                </div>
                <div class="col-md-5 mb-0">
                    <label for="fact_dir_edit_int" class="form-label required">Dirección</label>
                    <input type="text" class="form-control" id="fact_dir_edit_int" name="fact_dir">
                </div>
                <div class="col-md-2 mb-0">
                    <label for="fact_num_int_edit_int" class="form-label">Número Interior</label>
                    <input type="text" class="form-control" id="fact_num_int_edit_int" name="fact_numero_int">
                </div>
                <div class="col-md-2 mb-0">
                    <label for="fact_num_ext_edit_int" class="form-label required">Número Exterior</label>
                    <input type="text" class="form-control" id="fact_num_ext_edit_int" name="fact_numero_ext" required>
                </div>
            </div>
        </fieldset>
    </form>
</div>
