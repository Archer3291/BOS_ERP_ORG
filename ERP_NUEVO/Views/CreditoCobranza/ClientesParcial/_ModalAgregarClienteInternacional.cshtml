@*
    Modal de ALTA de cliente internacional.
    El RFC queda fijo en el genérico de extranjeros (XEXX010101000);
    la identificación real es el Tax ID.
*@
<div class="modal fade cli-modal" id="modalAgregarClienteInternacional" tabindex="-1" aria-labelledby="modalAgregarClienteInternacionalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="cli-icon">
                    <i class="fa-solid fa-globe"></i>
                </div>
                <div>
                    <h5 class="modal-title" id="modalAgregarClienteInternacionalLabel">Nuevo cliente internacional</h5>
                    <span class="modal-subtitle">El RFC queda fijo en el genérico de extranjeros; la identificación real es el Tax ID.</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAgregarClienteInternacional" autocomplete="off">

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Identificación</legend>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label for="internacional_cve_cli" class="form-label required">Código Cliente</label>
                                <input type="text" class="form-control" id="internacional_cve_cli" name="cve_cli" required readonly>
                            </div>
                            <div class="col-md-8 mb-3">
                                <label for="internacional_n_cli" class="form-label required">Nombre</label>
                                <input type="text" class="form-control" id="internacional_n_cli" name="n_cli" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-0">
                                <label for="internacional_tax_id" class="form-label required">Tax ID / Número Fiscal</label>
                                <input type="text" class="form-control" id="internacional_tax_id" name="tax_id" required>
                            </div>
                            <div class="col-md-6 mb-0">
                                <label for="internacional_vat" class="form-label required">RFC</label>
                                <input type="text" class="form-control" id="internacional_vat" name="vat" value="XEXX010101000" required readonly>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Dirección</legend>

                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <label for="pais_create_int" class="form-label required">País</label>
                                <input type="text" class="form-control internacional_pais" id="pais_create_int" name="pais" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="estado_create_int" class="form-label required">Estado</label>
                                <input type="text" class="form-control internacional_est" id="estado_create_int" name="estado" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="municipio_create_int" class="form-label required">Municipio</label>
                                <input type="text" class="form-control internacional_mun" id="municipio_create_int" name="municipio" required>
                            </div>
                            <div class="col-md-3 mb-3">
                                <label for="internacional_cp" class="form-label required">Zip Code</label>
                                <input type="text" class="form-control internacional_cp" id="internacional_cp" name="cp" maxlength="10" required>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-3 mb-0">
                                <label for="internacional_col" class="form-label required">Colonia</label>
                                <input type="text" class="form-control internacional_col" id="internacional_col" name="colonia" required>
                            </div>
                            <div class="col-md-5 mb-0">
                                <label for="internacional_dir" class="form-label required">Dirección</label>
                                <input type="text" class="form-control" id="internacional_dir" name="dir" required>
                            </div>
                            <div class="col-md-2 mb-0">
                                <label for="internacional_num_int" class="form-label">Número Interior</label>
                                <input type="number" class="form-control" id="internacional_num_int" name="numero_int">
                            </div>
                            <div class="col-md-2 mb-0">
                                <label for="internacional_num_ext" class="form-label required">Número Exterior</label>
                                <input type="number" class="form-control" id="internacional_num_ext" name="numero_ext" required>
                            </div>
                        </div>
                    </fieldset>

                    <fieldset class="cli-fieldset">
                        <legend class="cli-legend">Asignaciones</legend>

                        <div class="row">
                            <div class="col-md-3 mb-0">
                                <label for="internacional_cve_vdr" class="form-label">Vendedor</label>
                                <input type="text" class="form-control" id="internacional_cve_vdr" name="cve_vdr">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="internacional_cve_gpo" class="form-label">Grupo</label>
                                <input type="text" class="form-control" id="internacional_cve_gpo" name="cve_gpo">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="internacional_lim_crd" class="form-label">Límite de Crédito</label>
                                <input type="number" class="form-control" id="internacional_lim_crd" name="lim_crd" step="0.01" value="0">
                            </div>
                            <div class="col-md-3 mb-0">
                                <label for="internacional_pl_dias" class="form-label">Plazo de días</label>
                                <input type="number" class="form-control" id="internacional_pl_dias" name="pl_dias" step="0.01" value="0">
                            </div>
                        </div>
                    </fieldset>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="cli-btn cli-btn-ghost" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>Cancelar
                </button>
                <button type="button" class="cli-btn cli-btn-success" onclick="guardarClienteInternacional()">
                    <i class="fa-solid fa-floppy-disk"></i>Guardar cliente
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        const RFC_EXTRANJERO = 'XEXX010101000';

        /* ── Deja el formulario y sus Tom Select en blanco ─────────── */
        window.limpiarModalInternacional = function () {
            ClientesState.limpiarSelectsDeModal('#modalAgregarClienteInternacional');
            ClientesState.destruirManager(ClientesState.tom.crearInternacional);
            document.getElementById('formAgregarClienteInternacional').reset();
        };

        /* ── Abre el modal ya inicializado ────────────────────────── */
        window.abrirModalInternacional = async function () {
            limpiarModalInternacional();

            ClientesState.tom.crearInternacional = new TomSelectManager();
            const manager = ClientesState.tom.crearInternacional;

            const nvo_cve = await GetData({ path: '/Clientes/GetSiguienteCodigoInternacional' });
            document.getElementById('internacional_cve_cli').value = nvo_cve;
            document.getElementById('internacional_vat').value = RFC_EXTRANJERO;

            await cargarDireccion(direccionConfigInternacional, null, "create", "pais", null, { instanceName: manager });
            await cargarDireccion(direccionConfigInternacional, null, "create", "vendedores", null, { instanceName: manager });

            ClientesState.transportes = [];

            new bootstrap.Modal(document.getElementById('modalAgregarClienteInternacional')).show();
        };

        /* ── Valida y envía ───────────────────────────────────────── */
        window.guardarClienteInternacional = function () {
            const form = document.getElementById('formAgregarClienteInternacional');
            if (!form.checkValidity()) {
                form.reportValidity();
                return;
            }

            const data = {};
            new FormData(form).forEach((value, key) => { data[key] = value.trim(); });
            data.es_internacional = true;

            if (data.tax_id && data.tax_id.length < 9) {
                toastMixin.fire({
                    icon: 'error',
                    title: 'El TAX ID debe tener al menos 9 dígitos.'
                });
                return;
            }

            const errores = ClientesValidaciones.validarCamposObligatorios(data, {
                cve_cli: 'Código del cliente',
                n_cli: 'Nombre del cliente',
                tax_id: 'TAX ID',
                vat: 'RFC',
                pais: 'País',
                estado: 'Estado',
                cp: 'Zip Code',
                colonia: 'Colonia',
                dir: 'Dirección',
                numero_ext: 'Número exterior'
            });

            if (errores.length > 0) {
                ClientesValidaciones.mostrarErrores('Faltan campos obligatorios:', errores);
                return;
            }

            GetData({
                path: '/Clientes/CrearClienteInternacional',
                data: data,
                swalResponse: true,
                swalPath: '/CreditoCobranza/Clientes',
                swalType: 'modal'
            });
        };

        document.addEventListener('DOMContentLoaded', () => {
            document
                .getElementById('modalAgregarClienteInternacional')
                .addEventListener('hidden.bs.modal', limpiarModalInternacional);
        });
    })();
</script>
