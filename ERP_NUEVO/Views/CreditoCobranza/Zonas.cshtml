@{
    ViewBag.Title = "Zonas";
    ViewBag.PageTitle = "Zonas";
}
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<script>window.document.title = 'Zonas'</script>
<div class="container-fluid py-4">
    <div class="contenedor-tabla">
        <div class="card-body">
            <div class="row">
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <button type="button" class="btn btn-outline-primary mb-3 blue-500" id="btnAdd" onclick="createZone()">
                        <i class="fa-duotone fa-solid fa-plus"></i> Nueva Zona
                    </button>
                </div>
            </div>

            <div class="table-responsive-sm">
                <table id="zonesTable" class="modern-table" style="width:100%">
                    <thead class="bg-secondary">
                        <tr>
                            <th>Clave</th>
                            <th>Descripción</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade animate__animated animate__bounceIn" id="zoneModal" tabindex="-1" aria-labelledby="zoneModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="zoneModalLabel">Registrar Nueva Zona</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="zoneForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-key trailing"></i>
                        <input type="number" required id="clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                        <label class="form-label" for="clave">Ingresar clave</label>
                    </div>
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                        <input type="text" id="descripcion" class="form-control form-icon-trailing" name="Descripcion" />
                        <label class="form-label" for="descripcion">Ingresar descripción</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-outline-success" onclick="sendForm()">
                        <i class="fa-duotone fa-solid fa-floppy-disk fa-beat"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Credito_Cobranza/zones.js"></script>
}
