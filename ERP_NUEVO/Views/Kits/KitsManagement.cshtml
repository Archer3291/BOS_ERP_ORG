@{
    ViewBag.Title = "KitsManagement";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<link href="~/content/Kits/crear-kit.css" rel="stylesheet" />
<!-- Tom Select CSS -->
<link href="https://cdn.jsdelivr.net/npm/tom-select@2.3.1/dist/css/tom-select.bootstrap5.min.css" rel="stylesheet">
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<div class="container py-4">

    <!-- HEADER -->
    <div class="page-header">
        <h2 class="mb-2"><i class="bi bi-box-seam"></i> Crear y Fabricar Kit</h2>
        <p class="mb-0 opacity-90">Define la composición del kit y produce las unidades necesarias</p>
    </div>

    <!-- INDICADOR DE PASOS -->
    <div class="step-indicator mb-4">
        <div class="step active" id="step1">
            <div class="step-number">1</div>
            <div class="step-label">Información del Kit</div>
        </div>
        <div class="step" id="step2">
            <div class="step-number">2</div>
            <div class="step-label">Componentes (BOM)</div>
        </div>
        <div class="step" id="step3">
            <div class="step-number">3</div>
            <div class="step-label">Fabricación</div>
        </div>
    </div>

    <!-- PASO 1: INFORMACIÓN DEL KIT -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="section-title">
                <i class="bi bi-info-circle-fill text-primary"></i> Información del Kit
            </h5>

            <!-- Selector de Kit Existente -->
            <div class="row g-3 mb-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">
                        <i class="bi bi-search"></i> Buscar Kit Existente
                    </label>
                    <select id="kitSelect" placeholder="Seleccionar kit existente (opcional)...">
                        <option value="">Crear nuevo kit</option>
                    </select>
                    <small class="text-muted">Selecciona un kit existente para fabricar más unidades o deja vacío para crear uno nuevo</small>
                </div>
            </div>

            <hr class="my-3">

            <!-- Campos del Kit -->
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Código del Kit <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="kitCode" placeholder="Ej: KIT-EMP-001" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">
                        Nombre del Kit <span class="text-danger">*</span>
                    </label>
                    <input type="text" class="form-control" id="kitName" placeholder="Ej: Kit de Empaque Premium" required>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Descripción</label>
                    <input type="text" class="form-control" id="kitDescription" placeholder="Descripción breve">
                </div>
            </div>
        </div>
    </div>

    <!-- PASO 2: COMPONENTES DEL KIT (BOM) -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="section-title mb-0">
                    <i class="bi bi-list-check text-primary"></i> Componentes del Kit (BOM)
                </h5>
                <button class="btn btn-outline-primary" onclick="addProductRow()">
                    <i class="bi bi-plus-circle"></i> Agregar Producto
                </button>
            </div>

            <!-- Contenedor para mensajes de estado del kit -->
            <div id="kitComponentsStatus"></div>

            <div id="productsContainer">
                <div class="text-center text-muted py-5 product-selector" id="emptyState">
                    <i class="bi bi-inbox display-4 mb-3"></i>
                    <p class="mb-0">No hay productos agregados. Haz clic en "Agregar Producto" para comenzar.</p>
                </div>
            </div>

            <div class="table-responsive mt-3" id="bomTableContainer" style="display: none;">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Producto</th>
                            <th class="text-center">SKU</th>
                            <th class="text-center">Cantidad por Kit</th>
                            <th class="text-center">Stock Disponible</th>
                            <th class="text-center">Total Requerido</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody id="bomTable">
                        <!-- Se llenará dinámicamente -->
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- PASO 3: CONFIGURACIÓN DE FABRICACIÓN -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h5 class="section-title">
                <i class="bi bi-gear-fill text-primary"></i> Configuración de Fabricación
            </h5>
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold">
                        Cantidad a fabricar <span class="text-danger">*</span>
                    </label>
                    <input type="number" class="form-control" id="quantity" value="10" min="1" step="0.01">
                </div>
                <div class="col-md-3 d-none">
                    <label class="form-label fw-semibold">
                        Almacén destino <span class="text-danger">*</span>
                    </label>
                    <select class="form-select" id="warehouse">
                        <option value="">Seleccionar almacén</option>
                        <option value="CEDIS">CEDIS</option>
                        <option value="Norte">Sucursal Norte</option>
                        <option value="Sur">Sucursal Sur</option>
                        <option value="Centro">Sucursal Centro</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Fecha producción</label>
                    <input type="date" class="form-control" id="productionDate" value="">
                </div>
                <div class="col-md-3">
                    <div id="stockAlert" class="alert alert-secondary mb-0">
                        <i class="bi bi-dash-circle"></i> <span id="stockMessage">Sin productos</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- ESTADÍSTICAS -->
    <div class="row mb-4" id="statsSection" style="display: none;">
        <div class="col-md-4">
            <div class="stats-card success">
                <div class="d-flex align-items-center">
                    <i class="bi bi-check-circle-fill fs-2 text-success me-3"></i>
                    <div>
                        <div class="text-muted small">Productos disponibles</div>
                        <div class="fs-4 fw-bold" id="statsOk">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-card warning">
                <div class="d-flex align-items-center">
                    <i class="bi bi-exclamation-triangle-fill fs-2 text-warning me-3"></i>
                    <div>
                        <div class="text-muted small">Stock bajo</div>
                        <div class="fs-4 fw-bold" id="statsWarning">0</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="stats-card danger">
                <div class="d-flex align-items-center">
                    <i class="bi bi-x-circle-fill fs-2 text-danger me-3"></i>
                    <div>
                        <div class="text-muted small">Stock insuficiente</div>
                        <div class="fs-4 fw-bold" id="statsError">0</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- RESUMEN Y ACCIÓN -->
    <div class="card shadow-sm">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h5 class="fw-bold mb-2">Resumen</h5>
                    <p class="mb-2" id="summaryText">
                        Completa la información del kit y agrega productos
                    </p>
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle"></i>
                            Se creará el kit y se fabricarán las unidades especificadas
                        </small>
                    </div>
                </div>
                <div class="col-md-4 text-end">
                    <button class="btn btn-primary btn-lg" id="createBtn" onclick="createAndFabricateKit()" disabled>
                        <span class="spinner-border loading-spinner me-2" role="status"></span>
                        <i class="bi bi-hammer"></i> Crear y Fabricar
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- Modal de Selección de Producto -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    <i class="bi bi-search"></i> Seleccionar Producto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text"
                           class="form-control"
                           id="searchProduct"
                           placeholder="Buscar por código o nombre..."
                           oninput="filterProducts()">
                </div>
                <div id="productList" class="list-group" style="max-height: 400px; overflow-y: auto;">
                    <!-- Productos se cargan aquí -->
                </div>
                <!-- NUEVO: Contenedor de paginación -->
                <div id="productPagination" class="mt-3">
                    <!-- Controles de paginación se renderizan aquí -->
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Confirmación -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-check-circle"></i> Confirmar creación y fabricación</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <h6 class="fw-bold mb-3">Información del Kit:</h6>
                <div class="card bg-light mb-3">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Código:</strong> <span id="confirmKitCode"></span></p>
                                <p class="mb-0"><strong>Nombre:</strong> <span id="confirmKitName"></span></p>
                            </div>
                            <div class="col-md-6">
                                <p class="mb-1"><strong>Cantidad:</strong> <span id="confirmQuantity"></span> unidades</p>                              
                            </div>
                        </div>
                    </div>
                </div>

                <h6 class="fw-bold mb-3">Componentes del Kit:</h6>
                <div class="list-group mb-3" id="confirmMaterials">
                    <!-- Se llenará dinámicamente -->
                </div>

                <div class="alert alert-warning mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Importante:</strong> Se creará el kit y se fabricarán las unidades. Esta acción actualizará el inventario.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-lg"></i> Cancelar
                </button>
                <button type="button" class="btn btn-primary" onclick="confirmCreation()">
                    <i class="bi bi-check-lg"></i> Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Resultado -->
<div class="modal fade" id="resultModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header" id="resultHeader">
                <h5 class="modal-title" id="resultTitle"></h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="resultBody"></div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <!-- Tom Select JS -->
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Kits/crear-kit.js"></script>
}