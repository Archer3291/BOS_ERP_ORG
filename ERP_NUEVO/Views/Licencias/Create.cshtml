@model BOS_ERP.Models.Licencia

@{
    ViewBag.Title = "Crear Licencia";
}

<div class="container mt-1">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Crear Nueva Licencia</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm("Create", "Licencias", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-floating">
                        @Html.DropDownListFor(model => model.EmpresaId, (SelectList)ViewBag.EmpresaId, "-- Seleccione una Empresa --", new { @class = "form-select", @placeholder = "Empresa" })
                        @Html.LabelFor(model => model.EmpresaId, "Empresa")
                    </div>
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.TipoLicencia, new { htmlAttributes = new { @class = "form-control", @placeholder = "Tipo de Licencia" } })
                        @Html.LabelFor(model => model.TipoLicencia)
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.FechaInicio, new { htmlAttributes = new { @class = "form-control", @type = "date", @placeholder = "Fecha de Inicio" } })
                        @Html.LabelFor(model => model.FechaInicio)
                    </div>
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.FechaExpiracion, new { htmlAttributes = new { @class = "form-control", @type = "date", @placeholder = "Fecha de Expiración" } })
                        @Html.LabelFor(model => model.FechaExpiracion)
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.RFC, new { htmlAttributes = new { @class = "form-control", @placeholder = "RFC" } })
                        @Html.LabelFor(model => model.RFC)
                    </div>
                    <div class="col-md-8 form-floating">
                        @Html.EditorFor(model => model.RazonSocial, new { htmlAttributes = new { @class = "form-control", @placeholder = "Razón Social" } })
                        @Html.LabelFor(model => model.RazonSocial)
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.DireccionFiscal, new { htmlAttributes = new { @class = "form-control", @placeholder = "Dirección Fiscal" } })
                        @Html.LabelFor(model => model.DireccionFiscal)
                    </div>
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.Regimen, new { htmlAttributes = new { @class = "form-control", @placeholder = "Régimen Fiscal" } })
                        @Html.LabelFor(model => model.Regimen)
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Pais, new { htmlAttributes = new { @class = "form-control", @placeholder = "País" } })
                        @Html.LabelFor(model => model.Pais)
                    </div>
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-control", @placeholder = "Estado" } })
                        @Html.LabelFor(model => model.Estado)
                    </div>
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Ciudad, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ciudad" } })
                        @Html.LabelFor(model => model.Ciudad)
                    </div>
                </div>

                <div class="form-check mb-4">
                    @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input", id = "activaCheck" })
                    <label class="form-check-label" for="activaCheck">
                        ¿Está activa?
                    </label>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-save"></i> Guardar Licencia
                        </button>
                    </div>

                    <div class="col-md-6">
                        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary w-100" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
@Html.ValidationSummary(true, "", new { @class = "text-danger" })