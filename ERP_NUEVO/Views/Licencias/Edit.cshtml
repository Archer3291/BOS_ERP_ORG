@model BOS_ERP.Models.Licencia

@{
    ViewBag.Title = "Editar Licencia";
}

<div class="container mt-5">
    <div class="card shadow rounded-4">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">Editar Licencia</h4>
        </div>

        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                @Html.HiddenFor(model => model.LicenciaId)
                @Html.HiddenFor(model => model.LicenciaCodigo)

                <div class="row g-3 mb-3">
                    <!-- Empresa (editable) -->
                    <div class="col-md-6 form-floating">
                        <select name="EmpresaId" class="form-select" id="EmpresaId">
                            <option value="">-- Selecciona una empresa --</option>
                            @foreach (var item in (SelectList)ViewBag.EmpresaId)
                            {
                                @if (item.Selected)
                                {
                                    <option value="@item.Value" selected>@item.Text</option>
                                }
                                else
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            }
                        </select>
                        <label for="EmpresaId">Empresa</label>
                    </div>

                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.TipoLicencia, new { htmlAttributes = new { @class = "form-control", @placeholder = "Tipo de Licencia" } })
                        @Html.LabelFor(model => model.TipoLicencia)
                    </div>
                </div>


                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-floating">
                        <input type="date" name="FechaInicio" class="form-control"
                               value="@Model.FechaInicio.ToString("yyyy-MM-dd")" />
                        <label for="FechaInicio">Fecha de Inicio</label>
                    </div>

                    <div class="col-md-6 form-floating">
                        <input type="date" name="FechaExpiracion" class="form-control"
                               value="@Model.FechaExpiracion.ToString("yyyy-MM-dd")" />
                        <label for="FechaExpiracion">Fecha de Expiración</label>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.RFC, new { htmlAttributes = new { @class = "form-control", @placeholder = "RFC" } })
                        <label for="RFC">RFC</label>
                    </div>

                    <div class="col-md-8 form-floating">
                        @Html.EditorFor(model => model.RazonSocial, new { htmlAttributes = new { @class = "form-control", @placeholder = "Razón Social" } })
                        <label for="RazonSocial">Razón Social</label>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.DireccionFiscal, new { htmlAttributes = new { @class = "form-control", @placeholder = "Dirección Fiscal" } })
                        <label for="DireccionFiscal">Dirección Fiscal</label>
                    </div>
                    <div class="col-md-6 form-floating">
                        @Html.EditorFor(model => model.Regimen, new { htmlAttributes = new { @class = "form-control", @placeholder = "Régimen Fiscal" } })
                        <label for="Regimen">Régimen Fiscal</label>
                    </div>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Pais, new { htmlAttributes = new { @class = "form-control", @placeholder = "País" } })
                        <label for="Pais">País</label>
                    </div>

                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Estado, new { htmlAttributes = new { @class = "form-control", @placeholder = "Estado" } })
                        <label for="Estado">Estado</label>
                    </div>

                    <div class="col-md-4 form-floating">
                        @Html.EditorFor(model => model.Ciudad, new { htmlAttributes = new { @class = "form-control", @placeholder = "Ciudad" } })
                        <label for="Ciudad">Ciudad</label>
                    </div>
                </div>

                @*<div class="form-check mb-4">
                    @Html.CheckBoxFor(model => model.Activa, new { @class = "form-check-input", id = "activaCheck" })
                    <label class="form-check-label" for="activaCheck">
                        ¿Está activa?
                    </label>
                </div>*@

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-save"></i> Guardar Cambios
                        </button>
                    </div>

                    <div class="col-md-6">
                        @Html.ActionLink("Cancelar", "Index", null, new { @class = "btn btn-secondary w-100" })
                    </div>
                </div>
            }
        </div>
    </div>
</div>
