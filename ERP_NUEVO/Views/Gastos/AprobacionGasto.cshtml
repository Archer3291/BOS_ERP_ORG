@{
    ViewBag.Title = "Aprobación de Solicitudes de Gasto";
    ViewBag.PageTitle = "Solicitud de Gastos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="~/content/TableBuilder.css" rel="stylesheet" />
    <style>
        /* ═══════════════════════════════════════════════
           DESIGN SYSTEM
        ═══════════════════════════════════════════════ */
        :root {
            --navy: #0b1829;
            --navy-2: #152337;
            --navy-3: #1e3450;
            --blue: #1d4ed8;
            --blue-lt: #dbeafe;
            --ok: #059669;
            --ok-lt: #d1fae5;
            --warn: #d97706;
            --warn-lt: #fef3c7;
            --danger: #dc2626;
            --danger-lt: #fee2e2;
            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-400: #94a3b8;
            --slate-600: #475569;
            --ink: #0f172a;
            --white: #ffffff;

            --radius-sm: 4px;
            --radius: 8px;
            --radius-lg: 12px;
            --shadow-sm: 0 1px 3px rgba(11,24,41,.07), 0 2px 8px rgba(11,24,41,.05);
            --shadow: 0 2px 8px rgba(11,24,41,.08), 0 8px 24px rgba(11,24,41,.06);
            --shadow-lg: 0 8px 32px rgba(11,24,41,.16);
        }

        /* ── PAGE HEADER ─────────────────────────────── */
        .sg-page-header {
            background: var(--navy);
            position: sticky;
            top: 0;
            z-index: 200;
            box-shadow: 0 2px 20px rgba(0,0,0,.3);
        }

        .sg-header-top {
            padding: 16px 24px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .sg-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .sg-pill {
            background: #f59e0b;
            color: var(--navy);
            font-size: 10px;
            font-weight: 700;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            letter-spacing: .1em;
        }

        .sg-page-title {
            font-size: 20px;
            font-weight: 700;
            color: var(--white);
            letter-spacing: -.02em;
        }

        .sg-page-sub {
            font-size: 11px;
            color: rgba(255,255,255,.38);
            margin-top: 1px;
        }

        /* ── KPI STRIP ───────────────────────────────── */
        .kpi-strip {
            display: flex;
            overflow-x: auto;
            border-top: 1px solid rgba(255,255,255,.07);
            margin-top: 14px;
            scrollbar-width: none;
        }

            .kpi-strip::-webkit-scrollbar {
                display: none;
            }

        .kpi-item {
            flex: 1;
            min-width: 110px;
            padding: 12px 18px 13px;
            border-right: 1px solid rgba(255,255,255,.05);
            cursor: default;
            transition: background .18s;
        }

            .kpi-item:last-child {
                border-right: none;
            }

            .kpi-item:hover {
                background: rgba(255,255,255,.04);
            }

        .kpi-label {
            font-size: 8px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            margin-bottom: 4px;
        }

        .kpi-value {
            font-size: 16px;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
        }

            .kpi-value.v-amber {
                color: #f59e0b;
            }

            .kpi-value.v-ok {
                color: #34d399;
            }

            .kpi-value.v-danger {
                color: #f87171;
            }

            .kpi-value.v-blue {
                color: #93c5fd;
            }

        .kpi-sub {
            font-size: 9px;
            color: rgba(255,255,255,.22);
            margin-top: 2px;
        }

        /* ── BODY ────────────────────────────────────── */
        .sg-body {
            padding: 24px;
        }

        /* ── FILTER CARD ─────────────────────────────── */
        .filter-card {
            background: var(--bg-light);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 18px 20px 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
        }

        .filter-card-title {
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--slate-400);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .sg-label {
            display: block;
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-600);
            margin-bottom: 5px;
        }

        .sg-input, .sg-select {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-sm);
            font-family: var(--body);
            font-size: 12px;
            background: var(--bg-gray);
            outline: none;
            transition: border-color .18s, box-shadow .18s;
            height: 36px;
        }

            .sg-input:focus, .sg-select:focus {
                border-color: #f59e0b;
                box-shadow: 0 0 0 3px rgba(245,158,11,.14);
            }

            .sg-input::placeholder {
                color: var(--slate-400);
            }

        /* ── BOTONES ─────────────────────────────────── */
        .btn-sg {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-family: var(--body);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .18s;
            white-space: nowrap;
            height: 36px;
        }

        .btn-sg-primary {
            background: var(--navy);
            color: var(--white);
        }

            .btn-sg-primary:hover {
                background: var(--navy-2);
            }

        .btn-sg-ghost {
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
        }

            .btn-sg-ghost:hover {
                background: var(--slate-200);
            }

        .btn-sg-ok {
            background: var(--ok);
            color: var(--white);
        }

            .btn-sg-ok:hover {
                filter: brightness(.92);
            }

        .btn-sg-danger {
            background: var(--danger);
            color: var(--white);
        }

            .btn-sg-danger:hover {
                filter: brightness(.9);
            }

        .btn-sg-amber {
            background: #f59e0b;
            color: var(--navy);
        }

            .btn-sg-amber:hover {
                filter: brightness(.93);
            }

        .btn-sg-sm {
            padding: 5px 12px;
            font-size: 11px;
            height: 30px;
        }

        .btn-sg:disabled {
            opacity: .5;
            cursor: not-allowed;
        }

        /* ── BADGES ──────────────────────────────────── */
        .sg-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .sb-pending {
            background: var(--warn-lt);
            color: #92400e;
        }

        .sb-approved {
            background: var(--ok-lt);
            color: #065f46;
        }

        .sb-rejected {
            background: var(--danger-lt);
            color: #991b1b;
        }

        .sb-draft {
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
        }

        /* ── MONTO BAR ───────────────────────────────── */
        .monto-fill {
            height: 3px;
            border-radius: 2px;
            background: var(--blue);
            margin-top: 3px;
            transition: width .3s;
        }

        /* ── ROW HIGHLIGHT para pendientes ───────────── */
        /* TableBuilder aplica clase a la <tr>; si no lo soporta, ignorar */
        tr.row-pendiente {
            background: #fffbeb !important;
        }

        /* ═══════════════════════════════════════════════
           MODAL DETALLE / APROBACIÓN
        ═══════════════════════════════════════════════ */
        #modal-detalle .modal-dialog {
            max-width: 1000px;
        }

        #modal-detalle .modal-content {
            border: none;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        /* ── Cabecera oscura ─────────────────────────── */
        .md-head {
            background: var(--navy);
            padding: 20px 24px 0;
        }

        .md-head-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 16px;
        }

        .md-folio {
            font-size: 22px;
            font-weight: 600;
            color: var(--white);
        }

        .md-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .md-meta-item {
            font-size: 10px;
            color: rgba(255,255,255,.4);
        }

            .md-meta-item strong {
                display: block;
                color: rgba(255,255,255,.8);
                font-size: 11px;
                margin-top: 1px;
            }

        .md-close {
            background: rgba(255,255,255,.1);
            border: none;
            color: rgba(255,255,255,.6);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all .15s;
            flex-shrink: 0;
        }

            .md-close:hover {
                background: rgba(255,255,255,.18);
                color: var(--white);
            }

        /* ── Totals strip ────────────────────────────── */
        .md-totals {
            display: flex;
            background: var(--navy-3);
            border-top: 1px solid rgba(255,255,255,.06);
            overflow-x: auto;
            scrollbar-width: none;
        }

            .md-totals::-webkit-scrollbar {
                display: none;
            }

        .mdt-item {
            flex: 1;
            min-width: 90px;
            padding: 11px 16px;
            border-right: 1px solid rgba(255,255,255,.05);
        }

            .mdt-item:last-child {
                border-right: none;
            }

        .mdt-lbl {
            font-size: 8px;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            margin-bottom: 3px;
        }

        .mdt-val {
            font-size: 13px;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
        }

            .mdt-val.v-amber {
                color: #f59e0b;
            }

            .mdt-val.v-ok {
                color: #34d399;
            }

            .mdt-val.v-danger {
                color: #f87171;
            }

            .mdt-val.v-blue {
                color: #93c5fd;
            }

        /* ── Tabs ────────────────────────────────────── */
        .md-tabs {
            display: flex;
            background: var(--slate-100);
            border-bottom: 1px solid var(--slate-200);
            overflow-x: auto;
            scrollbar-width: none;
        }

            .md-tabs::-webkit-scrollbar {
                display: none;
            }

        .md-tab-btn {
            padding: 11px 16px;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-400);
            border: none;
            background: transparent;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            white-space: nowrap;
            transition: all .15s;
        }

            .md-tab-btn:hover {
                color: var(--ink);
            }

            .md-tab-btn.active {
                color: var(--navy);
                border-bottom-color: #f59e0b;
                background: var(--white);
            }
        /* Badge numérico en tab */
        .tab-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: var(--danger);
            color: var(--white);
            font-size: 8px;
            font-weight: 700;
            min-width: 16px;
            height: 16px;
            border-radius: 8px;
            padding: 0 4px;
            margin-left: 5px;
            vertical-align: middle;
        }

        .md-tab-panel {
            display: none;
            padding: 22px 24px;
        }

            .md-tab-panel.active {
                display: block;
            }

        /* ── Section titles ──────────────────────────── */
        .md-sec {
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--slate-400);
            padding-bottom: 7px;
            border-bottom: 1px solid var(--slate-200);
            margin-bottom: 14px;
            margin-top: 18px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .md-sec:first-child {
                margin-top: 0;
            }

        /* ── Info items ──────────────────────────────── */
        .md-info-item label {
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-400);
            display: block;
            margin-bottom: 2px;
        }

        .md-info-item span {
            font-size: 12px;
            font-weight: 500;
        }

        /* ── Flujo de aprobación ─────────────────────── */
        .aprov-panel {
            background: var(--bg-gray);
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 18px 20px;
            margin-bottom: 16px;
        }

        .aprov-title {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--slate-600);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .aprov-step {
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 10px 0;
            border-bottom: 1px solid var(--slate-200);
        }

            .aprov-step:last-child {
                border-bottom: none;
                padding-bottom: 0;
            }

        .aprov-icon {
            width: 32px;
            height: 32px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 12px;
            flex-shrink: 0;
        }

            .aprov-icon.done {
                background: var(--ok-lt);
                color: var(--ok);
            }

            .aprov-icon.pending {
                background: var(--warn-lt);
                color: var(--warn);
            }

            .aprov-icon.waiting {
                background: var(--slate-100);
                color: var(--slate-400);
            }

            .aprov-icon.rejected {
                background: var(--danger-lt);
                color: var(--danger);
            }

        .aprov-step-name {
            font-weight: 700;
            font-size: 12px;
        }

        .aprov-step-meta {
            font-size: 10px;
            color: var(--slate-400);

            margin-top: 2px;
        }

        /* ═══════════════════════════════════════════════
           PANEL DE DECISIÓN — diseño destacado
        ═══════════════════════════════════════════════ */
        .decision-panel {
            background: var(--white);
            border: 2px solid var(--slate-200);
            border-radius: var(--radius-lg);
            overflow: hidden;
        }

        .decision-header {
            background: var(--navy);
            padding: 14px 20px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .decision-header-title {
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--white);
        }

        .decision-header-sub {
            font-size: 9px;
            color: rgba(255,255,255,.4);
            margin-top: 2px;
        }

        .decision-body {
            padding: 20px;
        }

        /* Resumen rápido de la solicitud dentro del panel */
        .decision-summary {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            background: var(--slate-50);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius);
            padding: 12px 16px;
            margin-bottom: 18px;
        }

        .ds-item {
            flex: 1;
            min-width: 100px;
        }

        .ds-label {
            font-size: 8px;
            font-weight: 700;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: var(--slate-400);
            margin-bottom: 2px;
        }

        .ds-value {
            font-size: 13px;
            font-weight: 700;
            color: var(--ink);
        }

            .ds-value.amber {
                color: var(--warn);
            }

        .sg-textarea {
            width: 100%;
            padding: 10px 12px;
            border: 1.5px solid var(--slate-200);
            border-radius: var(--radius);
            font-family: var(--body);
            font-size: 12px;
            resize: vertical;
            min-height: 80px;
            outline: none;
            transition: border-color .18s, box-shadow .18s;
        }

            .sg-textarea:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(29,78,216,.1);
            }

        /* Botones de decisión grandes */
        .decision-btns {
            display: flex;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 16px;
        }

        .btn-decision {
            flex: 1;
            min-width: 140px;
            padding: 14px 20px;
            border-radius: var(--radius);
            font-family: var(--body);
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            border: none;
            transition: all .2s;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

            .btn-decision:disabled {
                opacity: .5;
                cursor: not-allowed;
            }

        .btn-dec-ok {
            background: var(--ok);
            color: var(--white);
            box-shadow: 0 4px 14px rgba(5,150,105,.3);
        }

            .btn-dec-ok:hover {
                filter: brightness(.92);
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(5,150,105,.35);
            }

        .btn-dec-danger {
            background: var(--danger);
            color: var(--white);
            box-shadow: 0 4px 14px rgba(220,38,38,.3);
        }

            .btn-dec-danger:hover {
                filter: brightness(.92);
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(220,38,38,.35);
            }

        .btn-dec-comment {
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1.5px solid var(--slate-200);
        }

            .btn-dec-comment:hover {
                background: var(--slate-200);
            }

        /* Estado: ya procesada */
        .ya-procesada-banner {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 20px;
            border-radius: var(--radius);
            font-size: 13px;
            font-weight: 600;
        }

            .ya-procesada-banner.aprobada {
                background: var(--ok-lt);
                color: #065f46;
                border: 1px solid #6ee7b7;
            }

            .ya-procesada-banner.rechazada {
                background: var(--danger-lt);
                color: #991b1b;
                border: 1px solid #fca5a5;
            }

            .ya-procesada-banner.otro {
                background: var(--slate-100);
                color: var(--slate-600);
                border: 1px solid var(--slate-200);
            }

        /* ── Archivos adjuntos ───────────────────────── */
        .file-row {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 9px 12px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius);
            margin-bottom: 7px;
            background: var(--slate-50);
            font-size: 11px;
            transition: border-color .15s;
        }

            .file-row:hover {
                border-color: #f59e0b;
            }

            .file-row i {
                color: var(--slate-400);
                font-size: 14px;
            }

        .file-name {
            flex: 1;
            font-weight: 600;
            color: var(--ink);
        }

        .file-size {
            font-size: 10px;
            color: var(--slate-400);
        }

        /* ── Historial ───────────────────────────────── */
        .hist-item {
            display: flex;
            gap: 12px;
            padding: 12px 0;
            border-bottom: 1px solid var(--slate-100);
        }

            .hist-item:last-child {
                border-bottom: none;
            }

        .hist-avatar {
            width: 30px;
            height: 30px;
            border-radius: 50%;
            background: #435670;
            color: var(--white);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            flex-shrink: 0;
        }

        .hist-name {
            font-weight: 700;
            font-size: 12px;

        }

        .hist-date {
            font-size: 10px;
            color: var(--slate-400);
            margin-left: 8px;
        }

        .hist-action-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 9px;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: 10px;
            margin-left: 6px;
            text-transform: uppercase;
        }

            .hist-action-badge.aprobado {
                background: var(--ok-lt);
                color: #065f46;
            }

            .hist-action-badge.rechazado {
                background: var(--danger-lt);
                color: #991b1b;
            }

            .hist-action-badge.comentario {
                background: var(--blue-lt);
                color: #1e40af;
            }

        .hist-body {
            font-size: 12px;
            color: var(--slate-600);
            margin-top: 5px;
            line-height: 1.5;
        }

        /* ── Toast ───────────────────────────────────── */
        .toast-area {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }

        .sg-toast {
            padding: 10px 16px;
            border-radius: var(--radius);
            font-size: 12px;
            font-family: var(--body);
            font-weight: 500;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 220px;
            max-width: 340px;
            pointer-events: auto;
            animation: toastIn .22s ease;
        }

        @@keyframes toastIn {
            from {
                transform: translateY(8px);
                opacity: 0;
            }

            to {
                transform: translateY(0);
                opacity: 1;
            }
        }

        .sg-toast.t-ok {
            background: var(--ok-lt);
            color: #065f46;
            border: 1px solid #6ee7b7;
        }

        .sg-toast.t-err {
            background: var(--danger-lt);
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .sg-toast.t-inf {
            background: var(--blue-lt);
            color: #1e40af;
            border: 1px solid #93c5fd;
        }

        @@media (max-width: 768px) {
            .sg-body {
                padding: 12px;
            }

            .sg-header-top {
                padding: 12px 16px 0;
            }

            .kpi-item {
                min-width: 100px;
                padding: 10px 14px 11px;
            }

            .kpi-value {
                font-size: 13px;
            }

            #modal-detalle .modal-dialog {
                margin: 8px;
            }

            .md-tab-btn {
                padding: 10px 12px;
                font-size: 9px;
            }

            .md-tab-panel {
                padding: 16px;
            }

            .decision-btns {
                flex-direction: column;
            }

            .btn-decision {
                min-width: unset;
            }
        }
    </style>
}

