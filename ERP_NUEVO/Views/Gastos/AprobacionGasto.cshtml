@section scripts {
    <script src="~/Scripts/TableBuilder.js"></script>
    <script>
        /* ══════════════════════════════════════════════════
           ESTADO GLOBAL
        ══════════════════════════════════════════════════ */
        const S = {
            bsModal: null,
            tabla: null,
            idActual: null,
            folioActual: null,
            datosActual: null,   // objeto solicitud completo
        };

        /* ══════════════════════════════════════════════════
           UTILIDADES
        ══════════════════════════════════════════════════ */
        const $el = id => document.getElementById(id);
        const setText = (id, v) => { const e = $el(id); if (e) e.textContent = v ?? '—'; };
        const setHtml = (id, v) => { const e = $el(id); if (e) e.innerHTML = v ?? ''; };
        const esc = t => { const d = document.createElement('div'); d.textContent = String(t ?? ''); return d.innerHTML; };

        const fmtMoney = (n, ccy = 'MXN') => {
            const sym = { MXN: '$', USD: 'US$', EUR: '€' };
            return (sym[ccy] || '$') + Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };

        /* ── Toast ─────────────────────────────────────── */
        function sgToast(msg, type = 'info') {
            const zone = $el('toast-area');
            const t = document.createElement('div');
            const cls = { ok: 't-ok', err: 't-err', info: 't-inf' };
            const ico = { ok: 'check-circle', err: 'exclamation-circle', info: 'info-circle' };
            t.className = `sg-toast ${cls[type] || 't-inf'}`;
            t.innerHTML = `<i class="fas fa-${ico[type] || 'info-circle'}"></i> ${esc(msg)}`;
            zone.appendChild(t);
            setTimeout(() => {
                t.style.transition = 'opacity .3s, transform .3s';
                t.style.opacity = '0';
                t.style.transform = 'translateY(6px)';
                setTimeout(() => t.remove(), 320);
            }, 3500);
        }

        /* ══════════════════════════════════════════════════
           BADGES
        ══════════════════════════════════════════════════ */
        function badgeEstatus(s) {
            const map = {
                '1': ['sb-pending', 'fa-clock', 'Pendiente'],
                '2': ['sb-approved', 'fa-check-circle', 'Aprobado'],
                '3': ['sb-rejected', 'fa-times-circle', 'Rechazado'],
                '0': ['sb-draft', 'fa-file-alt', 'Borrador'],
            };
            const [cls, ico, lbl] = map[String(s)] || ['sb-draft', 'fa-question', s ?? '—'];
            return `<span class="sg-badge ${cls}"><i class="fas ${ico}"></i>${lbl}</span>`;
        }

        function badgeUrgencia(u) {
            if (!u) return '—';
            const map = {
                inmediato: ['#ef4444', 'fa-bolt', 'Inmediato'],
                urgente: ['#f59e0b', 'fa-exclamation-circle', 'Urgente'],
                normal: ['#64748b', 'fa-clock', 'Normal'],
            };
            const key = (u || '').toLowerCase();
            const hit = Object.entries(map).find(([k]) => key.includes(k));
            const [color, ico, lbl] = hit ? hit[1] : ['#64748b', 'fa-clock', u];
            return `<span class="sg-badge" style="background:${color}18;color:${color};border:1px solid ${color}38;">
                        <i class="fas ${ico}"></i>${esc(lbl)}
                    </span>`;
        }

        function colorCategoria(cat) {
            const map = {
                'Gastos Operativos': '#1d4ed8',
                'Gastos Administrativos': '#7c3aed',
                'Viáticos': '#d97706',
                'Gastos Directos': '#059669',
            };
            return map[cat] || '#475569';
        }

        /* ══════════════════════════════════════════════════
           KPI
        ══════════════════════════════════════════════════ */
        async function cargarKPI() {
            const desde = $el('f-fecha-desde')?.value || '';
            const hasta = $el('f-fecha-hasta')?.value || '';
            try {
                const res = await fetch(`/Gastos/ResumenKPI?fechaDesde=${desde}&fechaHasta=${hasta}`);
                const d = await res.json();
                setText('kpi-total', d.total || '0');
                setText('kpi-monto', fmtMoney(d.monto_total));
                setText('kpi-pendientes', d.pendientes || '0');
                setText('kpi-aprobadas', d.aprobadas || '0');
                setText('kpi-rechazadas', d.rechazadas || '0');
                setText('kpi-urgentes', d.urgentes || '0');
                setText('kpi-monto-aprobado', fmtMoney(d.monto_aprobado));
                setText('kpi-tiempo', d.tiempo_promedio != null ? d.tiempo_promedio + ' días' : '—');
            } catch { /* no crítico */ }
        }

        /* ══════════════════════════════════════════════════
           FILTROS
        ══════════════════════════════════════════════════ */
        function getFiltrosExtra() {
            return {
                folio: $el('f-folio')?.value || '',
                categoria: $el('f-categoria')?.value || '',
                estatus: $el('f-estatus')?.value || '',
                urgencia: $el('f-urgencia')?.value || '',
                fechaDesde: $el('f-fecha-desde')?.value || '',
                fechaHasta: $el('f-fecha-hasta')?.value || '',
            };
        }

        function recargarTabla() { S.tabla?.reload(''); cargarKPI(); }

        function limpiarFiltros() {
            $el('f-folio').value = '';
            $el('f-categoria').value = '';
            $el('f-estatus').value = '1'; // vuelve a "Pendiente" por defecto
            $el('f-urgencia').value = '';
            $el('f-fecha-desde').value = '';
            $el('f-fecha-hasta').value = '';
            recargarTabla();
        }

        /* ══════════════════════════════════════════════════
           INICIALIZAR TABLA
        ══════════════════════════════════════════════════ */
        document.addEventListener('DOMContentLoaded', () => {
            // Rango por defecto: último mes
            const hoy = new Date();
            const hace = new Date(); hace.setMonth(hace.getMonth() - 1);
            const iso = d => d.toISOString().slice(0, 10);
            $el('f-fecha-desde').value = iso(hace);
            $el('f-fecha-hasta').value = iso(hoy);
            cargarKPI();

            S.tabla = createTable({
                selector: '#tabla-sg',
                path: '/Gastos/BuscarSolicitudes',
                searchPlaceholder: 'Solicitante, proveedor o concepto…',
                defaultPageSize: 25,
                pageSizeOptions: [10, 25, 50, 100],
                data: () => getFiltrosExtra(),
                exports: [{ type: 'excel', label: 'Exportar Excel', fileName: 'aprobacion_gastos' }],

                columns: [
                    {
                        title: 'Folio', data: 'folio',
                        formatter: v =>
                            `<span style="font-family:var(--mono);font-weight:700;font-size:12px;">
                                ${esc(v || '—')}
                             </span>`
                    },
                    {
                        title: 'Solicitante', data: 'solicitante',
                        formatter: (v, row) => {
                            const ini = (v || '?').split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
                            return `
                                <div style="display:flex;align-items:center;gap:8px;">
                                    <div style="width:28px;height:28px;border-radius:50%;
                                                background:var(--navy);color:#fff;
                                                display:flex;align-items:center;justify-content:center;
                                                font-size:10px;font-weight:700;flex-shrink:0;">
                                        ${esc(ini)}
                                    </div>
                                    <div>
                                        <div style="font-weight:600;font-size:12px;">${esc(v || '—')}</div>
                                        <div style="font-size:10px;color:var(--slate-400);">${esc(row.area || '')}</div>
                                    </div>
                                </div>`;
                        }
                    },
                    {
                        title: 'Proveedor / Concepto', data: 'proveedor',
                        formatter: (v, row) =>
                            `<div style="font-weight:500;font-size:12px;max-width:170px;
                                         overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                  title="${esc(v)}">${esc(v || '—')}</div>
                             <div style="font-size:10px;color:var(--slate-400);max-width:170px;
                                         overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                  title="${esc(row.concepto)}">${esc(row.concepto || '')}</div>`
                    },
                    {
                        title: 'Categoría', data: 'categoria',
                        formatter: (v, row) => {
                            const c = colorCategoria(v);
                            return `<div style="font-size:11px;font-weight:700;color:${c};">${esc(v || '—')}</div>
                                    <div style="font-size:10px;color:var(--slate-400);">${esc(row.subcategoria || '')}</div>`;
                        }
                    },
                    {
                        title: 'Fecha', data: 'fecha',
                        formatter: v =>
                            `<span style="font-family:var(--mono);font-size:11px;color:var(--slate-600);">
                                ${dateFormatter(v)}
                             </span>`
                    },
                    {
                        title: 'Urgencia', data: 'urgencia',
                        formatter: v => badgeUrgencia(v)
                    },
                    {
                        title: 'Monto', data: 'monto', className: 'text-end',
                        formatter: (v, row) => {
                            const m = parseFloat(v) || 0;
                            const pct = Math.min(Math.round((m / 100000) * 100), 100);
                            return `
                                <div style="font-family:var(--mono);font-size:12px;font-weight:700;">
                                    ${fmtMoney(m, row.moneda)}
                                </div>
                                <div class="monto-fill" style="width:${pct}%;"></div>
                                <div style="font-size:9px;color:var(--slate-400);font-family:var(--mono);
                                            text-align:right;margin-top:1px;">${esc(row.moneda || 'MXN')}</div>`;
                        }
                    },
                    {
                        title: 'Estatus', data: 'estatus',
                        formatter: v => badgeEstatus(v)
                    },
                    {
                        // Columna de acción rápida
                        title: '', data: 'estatus',
                        formatter: (v, row) => {
                            if (String(v) !== '1') return '';   // solo pendientes
                            return `
                                <button class="btn-sg btn-sg-amber btn-sg-sm"
                                        onclick="event.stopPropagation(); abrirDetalle(${row.id})">
                                    <i class="fas fa-stamp"></i> Revisar
                                </button>`;
                        }
                    },
                ],

                RowsEvents: { onRowClick: row => abrirDetalle(row.id) },
                GlobalEvents: { onDataLoaded: () => cargarKPI() },
            });

            // Enter en filtros dispara búsqueda
            ['f-folio', 'f-categoria', 'f-estatus', 'f-urgencia', 'f-fecha-desde', 'f-fecha-hasta']
                .forEach(id => $el(id)?.addEventListener('keydown', e => { if (e.key === 'Enter') recargarTabla(); }));
        });

        function renderCamposDinamicos(campos, subcategoria) {
            const sec = $el('md-sec-dinamicos');
            const body = $el('md-campos-dinamicos');

            if (!campos || !campos.length) {
                sec.style.display = 'none';
                body.innerHTML = '';
                return;
            }

            sec.style.display = '';
            setText('md-subcat-label', subcategoria || '');

            // Campos que ocupan ancho completo por su contenido largo
            const fullWidthIds = new Set([
                'ef-items', 'ef-mercancias', 'ef-pap', 'ef-legal-asunto',
                'ef-hon-alcance', 'ef-proj-mat', 'ef-justif', 'ef-rep-asist',
                'ef-ali-clientes', 'ef-cap-participantes'
            ]);

            body.innerHTML = campos.map(c => {
                const isFull = fullWidthIds.has(c.id);
                const colClass = isFull ? 'col-12' : 'col-12 col-sm-6 col-lg-4';

                // Valor vacío
                if (!c.valor || c.valor === '[]') return '';

                // Tag-input: viene como JSON array ["nombre1","nombre2"]
                let display = esc(c.valor);
                try {
                    const arr = JSON.parse(c.valor);
                    if (Array.isArray(arr) && arr.length) {
                        display = arr.map(t =>
                            `<span style="display:inline-flex;align-items:center;gap:4px;
                                  padding:2px 8px;border-radius:20px;font-size:11px;
                                  background:var(--blue-lt);color:#1e40af;
                                  border:1px solid #93c5fd;margin:2px;">
                        ${esc(t)}
                     </span>`
                        ).join('');
                    }
                } catch { /* no es JSON, usar el valor directo */ }

                return `
            <div class="${colClass}">
                <div class="md-info-item">
                    <label>${esc(c.label)}</label>
                    <span style="white-space:pre-wrap;">${display}</span>
                </div>
            </div>`;
            }).join('');
        }


        /* ══════════════════════════════════════════════════
           MODAL — ABRIR DETALLE
        ══════════════════════════════════════════════════ */
        async function abrirDetalle(id) {
            if (!S.bsModal)
                S.bsModal = new bootstrap.Modal($el('modal-detalle'), { backdrop: true, keyboard: true });
            S.bsModal.show();
            showMdTab('mdt-general', null, true);

            // Reset
            ['md-folio', 'md-creador', 'md-fecha', 'md-categoria', 'md-subcategoria',
                'md-monto', 'md-moneda', 'md-cc', 'md-aprobador-hd',
                'md-solicitante', 'md-area', 'md-proveedor', 'md-concepto',
                'md-justificacion', 'md-notas',
                'ds-folio', 'ds-solicitante', 'ds-monto', 'ds-categoria']
                .forEach(i => setText(i, '…'));
            setHtml('md-estatus-hd', '');
            setHtml('md-urgencia-hd', '');
            setHtml('md-flujo-panel', '<div style="padding:8px;color:var(--slate-400);font-size:12px;">Cargando…</div>');
            setHtml('md-archivos-body', '');
            setHtml('md-historial-body', '');
            $el('aprov-comentario').value = '';
            $el('tab-badge-docs').style.display = 'none';
            $el('tab-badge-hist').style.display = 'none';

            S.idActual = id;

            try {
                const res = await fetch(`/Gastos/DetalleSolicitud?id=${id}`);
                const data = await res.json();
                if (!data.success) { sgToast(data.message || 'Error al cargar', 'err'); return; }

                const enc = data.solicitud;
                S.folioActual = enc.folio;
                S.datosActual = enc;

                // Cabecera modal
                setText('md-folio', enc.folio || '—');
                setText('md-creador', enc.creador || '—');
                setText('md-fecha', dateFormatter(enc.fecha));
                setText('md-categoria', enc.categoria || '—');
                setText('md-subcategoria', enc.subcategoria || '—');
                setHtml('md-estatus-hd', badgeEstatus(enc.estatus));

                // Strip totals
                setText('md-monto', fmtMoney(enc.monto, enc.moneda));
                setText('md-moneda', enc.moneda || 'MXN');
                setText('md-cc', enc.centro_costo || '—');
                setHtml('md-urgencia-hd', badgeUrgencia(enc.urgencia));
                setText('md-aprobador-hd', enc.aprobador || '—');

                // Tab general
                setText('md-solicitante', enc.creador || '—');
                setText('md-area', enc.area || '—');
                setText('md-proveedor', enc.proveedor || '—');
                setText('md-concepto', enc.concepto || '—');
                setText('md-justificacion', enc.justificacion || '—');
                setText('md-notas', enc.notas || '—');

                // Flujo
                renderFlujo(enc);

                // Archivos
                renderArchivos(data.archivos || []);

                // Historial
                renderHistorial(data.historial || []);

                // Campos dinámicos
                renderCamposDinamicos(data.camposDinamicos || [], enc.subcategoria);

                // Badges en tabs
                const nDocs = (data.archivos || []).length;
                const nHist = (data.historial || []).length;
                if (nDocs > 0) { $el('tab-badge-docs').textContent = nDocs; $el('tab-badge-docs').style.display = ''; }
                if (nHist > 0) { $el('tab-badge-hist').textContent = nHist; $el('tab-badge-hist').style.display = ''; }

                // Panel de decisión: visible solo si estatus = 1 (Pendiente)
                const esPendiente = String(enc.estatus) === '1';

                // Resumen rápido en panel decisión
                setText('ds-folio', enc.folio || '—');
                setText('ds-solicitante', enc.creador || '—');
                setText('ds-monto', fmtMoney(enc.monto, enc.moneda));
                setText('ds-categoria', enc.categoria || '—');

                $el('aprov-form-wrap').style.display = esPendiente ? '' : 'none';
                $el('aprov-ya-procesada').style.display = esPendiente ? 'none' : '';

                if (!esPendiente) {
                    const banner = $el('ya-procesada-banner');
                    const cls = enc.estatus == 2 ? 'aprobada' : enc.estatus == 3 ? 'rechazada' : 'otro';
                    const ico = enc.estatus == 2 ? 'fa-check-circle' : enc.estatus == 3 ? 'fa-times-circle' : 'fa-info-circle';
                    const msg = enc.estatus == 2
                        ? 'Esta solicitud ya fue <strong>aprobada</strong> y no puede modificarse.'
                        : enc.estatus == 3
                            ? 'Esta solicitud fue <strong>rechazada</strong> y no puede modificarse.'
                            : 'Esta solicitud ya fue procesada.';

                    banner.className = `ya-procesada-banner ${cls}`;
                    banner.innerHTML = `<i class="fas ${ico}" style="font-size:18px;"></i><span>${msg}</span>`;
                }

            } catch (e) { sgToast('Error de conexión: ' + e.message, 'err'); }
        }

        /* ── Flujo ──────────────────────────────────────── */
        function renderFlujo(enc) {
            const pasos = [
                {
                    label: 'Solicitud creada',
                    persona: enc.creador,
                    fecha: enc.fecha,
                    estado: 'done',
                    ico: 'fa-check',
                },
                {
                    label: 'Revisión — Aprobador asignado',
                    persona: enc.aprobador,
                    fecha: enc.estatus == 2 || enc.estatus == 3 ? enc.fecha_captura : null,
                    estado: enc.estatus == 2 ? 'done' : enc.estatus == 3 ? 'rejected' : 'pending',
                    ico: enc.estatus == 2 ? 'fa-check' : enc.estatus == 3 ? 'fa-times' : 'fa-clock',
                },
            ];

            const labelEstado = { done: 'Completado', pending: 'En espera', waiting: 'Sin iniciar', rejected: 'Rechazado' };
            const bgColor = { done: 'var(--ok-lt)', rejected: 'var(--danger-lt)', pending: 'var(--warn-lt)', waiting: 'var(--slate-100)' };
            const txtColor = { done: '#065f46', rejected: '#991b1b', pending: '#92400e', waiting: 'var(--slate-600)' };

            setHtml('md-flujo-panel',
                `<div class="aprov-title"><i class="fas fa-route"></i> Flujo de autorización</div>` +
                pasos.map(p => `
                    <div class="aprov-step">
                        <div class="aprov-icon ${p.estado}"><i class="fas ${p.ico}"></i></div>
                        <div style="flex:1;">
                            <div class="aprov-step-name">${esc(p.label)}</div>
                            <div class="aprov-step-meta">
                                ${esc(p.persona || '—')}
                                ${p.fecha ? ` · ${dateFormatter(p.fecha)}` : ''}
                                <span class="sg-badge ms-2"
                                      style="font-size:8px;padding:1px 6px;
                                             background:${bgColor[p.estado]};
                                             color:${txtColor[p.estado]};">
                                    ${labelEstado[p.estado]}
                                </span>
                            </div>
                        </div>
                    </div>`).join('')
            );
        }

        /* ── Archivos ───────────────────────────────────── */
        function renderArchivos(archivos) {
            const body = $el('md-archivos-body');
            if (!archivos.length) {
                body.innerHTML = `<p style="color:var(--slate-400);font-size:12px;padding:8px 0;">Sin archivos adjuntos registrados.</p>`;
                return;
            }
            const extIcon = ext => {
                ext = (ext || '').toLowerCase().replace('.', '');
                if (ext === 'pdf') return 'fa-file-pdf';
                if (['jpg', 'jpeg', 'png', 'webp'].includes(ext)) return 'fa-file-image';
                if (['xlsx', 'xls'].includes(ext)) return 'fa-file-excel';
                return 'fa-file-alt';
            };
            body.innerHTML = archivos.map(a => `
                <div class="file-row">
                    <i class="fas ${extIcon(a.extencion)}" style="color:var(--warn);"></i>
                    <span class="file-name">${esc(a.nombre_original || 'Archivo')}</span>
                    <span class="file-size">${esc(a.extencion || '')}</span>
                    <a href="/Gastos/DescargarArchivo?uuid=${esc(a.uuid)}&ext=${esc(a.extencion)}"
                       class="btn-sg btn-sg-ghost btn-sg-sm" target="_blank">
                        <i class="fas fa-download"></i> Descargar
                    </a>
                </div>`).join('');
        }

        /* ── Historial ──────────────────────────────────── */
        function renderHistorial(historial) {
            const body = $el('md-historial-body');
            if (!historial.length) {
                body.innerHTML = `<p style="color:var(--slate-400);font-size:12px;">Sin acciones registradas aún.</p>`;
                return;
            }
            body.innerHTML = historial.map(h => {
                const ini = (h.usuario || '?').split(' ').map(p => p[0]).join('').slice(0, 2).toUpperCase();
                const cls = { Aprobado: 'aprobado', Rechazado: 'rechazado', Comentario: 'comentario' }[h.accion] || 'comentario';
                return `
                    <div class="hist-item">
                        <div class="hist-avatar">${esc(ini)}</div>
                        <div style="flex:1;">
                            <div>
                                <span class="hist-name">${esc(h.usuario || '—')}</span>
                                <span class="hist-date">${dateFormatter(h.fecha)}</span>
                                ${h.accion ? `<span class="hist-action-badge ${cls}">${esc(h.accion)}</span>` : ''}
                            </div>
                            ${h.comentario ? `<div class="hist-body">${esc(h.comentario)}</div>` : ''}
                        </div>
                    </div>`;
            }).join('');
        }

        /* ══════════════════════════════════════════════════
           PROCESAR DECISIÓN
        ══════════════════════════════════════════════════ */
        async function procesarDecision(accion) {
            const comentario = ($el('aprov-comentario')?.value || '').trim();

            if (accion === 'rechazar' && !comentario) {
                sgToast('El motivo de rechazo es obligatorio', 'err');
                $el('aprov-comentario')?.focus();
                return;
            }

            // Confirmación para aprobar/rechazar
            if (accion === 'aprobar' || accion === 'rechazar') {
                const msgConf = accion === 'aprobar'
                    ? `¿Confirmas la aprobación de la solicitud ${S.folioActual}?`
                    : `¿Confirmas el rechazo de la solicitud ${S.folioActual}?\nMotivo: ${comentario}`;
                if (!confirm(msgConf)) return;
            }

            const btnId = accion === 'aprobar' ? 'btn-aprobar' : accion === 'rechazar' ? 'btn-rechazar' : null;
            const btn = btnId ? $el(btnId) : null;
            const origHtml = btn?.innerHTML;

            try {
                if (btn) { btn.disabled = true; btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Procesando…'; }

                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                const body = new URLSearchParams({
                    id: S.idActual,
                    accion: accion,
                    comentario: comentario,
                });
                if (token) body.append('__RequestVerificationToken', token.value);

                const res = await fetch('/Gastos/ProcesarDecision', { method: 'POST', body });
                const result = await res.json();

                if (!result.success) { sgToast(result.message || 'Error al procesar', 'err'); return; }

                const label = { aprobar: 'aprobada ✅', rechazar: 'rechazada ❌', comentar: 'comentada 💬' };
                sgToast(`Solicitud ${result.folio} ${label[accion]} correctamente`, 'ok');

                S.bsModal?.hide();
                recargarTabla();

            } catch (e) {
                sgToast('Error de conexión: ' + e.message, 'err');
            } finally {
                if (btn) { btn.disabled = false; btn.innerHTML = origHtml; }
            }
        }

        /* ══════════════════════════════════════════════════
           TABS DEL MODAL
        ══════════════════════════════════════════════════ */
        function showMdTab(tabId, btn, force = false) {
            document.querySelectorAll('.md-tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.md-tab-btn').forEach(b => b.classList.remove('active'));
            $el(tabId)?.classList.add('active');
            if (btn) {
                btn.classList.add('active');
            } else {
                // Activar el btn correspondiente
                document.querySelectorAll('.md-tab-btn').forEach(b => {
                    if ((b.getAttribute('onclick') || '').includes(tabId)) b.classList.add('active');
                });
            }
        }
    </script>
}
