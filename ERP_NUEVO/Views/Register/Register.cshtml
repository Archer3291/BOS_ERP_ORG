@model BOS_ERP.Models.RegisterViewModel
@{
    ViewBag.Title = "Crear Cuenta";
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <title>Crear Cuenta — BCS ERP</title>
    <link rel="shortcut icon" href="~/content/img/@Context.Session.GetString("EmpresaFactura")/logo.png" />
    <link href="~/content/fontawesome-pro-6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;400;500;600&display=swap" />

    <style>
            *, *::before, *::after {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            :root {
                --bcs-teal: #1D9E75;
                --bcs-teal-dark: #0f6e52;
                --bcs-blue: #1a2d6b;
                --bcs-blue-mid: #2F6FED;
                --dark-bg: #080e1a;
                --dark-panel: rgba(9, 14, 28, 0.97);
                --glass-border: rgba(255, 255, 255, 0.08);
                --text-primary: #eef2ff;
                --text-muted: rgba(180, 200, 240, 0.48);
                --text-label: rgba(180, 200, 240, 0.52);
                --input-bg: rgba(255, 255, 255, 0.05);
                --input-border: rgba(255, 255, 255, 0.10);
                --input-focus-border: rgba(29, 158, 117, 0.6);
                --input-focus-shadow: rgba(29, 158, 117, 0.11);
                --section-color: rgba(29, 158, 117, 0.8);
            }

            html {
                min-height: 100%;
            }

            body {
                font-family: 'DM Sans', sans-serif;
                min-height: 100vh;
                background: var(--dark-bg);
                overflow-x: hidden;
                position: relative;
            }

            #canvas-bg {
                position: fixed;
                inset: 0;
                z-index: 0;
                pointer-events: none;
            }

            .page-wrapper {
                position: relative;
                z-index: 1;
                min-height: 100vh;
                display: flex;
                flex-direction: column;
                align-items: center;
                padding: 32px 20px 40px;
            }

            .top-brand {
                width: 100%;
                max-width: 880px;
                background: #121e39;
                border-radius: 18px 18px 0 0;
                border-bottom: none;
                padding: 20px 32px;
                display: flex;
                align-items: center;
                gap: 18px;
                position: relative;
                overflow: hidden;
            }

                .top-brand::before {
                    content: '';
                    position: absolute;
                    right: -40px;
                    top: -40px;
                    width: 180px;
                    height: 180px;
                    border-radius: 50%;
                    background: radial-gradient(circle, rgba(29,158,117,0.1) 0%, transparent 65%);
                    pointer-events: none;
                }

            .top-brand-logo {
                height: 58px;
                width: auto;
                object-fit: contain;
                position: relative;
                z-index: 1;
                flex-shrink: 0;
            }

            .top-brand-sep {
                width: 1px;
                height: 44px;
                background: linear-gradient(to bottom, transparent, #c8d5ef, transparent);
                flex-shrink: 0;
            }

            .top-brand-text {
                position: relative;
                z-index: 1;
            }

                .top-brand-text h2 {
                    font-size: 15px;
                    font-weight: 600;
                    color: #fff;
                    margin-bottom: 3px;
                }

                .top-brand-text p {
                    font-size: 12px;
                    color: #7a90b8;
                }

            .reg-card {
                width: 100%;
                max-width: 880px;
                background: var(--dark-panel);
                border: 0.5px solid var(--glass-border);
                border-top: none;
                border-radius: 0 0 20px 20px;
                box-shadow: 0 0 0 0.5px rgba(255,255,255,0.06), 0 28px 75px rgba(0, 0, 0, 0.65);
                overflow: hidden;
            }

            .card-header {
                padding: 24px 36px 20px;
                border-bottom: 0.5px solid var(--glass-border);
                display: flex;
                align-items: center;
                gap: 14px;
            }

            .card-header-icon {
                width: 40px;
                height: 40px;
                background: linear-gradient(135deg, var(--bcs-teal), #1565a8);
                border-radius: 10px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

                .card-header-icon i {
                    font-size: 16px;
                    color: #fff;
                }

            .card-header-text h3 {
                font-size: 16px;
                font-weight: 600;
                color: var(--text-primary);
                margin-bottom: 2px;
            }

            .card-header-text p {
                font-size: 12.5px;
                color: var(--text-muted);
            }

            .card-body {
                padding: 28px 36px 32px;
            }

            .validation-summary-errors {
                background: rgba(220, 53, 69, 0.1);
                border: 0.5px solid rgba(220, 53, 69, 0.3);
                border-radius: 10px;
                color: #ff8a97;
                font-size: 13px;
                padding: 12px 16px;
                margin-bottom: 20px;
            }

                .validation-summary-errors ul {
                    padding-left: 16px;
                    margin: 0;
                }

            .section-label {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 10px;
                font-weight: 600;
                letter-spacing: 1.4px;
                text-transform: uppercase;
                color: var(--section-color);
                margin-bottom: 18px;
                margin-top: 28px;
            }

                .section-label:first-child {
                    margin-top: 0;
                }

                .section-label i {
                    font-size: 12px;
                }

                .section-label::after {
                    content: '';
                    flex: 1;
                    height: 0.5px;
                    background: linear-gradient(to right, rgba(29,158,117,0.35), transparent);
                }

            .g3 {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 16px;
            }

            .g2 {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 16px;
            }

            .g21 {
                display: grid;
                grid-template-columns: 2fr 1fr;
                gap: 16px;
            }

            .field {
            }

                .field label {
                    display: block;
                    font-size: 10.5px;
                    font-weight: 500;
                    color: var(--text-label);
                    letter-spacing: 0.6px;
                    text-transform: uppercase;
                    margin-bottom: 7px;
                }

            .field-inner {
                position: relative;
            }

            .fi {
                position: absolute;
                left: 13px;
                top: 50%;
                transform: translateY(-50%);
                color: rgba(180, 200, 240, 0.28);
                font-size: 13px;
                pointer-events: none;
                z-index: 2;
            }

            .field-inner input,
            .field-inner select {
                width: 100%;
                background: var(--input-bg);
                border: 0.5px solid var(--input-border);
                border-radius: 10px;
                padding: 11px 14px 11px 36px;
                color: var(--text-primary);
                font-family: 'DM Sans', sans-serif;
                font-size: 13.5px;
                outline: none;
                transition: border-color .2s, background .2s, box-shadow .2s;
                -webkit-appearance: none;
                appearance: none;
            }

                .field-inner input::placeholder {
                    color: rgba(180, 200, 240, 0.18);
                }

                .field-inner input:focus,
                .field-inner select:focus {
                    border-color: var(--input-focus-border);
                    background: rgba(29, 158, 117, 0.05);
                    box-shadow: 0 0 0 3px var(--input-focus-shadow);
                }

                .field-inner select option {
                    background: #111b30;
                    color: var(--text-primary);
                }

            .toggle-pass {
                position: absolute;
                right: 11px;
                top: 50%;
                transform: translateY(-50%);
                background: transparent;
                border: none;
                padding: 0;
                cursor: pointer;
                color: rgba(180, 200, 240, 0.28);
                font-size: 13px;
                z-index: 2;
                transition: color .2s;
                line-height: 1;
            }

                .toggle-pass:hover {
                    color: var(--bcs-teal);
                }

            .has-toggle {
                padding-right: 36px;
            }

            .email-wrap {
                position: relative;
            }

                .email-wrap input {
                    padding-right: 158px;
                }

            .email-suffix {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                font-size: 12px;
                color: rgba(180, 200, 240, 0.3);
                pointer-events: none;
                white-space: nowrap;
                font-family: 'DM Sans', sans-serif;
            }

            .field-validation-error,
            .val-error {
                display: block;
                font-size: 11px;
                color: #ff8a97;
                margin-top: 4px;
            }

            .card-footer {
                display: flex;
                align-items: center;
                justify-content: space-between;
                padding: 20px 36px 28px;
                border-top: 0.5px solid var(--glass-border);
                margin-top: 24px;
                flex-wrap: wrap;
                gap: 14px;
            }

            .login-link {
                font-size: 13px;
                color: var(--text-muted);
            }

                .login-link a {
                    color: var(--bcs-blue-mid);
                    text-decoration: none;
                    font-weight: 500;
                    transition: color .2s;
                }

                    .login-link a:hover {
                        color: #5a9fff;
                    }

            .btn-register {
                padding: 13px 32px;
                background: linear-gradient(135deg, var(--bcs-teal) 0%, #1565a8 100%);
                border: none;
                border-radius: 10px;
                color: #fff;
                font-family: 'DM Sans', sans-serif;
                font-size: 14px;
                font-weight: 600;
                letter-spacing: 0.3px;
                cursor: pointer;
                transition: opacity .2s, transform .15s, box-shadow .2s;
                box-shadow: 0 6px 20px rgba(29, 158, 117, 0.38);
                display: flex;
                align-items: center;
                gap: 8px;
            }

                .btn-register:hover {
                    opacity: .91;
                    transform: translateY(-1px);
                    box-shadow: 0 10px 28px rgba(29, 158, 117, 0.48);
                }

                .btn-register:active {
                    transform: translateY(0);
                }

            @@media (max-width: 700px) {
                .g3, .g2, .g21 {
                    grid-template-columns: 1fr;
                }

                .card-body {
                    padding: 22px 20px 26px;
                }

                .card-header {
                    padding: 20px;
                }

                .card-footer {
                    flex-direction: column;
                    padding: 18px 20px 22px;
                }

                .btn-register {
                    width: 100%;
                    justify-content: center;
                }

                .top-brand {
                    padding: 16px 20px;
                    border-radius: 14px 14px 0 0;
                }
            }
    </style>
</head>

<body>
    <canvas id="canvas-bg"></canvas>
    <div class="page-wrapper">
        <div class="top-brand">
            <img class="top-brand-logo" src="~/content/img/intro_erp.png" alt="BCS ERP" />
            <div class="top-brand-sep"></div>
            <div class="top-brand-text">
                <h2>Business Operation System — BOS ERP</h2>
                <p>Plataforma empresarial integrada — Crear nueva cuenta</p>
            </div>
        </div>

        <div class="reg-card">
            <div class="card-header">
                <div class="card-header-icon">
                    <i class="fa-solid fa-user-plus"></i>
                </div>
                <div class="card-header-text">
                    <h3>Crear cuenta</h3>
                    <p>Completa el formulario para registrarte en el sistema</p>
                </div>
            </div>

            @using (Html.BeginForm("Register", "Register", FormMethod.Post, new { role = "form", autocomplete = "off" }))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.RolId)

                <div class="card-body">

                    @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                    <div class="section-label">
                        <i class="fa-solid fa-user-lock"></i>
                        Credenciales de acceso
                    </div>

                    <div class="g3">
                        <div class="field">
                            <label>Nombre de usuario</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-user fi"></i>
                                @Html.TextBoxFor(m => m.NombreUsuario, new
                                {
                                    placeholder = "usuario",
                                    autocomplete = "username"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.NombreUsuario, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field">
                            <label>Contraseña</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-lock fi"></i>
                                @Html.PasswordFor(m => m.Contrasena, new
                                {
                                    @class = "has-toggle",
                                    id = "password-input",
                                    placeholder = "••••••••",
                                    autocomplete = "new-password"
                                })
                                <button type="button" class="toggle-pass" id="toggle-pass1" aria-label="Mostrar contraseña">
                                    <i class="fa-solid fa-eye" id="icon-pass1"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Contrasena, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field">
                            <label>Confirmar contraseña</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-lock-keyhole fi"></i>
                                @Html.PasswordFor(m => m.ConfirmarContrasena, new
                                {
                                    @class = "has-toggle",
                                    id = "confirm-pass-input",
                                    placeholder = "••••••••",
                                    autocomplete = "new-password"
                                })
                                <button type="button" class="toggle-pass" id="toggle-pass2" aria-label="Mostrar contraseña">
                                    <i class="fa-solid fa-eye" id="icon-pass2"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.ConfirmarContrasena, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:26px;">
                        <i class="fa-solid fa-id-card"></i>
                        Información personal
                    </div>

                    <div class="g3">
                        <div class="field">
                            <label>Nombre(s)</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-user fi"></i>
                                @Html.TextBoxFor(m => m.Nombre, new { placeholder = "Juan" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Nombre, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field">
                            <label>Apellido(s)</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-user fi"></i>
                                @Html.TextBoxFor(m => m.Apellido, new { placeholder = "García" })
                            </div>
                            @Html.ValidationMessageFor(m => m.Apellido, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field">
                            <label>Correo electrónico</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-envelope fi"></i>
                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    placeholder = "correo@empresa.com",
                                    type = "email"
                                })
                            </div>
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="section-label" style="margin-top:26px;">
                        <i class="fa-solid fa-building"></i>
                        Información empresarial
                    </div>

                    <div class="g21" style="margin-bottom:16px;">
                        <div class="field">
                            <label>Email del superior</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-user-tie fi"></i>
                                <div class="email-wrap">
                                    <input type="text"
                                           id="superior-email-input"
                                           placeholder="nombre.apellido"
                                           autocomplete="off"
                                           style="padding-left:36px;" />
                                    <span class="email-suffix">@@sellosyretenes.com</span>
                                </div>
                            </div>
                            <input type="hidden" name="SuperiorEmail" id="SuperiorEmail" />
                            <span class="field-validation-valid val-error"
                                  data-valmsg-for="SuperiorEmail"
                                  data-valmsg-replace="true"></span>
                        </div>

                        <div class="field">
                            <label>Empresa</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-building fi"></i>
                                @Html.DropDownListFor(
                                    m => m.EmpresaId,
                                    Model.Empresas,
                                    "Selecciona una opción",
                                    new { @class = "" }
                                )
                            </div>
                            @Html.ValidationMessageFor(m => m.EmpresaId, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                    <div class="g2">
                        <div class="field">
                            <label>Área</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-sitemap fi"></i>
                                @Html.DropDownListFor(
                                    m => m.Id_Area,
                                    Model.Areas,
                                    "Selecciona una opción",
                                    new { @class = "" }
                                )
                            </div>
                            @Html.ValidationMessageFor(m => m.Id_Area, "", new { @class = "field-validation-error" })
                        </div>

                        <div class="field">
                            <label>Sucursal</label>
                            <div class="field-inner">
                                <i class="fa-solid fa-store fi"></i>
                                @Html.DropDownListFor(
                                    m => m.Id_sucursal,
                                    Model.Sucursales,
                                    "Selecciona una opción",
                                    new { @class = "" }
                                )
                            </div>
                            @Html.ValidationMessageFor(m => m.Id_sucursal, "", new { @class = "field-validation-error" })
                        </div>
                    </div>

                </div>

                <div class="card-footer">
                    <div class="login-link">
                        ¿Ya tienes una cuenta?
                        <a href="@Url.Action("Login", "Account")">Inicia sesión aquí</a>
                    </div>
                    <button type="submit" class="btn-register">
                        <i class="fa-solid fa-user-plus"></i>
                        Registrarse
                    </button>
                </div>

            }

        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/bundles/jqueryval"></script>
    <script>
        const ajaxUrl = '@Url.Action("ObtenerSucursalesPorEmpresa", "Catalogos")';
    </script>
    <script src="~/js/register.js"></script>
</body>
</html>
