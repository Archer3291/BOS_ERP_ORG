@model BOS_ERP.Models.Requisicion

@{
    ViewBag.Title = "Editar Requisición";
}

<h2>@ViewBag.Title</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(model => model.Id)

    <!-- Mismo contenido que Create.cshtml -->
    @Html.Partial("_Form", Model)
}

<div>
    @Html.ActionLink("Volver al Listado", "Index")
</div>

@section Scripts {
    <script src="~/bundles/jqueryval"></script>
    <script src="~/Scripts/Requisicion/requisicion-form.js"></script>
}