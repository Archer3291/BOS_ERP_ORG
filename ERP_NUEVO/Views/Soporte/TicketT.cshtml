    <script>
    function editarTicket(id, tituloActual, descripcionActual) {
        const currentTheme = localStorage.getItem('theme') || 'light';
        Swal.fire({
            title: 'Editar Ticket',
            theme: currentTheme,
            html:
                `<form id="swal-edit-form">
                    <div class="mb-3 text-start">
                        <label class="form-label">Asunto</label>
                        <input id="swal-input-titulo" class="form-control" value="" />
                    </div>
                    <div class="text-start">
                        <label class="form-label">Mensaje</label>
                        <textarea id="swal-input-desc" class="form-control" style="background-color: var(--bs-tertiary-bg);color: var(--bs-body-color);" rows="5"></textarea>
                    </div>
                </form>`,
            didOpen: () => {
                // Asignar por propiedad y no dentro del HTML: así el navegador trata
                // el contenido como texto y no como marcado.
                document.getElementById('swal-input-titulo').value = tituloActual ?? '';
                document.getElementById('swal-input-desc').value = descripcionActual ?? '';
            },
            showCancelButton: true,
            confirmButtonText: 'Guardar',
            cancelButtonText: 'Cancelar',
            focusConfirm: false,
            preConfirm: () => {
                const titulo = document.getElementById('swal-input-titulo').value.trim();
                const descripcion = document.getElementById('swal-input-desc').value.trim();

                if (!titulo || !descripcion) {
                    Swal.showValidationMessage('Ambos campos son obligatorios');
                    return false;
                }

                const formData = new FormData();
                formData.append("idTkt", id);
                formData.append("nuevoTitulo", titulo);
                formData.append("nuevaDescripcion", descripcion);
                formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

                return fetch('@Url.Action("ActualizarDatosTicket", "Ticket")', {
                    method: 'POST',
                    body: formData
                })
                .then(response => response.json())
                .then(data => {
                    if (!data.success) {
                        throw new Error(data.message || 'Error al actualizar');
                    }
                    return data;
                })
                .catch(error => {
                    Swal.showValidationMessage(`Error: ${error.message}`);
                });
            }
        }).then((result) => {
            if (result.isConfirmed) {
                Swal.fire({
                    icon: 'success',
                    title: 'Actualizado',
                    text: 'El ticket ha sido actualizado correctamente.',
                    timer: 1500,
                    showConfirmButton: false
                }).then(() => location.reload());
            }
        });
    }
    </script>

