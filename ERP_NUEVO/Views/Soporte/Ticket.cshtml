    <script>
 function editarTicket(id, tituloActual, descripcionActual) {
     const currentTheme = localStorage.getItem('theme') || 'light';
     Swal.fire({
         title: 'Editar Ticket',
         theme: currentTheme,
         html:
             `<form id="swal-edit-form">
                 <div class="mb-3 text-start">
                     <label class="form-label">Asunto</label>
                     <input id="swal-input-titulo" class="form-control" value="" />
                 </div>
                 <div class="text-start">
                     <label class="form-label">Mensaje</label>
                     <textarea id="swal-input-desc" class="form-control" style="background-color: var(--bs-tertiary-bg);color: var(--bs-body-color);" rows="5"></textarea>
                 </div>
             </form>`,
         didOpen: () => {
             // Asignar por propiedad y no dentro del HTML: así el navegador trata
             // el contenido como texto y no como marcado.
             document.getElementById('swal-input-titulo').value = tituloActual ?? '';
             document.getElementById('swal-input-desc').value = descripcionActual ?? '';
         },
         showCancelButton: true,
         confirmButtonText: 'Guardar',
         cancelButtonText: 'Cancelar',
         focusConfirm: false,
         preConfirm: () => {
             const titulo = document.getElementById('swal-input-titulo').value.trim();
             const descripcion = document.getElementById('swal-input-desc').value.trim();

             if (!titulo || !descripcion) {
                 Swal.showValidationMessage('Ambos campos son obligatorios');
                 return false;
             }

             const formData = new FormData();
             formData.append("idTkt", id);
             formData.append("nuevoTitulo", titulo);
             formData.append("nuevaDescripcion", descripcion);
             formData.append("__RequestVerificationToken", document.querySelector('input[name="__RequestVerificationToken"]').value);

             return fetch('@Url.Action("ActualizarDatosTicket", "Ticket")', {
                 method: 'POST',
                 body: formData
             })
             .then(response => response.json())
             .then(data => {
                 if (!data.success) {
                     throw new Error(data.message || 'Error al actualizar');
                 }
                 return data;
             })
             .catch(error => {
                 Swal.showValidationMessage(`Error: ${error.message}`);
             });
         }
     }).then((result) => {
         if (result.isConfirmed) {
             Swal.fire({
                 icon: 'success',
                 title: 'Actualizado',
                 text: 'El ticket ha sido actualizado correctamente.',
                 timer: 1500,
                 showConfirmButton: false
             }).then(() => location.reload());
         }
     });
 }
    </script>

    <script>
        // Los botones de editar ya no llevan onclick con los datos interpolados: se leen
        // de data-* (que Razor codifica como atributo) y se pasan a las funciones tal cual.
        document.addEventListener('DOMContentLoaded', function () {
            document.querySelectorAll('.btn-editar-ticket').forEach(function (b) {
                b.addEventListener('click', function () {
                    editarTicket(b.dataset.id, b.dataset.tit, b.dataset.descr);
                });
            });

            document.querySelectorAll('.btn-editar-respuesta').forEach(function (b) {
                b.addEventListener('click', function () {
                    editarRespuesta(b.dataset.id, b.dataset.coment);
                });
            });
        });
    </script>
    <script>
        // "ver payload" del panel de diagnóstico. El JSON se pinta indentado dentro
        // de un Swal en vez de en la tabla: son varios miles de caracteres y
        // volverían ilegible el hilo del ticket.
        document.querySelectorAll('.tkd-diag__ver').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var crudo = btn.dataset.payload || '';
                var texto;

                try {
                    texto = JSON.stringify(JSON.parse(crudo), null, 2);
                } catch (e) {
                    // Un payload que no parsea igual se muestra: es diagnóstico, y
                    // verlo crudo vale más que un mensaje de error encima del error.
                    texto = crudo;
                }

                var pre = document.createElement('pre');
                pre.className = 'tkd-diag__payload';
                pre.textContent = texto;   // textContent, no innerHTML: el payload
                                           // lleva texto que escribió el usuario.

                _Swal.fire({
                    title: 'Detalle del error',
                    html: pre.outerHTML,
                    width: '52rem',
                    confirmButtonText: 'Cerrar'
                });
            });
        });
    </script>
