<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dashboard de Tickets Mejorado</title>
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
</head>
<body>

    <div class="container my-5">
        <h2 class="mb-4">Dashboard de Tickets</h2>
        <!-- Indicadores -->
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card shadow-2-strong text-center p-3">
                    <i class="material-icons text-primary">inbox</i>
                    <h5>Total Tickets</h5>
                    <h3 id="totalTickets">0</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-2-strong text-center p-3">
                    <i class="material-icons text-warning">hourglass_top</i>
                    <h5>Tickets Pendientes</h5>
                    <h3 id="ticketsPendientes">0</h3>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-2-strong text-center p-3">
                    <i class="material-icons text-success">check_circle</i>
                    <h5>Tickets Resueltos</h5>
                    <h3 id="ticketsResueltos">0</h3>
                </div>
            </div>
        </div>
        <!-- Filtros -->
        <div class="card shadow-3 mb-4">
            <div class="card-body">
                <h5 class="card-title mb-4">
                    <i class="fas fa-filter me-2 text-primary"></i>Filtros de búsqueda
                </h5>
                <div class="row g-3 align-items-end">
                    <!-- Estado - Form Floating -->
                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filtroEstado1" aria-label="Estado">
                                <option value="">Todos</option>
                                <option value="1">Crítico</option>
                                <option value="2">Pendiente</option>
                                <option value="3">Resuelto</option>
                            </select>
                            <label for="filtroEstado1">Estado</label>
                        </div>
                    </div>
                    <!-- Prioridad - Form Floating -->
                    <div class="col-md-3">
                        <div class="form-floating">
                            <select class="form-select" id="filtroPrioridad1" aria-label="Prioridad">
                                <option value="">Todas</option>
                                <option value="1">Alta</option>
                                <option value="2">Media</option>
                                <option value="3">Baja</option>
                            </select>
                            <label for="filtroPrioridad1">Prioridad</label>
                        </div>
                    </div>
                    <!-- Fecha - Se queda igual -->
                    <div class="col-md-6">
                        <label for="tipoFiltroFecha" class="form-label">Tipo de filtro de fecha</label>
                        <select id="tipoFiltroFecha" class="form-select">
                            <option value="dia">Día</option>
                            <option value="mes" selected>Mes</option>
                            <option value="anio">Año</option>
                            <option value="rango">Rango de fechas</option>
                        </select>
                    </div>
                    <div class="col-md-3" id="contenedorFechaSimple">
                        <div class="form-outline">
                            <input type="month" id="filtroFechaMes" class="form-control" />
                            <label class="form-label" for="filtroFechaMes">Mes</label>
                        </div>
                    </div>
                    <div class="col-md-3 d-none" id="contenedorFechaDia">
                        <div class="form-outline">
                            <input type="date" id="filtroFechaDia" class="form-control" />
                            <label class="form-label" for="filtroFechaDia">Día</label>
                        </div>
                    </div>
                    <div class="col-md-3 d-none" id="contenedorFechaAnio">
                        <div class="form-outline">
                            <input type="number" id="filtroFechaAnio" min="2000" max="2100" class="form-control" placeholder="Año" />
                            <label class="form-label" for="filtroFechaAnio">Año</label>
                        </div>
                    </div>
                    <div class="col-md-6 d-none" id="contenedorFechaRango">
                        <div class="row g-2">
                            <div class="col">
                                <div class="form-outline">
                                    <input type="date" id="filtroFechaDesde" class="form-control" />
                                    <label class="form-label" for="filtroFechaDesde">Desde</label>
                                </div>
                            </div>
                            <div class="col">
                                <div class="form-outline">
                                    <input type="date" id="filtroFechaHasta" class="form-control" />
                                    <label class="form-label" for="filtroFechaHasta">Hasta</label>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!-- Botones -->
                    <div class="col-md-3 d-flex gap-2">
                        <button id="btnAplicarFiltros" class="btn btn-primary w-100">
                            <i class="fas fa-search me-1"></i> Aplicar
                        </button>
                        <button id="btnLimpiarFiltros1" class="btn btn-outline-secondary w-100">
                            <i class="fas fa-eraser me-1"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Gráficos -->
        <div class="row mb-4">
            <div class="col-md-6">
                <div class="card p-3 shadow-2-strong">
                    <h5>Tickets por Estado</h5>
                    <canvas id="graficoEstado"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card p-3 shadow-2-strong">
                    <h5>Tickets por Prioridad</h5>
                    <canvas id="graficoPrioridad"></canvas>
                </div>
            </div>
            <div class="col-md-12 mt-4">
                <div class="card p-3 shadow-2-strong">
                    <h5>Tendencia Últimos 7 Días</h5>
                    <canvas id="graficoTendencia"></canvas>
                </div>
            </div>
        </div>
        <!-- Tabla -->
        <div class="card shadow-2-strong p-3">
            <h5>Tickets Recientes</h5>
            <div class="table-responsive-sm">
                        @* createTable (TableBuilder) construye aquí la tabla completa:
           encabezados, buscador, paginación y exportación. Ya no hay <thead>
           que mantener sincronizado con las columnas del JS. *@
        <div id="tablaTicketsAdmin"></div>
            </div>
        </div>
    </div>
    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/Scripts/TableBuilder.js"></script>
<script src="~/Scripts/Soporte/ticket-administracion-informe.js"></script>
</body>
</html>
