
@{
    ViewBag.Title = "Equipo";
    //Layout = "~/Views/Shared/_Layout.cshtml";
}

<head>
    <meta charset="UTF-8" />
    <!-- Formulario oculto para el token anti-falsificación -->
    @*@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "__AjaxAntiForgeryForm" }))
        {
            @Html.AntiForgeryToken()
        }*@

    <script>window.document.title = 'Licencias'</script>
    <!-- DataTables CSS -->
    <link href="https://cdn.datatables.net/2.2.2/css/dataTables.bootstrap5.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/responsive/3.0.4/css/responsive.bootstrap5.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/select/3.0.0/css/select.bootstrap5.css" rel="stylesheet" />
    <link href="https://cdn.datatables.net/buttons/3.2.2/css/buttons.bootstrap5.css" rel="stylesheet" />
    <style>
        .tab-content {
            background-color: var(--bs-tertiary-bg);
            color: var(--bs-body-color);
        }


        /* Encabezado más moderno */
        table.dataTable thead {
            background-color: #0d6efd;
            color: #fff;
        }

        /* Bordes redondeados y sombreado ligero */
        table.dataTable {
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

            /* Hover moderno */
            table.dataTable tbody tr:hover {
                background-color: #f8f9fa;
                transition: background-color 0.3s;
            }

        /* Paginación al estilo MDB */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 50px;
            padding: 0.25rem 0.75rem;
            margin: 0 2px;
            font-weight: 500;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background-color: #0d6efd !important;
                color: white !important;
            }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border-radius: 0.375rem;
            padding: 0.25rem 0.75rem;
            border: 1px solid #ced4da;
        }
    </style>

</head>
<form>
    @Html.AntiForgeryToken()
</form>
<div class="card-header text-bg-primary">
</div>

<div class="card-body">
    <div class="row">
        <div class="table-responsive-sm">
                    @* createTable (TableBuilder) construye aquí la tabla completa:
           encabezados, buscador, paginación y exportación. Ya no hay <thead>
           que mantener sincronizado con las columnas del JS. *@
        <div id="tablaUsuarios"></div>
        </div>
    </div>
</div>


<!-- Modal de Edición -->
<div class="modal fade" id="modalEditarUsuario" tabindex="-1" aria-labelledby="modalEditarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalEditarUsuarioLabel">
                    <i class="fas fa-user-edit me-2"></i>Editar Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formEditarUsuario">
                    <input type="hidden" id="editNombreUsuario">
                    <div class="mb-3">
                        <label for="editNombre" class="form-label">
                            <i class="fas fa-user me-1"></i>Nombre
                        </label>
                        <input type="text" class="form-control" id="editNombre" required>
                    </div>
                    <div class="mb-3">
                        <label for="editEmail" class="form-label">
                            <i class="fas fa-envelope me-1"></i>Email
                        </label>
                        <input type="email" class="form-control" id="editEmail" required>
                    </div>
                    <div class="mb-3">
                        <label for="editRol" class="form-label">
                            <i class="fas fa-user-tag me-1"></i>Rol
                        </label>
                        <select class="form-select" id="editRol" required>
                        </select>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="submit" class="btn btn-primary" form="formEditarUsuario">
                    <i class="fas fa-save me-1"></i>Guardar Cambios
                </button>
            </div>
        </div>
    </div>
</div>


@*
    Categorías que atiende una persona.

    Es la mitad que le faltaba al rol: "Revisor" dice QUÉ puede hacer, esto dice
    DÓNDE. Un resolvedor sólo aparece en el combo de asignación de las categorías
    que tiene marcadas aquí, y sólo ve en Administración los tickets de esas.

    Las categorías que este administrador no maneja llegan deshabilitadas en vez de
    ocultas: esconderlas haría creer que la persona no las atiende.
*@
<div class="modal fade" id="modalCategoriasUsuario" tabindex="-1" aria-labelledby="modalCategoriasUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalCategoriasUsuarioLabel">
                    <i class="fas fa-layer-group me-2"></i>Categorías que atiende
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-3">
                    <strong id="nombreUsuarioCategorias"></strong> recibirá tickets únicamente
                    de las categorías marcadas, y sólo verá esas en Administración.
                </p>
                <div id="listaCategoriasUsuario"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-primary" id="btnGuardarCategoriasUsuario">
                    <i class="fas fa-save me-1"></i>Guardar
                </button>
            </div>
        </div>
    </div>
</div>


<!-- Modal de Confirmación de Eliminación -->
<div class="modal fade" id="modalEliminarUsuario" tabindex="-1" aria-labelledby="modalEliminarUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalEliminarUsuarioLabel">
                    <i class="fas fa-user-minus me-2"></i>Retirar del equipo de soporte
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <p>
                    <i class="fas fa-triangle-exclamation text-warning me-2"></i>
                    ¿Retirar a <strong id="nombreUsuarioEliminar"></strong> del equipo de soporte?
                    Dejará de atender tickets y volverá a ser usuario final.
                    No se elimina su cuenta del ERP, y puedes revertirlo con el botón Editar.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times me-1"></i>Cancelar
                </button>
                <button type="button" class="btn btn-danger" id="btnConfirmarEliminar">
                    <i class="fas fa-user-minus me-1"></i>Retirar
                </button>
            </div>
        </div>
    </div>
</div>


@* jQuery lo carga el layout; volver a cargarlo aquí reemplazaba $ y
   dejaba sin plugins a lo ya inicializado. *@
<script src="~/Scripts/TableBuilder.js"></script>
<script src="~/Scripts/Soporte/ticket-administracion-equipo.js"></script>



