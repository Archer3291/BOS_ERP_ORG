
@{
    ViewBag.Title = "Categorias";
}

<head>

    <style>
        .tab-content {
            background-color: var(--bs-tertiary-bg);
            color: var(--bs-body-color);
        }

        /* Encabezado más moderno */
        table.dataTable thead {
            background-color: #0d6efd;
            color: #fff;
        }

        /* Bordes redondeados y sombreado ligero */
        table.dataTable {
            border-radius: 0.5rem;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.05);
        }

            /* Hover moderno */
            table.dataTable tbody tr:hover {
                background-color: #f8f9fa;
                transition: background-color 0.3s;
            }

        /* Paginación al estilo MDB */
        .dataTables_wrapper .dataTables_paginate .paginate_button {
            border-radius: 50px;
            padding: 0.25rem 0.75rem;
            margin: 0 2px;
            font-weight: 500;
        }

            .dataTables_wrapper .dataTables_paginate .paginate_button.current {
                background-color: #0d6efd !important;
                color: white !important;
            }

        .dataTables_wrapper .dataTables_length select,
        .dataTables_wrapper .dataTables_filter input {
            border-radius: 0.375rem;
            padding: 0.25rem 0.75rem;
            border: 1px solid #ced4da;
        }
    </style>

</head>
<form>
    @Html.AntiForgeryToken()
</form>
<div class="card-header text-bg-primary">
</div>
<div class="card-body">
    <div class="row">
        @*
            Nace oculto y lo enciende el JS si /Categoria/Datos dice que puede crear
            (permisos.puedeCrear, es decir: Sistemas). Al revés -nacer visible y
            esconderlo- el botón parpadearía en cada carga para quien no puede usarlo.

            Esconderlo NO es el control de acceso: quien lo pone es CrearCategoria en
            el servidor. Esto sólo evita ofrecer un camino que termina en rechazo.
        *@
        <div class="d-flex justify-content-end m-2">
            <button id="btnAgregarCategoria" class="btn btn-primary d-none">
                <i class="fas fa-plus me-1"></i> Agregar Categoría
            </button>
        </div>
        <div class="table-responsive-sm">
                    @* createTable (TableBuilder) construye aquí la tabla completa:
           encabezados, buscador, paginación y exportación. Ya no hay <thead>
           que mantener sincronizado con las columnas del JS. *@
        <div id="tablaCategoria"></div>
        </div>
    </div>
</div>

@* jQuery lo carga el layout; volver a cargarlo aquí reemplazaba $ y
   dejaba sin plugins a lo ya inicializado. *@
<script src="~/Scripts/TableBuilder.js"></script>
<script src="~/Scripts/Soporte/ticket-administracion-categoria.js"></script>

