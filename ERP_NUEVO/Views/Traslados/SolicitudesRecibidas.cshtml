                font-size: 18px;
            }
            .detalle-info .info-item {
                display: flex;
                align-items: center;
                margin-bottom: 10px;
                padding: 12px;
                background: var(--bg-gray);
                border-radius: 6px;
                border: 1px solid var(--border-light);
            }
            .detalle-info .info-item i {
                margin-right: 12px;
                width: 18px;
                color: var(--success-color);
            }
            .detalle-info .info-item:last-child {
                margin-bottom: 0;
            }
            .resumen-header {
                margin-bottom: 20px;
            }
            .info-general {
                background: var(--very-light-blue);
                padding: 15px;
                border-radius: 8px;
                border-left: 4px solid var(--primary-blue);
                box-shadow: var(--shadow);
            }
            .info-row {
                display: flex;
                align-items: center;
                margin-bottom: 10px;
                font-size: 14px;
                color: var(--text-dark);
            }
            .info-row:last-child {
                margin-bottom: 0;
            }
            .info-row i {
                margin-right: 12px;
                width: 18px;
                color: var(--primary-blue);
            }
            .divider {
                margin: 20px 0;
                border: none;
                border-top: 1px solid var(--border-light);
            }
            .productos-listados {
                max-height: 300px;
                overflow-y: auto;
                padding-right: 5px;
            }
            .productos-listados::-webkit-scrollbar {
                width: 6px;
            }
            .productos-listados::-webkit-scrollbar-track {
                background: var(--bg-gray);
                border-radius: 3px;
            }
            .productos-listados::-webkit-scrollbar-thumb {
                background: var(--text-light);
                border-radius: 3px;
            }
            .productos-listados::-webkit-scrollbar-thumb:hover {
                background: var(--primary-blue);
            }
            .producto-item {
                padding: 14px;
                margin-bottom: 10px;
                border-radius: 8px;
                border: 1px solid var(--border-light);
