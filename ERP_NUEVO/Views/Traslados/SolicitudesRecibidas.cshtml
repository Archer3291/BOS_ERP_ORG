            const esCompleto = p.cantidad === p.cantidadsolicitada;
            const iconoEstado = esCompleto ? 'fas fa-check-circle' : 'fas fa-exclamation-triangle';
            const estadoClass = esCompleto ? 'completo' : 'parcial';

            html += `
