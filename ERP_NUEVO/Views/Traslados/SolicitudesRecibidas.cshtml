            }
            .producto-item:hover {
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }
            .producto-item.completo {
                background: var(--bg-light);
                border-left: 4px solid var(--success-color);
            }
            .producto-item.parcial {
                background: var(--bg-light);
                border-left: 4px solid var(--warning-color);
            }
