@{
    ViewBag.Title = "SolicitudesRecibidas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Solicitudes Recibidas";
}
<style>
    .contenedor-tabla {
        background: var(--bg-light);
        border-radius: 8px;
        box-shadow: var(--shadow);
        padding: 20px;
        margin: 20px;
    }

    .modern-table {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .table-light {
        background-color: var(--light-blue) !important;
        color: var(--text-dark);
    }

    .btn.sky-500 {
        background-color: var(--accent-blue);
        border-color: var(--accent-blue);
        color: white;
    }

        .btn.sky-500:hover {
            background-color: var(--primary-blue-dark);
            border-color: var(--primary-blue-dark);
        }

    /* Estilos para la sección de surtido */
    .surtir-container {
        background: var(--bg-light);
        border-radius: 8px;
        box-shadow: var(--shadow);
        padding: 25px;
        margin: 20px;
        border-left: 4px solid var(--accent-blue);
    }

    .surtir-header {
        background: linear-gradient(135deg, var(--primary-blue), var(--accent-blue));
        color: white;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 25px;
        box-shadow: var(--shadow-lg);
    }

    .select-solicitud {
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 8px;
        padding: 12px;
        color: var(--text-dark);
        font-size: 16px;
        transition: all 0.3s ease;
    }

        .select-solicitud:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
            outline: none;
        }

    .info-solicitud {
        background: var(--light-blue);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 20px;
        margin-bottom: 25px;
        position: relative;
        overflow: hidden;
    }

        .info-solicitud::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--accent-blue), var(--primary-blue));
        }

    .info-badge {
        display: inline-block;
        background: var(--accent-blue);
        color: white;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        margin-left: 10px;
    }

    .producto-card {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 20px;
        margin-bottom: 15px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .producto-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 4px;
            height: 100%;
            background: var(--accent-blue);
        }

        .producto-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-2px);
            border-color: var(--accent-blue);
        }

    .producto-header {
        display: flex;
        align-items: center;
        margin-bottom: 15px;
    }

    .producto-icon {
        width: 45px;
        height: 45px;
        background: linear-gradient(135deg, var(--accent-blue), var(--primary-blue));
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 18px;
        margin-right: 15px;
    }

    .producto-info h6 {
        color: var(--text-dark);
        font-weight: 600;
        margin: 0;
        font-size: 16px;
    }

    .producto-codigo {
        color: var(--text-light);
        font-size: 13px;
        font-family: 'Courier New', monospace;
        background: var(--very-light-blue);
        padding: 2px 8px;
        border-radius: 4px;
        display: inline-block;
        margin-top: 4px;
    }

    .stock-container {
        display: flex;
        gap: 20px;
        margin: 15px 0;
        padding: 12px;
        background: var(--light-blue);
        border-radius: 8px;
    }

    .stock-item {
        flex: 1;
        text-align: center;
    }

    .stock-label {
        font-size: 12px;
        color: var(--text-light);
        font-weight: 500;
        margin-bottom: 4px;
    }

    .stock-value {
        font-size: 18px;
        font-weight: bold;
    }

    .stock-disponible {
        color: var(--success-color);
    }

    .stock-solicitado {
        color: var(--accent-blue);
    }

    .stock-insuficiente {
        color: var(--danger-color);
    }

    .cantidad-controls {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 20px 0;
        padding: 15px;
        background: var(--bg-gray);
        border-radius: 8px;
    }

    .btn-cantidad {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid;
        transition: all 0.2s ease;
        font-weight: bold;
    }

        .btn-cantidad:hover:not(:disabled) {
            transform: scale(1.05);
        }

    .input-cantidad {
        width: 80px;
        text-align: center;
        border: 2px solid var(--border-light);
        border-radius: 8px;
        padding: 8px;
        font-size: 16px;
        font-weight: bold;
        color: var(--text-dark);
        background: var(--bg-light);
    }

        .input-cantidad:focus {
            border-color: var(--accent-blue);
            outline: none;
            box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
        }

    .unidad-label {
        color: var(--text-light);
        font-weight: 600;
        font-size: 14px;
    }

    .observaciones-producto {
        background: var(--light-blue);
        border-left: 4px solid var(--warning-color);
        padding: 12px 15px;
        border-radius: 0 8px 8px 0;
        margin-top: 10px;
    }

        .observaciones-producto i {
            color: var(--warning-color);
        }

    .alert-stock {
        border-radius: 8px;
        margin-top: 10px;
        border: none;
        font-weight: 500;
    }

    .alert-success {
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.1), rgba(5, 150, 105, 0.1));
        color: var(--success-color);
    }

    .alert-warning {
        background: linear-gradient(135deg, rgba(245, 158, 11, 0.1), rgba(217, 119, 6, 0.1));
        color: var(--warning-color);
    }

    .observaciones-surtido {
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 8px;
        margin-top: 25px;
    }

        .observaciones-surtido textarea {
            background: var(--bg-light);
            border: none;
            color: var(--text-dark);
            resize: vertical;
        }

            .observaciones-surtido textarea:focus {
                box-shadow: none;
                border-color: transparent;
            }

    .botones-accion {
        margin-top: 30px;
        text-align: center;
        padding: 20px;
        background: var(--light-blue);
        border-radius: 8px;
    }

    .btn-action {
        padding: 12px 25px;
        border-radius: 8px;
        font-weight: 600;
        font-size: 14px;
        margin: 0 8px;
        transition: all 0.3s ease;
        border: none;
        position: relative;
        overflow: hidden;
    }

        .btn-action::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .btn-action:hover::before {
            left: 100%;
        }

        .btn-action:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

    .fade-in {
        animation: fadeIn 0.5s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .slide-down {
        animation: slideDown 0.4s ease-out;
    }

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .alert-info {
        position: relative;
        background: var(--light-blue);
        padding: 10px 10px 10px 20px;
        color: var(--text-dark);
    }

        .alert-info::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 5px;
            height: 100%;
            background-color: var(--accent-blue);
        }

    /* Tema oscuro */
    [data-theme="dark"] .select-solicitud {
        background: var(--bg-light);
        color: var(--text-dark);
        border-color: var(--border-light);
    }

    [data-theme="dark"] .info-solicitud {
        background: var(--light-blue);
    }

    [data-theme="dark"] .producto-card {
        background: var(--bg-light);
    }

    [data-theme="dark"] .stock-container {
        background: var(--light-blue);
    }

    [data-theme="dark"] .cantidad-controls {
        background: var(--bg-gray);
    }

    [data-theme="dark"] .input-cantidad {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    [data-theme="dark"] .observaciones-surtido textarea {
        background: var(--bg-light);
        color: var(--text-dark);
    }

    .custom-tom .ts-dropdown {
        z-index: 1056; /* Ejemplo: más alto que modales de Bootstrap (1050) */
    }
</style>

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />

<!-- Tabla de solicitudes -->
<div class="contenedor-tabla">
    <div class="card-body">
        <h5 class="card-title mb-3">
            <i class="fa-solid fa-inbox me-2" style="color: var(--accent-blue);"></i>
            Solicitudes Recibidas
        </h5>
    </div>

    <div class="surtir-header">
        <h4 class="mb-0">
            <i class="fa-solid fa-boxes-stacked me-2"></i>
            Surtir Material de Inventario
        </h4>
        <p class="mb-0 mt-2 opacity-75">Selecciona una solicitud para gestionar el surtido de material</p>
    </div>
    
    <!-- Selector de solicitud -->
    <div class="mb-4 row">
        <div class="col-md-6 col-sm-12">
            <label for="selectSolicitud" class="form-label">
                <i class="fa-solid fa-list me-1"></i>
                Seleccionar Solicitud:
            </label>
            <select class="form-select select-solicitud custom-tom" id="selectSolicitud" onchange="cargarSolicitudSeleccionada()">
                <option value="">-- Seleccione una solicitud --</option>
                @{
                    foreach (var folio in Model["folios"])
                    {
                        <option value="@folio["uuid"]">@folio["folio"]</option>
                    }
                }
            </select>
        </div>
        <div class="col-md-6 col-sm-12">
            <label for="selectSucursal" class="form-label">
                <i class="fa-solid fa-list me-1"></i>
                Seleccionar la sucursal:
            </label>
            <select class="form-select select-solicitud" id="selectSucursal" onchange="cargarSolicitudSeleccionada()">
                <option value="">-- Seleccione una solicitud --</option>
                @{
                    foreach (var sucursal in Model["sucursales"])
                    {
                        if (Convert.ToInt32(sucursal["id_sucursal"]) == Convert.ToInt32(Context.Session.GetInt32("Sucursal")))
                        {
                            <option value="@sucursal["id_sucursal"]" selected>@sucursal["descripcion"]</option>
                        }
                        else
                        {
                            <option value="@sucursal["id_sucursal"]">@sucursal["descripcion"]</option>
                        }
                    }
                }
            </select>
        </div>
    </div>

    <!-- Contenido de la solicitud -->
    <div id="contenidoSolicitud" style="display: none;"></div>
</div>

<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
<script src="~/Scripts/Switch.js"></script>

<script>
    new TomSelect('#selectSolicitud', {
        maxItems: 1,
        create: false,
        sortField: {
            field: "text",
            direction: "asc"
        },
        dropdownParent: 'body',
        render: {
            option: (data, escape) => `<div style="color: var(--text-dark);">${escape(data.text)}</div>`,
            item: (data, escape) =>
                `<div><span style="color:#6C757D;">${escape(data.text)}</span></div>`
        }
    })
    // Variable global para almacenar los datos de la solicitud actual
    let solicitudActual = null;
    let solicitudesData = {};
    let productos = [];

    // Función para cargar la solicitud seleccionada
    async function cargarSolicitudSeleccionada() {
        const select = document.getElementById('selectSolicitud');
        const idSolicitud = select.value;
        const sucursal = document.getElementById('selectSucursal').value;

        if (!idSolicitud) {
            document.getElementById('contenidoSolicitud').style.display = 'none';
            return;
        }

        const solicitud = await GetData({
            path: '/Solicitudes/GetSolicitudData',
            data: {
                uuid: idSolicitud,
                sucursalOrigen: sucursal,
            }
        })

        if (solicitud) {
            mostrarContenidoSolicitud(solicitud);
        } else {
            // Aquí harías la llamada AJAX para cargar los datos
            console.log('Cargar solicitud desde servidor:', idSolicitud);
        }
    }

    // Función para mostrar el contenido de la solicitud
    function mostrarContenidoSolicitud(solicitud) {
        solicitudActual = solicitud;

        const selectSucursal = document.getElementById('selectSucursal')
        const sucursal = selectSucursal.options[selectSucursal.selectedIndex].text;
        const contenido = document.getElementById('contenidoSolicitud');

        let productosHtml = '';
        solicitud.partidas.forEach((producto, index) => {
            productosHtml += crearHtmlProducto(producto, index);
        });

        let fecha;
        if (solicitud.ordenCompra.fch && solicitud.ordenCompra.fch.startsWith("/Date(")) {
            const timestamp = parseInt(solicitud.ordenCompra.fch.match(/\d+/)[0]);
            const date = new Date(timestamp);
            fecha = date.toLocaleDateString('es-MX');
        }

        contenido.innerHTML = `
                        <div class="fade-in">
                            <!-- Información de la solicitud -->
                            <div class="info-solicitud slide-down">
                                <div class="row">
                                    <div>
                                        <h5 class="mb-3">
                                            <i class="fa-solid fa-file-lines me-2" style="color: var(--accent-blue);"></i>
                                            ${solicitud.ordenCompra.folio}
                                            <span class="info-badge">
                                                <i class="fa-solid fa-clock me-1"></i>
                                                ${solicitud.partidas.length} productos
                                            </span>
                                        </h5>
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <strong>
                                                    <i class="fa-solid fa-user me-1" style="color: var(--accent-blue);"></i>
                                                    Solicitante:
                                                </strong> ${solicitud.ordenCompra.solicitante}
                                            </div>
                                            <div class="col-lg-3">
                                                <strong>
                                                    <i class="fa-solid fa-calendar me-1" style="color: var(--accent-blue);"></i>
                                                    Fecha:
                                                </strong> ${fecha}
                                            </div>
                                        </div>
                                        <div class="row">
                                            <div class="col-lg-6">
                                                <strong>
                                                    <i class="fa-solid fa-apartment me-1" style="color: var(--accent-blue);"></i>
                                                    Sucursal origen:
                                                </strong> ${sucursal}
                                            </div>
                                            <div class="col-lg-6">
                                                <strong>
                                                    <i class="fa-solid fa-apartment me-1" style="color: var(--accent-blue);"></i>
                                                    Sucursal destino:
                                                </strong> ${solicitud.ordenCompra.sucursalsolicitante}
                                            </div>
                                        </div>
                                        <div class="row mt-3">
                                            <div class="col-12">
                                                <strong>
                                                    <i class="fa-solid fa-comment-dots me-1" style="color: var(--accent-blue);"></i>
                                                    Observaciones:
                                                </strong> ${solicitud.ordenCompra.coment_aut}
                                            </div>
                                        </div>
                                        <button class="btn blue-500 me-3 mt-3" id="infoAlmacen" onclick="GetInfoGeneral(${solicitudActual.ordenCompra.id_encabezado})">
                                            <i class="fa-solid fa-square-info"></i> Ver informacion completa
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <div class="alert-info mb-4">
                                <p class="mb-1">
                                    <i class="fas fa-info-circle me-2"></i>
                                    El stock disponible es por sucursal, puedes selecciona diferentes sucursales en 'Seleccionar sucursales' para ver el stock de esa sucursal <br>
                                    Sucursal actual: <strong>${sucursal}</strong>
                                </p>
                            </div>

                            <!-- Lista de productos -->
                            <div class="productos-lista">
                                <h6 class="mb-3">
                                    <i class="fa-solid fa-boxes me-2" style="color: var(--accent-blue);"></i>
                                    Productos Solicitados
                                </h6>
                                ${productosHtml}
                            </div>

                            <!-- Observaciones del surtido -->
                            <div class="observaciones-surtido">
                                <div class="p-3">
                                    <label class="form-label">
                                        <i class="fa-solid fa-pen-to-square me-1" style="color: var(--accent-blue);"></i>
                                        Observaciones del Surtido
                                    </label>
                                    <textarea class="form-control" id="observacionesSurtido" rows="3"
                                            placeholder="Ingrese observaciones adicionales sobre el surtido del material..."></textarea>
                                </div>
                            </div>

                            <!-- Botones de acción -->
                            <div class="botones-accion">
                                <button type="button" class="btn btn-outline-secondary btn-action" onclick="limpiarSolicitud()">
                                    <i class="fa-solid fa-times me-1"></i>
                                    Limpiar
                                </button>
                                <button type="button" class="btn btn-success btn-action" onclick="confirmarSurtido()">
                                    <i class="fa-solid fa-check me-1"></i>
                                    Confirmar Surtido Completo
                                </button>
                            </div>
                        </div>
                    `;

        contenido.style.display = 'block';
        initNormalToggles();

        solicitud.partidas.forEach((producto => {

        }))

        obtenerProductosSurtir()
    }

    // Función para crear el HTML de un producto
    function crearHtmlProducto(producto, index) {
        const stockSuficiente = producto.cantidadstock >= producto.cantidadsolicitada;
        const claseStock = stockSuficiente ? 'stock-disponible' : 'stock-insuficiente';
        const maxCantidad = Math.min(producto.cantidadsolicitada, producto.cantidadstock);
        const alertClass = stockSuficiente ? 'text-bg-success' : 'text-bg-danger';
        const alertIcon = stockSuficiente ? 'fa-check-circle' : 'fa-exclamation-triangle';
        const alertText = stockSuficiente ? 'Stock suficiente' : 'Stock insuficiente - ' + producto.cantidadstock + ' ' + producto.ud;
        const hayStock = producto.cantidadstock <= 0 || producto.cantidadstock < producto.cantidadsolicitada;

        return `
                        <div class="producto-card slide-down ${index}" style="animation-delay: ${index * 0.1}s">
                            <div class="producto-header">
                                <div class="producto-icon">
                                    <i class="fa-solid fa-cube"></i>
                                </div>
                                <div class="producto-info">
                                    <h6>${producto.descripcion}</h6>
                                    <div class="producto-codigo">${producto.codigo}</div>
                                    <span class="badge ${alertClass}">
                                        <i class="fa-solid ${alertIcon} me-2"></i>
                                        ${alertText}
                                    </span>
                                </div>
                            </div>

                            <div class="stock-container">
                                <div class="stock-item">
                                    <div class="stock-label">Solicitado</div>
                                    <div class="stock-value stock-solicitado">${producto.cantidadsolicitada} ${producto.ud}</div>
                                </div>
                                <div class="stock-item">
                                    <div class="stock-label">Disponible</div>
                                    <div class="stock-value ${claseStock}">${producto.cantidadstock} ${producto.ud}</div>
                                </div>
                                <div class="stock-item">
                                    <div class="stock-label">A Surtir</div>
                                    <div class="stock-value" id="surtir_${index}" style="color: #8b5cf6;" font-weight: bold;">${maxCantidad} ${producto.ud}</div>
                                </div>
                                <div class="stock-item">
                                    <input type="number" class="input-cantidad d-none"  onchange="validarCantidad(${index})" id="cantidad_${index}" value="${maxCantidad}" min="0" max="${producto.cantidadstock}" ${producto.cantidadstock < producto.cantidadsolicitada ? 'disabled' : ''} disabled>

                                    <div class="bootstrap-toggle toggle-outline toggle-success">
                                        <input type="checkbox" data-index="${index}" onchange="selectLocation(this)" id="agregarProducto_${index}" >
                                        <label for="agregarProducto_${index}" class="toggle-group">
                                            <span class="toggle-on">Surtir</span>
                                            <span class="toggle-handle"></span>
                                            <span class="toggle-off">No surtir</span>
                                        </label>
                                    </div>
                                    <br>
                                </div>
                            </div>
                        </div>
                    `;
    }

    // Función para validar la cantidad ingresada manualmente
    function validarCantidad(index) {
        const cant = document.getElementById(`cantidad_${index}`);
        const producto = solicitudActual.partidas[index];
        let cantidad = parseInt(cant.value);

        if (isNaN(cantidad) || cantidad < 0) cantidad = 0;
        if (cantidad > producto.cantidadstock) cantidad = producto.cantidadstock;

        cant.value = cantidad;
        actualizarVisualizacionCantidad(index, cantidad, producto.ud);
        actualizarBotonesCantidad(index);
    }

    // Función para actualizar la visualización de la cantidad a surtir
    function actualizarVisualizacionCantidad(index, cantidad, ud) {
        const display = document.getElementById(`surtir_${index}`);
        display.textContent = `${cantidad} ${ud}`;

        // Cambiar color según la cantidad
        if (cantidad === 0) {
            display.style.color = 'var(--text-light)';
        } else if (cantidad < solicitudActual.partidas[index].cantidadsolicitada) {
            display.style.color = 'var(--warning-color)';
        } else {
            display.style.color = 'var(--success-color)';
        }
    }

    // Función para actualizar el estado de los botones de cantidad
    function actualizarBotonesCantidad(index) {
        const cant = document.getElementById(`cantidad_${index}`);
        const producto = solicitudActual.partidas[index];
        const cantidad = parseInt(cant.value);

        // Encontrar los botones
        const container = cant.parentElement;
        const btnMenos = container.querySelector('.btn-outline-danger');
        const btnMas = container.querySelector('.btn-outline-success');

        // Actualizar estado de botones
        btnMenos.disabled = cantidad <= 0;
        btnMas.disabled = cantidad >= producto.cantidadstock;
    }

    // Función para limpiar la solicitud actual
    function limpiarSolicitud() {
        productos = [];
        const select = document.getElementById('selectSolicitud');
        select.value = '';
        document.getElementById('contenidoSolicitud').style.display = 'none';
        solicitudActual = null;
    }

    // Función para confirmar surtido con SweetAlert2
    function confirmarSurtido() {
        const observaciones = document.getElementById('observacionesSurtido').value;
        let payload = [];
        let noSurtido = [];
        payload = productos.filter(p => p.surtir == true);
        noSurtido = productos.filter(p => p.surtir == false);

        if (payload.length === 0) {
            _Swal.fire({
                title: 'Sin productos',
                text: 'No hay productos seleccionados para surtir.',
                icon: 'warning',
                confirmButtonText: 'Entendido',
            });
            return;
        }

        payload.forEach(x => {
            if (x.tarima == false) {
                toastMixin.fire({
                    icon: 'error',
                    title: `No se ah seleccionado la ubicacion del producto ${x.nombre}. Es necesario para hacer el movimiento de almacen.`
                });
                throw new Error(`No se ah seleccionado la ubicacion del producto ${x.nombre}. Es necesario para hacer el movimiento de almacen.`);
                return;
            }
        })

        // Verificar si es realmente un surtido completo
        const esCompleto = payload.length == productos.length;
        const tipoSurtido = esCompleto ? 'completo' : 'parcial';
        const resumen = generarResumenSurtido(payload);

        _Swal.fire({
            title: `¿Confirmar surtido?`,
            html: resumen,
            confirmButtonText: 'Sí, confirmar',
            cancelButtonText: 'Cancelar',
            customClass: {
                htmlContainer: 'resumen-surtido'
            },
            preConfirm: () => {
                const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
                    <style>
                        .flip {
                            animation: spinY 2s linear infinite;
                            transform-origin: center;
                        }
                        @@keyframes spinY {
                            0%   { transform: rotateY(0deg); }
                            100% { transform: rotateY(360deg); }
                        }
                    </style>
                    <g class="flip">
                        <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                        <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                        <circle cx="32" cy="48" r="3" fill="#000"/>
                    </g>
                </svg>`;

                let ulocation;
                let id_tarima = null;

                _Swal.fire({
                    iconHtml: warningIcon,
                    title: "¿Esta seguro?",
                    html: `
                        <div>
                            <p>¿Está seguro que desea proceder con el surtido de los productos del documento ${solicitudActual.ordenCompra.folio}?</p>
                            <p>Los productos que no se pudieron surtir quedarán pendientes en una variación de este documento. 
                            Estas variaciones se identifican con el mismo folio y una letra al final.</p>
                        </div>`,
                    footer: "<b style='color: red;'>ADVERTENCIA - Este cambio no se puede revertir</b>",
                    customClass: {
                        icon: "p-0 bg-transparent border-0 shadow-none"
                    },
                    preConfirm: async () => {
                        Swal.fire({
                            title: 'Generando movimiento por favor espere...',
                            allowOutsideClick: false,
                            allowEscapeKey: false,
                            showConfirmButton: false,
                            didOpen: () => {
                                Swal.showLoading();
                            }
                        });

                        await GetData({
                            path: '/Solicitudes/SurtidoCompleto',
                            data: {
                                sucursalOrigen: document.getElementById('selectSucursal').value,
                                encabezado: solicitudActual.ordenCompra.id_encabezado,
                                productos: JSON.stringify(payload),
                                noSurtido: JSON.stringify(noSurtido),
                                observaciones: observaciones,
                                sucursalDestino: solicitudActual.ordenCompra.suc,
                            },
                            swalResponse: true,
                            swalType: 'modal',
                        })

                        //limpiarSolicitud();
                    }
                })
            }
        });
    }


    // Función para obtener los productos a surtir
    function obtenerProductosSurtir() {
        productos = [];

        solicitudActual.partidas.forEach((producto, index) => {
            const cantidad = parseInt(document.getElementById(`cantidad_${index}`).value);
            const porcentajeSurtido = Math.round((cantidad / producto.cantidadsolicitada) * 100);
            //if (porcentajeSurtido === 100) {
            //if (cantidad > 0) {
                productos.push({
                    id_producto: producto.producto_id,
                    codigo: producto.codigo,
                    descripcion: producto.descripcion,
                    cantidad: cantidad,
                    unidad: producto.unidad,
                    id_partida: producto.id_partidas,
                    cantidadsolicitada: producto.cantidadsolicitada,
                    ud: producto.ud,
                    porcentajeSurtido: porcentajeSurtido,
                    surtir: porcentajeSurtido === 100 ? true : false,
                });
            //}
            //}
        });

        return productos;
    }

