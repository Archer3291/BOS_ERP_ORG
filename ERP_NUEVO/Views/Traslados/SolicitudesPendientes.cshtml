    // Funciones de sugerencias almacen
    async function sugerenciasAlmacen(id, indice, cantidad) {
        let disponible = await GetData({
            path: '/Solicitudes/GetInventarioDisponible',
            data: { id, cantidad }
        });

        const producto = productos[indice]; // 👈 producto actual
        if (!producto.tarima) producto.tarima = {}; // asegurar que existe

        let tableHTML = `
        <div style="max-height: 400px; overflow-y: auto; margin: 20px 0;">
            <table class="table table-hover" style="width: 100%; border-collapse: collapse; font-size: 14px;">
                <thead style="background-color: #f8f9fa; position: sticky; top: 0;">
                    <tr>
                        <th>Código</th>
                        <th>Cantidad</th>
                        <th>Tarima</th>
                        <th>Almacen</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>`;

        disponible.data.forEach((item, index) => {
            const codigo = item.codigo || 'Vacío';
            const cant = item.cantidad || 0;
            const almacen = item.almacen || '';
            const ulocation = item.ulocation || '';

            // 🔎 validar si ya está completa la asignación en esta tarima
            const asignada = producto.tarima[item.id_tarima] || 0;
            const disabled = asignada >= cant ? "disabled style='cursor:not-allowed;'" : "";
            let cantCompleta = "";
            if (cant === 0) {
                cantCompleta = "table-danger";
            } else if (cant >= cantidad) {
                cantCompleta = "table-success";
            } else {
                cantCompleta = "table-warning";
            }

            tableHTML += `
            <tr style="background-color: ${index % 2 === 0 ? '#ffffff' : '#f8f9fa'};" class="${cantCompleta}">
                <td>${codigo}</td>
                <td>${cant}</td>
                <td>${ulocation}</td>
                <td>${almacen}</td>
                <td style="text-align:center;">
                    <button
                        id="btn_tarima_${item.id_tarima}_${indice}"
                        onclick="selectLocation(${item.id_tarima}, ${indice}, ${cant}, '${ulocation}')"
                        class="btn btn-sm blue-500" ${disabled}
                        onmouseover="if(!this.disabled) this.style.backgroundColor='#0056b3'"
                        onmouseout="if(!this.disabled) this.style.backgroundColor='#007bff'"
                    >
                        Agregar
                    </button>
                </td>
            </tr>`;
        });

        tableHTML += `
                </tbody>
            </table>
        </div>`;

        _Swal.fire({
            html: `
        <div>
            <h4 style="margin-top: 20px; margin-bottom: 10px;">Stock Disponible:</h4>
            <p style="text-align: left;margin-top: 20px;margin-bottom: 10px;">Selecciona la ubicación donde deseas mover el producto seleccionado.</p>
            ${tableHTML}
        </div>`
        });
    }

    function selectLocation(idTarima, index, cantTarima, ulocation) {
        const producto = productos[index];
        producto.tarima = producto.tarima || {};

        const cantidadSolicitada = Number(
            producto.cantidadsolicitada ??
            producto.cantidadSolicitada ??
            producto.cantidad ??
            0
        );

        const asignado = Object.values(producto.tarima)
            .reduce((acc, v) => acc + Number(v || 0), 0);

        const faltante = cantidadSolicitada - asignado;
        if (faltante <= 0) {
            Swal.fire("Aviso", "Ya se asignó la cantidad solicitada.", "info");
            return;
        }

        const maxPosible = Math.min(Number(cantTarima || 0), faltante);

        _Swal.fire({
            title: `Asignar cantidad de la ubicación ${ulocation}`,
            input: "number",
            inputAttributes: {
                min: 1,
                max: maxPosible,
                step: 'any'
            },
            inputValue: maxPosible,
            showCancelButton: true,
            customClass: {
                input: "lock-min lock-max"
            },
            preConfirm: (value) => {
                const cantidad = Number(value);
                if (isNaN(cantidad) || cantidad <= 0) {
                    Swal.showValidationMessage("Cantidad inválida");
                    return false;
                }
                if (cantidad > maxPosible) {
                    Swal.showValidationMessage(`No puedes asignar más de ${maxPosible}`);
                    return false;
                }
                return cantidad;
            }
        }).then((result) => {
            if (result.isConfirmed) {
                const cantidad = result.value;

                // acumular en la tarima seleccionada
                producto.tarima[idTarima] =
                    (Number(producto.tarima[idTarima]) || 0) + cantidad;

                // 🔹 calcular total surtido de todas las tarimas
                const totalSurtido = Object.values(producto.tarima)
                    .reduce((acc, v) => acc + Number(v || 0), 0);

                // 🔹 deshabilitar botón si ya se agotó esa tarima
                if (producto.tarima[idTarima] >= cantTarima) {
                    const btn = document.getElementById(`btn_tarima_${idTarima}_${index}`);
                    if (btn) {
                        btn.disabled = true;
                        btn.style.backgroundColor = "#6c757d"; // gris
                        btn.style.cursor = "not-allowed";
                        btn.innerText = "Agotado";
                    }
                }

                // 🔹 actualizar DOM con el total surtido
                const surtirLabel = document.getElementById(`surtir_${index}`);
                const colorIdent = document.getElementById(`sugerenciasAlmacen_${index}`)


                producto.cantidad = totalSurtido;
                producto.porcentajeSurtido = Math.round((totalSurtido / cantidadSolicitada) * 100);
                producto.cantidad_pendiente = cantidadSolicitada - totalSurtido;

                if (totalSurtido == producto.cantidadsolicitada) {
                    colorIdent.classList.remove('red-500');
                    colorIdent.classList.remove('orange-500');
                    colorIdent.classList.add('green-500')
                } else if (totalSurtido < producto.cantidadsolicitada) {
                    colorIdent.classList.remove('red-500');
                    colorIdent.classList.remove('green-500')
                    colorIdent.classList.add('orange-500');
                } else if (totalSurtido == 0) {
                    colorIdent.classList.add('red-500');
                    colorIdent.classList.remove('green-500')
                    colorIdent.classList.remove('orange-500');
                }
                if (surtirLabel) {
                    surtirLabel.innerHTML = `${totalSurtido} ${producto.ud}`;
                }
            }
        });
    }
</script>
