@{
    ViewData["Title"] = "Unidades";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Unidades";
}

<div class="contenedor-tabla">
    <div class="container-fluid border-bottom py-2 shadow-sm">
        <div class="d-flex justify-content-between align-items-center px-3">
            <div>
                <button type="button" class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#modalBuscarUnidad">
                    Buscar unidad
                </button>
            </div>
        </div>
    </div>

    <form id="formUnidades">
        <div class="card shadow-3">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="claveUnidad" name="claveUnidad">
                                <option value="">Seleccione</option>
                            </select>
                            <label for="claveUnidad">Clave de unidad</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" class="form-control" id="nombreUnidad" name="nombreUnidad" placeholder="Nombre de la unidad">
                            <label for="nombreUnidad">Nombre de la unidad</label>
                        </div>
                    </div>
                </div>
                <div class="text-end mt-4">
                    <button type="submit" class="btn btn-success btn-lg shadow-2 rounded-circle" title="Guardar">
                        <i class="fas fa-check"></i>
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal Buscar Unidad -->
<div class="modal fade" id="modalBuscarUnidad" tabindex="-1" aria-labelledby="modalBuscarUnidadLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalBuscarUnidadLabel">Buscar Unidad</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <div class="input-group shadow-sm">
                        <input type="text" class="form-control shadow-none" id="inputBuscarUnidad" placeholder="Ej. Kilogramo, Pieza, Litro, etc.">
                        <button class="btn btn-outline-secondary shadow-sm" type="button" id="btnLimpiarResultadosUnidad">
                            <i class="bi bi-x-circle me-1"></i> Limpiar
                        </button>
                    </div>
                </div>

                <div class="border rounded-3 p-2 bg-light-subtle">
                    <ul class="list-group list-group-flush" id="listaResultadosUnidades" style="max-height: 400px; overflow-y: auto;">
                    </ul>
                </div>
            </div>

            <div id="pagination-unidades" class="d-flex justify-content-around mt-3">
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/Scripts/formularios.js"></script>
    <script src="~/Scripts/General/general.js"></script>
    <script src="~/Scripts/Almacen/unidades.js"></script>
}
