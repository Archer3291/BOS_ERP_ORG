@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfo

@{
    ViewData["Title"] = "Verificación de Almacén";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Verificación de Almacén";
}
<style>
    /* ── Layout base ── */
    .vi-page {
        background: var(--bg-gray);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    .vi-card {
        background: var(--bg-light);
        border-radius: var(--table-radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .vi-section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-bottom: .75rem;
        border-bottom: 2px solid var(--light-blue);
        margin-bottom: 1.25rem;
    }

    .vi-section-icon {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 10px;
        background: var(--primary-blue);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .vi-section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
    }

    .vi-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--text-light);
        margin-bottom: .3rem;
        display: block;
    }

        .vi-label i {
            color: var(--accent-blue);
            margin-right: .3rem;
        }

    .vi-control {
        border: 1.5px solid var(--border-light);
        border-radius: var(--row-radius);
        padding: .65rem 1rem;
        font-size: .9rem;
        background: var(--very-light-blue);
        color: var(--text-dark);
        width: 100%;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

        .vi-control:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            outline: none;
            background: var(--bg-light);
        }

        .vi-control[readonly] {
            background: var(--bg-gray);
            cursor: default;
        }

    /* ── Botones ── */
    .vi-btn {
        border: none;
        border-radius: var(--row-radius);
        padding: .6rem 1.25rem;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .vi-btn:hover {
            transform: translateY(-1px);
        }

        .vi-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none !important;
        }

    .vi-btn-primary {
        background: var(--primary-blue);
        color: #fff;
    }

        .vi-btn-primary:hover {
            background: var(--primary-blue-dark);
            box-shadow: 0 4px 14px rgba(30,58,95,.3);
        }

    .vi-btn-success {
        background: var(--success-color);
        color: #fff;
    }

        .vi-btn-success:hover {
            background: #047857;
            box-shadow: 0 4px 14px rgba(5,150,105,.3);
        }

    .vi-btn-danger {
        background: var(--danger-color);
        color: #fff;
        padding: .35rem .75rem;
        font-size: .8rem;
    }

        .vi-btn-danger:hover {
            background: #b91c1c;
        }

    .vi-btn-outline {
        background: transparent;
        color: var(--accent-blue);
        border: 1.5px solid var(--accent-blue);
    }

        .vi-btn-outline:hover {
            background: var(--accent-blue);
            color: #fff;
        }

    .vi-btn-ghost {
        background: transparent;
        color: var(--danger-color);
        border: 1.5px solid var(--danger-color);
    }

        .vi-btn-ghost:hover {
            background: var(--danger-color);
            color: #fff;
        }

    .vi-btn-amber {
        background: var(--warning-color);
        color: #fff;
    }

        .vi-btn-amber:hover {
            background: #b45309;
            box-shadow: 0 4px 14px rgba(217,119,6,.3);
        }

    /* ── Tabla ── */
    .vi-table-wrap {
        border-radius: var(--row-radius);
        border: 1px solid var(--border-light);
        overflow: hidden;
        overflow-x: auto;
        max-height: 540px;
        overflow-y: auto;
    }

    .vi-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1000px;
        font-size: .82rem;
    }

        .vi-table thead {
            background: var(--primary-blue);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .vi-table th {
            padding: .65rem .6rem;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
        }

        .vi-table td {
            padding: .65rem .6rem;
            border-bottom: 1px solid var(--border-light);
            vertical-align: middle;
            color: var(--text-dark);
        }

        .vi-table tbody tr:hover {
            background: var(--light-blue);
        }

    .vi-table-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-light);
    }

        .vi-table-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: .75rem;
            opacity: .35;
        }

    /* ── Resumen ── */
    .vi-summary-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .55rem 0;
        border-bottom: 1px dashed var(--border-light);
        font-size: .85rem;
    }

        .vi-summary-row:last-child {
            border-bottom: none;
        }

    .vi-summary-label {
        color: var(--text-light);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vi-summary-val {
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: var(--text-dark);
    }

    /* ── Badges ── */
    .vi-ver-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .2rem .6rem;
        border-radius: var(--badge-radius);
    }

        .vi-ver-badge.ok {
            background: #d1fae5;
            color: var(--success-color);
        }

        .vi-ver-badge.parcial {
            background: #fef3c7;
            color: var(--warning-color);
        }

        .vi-ver-badge.pendiente {
            background: #fee2e2;
            color: var(--danger-color);
        }

    /* ── Filas coloreadas ── */
    tr.fila-verificada td {
        background: rgba(5,150,105,.06) !important;
    }

    tr.fila-parcial td {
        background: rgba(217,119,6,.06) !important;
    }

    /* ── Input cantidad ── */
    .vi-ver-qty {
        width: 100%;
        min-width: 80px;
        border: 1.5px solid var(--border-light);
        border-radius: 7px;
        padding: .35rem .6rem;
        font-size: .82rem;
        background: var(--very-light-blue);
        color: var(--text-dark);
        transition: border-color var(--transition-fast);
    }

        .vi-ver-qty:focus {
            border-color: var(--accent-blue);
            outline: none;
            background: var(--bg-light);
        }

        .vi-ver-qty.excede {
            border-color: var(--danger-color);
            background: #fee2e2;
        }

        .vi-ver-qty:disabled {
            background: var(--border-light);
            cursor: not-allowed;
        }

    /* ── Barra de progreso ── */
    .vi-progress-wrap {
        height: 6px;
        border-radius: 99px;
        background: var(--border-light);
        overflow: hidden;
        margin-top: 4px;
    }

    .vi-progress-bar {
        height: 100%;
        border-radius: 99px;
        transition: width .4s;
    }

    /* ════════════════════════════════════════════
       EXISTENCIA POR ALMACÉN
    ════════════════════════════════════════════ */
    .vi-stock-wrap {
        position: relative;
        display: inline-flex;
        flex-direction: column;
        align-items: center;
    }

    .vi-stock-badge-wrap {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        cursor: pointer;
    }

    .vi-stock-total-badge {
        display: inline-block;
        padding: 3px 11px;
        border-radius: 6px;
        font-weight: 700;
        font-size: .8rem;
        min-width: 46px;
        text-align: center;
        letter-spacing: .3px;
    }

    .vi-stock-expand-icon {
        font-size: .65rem;
        color: var(--text-light);
        transition: transform var(--transition-fast);
    }

    .vi-stock-detail-popup {
        display: none;
        position: absolute;
        top: calc(100% + 6px);
        left: 50%;
        transform: translateX(-50%);
        z-index: 100;
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 10px;
        box-shadow: var(--shadow-lg);
        min-width: 220px;
        overflow: hidden;
    }

    .vi-stock-wrap:hover .vi-stock-detail-popup,
    .vi-stock-wrap:focus .vi-stock-detail-popup,
    .vi-stock-wrap:focus-within .vi-stock-detail-popup {
        display: block;
    }

    .vi-stock-wrap:hover .vi-stock-expand-icon {
        transform: rotate(180deg);
    }

    .vi-stock-popup-header {
        background: var(--primary-blue);
        color: #fff;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: 6px 12px;
    }

    .vi-stock-alm-row {
        display: grid;
        grid-template-columns: 70px 1fr auto;
        align-items: center;
        gap: 6px;
        padding: 5px 12px;
        border-bottom: 1px solid var(--border-light);
        font-size: .75rem;
    }

        .vi-stock-alm-row:last-of-type {
            border-bottom: none;
        }

    .vi-stock-alm-cve {
        font-family: monospace;
        font-weight: 700;
        color: var(--primary-blue);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vi-stock-alm-name {
        color: var(--text-light);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .vi-stock-alm-qty {
        font-weight: 700;
        color: var(--text-dark);
        text-align: right;
        white-space: nowrap;
    }

    .vi-stock-popup-total {
        display: flex;
        justify-content: space-between;
        padding: 6px 12px;
        background: var(--bg-gray);
        font-size: .75rem;
        font-weight: 700;
        color: var(--text-dark);
        border-top: 2px solid var(--border-light);
    }

    .vi-stock-empty {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #fee2e2;
        color: var(--danger-color);
        font-size: .72rem;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: 6px;
    }

    /* ════════════════════════════════════════════
       DISCREPANCIA FÍSICA
    ════════════════════════════════════════════ */
    .vi-disc-tag {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: #fef3c7;
        color: var(--warning-color);
        border: 1px solid var(--warning-color);
        font-size: .7rem;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 6px;
        margin-bottom: 4px;
        white-space: nowrap;
    }

    .vi-disc-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .75rem;
        margin-bottom: 1rem;
    }

    .vi-disc-info-item {
        background: var(--bg-gray);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: .6rem .9rem;
    }

    .vi-disc-info-label {
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: var(--text-light);
        margin-bottom: 2px;
    }

    .vi-disc-info-val {
        font-size: 1.1rem;
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: var(--text-dark);
    }

    /* ── Modal general ── */
    .vi-modal-header {
        background: var(--primary-blue);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vi-modal-header .btn-close {
            filter: invert(1);
        }

    .vi-search-item {
        padding: .7rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border-light);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .vi-search-item:hover {
            border-color: var(--accent-blue);
            background: var(--light-blue);
            transform: translateX(3px);
        }

    /* ── Botón flotante ── */
    .vi-floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--primary-blue);
        color: #fff;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(30,58,95,.4);
        transition: transform var(--transition-med), box-shadow var(--transition-med);
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .vi-floating-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(30,58,95,.5);
        }

    .vi-floating-tooltip {
        position: fixed;
        bottom: 38px;
        right: 96px;
        background: var(--dark-blue);
        color: #fff;
        padding: .4rem .9rem;
        border-radius: 8px;
        font-size: .8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition-med);
        z-index: 999;
    }

    .vi-floating-btn:hover + .vi-floating-tooltip {
        opacity: 1;
    }

    /* ── Etiquetas de impresión ── */
    @@media print {
        body * {
            visibility: hidden;
        }

        #vi-ver-etiquetas-container, #vi-ver-etiquetas-container * {
            visibility: visible;
        }

        #vi-ver-etiquetas-container {
            position: absolute;
            left: 0;
            top: 0;
            width: 100%;
        }

        .vi-etiqueta {
            page-break-inside: avoid;
            margin-bottom: 0;
        }

        .no-print {
            display: none !important;
        }
    }

    .vi-etiqueta {
        border: 2px solid var(--primary-blue);
        border-radius: 8px;
        padding: 12px 16px;
        margin-bottom: 12px;
        font-family: 'Courier New', monospace;
        font-size: .82rem;
    }

    .vi-etiqueta-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding-bottom: 6px;
        margin-bottom: 8px;
        border-bottom: 1px solid var(--light-blue);
    }

    .vi-etiqueta-folio {
        font-size: 1rem;
        font-weight: 700;
        color: var(--primary-blue);
    }

    .vi-etiqueta-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px 16px;
    }

    .vi-etiqueta-field {
        font-size: .78rem;
    }

        .vi-etiqueta-field span {
            color: var(--text-light);
        }

        .vi-etiqueta-field strong {
            color: var(--text-dark);
        }

    .vi-stock-popup-section-header {
        padding: 4px 12px;
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        background: var(--light-blue);
        color: var(--primary-blue);
        border-top: 1px solid var(--border-light);
    }

    .vi-stock-section-modula {
        background: #f3e8ff;
        color: #7c3aed;
    }

    .vi-stock-section-empty {
        opacity: .55;
        font-style: italic;
    }

    .vi-grupo-header-row td {
        border-bottom: none;
    }
</style>

@{ var role = Utilities.GetUserRole(User.Identity.Name); }

<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-warehouse"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--text-dark)">Verificación de Almacén</h1>
                <p class="mb-0 small" style="color:var(--text-light)">Verifique existencias del pedido y genere el documento de verificación</p>
            </div>
        </div>

        <form id="vi-ver-form" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" id="vi-ver-documentid" name="documentid">
            <input type="hidden" id="vi-ver-id-verificacion" name="id_verificacion">
            <input type="hidden" id="vi-ver-productosJSON" name="productosJSON">
            <input type="hidden" id="vi-ver-total" name="total" value="0">
            <input type="hidden" id="vi-ver-descuento" name="descuento" value="0">

            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Pedido de origen -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                            <h2 class="vi-section-title">Pedido de Origen</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Pedido</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vi-ver-modalBuscarPedido">
                                        <i class="fas fa-search"></i> Buscar Pedido
                                    </button>
                                    <input type="text" id="vi-ver-folio-pedido" class="vi-control" readonly
                                           placeholder="Seleccione un pedido aprobado…"
                                           style="border-radius:0 var(--row-radius) var(--row-radius) 0; border-left:none;">
                                </div>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-user"></i>Cliente</label>
                                <input type="text" id="vi-ver-cliente" class="vi-control" readonly>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" id="vi-ver-rfc" class="vi-control" readonly>
                            </div>
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vi-control" id="vi-ver-info-cliente" rows="2" readonly></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Artículos a verificar -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-clipboard-check"></i></div>
                            <h2 class="vi-section-title">Verificación de Existencias</h2>
                        </div>

                        <div class="mb-3">
                            <!-- Fila superior: Control de Surtido -->
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-2 p-3 rounded-3"
                                 style="background:linear-gradient(135deg,var(--light-blue) 0%,transparent 100%);
                                        border:1px solid var(--border-light);">

                                <div class="d-flex align-items-center gap-2 me-auto">
                                    <i class="fas fa-boxes" style="color:var(--primary-blue);font-size:1.1rem;"></i>
                                    <span style="font-weight:700;font-size:.9rem;color:var(--text-dark)">
                                        Control de Surtido
                                    </span>
                                </div>

                                <div id="vi-ver-info-surtido" class="d-none d-flex gap-2 flex-wrap align-items-center"></div>

                                <button type="button" class="vi-btn vi-btn-primary"
                                        id="vi-ver-btn-iniciar-surtido" disabled
                                        style="min-width:160px;justify-content:center;">
                                    <i class="fas fa-play"></i> Iniciar Surtido
                                </button>

                                <button type="button" class="vi-btn vi-btn-amber d-none"
                                        id="vi-ver-btn-finalizar-surtido"
                                        style="min-width:170px;justify-content:center;">
                                    <i class="fas fa-flag-checkered"></i> Finalizar Surtido
                                </button>
                            </div>

                            <!-- Fila inferior: Contadores y botones -->
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="vi-ver-badge ok">
                                        <i class="fas fa-check-circle"></i> <span id="vi-ver-cnt-ok">0</span> verificados
                                    </span>
                                    <span class="vi-ver-badge parcial">
                                        <i class="fas fa-exclamation-circle"></i> <span id="vi-ver-cnt-parcial">0</span> parciales
                                    </span>
                                    <span class="vi-ver-badge pendiente">
                                        <i class="fas fa-clock"></i> <span id="vi-ver-cnt-pend">0</span> pendientes
                                    </span>
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <button type="button" class="vi-btn vi-btn-outline"
                                            id="vi-ver-btn-verificar-todo"
                                            onclick="verificarTodoPedido()" disabled>
                                        <i class="fas fa-check-double"></i> Verificar Todo
                                    </button>
                                    <button type="button" class="vi-btn vi-btn-primary"
                                            id="vi-ver-btn-imprimir"
                                            onclick="imprimirEtiquetas()" disabled>
                                        <i class="fas fa-print"></i> Imprimir Etiquetas
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="vi-table-wrap">
                            <table class="vi-table">
                                <thead>
                                    <tr>
                                        <th style="width:36px">#</th>
                                        <th style="width:90px">Artículo</th>
                                        <th>Descripción</th>
                                        <th style="width:120px;text-align:center">Existencia</th>
                                        <th style="width:100px;text-align:center">Cant. Pendiente</th>
                                        <th style="width:130px">Cant. Verificada</th>
                                        <th style="width:110px">Lote / Serie</th>
                                        <th style="width:110px">Ubicación</th>
                                        <th style="width:100px">Estado</th>
                                        <th style="width:130px;text-align:center">Discrepancia</th>
                                    </tr>
                                </thead>
                                <tbody id="vi-ver-tabla-partidas">
                                    <tr>
                                        <td colspan="10" class="vi-table-empty">
                                            <i class="fas fa-warehouse"></i>
                                            <div class="fw-semibold mb-1">Sin pedido seleccionado</div>
                                            <small style="color:var(--text-light)">Busca y selecciona un pedido aprobado para comenzar</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TARJETA: Comentarios -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-comment-dots"></i></div>
                            <h2 class="vi-section-title">Observaciones de Almacén</h2>
                        </div>
                        <textarea class="vi-control" id="vi-ver-observaciones" name="observaciones" rows="3"
                                  placeholder="Condiciones del producto, incidencias, instrucciones de empaque…"></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem;z-index:0;">

                        <!-- Resumen -->
                        <div class="vi-card mb-3" style="border-radius:var(--table-radius);overflow:hidden;">
                            <div style="background:var(--primary-blue);color:#fff;padding:1.1rem 1.4rem;text-align:center;">
                                <i class="fas fa-clipboard-check" style="font-size:1.5rem;opacity:.9;display:block;margin-bottom:.2rem;"></i>
                                <div style="font-size:.75rem;font-weight:700;letter-spacing:1.2px;text-transform:uppercase;">
                                    Resumen de Verificación
                                </div>
                            </div>
                            <div style="padding:1.1rem 1.4rem;background:var(--bg-light);">
                                <div class="vi-summary-row">
                                    <span class="vi-summary-label">Total partidas</span>
                                    <span class="vi-summary-val" id="vi-ver-resumen-total">0</span>
                                </div>
                                <div class="vi-summary-row">
                                    <span class="vi-summary-label">Verificadas completas</span>
                                    <span class="vi-summary-val" style="color:var(--success-color)" id="vi-ver-resumen-ok">0</span>
                                </div>
                                <div class="vi-summary-row">
                                    <span class="vi-summary-label">Verificadas parciales</span>
                                    <span class="vi-summary-val" style="color:var(--warning-color)" id="vi-ver-resumen-parcial">0</span>
                                </div>
                                <div class="vi-summary-row">
                                    <span class="vi-summary-label">Pendientes</span>
                                    <span class="vi-summary-val" style="color:var(--danger-color)" id="vi-ver-resumen-pend">0</span>
                                </div>
                            </div>
                            <div style="padding:.5rem 1.4rem 1.1rem;background:var(--bg-light);">
                                <div class="d-flex justify-content-between mb-1">
                                    <small style="color:var(--text-light)">Progreso</small>
                                    <small style="color:var(--text-dark);font-weight:600" id="vi-ver-pct-progreso">0%</small>
                                </div>
                                <div class="vi-progress-wrap">
                                    <div class="vi-progress-bar" id="vi-ver-barra-progreso"
                                         style="width:0%;background:var(--success-color);"></div>
                                </div>
                            </div>
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vi-btn vi-btn-success"
                                    id="vi-ver-btn-guardar" disabled
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-save"></i> Guardar Verificación
                            </button>
                            <button type="button" class="vi-btn vi-btn-amber d-none"
                                    id="vi-ver-btn-generar-remision" disabled
                                    style="width:100%;justify-content:center;padding:.85rem;"
                                    onclick="generarRemisionDesdeVerificacion()">
                                <i class="fas fa-truck"></i> Generar Remisión
                            </button>
                            <a href="#" class="vi-btn vi-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

<!-- ===== BOTÓN FLOTANTE ===== -->
