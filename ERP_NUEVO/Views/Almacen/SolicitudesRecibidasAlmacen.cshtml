<!-- ═══════════════════════════════════════
     MODAL: DISCREPANCIA FÍSICA
═══════════════════════════════════════ -->
<div class="modal fade" id="vi-disc-modal" tabindex="-1">
    <div class="modal-dialog modal-md">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header"
                 style="background:linear-gradient(135deg,#92400e,var(--warning-color));">
                <h5 class="modal-title">
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    Registrar Discrepancia Física
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">

                <!-- Producto afectado -->
                <div class="mb-3 p-3 rounded-3"
                     style="background:#fef3c7;border:1.5px solid var(--warning-color);">
                    <div style="font-size:.7rem;font-weight:700;text-transform:uppercase;letter-spacing:.4px;
                                color:var(--warning-color);margin-bottom:3px;">
                        <i class="fas fa-box me-1"></i>Producto
                    </div>
                    <div id="vi-disc-producto" style="font-weight:700;color:var(--text-dark);font-size:.88rem;"></div>
                </div>

                <!-- Cuadro comparativo -->
                <div class="vi-disc-info-grid mb-3">
                    <div class="vi-disc-info-item">
                        <div class="vi-disc-info-label">
                            <i class="fas fa-shopping-cart me-1" style="color:var(--primary-blue)"></i>
                            Cant. solicitada
                        </div>
                        <div class="vi-disc-info-val" id="vi-disc-solicitado" style="color:var(--primary-blue)">—</div>
                    </div>
                    <div class="vi-disc-info-item">
                        <div class="vi-disc-info-label">
                            <i class="fas fa-boxes me-1" style="color:var(--text-light)"></i>
                            Stock en sistema <span style="font-size:.65rem;color:var(--success-color)">(solo Stock)</span>
                        </div>
                        <div class="vi-disc-info-val" id="vi-disc-sistema">—</div>
                    </div>
                </div>
                <!-- Nota Modula -->
                <div class="mb-3 p-2 rounded-2 d-flex align-items-start gap-2"
                     style="background:#f3e8ff;border:1px solid #7c3aed;">
                    <i class="fas fa-layer-group mt-1" style="color:#7c3aed;font-size:.85rem;flex-shrink:0"></i>
                    <div style="font-size:.75rem;color:#5b21b6;line-height:1.4">
                        <strong>Almacén Modula no se puede afectar.</strong>
                        La discrepancia aplica únicamente sobre el stock de almacenes tipo
                        <strong>Stock</strong>. La existencia en Modula se muestra solo como referencia.
                    </div>
                </div>
                <!-- Cantidad física real -->
                <div class="mb-3">
                    <label class="vi-label" style="font-size:.82rem;">
                        <i class="fas fa-hand-holding-box" style="color:var(--warning-color)"></i>
                        Cantidad física disponible <span style="color:var(--danger-color)">*</span>
                    </label>
                    <input type="number" id="vi-disc-cantidad-fisica" class="vi-control"
                           min="0" step="0.01" placeholder="Ingrese la cantidad que físicamente hay en almacén">
                    <div style="font-size:.73rem;color:var(--text-light);margin-top:4px;">
                        <i class="fas fa-info-circle"></i>
                        Si el pedido solicita 60 pzas pero físicamente sólo hay 50, ingrese 50.
                    </div>
                </div>

                <!-- Alerta de diferencia -->
                <div id="vi-disc-alerta" class="d-none mb-3 p-3 rounded-3"
                     style="background:#fee2e2;border:1.5px solid var(--danger-color);">
                    <div style="font-weight:700;color:var(--danger-color);font-size:.85rem;">
                        <i class="fas fa-triangle-exclamation me-1"></i>
                        Diferencia detectada: <span id="vi-disc-diferencia" style="font-family:monospace">0</span> unidades
                    </div>
                    <div style="font-size:.75rem;color:var(--danger-color);margin-top:4px;">
                        La remisión se generará con la cantidad física disponible.
                        El faltante quedará registrado con el motivo indicado.
                    </div>
                </div>

                <!-- Motivo -->
                <div class="mb-1">
                    <label class="vi-label" style="font-size:.82rem;">
                        <i class="fas fa-comment-alt" style="color:var(--accent-blue)"></i>
                        Motivo de la discrepancia <span style="color:var(--danger-color)">*</span>
                    </label>
                    <textarea id="vi-disc-motivo" class="vi-control" rows="3"
                              placeholder="Ej: Merma por daño en traslado, producto apartado para otro pedido, conteo manual difiere del sistema…"
                              style="resize:vertical;"></textarea>
                    <div style="font-size:.73rem;color:var(--text-light);margin-top:4px;">
                        <i class="fas fa-lock"></i> Este registro queda guardado como auditoría y no puede eliminarse.
                    </div>
                </div>

            </div>
            <div class="modal-footer gap-2">
                <button type="button" class="vi-btn vi-btn-ghost" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
                <button type="button" class="vi-btn vi-btn-amber" id="vi-disc-btn-guardar">
                    <i class="fas fa-exclamation-triangle"></i> Guardar Discrepancia
                </button>
            </div>
        </div>
    </div>
</div>
<script src="~/content/BrowserPrint.js-3.1.250/BrowserPrint-3.1.250.min.js"></script>
