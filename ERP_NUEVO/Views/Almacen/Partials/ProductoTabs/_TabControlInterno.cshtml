@*
    Pestaña Control Interno del formulario de producto:
    listas de precios, pesos y fracción arancelaria.
    @model  "crear" | "editar"
*@
@model string
@{
    var mode = Model ?? "crear";
    var pref = mode == "crear" ? "c_" : "e_";

    var preciosCliente = new[] {
        ("Guadalajara",    "precioGuadalajara"),
        ("Distribuidor 3", "precioD3"),
        ("Distribuidor 2", "precioD2"),
        ("Distribuidor 1", "precioD1")
    };

    var preciosVolumen = new[] {
        ("Mayoreo",   "precioMayoreoGDL"),
        ("½ Mayoreo", "precioMedioMayoreo"),
        ("Frecuente", "precioFrecuente"),
        ("Mostrador", "precioMostrador")
    };

    var pesos = new[] {
        ("Peso del producto",  "peso"),
        ("Peso alternativo 1", "peso2"),
        ("Peso alternativo 2", "peso3")
    };
}

<div class="prod-tab-pane" id="@(pref)tab-control">

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-dollar-sign"></i>Listas de precios</legend>

        <div class="prod-grid">
            @foreach (var (label, id) in preciosCliente)
            {
                <div class="prod-cell">
                    <div class="prod-cell-label">@label</div>
                    <input type="number" id="@(pref)@id" name="@id" step="0.01" placeholder="0.00">
                </div>
            }
        </div>

        <div class="prod-grid">
            @foreach (var (label, id) in preciosVolumen)
            {
                <div class="prod-cell">
                    <div class="prod-cell-label">@label</div>
                    <input type="number" id="@(pref)@id" name="@id" step="0.01" placeholder="0.00">
                </div>
            }
        </div>
    </fieldset>

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-weight-hanging"></i>Pesos</legend>

        <div class="prod-grid">
            @foreach (var (label, id) in pesos)
            {
                <div class="prod-cell">
                    <div class="prod-cell-label">@label</div>
                    <input type="number" id="@(pref)@id" name="@id" step="0.01" placeholder="0.00">
                </div>
            }
        </div>
    </fieldset>

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-passport"></i>Comercio exterior</legend>

        <div class="prod-field mb-0" style="max-width:320px">
            <label class="prod-label" for="@(pref)fracc">Fracción arancelaria</label>
            <input type="text" class="form-control" id="@(pref)fracc" name="fracc"
                   placeholder="Ej. 7318.15.99">
        </div>
    </fieldset>
</div>
