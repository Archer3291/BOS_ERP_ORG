@*
    Pestaña General del formulario de producto:
    identificación, clasificación, imagen y datos del SAT.
    Se renderiza dos veces (alta y edición); el prefijo de los ids
    evita que ambas copias colisionen.
    @model  "crear" | "editar"
*@
@model string
@{
    var mode = Model ?? "crear";
    var pref = mode == "crear" ? "c_" : "e_";
}

<div class="prod-tab-pane active" id="@(pref)tab-general">

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-circle-info"></i>Identificación</legend>

        <div class="row">
            <div class="col-md-5 prod-field">
                <div>
                    <label class="prod-label" for="@(pref)nombreProducto">
                        Nombre / Clave<span class="req">*</span>
                    </label>
                    <input required type="text" id="@(pref)nombreProducto" name="nombreProducto" class="form-control" placeholder="Ej. TOR-M8-25">
                </div>
                <div>
                    <label class="prod-label" for="@(pref)claveAlternativa">
                        Clave Alternativa (Opcional)
                    </label>
                    <input type="text" id="@(pref)claveAlternativa" name="claveAlternativa" class="form-control" placeholder="Ej. TOR-M8-25">
                </div>
                <div>
                    <label class="prod-label" for="@(pref)claveContratipo">
                        Clave Contratipo
                    </label>
                    <input type="text" id="@(pref)claveContratipo" name="claveContratipo" class="form-control" placeholder="Ej. TOR-M8-25">
                </div>
            </div>
            <div class="col-md-7 prod-field">
                <label class="prod-label">Estado</label>
                <div class="prod-toggles" style="height:auto;">
                    <div class="bootstrap-toggle toggle-outline toggle-success">
                        <input type="checkbox" id="@(pref)estadoProducto" name="estadoProducto" checked>
                        <label for="@(pref)estadoProducto" class="toggle-group">
                            <span class="toggle-on">Activo</span>
                            <span class="toggle-handle"></span>
                            <span class="toggle-off">Inactivo</span>
                        </label>
                    </div>
                    <div class="bootstrap-toggle toggle-outline toggle-success">
                        <input type="checkbox" id="@(pref)eskit" name="eskit">
                        <label for="@(pref)eskit" class="toggle-group">
                            <span class="toggle-on">Es Kit</span>
                            <span class="toggle-handle"></span>
                            <span class="toggle-off">No Kit</span>
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="prod-field mb-0">
            <label class="prod-label" for="@(pref)descripcion">
                Descripción<span class="req">*</span>
            </label>
            <input required type="text" id="@(pref)descripcion" name="descripcionProducto" class="form-control" placeholder="Descripción detallada del producto">
        </div>
    </fieldset>

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-layer-group"></i>Clasificación</legend>

        <div class="row">
            <div class="col-md-4 prod-field">
                <label class="prod-label" for="@(pref)lineaProducto">Línea<span class="req">*</span></label>
                <select required id="@(pref)lineaProducto" name="lineaProducto" class="form-select"></select>
            </div>
            <div class="col-md-4 prod-field">
                <label class="prod-label" for="@(pref)tipoProducto">Tipo<span class="req">*</span></label>
                <select required id="@(pref)tipoProducto" name="tipoProducto" class="form-select"></select>
            </div>
            <div class="col-md-4 prod-field">
                <label class="prod-label" for="@(pref)grupoProducto">Grupo<span class="req">*</span></label>
                <select required id="@(pref)grupoProducto" name="grupoProducto" class="form-select"></select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 prod-field mb-0">
                <label class="prod-label" for="@(pref)naturalezaProducto">Naturaleza<span class="req">*</span></label>
                <select required id="@(pref)naturalezaProducto" name="naturalezaProducto" class="form-select"></select>
            </div>
            <div class="col-md-6 prod-field mb-0">
                <label class="prod-label" for="@(pref)unidadProducto">Unidad de Medida<span class="req">*</span></label>
                <select required id="@(pref)unidadProducto" name="unidadProducto" class="form-select"></select>
            </div>
        </div>
    </fieldset>

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-image"></i>Imagen del producto</legend>

        <div class="row">
            <div class="col-md-6 prod-field mb-0">
                <div class="prod-upload-zone" onclick="document.getElementById('@(pref)imagenProductoInput').click()">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                    <p>Haz clic para subir una imagen</p>
                    <small>JPG, PNG o GIF</small>
                </div>
                <input type="file" class="d-none prod-img-input" accept="image/*" id="@(pref)imagenProductoInput" name="imagenProducto" data-mode="@mode">
            </div>
            <div class="col-md-6 prod-field mb-0">
                <div class="prod-img-frame">
                    <div class="prod-img-empty">
                        <i class="fa-regular fa-image"></i>
                        Sin imagen
                    </div>
                    <img id="@(pref)imagenPreview" src="#" alt="Vista previa" class="prod-img-preview">
                </div>
            </div>
        </div>
    </fieldset>

    <fieldset class="prod-fieldset">
        <legend class="prod-legend"><i class="fa-solid fa-file-invoice"></i>SAT CFDI</legend>

        <div class="row">
            <div class="col-md-6 prod-field">
                <label class="prod-label" for="@(pref)prod_sat">
                    Código de Producto SAT<span class="req">*</span>
                </label>
                <select required id="@(pref)prod_sat" name="prod_sat" class="form-control">
                    <option value="">Buscar producto SAT...</option>
                </select>
            </div>
            <div class="col-md-6 prod-field">
                <label class="prod-label" for="@(pref)unidadMedida">
                    Unidad de Medida SAT<span class="req">*</span>
                </label>
                <select required id="@(pref)unidadMedida" name="unidadMedida" class="form-control">
                    <option value="">Selecciona...</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="col-md-6 prod-field mb-0">
                <label class="prod-label" for="@(pref)unidadSecundaria">Unidad Secundaria</label>
                <select id="@(pref)unidadSecundaria" name="unidadSecundaria" class="form-control">
                    <option value="">Selecciona...</option>
                </select>
            </div>
            <div class="col-md-3 prod-field mb-0">
                <label class="prod-label" for="@(pref)ivaExento">
                    IVA Exento<span class="req">*</span>
                </label>
                <select required id="@(pref)ivaExento" name="ivaExento" class="form-select">
                    <option value="N">No</option>
                    <option value="S">Sí</option>
                </select>
            </div>
            <div class="col-md-3 prod-field mb-0">
                <label class="prod-label" for="@(pref)objetoImpuesto">
                    Objeto de Impuesto<span class="req">*</span>
                </label>
                <select required id="@(pref)objetoImpuesto" name="objetoImpuesto" class="form-control">
                    <option value="">Selecciona...</option>
                </select>
            </div>
        </div>
    </fieldset>
</div>
