@*
    Modal de ALTA de producto.
    El formulario en sí es _ProductoFormFields; aquí sólo se
    resuelve cuándo abrirlo y con qué estado inicial.
*@
<div class="modal fade prod-modal" id="modalCrearProducto" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="prod-icon">
                    <i class="fa-solid fa-plus"></i>
                </div>
                <div>
                    <h5 class="modal-title">Nuevo producto</h5>
                    <span class="modal-subtitle">Los campos marcados con * son obligatorios para poder facturar.</span>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <form id="formCrear" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    @Html.Partial("Partials/_ProductoFormFields", "crear")
                </form>
            </div>

            <div class="modal-footer">
                <button type="button" class="prod-btn prod-btn-ghost" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i>Cancelar
                </button>
                <button type="button" class="prod-btn prod-btn-success" onclick="guardarProducto('crear')">
                    <i class="fa-solid fa-floppy-disk"></i>Guardar producto
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        'use strict';

        /* ── Abre el modal y monta los catálogos ──────────────────── */
        window.abrirModalCrear = function () {
            const modalEl = document.getElementById('modalCrearProducto');

            document.getElementById('formCrear').reset();
            new bootstrap.Modal(modalEl).show();

            // Los Tom Select se montan con el modal ya visible: si no,
            // miden mal el ancho del control.
            modalEl.addEventListener('shown.bs.modal', () => initForm('crear'), { once: true });
        };
    })();
</script>
