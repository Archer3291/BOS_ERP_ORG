@*
    Formulario de producto compartido por el alta y la edición.
    Sólo arma la barra de pestañas; el contenido de cada una vive
    en ProductoTabs/.

    El prefijo de los ids (c_ / e_) permite que las dos copias
    convivan en la misma página sin colisionar.
    @model  "crear" | "editar"
*@
@model string
@{
    var mode = Model ?? "crear";
    var pref = mode == "crear" ? "c_" : "e_";
}

<div class="prod-tabs-wrapper">

    <div class="prod-tabs">
        <button type="button" class="prod-tab-btn active" data-target="#@(pref)tab-general">
            <i class="fa-solid fa-circle-info"></i>General
        </button>
        <button type="button" class="prod-tab-btn" data-target="#@(pref)tab-control">
            <i class="fa-solid fa-gears"></i>Control Interno
        </button>
    </div>

    @Html.Partial("Partials/ProductoTabs/_TabGeneral", mode)
    @Html.Partial("Partials/ProductoTabs/_TabControlInterno", mode)

</div>
