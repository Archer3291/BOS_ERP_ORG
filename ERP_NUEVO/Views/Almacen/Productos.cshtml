@using BOS_ERP.Controllers
@{
    ViewData["Title"] = "Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Productos";
}

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<link href="~/content/tom-select-theme.css" rel="stylesheet" />
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<link href="~/content/TableBuilder.css" rel="stylesheet" />
<link href="~/content/productos.css" rel="stylesheet" />

<script>window.document.title = 'Productos'</script>

@* ── Listado ────────────────────────────────────────────────── *@
@Html.Partial("Partials/_TablaProductos")

@* ── Alta y edición ─────────────────────────────────────────── *@
@Html.Partial("Partials/_ModalCrearProducto")
@Html.Partial("Partials/_ModalEditarProducto")

@* ── Sincronización desde la base externa ───────────────────── *@
@Html.Partial("Partials/_ModalImportarBD")

@* ── Alta masiva por CSV (requiere permiso) ─────────────────── *@
@if (Utilities.DoesUserHasRight(User.Identity.Name, "carga_layout"))
{
    @Html.Partial("Partials/_CargaMasivaProductos")
}

@section scripts {
    <script src="~/lib/jquery/jquery.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/Scripts/TableBuilder.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/Scripts/Switch.js?v=@DateTime.Now.Ticks"></script>
    <script src="~/Scripts/Almacen/Productos/productos-core.js?v=@DateTime.Now.Ticks"></script>
}
