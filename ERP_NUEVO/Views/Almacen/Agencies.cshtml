@{
    ViewBag.Title = "Agencias Aduanales";
    ViewBag.PageTitle = "Agencias Aduanales";
}

<script>window.document.title = 'Agencias Aduanales'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn blue-500 mb-3" id="btnAdd">
                    <i class="fa-duotone fa-solid fa-plus"></i> Nueva Agencia
                </button>
            </div>
        </div>

        <div class="table-responsive-sm">
            <table id="agencysTable" class="table modern-table">
                <thead class="bg-secondary">
                    <tr>
                        <th>Nombre</th>
                        <th>Calle</th>
                        <th>Colonia</th>
                        <th>Población</th>
                        <th>Teléfono</th>
                        <th>Teléfono 2</th>
                        <th>Fax</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade" id="agencyModal" tabindex="-1" aria-labelledby="agencyModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="agencyModalLabel">Registrar Nueva Agencia</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="agencyForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Clave">Ingresar Clave</label>                                
                                <input type="number" id="Clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Nombre">Ingresar Nombre</label>                                
                                <input type="text" id="Nombre" class="form-control form-icon-trailing" name="Nombre" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Calle">Ingresar Calle</label>                                
                                <input type="text" id="Calle" class="form-control form-icon-trailing" name="Calle" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Colonia">Ingresar Colonia</label>                                
                                <input type="text" id="Colonia" class="form-control form-icon-trailing" name="Colonia" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Poblacion">Ingresar Poblacion</label>                                
                                <input type="text" id="Poblacion" class="form-control form-icon-trailing" name="Poblacion" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Telefono">Ingresar teléfono</label>                                
                                <input type="tel" id="Telefono" class="form-control form-icon-trailing" name="Telefono" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Telefono2">Ingresar teléfono 2</label>                                
                                <input type="tel" id="Telefono2" class="form-control form-icon-trailing" name="Telefono2" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="Fax">Ingresar Fax</label>                                
                                <input type="tel" id="Fax" class="form-control form-icon-trailing" name="Fax" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn red-500" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                    </button>
                    <button type="button" class="btn blue-500" onclick="sendForm()">
                        <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Almacen/agencys.js"></script>
}