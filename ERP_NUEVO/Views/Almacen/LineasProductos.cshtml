@{
    ViewBag.Title = "Líneas de Productos";
}

<script>window.document.title = 'Líneas de Productos'</script>

<div class="card">
    <div class="card-header text-bg-primary">
        <h2 class="animate__animated animate__rubberBand">Líneas de Productos</h2>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn btn-outline-primary mb-3" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms" id="btnAdd">
                    <i class="fa-duotone fa-solid fa-plus fa-beat"></i> Nueva Línea
                </button>
            </div>
        </div>

        <div class="table-responsive-sm">
            <table id="linesTable" class="table table-striped table-bordered table-hover" style="width:100%">
                <thead class="bg-secondary">
                    <tr>
                        <th>Clave</th>
                        <th>Descripción</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade animate__animated animate__bounceIn" id="lineModal" tabindex="-1" aria-labelledby="lineModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="lineModalLabel">Registrar Nueva Línea</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="lineForm">
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-key trailing"></i>
                        <input type="number" id="clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                        <label class="form-label" for="clave">Ingresar clave</label>                        
                    </div>
                    <div class="form-outline mb-4" data-mdb-input-init>
                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                        <input type="text" id="description" class="form-control form-icon-trailing" name="Description" />
                        <label class="form-label" for="description">Ingresar descripción</label>                        
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-mdb-ripple-init data-mdb-ripple-color="danger" data-mdb-ripple-duration="1000ms" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-success" data-mdb-ripple-init data-mdb-ripple-color="success" data-mdb-ripple-duration="1000ms">
                        <i class="fa-duotone fa-solid fa-floppy-disk fa-beat"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Almacen/lines.js"></script>
}