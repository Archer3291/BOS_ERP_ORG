<script>
// ══════════════════════════════════════════════════════
//  Navegación de tabs
// ══════════════════════════════════════════════════════
function modSwitchMain(id, btn) {
    document.querySelectorAll('.mod-panel').forEach(function (p) { p.classList.remove('active'); });
    document.querySelectorAll('.mod-tab-btn').forEach(function (b) { b.classList.remove('active'); });
    document.getElementById('mod-panel-' + id).classList.add('active');
    btn.classList.add('active');
}

function modSwitchSub(id, scope, btn) {
    var parent = document.getElementById('mod-panel-' + scope);
    parent.querySelectorAll('.mod-sub-panel').forEach(function (p) { p.classList.remove('active'); });
    parent.querySelectorAll('.mod-sub-btn').forEach(function (b) { b.classList.remove('active'); });
    document.getElementById('mod-sub-' + id).classList.add('active');
    btn.classList.add('active');
}

// ══════════════════════════════════════════════════════
//  Validación
// ══════════════════════════════════════════════════════
function modClearErr(id) {
    var el  = document.getElementById(id);
    var err = document.getElementById('e-' + id);
    if (el)  el.classList.remove('is-invalid');
    if (err) { err.textContent = ''; err.style.display = 'none'; }
}

function modSetErr(id, msg) {
    var el  = document.getElementById(id);
    var err = document.getElementById('e-' + id);
    if (el)  el.classList.add('is-invalid');
    if (err) { err.textContent = msg; err.style.display = 'block'; }
}

function modValidate(campos) {
    var ok = true;
    campos.forEach(function (c) {
        modClearErr(c.id);
        var el  = document.getElementById(c.id);
        if (!el) return;
        var val = el.value.trim();
        if (!val) {
            modSetErr(c.id, c.label + ' es requerido.');
            ok = false;
        } else if (c.tipo === 'number' && (isNaN(val) || Number(val) <= 0)) {
            modSetErr(c.id, 'Debe ser un número mayor a 0.');
            ok = false;
        }
    });
    return ok;
}

// ══════════════════════════════════════════════════════
//  Resultados / Reset / Fetch
// ══════════════════════════════════════════════════════
function modMostrarResultado(boxId, isOk, mensaje) {
    var box = document.getElementById(boxId);
    box.className = 'mod-alert show ' + (isOk ? 'mod-alert-ok' : 'mod-alert-err');
    box.textContent = (isOk ? '✓ ' : '✕ ') + mensaje;
}

function modReset(prefix) {
    document.querySelectorAll('[id^="' + prefix + '-"]').forEach(function (el) {
        if (el.tagName === 'INPUT') { el.value = ''; el.classList.remove('is-invalid'); }
        if (el.classList.contains('mod-err')) { el.textContent = ''; el.style.display = 'none'; }
    });
    var tab = prefix === 'ib' ? 'inbound' : 'item';
    var box = document.getElementById('res-' + tab);
    if (box) { box.className = 'mod-alert'; box.textContent = ''; }
}

function modSetLoading(btnId, spId, loading) {
    var btn = document.getElementById(btnId);
    var sp  = document.getElementById(spId);
    btn.disabled    = loading;
    sp.style.display = loading ? 'block' : 'none';
}

function modFetch(url, payload, btnId, spId, resBoxId) {
    modSetLoading(btnId, spId, true);
    fetch(url, {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(payload)
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) { modMostrarResultado(resBoxId, data.ok, data.mensaje); })
    .catch(function (err) { modMostrarResultado(resBoxId, false, 'Error de red: ' + err.message); })
    .finally(function () { modSetLoading(btnId, spId, false); });
}

// ══════════════════════════════════════════════════════
//  Inbound individual
// ══════════════════════════════════════════════════════
function enviarInbound() {
    var valido = modValidate([
        { id: 'ib-orden',    label: 'Número de orden'    },
        { id: 'ib-codigo',   label: 'Código de artículo' },
        { id: 'ib-desc',     label: 'Descripción'        },
        { id: 'ib-unidad',   label: 'Unidad de medida'   },
        { id: 'ib-cantidad', label: 'Cantidad', tipo: 'number' }
    ]);
    if (!valido) return;

modFetch('@Url.Action("EnviarInbound", "Modula")', {
    OrdenNumero:      document.getElementById('ib-orden').value.trim(),
    OrdenDescripcion: document.getElementById('ib-ordes').value.trim(),
    Codigo:           document.getElementById('ib-codigo').value.trim(),
    Descripcion:      document.getElementById('ib-desc').value.trim(),
    Unidad:           document.getElementById('ib-unidad').value.trim().toUpperCase(),
    Cantidad:         document.getElementById('ib-cantidad').value.trim(),
    Lote:             document.getElementById('ib-lote').value.trim(),     // nuevo
    LineaHost:        document.getElementById('ib-linea').value.trim()     // nuevo
}, 'btn-inbound', 'sp-inbound', 'res-inbound');
}

