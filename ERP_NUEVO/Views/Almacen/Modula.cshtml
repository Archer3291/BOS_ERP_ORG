//  Item Master individual
// ══════════════════════════════════════════════════════
function enviarItem() {
    var valido = modValidate([
        { id: 'it-codigo', label: 'Código'      },
        { id: 'it-desc',   label: 'Descripción' },
        { id: 'it-unidad', label: 'Unidad'      }
    ]);
    if (!valido) return;

    modFetch('@Url.Action("Enviar", "Modula")', {
        Codigo:      document.getElementById('it-codigo').value.trim(),
        Descripcion: document.getElementById('it-desc').value.trim(),
