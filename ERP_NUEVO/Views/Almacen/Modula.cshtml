}

// ══════════════════════════════════════════════════════
//  CSV — estado en memoria
// ══════════════════════════════════════════════════════
var csvRegistros = [];

function descargarPlantilla() {
    var contenido = 'OrdenNumero,OrdenDescripcion,Codigo,Descripcion,Unidad,Cantidad\n' +
                    'ORD-001,Reabastecimiento bodega A,ART-001,Tornillo M6,PZA,100\n' +
                    'ORD-001,Reabastecimiento bodega A,ART-002,Tuerca M6,PZA,100\n';
    var blob = new Blob([contenido], { type: 'text/csv;charset=utf-8;' });
    var a    = document.createElement('a');
    a.href   = URL.createObjectURL(blob);
    a.download = 'plantilla_inbound.csv';
    a.click();
}

function csvOnDrop(event) {
    event.preventDefault();
    var file = event.dataTransfer.files[0];
    if (file) csvSeleccionado(file);
}

function csvSeleccionado(file) {
    if (!file) return;
    if (!file.name.toLowerCase().endsWith('.csv')) {
        alert('Por favor selecciona un archivo .csv');
        return;
    }
    document.getElementById('csv-filename').textContent = file.name;

    var formData = new FormData();
    formData.append('archivo', file);

    fetch('@Url.Action("ParsearCsvInbound", "Modula")', {
        method: 'POST',
        body:   formData
    })
    .then(function (r) { return r.json(); })
    .then(function (data) {
        if (!data.ok && !data.registros) {
            alert('Error: ' + data.mensaje);
            return;
        }
        csvRegistros = data.registros || [];
        renderizarPreview(csvRegistros, data.errores || []);
    })
    .catch(function (err) { alert('Error al leer el archivo: ' + err.message); });
}

function renderizarPreview(registros, errores) {
    var errBox = document.getElementById('csv-errores');
    if (errores.length > 0) {
        errBox.className = 'mod-csv-warn show';
        errBox.innerHTML = '<strong>⚠ ' + errores.length + ' fila(s) con error (omitidas):</strong>' +
            '<ul style="margin:.4rem 0 0 1rem">' +
            errores.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
            '</ul>';
    } else {
        errBox.className = 'mod-csv-warn';
    }

    var tbody = document.getElementById('csv-tbody');
    tbody.innerHTML = '';
    registros.forEach(function (r, i) {
        tbody.innerHTML +=
            '<tr>' +
            '<td class="mod-muted">' + (i + 1) + '</td>' +
            '<td>' + r.OrdenNumero + '</td>' +
            '<td class="mod-muted">' + (r.OrdenDescripcion || '—') + '</td>' +
            '<td><code class="mod-code">' + r.Codigo + '</code></td>' +
            '<td>' + r.Descripcion + '</td>' +
            '<td><span class="mod-badge-unit">' + r.Unidad + '</span></td>' +
            '<td class="mod-num">' + r.Cantidad + '</td>' +
            '</tr>';
    });

    document.getElementById('csv-count').textContent  = registros.length;
    document.getElementById('csv-count2').textContent = registros.length;

    document.getElementById('csv-preview').style.display = registros.length === 0 ? 'none' : 'block';

    var resBox = document.getElementById('res-csv');
    resBox.className  = 'mod-alert';
    resBox.textContent = '';
}

function limpiarCsv() {
    csvRegistros = [];
    document.getElementById('csv-file').value            = '';
    document.getElementById('csv-filename').textContent  = 'Ningún archivo seleccionado';
    document.getElementById('csv-preview').style.display = 'none';
    document.getElementById('csv-errores').className     = 'mod-csv-warn';
    var resBox = document.getElementById('res-csv');
    resBox.className  = 'mod-alert';
    resBox.textContent = '';
}

function confirmarEnviarCsv() {
    if (!csvRegistros || csvRegistros.length === 0) return;

    modSetLoading('btn-csv', 'sp-csv', true);

    fetch('@Url.Action("EnviarInboundMasivo", "Modula")', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(csvRegistros)
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
        var resBox = document.getElementById('res-csv');
        resBox.className = 'mod-alert show ' + (data.ok ? 'mod-alert-ok' : 'mod-alert-err');
        resBox.textContent = (data.ok ? '✓ ' : '✕ ') +
            (data.total ? data.total + ' registros — ' : '') + data.mensaje;
    })
    .catch(function (err) {
        var resBox = document.getElementById('res-csv');
        resBox.className  = 'mod-alert show mod-alert-err';
        resBox.textContent = '✕ Error de red: ' + err.message;
    })
    .finally(function () { modSetLoading('btn-csv', 'sp-csv', false); });
    }

