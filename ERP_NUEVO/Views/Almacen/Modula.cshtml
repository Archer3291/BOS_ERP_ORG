@{
    ViewBag.Title = "Modula WebService";
    ViewBag.PageTitle = "Modula WebService";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    /* ── Modula view ────────────────────────────────── */
    .mod-wrap {
        max-width: 820px;
        margin: 0 auto;
        padding: 2rem 1rem;
    }

    /* Header */
    .mod-header {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-bottom: 2rem;
        padding-bottom: 1.25rem;
        border-bottom: 1.5px solid var(--border-light);
    }

    .mod-header-icon {
        width: 44px;
        height: 44px;
        background: var(--primary-blue);
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

        .mod-header-icon svg {
            width: 22px;
            height: 22px;
            stroke: #fff;
            fill: none;
            stroke-width: 1.8;
            stroke-linecap: round;
            stroke-linejoin: round;
        }

    .mod-header h1 {
        font-size: 1.15rem;
        font-weight: 600;
        color: var(--text-dark);
        letter-spacing: -.01em;
        margin: 0;
    }

    .mod-header p {
        font-size: .78rem;
        color: var(--text-light);
        margin: 2px 0 0;
    }

    /* Main tabs */
    .mod-main-tabs {
        display: flex;
        gap: 4px;
        background: var(--light-blue);
        border-radius: 12px;
        padding: 4px;
        margin-bottom: 1.75rem;
    }

    .mod-tab-btn {
        flex: 1;
        padding: .5rem 1rem;
        border: none;
        background: transparent;
        border-radius: 9px;
        font-size: .84rem;
        font-weight: 500;
        color: var(--secondary-blue);
        cursor: pointer;
        transition: all var(--transition-fast);
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
    }

        .mod-tab-btn.active {
            background: var(--bg-light);
            color: var(--primary-blue);
            box-shadow: var(--shadow);
            font-weight: 600;
        }

        .mod-tab-btn:hover:not(.active) {
            background: rgba(255, 255, 255, .5);
        }

    .mod-badge {
        font-size: .63rem;
        padding: 2px 8px;
        border-radius: var(--badge-radius);
        font-weight: 600;
        letter-spacing: .03em;
        line-height: 1.4;
    }

    .mod-badge-green {
        background: #dcfce7;
        color: #15803d;
    }

    .mod-badge-blue {
        background: #dbeafe;
        color: #1e40af;
    }

    /* Panels */
    .mod-panel {
        display: none;
    }

        .mod-panel.active {
            display: block;
        }

    /* Sub-tabs */
    .mod-sub-tabs {
        display: flex;
        gap: 6px;
        margin-bottom: 1.25rem;
    }

    .mod-sub-btn {
        padding: .38rem .9rem;
        border: 1.5px solid var(--border-light);
        background: var(--bg-light);
        border-radius: 8px;
        font-size: .78rem;
        font-weight: 500;
        color: var(--text-light);
        cursor: pointer;
        transition: all var(--transition-fast);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .mod-sub-btn.active {
            border-color: var(--primary-blue);
            background: var(--primary-blue);
            color: #fff;
        }

        .mod-sub-btn:hover:not(.active) {
            border-color: var(--secondary-blue);
            color: var(--text-dark);
        }

    .mod-sub-panel {
        display: none;
    }

        .mod-sub-panel.active {
            display: block;
        }

    /* Card */
    .mod-card {
        background: var(--bg-light);
        border: 1.5px solid var(--border-light);
        border-radius: var(--table-radius);
        padding: 1.5rem;
        box-shadow: var(--shadow);
    }

    /* Section label */
    .mod-section-label {
        font-size: .67rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: var(--secondary-blue);
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .mod-section-label::after {
            content: '';
            flex: 1;
            height: 1px;
            background: var(--border-light);
        }

    /* Form grid */
    .mod-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: .9rem;
        margin-bottom: 1.25rem;
    }

    .mod-form-grid-3 {
        grid-template-columns: 1fr 1fr 1fr;
    }

    @@media (max-width: 580px) {
        .mod-form-grid,
        .mod-form-grid-3 {
            grid-template-columns: 1fr;
        }
    }

    .mod-field label {
        display: block;
        font-size: .78rem;
        font-weight: 500;
        color: var(--text-dark);
        margin-bottom: .35rem;
    }

        .mod-field label .req {
            color: var(--danger-color);
            font-size: .7rem;
            margin-left: 1px;
        }

    .mod-field input {
        width: 100%;
        padding: .45rem .72rem;
        border: 1.5px solid var(--border-light);
        border-radius: 8px;
        font-size: .83rem;
        color: var(--text-dark);
        background: var(--bg-light);
        outline: none;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

        .mod-field input:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, .12);
        }

        .mod-field input.is-invalid {
            border-color: var(--danger-color);
        }

    .mod-field .mod-hint {
        font-size: .7rem;
        color: var(--text-light);
        margin-top: .3rem;
    }

    .mod-field .mod-err {
        font-size: .7rem;
        color: var(--danger-color);
        margin-top: .3rem;
        display: none;
    }

    /* Actions */
    .mod-actions {
        display: flex;
        justify-content: flex-end;
        gap: .6rem;
        margin-top: .75rem;
    }

    .mod-btn {
        padding: .42rem .95rem;
        border-radius: 8px;
        font-size: .8rem;
        font-weight: 500;
        cursor: pointer;
        border: 1.5px solid transparent;
        transition: all var(--transition-fast);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .mod-btn-ghost {
        background: var(--bg-light);
        border-color: var(--border-light);
        color: var(--secondary-blue);
    }

        .mod-btn-ghost:hover {
            border-color: var(--secondary-blue);
            color: var(--text-dark);
        }

    .mod-btn-primary {
        background: var(--primary-blue);
        border-color: var(--primary-blue);
        color: #fff;
    }

        .mod-btn-primary:hover {
            background: var(--primary-blue-dark);
            border-color: var(--primary-blue-dark);
        }

        .mod-btn-primary:disabled {
            opacity: .55;
            cursor: not-allowed;
        }

    .mod-spinner {
        width: 13px;
        height: 13px;
        border: 2px solid rgba(255, 255, 255, .3);
        border-top-color: #fff;
        border-radius: 50%;
        animation: modSpin .7s linear infinite;
        display: none;
    }

    @@keyframes modSpin {
        to {
            transform: rotate(360deg);
        }
    }

    /* Result alert */
    .mod-alert {
        border-radius: 9px;
        padding: .65rem 1rem;
        font-size: .81rem;
        display: none;
        margin-top: 1rem;
        font-weight: 500;
    }

        .mod-alert.show {
            display: block;
        }

    .mod-alert-ok {
        background: #f0fdf4;
        border: 1.5px solid #bbf7d0;
        color: var(--success-color);
    }

    .mod-alert-err {
        background: #fef2f2;
        border: 1.5px solid #fecaca;
        color: var(--danger-color);
    }

    /* CSV */
    .mod-info-bar {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1.25rem;
    }

        .mod-info-bar p {
            font-size: .78rem;
            color: var(--text-light);
            margin-top: .3rem;
            line-height: 1.55;
        }

        .mod-info-bar code {
            background: var(--light-blue);
            color: var(--primary-blue);
            padding: 1px 5px;
            border-radius: 4px;
            font-size: .72rem;
        }

    .mod-drop-zone {
        border: 2px dashed var(--border-light);
        border-radius: 12px;
        padding: 2rem 1.5rem;
        text-align: center;
        cursor: pointer;
        background: var(--bg-gray);
        transition: all var(--transition-fast);
    }

        .mod-drop-zone:hover,
        .mod-drop-zone.drag-over {
            background: var(--accent-purple-light);
            border-color: var(--accent-purple);
        }

        .mod-drop-zone p {
            font-size: .82rem;
            color: var(--text-light);
            margin: 0;
        }

    .mod-drop-filename {
        font-size: .75rem;
        margin-top: .35rem;
        color: var(--secondary-blue);
    }

    .mod-csv-warn {
        background: #fffbeb;
        border: 1.5px solid #fde68a;
        border-radius: 9px;
        padding: .65rem 1rem;
        font-size: .75rem;
        color: #92400e;
        display: none;
        margin-bottom: 1rem;
    }

        .mod-csv-warn.show {
            display: block;
        }

    .mod-preview-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: .75rem;
    }

        .mod-preview-header span {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text-dark);
        }

    .mod-count-pill {
        background: var(--primary-blue);
        color: #fff;
        font-size: .66rem;
        padding: 2px 9px;
        border-radius: var(--badge-radius);
        font-weight: 600;
        margin-left: 6px;
    }

    .mod-preview-wrap {
        max-height: 300px;
        overflow-y: auto;
        border-radius: 10px;
        border: 1.5px solid var(--border-light);
    }

    .mod-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .75rem;
    }

        .mod-table thead th {
            background: var(--bg-gray);
            color: var(--secondary-blue);
            font-weight: 600;
            padding: .5rem .75rem;
            text-align: left;
            position: sticky;
            top: 0;
            border-bottom: 1.5px solid var(--border-light);
            white-space: nowrap;
        }

        .mod-table tbody tr {
            border-bottom: 1px solid var(--border-light);
        }

            .mod-table tbody tr:hover {
                background: var(--very-light-blue);
            }

        .mod-table tbody td {
            padding: .42rem .75rem;
            color: var(--text-dark);
        }

            .mod-table tbody td.mod-muted {
                color: var(--text-light);
            }

            .mod-table tbody td.mod-num {
                text-align: right;
                font-variant-numeric: tabular-nums;
            }

    .mod-badge-unit {
        background: var(--light-blue);
        color: var(--primary-blue);
        font-size: .65rem;
        padding: 2px 7px;
        border-radius: var(--badge-radius);
        font-weight: 600;
    }

    .mod-code {
        background: var(--light-blue);
        color: var(--primary-blue-dark);
        padding: 1px 5px;
        border-radius: 4px;
        font-size: .72rem;
    }

    .mod-btn-link {
        background: none;
        border: none;
        color: var(--text-light);
        font-size: .75rem;
        cursor: pointer;
        padding: 0;
        text-decoration: underline;
    }

        .mod-btn-link:hover {
            color: var(--danger-color);
        }

    [data-theme="dark"] .mod-alert-ok {
        background: rgba(5, 150, 105, .12);
        border-color: rgba(5, 150, 105, .3);
    }

    [data-theme="dark"] .mod-alert-err {
        background: rgba(220, 38, 38, .12);
        border-color: rgba(220, 38, 38, .3);
    }

    [data-theme="dark"] .mod-csv-warn {
        background: rgba(217, 119, 6, .12);
        border-color: rgba(217, 119, 6, .3);
        color: #fde68a;
    }

    [data-theme="dark"] .mod-badge-green {
        background: rgba(21, 128, 61, .2);
        color: #86efac;
    }

    [data-theme="dark"] .mod-badge-blue {
        background: rgba(30, 64, 175, .2);
        color: #93c5fd;
    }
</style>


    <!-- ── Header ── -->
    <div class="mod-header">
        <div class="mod-header-icon">
            <svg viewBox="0 0 24 24">
                <rect x="2" y="3" width="20" height="14" rx="2" />
                <path d="M8 21h8M12 17v4" />
                <path d="M7 8h2M7 11h2M12 8h5M12 11h5" />
            </svg>
        </div>
        <div>
            <p>Integración con el sistema de almacén automatizado</p>
        </div>
    </div>

    <!-- ── Main tabs ── -->
    <div class="mod-main-tabs">
        <button class="mod-tab-btn active" onclick="modSwitchMain('inbound', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h5" />
                <polyline points="16 2 16 6 12 6" />
                <path d="m13 15 3 3 5-5" />
            </svg>
            Inbound
            <span class="mod-badge mod-badge-green">Recepción</span>
        </button>
        <button class="mod-tab-btn" onclick="modSwitchMain('maintenance', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 16V8a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v8" />
                <polyline points="3 16 8 21 13 16" />
                <line x1="8" y1="21" x2="8" y2="11" />
            </svg>
            Maintenance
            <span class="mod-badge" style="background:#fef3c7;color:#92400e;">Surtimiento</span>
        </button>
        <button class="mod-tab-btn" onclick="modSwitchMain('item', this)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="8" height="8" rx="1" />
                <rect x="14" y="2" width="8" height="8" rx="1" />
                <rect x="14" y="14" width="8" height="8" rx="1" />
                <rect x="2" y="14" width="8" height="8" rx="1" />
            </svg>
            Item Master
            <span class="mod-badge mod-badge-blue">Catálogo</span>
        </button>
    </div>

    <!-- ════════════════ INBOUND ════════════════ -->
    <div class="mod-panel active" id="mod-panel-inbound">

        <div class="mod-sub-tabs">
            <button class="mod-sub-btn active" onclick="modSwitchSub('ib-single', 'inbound', this)">
                Registro individual
            </button>
            <button class="mod-sub-btn" onclick="modSwitchSub('ib-csv', 'inbound', this)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                Carga masiva CSV
            </button>
        </div>

        <!-- Individual -->
        <div class="mod-sub-panel active" id="mod-sub-ib-single">
            <div class="mod-card">
                <p class="mod-section-label">Datos del pedido</p>

                <div class="mod-form-grid">
                    <div class="mod-field">
                        <label for="ib-orden">Número de orden <span class="req">*</span></label>
                        <input id="ib-orden" type="text" placeholder="ej. ORD-2024-001" />
                        <div class="mod-err" id="e-ib-orden"></div>
                    </div>
                    <div class="mod-field">
                        <label for="ib-ordes">Descripción de la orden</label>
                        <input id="ib-ordes" type="text" placeholder="ej. Reabastecimiento bodega A" />
                    </div>
                    <div class="mod-field">
                        <label for="ib-codigo">Código de artículo <span class="req">*</span></label>
                        <input id="ib-codigo" type="text" placeholder="ej. ART-001" />
                        <div class="mod-err" id="e-ib-codigo"></div>
                    </div>
                    <div class="mod-field">
                        <label for="ib-desc">Descripción del artículo <span class="req">*</span></label>
                        <input id="ib-desc" type="text" placeholder="ej. Tornillo M6" />
                        <div class="mod-err" id="e-ib-desc"></div>
                    </div>
                    <div class="mod-field">
                        <label for="ib-unidad">Unidad de medida <span class="req">*</span></label>
                        <input id="ib-unidad" type="text" placeholder="PZA" style="text-transform:uppercase;" />
                        <div class="mod-hint">PZA · KG · LT · MT · CJ</div>
                        <div class="mod-err" id="e-ib-unidad"></div>
                    </div>
                    <div class="mod-field">
                        <label for="ib-cantidad">Cantidad <span class="req">*</span></label>
                        <input id="ib-cantidad" type="number" placeholder="0" min="1" />
                        <div class="mod-err" id="e-ib-cant"></div>
                    </div>
                </div>

                <div class="mod-alert" id="res-inbound"></div>

                <div class="mod-actions">
                    <button type="button" class="mod-btn mod-btn-ghost" onclick="modReset('ib')">↺ Limpiar</button>
                    <button type="button" class="mod-btn mod-btn-primary" id="btn-inbound" onclick="enviarInbound()">
                        <div class="mod-spinner" id="sp-inbound"></div>
                        Enviar Inbound →
                    </button>
                </div>
            </div>
        </div>

        <!-- CSV masivo -->
        <div class="mod-sub-panel" id="mod-sub-ib-csv">
            <div class="mod-card">

                <div class="mod-info-bar">
                    <div>
                        <p class="mod-section-label" style="margin-bottom:.4rem">Carga masiva</p>
                        <p>
                            El CSV debe tener encabezado en la primera fila con estas columnas en orden:<br />
                            <code>OrdenNumero, OrdenDescripcion, Codigo, Descripcion, Unidad, Cantidad</code>
                        </p>
                    </div>
                    <button class="mod-btn mod-btn-ghost" onclick="descargarPlantilla()" style="flex-shrink:0;margin-top:4px">
                        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
                            <polyline points="7 10 12 15 17 10" />
                            <line x1="12" y1="15" x2="12" y2="3" />
                        </svg>
                        Plantilla CSV
                    </button>
                </div>

                <!-- Drop zone -->
                <div id="mod-drop-zone" class="mod-drop-zone"
                     onclick="document.getElementById('csv-file').click()"
                     ondragover="event.preventDefault();this.classList.add('drag-over')"
                     ondragleave="this.classList.remove('drag-over')"
                     ondrop="csvOnDrop(event);this.classList.remove('drag-over')">
                    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#94a3b8"
                         stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"
                         style="display:block;margin:0 auto .6rem">
                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                        <polyline points="14 2 14 8 20 8" />
                        <line x1="12" y1="11" x2="12" y2="17" />
                        <polyline points="9 14 12 17 15 14" />
                    </svg>
                    <p>Arrastra tu CSV aquí o haz clic para seleccionar</p>
                    <p class="mod-drop-filename" id="csv-filename">Ningún archivo seleccionado</p>
                </div>
                <input type="file" id="csv-file" accept=".csv" class="d-none"
                       onchange="csvSeleccionado(this.files[0])" />

                <!-- Errores de parseo -->
                <div id="csv-errores" class="mod-csv-warn"></div>

                <!-- Preview -->
                <div id="csv-preview" style="display:none;margin-top:1.25rem">
                    <div class="mod-preview-header">
                        <span>
                            Vista previa
                            <span class="mod-count-pill" id="csv-count">0</span>
                            registros válidos
                        </span>
                        <button class="mod-btn-link" onclick="limpiarCsv()">✕ Quitar archivo</button>
                    </div>

                    <div class="mod-preview-wrap">
                        <table class="mod-table">
                            <thead>
                                <tr>
                                    <th>#</th>
                                    <th>OrdenNumero</th>
                                    <th>OrdenDescripcion</th>
                                    <th>Codigo</th>
                                    <th>Descripcion</th>
                                    <th>Unidad</th>
                                    <th>Cantidad</th>
                                </tr>
                            </thead>
                            <tbody id="csv-tbody"></tbody>
                        </table>
                    </div>

                    <div class="mod-alert" id="res-csv"></div>

                    <div class="mod-actions" style="margin-top:.9rem">
                        <button type="button" class="mod-btn mod-btn-ghost" onclick="limpiarCsv()">↺ Cancelar</button>
                        <button type="button" class="mod-btn mod-btn-primary" id="btn-csv" onclick="confirmarEnviarCsv()">
                            <div class="mod-spinner" id="sp-csv"></div>
                            Confirmar y enviar (<span id="csv-count2">0</span> registros) →
                        </button>
                    </div>
                </div>

            </div>
        </div>

    </div><!-- /panel-inbound -->
    <!-- ════════════════ MAINTENANCE ════════════════ -->
    <div class="mod-panel" id="mod-panel-maintenance">

        <div class="mod-sub-tabs">
            <button class="mod-sub-btn active" onclick="modSwitchSub('mt-single', 'maintenance', this)">
                Registro individual
            </button>
            <button class="mod-sub-btn" onclick="modSwitchSub('mt-csv', 'maintenance', this)">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                    <polyline points="14 2 14 8 20 8" />
                </svg>
                Carga masiva CSV
            </button>
        </div>

        <!-- Individual -->
        <div class="mod-sub-panel active" id="mod-sub-mt-single">
            <div class="mod-card">
                <p class="mod-section-label">Datos del surtimiento</p>

                <div class="mod-form-grid">
                    <div class="mod-field">
