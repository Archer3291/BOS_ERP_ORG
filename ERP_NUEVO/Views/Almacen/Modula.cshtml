function renderizarPreviewMt(registros, errores) {
    var errBox = document.getElementById('csv-errores-mt');
    if (errores.length > 0) {
        errBox.className = 'mod-csv-warn show';
        errBox.innerHTML = '<strong>⚠ ' + errores.length + ' fila(s) con error (omitidas):</strong>' +
            '<ul style="margin:.4rem 0 0 1rem">' +
            errores.map(function (e) { return '<li>' + e + '</li>'; }).join('') +
            '</ul>';
    } else {
        errBox.className = 'mod-csv-warn';
    }

    var tbody = document.getElementById('csv-tbody-mt');
    tbody.innerHTML = '';
    registros.forEach(function (r, i) {
        tbody.innerHTML +=
            '<tr>' +
            '<td class="mod-muted">'  + (i + 1) + '</td>' +
            '<td>'  + r.OrdenNumero + '</td>' +
            '<td class="mod-muted">' + (r.OrdenDescripcion || '—') + '</td>' +
            '<td><code class="mod-code">' + r.Codigo + '</code></td>' +
            '<td>'  + r.Descripcion + '</td>' +
            '<td><span class="mod-badge-unit">' + r.Unidad + '</span></td>' +
            '<td class="mod-num">'  + r.Cantidad + '</td>' +
            '<td class="mod-num">'  + r.LineaHost + '</td>' +
            '<td class="mod-muted">' + (r.Lote      || '—') + '</td>' +
            '<td class="mod-muted">' + (r.Nota      || '—') + '</td>' +
            '<td class="mod-muted">' + (r.Prioridad || '—') + '</td>' +
            '</tr>';
    });

    document.getElementById('csv-count-mt').textContent  = registros.length;
    document.getElementById('csv-count2-mt').textContent = registros.length;
    document.getElementById('csv-preview-mt').style.display = registros.length === 0 ? 'none' : 'block';

    var resBox = document.getElementById('res-csv-mt');
    resBox.className  = 'mod-alert';
    resBox.textContent = '';
}

function limpiarCsvMt() {
    csvRegistrosMt = [];
    document.getElementById('csv-file-mt').value             = '';
    document.getElementById('csv-filename-mt').textContent   = 'Ningún archivo seleccionado';
    document.getElementById('csv-preview-mt').style.display  = 'none';
    document.getElementById('csv-errores-mt').className      = 'mod-csv-warn';
    var resBox = document.getElementById('res-csv-mt');
    resBox.className  = 'mod-alert';
    resBox.textContent = '';
}

function confirmarEnviarCsvMt() {
    if (!csvRegistrosMt || csvRegistrosMt.length === 0) return;

    modSetLoading('btn-csv-mt', 'sp-csv-mt', true);

    fetch('@Url.Action("EnviarMaintenanceMasivo", "Modula")', {
        method:  'POST',
        headers: { 'Content-Type': 'application/json' },
        body:    JSON.stringify(csvRegistrosMt)
    })
    .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); })
    .then(function (data) {
        var resBox = document.getElementById('res-csv-mt');
        resBox.className  = 'mod-alert show ' + (data.ok ? 'mod-alert-ok' : 'mod-alert-err');
        resBox.textContent = (data.ok ? '✓ ' : '✕ ') +
            (data.total ? data.total + ' registros — ' : '') + data.mensaje;
    })
    .catch(function (err) {
        var resBox = document.getElementById('res-csv-mt');
        resBox.className  = 'mod-alert show mod-alert-err';
        resBox.textContent = '✕ Error de red: ' + err.message;
    })
    .finally(function () { modSetLoading('btn-csv-mt', 'sp-csv-mt', false); });
}
</script>
