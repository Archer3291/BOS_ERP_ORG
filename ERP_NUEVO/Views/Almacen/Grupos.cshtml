@{
    ViewBag.Title = "Grupos";
    ViewBag.PageTitle = "Grupos";
}

<script>window.document.title = 'Grupos de Productos'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn blue-500 mb-3" id="btnAdd" onclick="createGroup()">
                    <i class="fa-duotone fa-solid fa-plus"></i> Nuevo Grupo
                </button>
            </div>
        </div>

        <div class="table-responsive-sm">
            <table id="groupsTable" class="table modern-table" style="width:100%">
                <thead class="bg-secondary">
                    <tr>
                        <th>Clave</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade" id="groupModal" tabindex="-1" aria-labelledby="groupModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="groupModalLabel">Registrar Nuevo Grupo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="groupForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4">
                        <label class="form-label" for="Clave">Ingresar clave</label>
                        <input type="number" id="Clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="Description">Ingresar descripción</label>
                        <input type="text" id="Description" class="form-control form-icon-trailing" name="Description" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <select class="form-select" id="Activo" name="Activo" required>
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-outline-success" onclick="sendForm()">
                        <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Almacen/grupos.js"></script>
}