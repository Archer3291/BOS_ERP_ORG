@{
    ViewData["Title"] = "Tipos de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Tipos";
}

@section styles {
    <!-- Estilos personalizados si se requieren -->
}

<div class="contenedor-tabla">
    <div class="container-fluid border-bottom py-2 shadow-sm">
        <div class="d-flex justify-content-between align-items-center px-3">
            <div>
                <button type="button" class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#modalBuscarTipoProducto">
                    Buscar tipo
                </button>
            </div>
            <div>
                <button type="button" class="btn btn-primary shadow-lg" data-bs-toggle="modal" data-bs-target="#modalAgregarTipo" onclick="createType()">
                    Agregar tipo
                </button>
            </div>
        </div>
    </div>

    <form id="formTiposProducto">
        <div class="card shadow-3">
            <div class="card-body">
                <div class="row g-3 align-items-center">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <select class="form-select" id="claveTipoProducto" name="claveTipoProducto" disabled>
                                <option value="">Seleccione</option>
                            </select>
                            <label for="claveTipoProducto">Clave del tipo de producto</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" disabled class="form-control" id="nombreTipoProducto" name="nombreTipoProducto" placeholder="Nombre del tipo de producto">
                            <label for="nombreTipoProducto">Nombre del tipo de producto</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <select class="form-select" id="Status" name="Status" disabled>
                            <option>Selecciona un estado</option>
                            <option value="1">Activo</option>
                            <option value="0">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="text-end mt-4">
                    <button type="button" class="btn btn-primary" id="editTypeButton" title="Guardar" onclick="editType(this)">
                        Editar tipo
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

<!-- Modal Buscar Tipo de Producto -->
<div class="modal fade" id="modalBuscarTipoProducto" tabindex="-1" aria-labelledby="modalBuscarTipoProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalBuscarTipoProductoLabel">Buscar Tipo de Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="mb-4">
                    <div class="input-group shadow-sm">
                        <input type="text" class="form-control shadow-none" id="inputBuscarTipoProducto" placeholder="Ej. Eléctrico, Mecánico, etc.">
                        <button class="btn btn-outline-secondary shadow-sm" type="button" id="btnLimpiarResultadosTipo">
                            <i class="bi bi-x-circle me-1"></i> Limpiar
                        </button>
                    </div>
                </div>
                <div class="border rounded-3 p-2 bg-light-subtle">
                    <ul class="list-group list-group-flush" id="listaResultadosTiposProducto">
                    </ul>
                </div>
            </div>
            <div id="pagination-tipos-producto" class="d-flex justify-content-around">
            </div>
        </div>
    </div>
</div>


<!-- Modal Agregar Tipo de Producto -->
<div class="modal fade" id="modalAgregarTipo" tabindex="-1" aria-labelledby="modalAgregarTipoLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="typeModalLabel">Registrar Nuevo Tipo</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="typeForm">
                @Html.AntiForgeryToken()
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4">
                        <label class="form-label" for="Clave">Ingresar clave</label>
                        <input type="number" id="Clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="Description">Ingresar descripción</label>
                        <input type="text" id="Description" class="form-control form-icon-trailing" name="Description" />
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <select class="form-select" id="Status" name="Status" required>
                                <option>Selecciona un estado</option>
                                <option value="1">Activo</option>
                                <option value="0">Inactivo</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar
                    </button>
                    <button type="button" class="btn btn-outline-success" onclick="sendForm()">
                        <i class="fa-duotone fa-solid fa-floppy-disk fa-beat"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/Scripts/formularios.js"></script>
    <script src="~/Scripts/General/general.js"></script>
    <script src="~/Scripts/Almacen/tipos.js"></script>
}
