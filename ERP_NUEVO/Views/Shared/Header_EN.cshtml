@model BOS_ERP.Models.Factura
@using BOS_ERP.Controllers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: 'Segoe UI', Calibri, Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.3;
            letter-spacing: 0.5px;
            margin: 0;
            padding: 0;
        }

        .header-container {
            width: 100%;
            border: 1px solid #e0e0e0;
            border-bottom: 3px solid #d32f2f;
            padding: 10px;
            margin-bottom: 2px;
            background: #fafafa;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .logo-cell {
            width: 18%;
            vertical-align: middle;
            padding-right: 8px;
            text-align: center;
        }

            .logo-cell img {
                width: 100px;
                max-height: 75px;
                display: block;
                margin: 0 auto;
                border-radius: 3px;
            }

        .emisor-cell {
            width: 50%;
            vertical-align: middle;
            padding: 0 10px;
            border-left: 2px solid #e0e0e0;
            border-right: 2px solid #e0e0e0;
        }

        .factura-cell {
            width: 32%;
            vertical-align: middle;
            padding: 8px 10px;
            background: #f5f5f5;
            border-radius: 3px;
        }

        .header-title {
            font-size: 13px;
            font-weight: bold;
            color: #d32f2f;
            margin: 0 0 6px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .factura-title {
            font-size: 12px;
            font-weight: bold;
            color: #1976d2;
            margin: 0 0 6px 0;
            text-align: right;
        }

        .emisor-info,
        .factura-info {
            font-size: 8px;
            line-height: 1.6;
        }

            .emisor-info div,
            .factura-info div {
                margin: 2px 0;
            }

            .emisor-info strong {
                color: #1976d2;
                font-weight: bold;
                display: inline-block;
                min-width: 85px;
            }

            .factura-info strong {
                color: #555;
                font-weight: bold;
                display: inline-block;
                min-width: 65px;
            }

        .uuid-highlight {
            background: white;
            padding: 4px 6px;
            border-radius: 2px;
            margin-top: 6px;
            font-size: 7.5px;
            word-break: break-all;
            border-left: 3px solid #1976d2;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

            .uuid-highlight strong {
                color: #1976d2;
                min-width: auto;
            }
    </style>
</head>
<body>
    <div class="header-container">
        <table class="header-table">
            <tr>
                @{
                    var absoluteUrl = Context.Request.Scheme + "://" + Context.Request.Host.Value + Url.Content($"~/content/img/{Context.Session.GetString("EmpresaFactura")}/logo.png");
                }
                <!-- Logo -->
                <td class="logo-cell">
                    <img src="@absoluteUrl" alt="Company Logo" />
                </td>

                <!-- Issuer Information -->
                <td class="emisor-cell">
                    @if (@Model.TipoFacturacion == "ANTICIPO")
                    {
                        <div class="header-title">Advance Payment Invoice</div>
                    }
                    else
                    {
                <div class="header-title">COMERCIAL INVOICE</div>
                    }
                    <div class="emisor-info">
                        <div><strong>RFC:</strong> @Model.RfcEmisor</div>
                        <div><strong>REGISTERED NAME:</strong> @Model.RsoEmisor</div>
                        <div><strong>TAX REGIME:</strong> @Model.Rege -- @Model.regimenEText</div>
                        <div><strong>TAX ADRESS:</strong> @Model.LugarExpedicion</div>
                    </div>
                </td>

                <!-- Invoice Data -->
                <td class="factura-cell">
                    <div class="factura-info">
                        <div><strong>Date:</strong> @Model.Fecha</div>
                        <div><strong>Type:</strong> @Model.TipoDeComprobante</div>
                        <div><strong>Series:</strong> @Model.Serie</div>
                        <div><strong>Sheet:</strong> @Model.Folio</div>
                        <div><strong>Short sheet:</strong> @Model.FolioCorto</div>
                        @if (!string.IsNullOrEmpty(Model.Oc))
                        {
                            <div><strong>Purchase Order:</strong> @Model.Oc</div>
                        }
                    </div>
                    <div class="uuid-highlight">
                        <strong>Tax Sheet:</strong> @Model.UUID
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
