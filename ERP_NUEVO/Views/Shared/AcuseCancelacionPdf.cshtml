@model BOS_ERP.Models.AcuseCancelacion
@using BOS_ERP.Controllers
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Acuse de Cancelación @Model.Uuid</title>
    <style>
        @@page {
            size: A4;
            margin: 15mm;
        }

        body {
            font-family: 'Segoe UI', Calibri, Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.3;
            letter-spacing: 0.3px;
            margin: 0;
            padding: 0;
        }

        h1, h2 {
            color: #b00020;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            background-color: #1976d2;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-size: 10px;
            letter-spacing: 0.4px;
        }

        td {
            padding: 4px 8px;
            vertical-align: top;
        }

        .section-title {
            font-size: 13px;
            color: #b00020;
            margin-top: 15px;
            margin-bottom: 8px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 3px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .info-box {
            border: 1px solid #ccc;
            padding: 6px;
            margin-top: 3px;
            background-color: #fafafa;
            line-height: 1.3;
        }

            .info-box strong {
                color: #333;
            }

        .sello {
            word-break: break-word;
            white-space: pre-wrap;
            font-family: 'Courier New', monospace;
            font-size: 9px;
            background-color: #f9f9f9;
            border: 1px dashed #aaa;
            padding: 6px;
            margin-bottom: 8px;
        }

        .qr {
            text-align: center;
            margin-top: 20px;
        }

            .qr img {
                width: 150px;
                height: 150px;
            }

        .estatus-box {
            margin-top: 20px;
            text-align: right;
            font-size: 12px;
        }

        .estatus-destacado {
            display: inline-block;
            background: #fdecea;
            border: 1px solid #b00020;
            color: #b00020;
            font-weight: bold;
            font-size: 13px;
            padding: 6px 14px;
            border-radius: 3px;
            text-transform: uppercase;
        }

        .observaciones-box {
            background-color: #fff8e1;
            border-left: 3px solid #ffc107;
            padding: 6px;
            margin: 12px 0;
            font-size: 10px;
        }

        .pagare-box {
            border: 2px solid #333;
            padding: 15px;
            background-color: #fafafa;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <!-- DATOS DEL ACUSE -->
    <div class="section-title">Datos de la Cancelación</div>
    <table>
        <tr>
            <td style="width: 18%;"><strong>Fecha de Cancelación:</strong></td>
            <td style="width: 32%;">@Model.FechaCancelacion.ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td style="width: 18%;"><strong>Estatus:</strong></td>
            <td style="width: 32%;">@Model.Estatus</td>
        </tr>
        <tr>
            <td><strong>Motivo:</strong></td>
            <td colspan="3">@Model.Motivo</td>
        </tr>
        @if (!string.IsNullOrWhiteSpace(Model.FolioSustitucion))
        {
            <tr>
                <td><strong>Folio de Sustitución:</strong></td>
                <td colspan="3">@Model.FolioSustitucion</td>
            </tr>
        }
    </table>

    <!-- EMISOR -->
    <div class="section-title">Emisor</div>
    <div class="info-box">
        <table style="width: 100%;">
            <tr>
                <td style="width: 18%;"><strong>RFC:</strong></td>
                <td style="width: 32%;">@Model.RfcEmisor</td>
                @if (!string.IsNullOrWhiteSpace(Model.RfcReceptor))
                {
                    <td style="width: 18%;"><strong>RFC Receptor:</strong></td>
                    <td style="width: 32%;">@Model.RfcReceptor</td>
                }
            </tr>
        </table>
    </div>

    <!-- FOLIO FISCAL -->
    <div class="section-title">Folio Fiscal Cancelado</div>
    <div class="sello" style="font-size: 11px; text-align: center;">
        @Model.Uuid
    </div>

    <!-- ESTATUS DESTACADO -->
    <div class="estatus-box">
        <span class="estatus-destacado">CFDI Cancelado @(!string.IsNullOrWhiteSpace(Model.Estatus) ? "— Estatus " + Model.Estatus : "")</span>
    </div>

    <!-- SELLOS -->
    <div class="section-title" style="margin-top: 25px;">Sello y Verificación</div>
    <table>
        <tr>
            <!-- Columna Sello -->
            <td style="width: 75%; vertical-align: top;">
                <p style="margin: 5px 0 3px 0;"><strong>Sello SAT:</strong></p>
                <div class="sello">@Model.SelloSAT</div>
            </td>

            <!-- Columna QR -->
            @if (!string.IsNullOrEmpty(Model.RutaQr))
            {
                <td style="width: 25%; text-align: center; vertical-align: top; padding-left: 10px;">
                    <strong style="display: block; margin-bottom: 8px;">Código QR</strong>
                    <img src="@Url.Content(Model.RutaQr)" alt="QR Acuse" style="width: 150px; height: 150px; border: 1px solid #ccc; padding: 5px; background: white;" />
                    <br><small style="color: #666;">Verificación SAT</small>
                </td>
            }
        </tr>
    </table>

    <!-- AVISO LEGAL -->
    <div class="pagare-box">
        <p style="font-size: 10px; line-height: 1.6; text-align: justify; margin: 0;">
            Este documento constituye el acuse de cancelación del Comprobante Fiscal Digital por Internet (CFDI)
            con folio fiscal antes señalado, conforme a lo establecido por el Servicio de Administración Tributaria (SAT).
            La cancelación surte efectos a partir de la fecha indicada en este acuse.
        </p>
    </div>

    <!-- Footer -->
    <div style="text-align: center; margin-top: 25px; padding-top: 10px; border-top: 1px solid #ccc; font-size: 10px; color: #666;">
        <strong>Este documento es una representación impresa del acuse de cancelación de CFDI</strong><br>
        Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

</body>
</html>