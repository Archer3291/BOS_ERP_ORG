@model BOS_ERP.Models.Factura
@using System.Data
@using System.Linq

@* @using ModulaService; *@
@using BOS_ERP.Models;
@using System;
@using System.Collections.Generic;
@using System.Collections.Specialized;
@using System.Configuration;
@using System.Data;
@using System.Data.SqlClient;
@using System.IO;
@using System.Linq;
@using System.Net;
@using System.Net.Mail;
@using System.Threading.Tasks;
@using Microsoft.AspNetCore.Mvc;
@using System.Windows;

@{
    Layout = null;

    // Determinar etiqueta del tipo de NC
    string tipoNC = (Model.TipoFacturacion ?? "").ToUpper();
    string etiquetaTipo = tipoNC switch
    {
        "DEVOLUCION" => "DEVOLUCIÓN",
        "DESCUENTO" => "DESCUENTO",
        "PRECIO" => "AJUSTE DE PRECIO",
        _ => "NOTA DE CRÉDITO"
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Nota de Crédito @Model.UUID</title>
    <style>
        @@page {
            size: A4;
            margin: 15mm;
        }

        thead {
            display: table-header-group;
            background-color: #e0e0e0;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.2;
            margin: 0;
            padding: 0;
        }

        h1, h2 {
            color: #1565c0;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            background-color: #1565c0;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-size: 10px;
        }

        td {
            padding: 4px 8px;
            vertical-align: top;
        }

        /* ── Banner superior de NC ── */
        .nc-banner {
            background-color: #1565c0;
            color: white;
            text-align: center;
            padding: 10px;
            margin-bottom: 14px;
            border-radius: 4px;
        }

            .nc-banner h2 {
                margin: 0;
                font-size: 16px;
                color: white;
                letter-spacing: 1px;
            }

            .nc-banner p {
                margin: 3px 0 0 0;
                font-size: 10px;
                opacity: 0.85;
            }

        .section-title {
            font-size: 13px;
            color: #1565c0;
            margin-top: 15px;
            margin-bottom: 8px;
            border-bottom: 2px solid #1565c0;
            padding-bottom: 3px;
            text-transform: uppercase;
            font-weight: bold;
        }

        .info-box {
            border: 1px solid #ccc;
            padding: 6px;
            margin-top: 3px;
            background-color: #fafafa;
        }

            .info-box strong {
                color: #333;
            }

        /* ── Tabla de conceptos ── */
        .productos th, .productos td {
            border: 1px solid #bbb;
            font-size: 10px;
            padding: 5px 6px;
        }

        .productos tbody tr:nth-child(even) {
            background-color: #f5f5f5;
        }

        .productos td.descripcion {
            font-weight: 500;
        }

        .productos td.numero {
            text-align: center;
            width: 8%;
        }

        .productos td.cantidad,
        .productos td.precio,
        .productos td.importe {
            text-align: right;
        }

        .productos {
            page-break-inside: auto;
        }

            .productos thead {
                display: table-header-group;
            }

            .productos tfoot {
                display: table-footer-group;
            }

            .productos tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

        /* ── Observaciones ── */
        .observaciones-box {
            background-color: #e8eaf6;
            border-left: 3px solid #1565c0;
            padding: 6px;
            margin: 12px 0;
            font-size: 10px;
        }

        /* ── Totales ── */
        .totales-table {
            width: 100%;
            margin-top: 20px;
            border-collapse: collapse;
        }

        .total-numeros table {
            width: 100%;
            border: 1px solid #ccc;
            background-color: #fafafa;
        }

        .total-numeros td {
            padding: 6px 10px;
            font-size: 11px;
        }

        .total-numeros .final-row {
            border-top: 2px solid #1565c0;
            background-color: #e3f2fd;
        }

            .total-numeros .final-row td {
                font-weight: bold;
                color: #1565c0;
                font-size: 13px;
            }

        /* ── CFDIs relacionados ── */
        .rel-badge {
            display: inline-block;
            background-color: #1565c0;
            color: white;
            font-size: 9px;
            padding: 2px 6px;
            border-radius: 3px;
            margin-left: 6px;
            vertical-align: middle;
        }

        /* ── Sellos ── */
        .sello {
            word-break: break-word;
            white-space: pre-wrap;
            font-family: 'Courier New', monospace;
            font-size: 9px;
            background-color: #f9f9f9;
            border: 1px dashed #aaa;
            padding: 6px;
            margin-bottom: 8px;
        }
    </style>
</head>
<body>

    <!-- ══ BANNER NOTA DE CRÉDITO ══════════════════════════════════════════ -->
    <div class="nc-banner">
        <h2>NOTA DE CRÉDITO — @etiquetaTipo</h2>
    </div>

    <!-- ══ DATOS DEL COMPROBANTE ══════════════════════════════════════════ -->
    <div class="section-title">Datos del Comprobante</div>
    <table>
        <tr>
            <td style="width:18%;"><strong>Fecha de Emisión:</strong></td>
            <td style="width:32%;">@(string.IsNullOrEmpty(Model.FechaTimbrado) ? DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss") : DateTime.Parse(Model.FechaTimbrado).ToString("dd/MM/yyyy HH:mm:ss"))</td>
            <td style="width:18%;"><strong>Tipo de Comprobante:</strong></td>
            <td style="width:32%;">@Model.TipoDeComprobante</td>
        </tr>
        <tr>
            <td><strong>Forma de Pago:</strong></td>
            <td>@Model.IdTipoPago -- @Model.formaPagoTexto</td>
            <td><strong>Método de Pago:</strong></td>
            <td>@Model.metodoPagoTexto -- @Model.MdpFactura</td>
        </tr>
        <tr>
            <td><strong>Moneda:</strong></td>
            <td>@Model.Moneda</td>
            <td><strong>Tipo de Cambio:</strong></td>
            <td>@Model.TipoCambio</td>
        </tr>
        <tr>
            <td><strong>Exportación:</strong></td>
            <td>@(Model.Exportacion ?? "01")</td>
            <td><strong>Lugar de Expedición:</strong></td>
            <td>@(Model.LugarExpedicion ?? Model.CpE)</td>
        </tr>
    </table>

    <!-- ══ CFDI RELACIONADO (factura origen) ═════════════════════════════ -->
    @if (!string.IsNullOrWhiteSpace(Model.UUIDsRelacionados))
    {
        <div class="section-title">
            CFDI(s) Relacionado(s)
            <span class="rel-badge">Tipo Relación: @(Model.TipoRelacion ?? "01")</span>
        </div>
        <div class="info-box">
            @foreach (var uuid in Model.UUIDsRelacionados.Split(new[] { ',', ';', '|' }, StringSplitOptions.RemoveEmptyEntries))
            {
                <div style="font-family:'Courier New',monospace; font-size:10px; padding:2px 0;">
                    @uuid.Trim()
                </div>
            }
        </div>
    }

    <!-- ══ EMISOR ═════════════════════════════════════════════════════════ -->
    <div class="section-title">Emisor</div>
    <div class="info-box">
        <table style="width:100%;">
            <tr>
                <td style="width:18%;"><strong>RFC:</strong></td>
                <td style="width:32%;">@Model.RfcEmisor</td>
                <td style="width:18%;"><strong>Régimen Fiscal:</strong></td>
                <td style="width:32%;">@Model.Rege</td>
            </tr>
            <tr>
                <td><strong>Razón Social:</strong></td>
                <td colspan="3">@Model.RsoEmisor</td>
            </tr>
        </table>
    </div>

    <!-- ══ RECEPTOR ══════════════════════════════════════════════════════ -->
    <div class="section-title">Receptor</div>
    <div class="info-box">
        <table style="width:100%;">
            <tr>
                <td style="width:18%;"><strong>RFC:</strong></td>
                <td style="width:32%;">@Model.RfcCliente</td>
                <td style="width:18%;"><strong>Régimen Fiscal:</strong></td>
                <td style="width:32%;">@Model.Regc</td>
            </tr>
            <tr>
                <td><strong>Razón Social:</strong></td>
                <td colspan="3">@Model.RsoCliente</td>
            </tr>
            <tr>
                <td><strong>Domicilio Fiscal:</strong></td>
                <td>@Model.CpR</td>
                <td><strong>Uso CFDI:</strong></td>
                <td>@Model.IdUsoCFDI -- @Model.CFDIText</td>
            </tr>
        </table>
    </div>

    <!-- ══ CONCEPTOS ═════════════════════════════════════════════════════ -->
    <div class="section-title">Conceptos</div>
    <table class="productos">
        <thead>
            <tr>
                <th style="width:10%;">No. Identificación</th>
                <th style="width:36%;">Descripción</th>
                <th style="width:8%;">Cantidad</th>
                <th style="width:8%;">Unidad</th>
                <th style="width:12%;">Precio Unit.</th>
                <th style="width:10%;">Descuento</th>
                <th style="width:16%;">Importe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Tproductos.Rows)
            {
                decimal cant = Convert.ToDecimal(row["cantidad"]);
                decimal precio = Convert.ToDecimal(row["precioUnit"]);
                decimal descPct = Convert.ToDecimal(row["descuento"]);
                decimal ivaPct = row.Table.Columns.Contains("iva") ? Convert.ToDecimal(row["iva"]) : 0m;
                decimal iepsPct = row.Table.Columns.Contains("ieps") ? Convert.ToDecimal(row["ieps"]) : 0m;

                decimal importe = Math.Round(cant * precio, 2);
                decimal desc = Math.Round(importe * descPct / 100m, 2);
                decimal baseGrv = importe - desc;
                decimal ivaImp = Math.Round(baseGrv * ivaPct / 100m, 2);
                decimal iepsImp = Math.Round(baseGrv * iepsPct / 100m, 2);
                decimal total = baseGrv + ivaImp + iepsImp;

                <tr>
                    <td class="numero">@row["numero"]</td>
                    <td class="descripcion">
                        <strong>@row["descripcion"]</strong>
                        <br />
                        <small style="color:#888;">
                            Clave Prod/Serv: @row["claveProdServ"] &nbsp;|&nbsp;
                            Clave Unidad: @row["claveUnidad"] &nbsp;|&nbsp;
                            Objeto Imp: @row["objetoImp"]
                        </small>
                        @if (row.Table.Columns.Contains("comentario") && !string.IsNullOrWhiteSpace(row["comentario"]?.ToString()))
                        {
                            <br />
                            <small style="color:#555; font-style:italic; background-color:#e8eaf6; padding:2px 4px; border-left:2px solid #1565c0;">
                                @row["comentario"]
                            </small>
                        }
                    </td>
                    <td class="cantidad">@string.Format("{0:N2}", cant)</td>
                    <td class="numero">@row["unidad"]</td>
                    <td class="precio">@string.Format("{0:C2}", precio)</td>
                    <td class="precio" style="color:#c62828;">
                        @{ if (descPct > 0)
                            {
                                @(string.Format("{0:C2}", desc))
                                <br /><small> (@descPct %) </small>
                            }
                            else
                            {
                                @:—
                            }
                        }
                    </td>
                    <td class="importe">@string.Format("{0:C2}", total)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- ══ OBSERVACIONES / CONCEPTO ═══════════════════════════════════════ -->
    @if (!string.IsNullOrEmpty(Model.Observaciones))
    {
        <div class="observaciones-box">
            <strong>Concepto / Observaciones:</strong> @Model.Observaciones
        </div>
    }

    <!-- ══ TOTALES ════════════════════════════════════════════════════════ -->
    <table class="totales-table">
        <tr>
            <!-- Letra -->
            <td style="width:60%; vertical-align:top; padding-right:20px;">
                <strong>Total con Letra:</strong><br />
                @Model.TotalTexto @Model.Moneda
            </td>

            <!-- Números -->
            <td style="width:40%; vertical-align:top;" class="total-numeros">
                <table>
                    <tr>
                        <td style="text-align:right; width:60%;"><strong>Subtotal:</strong></td>
                        <td style="text-align:right; width:40%;">@string.Format("{0:C2}", Model.Subtotal)</td>
                    </tr>
                    @if (Model.Descuento > 0)
                    {
                        <tr>
                            <td style="text-align:right; color:#c62828;"><strong>Descuento:</strong></td>
                            <td style="text-align:right; color:#c62828;">- @string.Format("{0:C2}", Model.Descuento)</td>
                        </tr>
                    }
                    <tr>
                        <td style="text-align:right;"><strong>IVA (16%):</strong></td>
                        <td style="text-align:right;">@string.Format("{0:C2}", Model.IVA)</td>
                    </tr>
                    @if (Model.IepsF > 0)
                    {
                        <tr>
                            <td style="text-align:right;"><strong>IEPS:</strong></td>
                            <td style="text-align:right;">@string.Format("{0:C2}", Model.IepsF)</td>
                        </tr>
                    }
                    <tr class="final-row">
                        <td style="text-align:right;"><strong>TOTAL NC:</strong></td>
                        <td style="text-align:right;"><strong>@string.Format("{0:C2}", Model.Total)</strong></td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>

    <!-- ══ SELLOS Y QR ════════════════════════════════════════════════════ -->
    <div class="section-title" style="margin-top:25px;">Sellos y Cadena Original</div>
    <table>
        <tr>
            <td style="width:75%; vertical-align:top;">
                <p style="margin:5px 0 3px 0;"><strong>No. de Serie del Certificado del SAT:</strong></p>
                <div class="sello">@Model.NoCertificadoSAT</div>

                <p style="margin:8px 0 3px 0;"><strong>No. de Serie del CSD del Emisor:</strong></p>
                <div class="sello">@Model.NoCertificado</div>

                <p style="margin:8px 0 3px 0;"><strong>Sello CFDI:</strong></p>
                <div class="sello">@Model.SelloCFDI</div>

                <p style="margin:8px 0 3px 0;"><strong>Sello SAT:</strong></p>
                <div class="sello">@Model.SelloSAT</div>

                <p style="margin:8px 0 3px 0;"><strong>Cadena Original:</strong></p>
                <div class="sello">@Model.CadenaOriginal</div>
            </td>

            @if (!string.IsNullOrEmpty(Model.RutaQr))
            {
                <td style="width:25%; text-align:center; vertical-align:top; padding-left:10px;">
                    <strong style="display:block; margin-bottom:8px;">Código QR</strong>
                    <img src="@Url.Content(Model.RutaQr)" alt="QR CFDI"
                         style="width:150px; height:150px; border:1px solid #ccc; padding:5px; background:white;" />
                    <br /><small style="color:#666;">Verificación SAT</small>
                </td>
            }
        </tr>
    </table>

    <!-- ══ FOOTER ════════════════════════════════════════════════════════ -->
    <div style="text-align:center; margin-top:25px; padding-top:10px; border-top:1px solid #ccc; font-size:10px; color:#666;">
        <strong>Este documento es una representación impresa de un CFDI — Nota de Crédito</strong><br />
        Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

</body>
</html>
