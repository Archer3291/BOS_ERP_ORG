        @{
            <!-- Operacion Dropdown -->
            var currentTipo = Context.Request.Query["tipo"].ToString().ToLower();
            // Definiciones
            //var tiposVenta = new[] { "sucursal", "industrial", "nacional", "internacionales" };
            var accionesCompra = new[] { "AltaCotizacion", "Index", "AltaPedido", "AltaPedidoInternacional", "AltaPedidoNacional", "HistorialPedidos", "SolicitudCotizacion" };

            var isOperacion = currentController == "Operaciones";

            // Definir qué submenu está abierto según acción y tipo exacto
            var isSubmenuNacional = (currentAction == "SolicitudCotizacion" || currentAction == "Index") && currentTipo == "nacional";
            var isSubmenuInternacional = (currentAction == "SolicitudCotizacion" || currentAction == "Index") && currentTipo == "internacional";
            var isSubmenuVentasAdministracion = (currentAction == "SolicitudCotizacion" || currentAction == "Index") && currentTipo == "internacional";
            var isSubmenuGastos = currentAction == "SolicitudCotizacion" && currentTipo == "gasto";

            var isCompraMainAbierto = currentController == "Compras" ? true : false;

            var permiso = Utilities.DoesUserHasRight(User.Identity.Name, "Gestion de Solicitudes");
            bool rol = Utilities.DoesUserHasRole(User.Identity.Name, "Gerente");
            bool esDirector = Utilities.DoesUserHasRole(User.Identity.Name, "Director");
            bool area = Utilities.DoesUserHasArea(User.Identity.Name, new List<string> { "Compras Nacionales", "Administración y Finanzas", "Direccion" });
            bool areaCompras = Utilities.DoesUserHasArea(User.Identity.Name, new List<string> { "Compras Nacionales", "Direccion" });

            var accionesVenta = new[] {
                                "Sucursales","Industrial","Nacional","Internacionales",
                                "PackingList","PuntoDeVenta",
                                "AltaCotizacion","AltaPedidos","AltaRemision","AltaFactura"
                                };

            var tiposVenta = new[] { "sucursal", "industrial", "nacional", "internacionales" };
            var isAnyVentaAbierta = currentController == "Ventas" || accionesVenta.Contains(currentAction) || tiposVenta.Contains(currentTipo);

            bool isSucursales = currentAction == "Sucursales" && currentController == "Ventas";
            bool isIndustrial = currentAction == "Industrial" && currentController == "Ventas";
            bool isNacional = currentAction == "Nacional" && currentController == "Ventas";
            bool isInternacionales = currentAction == "Internacionales" && currentController == "Ventas";
            bool isTubos = currentAction == "Index" && currentController == "Tubos";
            bool isPackingList = currentAction == "PackingList" && currentController == "Ventas";
            bool isPuntoDeVenta = currentAction == "PuntoDeVenta" && currentController == "Ventas";
            bool isRefacturacion = currentAction == "Refacturacion" && currentController == "Ventas";
            // La factura libre tiene controlador propio, no cuelga de Ventas.
            bool isFacturaLibre = currentController == "FacturaLibre";
            bool isNotasCredito = currentAction == "NotasCredito" && currentController == "Ventas";
            bool isConsultaNotasCredito = currentAction == "ConsultaNotasCredito" && currentController == "Ventas";
            bool isSolicitudNC = currentAction == "SolicitudNC" && currentController == "Ventas";
            bool isSolicitudRegresoMaterial = currentAction == "SolicitudRegresoMaterial" && currentController == "Ventas";
            bool isPedidosPendientes = currentAction == "PedidosPendientes" && currentController == "Ventas";
            bool isAprobacionAperturas = currentAction == "AprobacionAperturas" && currentController == "Ventas";
            // El portal vive en AutoFacturacionPublica; "Ventas/AutoFacturacion"
            // se conserva sólo como redirección para enlaces antiguos.
            bool isAutoFacturacion = currentController == "AutoFacturacionPublica"
                || (currentAction == "AutoFacturacion" && currentController == "Ventas");

            bool isVentaMainAbierto = currentController == "Ventas";
            bool isCompraDentroDeVentasAbierto = isVentaMainAbierto || currentAction == "PuntoDeVenta";

            bool isPVAdmin = currentAction == "BitacoraTickets" && currentController == "Ventas";
            bool isBitacora = currentAction == "BitacoraTickets" && currentController == "Ventas";
            bool isRetiro = currentAction == "RetiroEfectivo" && currentController == "Ventas";
            bool isPendientesEntrega = currentAction == "PendientesEntrega" && currentController == "Ventas";
            bool isFormasPagoBancos = currentAction == "FormasPagoBancos" && currentController == "Ventas";

            if (Utilities.DoesUserHasRight(User.Identity.Name, "operaciones"))
            {
                <div class="nav-item nav-dropdown">
                    <a href="#" class="nav-link dropdown-toggle @(currentController == "Compras" || currentController == "Ventas" ? "" : "collapsed")" data-label="Operaciones" data-bs-toggle="manual">
                        <i class="fa-duotone fa-arrows-rotate fa-fw"></i>
