            <a href="#" class="nav-link dropdown-toggle collapsed @(isGestionGerente ? "active" : "")" data-target="#gestionGerenteDropdown" data-label="Gestión de Usuarios">
                <i class="fa-solid fa-people-group"></i>
                Gestion de usuarios
            </a>
            <div class="nav-dropdown-menu @(isGestionGerente ? "show" : "collapsed")" id="gestionGerenteDropdown" data-titulo="Gestión de Usuarios">
                <a href="@Url.Action("GestionUsuarios", "Gerentes")" class="dropdown-item @(currentAction == "GestionUsuarios" ? "nav-link active active" : "")">Usuarios</a>
            </div>
        </div>
    }

    @if (Utilities.DoesUserHasRight(User.Identity.Name, "sistemas"))
    {
        var isSettings = currentController == "Settings";
        <div class="nav-item">
            <a href="@Url.Action("Settings", "Settings")" class="nav-link @(currentController == "Settings" ? "active" : "")" data-label="Configuración">
                <i class="fa-duotone fa-gear fa-fw"></i>
                Configuración
            </a>
        </div>
    }
    @if (User.Identity.IsAuthenticated)
    {
        var isSettings = currentController == "Chat";
        <div class="nav-item">
            <a href="@Url.Action("Chat", "Chat")" class="nav-link @(currentController == "Chat" ? "active" : "")" data-label="Chat">
                <i class="fa-solid fa-message-bot"></i>
                Asistente IA
            </a>
        </div>
    }
}