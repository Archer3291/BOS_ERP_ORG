                   data-target="#contabilidadDropdown" data-label="Contabilidad">
                    <i class="fa-duotone fa-calculator fa-fw"></i>
                    Contabilidad
                </a>
                <div class="nav-dropdown-menu @(isConta ? "show" : "collapsed")" id="contabilidadDropdown" data-titulo="Contabilidad">
                    @*@if (Utilities.DoesUserHasRight(User.Identity.Name, "conceptos"))
                                    {

                                        <a href="@Url.Action("Conceptos", "Contabilidad")" class="dropdown-item @(currentAction == "Conceptos" ? "nav-link active" : "")">Conceptos</a>
                                    }*@

                    @if (Utilities.DoesUserHasRight(User.Identity.Name, "departamentos"))
