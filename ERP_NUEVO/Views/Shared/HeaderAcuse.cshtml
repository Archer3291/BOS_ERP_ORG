@model BOS_ERP.Models.AcuseCancelacion
@using BOS_ERP.Controllers
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: 'Segoe UI', Calibri, Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.3;
            letter-spacing: 0.5px;
            margin: 0;
            padding: 0;
        }

        .header-container {
            width: 100%;
            border: 1px solid #e0e0e0;
            border-bottom: 3px solid #b00020;
            padding: 10px;
            margin-bottom: 2px;
            background: #fafafa;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .logo-cell {
            width: 18%;
            vertical-align: middle;
            padding-right: 8px;
            text-align: center;
        }

            .logo-cell img {
                width: 100px;
                max-height: 75px;
                display: block;
                margin: 0 auto;
                border-radius: 3px;
            }

        .emisor-cell {
            width: 50%;
            vertical-align: middle;
            padding: 0 10px;
            border-left: 2px solid #e0e0e0;
            border-right: 2px solid #e0e0e0;
        }

        .acuse-cell {
            width: 32%;
            vertical-align: middle;
            padding: 8px 10px;
            background: #f5f5f5;
            border-radius: 3px;
        }

        .header-title {
            font-size: 13px;
            font-weight: bold;
            color: #b00020;
            margin: 0 0 6px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .acuse-title {
            font-size: 12px;
            font-weight: bold;
            color: #1976d2;
            margin: 0 0 6px 0;
            text-align: right;
        }

        .emisor-info,
        .acuse-info {
            font-size: 8px;
            line-height: 1.6;
        }

            .emisor-info div,
            .acuse-info div {
                margin: 2px 0;
            }

            .emisor-info strong {
                color: #1976d2;
                font-weight: bold;
                display: inline-block;
                min-width: 85px;
            }

            .acuse-info strong {
                color: #555;
                font-weight: bold;
                display: inline-block;
                min-width: 65px;
            }

        .uuid-highlight {
            background: white;
            padding: 4px 6px;
            border-radius: 2px;
            margin-top: 6px;
            font-size: 7.5px;
            word-break: break-all;
            border-left: 3px solid #b00020;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

            .uuid-highlight strong {
                color: #b00020;
                min-width: auto;
            }

        .estatus-badge {
            display: inline-block;
            background: #b00020;
            color: white;
            font-size: 8px;
            font-weight: bold;
            padding: 2px 6px;
            border-radius: 2px;
            margin-top: 4px;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="header-container">
        <table class="header-table">
            <tr>
                @{
                    var absoluteUrl = Context.Request.Scheme + "://" + Context.Request.Host.Value + Url.Content($"~/content/img/{Context.Session.GetString("EmpresaFactura")}/logo.png");
                }
                <!-- Logo -->
                <td class="logo-cell">
                    <img src="@absoluteUrl" alt="Logo Empresa" />
                </td>

                <!-- Información del Emisor -->
                <td class="emisor-cell">
                    <div class="header-title">Acuse de Cancelación CFDI</div>
                    <div class="emisor-info">
                        <div><strong>RFC:</strong> @Model.RfcEmisor</div>
                        @if (!string.IsNullOrEmpty(Model.RfcReceptor))
                        {
                            <div><strong>RFC Receptor:</strong> @Model.RfcReceptor</div>
                        }
                        <div><strong>Motivo:</strong> @Model.Motivo</div>
                        @if (!string.IsNullOrEmpty(Model.FolioSustitucion))
                        {
                            <div><strong>Folio Sustitución:</strong> @Model.FolioSustitucion</div>
                        }
                    </div>
                </td>

                <!-- Datos del Acuse -->
                <td class="acuse-cell">
                    <div class="acuse-info">
                        <div><strong>Fecha:</strong> @Model.FechaCancelacion.ToString("dd/MM/yyyy HH:mm:ss")</div>
                        @if (!string.IsNullOrEmpty(Model.Estatus))
                        {
                            <div><strong>Estatus:</strong> <span class="estatus-badge">@Model.Estatus</span></div>
                        }
                    </div>
                    <div class="uuid-highlight">
                        <strong>Folio Fiscal:</strong> @Model.Uuid
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>