@{
    ViewBag.Title = "Resultado del escaneo";
    var movimientos = ViewBag.ResultadoQR as List<Dictionary<string, object>>;
}

<h2 class="mb-4">Resultado del escaneo de código QR</h2>

<p><strong>Lote operación:</strong> @ViewBag.LoteOperacion</p>

@if (movimientos != null && movimientos.Count > 0)
{
    <div class="table-responsive">
        <table class="table table-bordered table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Producto ID</th>
                    <th>Tipo Movimiento</th>
                    <th>Nombre Movimiento</th>
                    <th>Cantidad</th>
                    <th>Almacén ID</th>
                    <th>Fecha</th>
                    <th>Referencia Externa</th>
                    <th>Origen Proceso</th>
                    <th>Usuario ID</th>
                    <th>Observaciones</th>
                    <th>Responsiva ID</th>
                    <th>Stock</th>

                </tr>
            </thead>
            <tbody>
                @foreach (var item in movimientos)
                {
                    <tr>
                        <td>@item["id"]</td>
                        <td>@item["producto_id"]</td>
                        <td>@item["tipo_movimiento_id"]</td>
                        <td>@item["nombre"]</td>
                        <td>@item["cantidad"]</td>
                        <td>@item["almacen_id"]</td>
                        <td>@((item["fecha"] as DateTime?)?.ToString("yyyy-MM-dd HH:mm") ?? "")</td>
                        <td>@item["referencia_externa"]</td>
                        <td>@item["origen_proceso"]</td>
                        <td>@item["usuario_id"]</td>
                        <td>@item["observaciones"]</td>
                        <td>@item["responsiva_id"]</td>
                        <td>@item["stock_actual"]</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="alert alert-warning">No se encontraron resultados para el lote escaneado.</div>
}
