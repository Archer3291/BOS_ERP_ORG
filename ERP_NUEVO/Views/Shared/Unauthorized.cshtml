<!-- Views/Shared/Unauthorized.cshtml -->
@{
    ViewBag.Title = "Acceso No Autorizado";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5">
    <div class="alert alert-danger text-center">
        <h2><i class="fas fa-ban"></i> @ViewBag.Title</h2>
        <p class="mt-3">No tienes permisos para acceder a esta sección del sistema.</p>
        <a href="@Url.Action("Index", "Home")" class="btn btn-primary mt-3">
            <i class="fas fa-home"></i> Volver al Inicio
        </a>
    </div>
</div>