<link href="~/content/tablebuilder.css" rel="stylesheet" />

<div id="migrarInventario"></div>

<script src="~/scripts/tablebuilder.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function() {
        createTable({
            selector: "#migrarInventario",
            path: '/Solicitudes/GetProductos',
            columns: [
                { title: "Clave", data: "clave" },
                { title: "Descripcion", data: "descripcion" },
                { title: "Unidad", data: "unidad" },
                { title: "Unidad Secundaria", data: "unidad_sec" },
                { title: "Moneda Combra", data: "moneda_compra" },
                { title: "Valor Inventario", data: "valor_inventario" },
                { title: "Ultimo Costo", data: "ultimo_costo" }
            ],
        });
    });
</script>