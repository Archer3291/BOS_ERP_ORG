                                    <input type="radio" value="recepcionV" class="btn-check proceso" name="proceso" id="recepcion" autocomplete="off" required>
                                    <label for="recepcion" class="w-100 h-100 d-block">
                                        <div class="product-title">
                                            Recepcion de material nacional
                                        </div>
                                        <div class="product-description">
                                            Productos provenientes de proveedorres nacionales.
                                        </div>
                                        <div class="product-features">
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de inventario</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de entradas y salidas de material</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Seguimiento de stock</span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        }
                    }

                    @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "recepcion_devolucion"))
                        {
                            <div class="col-sm-12 col-md-6">
                                <!-- Recibir devolucion -->
                                <div class="product-card" data-option="devolucion">
                                    <div class="corner-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 24 24"><path d="m14.712 2.289l-.087-.078a1 1 0 0 0-1.327.078l-.078.087a1 1 0 0 0 .078 1.326l1.299 1.297H8.999l-.24.004A6.997 6.997 0 0 0 2 11.993a6.94 6.94 0 0 0 1.189 3.899a.999.999 0 0 0 1.626-1.163l-.135-.218A4.997 4.997 0 0 1 9 6.998h5.595l-1.297 1.297l-.078.087a.999.999 0 0 0 1.492 1.326l3.006-3.003l.077-.087a1 1 0 0 0-.078-1.326zm6.075 5.771A.999.999 0 0 0 19 8.677c0 .209.064.402.172.561a4.997 4.997 0 0 1-4.17 7.75H9.414l1.294-1.29l.083-.096a1 1 0 0 0-.006-1.23l-.077-.088l-.095-.084a1 1 0 0 0-1.232.006l-.088.078l-3.005 3.003l-.083.095a1 1 0 0 0 .006 1.231l.077.087l3.005 3.003l.095.084a1 1 0 0 0 1.397-1.41l-.077-.087l-1.304-1.303H15l.24-.003a6.997 6.997 0 0 0 5.546-10.927z" /></svg>
                                    </div>
                                    <input type="radio" value="devolucionV" class="btn-check proceso" name="proceso" id="devolucion" autocomplete="off" required>
                                    <label for="devolucion" class="w-100 h-100 d-block">
                                        <div class="product-title">Recepcion de devolucion de material</div>
                                        <div class="product-description">
                                            Recepcion de material devuelto por cliente
                                        </div>
                                        <div class="product-features">
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de inventario</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de entradas y salidas de material</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Seguimiento de stock</span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        }
                    }


                    @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "recepcion_internacional"))
                        {
                            <div class="col-sm-12 col-md-6">
                                <!-- Recibir internacional -->
                                <div class="product-card" data-option="internacional">
                                    <div class="corner-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 2048 2048"><path d="M496 883q13 0 29 4t32 11t32 13t29 12l-16 2q-8 1-17 1q-17 0-31-5t-26-13t-24-12t-22-6q-10 0-18 4t-16 9q0-4-7-4q7-7 26-11t29-5m135 45q41 0 75 14q-14 5-28 8t-29 4q-20 0-36-4q5-8 10-10t8-12M1024 0q141 0 271 37t244 103t208 161t160 207t104 244t37 272q0 141-37 271t-103 244t-161 208t-207 160t-244 104t-272 37q-141 0-271-37t-244-103t-208-161t-160-207t-104-244t-37-272q0-141 37-271t103-244t161-208t207-160T752 37t272-37m762 555q-14-22-28-42t-29-41q-2 9-5 13t-4 18q0 9 7 17t18 16t22 12t19 7m-69-98q0 8-3 11h6q4 0 6 1zm-693 1463q114 0 223-29t206-82t180-130t145-172q-13-30-25-61t-12-64q0-36 3-58t7-39t4-29t-3-31t-17-41t-37-62q1-7 3-19t4-25t1-24t-5-19q-26-3-54-11t-50-24l6-5q-13 3-26 8t-25 11t-26 8t-27 4l-16-2l3-7q-14 4-30 10t-31 6q-10 0-29-7t-38-17t-34-22t-15-23l2-3q-5-6-13-11t-15-10t-13-11t-5-14l11-9l-23-3l-8-30q2 5 9 4t11-4l-36-19l25-64q-14-52-7-80t27-46t44-36t49-49l-3-12l66-80l15-2q28 0 63-2t71-7t71-10t64-13q-32-38-67-72t-75-65q-11 4-27 11t-32 18t-25 24t-11 27l6 19q-18 29-40 36t-45 8t-48 0t-48 9l-16-34l15-58l-17-25l173-54q-11-28-36-42t-55-14v-10l56-9q-93-46-193-70t-205-24q-87 0-172 17t-164 49t-153 80t-135 108q26 0 40 13t26 29t25 29t35 14l16-12l-2-22l33-47l-26-74q5-3 15-10t17-7q30 0 46 3t28 11t21 23t28 38l36-28q10 4 32 13t45 22t39 27t17 26q0 15-11 24t-29 15t-37 9t-38 8t-29 10t-12 17l58 19q-20 17-43 31t-48 26l4 17l-92 36v28l-7 3l5-35l-4-1q-7 0-8 3t-1 7t2 8t1 6l-13-7l2 4q0 3 3 9t8 11t8 10t4 5q0 3-4 6t-10 4t-8 3t0 1q14 0 6 2t-25 10t-31 23t-16 44q0 17 1 33t-1 33q-14-38-42-58t-68-20l-43 4l21 14q-17-2-35-4t-37-1t-34 8t-30 21l-6 45q0 32 14 52t49 21q30 0 59-9t57-21q-9 22-20 42t-16 44l13 6q24-16 44-5t39 32t39 43t43 32l-34 18l-80-45q1 2 2 9t-1 3l-36-61q-32-1-68-10t-73-24t-69-33t-59-38l-7 107q0 122 33 238t93 218t147 186t193 143q-5-21-1-42t10-42t13-42t7-43q0-32-10-67t-24-71t-31-71t-27-66t-16-58t6-47l-15-7q6-14 16-27t21-26t17-28t7-30q0-10-4-21t-7-21l21 5q17-39 46-5