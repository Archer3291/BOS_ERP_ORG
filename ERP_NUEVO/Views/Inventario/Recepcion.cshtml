                                    </div>
                                    <input type="radio" value="internacionalV" class="btn-check proceso" name="proceso" id="internacional" autocomplete="off" required>
                                    <label for="internacional" class="w-100 h-100 d-block">
                                        <div class="product-title">Recepcion de material internacional</div>
                                        <div class="product-description">
                                            Productos provenientes de proveedores internacionales.
                                        </div>
                                        <div class="product-features">
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de inventario</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Etiquetado con norma NOM-050</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Seguimiento de stock</span>
                                            </div>
                                        </div>
                                    </label>
