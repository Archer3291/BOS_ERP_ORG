                    @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                        {
                            <div class="col-sm-12 col-md-6">
                                <!-- Recibir extraordinario -->
                                <div class="product-card" data-option="extraordinario">
                                    <div class="corner-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 48 48"><g fill="none"><path d="M14 4h20v20H14zM4 24h20v20H4zm20 0h20v20H24z" /><path stroke="#475569" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M24 24H4v20h20zm0 0v20zm0 0h20v20H24zM14 4h20v20H14zm10 6v8" /><path stroke="#475569" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="m20 14l4-4l4 4M10 34h8m-4 4l-4-4l4-4m24 4h-8m4-4l4 4l-4 4" /></g></svg>
                                    </div>
                                    <input type="radio" value="extraordinario" class="btn-check proceso" name="proceso" id="extraordinario" autocomplete="off" required>
                                    <label for="extraordinario" class="w-100 h-100 d-block">
                                        <div class="product-title">Ingreso de inventario extraordinario</div>
                                        <div class="product-description">
                                            Ingreso de material al invenrario temporal por medio de un excel para venta internacional
                                        </div>
                                        <div class="product-features">
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de inventario</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Etiquetado con norma NOM-050</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Seguimiento de stock</span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        }
                    }

                    @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_barras"))
                        {
                            <div class="col-sm-12 col-md-6">
                                <!-- Recibir barras -->
                                <div class="product-card" data-option="barras">
                                    <div class="corner-icon">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="30" height="30" viewBox="0 0 48 48"><g fill="none"><path d="M14 4h20v20H14zM4 24h20v20H4zm20 0h20v20H24z" /><path stroke="#475569" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="M24 24H4v20h20zm0 0v20zm0 0h20v20H24zM14 4h20v20H14zm10 6v8" /><path stroke="#475569" stroke-linecap="round" stroke-linejoin="round" stroke-width="4" d="m20 14l4-4l4 4M10 34h8m-4 4l-4-4l4-4m24 4h-8m4-4l4 4l-4 4" /></g></svg>
                                    </div>
                                    <input type="radio" value="barras" class="btn-check proceso" name="proceso" id="barras" autocomplete="off" required>
                                    <label for="barras" class="w-100 h-100 d-block">
                                        <div class="product-title">Ingreso de inventario barras</div>
                                        <div class="product-description">
                                            Ingreso de material al inventario de Tubo y Barra
                                        </div>
                                        <div class="product-features">
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Control de inventario</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Manejo de materiales</span>
                                            </div>
                                            <div class="feature-item">
                                                <i class="fas fa-check"></i>
                                                <span>Seguimiento de stock</span>
                                            </div>
                                        </div>
                                    </label>
                                </div>
                            </div>
                        }
                    }
                </fieldset>
            </form>
        </div>

            <div id="step-2" class="wizard-panel" role="tabpanel">
            <form id="form-2" novalidate>
                <!-- Recepcion nacional -->
                <div id="recepcion-contenedor" class="d-none">
                    @Html.Partial("partials/_RecepcionOrdenCompra")
                </div>

                <!-- Devolucion de material -->
                <div id="devolucion-contenedor" class="d-none">
                    @Html.Partial("partials/_RecepcionDevolucion")
                </div>

                <!-- Recepcion internacional -->
                <div id="recepcion-internacional" class="d-none">
                    @Html.Partial("partials/_RecepcionMaterialInternacional")
                </div>

                @{
                    if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                    {
                        <div id="inventario-extraordinario" class="d-none">
                            @Html.Partial("partials/_RecepcionInventarioExtraordinario")
                        </div>
                    }
                }
                
                @{
                    if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_barras"))
                    {
                        <div id="inventario-barras" class="d-none">
                            @Html.Partial("partials/_RecepcionInventarioBarras")
                        </div>
                    }
                }
            </form>
            </div>
        </div>
    </div>
</div>

<script src="~/scripts/WizardBuilder.js?v=@DateTime.Now.Ticks"></script>
<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
<script>
    const wizardRecepcion = createWizard({
        selector: '#rec-wizard-bar',
        panelsSelector: '#rec-wizard-panels',
        labels: { next: 'Siguiente', prev: 'Anterior' },
        steps: [
            {
                id: 1,
                label: 'Tipo de proceso',
                panel: '#step-1',
                formId: 'form-1',
                errorMessage: 'Debes seleccionar el tipo de recepcion.'
            },
            {
                id: 2,
                label: 'Motivo de devolucion / Recepcion',
                panel: '#step-2',
                formId: 'form-2'
            }
        ],
        onStepChange: () => window.scrollTo({ top: 0, behavior: 'smooth' })
    });

    window.wizardRecepcion = wizardRecepcion;

    document.querySelectorAll('input[name="proceso"]').forEach(radio => {
        radio.addEventListener('click', (e) => {
            // seleccionar el card
            document.querySelectorAll('.product-card').forEach(c => c.classList.remove('selected'));
            e.target.parentElement.classList.add('selected');

            // marcar el radio como checkeado
            e.target.checked = true

            @{
                if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_barras"))
                {
                    <text>
                            document.getElementById("inventario-barras").classList.add('d-none')
                    </text>
                }
            }

            // mostrar las parciales seleccionadas
            if (e.target.value === 'recepcionV') {
                document.getElementById("recepcion-contenedor").classList.remove('d-none')
                document.getElementById("devolucion-contenedor").classList.add('d-none')
                document.getElementById("recepcion-internacional").classList.add('d-none')

                @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                        {
                            <text>
                                    document.getElementById("inventario-extraordinario").classList.add('d-none')
                            </text>
                    }
                    }

                } else if (e.target.value === 'devolucionV') {
                document.getElementById("recepcion-contenedor").classList.add('d-none')
                document.getElementById("devolucion-contenedor").classList.remove('d-none')
                document.getElementById("recepcion-internacional").classList.add('d-none')

                @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                        {
                            <text>
                                    document.getElementById("inventario-extraordinario").classList.add('d-none')
                            </text>
                    }
                    }
                } else if (e.target.value === 'internacionalV') {
                document.getElementById("recepcion-contenedor").classList.add('d-none')
                document.getElementById("devolucion-contenedor").classList.add('d-none')
                document.getElementById("recepcion-internacional").classList.remove('d-none')

                @{
                        if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                        {
                            <text>
                                    document.getElementById("inventario-extraordinario").classList.add('d-none')
                            </text>
                    }
                    }
                }
            @{
                    if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                    {
                        <text>
                                else if (e.target.value === 'extraordinario') {
                                    document.getElementById("recepcion-contenedor").classList.add('d-none')
                                            document.getElementById("devolucion-contenedor").classList.add('d-none')
                                document.getElementById("recepcion-internacional").classList.add('d-none')
                                document.getElementById("inventario-extraordinario").classList.remove('d-none')
                                        }
                        </text>
                }
                }
            @{
                    if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_barras"))
                    {
                        <text>
                                else if (e.target.value === 'barras') {
                                    document.getElementById("recepcion-contenedor").classList.add('d-none')
                                document.getElementById("devolucion-contenedor").classList.add('d-none')
                                document.getElementById("recepcion-internacional").classList.add('d-none')
                                document.getElementById("inventario-barras").classList.remove('d-none')
                        </text>

                    if (Utilities.DoesUserHasRight(User.Identity.Name, "inventario_extraordinario"))
                    {
                        <text>
                                document.getElementById("inventario-extraordinario").classList.add('d-none')
                        </text>
                    }

                        <text>
                                        }
                        </text>
                }
                }
            })
    })
</script>