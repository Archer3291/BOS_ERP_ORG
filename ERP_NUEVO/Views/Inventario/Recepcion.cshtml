                <div class="form-header">
                    <h4>Selecciona el tipo de proceso que se va a registrar</h4>
                    <p>Elige la opción que mejor describa el propósito de tu recepcion</p>
                </div>

                <!-- Product Options -->
                <fieldset class="row g-3" aria-required="true">
