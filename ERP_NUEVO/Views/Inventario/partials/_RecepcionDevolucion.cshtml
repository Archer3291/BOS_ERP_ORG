<style>
    .pagination-btn {
        background-color: var(--bg-light);
        border: 1.5px solid var(--border-light);
        color: var(--text-dark);
        padding: 8px 12px;
        margin: 0 2px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 14px;
        transition: all 0.2s ease;
        cursor: pointer;
        min-width: 38px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .pagination-btn:hover {
            background-color: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
            transform: translateY(-1px);
        }

        .pagination-btn.active {
            background-color: var(--primary-blue);
            color: white;
            border-color: var(--primary-blue);
            box-shadow: 0 2px 4px rgba(30, 58, 95, 0.3);
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none !important;
        }

            .pagination-btn:disabled:hover {
                background-color: var(--bg-light);
                color: var(--text-dark);
                border-color: var(--border-light);
            }

    .pagination-dots {
        color: var(--text-light);
        margin: 0 8px;
        font-weight: bold;
        display: inline-flex;
        align-items: center;
    }

    .pagination-info {
        color: var(--text-light);
        font-size: 14px;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .page-size-selector {
        border: 1px solid var(--border-light);
        border-radius: 6px;
        padding: 5px 8px;
        background-color: var(--bg-light);
        color: var(--text-dark);
        font-size: 14px;
    }

    .loading-spinner {
        display: none;
        color: var(--primary-blue);
    }
</style>


