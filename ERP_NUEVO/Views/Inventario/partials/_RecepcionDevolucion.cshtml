<script>
    let unidadesList = [];
    async function cargarUnidades() {
        const prov = await fetch('/Inventario/GetListaUnidades');
        unidadesList = await prov.json();
    }

    cargarUnidades();
    function agregarFila(datosProducto = null) {
        document.querySelector('.tab-content').style.removeProperty('height')
        const tbody = document.querySelector("#tabla-materiales tbody");
        const fila = document.createElement("tr");

        const c1 = datosProducto?.cve_prod || '';
        const c2 = datosProducto?.descr_prod || '';
        const c11 = datosProducto?.udm || '';

        let html =
            `<td class="text-center"><input type="checkbox" class="seleccionar-fila" /></td>` +
            `<td></td>` +
            `<td contenteditable="true" class="input-cantidad"></td>` +
            `<td contenteditable="true" class="input-codigo">${c1}</td>` +
            `<td contenteditable="true" class="input-descripcion">${c2}</td>` +
            `<td contenteditable="true" class="input-id d-none">${datosProducto.id_catproductos}</td>`;

        fila.innerHTML = html;

        const td = document.createElement('td');
        td.classList.add('unidad');
        const select = document.createElement('select');
        select.classList.add('unidadId');
        select.setAttribute('autocomplete', 'off');
        td.appendChild(select);
        fila.appendChild(td);

        if (unidadesList.length === 0) {
            cargarUnidades().then(() => {
                inicializarTomSelectUnidad(select);
            });
        } else {
            inicializarTomSelectUnidad(select);
        }

        tbody.appendChild(fila);
    }

    let ts;
    function inicializarTomSelectUnidad(select, valor = null) {
        ts = new TomSelect(select, {
            persist: false,
            createOnBlur: true,
            create: true,
            options: unidadesList,
            valueField: "id_udm",
            labelField: "descripcion",
            searchField: ["cve_udm", "descripcion"],
            render: {
                option: function (data, escape) {
                    return `<div style="color: var(--text-dark)">${escape(data.descripcion)}</div>`;
                },
                item: function (data, escape) {
                    return `<div style="color: var(--text-dark)">${escape(data.descripcion)}</div>`;
                }
            }
        });

        if (valor) ts.setValue(valor);
    }

    function eliminarFilasSeleccionadas() {
        const checkboxes = document.querySelectorAll(".seleccionar-fila:checked");
        checkboxes.forEach(chk => {
            chk.closest("tr").remove();
        });
    }

    const limpiarNumero = (str) => str.replace(/[^\d.]/g, '');

    // Función para buscar productos con paginación
    let pageSize = 50; // Número de productos por página
    let totalProducts = 0; // <-- usar let en lugar de const
    let currentPage = 1

    document.getElementById('pageSizeSelector').addEventListener('change', () => buscarProductos("", currentPage));

    function buscarProductos(nombre, currentPage = 1) {
        pageSize = parseInt(document.getElementById('pageSizeSelector').value);
        fetch(`/Almacen/Producto/Buscar?nombre=${encodeURIComponent(nombre)}&page=${currentPage}&pageSize=${pageSize}`)
            .then(res => res.json())
            .then(response => {
                const lista = document.getElementById('listaResultados');
                lista.innerHTML = ''; // Limpiar resultados anteriores
                updateRecordInfo(currentPage)

                // ⚠️ Ajusta aquí según cómo devuelva tu backend
                // Si regresa { data, total }:
                const data = response.data || response;
                totalProducts = response.total ?? data.length;

                if (data.length === 0) {
                    lista.innerHTML = '<div class="p-3">No se encontraron productos.</div>';
                    return;
                }

                // Crear tabla
                const tabla = document.createElement('table');
                tabla.classList.add('table', 'table-hover', 'table-bordered');

                tabla.innerHTML = `
         <thead class="table-secondary">
             <tr>
                 <th style="width: 30%;">Clave</th>
                 <th>Descripción</th>
             </tr>
         </thead>
         <tbody></tbody>
     `;

                const tbody = tabla.querySelector('tbody');

                data.forEach(producto => {
                    const fila = document.createElement('tr');
                    fila.style.cursor = 'pointer';
                    fila.innerHTML = `
             <td>${producto.id}</td>
             <td>${producto.descripcion}</td>
         `;

                    fila.addEventListener('click', () => {
                        fetch(`/Almacen/Producto/BuscarProducto?idproducto=${producto.id}`)
                            .then(res => res.json())
                            .then(detalle => {
                                const productId = detalle[0]?.cve_prod;
                                const table = document.querySelectorAll("#tabla-materiales tbody tr");
                                const ifExist = Array.from(table).some(fila => fila.cells[3]?.innerText.trim() === productId);

                                if (ifExist) {
                                    toastMixin.fire({
                                        icon: 'warning',
                                        title: 'Este producto ya ha sido agregado.'
                                    });
                                    return;
                                }

                                $('#modalBuscarProducto').modal('hide')
                                agregarFila(detalle[0]);
                            });
                    });

                    tbody.appendChild(fila);
                });

                lista.appendChild(tabla);

                // Actualizar la paginación con el total real
                actualizarPaginacion(currentPage, data.length);

                lista.scrollTop = 0;
            })
            .catch(err => {
                console.error('Error al buscar: ', err);
            });
    }
    let folioRep

    // Función para actualizar los controles de paginación
    function actualizarPaginacion(currentPage, currentPageResults) {
        const totalPages = Math.ceil(totalProducts / pageSize); // totalProducts debe estar definido globalmente
        const pagination = document.getElementById('paginationControls');

        if (totalPages <= 1) {
            pagination.innerHTML = '';
            return;
        }

        let html = '';

        // Botón Primera página
        html += `<button class="pagination-btn ${currentPage === 1 ? 'disabled' : ''}"
             onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, 1)"
             ${currentPage === 1 ? 'disabled' : ''} title="Primera página">
             <i class="fas fa-angle-double-left"></i>
      </button>`;

        // Botón Anterior
        html += `<button class="pagination-btn ${currentPage === 1 ? 'disabled' : ''}"
             onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, ${currentPage - 1})"
             ${currentPage === 1 ? 'disabled' : ''} title="Página anterior">
             <i class="fas fa-angle-left"></i>
      </button>`;

        // Calcular rango de páginas visibles
        let start = Math.max(1, currentPage - 2);
        let end = Math.min(totalPages, currentPage + 2);

        if (end - start < 4) {
            if (start === 1) {
                end = Math.min(totalPages, start + 4);
            } else {
                start = Math.max(1, end - 4);
            }
        }

        // Primera página y puntos suspensivos si aplica
        if (start > 1) {
            html += `<button class="pagination-btn"
                 onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, 1)">1</button>`;
            if (start > 2) {
                html += `<span class="pagination-dots">...</span>`;
            }
        }

        // Páginas del rango actual
        for (let i = start; i <= end; i++) {
            html += `<button class="pagination-btn ${i === currentPage ? 'active' : ''}"
                 onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, ${i})">${i}</button>`;
        }

        // Última página y puntos suspensivos si aplica
        if (end < totalPages) {
            if (end < totalPages - 1) {
                html += `<span class="pagination-dots">...</span>`;
            }
            html += `<button class="pagination-btn"
                 onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, ${totalPages})">${totalPages}</button>`;
        }

        // Botón Siguiente
        html += `<button class="pagination-btn ${currentPage === totalPages ? 'disabled' : ''}"
             onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, ${currentPage + 1})"
             ${currentPage === totalPages ? 'disabled' : ''} title="Página siguiente">
             <i class="fas fa-angle-right"></i>
      </button>`;

        // Botón Última página
        html += `<button class="pagination-btn ${currentPage === totalPages ? 'disabled' : ''}"
             onclick="buscarProductos(document.getElementById('inputBuscarNombre').value, ${totalPages})"
             ${currentPage === totalPages ? 'disabled' : ''} title="Última página">
             <i class="fas fa-angle-double-right"></i>
      </button>`;

        pagination.innerHTML = html;
        updateRecordInfo(currentPage)
    }

    function updateRecordInfo(currentPage) {
        const from = (currentPage - 1) * pageSize + 1;
        const to = Math.min(currentPage * pageSize, totalProducts);

        document.getElementById('recordsFrom').textContent = from;
        document.getElementById('recordsTo').textContent = to;
        document.getElementById('totalRecords').textContent = totalProducts;
    }

    // Inicializar la búsqueda cuando se abre el modal
    document.getElementById('modalBuscarProducto').addEventListener('shown.bs.modal', () => {
        buscarProductos(''); // Realiza una búsqueda sin filtro (muestra todos los productos)
    });

    // Llamada para buscar productos cuando se escribe en el input
    document.getElementById('inputBuscarNombre').addEventListener('input', () => {
        buscarProductos(document.getElementById('inputBuscarNombre').value);
    });

    // Buscar automáticamente al abrir el modal
    const modalBuscarProducto = document.getElementById('modalBuscarProducto');

    modalBuscarProducto.addEventListener('shown.bs.modal', () => {
        const nombre = inputBuscarNombre.value.trim();
        buscarProductos(nombre);
    });


    document.getElementById('btnLimpiarResultados').addEventListener('click', () => {
        //document.getElementById('listaResultados').innerHTML = '';
        buscarProductos('');
        document.getElementById('inputBuscarNombre').value = '';
    });

    document.getElementById('btnLimpiarResultados').addEventListener('click', () => {
        //document.getElementById('listaResultados').innerHTML = '';
        buscarProductos('');
        document.getElementById('inputBuscarNombre').value = '';
        document.getElementById('inputBuscarNombre').focus();
    });

    const _registrarEntradaOriginal = registrarEntrada;

    // Validar datos de la tabla
    function registrarEntrada() {
        const filasMateriales = [];

        let errorFila = false;

        document.querySelectorAll("#tabla-materiales tbody tr").forEach((fila) => {
            const cantidad = parseInt(limpiarNumero(fila.cells[2].innerText.trim()));
            const codigo = fila.cells[3].innerText.trim();
            const descripcion = fila.cells[4].innerText.trim();
            const id_producto = parseInt(fila.cells[5].innerText.trim());

            const unidad = ts.getValue();

            let filaValida = cantidad !== "" && cantidad !== "0" && codigo !== "" && descripcion !== "" && unidad !== '';

            if (filaValida) {
                const fila = {
                    id_producto,
                    codigo,
                    descripcion,
                    cantidad,
                    unidad,
                };

                filasMateriales.push(fila);
            } else {
                errorFila = true;
            }
        });

        if (filasMateriales.length === 0 || errorFila) {
            toastMixin.fire({
                icon: 'error',
                title: 'Hay filas incompletas o vacías. Revisa que todos los campos obligatorios estén llenos.'
            });
            return false;
        }

        const motivo = document.getElementById('motivoDevolucion').value;
        const factura = document.getElementById('facturaDevolucion').value.trim();
        const observaciones = document.getElementById('observaciones').value.trim();

        if (motivo == "0") {
            toastMixin.fire({
                icon: 'error',
                title: 'El motivo de devolucion es obligatorio, por favor ingresalo.'
            });
            return false;
        }

        if (factura == "") {
            toastMixin.fire({
                icon: 'error',
                title: 'La factura de referencia es obligatoria, por favor ingresala.'
            });
            return false;
        }

        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
                <style>
                    .flip {
                        animation: spinY 2s linear infinite;
                        transform-origin: center;
                    }
                    @@keyframes spinY {
                        0%   { transform: rotateY(0deg); }
                        100% { transform: rotateY(360deg); }
                    }
                </style>
                <g class="flip">
                    <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                    <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                    <circle cx="32" cy="48" r="3" fill="#000"/>
                </g>
            </svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: "Confirmar recepción",
            html: `¿Esta seguro que quiere registrar estos productos como devolucion?`,
            footer: "<b style='color: red;'>ADVERTENCIA - Este cambio no se puede revertir</b>",
            customClass: {
                icon: "p-0 bg-transparent border-0 shadow-none"
            },
            preConfirm: () => {
                GetData({
                    path: "/Inventario/RecibirDevolucion",
                    data: {
                        productos: JSON.stringify(filasMateriales),
                        motivo: motivo,
                        factura: factura,
                        observaciones: observaciones,
                        reporteId: folioRep,
                    },
                    swalType: 'modal',
                    swalResponse: true,
                    swalPath: "/Inventario/Recepcion"
                })
            }
        })

        return true;
    }
    // ── Inicializar al cargar la página ───────────────────────────
    document.addEventListener('DOMContentLoaded', () => {
        cargarReportesRmd();
    });
    // ══════════════════════════════════════════════════════════════
    //  MÓDULO RMD — Reportes de devolución pendientes en inventario
    // ══════════════════════════════════════════════════════════════

    let rmdReporteActual = null;   // reporte seleccionado actualmente

    const URGENCIA_BADGE = {
        critica: '<span class="badge bg-danger">Crítica</span>',
        alta: '<span class="badge bg-warning text-dark">Alta</span>',
        normal: '<span class="badge bg-secondary">Normal</span>',
    };

    const TIPO_DANIO_LABEL = {
        fisico: 'Daño físico',
        incompleto: 'Incompleto',
        caducado: 'Caducado',
        calidad: 'Calidad',
        mojado: 'Humedad',
        otro: 'Otro',
    };

    // Carga y renderiza los reportes RMD pendientes
    async function cargarReportesRmd() {
        try {
            const res = await fetch('/Inventario/GetReportesDevolucionPendientes');
            const data = await res.json();

            const panel = document.getElementById('panel-reportes-rmd');
            const tbody = document.getElementById('tbody-reportes-rmd');
            const badge = document.getElementById('rmd-count-badge');

            if (!data || data.length === 0) {
                panel.style.display = 'none';
                return;
            }

            panel.style.display = 'block';
            badge.textContent = data.length;

            tbody.innerHTML = data.map((r, i) => `
            <tr id="rmd-tr-${r.id}">
                <td class="font-monospace" style="font-size:12px;">${r.id}</td>
                <td style="font-size:12px;">${dateFormatter(r.fecha_reporte)}</td>
                <td style="font-size:12px;">${escHtml(r.nombre_vendedor || '—')}</td>
                <td style="font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                    title="${escHtml(r.folios_txt)}">${escHtml(r.folios_txt || '—')}</td>
                <td style="font-size:12px;">${escHtml(TIPO_DANIO_LABEL[r.tipo_danio] || r.tipo_danio)}</td>
                <td>${URGENCIA_BADGE[r.urgencia] || URGENCIA_BADGE.normal}</td>
                <td class="text-center">${r.total_partidas || 0}</td>
 <td>
            <button type="button" class="btn btn-sm btn-outline-primary"
                    onclick="event.preventDefault(); event.stopPropagation(); cargarPartidasDeReporte(${r.id})"
                    title="Cargar partidas en la tabla">
                <i class="fas fa-file-import me-1"></i>Cargar
            </button>
            <button type="button" class="btn btn-sm btn-outline-info ms-1"
                    onclick="event.preventDefault(); event.stopPropagation(); verDetalleReporte(${r.id})"
                    title="Ver descripción completa">
                <i class="fas fa-eye"></i>
            </button>
        </td>
    </tr>`).join('');

        } catch (e) {
            console.error('Error cargando reportes RMD:', e);
        }
    }

    // Carga las partidas del reporte en la tabla de inventario
    async function cargarPartidasDeReporte(reporteId) {
        try {
            const res = await fetch(`/Inventario/GetPartidasReporte?reporteId=${reporteId}`);
            const partidas = await res.json();

            if (!partidas || partidas.length === 0) {
                toastMixin.fire({ icon: 'warning', title: 'Este reporte no tiene partidas registradas.' });
                return;
            }

            // Limpiar tabla actual
            document.querySelector('#tabla-materiales tbody').innerHTML = '';
            rmdReporteActual = reporteId;

            folioRep = reporteId
            // Resaltar fila seleccionada
            document.querySelectorAll('#tbody-reportes-rmd tr').forEach(tr =>
                tr.classList.remove('table-primary'));
            const trSel = document.getElementById(`rmd-tr-${reporteId}`);
            if (trSel) trSel.classList.add('table-primary');

            // Llenar tabla con partidas del reporte
            for (const p of partidas) {
                // Construimos un objeto compatible con agregarFila
                const datoProducto = {
                    cve_prod: p.codigo,
                    descr_prod: p.descripcion,
                    udm: p.desc_unidad || p.cve_udm || '',
                    id_catproductos: p.id_catproductos || 0,
                    cantidadRmd: p.cantidad,   // cantidad dañada reportada
                    unidadId: p.unidad,     // id_udm para el TomSelect
                };
                agregarFilaRmd(datoProducto);
            }

            // Preseleccionar motivo si corresponde
            const reporte = await fetch(`/Inventario/GetReportesDevolucionPendientes`)
                .then(r => r.json())
                .then(arr => arr.find(x => x.id === reporteId));

            if (reporte) {
                const motivoMap = {
                    fisico: 'daño',
                    incompleto: 'incompleto',
                    caducado: 'daño',
                    calidad: 'daño',
                    mojado: 'daño',
                    otro: 'diferente',
                };
                const sel = document.getElementById('motivoDevolucion');
                if (sel) sel.value = motivoMap[reporte.tipo_danio] || '0';

                const obs = document.getElementById('observaciones');
                if (obs) obs.value = reporte.descripcion || '';

                const fac = document.getElementById('facturaDevolucion');
                if (fac) fac.value = reporte.folios_txt || '';
            }

            toastMixin.fire({
                icon: 'success',
                title: `${partidas.length} partida(s) cargadas desde el reporte #${reporteId}`,
            });
        } catch (e) {
            console.error('Error cargando partidas del reporte:', e);
            toastMixin.fire({ icon: 'error', title: 'Error al cargar las partidas del reporte.' });
        }
    }

    // Agrega una fila prerellenada con cantidad editable
    function agregarFilaRmd(datoProducto) {
        document.querySelector('.tab-content').style.removeProperty('height');
        const tbody = document.querySelector('#tabla-materiales tbody');
        const fila = document.createElement('tr');

        const html =
            `<td class="text-center"><input type="checkbox" class="seleccionar-fila" /></td>` +
            `<td></td>` +
            `<td contenteditable="true" class="input-cantidad">${datoProducto.cantidadRmd || ''}</td>` +
            `<td contenteditable="true" class="input-codigo">${datoProducto.cve_prod || ''}</td>` +
            `<td contenteditable="true" class="input-descripcion">${datoProducto.descr_prod || ''}</td>` +
            `<td contenteditable="true" class="input-id d-none">${datoProducto.id_catproductos || 0}</td>`;

        fila.innerHTML = html;

        const td = document.createElement('td');
        td.classList.add('unidad');
        const select = document.createElement('select');
        select.classList.add('unidadId');
        select.setAttribute('autocomplete', 'off');
        td.appendChild(select);
        fila.appendChild(td);

        tbody.appendChild(fila);

        // Inicializar TomSelect con valor preseleccionado
        if (unidadesList.length === 0) {
            cargarUnidades().then(() => {
                inicializarTomSelectUnidad(select, datoProducto.unidadId);
            });
        } else {
            inicializarTomSelectUnidad(select, datoProducto.unidadId);
        }
    }

    // Utilidades
    function escHtml(str) {
        const d = document.createElement('div');
        d.textContent = String(str ?? '');
        return d.innerHTML;
    }

    function verDetalleReporte(reporteId) {
        // Reutiliza el sistema de modal/toast existente — muestra descripción
        fetch('/Inventario/GetReportesDevolucionPendientes')
            .then(r => r.json())
            .then(arr => {
                const r = arr.find(x => x.id === reporteId);
                if (!r) return;
                toastMixin.fire({
                    icon: 'info',
                    title: `Reporte #${r.id} — ${TIPO_DANIO_LABEL[r.tipo_danio] || r.tipo_danio}`,
                    html: `<b>Urgencia:</b> ${r.urgencia}<br>
                        <b>Folios:</b> ${escHtml(r.folios_txt)}<br>
                        <b>Descripción:</b> ${escHtml(r.descripcion)}<br>
                        <b>Ubicación:</b> ${escHtml(r.ubicacion_material || '—')}<br>
                        <b>Referencia:</b> ${escHtml(r.referencia || '—')}`,
                    timer: 0,
                    showConfirmButton: true,
                });
            });
    }

</script>