    function editarDescripcion(product, div) {
        _Swal.fire({
            title: "Editar descripción",
            input: "text",
            inputValue: product.descripcion,
            showCancelButton: true,
            confirmButtonText: "Guardar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed && result.value && result.value) {
                const newDesc = result.value.trim();
                document.getElementById(`descripcion_${product.id_partidas}`).innerText = newDesc;

                // Comparar con original
                const originalDescEl = document.getElementById(`originalDesc_${product.id_partidas}`);
                if (newDesc !== product.descripcion) {
                    originalDescEl.classList.remove("d-none");
                    div.querySelector(`#descripcion_${product.id_partidas}`).classList.add("text-warning", "fw-bold");
                } else {
                    originalDescEl.classList.add("d-none");
                    div.querySelector(`#descripcion_${product.id_partidas}`).classList.remove("text-warning", "fw-bold");
                }

                productStates[product.id_partidas].descripcion = result.value;
            }
        });
    }

    function editarCantidad(product, div) {
        _Swal.fire({
            title: "Editar cantidad",
            input: "number",
            inputValue: product.cantidad,
            inputAttributes: {
                step: "any",
                min: 0
            },
            showCancelButton: true,
            confirmButtonText: "Guardar",
            cancelButtonText: "Cancelar"
        }).then((result) => {
            if (result.isConfirmed && result.value && result.value) {
                const newQty = result.value;
                document.getElementById(`cantidad_${product.id_partidas}`).innerText = `Cant: ${newQty} ${product.ud}`;

                // Comparar con original
                const originalQtyEl = document.getElementById(`originalQty_${product.id_partidas}`);
                if (newQty != product.cantidad) {
                    originalQtyEl.classList.remove("d-none");
                    document.getElementById(`cantidad_${product.id_partidas}`).classList.add("bg-warning", "text-dark");
                } else {
                    originalQtyEl.classList.add("d-none");
                    document.getElementById(`cantidad_${product.id_partidas}`).classList.remove("bg-warning", "text-dark");
                }

                productStates[product.id_partidas].cantidad = parseInt(result.value);
            }
        });
    }

    // Guardar cambios
    document.addEventListener("DOMContentLoaded", () => {
        document.getElementById("searchBtn").addEventListener("click", () => {
            const selectedDoc = tomS.getValue();
            if (selectedDoc !== "0") {
                loadDocument(selectedDoc);
            } else {
                toastMixin.fire({ title: "Por favor selecciona un documento", icon: "warning" });
            }
        });

        document.getElementById("saveChangesBtn").addEventListener("click", () => {
            const selectedDoc = tomS.getValue();
            if (selectedDoc === "0") {
                toastMixin.fire({ title: "Por favor selecciona un documento", icon: "warning" });
                return;
            }

            let payload = [];
            for (const [productId, state] of Object.entries(productStates)) {
                const partidas = documentsData.partidas.find(p => p.id_partidas == productId);

                let proveedor = partidas.proveedorid || null;

                if (state.hasError == false && state.checked == false) {
                    toastMixin.fire({ title: `No puedes dejar productos sin seleccionar`, icon: 'error' });
                    throw Error('No puedes dejar productos sin seleccionar');
                    return;
                }

                if (state.checked && state.destino == null) {
                    toastMixin.fire({ title: `Debes seleccionar un destino para el producto ${state.descripcion}`, icon: 'error' });
                    throw Error('Debes seleccionar un destino para el producto');
                    return;
                }

                payload.push({
                    productId,
                    status: !state.hasError && state.checked,
                    cantidad: state.cantidad,
                    cantidad_original: partidas.cantidad,
                    destino: state.destino,
                    id_producto: state.id_producto,
                    unidad: state.unidad,
                    motivo: null,
                    cve_unidad: partidas.ud,
                    encabezado: documentsData.ordenCompra.id_encabezado,
                    encabezado_padre: documentsData.variacionPadre?.id_encabezado ?? documentsData.ordenCompra?.id_encabezado,
                    proveedor: proveedor,
                    proveedor_nombre: partidas.proveedor,
                    codigo: partidas.codigo,
                    descripcion: state.descripcion,
                    idp: partidas.idp,
                    f_pago: partidas.f_pago_id,
                });
            }

            _Swal.fire({
                title: "Confirmar recepción",
                html: `¿Está seguro que desea proceder con la recepción del material con el folio ${documentsData.ordenCompra.folio}?`,
                input: "textarea",
                inputLabel: "Comentarios extra",
                inputPlaceholder: "Comentarios extra...",
                preConfirm: (comentario) => {
                    GetData({
                        path: "/Inventario/ProcesarCuarentena",
                        data: {
                            productos: JSON.stringify(payload),
                            comentario: comentario,
                            encabezado: documentsData.ordenCompra.id_encabezado,
                        },
                    }).then((_res) => {
                        if (_res.icon === 'success') {
                            _SwalReload(_res)
                        } else {
                            _Swal.fire({
                                icon: 'error',
                                title: _res.title,
                                html: `
                                <p>Los siguientes productos no tienen suficiente stock:</p>
                                <table border="1" class="table table-hover" style="width:100%; text-align:left;">
                                    <thead>
                                        <tr>
                                            <th>Producto</th>
                                            <th>Cantidad solicitada</th>
                                            <th>Stock disponible</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${_res.productos.map(p => `
                                            <tr>
                                                <td>${p.descripcion}</td>
                                                <td>${p.cantidad}</td>
                                                <td>${p.stockDisponible}</td>
                                            </tr>
                                        `).join('')}
                                    </tbody>
                                </table>`
                            })
                        }
                    })
                }
            })
        });

        tomS.on("change", (value) => {
            if (value) loadDocument(value);
        });

        document.getElementById('generearEtiquetas').addEventListener('click', () => {
            generarEtiquetas(documentsData.partidas, documentsData.ordenCompra)
        })
    });
</script>
