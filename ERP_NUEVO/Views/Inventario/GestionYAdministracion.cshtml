@{
    ViewBag.Title = "Gestión y administración del inventario";
}

@section styles {
    <link href="~/content/compras-nacionales.css" rel="stylesheet" />
    <link href="~/content/Inventario/estructura-inventario.css" rel="stylesheet" />
}

@*
    Explorador de la estructura del inventario.

    Toda la pantalla la construye estructura-inventario.js a partir del árbol
    que devuelve /AdministracionInventario/Arbol; aquí solo van los contenedores
    fijos (árbol, panel, drawer y generador) para que el JS no tenga que
    inventarse el armazón en cada carga.
*@

<div class="ei-app">

    <!-- ------------------------------------------------------------ barra -->
    <div class="ei-topbar">
        <h1 class="ei-topbar__titulo">
            <i class="fas fa-sitemap"></i> Estructura del inventario
        </h1>
        <span id="ei-resumen" class="ei-ficha__meta"></span>

        <span class="ei-topbar__sep"></span>

        <div class="ei-buscador">
            <i class="fas fa-magnifying-glass"></i>
            <input type="search" id="ei-buscar" placeholder="Buscar sucursal, rack, ULocation…"
                   autocomplete="off" aria-label="Buscar en la estructura">
        </div>

        <button type="button" class="ei-btn" id="ei-colapsar" title="Expandir o colapsar todo el árbol">
            <i class="fas fa-list-tree"></i> Expandir
        </button>

        <button type="button" class="ei-btn ei-btn--icono" id="ei-recargar" title="Recargar la estructura">
            <i class="fas fa-rotate"></i>
        </button>

        <button type="button" class="ei-btn ei-btn--primario" id="ei-nueva-sucursal">
            <i class="fas fa-plus"></i> Nueva sucursal
        </button>
    </div>

    <!-- ------------------------------------------------------------ árbol -->
    <aside class="ei-arbol">
        <div class="ei-arbol__cabecera">
            <span>Jerarquía</span>
            <i class="fas fa-code-branch"></i>
        </div>
        <div class="ei-arbol__lista" id="ei-arbol-lista" role="tree" aria-label="Estructura del inventario"></div>
    </aside>

    <!-- ------------------------------------------------------------ panel -->
    <section class="ei-panel" id="ei-panel" aria-live="polite"></section>
</div>

<!-- ------------------------------------------------- drawer de alta/edición -->
<div class="ei-drawer-fondo" id="ei-drawer-fondo"></div>

<aside class="ei-drawer" id="ei-drawer" role="dialog" aria-modal="true" aria-labelledby="ei-drawer-titulo">
    <header class="ei-drawer__cabecera">
        <h2 class="ei-drawer__titulo" id="ei-drawer-titulo">Nuevo registro</h2>
        <button type="button" class="ei-drawer__cerrar" id="ei-drawer-cerrar" aria-label="Cerrar">
            <i class="fas fa-xmark"></i>
        </button>
    </header>

    <div class="ei-drawer__cuerpo" id="ei-drawer-cuerpo"></div>

    <footer class="ei-drawer__pie">
        <button type="button" class="ei-btn" id="ei-drawer-cancelar">
            <i class="fas fa-xmark"></i> Cancelar
        </button>
        <button type="button" class="ei-btn ei-btn--primario" id="ei-drawer-guardar">
            <i class="fas fa-floppy-disk"></i> Guardar
        </button>
    </footer>
</aside>

<!-- --------------------------------------------- generador de estructura -->
<div class="ei-modal-fondo" id="ei-gen-fondo">
    <div class="ei-modal" role="dialog" aria-modal="true" aria-labelledby="ei-gen-titulo">
        <header class="ei-modal__cabecera">
            <i class="fas fa-bolt fa-lg"></i>
            <h2 class="ei-modal__titulo" id="ei-gen-titulo">Generar estructura</h2>
            <button type="button" class="ei-drawer__cerrar" id="ei-gen-cerrar" aria-label="Cerrar">
                <i class="fas fa-xmark"></i>
            </button>
        </header>

        <div class="ei-modal__cuerpo">
            <div class="ei-modal__form" id="ei-gen-form"></div>

            <div class="ei-modal__previa">
                <div class="ei-previa__cabecera">
                    <i class="fas fa-eye"></i> Se creará exactamente esto
                </div>
                <div id="ei-gen-previa" style="flex:1;overflow-y:auto;"></div>
            </div>
        </div>

        <footer class="ei-modal__pie">
            <span class="ei-ficha__meta">
                <i class="fas fa-circle-info"></i>
                Las ULocation las calcula el servidor: lo que ves es lo que se guarda.
            </span>
            <span class="ei-topbar__sep"></span>
            <button type="button" class="ei-btn" id="ei-gen-cancelar">
                <i class="fas fa-xmark"></i> Cancelar
            </button>
            <button type="button" class="ei-btn ei-btn--primario" id="ei-gen-crear">
                <i class="fas fa-bolt"></i> Crear estructura
            </button>
        </footer>
    </div>
</div>

@section Scripts {
    <script src="~/scripts/Inventario/Administracion/estructura-inventario.js" defer></script>
}
