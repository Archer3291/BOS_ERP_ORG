@{
    ViewBag.Title = "GestionSolicitudes";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Gestionar solicitudes";
}

<div class="contenedor-tabla">
    <div class="card-body">
        <!-- Lista de productos seleccionados -->
        <div class="table-responsive">
            <table class="table modern-table table-hover" id="solicitudes">
                <thead class="table-light">
                    <tr>
                        <th>Folio</th>
                        <th>Fecha</th>
                        <th>Solicitante</th>
                        <th>Observaciones</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody id="selectedProductsBody"></tbody>
            </table>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        actualizarTabla();
    })

    function actualizarTabla() {
        cargarTabla("#solicitudes", "/Inventario/GetSolicitudesTraslado");
    }

    function cargarTabla(selector, url) {
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');

        const tabla = $(selector).DataTable({
            destroy: true,
            ajax: {
                url: url,
                dataSrc: "data"
            },
            columns: [
                { data: "nuevo_codigo" },
                {
                    data: "fch",
                    render: function (data, type, row) {
                        if (data && data.startsWith("/Date(")) {
                            const timestamp = parseInt(data.match(/\d+/)[0]);
                            const date = new Date(timestamp);
                            return date.toLocaleDateString('es-MX');
                        }
                        return "";
                    }
                },
                { data: "responsable" },
                { data: "coment_aut" },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        let botones = ``;
                        botones += '' +
                            `<div class="d-flex gap-1" role="group">` +
                            `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Ver detalles" onclick="GetInfoGeneral(${data.id_encabezado})">` +
                            `       <i class="fa-solid fa-circle-info"></i>` +
                            `   </button>` +
                            `   <button class="btn btn-sm btn-success" title="Seleccionar Producto" onclick="aceptarSolicitud(${data.id_encabezado}, '${data.nuevo_codigo}')">` +
                            `        <i class="fa-solid fa-circle-check" ></i> ` +
                            `   </button>`;
                        botones += `</div>`;
                        return botones
                    },

                },
                { data: "id_encabezado", visible: false, searchable: true }
            ],
        });

        // 👇 Espera a que la tabla esté completamente cargada y luego aplica la búsqueda
        if (id) {
            $(selector).on('xhr.dt', function () {
                tabla.search(id).draw();
            });
        }
    }

    function aceptarSolicitud(id, folio) {
        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
    <style>
        .flip {
            animation: spinY 2s linear infinite;
            transform-origin: center;
        }
        @@keyframes spinY {
            0%   { transform: rotateY(0deg); }
            100% { transform: rotateY(360deg); }
        }
    </style>
    <g class="flip">
        <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
        <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
        <circle cx="32" cy="48" r="3" fill="#000"/>
    </g>
</svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: 'Seguro?',
            text: '¿Está seguro que desea aceptar esta solicitud?',
            footer: '<b style="color: red;">ADVERTENCIA - Este cambio no se puede revertir</b>',
            customClass: {
                icon: 'p-0 bg-transparent border-0 shadow-none'
            },
            preConfirm: async (comentario) => {
                GetData({
                    path: '/Inventario/AceptarSolicitudTraslado',
                    data: {
                        id_encabezado: id,
                        folio: folio
                    }
                }).then((_res) => {
                    if (_res.icon === 'success') {
                        _SwalReload(_res)
                    } else {
                        _Swal.fire(_res)
                    }
                })
            }
        });
    }
</script>