@{
    ViewBag.Title = "Inventario Virtual";
}

@* Ajusta esta ruta a donde realmente vivan tus archivos estáticos *@
<link href="~/content/Inventario/inventario-virtual.css" rel="stylesheet" />

<div id="appInventarioVirtual" class="iv-almacen-virtual">

    <!-- Barra de selección / búsqueda -->
    <div class="iv-toolbar">
        <div class="iv-selector">
            <label class="form-label mb-1">Sucursal</label>
            <select id="selSucursal" class="form-select form-select-sm">
                <option value="">Selecciona sucursal...</option>
            </select>
        </div>

        <div class="iv-selector">
            <label class="form-label mb-1">Almacén</label>
            <select id="selAlmacen" class="form-select form-select-sm" disabled>
                <option value="">Selecciona almacén...</option>
            </select>
        </div>

        <div class="iv-selector iv-search">
            <label class="form-label mb-1">Buscar producto / tarima</label>
            <input type="text" id="inputBusqueda" class="form-control form-control-sm"
                   placeholder="Código, descripción o tarima..." />
        </div>

        <div class="iv-legend">
            <span class="iv-legend-item"><span class="iv-swatch iv-swatch-vacio"></span> Vacío</span>
            <span class="iv-legend-item"><span class="iv-swatch iv-swatch-baja"></span> Llenado bajo</span>
            <span class="iv-legend-item"><span class="iv-swatch iv-swatch-media"></span> Llenado medio</span>
            <span class="iv-legend-item"><span class="iv-swatch iv-swatch-alta"></span> Llenado alto</span>
            <span class="iv-legend-item"><span class="iv-swatch iv-swatch-match"></span> Coincidencia</span>
        </div>
    </div>

    <!-- Estados -->
    <div id="estadoCarga" class="iv-estado text-center py-5">
        <div class="spinner-border" role="status"></div>
        <p class="mt-2">Cargando inventario...</p>
    </div>

    <div id="estadoPlaceholder" class="iv-estado text-center py-5 text-muted" style="display:none;">
        Selecciona una sucursal y un almacén para visualizar el inventario.
    </div>

    <div id="estadoVacioAlmacen" class="iv-estado text-center py-5 text-muted" style="display:none;">
        Este almacén no tiene estructura de racks registrada.
    </div>

    <!-- Aquí se inserta: mini-mapa, barra de estadísticas y el plano del almacén -->
    <div id="almacenContenedor" class="iv-warehouse" style="display:none;"></div>

    <!-- Modal de detalle de nivel / tarimas / productos -->
    <div class="modal fade" id="modalDetalleNivel" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="modalDetalleTitulo"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="modalDetalleBody"></div>
            </div>
        </div>
    </div>

</div>

@* Ajusta a tu ruta real del script del componente *@
<script src="~/Scripts/Inventario/Consulta/inventario-virtual.js"></script>
