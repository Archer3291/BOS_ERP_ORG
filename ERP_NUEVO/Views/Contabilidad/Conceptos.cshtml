@{
    ViewBag.Title = "Conceptos";
    ViewBag.PageTitle = "Conceptos";
}

<script>window.document.title = 'Conceptos'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row align-items-end">
            <div class="col-auto">
                <label for="filtroActivo" class="form-label mb-0">Filtrar por estado:</label>
                <select id="filtroActivo" class="form-select form-select-sm mt-1" style="min-width: 160px;">
                    <option value="">Todos</option>
                    <option value="Sí" selected>Activos</option>
                    <option value="No">Inactivos</option>
                </select>
            </div>
            <div class="col d-flex justify-content-end">
                <button type="button" class="btn blue-500" id="btnAdd">
                    <i class="fa-duotone fa-plus"></i> Nuevo Concepto
                </button>
            </div>
        </div>


        <div class="table-responsive-sm">
            <table id="conceptsTable" class="table modern-table" style="width:100%">
                <thead class="bg-secondary">
                    <tr>
                        <th>Clave</th>
                        <th>Descripción</th>
                        <th>Número de cuenta</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade" id="conceptModal" tabindex="-1" aria-labelledby="conceptModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="conceptModalLabel">Registrar Nuevo Concepto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="conceptForm">
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4">
                        <label class="form-label" for="clave">Ingresar clave</label>                        
                        <input type="text" id="clave" class="form-control form-icon-trailing" name="Clave" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="descripcion">Ingresar descripción</label>                        
                        <input type="text" id="descripcion" class="form-control form-icon-trailing" name="Descripcion" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="numerocuenta">Ingresar número de cuenta</label>                        
                        <input type="text" id="numerocuenta" class="form-control form-icon-trailing" name="NumeroCuenta" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Contabilidad/concepts.js"></script>
}