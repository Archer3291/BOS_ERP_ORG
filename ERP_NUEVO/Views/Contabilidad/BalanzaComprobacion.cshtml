    <!-- Árbol -->
    <div class="card-wrap">
        <div id="tree">
            <div class="w-100 d-grid justify-content-center text-center p-4">
                <div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 14 14">
                        <path fill="#999999" fill-rule="evenodd" d="M5.5 0a1 1 0 0 0-1 1v.5a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V1a1 1 0 0 0-1-1zM2.75 1h.5v.5A2.25 2.25 0 0 0 5.5 3.75h3a2.25 2.25 0 0 0 2.25-2.25V1h.5a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5h-8.5a1.5 1.5 0 0 1-1.5-1.5v-10A1.5 1.5 0 0 1 2.75 1" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="mt-2 text-center">
                    Da click en "Consultar", para ver los resultados
                </div>
