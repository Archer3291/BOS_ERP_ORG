@{
    ViewBag.Title = "BalanzaComprobacion";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Balanza de comprobacion";
}

<link href="~/content/TableBuilder.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<style>
    .bk-wrap {
        padding: 1rem 0;
    }

    /* ── Filter Bar ─────────────────────────────────────────── */
    .filter-bar {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius);
        padding: 16px 20px;
        margin-bottom: 16px;
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
        box-shadow: var(--shadow);
    }

    .filter-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
        min-width: 140px;
        flex: 1;
    }

        .filter-group label {
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-light);
        }

        .filter-group input,
        .filter-group select {
            height: 34px;
            padding: 0 10px;
            border: 1px solid var(--border-light);
            border-radius: var(--row-radius);
            background: var(--bg-gray);
            color: var(--text-dark);
            font-size: 13px;
            outline: none;
            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
        }

            .filter-group input:focus,
            .filter-group select:focus {
                border-color: var(--accent-blue);
                background: var(--bg-light);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.12);
            }

    /* ── Toggle dentro del filter-bar ──────────────────────── */
    /*
     * El problema: .filter-group tiene flex:1 y el .bootstrap-toggle
     * tiene margin-bottom:1rem por defecto, lo que lo empuja hacia arriba
     * y lo desalinea con los botones y divisores.
     *
     * Solución: clase dedicada .filter-toggle-group con flex:0 0 auto
     * para que no crezca, y se neutraliza el margin-bottom del toggle.
     */
    .filter-toggle-group {
        display: flex;
        flex-direction: column;
        gap: 5px;
        flex: 0 0 auto;
    }

        .filter-toggle-group > span {
            font-size: 11px;
            font-weight: 500;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-light);
        }

        .filter-toggle-group .bootstrap-toggle {
            margin-bottom: 0; /* neutraliza el margin del componente */
        }

    .filter-divider {
        width: 1px;
        background: var(--border-light);
        align-self: stretch;
        margin: 0 4px;
    }

    .filter-actions {
        display: flex;
        gap: 8px;
        align-items: flex-end;
    }

    .btn {
        height: 34px;
        padding: 0 16px;
        border-radius: var(--row-radius);
        font-size: 13px;
        cursor: pointer;
        transition: all var(--transition-fast);
        white-space: nowrap;
        border: 1px solid var(--border-light);
        /*background: var(--bg-light);*/
        color: var(--text-dark);
    }

        .btn:hover {
            background: var(--bg-gray);
            border-color: var(--secondary-blue);
        }

        .btn:active {
            transform: scale(0.98);
        }

    .btn-primary {
        background: var(--primary-blue);
        color: #fff;
        border-color: var(--primary-blue);
    }

        .btn-primary:hover {
            background: var(--primary-blue-dark);
            border-color: var(--primary-blue-dark);
        }

    /* ── Column Header ──────────────────────────────────────── */
    .bk-header {
        display: grid;
        grid-template-columns: 1fr repeat(4, 120px);
        gap: 8px;
        padding: 6px 12px 6px 32px;
        font-size: 11px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-light);
        border-bottom: 1px solid var(--border-light);
        margin-bottom: 4px;
    }

        .bk-header span {
            text-align: right;
        }

            .bk-header span:first-child {
                text-align: left;
            }

    /* ── Card Wrapper ───────────────────────────────────────── */
    .card-wrap {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius);
        padding: 8px;
        box-shadow: var(--shadow);
    }

    /* ── Tree Nodes ─────────────────────────────────────────── */
    .node {
        border-radius: var(--row-radius);
        margin-bottom: 2px;
        overflow: hidden;
    }

    .node-row {
        display: grid;
        grid-template-columns: 1fr repeat(4, 120px);
        gap: 8px;
        align-items: center;
        padding: 7px 12px;
        cursor: pointer;
        border-radius: var(--row-radius);
        transition: background var(--transition-fast);
        border: 0.5px solid transparent;
    }

        .node-row:hover {
            background: var(--bg-gray);
            border-color: var(--border-light);
        }

        .node-row.leaf {
            cursor: default;
        }

            .node-row.leaf:hover {
                background: transparent;
                border-color: transparent;
            }

    .node-name {
        display: flex;
        align-items: center;
        gap: 6px;
        font-size: 13px;
        color: var(--text-dark);
        overflow: hidden;
    }

        .node-name .code {
            font-size: 11px;
            color: var(--text-light);
            font-family: monospace;
            flex-shrink: 0;
        }

        .node-name .label {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

    .chevron {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        color: var(--text-light);
        transition: transform var(--transition-med);
    }

        .chevron.open {
            transform: rotate(90deg);
        }

    .chevron-ph {
        width: 14px;
        flex-shrink: 0;
    }

    .node-amt {
        font-size: 13px;
        text-align: right;
        font-variant-numeric: tabular-nums;
        color: var(--text-light);
    }

    .node-saldo {
        font-size: 13px;
        text-align: right;
        font-variant-numeric: tabular-nums;
        font-weight: 500;
    }

    .saldo-pos {
        color: var(--success-color);
    }

    .saldo-neg {
        color: var(--danger-color);
    }

    .children {
        padding-left: 16px;
        overflow: hidden;
    }

    /* ── Depth Levels ───────────────────────────────────────── */
    .depth-0 > .node-row {
        background: var(--primary-blue);
        border-radius: var(--row-radius);
    }

        .depth-0 > .node-row .node-name .code,
        .depth-0 > .node-row .node-name .label,
        .depth-0 > .node-row .node-amt,
        .depth-0 > .node-row .node-saldo {
            color: #ffffff !important;
        }

        .depth-0 > .node-row .chevron {
            color: rgba(255,255,255,0.6);
        }

        .depth-0 > .node-row:hover {
            background: var(--primary-blue-dark);
            border-color: transparent;
        }

    .depth-1 > .node-row {
        background: var(--light-blue);
        border-radius: var(--row-radius);
    }

        .depth-1 > .node-row .node-name .label {
            font-weight: 500;
        }

    .depth-2 > .node-row {
        background: var(--bg-gray);
        border-radius: var(--row-radius);
    }

        .depth-2 > .node-row .node-name .label {
            font-weight: 500;
        }

    .depth-3 > .node-row {
        background: transparent;
    }

        .depth-3 > .node-row .node-name .label {
            font-weight: 500;
            font-size: 12.5px;
        }

    .leaf-row .node-name .label {
        color: var(--text-light);
        font-weight: 400;
        font-size: 12px;
    }

    .leaf-row .node-amt {
        font-size: 12px;
    }

    .leaf-row .node-saldo {
        font-size: 12px;
    }

    .spacer {
        height: 8px;
    }

    /* ── Validación de campos obligatorios ─────────────────────── */
    .field-error input,
    .field-error select {
        border-color: var(--danger-color) !important;
        background: color-mix(in srgb, var(--danger-color) 6%, var(--bg-light)) !important;
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--danger-color) 15%, transparent) !important;
    }

    .field-error label {
        color: var(--danger-color) !important;
    }

    .error-msg {
        font-size: 10px;
        color: var(--danger-color);
        font-weight: 500;
        margin-top: 2px;
        display: none;
    }

    .field-error .error-msg {
        display: block;
    }
</style>

<div class="bk-wrap">
