    async function guardarTipoPoliza() {
        const nombre = document.getElementById('tipo_nombre').value.trim();
        const categoriaId = document.getElementById('tipo_categoria').value;
        const clasificacionId = document.getElementById('tipo_clasificacion').value;
        const descripcion = document.getElementById('tipo_descripcion').value.trim();
        const activo = document.getElementById('tipo_activo').checked;

        if (!nombre) {
            mostrarAlerta('error', 'El nombre es obligatorio');
            document.getElementById('tipo_nombre').focus();
            return;
        }
        if (!categoriaId) {
            mostrarAlerta('error', 'La categoría es obligatoria');
            return;
        }
        if (!clasificacionId) {
            mostrarAlerta('error', 'La clasificación es obligatoria');
            return;
        }

        const datos = {
            nombre,
            id_categoria: categoriaId,
            clasificacion_id: clasificacionId,
            descripcion,
            activo
        };
        if (window.tipoPolizaEditando) datos.id_tipo_poliza = window.tipoPolizaEditando.id_tipo_poliza;

        Swal.fire({
            title: 'Guardando...',
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });
        await GetData({
            path: '/ConfiguracionPolizas/GuardarTipoPoliza',
            data: datos,
            swalResponse: true,
            swalType: 'modal',
            swalPath: '/Contabilidad/ConfiguracionPolizas'
        });
    }

