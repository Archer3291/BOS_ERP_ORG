                    <button type="button" class="btn btn-cp-ghost btn-sm" id="btnCancelarDocumento">
                        <i class="fa-solid fa-times fa-xs"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Partidas -->
    <div class="cp-section" style="padding-bottom:0.75rem;">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="cp-section-title mb-0"><span class="dot"></span>Partidas</p>
            <button type="button" class="btn btn-cp-success btn-sm" id="btnAgregarPartida">
                <i class="fa-solid fa-plus fa-xs me-1"></i> Agregar
            </button>
        </div>

        <div class="cp-table-wrap cp-scroll" style="max-height:480px; overflow:auto;">
            <table id="tablaPartidas">
                <thead>
                    <tr>
                        <th class="text-center" style="width:52px;">#</th>
                        <th style="min-width:160px;">Tipo cuenta <span style="color:var(--warning-color);">*</span></th>
