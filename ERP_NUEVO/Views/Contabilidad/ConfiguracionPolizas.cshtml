<script src="~/Scripts/TableBuilder.js"></script>
<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>

<script>
    /* ═══════════════════════════════════════════════
       CATÁLOGOS
       Tipos de cuenta, lados, orígenes de monto y tipos de proceso viven en las
       tablas poliza_cat_* (ver sql/poliza_catalogos.sql). Antes eran arreglos
       escritos a mano aquí: agregar un valor obligaba a editar esta vista.
       Se cachean en memoria porque los usan la vista previa y la edición.
    ═══════════════════════════════════════════════ */
    let _catalogosPoliza = null;

    async function getCatalogosPoliza() {
        if (_catalogosPoliza) return _catalogosPoliza;

        const data = await GetData({
            path: '/ConfiguracionPolizas/GetCatalogosPoliza'
        });

        if (!data || !Array.isArray(data.tiposCuenta)) {
            /* Casi siempre significa que falta correr sql/poliza_catalogos.sql */
            _Swal.fire({
                icon: 'error',
                title: 'Catálogos de pólizas no disponibles',
                html: data?.html || 'No se pudieron leer las tablas poliza_cat_*. Verifica que se haya ejecutado sql/poliza_catalogos.sql en esta base.',
                showCancelButton: false
            });
            throw new Error('Catálogos de pólizas no disponibles');
        }

        _catalogosPoliza = {
            tiposCuenta: data.tiposCuenta,
            lados: data.lados,
            origenesMonto: data.origenesMonto,
            tiposProceso: data.tiposProceso
        };
        return _catalogosPoliza;
    }

    /* Índice clave → renglón, para no andar buscando con find() en cada celda */
    function indexarPorClave(catalogo) {
        return Object.fromEntries((catalogo || []).map(x => [x.clave, x]));
    }

    /* ═══════════════════════════════════════════════
   TIPOS DE PÓLIZA
═══════════════════════════════════════════════ */
    async function agregarTipoPoliza() {
        const modalTipoPoliza = new bootstrap.Modal(document.getElementById('modalTipoPoliza'));
        const modalContent = document.getElementById('modalContentTpoliza');
        const modalTitle = document.querySelector('#modalTipoPoliza .modal-title');

        const data = await GetData({
            path: '/ConfiguracionPolizas/GetTiposPoliza'
        });
        const tiposPoliza = data.tipos;
        const empresas = data.empresas;
        const categorias = await GetData({
            path: '/ConfiguracionPolizas/GetCategorias'
        });
        const clasificaciones = await GetData({
            path: '/ConfiguracionPolizas/GetClasificaciones'
        });

        window.datosComplementariosTipos = {
            categorias,
            clasificaciones
        };

        const empresaId = tiposPoliza.length > 0 ? tiposPoliza[0].empresa_id : null;
        const empresaActual = empresas.find(e => e.empresaid == empresaId);
        modalTitle.textContent = empresaActual ? `Tipos de póliza — ${empresaActual.nombre}` : 'Tipos de póliza';

        let html = `
    <!-- Formulario oculto -->
    <div id="formularioTipoPoliza" style="display:none;" class="mb-3">
        <div class="cp-edit-form">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="cp-section-title mb-0">
                    <span class="dot"></span>
                    <span id="tituloFormularioTipo">Nuevo tipo de póliza</span>
                </span>
                <button type="button" class="btn btn-cp-ghost btn-sm" id="btnCancelarFormTipo">
                    <i class="fa-solid fa-times fa-xs"></i>
                </button>
            </div>
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label">Nombre <span class="text-danger">*</span></label>
