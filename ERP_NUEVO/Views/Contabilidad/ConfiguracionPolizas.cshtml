                    ${categorias.map(cat => `<option value="${cat.id_categoria}" ${general.id_categoria == cat.id_categoria ? 'selected' : ''}>${cat.nombre}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label">Clasificación <span class="text-danger">*</span></label>
                <select class="form-select form-select-sm" id="edit_clasificacion">
                    <option value="">Selecciona...</option>
                    ${clasificaciones.map(c => `<option value="${c.id_clasificacion_poliza}" ${general.id_clasificacion_poliza == c.id_clasificacion_poliza ? 'selected' : ''}>${c.nombre}</option>`).join('')}
                </select>
            </div>
            <div class="col-md-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="edit_activo" ${general.activo ? 'checked' : ''}>
                    <label class="form-check-label" for="edit_activo" style="font-size:0.82rem; color:var(--text-light);">Póliza activa</label>
                </div>
            </div>
        </div>
    </div>

    <!-- Documentos -->
    <div class="cp-section">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <p class="cp-section-title mb-0"><span class="dot" style="background:var(--success-color);"></span>Documentos que generan esta póliza</p>
            <button type="button" class="btn btn-cp-success btn-sm" id="btnAgregarDocumento">
                <i class="fa-solid fa-plus fa-xs me-1"></i> Agregar
            </button>
        </div>

        <div class="doc-chips" id="docChips">
            <!-- chips se renderizan aquí -->
        </div>

        <!-- Formulario inline para agregar doc -->
        <div id="nuevoDocumentoContainer" style="display:none;" class="add-doc-form mt-2">
            <div class="row g-2 align-items-end">
                <div class="col-md-5">
                    <label class="form-label" style="font-size:0.75rem; color:var(--text-light); font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">
                        Documento <span class="text-danger">*</span>
                    </label>
                    <select id="selectNuevoDocumento"></select>
                </div>
                <div class="col-md-4">
                    <label class="form-label" style="font-size:0.75rem; color:var(--text-light); font-weight:600; text-transform:uppercase; letter-spacing:0.04em;">
