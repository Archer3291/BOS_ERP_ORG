    /* ═══════════════════════════════════════════════
       VISTA PREVIA
    ═══════════════════════════════════════════════ */
    async function vistaPrevia(e) {
        const polizaConfig = await GetData({
            path: '/ConfiguracionPolizas/GetPolizaConfig',
            data: {
                id_tipo_poliza: e.id_tipo_poliza
            }
        });
        const partidas = polizaConfig.partidas;
        const general = polizaConfig.general[0];
        const modalContent = document.getElementById('modalContent');

        const catalogos = await getCatalogosPoliza();
        const tiposCuentaPorClave = indexarPorClave(catalogos.tiposCuenta);

        /* Montos de ejemplo por origen: columna monto_ejemplo del catálogo */
        const montosFicticios = Object.fromEntries(
            catalogos.origenesMonto.map(o => [o.clave, Number(o.monto_ejemplo) || 0])
        );
        const leyendaMontos = catalogos.origenesMonto
            .filter(o => Number(o.monto_ejemplo) > 0)
            .map(o => `${o.clave} $${Number(o.monto_ejemplo).toLocaleString('es-MX')}`)
            .join(' · ');

        const calcularMonto = p => ((montosFicticios[p.origen_monto] || 0) * 1).toFixed(2);
        const logoPath = `../Content/img/${general.empresa}/logo.png`;

        let html = `
    <div class="vp-header">
        <div class="vp-logo-box">
            <img src="${logoPath}" alt="Logo" onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
            <div style="display:none; align-items:center; justify-content:center; width:100%; height:100%; color:var(--text-light); font-size:1.4rem;">
                <i class="fa-solid fa-building"></i>
            </div>
        </div>
        <div class="vp-meta">
            <h6>${general.descripcion}</h6>
            <small>
                <span class="cp-badge cp-badge-blue me-1">${general.categoria}</span>
                <span class="cp-badge cp-badge-slate me-1">${general.clasificacion.toUpperCase()}</span>
                <span class="cp-badge ${general.activo ? 'cp-badge-green' : 'cp-badge-red'}">
                    ${general.activo ? 'Activa' : 'Inactiva'}
                </span>
            </small>
        </div>
        <div class="vp-stats">
            <small style="color:var(--text-light);">${general.empresa}</small>
        </div>
    </div>

    <div class="vp-example-bar">
        <i class="fa-solid fa-flask fa-xs me-1"></i>
        <strong>Datos ficticios:</strong> ${leyendaMontos || 'sin montos de ejemplo configurados'}
    </div>

    <div class="cp-table-wrap cp-scroll" style="max-height:500px; overflow-y:auto;">
        <table class="cp-table">
            <thead>
                <tr>
                    <th class="text-center" style="width:50px;">#</th>
                    <th style="width:110px;">Tipo</th>
                    <th style="width:140px;">Cuenta</th>
                    <th>Descripción</th>
                    <th class="text-end" style="width:110px;">Debe</th>
                    <th class="text-end" style="width:110px;">Haber</th>
                    <th class="text-center" style="width:90px;">Origen</th>
                    <th class="text-center" style="width:70px;">IVA</th>
                </tr>
            </thead>
            <tbody>`;

        let totalDebe = 0,
            totalHaber = 0;

        if (!partidas || partidas.length === 0) {
            html += `<tr><td colspan="8" class="text-center py-4" style="color:var(--text-light);font-size:0.82rem;">Sin partidas configuradas</td></tr>`;
        } else {
            partidas.forEach(p => {
                /* Sin cuenta fija capturada, el motor la resuelve en automático:
                   el texto a mostrar sale de etiqueta_cuenta del catálogo. */
                const etiquetaAutomatica = tiposCuentaPorClave[p.tipo_cuenta]?.etiqueta_cuenta;
                const cuentaDisplay = p.cuenta_contable ||
                    (etiquetaAutomatica ?
                        `<em style="color:var(--text-light);font-size:0.78rem;">${etiquetaAutomatica}</em>` :
                        '<em style="color:var(--text-light);">—</em>');

                const monto = calcularMonto(p);
                const isDebe = p.lado === 'DEBE';
                const isHaber = p.lado === 'HABER';
                if (isDebe) totalDebe += parseFloat(monto);
                if (isHaber) totalHaber += parseFloat(monto);

                html += `
            <tr>
                <td class="text-center" style="color:var(--text-light);font-size:0.78rem;">${p.orden}</td>
                <td><span class="cp-badge cp-badge-blue" style="font-size:0.68rem;">${p.tipo_cuenta}</span></td>
                <td style="font-size:0.8rem;">${cuentaDisplay}</td>
                <td style="font-size:0.82rem;">${p.descripcion_template}</td>
                <td class="text-end" style="font-size:0.82rem; font-weight:${isDebe ? '600' : '400'}; color:${isDebe ? 'var(--danger-color)' : 'var(--text-light)'};">
                    ${isDebe ? '$' + parseFloat(monto).toLocaleString('es-MX', { minimumFractionDigits: 2 }) : '—'}
                </td>
                <td class="text-end" style="font-size:0.82rem; font-weight:${isHaber ? '600' : '400'}; color:${isHaber ? 'var(--success-color)' : 'var(--text-light)'};">
                    ${isHaber ? '$' + parseFloat(monto).toLocaleString('es-MX', { minimumFractionDigits: 2 }) : '—'}
                </td>
                <td class="text-center">
                    <span class="cp-badge cp-badge-purple" style="font-size:0.68rem;">${p.origen_monto}</span>
                </td>
                <td class="text-center">
                    ${p.cve_impuesto ? `<span class="cp-badge cp-badge-amber" style="font-size:0.68rem;">${p.cve_impuesto}</span>` : '<span style="color:var(--text-light);">—</span>'}
                </td>
            </tr>`;
            });

            const cuadrada = Math.abs(totalDebe - totalHaber) < 0.01;
            html += `
        <tr class="totales-row">
            <td colspan="4" class="text-end" style="color:var(--text-light);font-size:0.78rem;letter-spacing:0.04em;">TOTALES</td>
            <td class="text-end" style="color:var(--danger-color);">$${totalDebe.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</td>
            <td class="text-end" style="color:var(--success-color);">$${totalHaber.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</td>
            <td colspan="2" class="text-center">
                <span class="cp-badge ${cuadrada ? 'cp-badge-green' : 'cp-badge-red'}">
                    <i class="fa-solid ${cuadrada ? 'fa-check' : 'fa-times'} fa-xs"></i>
                    ${cuadrada ? 'Cuadrada' : 'Descuadrada'}
                </span>
            </td>
        </tr>`;
        }

        html += `</tbody></table></div>

    <div class="d-flex gap-2 mt-3">
        <div class="cp-info-box flex-fill" style="background:var(--bg-light); border-color:var(--border-light); color:var(--text-light);">
            <i class="fa-solid fa-list-ol fa-xs me-1"></i> ${partidas?.length || 0} partidas
        </div>
        <div class="cp-info-box flex-fill ${Math.abs(totalDebe - totalHaber) < 0.01 ? '' : 'bg-danger-subtle'}">
            Diferencia: $${Math.abs(totalDebe - totalHaber).toLocaleString('es-MX', { minimumFractionDigits: 2 })}
        </div>
    </div>`;

        modalContent.innerHTML = html;
        new bootstrap.Modal(document.getElementById('modalVistaPrevia')).show();
    }

    /* ═══════════════════════════════════════════════
       EDITAR PÓLIZA
    ═══════════════════════════════════════════════ */
    let tomSelectInstances = [];

    async function editarPoliza(e) {
        const modalContent = document.getElementById('modalContentEdit');

        const actualConfig = await GetData({
            path: '/ConfiguracionPolizas/GetPolizaConfig',
            data: {
                id_tipo_poliza: e.id_tipo_poliza
            }
        });
        window.currentPolizaId = e.id_tipo_poliza;
        window.currentEmpresaId = e.empresaid;

        const partidas = actualConfig.partidas;
        const general = actualConfig.general[0];
        const documentosPoliza = actualConfig.documentosPoliza;
        const documentos = actualConfig.documentos;

        const datosComplementarios = await GetData({
            path: '/ConfiguracionPolizas/GetDatosComplementarios',
            data: {
                empresa_id: e.empresaid
            }
        });
        const empresas = datosComplementarios.empresas;
        const cuentas = datosComplementarios.cuentas;
        const impuestos = datosComplementarios.impuestos;
        const categorias = datosComplementarios.categorias;
        const clasificaciones = datosComplementarios.clasificaciones;

        /* Catálogos desde la BD (tablas poliza_cat_*), ya no listas fijas aquí */
        const catalogos = await getCatalogosPoliza();
        const tiposCuenta = catalogos.tiposCuenta;
        const lados = catalogos.lados;
        const origenesMontos = catalogos.origenesMonto;
        const tiposProceso = catalogos.tiposProceso;

        /* El selector de tipo de proceso pasa de 14 a más de 45 opciones,
           así que se agrupa por módulo para que siga siendo navegable. */
        const opcionesTipoProceso = (() => {
            const grupos = new Map();
            tiposProceso.forEach(tp => {
                const modulo = tp.modulo || 'Otros';
                if (!grupos.has(modulo)) grupos.set(modulo, []);
                grupos.get(modulo).push(tp);
            });
            return [...grupos.entries()].map(([modulo, items]) => `
                <optgroup label="${modulo}">
                    ${items.map(tp => `<option value="${tp.clave}">${tp.descripcion}</option>`).join('')}
                </optgroup>`).join('');
        })();

        /* Reglas de captura por tipo de cuenta, también del catálogo */
        const tiposQueExigenCuenta = tiposCuenta.filter(t => t.requiere_cuenta).map(t => t.clave);
        const tiposQueExigenImpuesto = tiposCuenta.filter(t => t.requiere_impuesto).map(t => t.clave);
        const reglasValidacion = [
            'Todos los campos marcados con * son obligatorios',
            tiposQueExigenCuenta.length ? `La cuenta es obligatoria si el tipo es ${tiposQueExigenCuenta.join(' o ')}` : '',
            tiposQueExigenImpuesto.length ? `El impuesto es obligatorio si el tipo es ${tiposQueExigenImpuesto.join(' o ')}` : '',
            ...tiposCuenta
                .filter(t => t.origen_monto_forzado)
                .map(t => `Si el tipo es ${t.clave}, el origen se fija en ${t.origen_monto_forzado}`)
        ].filter(Boolean);

        let html = `
    <!-- Configuración general -->
