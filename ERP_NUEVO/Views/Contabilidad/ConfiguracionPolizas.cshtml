@{
    ViewBag.Title = "ConfiguracionPolizas";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["PageTitle"] = "Configuracion de polizas";
}

<style>
    /* ── Modales generales ── */
    .modal-content {
        border: none;
        border-radius: 16px;
        overflow: hidden;
        box-shadow: var(--shadow-lg);
    }

    .modal-header {
        background: var(--bg-light);
        border-bottom: 1px solid var(--border-light);
        padding: 1.1rem 1.5rem;
    }

    .modal-title {
        font-size: 0.95rem;
        font-weight: 600;
        color: var(--text-dark);
        letter-spacing: -0.01em;
    }

    .modal-body {
        background: var(--bg-gray);
        padding: 1.25rem 1.5rem;
    }

    .modal-footer {
        background: var(--bg-light);
        border-top: 1px solid var(--border-light);
        padding: 0.85rem 1.5rem;
        gap: 0.5rem;
    }

    /* ── Sección card interna ── */
    .cp-section {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
        margin-bottom: 1rem;
    }

    .cp-section-title {
        font-size: 0.78rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--text-light);
        margin-bottom: 0.9rem;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

        .cp-section-title .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--accent-blue);
            flex-shrink: 0;
        }

    /* ── Tabla de partidas ── */
    #tablaPartidas {
        font-size: 0.82rem;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        #tablaPartidas thead th {
            background: var(--bg-gray);
            color: var(--text-light);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 9px 10px;
            border-bottom: 1px solid var(--border-light);
            border-top: none;
            white-space: nowrap;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        #tablaPartidas tbody tr {
            border-bottom: 1px solid var(--border-light);
            transition: background var(--transition-fast);
        }

            #tablaPartidas tbody tr:last-child {
                border-bottom: none;
            }

            #tablaPartidas tbody tr:hover {
                background: var(--bg-gray);
            }

        #tablaPartidas td {
            padding: 7px 8px;
            vertical-align: middle;
            border: none;
        }

    /* ── Tabla genérica (categorías, tipos, documentos) ── */
    .cp-table {
        font-size: 0.84rem;
        border-collapse: separate;
        border-spacing: 0;
        width: 100%;
    }

        .cp-table thead th {
            background: var(--bg-gray);
            color: var(--text-light);
            font-size: 0.72rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 9px 12px;
            border-bottom: 1px solid var(--border-light);
            border-top: none;
            white-space: nowrap;
        }

        .cp-table tbody tr {
            border-bottom: 1px solid var(--border-light);
            transition: background var(--transition-fast);
        }

            .cp-table tbody tr:last-child {
                border-bottom: none;
            }

            .cp-table tbody tr:hover {
                background: var(--very-light-blue);
            }

        .cp-table td {
            padding: 9px 12px;
            vertical-align: middle;
            border: none;
            color: var(--text-dark);
        }

    .cp-table-wrap {
        border: 1px solid var(--border-light);
        border-radius: 10px;
        overflow: hidden;
    }

    /* ── Badges ── */
    .cp-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.72rem;
        font-weight: 500;
        padding: 3px 9px;
        border-radius: 20px;
        line-height: 1.4;
    }

    .cp-badge-blue {
        background: #eff6ff;
        color: #1d4ed8;
    }

    .cp-badge-slate {
        background: #f1f5f9;
        color: var(--secondary-blue);
    }

    .cp-badge-green {
        background: #f0fdf4;
        color: #166534;
    }

    .cp-badge-red {
        background: #fef2f2;
        color: #991b1b;
    }

    .cp-badge-amber {
        background: #fffbeb;
        color: #92400e;
    }

    .cp-badge-purple {
        background: var(--accent-purple-light);
        color: #4338ca;
    }

    [data-theme="dark"] .cp-badge-blue {
        background: #1e3a5f;
        color: #93c5fd;
    }

    [data-theme="dark"] .cp-badge-slate {
        background: #334155;
        color: #94a3b8;
    }

    [data-theme="dark"] .cp-badge-green {
        background: #064e3b;
        color: #6ee7b7;
    }

    [data-theme="dark"] .cp-badge-red {
        background: #7f1d1d;
        color: #fca5a5;
    }

    [data-theme="dark"] .cp-badge-amber {
        background: #78350f;
        color: #fcd34d;
    }

    [data-theme="dark"] .cp-badge-purple {
        background: #3730a3;
        color: #c4b5fd;
    }

    /* ── Documentos — chips ── */
    .doc-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        min-height: 38px;
        padding: 2px 0;
    }

    .doc-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--bg-gray);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 5px 10px;
        font-size: 0.8rem;
        color: var(--text-dark);
        transition: background var(--transition-fast);
    }

        .doc-chip:hover {
            background: #fee2e2;
            border-color: #fca5a5;
        }

        .doc-chip .chip-clave {
            font-weight: 600;
            color: var(--accent-blue);
            font-size: 0.75rem;
        }

        .doc-chip .chip-proceso {
            font-size: 0.7rem;
            color: var(--text-light);
            background: var(--light-blue);
            border-radius: 4px;
            padding: 1px 5px;
        }

        .doc-chip .chip-remove {
            background: none;
            border: none;
            color: var(--text-light);
            cursor: pointer;
            padding: 0;
            line-height: 1;
            font-size: 0.75rem;
            transition: color var(--transition-fast);
        }

            .doc-chip .chip-remove:hover {
                color: var(--danger-color);
            }

    .doc-chip-empty {
        color: var(--text-light);
        font-size: 0.82rem;
        padding: 6px 0;
    }

    /* ── Formulario inline de agregar documento ── */
    .add-doc-form {
        background: var(--bg-gray);
        border: 1px dashed var(--border-light);
        border-radius: 10px;
        padding: 12px 14px;
        margin-top: 10px;
    }

    /* ── Formulario de edición (categoría / tipo póliza) ── */
    .cp-edit-form {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-left: 3px solid var(--accent-blue);
        border-radius: 10px;
        padding: 1rem 1.1rem;
        margin-bottom: 1rem;
    }

        .cp-edit-form .form-label {
            font-size: 0.78rem;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 4px;
        }

        .cp-edit-form .form-control,
        .cp-edit-form .form-select {
            font-size: 0.85rem;
            border-color: var(--border-light);
            background: var(--bg-gray);
            color: var(--text-dark);
            border-radius: 8px;
        }

            .cp-edit-form .form-control:focus,
            .cp-edit-form .form-select:focus {
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
            }

    /* ── Config general del modal de edición ── */
    #modalContentEdit .form-label {
        font-size: 0.78rem;
        font-weight: 600;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 4px;
    }

    #modalContentEdit .form-control,
    #modalContentEdit .form-select {
        font-size: 0.85rem;
        border-color: var(--border-light);
        background: var(--bg-light);
        color: var(--text-dark);
        border-radius: 8px;
    }

        #modalContentEdit .form-control:focus,
        #modalContentEdit .form-select:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59,130,246,0.1);
        }

    /* ── Selects dentro de la tabla de partidas ── */
    #tablaPartidas .form-select-sm,
    #tablaPartidas .form-control-sm {
        font-size: 0.8rem;
        border-radius: 6px;
        border-color: var(--border-light);
        background: var(--bg-light);
        color: var(--text-dark);
        padding: 4px 8px;
    }

        #tablaPartidas .form-select-sm:focus,
        #tablaPartidas .form-control-sm:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 2px rgba(59,130,246,0.12);
        }

    /* Hint de descripción bajo el select */
    .field-hint {
        font-size: 0.68rem;
        color: var(--text-light);
        min-height: 1.3em;
        line-height: 1.3;
        margin-top: 3px;
        max-width: 230px;
    }

    .tipo-cuenta-desc {
        background: var(--border-light);
        padding: 6px;
        border-radius: 8px;
        border-color: var(--border-light);
    }

    /* ── Orden input ── */
    .orden-input {
        background: var(--bg-gray) !important;
        font-weight: 600;
        font-size: 0.82rem;
        text-align: center;
        border-radius: 6px;
        border-color: var(--border-light);
        color: var(--text-light);
    }

    /* ── TomSelect override ── */
    .ts-wrapper.form-select-sm .ts-control {
        min-height: 30px !important;
        font-size: 0.8rem !important;
        border-radius: 6px !important;
        border-color: var(--border-light) !important;
        background: var(--bg-light) !important;
        padding: 3px 8px !important;
    }

    .ts-dropdown {
        z-index: 9999 !important;
        border-radius: 8px !important;
        border-color: var(--border-light) !important;
        font-size: 0.82rem !important;
        box-shadow: var(--shadow-lg) !important;
    }

    /* ── Botones ── */
    .btn-cp-primary {
        background: var(--accent-blue);
        color: #fff;
        border: none;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 6px 14px;
        transition: opacity var(--transition-fast);
    }

        .btn-cp-primary:hover {
            opacity: 0.88;
            color: #fff;
        }

    .btn-cp-ghost {
        background: transparent;
        color: var(--text-light);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        font-size: 0.8rem;
        padding: 6px 14px;
        transition: background var(--transition-fast), color var(--transition-fast);
    }

        .btn-cp-ghost:hover {
            background: var(--bg-gray);
            color: var(--text-dark);
        }

    .btn-cp-danger {
        background: #fef2f2;
        color: #dc2626;
        border: 1px solid #fecaca;
        border-radius: 6px;
        font-size: 0.75rem;
        padding: 4px 8px;
        transition: background var(--transition-fast);
    }

        .btn-cp-danger:hover {
            background: #fee2e2;
            color: #b91c1c;
        }

    [data-theme="dark"] .btn-cp-danger {
        background: #7f1d1d;
        color: #fca5a5;
        border-color: #991b1b;
    }

    .btn-cp-success {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
        border-radius: 8px;
        font-size: 0.8rem;
        font-weight: 500;
        padding: 6px 14px;
        transition: background var(--transition-fast);
    }

        .btn-cp-success:hover {
            background: #dcfce7;
            color: #14532d;
        }

    [data-theme="dark"] .btn-cp-success {
        background: #064e3b;
        color: #6ee7b7;
        border-color: #065f46;
    }

    /* ── Info box (validaciones) ── */
    .cp-info-box {
        background: #eff6ff;
        border: 1px solid #bfdbfe;
        border-radius: 10px;
        padding: 10px 14px;
        font-size: 0.78rem;
        color: #1e40af;
        line-height: 1.6;
        margin-top: 0.75rem;
    }

    [data-theme="dark"] .cp-info-box {
        background: #1e3a5f;
        border-color: #1d4ed8;
        color: #93c5fd;
    }

    /* ── Vista previa ── */
    #modalVistaPrevia .cp-table th {
        white-space: nowrap;
    }

    .vp-header {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 1rem 1.25rem;
        margin-bottom: 1rem;
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .vp-logo-box {
        width: 64px;
        height: 64px;
        border: 1px solid var(--border-light);
        border-radius: 10px;
        overflow: hidden;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--bg-gray);
    }

        .vp-logo-box img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
        }

    .vp-meta {
        flex: 1;
    }

        .vp-meta h6 {
            font-size: 0.92rem;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 4px;
        }

        .vp-meta small {
            color: var(--text-light);
            font-size: 0.78rem;
        }

    .vp-stats {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 4px;
    }

    .vp-example-bar {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: 7px 12px;
        font-size: 0.78rem;
        color: #92400e;
        margin-bottom: 1rem;
    }

    [data-theme="dark"] .vp-example-bar {
        background: #78350f;
        border-color: #b45309;
        color: #fcd34d;
    }

    .cp-section {
        position: relative;
    }

    /* ── Scroll personalizado ── */
    .cp-scroll::-webkit-scrollbar {
        width: 6px;
        height: 6px;
    }

    .cp-scroll::-webkit-scrollbar-track {
        background: transparent;
    }

    .cp-scroll::-webkit-scrollbar-thumb {
        background: var(--border-light);
        border-radius: 3px;
    }

        .cp-scroll::-webkit-scrollbar-thumb:hover {
            background: var(--secondary-blue);
        }

    /* ── Totales row ── */
    .totales-row td {
        background: var(--bg-gray);
        font-weight: 600;
        font-size: 0.82rem;
        border-top: 2px solid var(--border-light) !important;
    }
</style>

<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<link href="~/content/TableBuilder.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />

@* Tabla principal *@
<div class="contenedor-tabla">
    <div class="card-body">
        <div class="d-flex gap-2 mb-3">
            <button class="btn btn-sm btn-cp-ghost" onclick="agregarCategoria()">
                <i class="fa-solid fa-tag fa-xs me-1"></i> Categorías
            </button>
