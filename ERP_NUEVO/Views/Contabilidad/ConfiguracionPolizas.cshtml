                    </label>
                    <select class="form-select form-select-sm" id="selectTipoProceso">
                        <option value="">Selecciona...</option>
                        ${opcionesTipoProceso}
                    </select>
                </div>
                <div class="col-md-3 d-flex gap-1">
                    <button type="button" class="btn btn-cp-primary btn-sm flex-fill" id="btnConfirmarDocumento">
