    function limpiarFormularioTipoPoliza() {
        ['tipo_nombre', 'tipo_descripcion'].forEach(id => document.getElementById(id).value = '');
        document.getElementById('tipo_categoria').value = '';
        document.getElementById('tipo_clasificacion').value = '';
        document.getElementById('tipo_activo').checked = true;
