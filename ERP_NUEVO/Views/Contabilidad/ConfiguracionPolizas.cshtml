    <div class="cp-info-box">
        <i class="fa-solid fa-circle-info fa-xs me-1"></i>
        <strong>Validaciones:</strong> ${reglasValidacion.join(' · ')}
    </div>`;

        modalContent.innerHTML = html;

        /* ── Documentos (chips) ── */
        let tomSelectDocumento = null;

        function inicializarTomSelectDocumento() {
            if (tomSelectDocumento) {
                tomSelectDocumento.destroy();
                tomSelectDocumento = null;
            }
            tomSelectDocumento = new TomSelect('#selectNuevoDocumento', {
                placeholder: 'Busca un documento...',
                dropdownParent: 'body',
                allowEmptyOption: true,
                create: false,
                options: [],
                render: {
                    option: (data, escape) => `<div style="padding:5px;">
                    <span style="color:black;font-weight:600;">${escape(data.clave)}</span>
                    <span style="color:var(--accent-blue);"> — ${escape(data.text)}</span></div>`,
                    item: (data, escape) => `<div>${escape(data.clave)} — ${escape(data.text)}</div>`
                }
            });
        }

        window.documentosPolizaActuales = documentosPoliza.map(d => ({
            idtpdoc: d.idtpdoc,
            abreviaturatpdoc: d.abreviaturatpdoc,
            tpdoc: d.tpdoc,
            tipo_proceso: d.tipo_proceso || null,
            id_poliza_documento: d.id_poliza_documento,
            esNuevo: false
        }));

        renderizarDocumentos();

        document.getElementById('btnAgregarDocumento').addEventListener('click', () => {
            document.getElementById('nuevoDocumentoContainer').style.display = 'block';
            inicializarTomSelectDocumento();
            actualizarSelectDocumentos();
        });

        document.getElementById('btnConfirmarDocumento').addEventListener('click', () => {
            const idtpdoc = tomSelectDocumento.getValue();
            const tipoProceso = document.getElementById('selectTipoProceso').value;
            if (!idtpdoc) {
                mostrarAlerta('warning', 'Selecciona un documento.');
                return;
            }
            if (!tipoProceso) {
                mostrarAlerta('warning', 'Selecciona el tipo de proceso.');
                return;
            }

            const doc = documentos.find(d => d.idtpdoc == idtpdoc);
            window.documentosPolizaActuales.push({
                idtpdoc: doc.idtpdoc,
                abreviaturatpdoc: doc.abreviaturatpdoc,
                tpdoc: doc.tpdoc,
                tipo_proceso: tipoProceso,
                id_poliza_documento: null,
                esNuevo: true
            });
            renderizarDocumentos();
            document.getElementById('nuevoDocumentoContainer').style.display = 'none';
            document.getElementById('selectTipoProceso').value = '';
            tomSelectDocumento.clear();
        });

        document.getElementById('btnCancelarDocumento').addEventListener('click', () => {
            document.getElementById('nuevoDocumentoContainer').style.display = 'none';
            if (tomSelectDocumento) tomSelectDocumento.clear();
        });

        /* ── Partidas ── */
        partidas.forEach((partida, index) => {
            agregarFilaPartida(partida, index + 1, {
                cuentas,
                impuestos,
                tiposCuenta,
                lados,
                origenesMontos
            });
        });

        document.getElementById('btnAgregarPartida').addEventListener('click', () => {
            const nuevoOrden = document.getElementById('partidasBody').children.length + 1;
            agregarFilaPartida(null, nuevoOrden, {
                cuentas,
                impuestos,
                tiposCuenta,
                lados,
                origenesMontos
            });
        });

        /* ── Cambio de empresa ── */
        document.getElementById('edit_empresa').addEventListener('change', async function () {
            const nuevaEmpresaId = this.value;
            const confirmar = await Swal.fire({
                title: '¿Cambiar empresa?',
                html: 'Se perderán las cuentas seleccionadas en las partidas.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonText: 'Sí, cambiar',
                cancelButtonText: 'Cancelar'
            });
            if (!confirmar.isConfirmed) {
                this.value = window.currentEmpresaId;
                return;
            }
            window.currentEmpresaId = nuevaEmpresaId;
            Swal.fire({
                title: 'Cargando...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
            const nuevosDatos = await GetData({
                path: '/ConfiguracionPolizas/GetDatosComplementarios',
                data: {
                    empresa_id: nuevaEmpresaId
                }
            });
            await recargarPartidas(nuevosDatos.cuentas, nuevosDatos.impuestos, {
                tiposCuenta,
                lados,
                origenesMontos
            });
            Swal.close();
            mostrarAlerta('success', 'Datos actualizados');
        });

        new bootstrap.Modal(document.getElementById('modalEdicion')).show();

        /* ── Funciones auxiliares (documentos) ── */
        function renderizarDocumentos() {
            const chips = document.getElementById('docChips');
            chips.innerHTML = '';
            if (window.documentosPolizaActuales.length === 0) {
                chips.innerHTML = `<span class="doc-chip-empty"><i class="fa-solid fa-inbox fa-xs me-1"></i>Sin documentos asociados</span>`;
                return;
            }
            const procesosPorClave = indexarPorClave(tiposProceso);

            window.documentosPolizaActuales.forEach((doc, index) => {
                /* El chip muestra la descripción del catálogo; si la clave ya no
                   está activa se cae a la clave cruda para no ocultar el dato. */
                const etiquetaProceso = procesosPorClave[doc.tipo_proceso]?.descripcion || doc.tipo_proceso;
                const chip = document.createElement('div');
                chip.className = 'doc-chip';
                chip.innerHTML = `
                <span class="chip-clave">${doc.abreviaturatpdoc}</span>
                <span>${doc.tpdoc}</span>
                ${doc.tipo_proceso ? `<span class="chip-proceso" title="${doc.tipo_proceso}">${etiquetaProceso}</span>` : ''}
                <button class="chip-remove" onclick="eliminarDocumento(${index})" title="Quitar">
                    <i class="fa-solid fa-times"></i>
                </button>`;
                chips.appendChild(chip);
            });
        }

        function actualizarSelectDocumentos() {
            const idsYa = window.documentosPolizaActuales.map(d => d.idtpdoc);
            const disponibles = documentos.filter(d => !idsYa.includes(d.idtpdoc));
            tomSelectDocumento.clearOptions();
            tomSelectDocumento.addOptions(disponibles.map(doc => ({
                value: doc.idtpdoc,
                text: doc.tpdoc,
                clave: doc.abreviaturatpdoc
            })));
            tomSelectDocumento.clear();
        }

        window.eliminarDocumento = function (index) {
            window.documentosPolizaActuales.splice(index, 1);
            renderizarDocumentos();
        };
    }

    /* ── Recargar partidas al cambiar empresa ── */
    async function recargarPartidas(nuevasCuentas, nuevosImpuestos, opciones) {
        const tbody = document.getElementById('partidasBody');
        const filas = tbody.querySelectorAll('tr');
        const actuales = [];

        filas.forEach(fila => {
            actuales.push({
                tipo_cuenta: fila.querySelector('.tipo-cuenta-select').value,
                lado: fila.querySelector('.lado-select').value,
                origen_monto: fila.querySelector('.origen-select').value,
                factor: 1,
                descripcion_template: fila.querySelector('.descripcion-input').value
            });
        });

        tomSelectInstances.forEach(i => {
            if (i?.destroy) i.destroy();
        });
        tomSelectInstances = [];
        tbody.innerHTML = '';

        actuales.forEach((p, index) => {
            agregarFilaPartida(p, index + 1, {
                cuentas: nuevasCuentas,
                impuestos: nuevosImpuestos,
                ...opciones
            });
        });
    }

    /* ── Agregar fila de partida ── */
    function agregarFilaPartida(partida, orden, opciones) {
        const {
            cuentas,
            impuestos,
            tiposCuenta,
            lados,
            origenesMontos
        } = opciones;
        const tbody = document.getElementById('partidasBody');
        const rowId = `partida_${Date.now()}_${orden}`;
        const tr = document.createElement('tr');
        tr.id = rowId;

        const descTipoCuenta = (() => {
            const m = tiposCuenta.find(t => t.clave === partida?.tipo_cuenta);
            return m ? m.descripcion : '';
        })();
        const descOrigen = (() => {
            const m = origenesMontos.find(o => o.clave === partida?.origen_monto);
            return m ? m.descripcion : '';
        })();

        tr.innerHTML = `
        <td class="text-center">
            <input type="number" class="form-control form-control-sm orden-input" value="${orden}" min="1" readonly style="width:48px;">
        </td>
        <td>
            <select class="form-select form-select-sm tipo-cuenta-select" required>
                <option value="">—</option>
                ${tiposCuenta.map(t => `
                    <option value="${t.clave}" data-desc="${t.descripcion}" ${partida?.tipo_cuenta === t.clave ? 'selected' : ''}>
                        ${t.clave}
                    </option>`).join('')}
            </select>
            <div class="field-hint tipo-cuenta-desc">${descTipoCuenta}</div>
        </td>
        <td><select class="cuenta-select" style="width:100%;"></select></td>
        <td>
            <select class="form-select form-select-sm lado-select" required>
                <option value="">—</option>
                ${lados.map(l => `<option value="${l.clave}" title="${l.descripcion}" ${partida?.lado === l.clave ? 'selected' : ''}>${l.clave}</option>`).join('')}
            </select>
        </td>
        <td>
            <select class="form-select form-select-sm origen-select" required>
                <option value="">—</option>
                ${origenesMontos.map(o => `
                    <option value="${o.clave}" data-desc="${o.descripcion}" ${partida?.origen_monto === o.clave ? 'selected' : ''}>
                        ${o.clave}
                    </option>`).join('')}
            </select>
            <div class="field-hint origen-desc">${descOrigen}</div>
        </td>
        <td>
            <input type="text" class="form-control form-control-sm descripcion-input"
                value="${partida?.descripcion_template || ''}" required placeholder="Descripción..." style="min-width:150px;">
        </td>
        <td><select class="impuesto-select" style="width:100%;"></select></td>
        <td class="text-center">
            <button type="button" class="btn btn-cp-danger" onclick="eliminarPartida('${rowId}')" title="Eliminar">
                <i class="fa-solid fa-trash fa-xs"></i>
            </button>
        </td>`;

        tbody.appendChild(tr);

        /* Hints de descripción */
        const tipoCuentaSelect = tr.querySelector('.tipo-cuenta-select');
        const tipoCuentaDesc = tr.querySelector('.tipo-cuenta-desc');
        const origenSelect = tr.querySelector('.origen-select');
        const origenDesc = tr.querySelector('.origen-desc');

        const actualizarDesc = (sel, el) => {
            const o = sel.options[sel.selectedIndex];
            el.textContent = o?.dataset.desc || '';
        };

        /* TomSelect cuenta */
        const cuentaEl = tr.querySelector('.cuenta-select');
        const tomSelectCuenta = new TomSelect(cuentaEl, {
            dropdownParent: tr.closest('.cp-section'),
            allowEmptyOption: true,
            create: false,
            maxOptions: 500,
            placeholder: 'Cuenta...',
            onDropdownOpen() {
                const wrap = document.querySelector('#tablaPartidas').closest('.cp-section');
                const sl = wrap.scrollLeft;

                requestAnimationFrame(() => {
                    wrap.scrollLeft = sl;
                });

                this.positionDropdown(); // 🔥 clave
            },
            onChange() {
                const wrap = document.querySelector('#tablaPartidas').closest('.cp-section');
                const sl = wrap.scrollLeft;

                requestAnimationFrame(() => {
                    wrap.scrollLeft = sl;
                });

                this.positionDropdown(); // 🔥 otra vez
            },
            options: cuentas.map(c => ({
                value: c.id_cuenta_contable,
                text: `${c.codigo} - ${c.nombre}`,
                codigo: c.codigo,
                nombre: c.nombre
            })),
            render: {
        option: (d, esc) => `<div style="padding:4px 8px;"><span style="color:black;font-weight:600;">${esc(d.codigo)} </span> <span style="color:var(--accent-blue);"> — ${esc(d.nombre)}</span></div>`,
        item: (d, esc) => `<div style="padding:4px 8px;"><span style="color:black;font-weight:600;">${esc(d.codigo)} </span> <span style="color:var(--accent-blue);"> — ${esc(d.nombre)}</span></div>`
            }
        });

        tomSelectInstances.push(tomSelectCuenta);
        if (partida?.id_cuenta_contable && cuentas.find(c => c.id_cuenta_contable == partida.id_cuenta_contable)) {
            tomSelectCuenta.setValue(partida.id_cuenta_contable);
        }

        /* TomSelect impuesto */
        const impuestoEl = tr.querySelector('.impuesto-select');
        const tomSelectImpuesto = new TomSelect(impuestoEl, {
            dropdownParent: document.querySelector('.cp-section'),
            allowEmptyOption: true,
            create: false,
            placeholder: 'Impuesto...',
            onDropdownOpen() {
                const wrap = document.querySelector('#tablaPartidas').closest('.cp-section');
                const sl = wrap.scrollLeft;

                requestAnimationFrame(() => {
                    wrap.scrollLeft = sl;
                });

                this.positionDropdown(); // 🔥 clave
            },
            onChange() {
                const wrap = document.querySelector('#tablaPartidas').closest('.cp-section');
                const sl = wrap.scrollLeft;

                requestAnimationFrame(() => {
                    wrap.scrollLeft = sl;
                });

                this.positionDropdown(); // 🔥 otra vez
            },
            options: impuestos.map(i => ({
                value: i.id_impuesto,
                text: `${i.cve_impuesto} - ${i.desc}`,
                cve: i.cve_impuesto,
                descripcion: i.desc
            })),
            render: {
                option: (d, esc) => `<div style="padding:4px 8px;"><span style="color:black;font-weight:600;">${esc(d.cve)} </span> <span style="color:var(--accent-blue);"> — ${esc(d.descripcion)}</span></div>`,
    item: (d, esc) => `<div style="padding:4px 8px;"><span style="color:black;font-weight:600;">${esc(d.cve)} </span> <span style="color:var(--accent-blue);"> — ${esc(d.descripcion)}</span></div>`
            }
        });

        tomSelectInstances.push(tomSelectImpuesto);
        if (partida?.id_impuesto && impuestos.find(i => i.id_impuesto == partida.id_impuesto)) {
            tomSelectImpuesto.setValue(partida.id_impuesto);
        }

        /* Eventos */
        tipoCuentaSelect.addEventListener('change', () => {
            actualizarDesc(tipoCuentaSelect, tipoCuentaDesc);
            validarPartida(tr, tomSelectCuenta, tomSelectImpuesto, tiposCuenta);
        });
        origenSelect.addEventListener('change', () => {
            actualizarDesc(origenSelect, origenDesc);
            validarPartida(tr, tomSelectCuenta, tomSelectImpuesto, tiposCuenta);
        });
        actualizarDesc(tipoCuentaSelect, tipoCuentaDesc);
        actualizarDesc(origenSelect, origenDesc);
    }

    /* ── Validación de partida ──
       Las reglas ya no están escritas aquí: salen de las columnas
       requiere_cuenta / requiere_impuesto / origen_monto_forzado del catálogo
       poliza_cat_tipo_cuenta. */
    function validarPartida(tr, tomSelectCuenta, tomSelectImpuesto, tiposCuenta) {
        const tipoCuenta = tr.querySelector('.tipo-cuenta-select').value;
        const origenSelect = tr.querySelector('.origen-select');
        const origenMonto = origenSelect.value;
        const cuentaWrap = tomSelectCuenta.wrapper.parentElement;
        const impuestoWrap = tomSelectImpuesto.wrapper.parentElement;
        const regla = (tiposCuenta || []).find(t => t.clave === tipoCuenta);

        cuentaWrap.classList.remove('border', 'border-danger', 'rounded');
        impuestoWrap.classList.remove('border', 'border-danger', 'rounded');

        if (!regla) return;

        if (regla.requiere_cuenta && !tomSelectCuenta.getValue())
            cuentaWrap.classList.add('border', 'border-danger', 'rounded');

        if (regla.requiere_impuesto && !tomSelectImpuesto.getValue())
            impuestoWrap.classList.add('border', 'border-danger', 'rounded');

        if (regla.origen_monto_forzado && origenMonto !== regla.origen_monto_forzado) {
            origenSelect.value = regla.origen_monto_forzado;
            origenSelect.dispatchEvent(new Event('change'));
            mostrarAlerta('warning', `Origen debe ser ${regla.origen_monto_forzado} cuando el tipo es ${tipoCuenta}`);
        }
    }

    /* ── Eliminar / reordenar ── */
    function eliminarPartida(rowId) {
        Swal.fire({
            title: '¿Eliminar partida?',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc2626',
            confirmButtonText: 'Eliminar',
            cancelButtonText: 'Cancelar'
        }).then(r => {
            if (r.isConfirmed) {
                document.getElementById(rowId).remove();
                reordenarPartidas();
                mostrarAlerta('success', 'Partida eliminada');
            }
        });
    }

    function reordenarPartidas() {
        document.querySelectorAll('#partidasBody tr').forEach((fila, i) => {
            fila.querySelector('.orden-input').value = i + 1;
        });
    }

    /* ── Alertas ── */
    function mostrarAlerta(tipo, mensaje) {
        toastMixin.fire({
            icon: tipo,
            title: mensaje
        });
    }

    /* ── Guardar edición ── */
    document.getElementById('btnGuardarEdicion').addEventListener('click', async function () {
        const filas = document.querySelectorAll('#partidasBody tr');
        if (filas.length === 0) {
            mostrarAlerta('error', 'Agrega al menos una partida');
            return;
        }

        const { tiposCuenta } = await getCatalogosPoliza();
        const reglasPorTipo = indexarPorClave(tiposCuenta);

        const partidas = [];
        let hayErrores = false;

        filas.forEach((fila, index) => {
            const tipoCuenta = fila.querySelector('.tipo-cuenta-select').value;
            const lado = fila.querySelector('.lado-select').value;
            const origenMonto = fila.querySelector('.origen-select').value;
            const factor = 1;
            const descripcion = fila.querySelector('.descripcion-input').value;
            const idCuenta = fila.querySelector('.cuenta-select').tomselect?.getValue() || null;
            const idImpuesto = fila.querySelector('.impuesto-select').tomselect?.getValue() || null;

            if (!tipoCuenta || !lado || !origenMonto || !factor || !descripcion) {
                mostrarAlerta('error', `Partida ${index + 1}: campos obligatorios vacíos`);
                hayErrores = true;
                return;
            }
            /* Mismas reglas que valida la captura, leídas del catálogo */
            const regla = reglasPorTipo[tipoCuenta];
            if (!regla) {
                mostrarAlerta('error', `Partida ${index + 1}: el tipo de cuenta ${tipoCuenta} ya no está disponible`);
                hayErrores = true;
                return;
            }
            if (regla.requiere_cuenta && !idCuenta) {
                mostrarAlerta('error', `Partida ${index + 1}: la cuenta es obligatoria para tipo ${tipoCuenta}`);
                hayErrores = true;
                return;
            }
            if (regla.requiere_impuesto && !idImpuesto) {
                mostrarAlerta('error', `Partida ${index + 1}: el impuesto es obligatorio`);
                hayErrores = true;
                return;
            }
            if (regla.origen_monto_forzado && origenMonto !== regla.origen_monto_forzado) {
                mostrarAlerta('error', `Partida ${index + 1}: origen debe ser ${regla.origen_monto_forzado}`);
                hayErrores = true;
                return;
            }
            partidas.push({
                orden: index + 1,
                tipo_cuenta: tipoCuenta,
                id_cuenta_contable: idCuenta,
                lado,
                origen_monto: origenMonto,
                factor: parseFloat(factor),
                descripcion_template: descripcion,
                id_impuesto: idImpuesto
            });
        });

        if (hayErrores) return;

        const datosGenerales = {
            id_categoria: document.getElementById('edit_categoria').value,
            id_clasificacion: document.getElementById('edit_clasificacion').value,
            descripcion: document.getElementById('edit_descripcion_general').value,
            activo: document.getElementById('edit_activo').checked,
        };

        if (!datosGenerales.id_categoria || !datosGenerales.id_clasificacion || !datosGenerales.descripcion) {
            mostrarAlerta('error', 'Completa los campos de configuración general');
            return;
        }

        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display:block;margin:auto;">
        <style>.flip{animation:spinY 2s linear infinite;transform-origin:center;}@@keyframes spinY{0%{transform:rotateY(0deg);}100%{transform:rotateY(360deg);}}</style>
        <g class="flip">
            <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
            <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
            <circle cx="32" cy="48" r="3" fill="#000"/>
        </g></svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: 'Guardar póliza',
            html: '¿La póliza es correcta? Puede editarse en cualquier momento.',
            customClass: {
                icon: 'p-0 bg-transparent border-0 shadow-none'
            },
            preConfirm: () => {
                Swal.fire({
                    title: 'Registrando póliza...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => Swal.showLoading()
                });
                GetData({
                    path: '/ConfiguracionPolizas/RegistrarPoliza',
                    data: {
                        tipo_poliza: currentPolizaId,
                        general: JSON.stringify(datosGenerales),
                        partidas: JSON.stringify(partidas),
                        documentos: JSON.stringify(documentosPolizaActuales),
                    },
                    swalResponse: true,
                    swalType: 'modal',
                    swalPath: '/Contabilidad/ConfiguracionPolizas'
                });
            }
        });
    });

    /* ═══════════════════════════════════════════════
        INIT
    ═══════════════════════════════════════════════ */
    document.addEventListener('DOMContentLoaded', () => {
        createTable({
            selector: '#tablaTiposPoliza',
            path: '/ConfiguracionPolizas/GetPolizas',
            searchPlaceholder: 'Buscar tipo de póliza...',
            columns: [{
                title: 'Categoría',
                data: 'categoria'
            },
            {
                title: 'Descripción',
                data: 'descripcion'
            },
            {
                title: 'Clasificación',
                data: 'clasificacion'
            },
            {
                title: 'Empresa',
                data: 'empresa'
            },
            ],
            actions: [{
                icon: 'fa-eye',
                color: 'cyan-500',
                title: 'Vista previa',
                onClick: row => vistaPrevia(row)
            },
            {
                icon: 'fa-pen-to-square',
                color: 'green-500',
                title: 'Editar',
                onClick: row => editarPoliza(row)
            },
            ],
        });
    });
</script>
