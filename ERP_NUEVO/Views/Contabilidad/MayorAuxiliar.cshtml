
@{
    ViewBag.Title = "MayorAuxiliar";
    ViewBag.PageTitle = "Mayor Auxiliar";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/content/TableBuilder.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<link href="~/content/contabilidad/MayorAuxiliar.css" rel="stylesheet" />

<div class="bk-wrap">
    <!-- Filtros -->
    <div class="filter-bar">
        <div class="filter-group" id="group-fecha-inicio">
            <label>Fecha inicio</label>
            <input type="date" id="fecha-inicio">
            <span class="error-msg">Campo obligatorio</span>
        </div>
        <div class="filter-group" id="group-fecha-fin">
            <label>Fecha fin</label>
            <input type="date" id="fecha-fin">
            <span class="error-msg">Campo obligatorio</span>
        </div>
        <div class="filter-divider"></div>
        <div class="filter-group" id="group-cuenta-ini">
            <label>Cuenta inicial</label>
            <input type="text" id="cuenta-ini" value="1" placeholder="ej. 1-01" style="font-family:monospace;font-size:12px">
            <span class="error-msg">Campo obligatorio</span>
        </div>
        <div class="filter-group" id="group-cuenta-fin">
            <label>Cuenta final</label>
            <input type="text" id="cuenta-fin" placeholder="ej. 9-99" style="font-family:monospace;font-size:12px">
            <span class="error-msg">Campo obligatorio</span>
        </div>
        <div class="filter-divider"></div>
        <!-- Toggle: usar .filter-toggle-group para alineación correcta -->
        <div class="filter-toggle-group">
            <span>Cuentas en cero</span>
            <div class="bootstrap-toggle toggle-success">
                <input type="checkbox" id="quitarCero" checked>
                <label for="quitarCero" class="toggle-group">
                    <span class="toggle-on">Ocultar</span>
                    <span class="toggle-handle"></span>
                    <span class="toggle-off">Mostrar</span>
                </label>
            </div>
        </div>
        <div class="filter-divider"></div>
        <!-- Toggle: usar .filter-toggle-group para alineación correcta -->
        <div class="filter-toggle-group">
            <span>Tipo reporte</span>
            <div class="bootstrap-toggle toggle-success">
                <input type="checkbox" id="tipoReporte" checked>
                <label for="tipoReporte" class="toggle-group">
                    <span class="toggle-on">Fecha libre</span>
                    <span class="toggle-handle"></span>
                    <span class="toggle-off">Por año</span>
                </label>
            </div>
        </div>
        <div class="filter-divider"></div>
        <div class="filter-actions">
            <button class="btn" onclick="clearFilters()">Limpiar</button>
            <button class="btn btn-primary" onclick="applyFilters()">Consultar</button>
        </div>
    </div>

    <button class="btn red-500" onclick="exportarPDF()">Exportar a PDF <i class="fa-solid fa-file-pdf"></i></button>
    <button class="btn green-500" onclick="exportarExcel()">Exportar a Excel <i class="fa-solid fa-file-excel"></i></button>

    <!-- Encabezado de columnas -->
    <div class="bk-header">
        <span>Cuenta</span>
        <span>Saldo Inicial</span>
        <span>Cargos</span>
        <span>Abonos</span>
        <span>Saldo Final</span>
    </div>

    <!-- Árbol -->
    <div class="card-wrap">
        <div id="tree">
            <div class="w-100 d-grid justify-content-center text-center p-4">
                <div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="60" height="60" viewBox="0 0 14 14">
                        <path fill="#999999" fill-rule="evenodd" d="M5.5 0a1 1 0 0 0-1 1v.5a1 1 0 0 0 1 1h3a1 1 0 0 0 1-1V1a1 1 0 0 0-1-1zM2.75 1h.5v.5A2.25 2.25 0 0 0 5.5 3.75h3a2.25 2.25 0 0 0 2.25-2.25V1h.5a1.5 1.5 0 0 1 1.5 1.5v10a1.5 1.5 0 0 1-1.5 1.5h-8.5a1.5 1.5 0 0 1-1.5-1.5v-10A1.5 1.5 0 0 1 2.75 1" clip-rule="evenodd" />
                    </svg>
                </div>
                <div class="mt-2 text-center">
                    Da click en "Consultar", para ver los resultados
                </div>
            </div>
        </div>
    </div>
</div>

@*Modal de Detalle*@
