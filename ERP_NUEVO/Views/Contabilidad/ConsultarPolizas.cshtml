    // Función para guardar cambios
    async function guardarEdicion() {
        // Validar balance
        //if (!calcularTotales()) {
        //    alert('Los totales de Debe y Haber no cuadran. Por favor, revisa los montos antes de guardar.');
        //    return;
        //}

        // Validar que haya al menos una partida
        if (partidasEditables.length === 0) {
            toastMixin.fire({
                icon: 'error',
                title: 'Debe haber al menos una partida contable.',
            })
            throw new Error(`Debe haber al menos una partida contable.`)
            return;
        }

        const filas = document.querySelectorAll("#tablaEditPartidas tbody tr");
        partidasEditables.forEach((partida, index) => {
            if (partida.centro === 0 || partida.centro === "0" || partida.centro === "" || !partida.centro) {
                toastMixin.fire({
                    icon: 'error',
                    title: `La fila ${index} tiene el centro de costos vacío`,
                });
                throw new Error(`La fila ${index} tiene el centro de costos vacío`)
                return;
            }

            if (partida.cuenta === 0 || partida.cuenta === "0" || partida.cuenta === "" || !partida.cuenta) {
                toastMixin.fire({
                    icon: 'error',
                    title: `La fila ${index} tiene la cuenta contable vacía`,
                });
                throw new Error(`La fila ${index} tiene la cuenta contable vacía`)
                return;
            }

            if (partida.debe === 0 && partida.haber === 0 || partida.debe === "0" && partida.haber === "0" || partida.debe === "" && partida.haber === "" || !partida.debe && !partida.haber) {
                toastMixin.fire({
                    icon: 'error',
                    title: `La fila ${index} debe tener un valor en "Debe" o "Haber"`,
                });
                throw new Error(`La fila ${index} debe tener un valor en "Debe" o "Haber"`)
                return;
            }

            if (partida.descripcion == "" || !partida.descripcion) {
                toastMixin.fire({
                    icon: 'error',
                    title: `La fila ${index} tiene la descripcion vacia`,
                });
                throw new Error(`La fila ${index} tiene la descripcion vacia`)
                return;
            }
        })

        // Preparar datos para enviar
        const poliza = {
            id: polizaActual.id_poliza,
            estado: document.getElementById('editEstado').value,
            tipo: polizaActual.tipo,
            fecha: document.getElementById('editFecha').value,
            id_encabezado: polizaActual.referencia,
            descripcion: document.getElementById('editDescripcion').value,
            detalles: partidasEditables
        };

        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
            <style>
                .flip {
                    animation: spinY 2s linear infinite;
                    transform-origin: center;
                }
                @@keyframes spinY {
                    0%   { transform: rotateY(0deg); }
                    100% { transform: rotateY(360deg); }
                }
            </style>
            <g class="flip">
                <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                <circle cx="32" cy="48" r="3" fill="#000"/>
            </g>
        </svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: "Confirmar recepción",
            html: `
        <div>
            <p>¿Está seguro que desea proceder con la edicion de la poliza con la referencia ${polizaActual.folio_poliza}?</p>
        </div>
    `,
            footer: "<b style='color: red;'>ADVERTENCIA - Este cambio no se puede revertir</b>",
            customClass: {
                icon: "p-0 bg-transparent border-0 shadow-none"
            },
            preConfirm: () => {
                Swal.fire({
                    title: 'Registrando poliza, esto puede tardar unos minutos...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                GetData({
                    path: '/Contabilidad/EditarPoliza',
                    data: {
                        encabezado_id: polizaActual.referencia,
                        folio: polizaActual.folio_poliza,
                        id_poliza: polizaActual.id_poliza,
                        datosPoliza: JSON.stringify(poliza),
                    },
                    swalResponse: true,
                    swalType: 'modal',
                    swalPath: '/Contabilidad/ConsultarPolizas'
                })
            }
        })
    }
</script>