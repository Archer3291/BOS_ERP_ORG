                //    const totales = response.totales;
                //    document.getElementById('totalPolizas').textContent = totales.totalPolizas;
                //    document.getElementById('totalHaber').textContent = Currency.format(totales.saldosTotales.total_haber);
                //    document.getElementById('totalDebe').textContent = Currency.format(totales.saldosTotales.total_debe);
                //    document.getElementById('montoTotal').textContent = Currency.format(totales.saldosTotales.total_saldo);
                //},
                onLoading: (isLoading) => {
                    document.querySelector('#tablaPolizas').classList.toggle('opacity-50', isLoading);
                },
                onError: (err) => {
                    alert('Error al cargar los datos: ' + err.message);
                }
            },
            data: () => ({
                tipo: document.getElementById('filtroTipo').value,
                estado: document.getElementById('filtroEstado').value,
                fechaInicio: document.getElementById('filtroFechaInicio').value,
                fechaFin: document.getElementById('filtroFechaFin').value,
                saldoMayor: parseFloat(document.getElementById('saldoMayor').value),
                polizasCuadradas: parseInt(document.getElementById('polizasCuadradas').value),
                categoria: parseInt(document.getElementById('filtroCat').value),
            }),
        });

        // Asignar la tabla a una variable global para usarla en guardarEdicion
        window.tablaPolizas = tablaPolizas;

        document.getElementById('btnBuscar').addEventListener('click', () => {
            tablaPolizas.reload();
        });

        document.getElementById('btnLimpiar').addEventListener('click', () => {
