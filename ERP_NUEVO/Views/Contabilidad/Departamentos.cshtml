@{
    ViewBag.Title = "Departamentos";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Departamentos";
}

<script>window.document.title = 'Departamentos'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<link href="~/content/TableBuilder.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn blue-500 mb-3" id="btnAddDepartment">
                    <i class="fa-duotone fa-solid fa-plus"></i> Nuevo Departamento
                </button>
            </div>
        </div>
        <div id="departmentsTable"></div>
    </div>
</div>

<!-- Modal para agregar/editar departamento -->
<div class="modal fade" id="departmentModal" tabindex="-1" aria-labelledby="departmentModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="departmentModalLabel">Registrar Nuevo Departamento</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="departmentForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="action" value="add" />
                    <input type="hidden" id="id" name="id" />

                    <div class="form-outline mb-4">
                        <label class="form-label" for="nombre">Nombre</label>
                        <input type="text" id="nombre" name="nombre" class="form-control form-icon-trailing" maxlength="100" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="descripcion">Descripción</label>
                        <input type="text" id="descripcion" name="descripcion" class="form-control form-icon-trailing" maxlength="255" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="abreviatura">Abreviatura</label>
                        <input type="text" id="abreviatura" name="abreviatura" class="form-control form-icon-trailing" maxlength="10" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                    <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                </button>
                <button type="button" class="btn btn-outline-success" id="btnSaveDepartment">
                    <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/TableBuilder.js"></script>
    <script src="~/Scripts/Contabilidad/departments.js"></script>
}
