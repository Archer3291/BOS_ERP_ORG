@*Codigo completo de packing list*@
@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Packing List";
}
@section styles {

    <link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
    <style>

        .header2 {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            padding: 30px;
        }

            .header2 h1 {
                font-size: 28px;
                margin-bottom: 10px;
            }

        .header2-info {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-top: 20px;
        }

        .info-box {
            background: rgba(255,255,255,0.1);
            padding: 15px;
            border-radius: 8px;
        }

            .info-box label {
                display: block;
                font-size: 12px;
                opacity: 0.9;
                margin-bottom: 5px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .info-box input, .info-box select {
                width: 100%;
                padding: 8px;
                border: none;
                border-radius: 4px;
                font-size: 14px;
            }

        .content {
            padding: 30px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: var(--text-dark);
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid var(--accent-blue);
        }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            margin-bottom: 20px;
        }

        .form-group {
            display: flex;
            flex-direction: column;
        }

            .form-group label {
                font-size: 13px;
                color: var(--text-light);
                margin-bottom: 5px;
                font-weight: 500;
            }

            .form-group input, .form-group select, .form-group textarea {
                padding: 10px;
                border: 1px solid var(--border-light);
                border-radius: 6px;
                font-size: 14px;
                transition: border-color 0.3s;
            }

                .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
                    outline: none;
                    border-color: var(--accent-blue);
                }

        .bultos-container {
            margin-top: 20px;
        }

        .bulto-card {
            background: var(--very-light-blue);
            border: 2px solid var(--border-light);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
        }

        .bulto-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 15px;
        }

        .bulto-number {
            font-size: 16px;
            font-weight: 600;
            color: var(--primary-blue);
        }

        .btn-remove {
            background: var(--danger-color);
            color: white;
            border: none;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.3s;
        }

            .btn-remove:hover {
                background: #b91c1c;
            }

        .items-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            overflow-x: auto;
            display: block;
        }

            .items-table thead {
                background: var(--primary-blue);
                color: white;
            }

            .items-table th, .items-table td {
                padding: 10px;
                text-align: left;
                border: 1px solid var(--border-light);
            }

            .items-table tbody tr:hover {
                background: var(--very-light-blue);
            }

            .items-table input {
                width: 100%;
                padding: 6px;
                border: 1px solid var(--border-light);
                border-radius: 4px;
            }

        .btn-primary {
            background: var(--primary-blue);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
            margin-right: 10px;
        }

            .btn-primary:hover {
                background: var(--primary-blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

        .btn-secondary {
            background: var(--success-color);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
            font-weight: 600;
            transition: all 0.3s;
        }

            .btn-secondary:hover {
                background: #047857;
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

        .actions {
            display: flex;
            gap: 10px;
            margin-top: 30px;
            padding-top: 20px;
            border-top: 2px solid var(--border-light);
        }

        .totales {
            background: var(--light-blue);
            border-left: 4px solid var(--accent-blue);
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
        }

        .totales-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .total-item {
            display: flex;
            flex-direction: column;
        }

            .total-item label {
                font-size: 12px;
                color: var(--text-light);
                margin-bottom: 5px;
            }

            .total-item .value {
                font-size: 20px;
                font-weight: 600;
                color: var(--primary-blue);
            }

        .btn-add-item {
            background: var(--success-color);
            color: white;
            border: none;
            padding: 8px 16px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            margin-top: 10px;
        }

            .btn-add-item:hover {
                background: #047857;
            }


            /* Contenedor de tarimas */
.tarimas-container {
    margin-top: 20px;
}

/* Tarjeta de tarima */
        .tarima-card {
            background: var(--bg-gray);
            border: 3px solid var(--accent-blue);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 30px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

/* Encabezado de tarima */
.tarima-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
    padding-bottom: 15px;
    border-bottom: 3px solid var(--accent-blue);
}

.tarima-number {
    font-size: 20px;
    font-weight: 700;
    color: var(--primary-blue);
    display: flex;
    align-items: center;
    gap: 10px;
}

/* Botón para agregar bulto a tarima */
.btn-add-bulto {
    background: var(--success-color);
    color: white;
    border: none;
    padding: 10px 20px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    margin-right: 10px;
    transition: all 0.3s;
}

.btn-add-bulto:hover {
    background: #047857;
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
}

/* Estadísticas de la tarima */
        .tarima-stats {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 15px;
            background: var(--bg-light);
            padding: 15px;
            border-radius: 8px;
            margin-bottom: 20px;
            border-left: 4px solid var(--accent-blue);
        }

.stat-item {
    display: flex;
    flex-direction: column;
    gap: 5px;
}

.stat-label {
    font-size: 11px;
    color: var(--text-light);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.stat-value {
    font-size: 18px;
    font-weight: 700;
    color: var(--primary-blue);
}

/* Contenedor de bultos dentro de tarima */
.bultos-en-tarima {
    margin-top: 15px;
}

/* Tarjeta de bulto compacta */
        .bulto-card-small {
            background: var(--bg-light);
            border: 2px solid var(--border-light);
            border-radius: 8px;
            padding: 15px;
            transition: all 0.3s;
        }

.bulto-card-small:hover {
    border-color: var(--accent-blue);
    box-shadow: 0 2px 8px rgba(21, 63, 112, 0.15);
}

/* Grid compacto para formularios en bultos */
.form-grid-compact {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
    margin-bottom: 10px;
}

.form-grid-compact .form-group label {
    font-size: 11px;
    margin-bottom: 3px;
}

.form-grid-compact .form-group input,
.form-grid-compact .form-group select {
    padding: 6px;
    font-size: 12px;
}

/* Botón de eliminación pequeño */
.btn-remove-small {
    background: var(--danger-color);
    color: white;
    border: none;
    padding: 4px 8px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 11px;
    transition: background 0.3s;
}

.btn-remove-small:hover {
    background: #b91c1c;
}

/* Tabla de items compacta */
.items-table-compact {
    width: 100%;
    border-collapse: collapse;
    font-size: 11px;
    margin-top: 10px;
}

.items-table-compact thead {
    background: var(--primary-blue);
    color: white;
}

.items-table-compact th,
.items-table-compact td {
    padding: 6px;
    text-align: left;
    border: 1px solid var(--border-light);
}

.items-table-compact tbody tr:hover {
    background: var(--very-light-blue);
}

.items-table-compact input {
    width: 100%;
    padding: 4px;
    border: 1px solid var(--border-light);
    border-radius: 4px;
    font-size: 11px;
}

/* Responsive para tarimas */
@@media (max-width: 768px) {
    .bultos-en-tarima {
        grid-template-columns: 1fr;
    }

    .form-grid-compact {
        grid-template-columns: 1fr;
    }

    .tarima-stats {
        grid-template-columns: repeat(2, 1fr);
    }
}

/* Animación de entrada para tarimas */
@@keyframes slideIn {
    from {
        opacity: 0;
        transform: translateY(-20px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.tarima-card {
    animation: slideIn 0.3s ease-out;
}
    /* Estilos adicionales para botones de impresión */
.btn-secondary {
    background: var(--success-color);
    color: white;
    border: none;
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
    transition: all 0.3s;
    white-space: nowrap;
}

.btn-secondary:hover {
    transform: translateY(-2px);
    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.15);
    opacity: 0.9;
}

/* Botones específicos de tarima */
.tarima-header > div {
    display: flex;
    gap: 5px;
    flex-wrap: wrap;
    align-items: center;
}

/* Botones específicos de bulto */
.bulto-header > div {
    display: flex;
    gap: 3px;
    align-items: center;
}

/* Responsive para botones */
@@media (max-width: 768px) {
    .tarima-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 10px;
    }

    .tarima-header > div {
        width: 100%;
        justify-content: flex-start;
    }

    .btn-secondary {
        font-size: 11px;
        padding: 8px 12px;
    }
}

/* Tooltips para botones (opcional) */
.btn-secondary[title]:hover::after {
    content: attr(title);
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translateX(-50%);
    background: rgba(0, 0, 0, 0.8);
    color: white;
    padding: 5px 10px;
    border-radius: 4px;
    font-size: 11px;
    white-space: nowrap;
    margin-bottom: 5px;
    z-index: 1000;
}
    </style>
}
<form>
    @Html.AntiForgeryToken()
</form>

<div class="header2">
    <h1>📦 Packing List - Lista de Empaque</h1>
    <div class="header2-info">
        <div class="info-box">
            <label>Factura Referencia</label>
            <input type="text" id="facturaRef" placeholder="Serie-Folio" value="A-1234">
        </div>
        <div class="info-box">
            <label>Fecha de Embarque</label>
            <input type="date" id="fechaEmbarque">
        </div>
        <div class="info-box">
            <label>Medio de Transporte</label>
            <select id="medioTransporte">
                <option value="Terrestre">Terrestre</option>
                <option value="Marítimo">Marítimo</option>
                <option value="Aéreo">Aéreo</option>
            </select>
        </div>
    </div>
</div>


<div class="content">
    <!-- SECCIÓN: INFORMACIÓN LOGÍSTICA -->
    <div class="section">
        <div class="section-title">🚢 Información Logística</div>
        <div class="form-grid">
            <div class="form-group">
                <label>Puerto/Lugar de Salida</label>
                <input type="text" id="puertoSalida" placeholder="Ej: Veracruz, México">
            </div>
            <div class="form-group">
                <label>Puerto/Lugar de Destino</label>
                <input type="text" id="puertoDestino" placeholder="Ej: Houston, USA">
            </div>
            <div class="form-group">
                <label>Incoterm</label>
                <select id="incoterm">
                    <option value="">Seleccionar...</option>
                    <option value="FOB">FOB - Free On Board</option>
                    <option value="CIF">CIF - Cost, Insurance and Freight</option>
                    <option selected value="EXW">EXW - Ex Works</option>
                    <option value="FCA">FCA - Free Carrier</option>
                    <option value="DAP">DAP - Delivered At Place</option>
                    <option value="DDP">DDP - Delivered Duty Paid</option>
                </select>
            </div>
            <div class="form-group">
                <label>No. Contenedor (opcional)</label>
                <input type="text" id="numContenedor" placeholder="ABCD1234567">
            </div>
            <div class="form-group">
                <label>Numero Orden Cliente</label>
                <input type="text" id="numSello" placeholder="SEAL123456">
            </div>
        </div>
    </div>

    <!-- SECCIÓN: CONSIGNATARIO -->
    <div class="section">
        <div class="section-title">👤 Consignatario / Destinatario</div>
        <div class="form-grid">
            <div class="form-group">
                <label>Nombre/Razón Social</label>
                <input type="text" id="consignatarioNombre" placeholder="Nombre del consignatario">
            </div>
            <div class="form-group">
                <label>Calle</label>
                <input type="text" id="consignatarioCalle" placeholder="Calle">
            </div>
            <div class="form-group">
                <label>Num. Exterior</label>
                <input type="text" id="consignatarioNExterior" placeholder="Num. Exterior">
            </div>
            <div class="form-group">
                <label>Num Interior</label>
                <input type="text" id="consignatarioNInterior" placeholder="Num Interior">
            </div>
            <div class="form-group">
                <label>Colonia</label>
                <input type="text" id="consignatarioColonia" placeholder="Colonia">
            </div>
            <div class="form-group">
                <label>Codigo Postal</label>
                <input type="text" id="consignatarioCP" placeholder="Codigo Postal">
            </div>
            <div class="form-group">
                <label>Estado</label>
                <input type="text" id="consignatarioEstado" placeholder="Estado">
            </div>
            <div class="form-group">
                <label>País</label>
                <input type="text" id="consignatarioPais" placeholder="País">
            </div>
        </div>
    </div>

    <!-- SECCIÓN: BULTOS -->
    <div class="section">
        <div class="section-title">🎯 Tarimas y Bultos</div>
        <p style="color: var(--text-light); margin-bottom: 15px;">
            Organiza tus bultos en tarimas. Cada tarima puede contener múltiples bultos, y cada bulto contiene los productos.
        </p>
        <button class="btn-primary" onclick="agregarTarima()">+ Agregar Tarima</button>

        <div class="tarimas-container" id="tarimasContainer">
            <!-- Las tarimas se agregarán aquí dinámicamente -->
        </div>
    </div>


    <!-- TOTALES -->
    <div class="totales">
        <div class="section-title">📊 Totales Generales</div>
        <div class="totales-grid">
            <div class="total-item">
                <label>Total de Bultos</label>
                <div class="value" id="totalBultos">0</div>
            </div>
            <div class="total-item">
                <label>Peso Neto Total (gr)</label>
                <div class="value" id="totalPesoNeto">0.00</div>
            </div>
            <div class="total-item">
                <label>Peso Bruto Total (gr)</label>
                <div class="value" id="totalPesoBruto">0.00</div>
            </div>
            <div class="total-item">
                <label>Volumen Total (m³)</label>
                <div class="value" id="totalVolumen">0.000</div>
            </div>
        </div>
    </div>

    <!-- OBSERVACIONES -->
    <div class="section">
        <div class="section-title">📝 Observaciones</div>
        <textarea id="observaciones" rows="3" style="width: 100%; padding: 10px; border: 1px solid var(--border-light); border-radius: 6px;" placeholder="Instrucciones especiales, notas de manejo, etc."></textarea>
    </div>

    <!-- ACCIONES -->
    <div class="actions">
        <button class="btn-primary" id="btnGuardar" onclick="guardarPackingList(this)">💾 Guardar</button>
        @*<button class="btn-secondary" onclick="generarPDF()">📄 Generar PDF</button>*@
        @*<button class="btn-primary" onclick="exportarJSON()">📥 Exportar JSON</button>*@
    </div>
</div>


<!-- 🔹 Modal Selección de Productos -->
<div class="modal fade" id="modalSeleccionPartidas" tabindex="-1" aria-labelledby="modalSeleccionPartidasLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar productos para el bulto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- 🔍 Campo de búsqueda -->
                <div class="mb-3">
                    <input type="text"
                           class="form-control"
                           id="buscarPartida"
                           placeholder="🔍 Buscar por SKU, descripción o fracción arancelaria...">
                </div>

                <table class="table table-sm table-hover" id="tablaPartidasDisponibles">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 40px;">
                                <input type="checkbox"
                                       id="checkTodos"
                                       title="Seleccionar todos"
                                       onchange="toggleTodos(this)">
                            </th>
                            <th>SKU</th>
                            <th>Descripción</th>
                            <th>Cantidad</th>
                            <th>Unidad</th>
                            <th>Peso Unit.</th>
                            <th>Fracción</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>

                <!-- Mensaje cuando no hay resultados -->
                <div id="noResultados" class="text-center text-muted py-3" style="display: none;">
                    No se encontraron productos que coincidan con la búsqueda
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnAgregarSeleccion">Agregar al Bulto</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/content/BrowserPrint.js-3.1.250/BrowserPrint-3.1.250.min.js"></script>

    <script>

        const consultaBaseUrl = '@Url.Action("ConsultarPackingList", "Operaciones", null, Context.Request.Scheme)';
        BrowserPrint.getDefaultDevice("printer", function (printer) {
            console.log("Impresora detectada:", printer.name);
        }, function (err) {
            alert("No se encontró impresora Zebra");
        });

        function imprimirZebra(zpl) {
            BrowserPrint.getDefaultDevice("printer", function (printer) {
                console.log(printer)
                printer.send(
                    zpl,
                    () => console.log("Impresión exitosa"),
                    err => console.error("Error:", err)
                );
            });
        }
        // ============================================
        // SCRIPT COMPLETO PACKING LIST - CORREGIDO
        // ============================================

        let bultoCounter = 0;
        let tarimaCounter = 0;
        let partidasFactura = [];
        let partidasAsignadas = [];
        let bultos = [];
        let tarimas = []; // Nueva estructura para tarimas
        let tomManager;
        let partidasDisponiblesActuales = [];
        let bultoSeleccionado = null;
        let modalInstance = null;

        // ============================================
        // INICIALIZACIÓN
        // ============================================

        // Configurar eventos una sola vez al cargar
        document.addEventListener('DOMContentLoaded', function () {
            console.log('🚀 Inicializando Packing List con Tarimas...');

            const fechaInput = document.getElementById('fechaEmbarque');
            if (fechaInput) {
                fechaInput.valueAsDate = new Date();
            }

            const btnAgregar = document.getElementById('btnAgregarSeleccion');
            if (btnAgregar) {
                btnAgregar.addEventListener('click', agregarSeleccionAlBulto);
            }

            const inputBuscar = document.getElementById('buscarPartida');
            if (inputBuscar) {
                inputBuscar.addEventListener('input', filtrarPartidas);
            }
        });

        // Cargar datos iniciales (TomSelect y facturas)
        GetData({
            path: '/PackingList/DatosSelect',
        }).then((_res) => {
            tomManager = new TomSelectManager();
            const facturas = _res.facturas;

            tomManager.create('#facturaRef', {
                selector: '#facturaRef',
                options: facturas,
                valueField: 'id',
                displayField: 'nombre',
                searchField: ['id', 'nombre'],
                placeholder: 'Seleccione una factura...',
                maxItems: 1,
                create: false,
                render: {
                    option: (data, escape) =>
                        `<div>${escape(data.nombre)} (ID: ${escape(data.id)})</div>`,
                    item: (data, escape) =>
                        `<div>${escape(data.nombre)}</div>`
                },
                onChange: (value) => {
                    if (value) {
                        cargarFactura(value);
                    }
                }
            });
        }).catch(error => {
            console.error('❌ Error al cargar facturas:', error);
        });

        // ============================================
        // CARGA DE FACTURA
        // ============================================

        async function cargarFactura(idFactura) {
            try {
                console.log('📥 Cargando factura:', idFactura);
                const response = await fetch(`/PackingList/BuscarDocumento?id=${idFactura}`);
                const data = await response.json();

                if (!data || !data.length) {
                    alert("No se encontró información para esta factura.");
                    return;
                }

                const encabezado = data[0];

                document.querySelector('#facturaRef').value = encabezado.factura_ref || '';
                document.querySelector('#observaciones').value = encabezado.observaciones || '';
                document.querySelector('#consignatarioNombre').value = encabezado.nombre_cliente || '';
                document.querySelector('#consignatarioCalle').value = encabezado.dir || '';
