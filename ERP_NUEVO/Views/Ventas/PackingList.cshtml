                                startY: yPos,
                                head: [['SKU', 'DESCRIPCIÓN', 'CANT.', 'UNIDAD', 'FRACCIÓN ARANCELARIA']],
                                body: bulto.items.map(item => [
                                    item.sku || 'N/A',
