            const fecha = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: '2-digit' });

            // Calcular totales de la tarima
            let totalBultos = tarima.bultos.length;
            let totalPesoNeto = 0;
            let totalPesoBruto = 0;
            let totalVolumen = 0;
            let totalItems = 0;

            tarima.bultos.forEach(bulto => {
                totalPesoNeto += parseFloat(bulto.pesoNeto) || 0;
