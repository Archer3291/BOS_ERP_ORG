        function agregarItem(bultoId, tarimaId) {
            console.log('🔍 Abriendo modal para bulto:', bultoId, 'en tarima:', tarimaId);
            bultoSeleccionado = { bultoId, tarimaId };

            if (partidasFactura.length === 0) {
                alert('⚠️ Primero debes seleccionar una factura');
                return;
            }

            partidasDisponiblesActuales = partidasFactura.filter(p => !partidasAsignadas.includes(p.id));

            if (partidasDisponiblesActuales.length === 0) {
                alert('⚠️ No hay productos disponibles');
                return;
            }

            const inputBuscar = document.getElementById('buscarPartida');
            if (inputBuscar) inputBuscar.value = '';

            const checkMaestro = document.getElementById('checkTodos');
            if (checkMaestro) {
                checkMaestro.checked = false;
                checkMaestro.indeterminate = false;
            }

            renderizarPartidas(partidasDisponiblesActuales);

            const modalElement = document.getElementById('modalSeleccionPartidas');
            if (modalElement) {
                if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                    modalInstance = new bootstrap.Modal(modalElement);
                    modalInstance.show();
                } else if (typeof $ !== 'undefined' && $.fn.modal) {
                    $(modalElement).modal('show');
                }
            }
        }

        function filtrarPartidas(e) {
            const textoBusqueda = e.target.value.toLowerCase().trim();

            if (textoBusqueda === '') {
                renderizarPartidas(partidasDisponiblesActuales);
            } else {
                const resultados = partidasDisponiblesActuales.filter(p => {
                    return (
                        p.sku.toLowerCase().includes(textoBusqueda) ||
                        p.descripcion.toLowerCase().includes(textoBusqueda) ||
                        p.fraccion.toLowerCase().includes(textoBusqueda)
                    );
                });
                renderizarPartidas(resultados);
            }
        }


        function renderizarPartidas(partidas) {
            const tbody = document.querySelector('#tablaPartidasDisponibles tbody');
            const tabla = document.getElementById('tablaPartidasDisponibles');
            const noResultados = document.getElementById('noResultados');

            if (!tbody) return;

            tbody.innerHTML = "";

            if (partidas.length === 0) {
                if (tabla) tabla.style.display = 'none';
                if (noResultados) noResultados.style.display = 'block';
            } else {
                if (tabla) tabla.style.display = '';
                if (noResultados) noResultados.style.display = 'none';

                partidas.forEach(p => {
                    const peso = p.peso || 0;
                    tbody.insertAdjacentHTML('beforeend', `
                <tr>
                    <td><input type="checkbox" value="${p.id}" class="partida-checkbox"></td>
                    <td>${p.sku}</td>
                    <td>${p.descripcion}</td>
                    <td>${p.cantidad}</td>
                    <td>${p.unidad}</td>
                    <td>${peso.toFixed(3)} gr</td>
                    <td>${p.fraccion}</td>
                </tr>
            `);
                    tbody.querySelectorAll('input[type="checkbox"]').forEach(chk => {
                        chk.addEventListener('change', () => {
                            const todos = tbody.querySelectorAll('input[type="checkbox"]');
                            const checkeados = tbody.querySelectorAll('input[type="checkbox"]:checked');
                            const checkMaestro = document.getElementById('checkTodos');
                            if (checkMaestro) {
                                checkMaestro.checked = todos.length === checkeados.length;
                                checkMaestro.indeterminate = checkeados.length > 0 && checkeados.length < todos.length;
                            }
                        });
                    });
                });
            }
        }

        function agregarSeleccionAlBulto() {
            if (!bultoSeleccionado) return;

            const checkboxes = document.querySelectorAll('#tablaPartidasDisponibles tbody input[type="checkbox"]:checked');

            if (checkboxes.length === 0) {
                alert('⚠️ Selecciona al menos un producto');
                return;
            }

            const { bultoId, tarimaId } = bultoSeleccionado;
            const tarima = tarimas.find(t => t.id === tarimaId);
            if (!tarima) return;

            const bulto = tarima.bultos.find(b => b.id === bultoId);
            if (!bulto) return;

            checkboxes.forEach(chk => {
                const partidaId = parseInt(chk.value);
                const partida = partidasFactura.find(p => p.id === partidaId);

                if (partida && !partidasAsignadas.includes(partidaId)) {
                    partidasAsignadas.push(partidaId);
                    bulto.items.push(partida);
                    agregarItemATabla(bultoId, partida);
                }
            });

            actualizarPesoNetoBulto(bultoId, tarimaId);
            cerrarModal();
        }

        function cerrarModal() {
            const modalElement = document.getElementById('modalSeleccionPartidas');

            if (modalInstance) {
                modalInstance.hide();
            } else if (typeof bootstrap !== 'undefined' && bootstrap.Modal) {
                const modal = bootstrap.Modal.getInstance(modalElement);
                if (modal) modal.hide();
            } else if (typeof $ !== 'undefined' && $.fn.modal) {
                $(modalElement).modal('hide');
            }

            setTimeout(() => {
                const backdrop = document.querySelector('.modal-backdrop');
                if (backdrop) backdrop.remove();
                document.body.classList.remove('modal-open');
                document.body.style.removeProperty('padding-right');
            }, 300);
        }

        function agregarItemATabla(bultoId, item) {
            const tbody = document.querySelector(`#${bultoId}-items tbody`);
            if (!tbody) return;

            const itemId = `item-${item.id}`;
            if (document.getElementById(itemId)) return;

            const pesoUnitario = item.peso || 0;
            const pesoInput = pesoUnitario === 0
                ? `<input type="number" step="0.001" min="0" value="0"
            style="width: 100%; padding: 4px; border: 1px solid var(--accent-blue); background: #fffbcc;"
            onchange="actualizarPesoItem('${bultoId}', ${item.id}, this.value)"
            placeholder="Ingrese peso">`
                : pesoUnitario.toFixed(3);

            // Obtener tarimaId buscando en el array
            let tarimaId = null;
            for (let t of tarimas) {
                if (t.bultos.find(b => b.id === bultoId)) {
                    tarimaId = t.id;
                    break;
                }
            }

            const html = `
        <tr id="${itemId}">
            <td>${item.sku}</td>
            <td>${item.descripcion}</td>
            <td>${item.cantidad}</td>
            <td>${item.unidad}</td>
            <td id="${itemId}-peso-unit">${pesoInput}</td>
            <td style="white-space:nowrap;">
                <button class="btn-secondary"
                    style="padding:3px 7px; font-size:11px; background:#059669; margin-right:2px;"
                    title="Vista previa ZPL del producto"
                    onclick="vistaPreviewZPLProducto(${item.id}, '${bultoId}', '${tarimaId}')">
                    👁️
                </button>
                <button class="btn-secondary"
                    style="padding:3px 7px; font-size:11px; background:#7c3aed;"
                    title="Imprimir etiqueta de producto"
                    onclick="imprimirEtiquetaProducto(${item.id}, '${bultoId}', '${tarimaId}')">
                    🏷️
                </button>
            </td>
            <td>
                <button class="btn-remove-small"
                    onclick="eliminarItem('${bultoId}', ${item.id})"
                    style="padding:4px 8px;">🗑️</button>
            </td>
        </tr>
    `;

            tbody.insertAdjacentHTML('beforeend', html);
        }

        function actualizarPesoItem(bultoId, itemId, nuevoPeso) {
            let bulto = null;
            let tarimaId = null;

            for (let tarima of tarimas) {
                const foundBulto = tarima.bultos.find(b => b.id === bultoId);
                if (foundBulto) {
                    bulto = foundBulto;
                    tarimaId = tarima.id;
                    break;
                }
            }

            if (!bulto) return;

            const item = bulto.items.find(i => i.id === itemId);
            if (item) {
                item.peso = parseFloat(nuevoPeso) || 0;
                actualizarPesoNetoBulto(bultoId, tarimaId);
            }
        }

        function actualizarPesoNetoBulto(bultoId, tarimaId) {
            const tarima = tarimas.find(t => t.id === tarimaId);
            if (!tarima) return;

            const bulto = tarima.bultos.find(b => b.id === bultoId);
            if (!bulto) return;

            let pesoNetoTotal = 0;
            bulto.items.forEach(item => {
                const peso = parseFloat(item.peso) || 0;
                const cantidad = parseFloat(item.cantidad) || 0;
                pesoNetoTotal += peso * cantidad;
            });

            bulto.pesoNeto = pesoNetoTotal;

            // Actualizar el input visual
            const pesoNetoInput = document.getElementById(`${bultoId}-peso-neto-input`);
            if (pesoNetoInput) {
                pesoNetoInput.value = pesoNetoTotal.toFixed(2);
            }

            console.log(`⚖️ Peso neto calculado automáticamente para bulto ${bultoId}:`, pesoNetoTotal.toFixed(2));

            actualizarEstadisticasTarima(tarimaId);
            calcularTotales();
        }

        function eliminarItem(bultoId, itemId) {
            if (!confirm('¿Eliminar este producto?')) return;

            let tarima = null;
            let bulto = null;

            for (let t of tarimas) {
                const b = t.bultos.find(b => b.id === bultoId);
                if (b) {
                    tarima = t;
                    bulto = b;
                    break;
                }
            }

            if (!bulto) return;

            bulto.items = bulto.items.filter(i => i.id !== itemId);
            partidasAsignadas = partidasAsignadas.filter(id => id !== itemId);

            const itemElement = document.querySelector(`#${bultoId}-items tbody #item-${itemId}`);
            if (itemElement) itemElement.remove();

            actualizarPesoNetoBulto(bultoId, tarima.id);
        }

        // ============================================
        // CÁLCULOS Y TOTALES
        // ============================================

        function calcularTotales() {
            let totalBultos = 0;
            let totalPesoNeto = 0;
            let totalPesoBruto = 0;
            let totalVolumen = 0;

            tarimas.forEach(tarima => {
                tarima.bultos.forEach(bulto => {
                    totalBultos++;
                    totalPesoNeto += parseFloat(bulto.pesoNeto) || 0;
                    totalPesoBruto += parseFloat(bulto.pesoBruto) || 0;

                    const largo = parseFloat(bulto.largo) || 0;
                    const ancho = parseFloat(bulto.ancho) || 0;
                    const alto = parseFloat(bulto.alto) || 0;
                    totalVolumen += (largo * ancho * alto);
                });
            });

            // Actualizar display de totales generales
            const elemTotalBultos = document.getElementById('totalBultos');
            const elemTotalPesoNeto = document.getElementById('totalPesoNeto');
            const elemTotalPesoBruto = document.getElementById('totalPesoBruto');
            const elemTotalVolumen = document.getElementById('totalVolumen');

            if (elemTotalBultos) elemTotalBultos.textContent = totalBultos;
            if (elemTotalPesoNeto) elemTotalPesoNeto.textContent = totalPesoNeto.toFixed(2);
            if (elemTotalPesoBruto) elemTotalPesoBruto.textContent = totalPesoBruto.toFixed(2);
            if (elemTotalVolumen) elemTotalVolumen.textContent = totalVolumen.toFixed(3);

            console.log(`📊 Totales generales actualizados:`, {
                bultos: totalBultos,
                pesoNeto: totalPesoNeto.toFixed(2),
                pesoBruto: totalPesoBruto.toFixed(2),
                volumen: totalVolumen.toFixed(3)
            });
        }

        // ============================================
        // RECOLECCIÓN Y EXPORTACIÓN DE DATOS
        // ============================================

        function recolectarDatos() {
            const facturaReSelect = tomManager.getInstance('#facturaRef');
            const facturaReValue = facturaReSelect?.getValue();
            const facturaReText = facturaReSelect?.getItem(facturaReValue)?.textContent;

            const data = {
                facturaReferencia: facturaReValue || '',
                facturaReferenciaTexto: facturaReText || '',
                fechaEmbarque: document.getElementById('fechaEmbarque')?.value || '',
                medioTransporte: document.getElementById('medioTransporte')?.value || '',
                puertoSalida: document.getElementById('puertoSalida')?.value || '',
                puertoDestino: document.getElementById('puertoDestino')?.value || '',
                incoterm: document.getElementById('incoterm')?.value || '',
                numeroContenedor: document.getElementById('numContenedor')?.value || '',
                ODCComprador: document.getElementById('numSello')?.value || '',
                consignatario: {
                    nombre: document.getElementById('consignatarioNombre')?.value || '',
                    calle: document.getElementById('consignatarioCalle')?.value || '',
                    nexterior: document.getElementById('consignatarioNExterior')?.value || '',
                    ninterior: document.getElementById('consignatarioNInterior')?.value || '',
                    colonia: document.getElementById('consignatarioColonia')?.value || '',
                    cp: document.getElementById('consignatarioCP')?.value || '',
                    estado: document.getElementById('consignatarioEstado')?.value || '',
                    pais: document.getElementById('consignatarioPais')?.value || ''
                },
                observaciones: document.getElementById('observaciones')?.value || '',
                tarimas: []
            };

            tarimas.forEach(tarima => {
                const tarimaData = {
                    numero: tarima.numero,
                    descripcion: tarima.descripcion,
                    bultos: []
                };

                tarima.bultos.forEach(bulto => {
                    tarimaData.bultos.push({
                        numero: bulto.numero,
                        tipoEmbalaje: bulto.tipoEmbalaje,
                        marca: bulto.marca,
                        dimensiones: {
                            largo: bulto.largo,
                            ancho: bulto.ancho,
                            alto: bulto.alto,
                            volumen: bulto.largo * bulto.ancho * bulto.alto
                        },
                        pesoNeto: bulto.pesoNeto,
                        pesoBruto: bulto.pesoBruto,
                        items: bulto.items.map(item => ({
                            ...item,
                            pesoUnitario: item.peso || 0,
                            pesoTotal: (item.peso || 0) * (item.cantidad || 0)
                        }))
                    });
                });

                data.tarimas.push(tarimaData);
            });

            return data;
        }

        // ============================================
        // VALIDACIONES
        // ============================================

        function validarDatosPackingList(data) {
            const errores = [];

            // Validar factura referencia
            if (!data.facturaReferencia || data.facturaReferencia.trim() === '') {
                errores.push('❌ Debe seleccionar una factura de referencia');
            }

            // Validar fecha de embarque
            if (!data.fechaEmbarque || data.fechaEmbarque.trim() === '') {
                errores.push('❌ Debe ingresar la fecha de embarque');
            }

            // Validar información logística básica
            if (!data.puertoSalida || data.puertoSalida.trim() === '') {
                errores.push('❌ Debe ingresar el puerto/lugar de salida');
            }

            if (!data.puertoDestino || data.puertoDestino.trim() === '') {
                errores.push('❌ Debe ingresar el puerto/lugar de destino');
            }

            if (!data.incoterm || data.incoterm.trim() === '') {
                errores.push('❌ Debe seleccionar un Incoterm');
            }

            // Validar consignatario
            if (!data.consignatario.nombre || data.consignatario.nombre.trim() === '') {
                errores.push('❌ Debe ingresar el nombre del consignatario');
            }

            if (!data.consignatario.calle || data.consignatario.calle.trim() === '') {
                errores.push('❌ Debe ingresar la calle del consignatario');
            }

            if (!data.consignatario.cp || data.consignatario.cp.trim() === '') {
                errores.push('❌ Debe ingresar el código postal del consignatario');
            }

            if (!data.consignatario.estado || data.consignatario.estado.trim() === '') {
                errores.push('❌ Debe ingresar el estado del consignatario');
            }

            if (!data.consignatario.pais || data.consignatario.pais.trim() === '') {
                errores.push('❌ Debe ingresar el país del consignatario');
            }

            // Validar que existan bultos
            if (!data.bultos || data.bultos.length === 0) {
                errores.push('❌ Debe agregar al menos un bulto');
            } else {
                // Validar cada bulto
                data.bultos.forEach((bulto, index) => {
                    const numBulto = index + 1;

                    // Validar que el bulto tenga items
                    if (!bulto.items || bulto.items.length === 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener al menos un producto`);
                    }

                    // Validar dimensiones
                    if (bulto.dimensiones.largo <= 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener un largo mayor a 0`);
                    }

                    if (bulto.dimensiones.ancho <= 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener un ancho mayor a 0`);
                    }

                    if (bulto.dimensiones.alto <= 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener un alto mayor a 0`);
                    }

                    // Validar pesos
                    if (bulto.pesoNeto <= 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener un peso neto mayor a 0`);
                    }

                    if (bulto.pesoBruto <= 0) {
                        errores.push(`❌ El Bulto #${numBulto} debe tener un peso bruto mayor a 0`);
                    }

                    // Validar que peso bruto sea mayor o igual al neto
                    if (bulto.pesoBruto < bulto.pesoNeto) {
                        errores.push(`❌ El Bulto #${numBulto}: el peso bruto debe ser mayor o igual al peso neto`);
                    }

                    // Validar marca/identificación
                    if (!bulto.marca || bulto.marca.trim() === '') {
                        errores.push(`❌ El Bulto #${numBulto} debe tener una marca/identificación`);
                    }
                });
            }

            return errores;
        }

        function mostrarErroresValidacion(errores) {
            const mensajeHTML = `
                                <div style="text-align: left; max-height: 400px; overflow-y: auto;">
                                    <h4 style="color: #dc2626; margin-bottom: 15px;">⚠️ Se encontraron los siguientes errores:</h4>
                                    <ul style="list-style: none; padding: 0; margin: 0;">
                                        ${errores.map(error => `
                                            <li style="padding: 8px; margin-bottom: 5px; background: #fee; border-left: 3px solid #dc2626; border-radius: 4px;">
                                                ${error}
                                            </li>
                                        `).join('')}
                                    </ul>
                                </div>
                            `;

            // Si tienes SweetAlert2 o similar
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'error',
                    title: 'Errores de validación',
                    html: mensajeHTML,
                    confirmButtonText: 'Entendido',
                    width: '600px'
                });
            } else {
                // Fallback a alert nativo
                alert('ERRORES DE VALIDACIÓN:\n\n' + errores.join('\n'));
            }
        }

        // ============================================
        // GUARDAR PACKING LIST
        // ============================================

        async function guardarPackingList(btn) {
            if (btn?.disabled) return;
            try {
                if (btn) {
                    btn.disabled = true;
                    btn.textContent = '⏳ Guardando...';
                }
                const data = recolectarDatos();
                console.log('💾 Datos del Packing List:', data);

                // Validación básica
                if (!data.facturaReferencia || tarimas.length === 0) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Información Incompleta',
                        text: 'Debe completar la información básica y agregar al menos una tarima con bultos',
                        confirmButtonColor: '#0891b2'
                    });
                    return;
                }

                // Validar dimensiones y pesos de todos los bultos
                const erroresDimensiones = [];

                data.tarimas.forEach((tarima, tarimaIndex) => {
                    tarima.bultos.forEach((bulto, bultoIndex) => {
                        const erroresBulto = [];

                        // Validar dimensiones
                        if (!bulto.dimensiones.largo || bulto.dimensiones.largo <= 0) {
                            erroresBulto.push('Largo debe ser mayor a 0');
                        }
                        if (!bulto.dimensiones.ancho || bulto.dimensiones.ancho <= 0) {
                            erroresBulto.push('Ancho debe ser mayor a 0');
                        }
                        if (!bulto.dimensiones.alto || bulto.dimensiones.alto <= 0) {
                            erroresBulto.push('Alto debe ser mayor a 0');
                        }

                        // Validar pesos
                        if (!bulto.pesoNeto || bulto.pesoNeto <= 0) {
                            erroresBulto.push('Peso Neto debe ser mayor a 0');
                        }
                        if (!bulto.pesoBruto || bulto.pesoBruto <= 0) {
                            erroresBulto.push('Peso Bruto debe ser mayor a 0');
                        }

                        // Validar que peso bruto >= peso neto
                        if (bulto.pesoBruto < bulto.pesoNeto) {
                            erroresBulto.push('Peso Bruto debe ser mayor o igual al Peso Neto');
                        }

                        if (erroresBulto.length > 0) {
                            erroresDimensiones.push({
                                tarima: tarima.descripcion || `TARIMA ${tarima.numero}`,
                                bulto: `Bulto #${bulto.numero}`,
                                errores: erroresBulto
                            });
                        }
                    });
                });

                // Si hay errores de dimensiones/pesos, mostrarlos
                if (erroresDimensiones.length > 0) {
                    let listaErrores = erroresDimensiones.map(e => `
                <div style="background: #fee; border-left: 4px solid #dc2626; padding: 10px; margin-bottom: 10px; border-radius: 4px; text-align: left;">
                    <p style="margin: 0 0 5px 0; font-weight: 600; color: #991b1b;">
                        ${e.tarima} - ${e.bulto}
                    </p>
                    <ul style="margin: 0; padding-left: 20px; font-size: 13px;">
                        ${e.errores.map(err => `<li>${err}</li>`).join('')}
                    </ul>
                </div>
            `).join('');

                    Swal.fire({
                        icon: 'error',
                        title: 'Dimensiones y Pesos Incompletos',
                        html: `
                    <p style="margin-bottom: 15px;">
                        Se encontraron <strong>${erroresDimensiones.length}</strong> bulto(s) con información incompleta o incorrecta.
                    </p>
                    <div style="max-height: 400px; overflow-y: auto;">
                        ${listaErrores}
                    </div>
                    <div style="background: #dbeafe; border-left: 4px solid #3b82f6; padding: 10px; border-radius: 4px; margin-top: 15px;">
                        <p style="margin: 0; font-size: 13px; color: #1e40af;">
                            💡 <strong>Nota:</strong> Todos los bultos deben tener dimensiones (largo, ancho, alto) y pesos (neto y bruto) mayores a 0. El peso bruto debe ser mayor o igual al peso neto.
                        </p>
                    </div>
                `,
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#dc2626',
                        width: '700px'
                    });
                    return;
                }

                // Validar que todas las partidas estén asignadas
                const totalPartidasFactura = partidasFactura.length;
                const partidasAsignadasCount = partidasAsignadas.length;

                if (partidasAsignadasCount < totalPartidasFactura) {
                    const partidasFaltantes = totalPartidasFactura - partidasAsignadasCount;
                    const partidasNoAsignadas = partidasFactura.filter(p => !partidasAsignadas.includes(p.id));

                    let listaFaltantes = partidasNoAsignadas.slice(0, 5).map(p =>
                        `<li style="text-align: left; padding: 5px;">${p.sku} - ${p.descripcion}</li>`
                    ).join('');

                    if (partidasNoAsignadas.length > 5) {
                        listaFaltantes += `<li style="text-align: left; padding: 5px; color: #666;">... y ${partidasNoAsignadas.length - 5} más</li>`;
                    }

                    Swal.fire({
                        icon: 'error',
                        title: 'Partidas sin Asignar',
                        html: `
                    <p style="margin-bottom: 15px;">
                        Hay <strong>${partidasFaltantes}</strong> producto(s) de la factura que no han sido asignados a ningún bulto.
                    </p>
                    <div style="background: #fee; border-left: 4px solid #dc2626; padding: 10px; border-radius: 4px; margin-bottom: 15px;">
                        <p style="margin: 0; font-size: 13px; color: #991b1b;">
                            ⚠️ Todas las partidas de la factura deben estar asignadas antes de guardar.
                        </p>
                    </div>
                    <div style="max-height: 200px; overflow-y: auto; text-align: left; background: #f9fafb; padding: 10px; border-radius: 4px;">
                        <p style="font-weight: 600; margin-bottom: 8px;">Productos sin asignar:</p>
                        <ul style="margin: 0; padding-left: 20px;">
                            ${listaFaltantes}
                        </ul>
                    </div>
                `,
                        confirmButtonText: 'Entendido',
                        confirmButtonColor: '#dc2626',
                        width: '600px'
                    });
                    return;
                }

                // Confirmación
                const totalBultos = data.tarimas.reduce((sum, t) => sum + t.bultos.length, 0);
                const totalVolumen = data.tarimas.reduce((sum, t) =>
                    sum + t.bultos.reduce((sumB, b) => sumB + (b.dimensiones.volumen || 0), 0), 0
                );
                const totalPesoNeto = data.tarimas.reduce((sum, t) =>
                    sum + t.bultos.reduce((sumB, b) => sumB + (b.pesoNeto || 0), 0), 0
                );
                const totalPesoBruto = data.tarimas.reduce((sum, t) =>
                    sum + t.bultos.reduce((sumB, b) => sumB + (b.pesoBruto || 0), 0), 0
                );

                const resultadoConfirm = await Swal.fire({
                    icon: 'question',
                    title: '¿Guardar el Packing List?',
                    html: `
                <div style="text-align: left; padding: 10px;">
                    <p><strong>Factura:</strong> ${data.facturaReferencia}</p>
                    <p><strong>Tarimas:</strong> ${data.tarimas.length}</p>
                    <p><strong>Total Bultos:</strong> ${totalBultos}</p>
                    <p><strong>Productos Asignados:</strong> ${partidasAsignadasCount} de ${totalPartidasFactura}</p>
                    <hr style="margin: 10px 0; border: none; border-top: 1px solid #e5e7eb;">
                    <p><strong>Volumen Total:</strong> ${totalVolumen.toFixed(3)} m³</p>
                    <p><strong>Peso Neto Total:</strong> ${totalPesoNeto.toFixed(2)} gr</p>
                    <p><strong>Peso Bruto Total:</strong> ${totalPesoBruto.toFixed(2)} gr</p>
                </div>
            `,
                    showCancelButton: true,
                    confirmButtonText: '💾 Guardar',
                    confirmButtonColor: '#0891b2',
                    cancelButtonText: 'Cancelar',
                    cancelButtonColor: '#6b7280',
                    width: '500px'
                });

                if (!resultadoConfirm.isConfirmed) return;

                const btnGuardar = event?.target;
                const textoOriginal = btnGuardar?.textContent;
                if (btnGuardar) {
                    btnGuardar.disabled = true;
                    btnGuardar.textContent = '⏳ Guardando...';
                }

                const formData = new FormData();
                formData.append("data", JSON.stringify(data));
                const tokenDirector = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (tokenDirector) {
                    formData.append('__RequestVerificationToken', tokenDirector);
                }

                const response = await fetch('/PackingList/GuardarPackingList', {
                    method: 'POST',
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Error del servidor: ${response.status}`);
                }

                const resultado = await response.json();
                console.log('✅ Respuesta del servidor:', resultado);

                if (resultado.success) {
                    const resultadoSwal = await Swal.fire({
                        icon: 'success',
                        title: '¡Guardado exitoso!',
                        html: `
            <p>Packing List guardado correctamente.</p>
            <p><strong>ID:</strong> ${resultado.folio || 'N/A'}</p>
        `,
                        showDenyButton: true,
                        showCancelButton: true,
                        confirmButtonText: '📄 Descargar PDF',
                        confirmButtonColor: '#059669',
                        denyButtonText: '🖨️ Imprimir Etiquetas',
                        denyButtonColor: '#0891b2',
                        cancelButtonText: 'Cerrar',
                        cancelButtonColor: '#6b7280'
                    });

                    if (resultadoSwal.isConfirmed) {
                        await generarPDF();
                    } else if (resultadoSwal.isDenied) {
                        // Mostrar menú de opciones de impresión
                        const opcionImpresion = await Swal.fire({
                            title: '🖨️ Opciones de Impresión',
                            html: `
                <div style="text-align: left; padding: 10px;">
                    <p style="margin-bottom: 15px;">Selecciona qué deseas imprimir:</p>
                </div>
            `,
                            showDenyButton: true,
                            showCancelButton: true,
                            confirmButtonText: '🎯 Todas las Tarimas',
                            confirmButtonColor: '#8b5cf6',
                            denyButtonText: '📦 Tarima Individual',
                            denyButtonColor: '#0891b2',
                            cancelButtonText: 'Cancelar',
                            cancelButtonColor: '#6b7280'
                        });

                        if (opcionImpresion.isConfirmed) {
                            // Imprimir todas las etiquetas de todas las tarimas
                            if (tarimas.length === 0) {
                                Swal.fire('⚠️', 'No hay tarimas para imprimir', 'warning');
                                return;
                            }

                            const totalEtiquetas = tarimas.reduce((sum, t) => sum + t.bultos.length + 1, 0);
                            const confirmar = await Swal.fire({
                                icon: 'question',
                                title: '¿Imprimir todas las etiquetas?',
                                html: `
                    <p>Se imprimirán <strong>${totalEtiquetas}</strong> etiquetas en total:</p>
                    <ul style="text-align: left; margin: 10px 0;">
                        ${tarimas.map(t => `<li>${t.descripcion}: 1 etiqueta de tarima + ${t.bultos.length} etiquetas de bultos</li>`).join('')}
                    </ul>
                `,
                                showCancelButton: true,
                                confirmButtonText: '🖨️ Imprimir Todo',
                                confirmButtonColor: '#059669',
                                cancelButtonText: 'Cancelar'
                            });

                            if (confirmar.isConfirmed) {
                                Swal.fire({
                                    title: '⏳ Imprimiendo...',
                                    html: 'Por favor espera mientras se envían todas las etiquetas',
                                    allowOutsideClick: false,
                                    didOpen: () => {
                                        Swal.showLoading();
                                    }
                                });

                                let delay = 0;
                                tarimas.forEach((tarima, tarimaIndex) => {
                                    setTimeout(() => {
                                        imprimirEtiquetaTarima(tarima.id);
                                    }, delay);
                                    delay += 2000;

                                    tarima.bultos.forEach((bulto, bultoIndex) => {
                                        setTimeout(() => {
                                            imprimirEtiquetaBulto(bulto.id, tarima.id);
                                        }, delay);
                                        delay += 2000;
                                    });
                                });

                                setTimeout(() => {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'Impresión completada',
                                        text: `Se enviaron ${totalEtiquetas} etiquetas a la impresora`,
                                        timer: 3000
                                    });
                                }, delay);
                            }
                        } else if (opcionImpresion.isDenied) {
                            // Seleccionar tarima individual
                            const opcionesTarimas = tarimas.map(t =>
                                `<option value="${t.id}">${t.descripcion || `EMPAQUE ${t.numero}`} (${t.bultos.length} bultos)</option>`
                            ).join('');

                            const seleccionTarima = await Swal.fire({
                                title: '📦 Seleccionar Tarima',
                                html: `
                    <select id="selectTarima" class="swal2-input" style="width: 80%;">
                        ${opcionesTarimas}
                    </select>
                `,
                                showCancelButton: true,
                                confirmButtonText: '🖨️ Imprimir Tarima',
                                confirmButtonColor: '#0891b2',
                                cancelButtonText: 'Cancelar',
                                preConfirm: () => {
                                    return document.getElementById('selectTarima').value;
                                }
                            });

                            if (seleccionTarima.isConfirmed && seleccionTarima.value) {
                                imprimirTodasEtiquetasTarima(seleccionTarima.value);
                            }
                        }
                    }
                } else {
                    throw new Error(resultado.message || 'Error desconocido');
                }

            } catch (error) {
                console.error('❌ Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error al Guardar',
                    text: error.message || 'Ocurrió un error inesperado al guardar el Packing List',
                    confirmButtonText: 'Aceptar',
                    confirmButtonColor: '#dc2626'
                });
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.textContent = '💾 Guardar';
                }
            }
        }

        async function generarPDF() {
            try {
                const data = recolectarDatos();
                console.log('📄 Generando PDF con:', data);

                if (!data.facturaReferencia || data.tarimas.length === 0) {
                    alert('⚠️ Debe completar la información básica y agregar al menos una tarima con bultos antes de generar el PDF');
                    return;
                }

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('p', 'mm', 'a4');

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 20;
                let yPos = margin;

                // ── Paleta de colores ──────────────────────────────────────────────
                const primaryColor = [21, 63, 112];
                const accentColor = [21, 63, 112];
                const lightGray = [245, 245, 245];
                const mediumGray = [189, 189, 189];
                const darkGray = [97, 97, 97];
                const successGreen = [5, 150, 105];

                // ── Datos del exportador (ajusta según tu empresa) ─────────────────
                const EXPORTADOR = {
                    nombre: 'SELLOS Y RETENES DE SAN LUIS S.A. DE C.V.',
                    rfc: 'SRS000000XXX',          // ← reemplaza con RFC real
                    calle: 'Av. Periférico Oriente 200',
                    colonia: 'Prados de San Vicente 2da Sección',
                    cp: '78394',
                    ciudad: 'Villa de Pozos',
                    estado: 'San Luis Potosí',
                    pais: 'México',
                    telefono: '',                       // ← opcional
                    email: '',                       // ← opcional
                };

                // ══════════════════════════════════════════════════════════════════
                // HELPERS LOCALES
                // ══════════════════════════════════════════════════════════════════
                const checkPage = (needed = 40) => {
                    if (yPos + needed > pageHeight - 20) {
                        doc.addPage();
                        yPos = margin + 10;
                    }
                };

                const drawSectionTitle = (text) => {
                    checkPage(14);
                    doc.setFontSize(10);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...primaryColor);
                    doc.text(text, margin, yPos);
                    doc.setDrawColor(...accentColor);
                    doc.setLineWidth(0.5);
                    doc.line(margin, yPos + 1, pageWidth - margin, yPos + 1);
                    yPos += 8;
                };

                // ══════════════════════════════════════════════════════════════════
                // ENCABEZADO (igual que antes, sin cambios visuales)
                // ══════════════════════════════════════════════════════════════════
                doc.setFillColor(...primaryColor);
                doc.rect(0, 0, pageWidth, 40, 'F');

                try {
                    const logoBase64 = await convertToBase64(`/Content/img/${empresa}/logo-light.png`);
                    doc.addImage(logoBase64, 'PNG', margin, 10, 30, 20);
                } catch {
                    doc.setFontSize(12);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(255, 255, 255);
                    doc.text('SRS', margin + 5, 22);
                }

                doc.setFontSize(10);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text('SELLOS Y RETENES DE SAN LUIS', margin + 35, 15);

                doc.setFontSize(8);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(240, 240, 240);
                doc.text('Packing & Logistics Department', margin + 35, 20);

                doc.setFontSize(22);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text('PACKING LIST', pageWidth - margin, 18, { align: 'right' });

                doc.setFontSize(9);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(240, 240, 240);
                doc.text('Lista de Empaque Internacional', pageWidth - margin, 24, { align: 'right' });

                doc.setFillColor(...accentColor);
                doc.roundedRect(pageWidth - margin - 50, 27, 50, 8, 2, 2, 'F');
                doc.setFontSize(9);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text(`#${data.facturaReferenciaTexto}`, pageWidth - margin - 25, 33, { align: 'center' });

                yPos = 48;

                // ══════════════════════════════════════════════════════════════════
                // MEJORA 1 – EXPORTADOR  +  DESTINATARIO (lado a lado)
                // ══════════════════════════════════════════════════════════════════
                drawSectionTitle('PARTES INVOLUCRADAS');

                const halfW = (pageWidth - 2 * margin - 6) / 2;

                // Caja exportador
                doc.setFillColor(...lightGray);
                doc.roundedRect(margin, yPos, halfW, 36, 2, 2, 'F');
                doc.setFontSize(7);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text('EXPORTADOR / SHIPPER', margin + 3, yPos + 5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(0, 0, 0);
                doc.setFontSize(7.5);
                [
                    EXPORTADOR.nombre,
                    `${EXPORTADOR.calle}`,
                    `${EXPORTADOR.colonia}, C.P. ${EXPORTADOR.cp}`,
                    `${EXPORTADOR.ciudad}, ${EXPORTADOR.estado}`,
                    `RFC: ${EXPORTADOR.rfc}  |  País: ${EXPORTADOR.pais}`
                ].forEach((line, i) => doc.text(line, margin + 3, yPos + 11 + i * 4.5));

                // Caja destinatario
                const rightX = margin + halfW + 6;
                doc.setFillColor(...lightGray);
                doc.roundedRect(rightX, yPos, halfW, 36, 2, 2, 'F');
                doc.setFontSize(7);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text('CONSIGNATARIO / DESTINATARIO', rightX + 3, yPos + 5);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(0, 0, 0);
                doc.setFontSize(7.5);
                [
                    data.consignatario.nombre,
                    `${data.consignatario.calle} ${data.consignatario.nexterior} ${data.consignatario.ninterior}`.trim(),
                    `${data.consignatario.colonia}, C.P. ${data.consignatario.cp}`,
                    `${data.consignatario.estado}`,
                    `País: ${data.consignatario.pais}`
                ].filter(Boolean).forEach((line, i) => doc.text(line, rightX + 3, yPos + 11 + i * 4.5));

                yPos += 42;

                // ══════════════════════════════════════════════════════════════════
                // INFORMACIÓN DE EMBARQUE (igual que antes)
                // ══════════════════════════════════════════════════════════════════
                drawSectionTitle('INFORMACIÓN DE EMBARQUE');

                const colW = (pageWidth - 2 * margin - 10) / 2;
                let leftY = yPos;
                let rightY = yPos;

                [
                    ['Fecha de Embarque', data.fechaEmbarque || 'N/A'],
                    ['Medio de Transporte', data.medioTransporte || 'N/A'],
                    ['Puerto / Lugar de Salida', data.puertoSalida || 'N/A'],
                    ['Puerto / Lugar de Destino', data.puertoDestino || 'N/A'],
                ].forEach(([label, value]) => {
                    doc.setFontSize(7); doc.setFont('helvetica', 'bold'); doc.setTextColor(...darkGray);
                    doc.text(label.toUpperCase(), margin, leftY);
                    doc.setFont('helvetica', 'normal'); doc.setTextColor(0, 0, 0); doc.setFontSize(8.5);
                    doc.text(doc.splitTextToSize(value, colW - 5), margin, leftY + 4);
                    leftY += 12;
                });

                [
                    ['Incoterm', data.incoterm || 'N/A'],
                    ['No. Contenedor', data.numeroContenedor || 'N/A'],
                    ['Orden de Compra Cliente', data.ODCComprador || 'N/A'],
                ].forEach(([label, value]) => {
                    const rx = margin + colW + 10;
                    doc.setFontSize(7); doc.setFont('helvetica', 'bold'); doc.setTextColor(...darkGray);
                    doc.text(label.toUpperCase(), rx, rightY);
                    doc.setFont('helvetica', 'normal'); doc.setTextColor(0, 0, 0); doc.setFontSize(8.5);
                    doc.text(doc.splitTextToSize(value, colW - 5), rx, rightY + 4);
                    rightY += 12;
                });

                yPos = Math.max(leftY, rightY) + 6;

                // ══════════════════════════════════════════════════════════════════
                // MEJORA 2 – TABLA RESUMEN DE TARIMAS
                // ══════════════════════════════════════════════════════════════════
                drawSectionTitle('RESUMEN DE TARIMAS');

                const resumenHead = [['#', 'DESCRIPCIÓN', 'BULTOS', 'PESO NETO (gr)', 'PESO BRUTO (gr)', 'VOLUMEN (m³)']];
                const resumenBody = data.tarimas.map((t, idx) => {
                    let pn = 0, pb = 0, vol = 0;
                    t.bultos.forEach(b => {
                        pn += parseFloat(b.pesoNeto) || 0;
                        pb += parseFloat(b.pesoBruto) || 0;
                        vol += parseFloat(b.dimensiones.volumen) || 0;
                    });
                    return [
                        idx + 1,
                        t.descripcion || `TARIMA ${t.numero}`,
                        t.bultos.length,
                        pn.toFixed(2),
                        pb.toFixed(2),
                        vol.toFixed(3)
                    ];
                });

                // Fila de totales
                const totPN = resumenBody.reduce((s, r) => s + parseFloat(r[3]), 0);
                const totPB = resumenBody.reduce((s, r) => s + parseFloat(r[4]), 0);
                const totVol = resumenBody.reduce((s, r) => s + parseFloat(r[5]), 0);
                const totBul = resumenBody.reduce((s, r) => s + parseInt(r[2]), 0);

                resumenBody.push(['', 'TOTAL GENERAL', totBul, totPN.toFixed(2), totPB.toFixed(2), totVol.toFixed(3)]);

                doc.autoTable({
                    startY: yPos,
                    head: resumenHead,
                    body: resumenBody,
                    theme: 'plain',
                    styles: { fontSize: 8, cellPadding: 3, lineColor: mediumGray, lineWidth: 0.15 },
                    headStyles: { fillColor: primaryColor, textColor: 255, fontStyle: 'bold', fontSize: 7.5 },
                    alternateRowStyles: { fillColor: [250, 250, 250] },
                    willDrawCell: (data) => {
                        // Pintar fila de totales en verde suave
                        if (data.row.index === resumenBody.length - 1 && data.section === 'body') {
                            data.cell.styles.fillColor = [209, 250, 229];
                            data.cell.styles.fontStyle = 'bold';
                            data.cell.styles.textColor = [6, 78, 59];
                        }
                    },
                    columnStyles: {
                        0: { cellWidth: 10, halign: 'center' },
                        1: { cellWidth: 65 },
                        2: { cellWidth: 18, halign: 'center' },
                        3: { cellWidth: 32, halign: 'right' },
                        4: { cellWidth: 32, halign: 'right' },
                        5: { cellWidth: 28, halign: 'right' },
