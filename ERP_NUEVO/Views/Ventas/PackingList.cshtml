        function actualizarEstadisticasTarima(tarimaId) {
            const tarima = tarimas.find(t => t.id === tarimaId);
            if (!tarima) return;

            let totalBultos = tarima.bultos.length;
            let totalPesoNeto = 0;
            let totalPesoBruto = 0;
            let totalVolumen = 0;

            tarima.bultos.forEach(bulto => {
                totalPesoNeto += parseFloat(bulto.pesoNeto) || 0;
                totalPesoBruto += parseFloat(bulto.pesoBruto) || 0;

                const largo = parseFloat(bulto.largo) || 0;
                const ancho = parseFloat(bulto.ancho) || 0;
                const alto = parseFloat(bulto.alto) || 0;
                totalVolumen += (largo * ancho * alto);
            });

            // Actualizar display de estadísticas
            const elemBultos = document.getElementById(`${tarimaId}-bultos`);
            const elemPesoNeto = document.getElementById(`${tarimaId}-peso-neto`);
            const elemPesoBruto = document.getElementById(`${tarimaId}-peso-bruto`);
            const elemVolumen = document.getElementById(`${tarimaId}-volumen`);

            if (elemBultos) elemBultos.textContent = totalBultos;
            if (elemPesoNeto) elemPesoNeto.textContent = totalPesoNeto.toFixed(2) + ' gr';
            if (elemPesoBruto) elemPesoBruto.textContent = totalPesoBruto.toFixed(2) + ' gr';
            if (elemVolumen) elemVolumen.textContent = totalVolumen.toFixed(3) + ' m³';

            console.log(`📊 Estadísticas actualizadas para ${tarimaId}:`, {
                bultos: totalBultos,
                pesoNeto: totalPesoNeto.toFixed(2),
                pesoBruto: totalPesoBruto.toFixed(2),
                volumen: totalVolumen.toFixed(3)
            });
        }

