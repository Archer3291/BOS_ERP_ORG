        // Función para copiar código ZPL al portapapeles
        function copiarZPL(zplEncoded) {
            const zpl = decodeURIComponent(zplEncoded);

            navigator.clipboard.writeText(zpl).then(() => {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'Código copiado',
                        text: 'El código ZPL se copió al portapapeles',
                        timer: 1500,
                        showConfirmButton: false
                    });
                } else {
                    alert('✅ Código ZPL copiado al portapapeles');
                }
            }).catch(err => {
                console.error('Error al copiar:', err);
                alert('❌ No se pudo copiar el código');
            });
        }

        // Función para imprimir todas las etiquetas de una tarima
        function imprimirTodasEtiquetasTarima(tarimaId) {
            const tarima = tarimas.find(t => t.id === tarimaId);
            if (!tarima) {
                alert('⚠️ No se encontró la tarima');
                return;
            }

            if (tarima.bultos.length === 0) {
                alert('⚠️ La tarima no tiene bultos para imprimir');
                return;
            }

            const confirmar = confirm(`¿Imprimir ${tarima.bultos.length + 1} etiquetas?\n\n1 etiqueta de tarima + ${tarima.bultos.length} etiquetas de bultos`);

            if (!confirmar) return;

            // Imprimir etiqueta de tarima primero
            imprimirEtiquetaTarima(tarimaId);

            // Esperar un momento y luego imprimir cada bulto
            let delay = 2000;
            tarima.bultos.forEach((bulto, index) => {
                setTimeout(() => {
                    imprimirEtiquetaBulto(bulto.id, tarimaId);
                }, delay + (index * 2000)); // 2 segundos entre cada impresión
            });

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'info',
                    title: 'Imprimiendo serie',
                    html: `
                <p>Imprimiendo ${tarima.bultos.length + 1} etiquetas...</p>
                <p style="font-size: 12px; color: #666;">
                    Por favor espera mientras se envían todas las etiquetas a la impresora.
                </p>
            `,
                    timer: 3000,
                    showConfirmButton: false
                });
            }
        }

