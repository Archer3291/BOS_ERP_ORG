                        pageWidth - margin - 5, yPos + 6, { align: 'right' }
                    );
                    yPos += 15;

                    tarima.bultos.forEach((bulto) => {
                        checkPage(70);

                        // Línea lateral
                        doc.setDrawColor(...accentColor); doc.setLineWidth(1);
