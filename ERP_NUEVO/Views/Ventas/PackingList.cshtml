                        doc.text(
                            `${parseFloat(bulto.dimensiones.largo || 0).toFixed(2)} × ${parseFloat(bulto.dimensiones.ancho || 0).toFixed(2)} × ${parseFloat(bulto.dimensiones.alto || 0).toFixed(2)} m`,
                            infoX + 30, yPos + 15
                        );

                        // Pesos
                        const pesoX = pageWidth - margin - 55;
