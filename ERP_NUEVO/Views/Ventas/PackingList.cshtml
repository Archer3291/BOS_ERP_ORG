                        doc.setFillColor(255, 255, 255);
                        doc.setDrawColor(...mediumGray); doc.setLineWidth(0.3);
                        doc.roundedRect(margin + 8, yPos, pageWidth - 2 * margin - 8, 18, 2, 2, 'FD');

                        // Círculo número
                        doc.setFillColor(...primaryColor);
                        doc.circle(margin + 17, yPos + 9, 6, 'F');
