                                headStyles: { fillColor: primaryColor, textColor: 255, fontStyle: 'bold', fontSize: 7 },
                                alternateRowStyles: { fillColor: [250, 250, 250] },
                                columnStyles: {
                                    0: { cellWidth: 25, fontStyle: 'bold' },
