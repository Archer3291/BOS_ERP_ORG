                    <p style="margin-bottom: 8px; font-size: 13px; color: #555;">
                        Código ZPL que se enviará a la impresora:
                    </p>
                    <textarea readonly
                        style="width:100%; height:280px; font-family:'Courier New',monospace;
                               font-size:10px; padding:10px; border:1px solid #ddd;
                               border-radius:4px; background:#fafafa; resize:vertical;"
                    >${zpl}</textarea>
                    <div style="margin-top:10px; padding:10px; background:#f0fdf4;
                                border-left:4px solid #22c55e; border-radius:4px;">
                        <p style="margin:0; font-size:12px; color:#15803d;">
                            💡 <strong>Tip:</strong> Prueba el código en
                            <a href="http://labelary.com/viewer.html" target="_blank"
                               style="color:#16a34a; font-weight:600;">
                               Labelary Viewer
                            </a>
                            para ver la etiqueta antes de imprimir.
                        </p>
                    </div>
                </div>
            `,
                    width: '800px',
                    showCancelButton: true,
                    showDenyButton: true,
                    confirmButtonText: '🖨️ Imprimir Ahora',
                    confirmButtonColor: '#7c3aed',
                    cancelButtonText: '📋 Copiar Código',
                    cancelButtonColor: '#6b7280',
                    denyButtonText: '❌ Cerrar',
                    denyButtonColor: '#ef4444'
                }).then(result => {
                    if (result.isConfirmed) {
                        imprimirEtiquetaProducto(itemId, bultoId, tarimaId);
                    } else if (result.dismiss === Swal.DismissReason.cancel) {
                        copiarZPL(encodeURIComponent(zpl));
                    }
                });
            } else {
                // Fallback sin SweetAlert2
                const copiar = confirm(
                    `Vista Previa - Producto: ${item?.sku}\n\n` +
                    '¿Copiar el código ZPL al portapapeles?\n' +
                    '(También disponible en consola)'
                );
                console.log('Código ZPL del Producto:', zpl);
                if (copiar) copiarZPL(encodeURIComponent(zpl));
            }
        }

        function imprimirTodosProductosTarima(tarimaId) {
            const tarima = tarimas.find(t => t.id === tarimaId);
            if (!tarima) { alert('⚠️ No se encontró la tarima'); return; }

            // Recopilar todos los items únicos de la tarima
            const todosItems = [];
            tarima.bultos.forEach(bulto => {
                bulto.items.forEach(item => {
                    todosItems.push({ item, bultoId: bulto.id, tarimaId });
                });
            });

            if (todosItems.length === 0) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Sin productos',
                        text: 'Esta tarima no tiene productos asignados en sus bultos',
                        confirmButtonColor: '#7c3aed'
                    });
                } else {
                    alert('⚠️ Esta tarima no tiene productos asignados');
                }
                return;
            }

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'question',
                    title: '🏷️ Etiquetas de Productos',
                    html: `
                <p>Se imprimirán <strong>${todosItems.length}</strong> etiqueta(s) de producto 
                   para la tarima <strong>${tarima.descripcion || `TARIMA ${tarima.numero}`}</strong>.</p>
                <div style="max-height:160px; overflow-y:auto; text-align:left;
                            background:#f9fafb; padding:8px; border-radius:6px; margin-top:10px;">
                    ${todosItems.map((e, i) =>
                        `<div style="padding:3px 0; font-size:12px; border-bottom:1px solid #e5e7eb;">
                            ${i + 1}. <strong>${e.item.sku}</strong> — ${e.item.descripcion}
                            <span style="color:#7c3aed; float:right;">Bulto #${tarimas
                            .find(t => t.id === tarimaId)?.bultos
                            .find(b => b.id === e.bultoId)?.numero}</span>
                        </div>`
                    ).join('')}
                </div>`,
                    showCancelButton: true,
                    confirmButtonText: '🖨️ Imprimir Todas',
                    confirmButtonColor: '#7c3aed',
                    cancelButtonText: 'Cancelar',
                    cancelButtonColor: '#6b7280',
                    width: '560px'
                }).then(result => {
                    if (!result.isConfirmed) return;

                    Swal.fire({
                        title: '⏳ Imprimiendo productos...',
                        html: 'Enviando etiquetas a la impresora',
                        allowOutsideClick: false,
                        didOpen: () => Swal.showLoading()
                    });

                    let delay = 0;
                    todosItems.forEach(({ item, bultoId, tarimaId: tId }) => {
                        setTimeout(() => {
                            const zpl = generarEtiquetaProducto(item.id, bultoId, tId);
                            if (zpl) imprimirZebra(zpl);
                        }, delay);
                        delay += 1800;
                    });

                    setTimeout(() => {
                        Swal.fire({
                            icon: 'success',
                            title: 'Impresión completada',
                            text: `${todosItems.length} etiqueta(s) enviadas`,
                            timer: 2500,
                            showConfirmButton: false
                        });
                    }, delay);
                });
            } else {
                if (!confirm(`¿Imprimir ${todosItems.length} etiquetas de producto?`)) return;
                let delay = 0;
                todosItems.forEach(({ item, bultoId, tarimaId: tId }) => {
                    setTimeout(() => {
                        const zpl = generarEtiquetaProducto(item.id, bultoId, tId);
                        if (zpl) imprimirZebra(zpl);
                    }, delay);
                    delay += 1800;
                });
            }
        }




        // ============================================
        // INICIALIZACIÓN AUTOMÁTICA
        // ============================================

        // Agregar un bulto inicial al cargar
        window.addEventListener('load', function () {
            setTimeout(() => {
                if (bultos.length === 0) {
                    agregarBulto();
                }
            }, 500);
        });
    </script>
}