            const tarima = tarimas.find(t => t.id === tarimaId);
            if (tarima && tarima.bultos) {
                tarima.bultos.forEach(bulto => {
                    if (bulto.items) {
                        bulto.items.forEach(item => {
                            partidasAsignadas = partidasAsignadas.filter(id => id !== item.id);
                        });
                    }
                });
