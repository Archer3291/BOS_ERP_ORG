@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfoGroup
@{
        ViewBag.Title = "Zonas";
        ViewBag.PageTitle = "Ventas Nacionales";
        Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        /* ── WIZARD BAR ─────────────────────────────────────── */
        .vn-wizard-bar {
            display: flex;
            align-items: center;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.08);
            padding: 0 1.25rem;
            height: 52px;
            position: sticky;
            top: 0;
            z-index: 100;
            gap: 0;
        }

        .vn-wizard-steps-group {
            display: flex;
            align-items: center;
            gap: 0;
            flex: 1;
        }

        .vn-wizard-step {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 1rem;
            height: 52px;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: border-color var(--transition-fast), color var(--transition-fast);
            user-select: none;
        }

            .vn-wizard-step:hover .vn-step-label {
                color: var(--accent-blue);
            }

            .vn-wizard-step.active {
                border-bottom-color: var(--accent-blue);
            }

                .vn-wizard-step.active .vn-step-num {
                    background: var(--accent-blue);
                    color: #fff;
                }

                .vn-wizard-step.active .vn-step-label {
                    color: var(--accent-blue);
                    font-weight: 600;
                }

            .vn-wizard-step.done .vn-step-num {
                background: var(--success-color);
                color: #fff;
            }

            .vn-wizard-step.done .vn-step-label {
                color: rgba(255,255,255,.55);
            }

        .vn-step-num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            color: rgba(255,255,255,.6);
            font-size: 0.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background var(--transition-fast), color var(--transition-fast);
        }

        .vn-step-label {
            font-size: 0.82rem;
            font-weight: 500;
            color: rgba(255,255,255,.45);
            transition: color var(--transition-fast);
            white-space: nowrap;
        }

        .vn-wizard-divider {
            width: 24px;
            height: 1px;
            background: rgba(255,255,255,.15);
            flex-shrink: 0;
            margin: 0 0.25rem;
        }

        /* ── RESUMEN DROPDOWN EN WIZARD BAR ─────────────────── */
        .vn-wb-resumen {
            position: relative;
            margin-left: auto;
        }

        .vn-wb-resumen-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.35rem 0.85rem;
            border-radius: 7px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            color: rgba(255,255,255,.75);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition-fast), border-color var(--transition-fast);
            white-space: nowrap;
        }

            .vn-wb-resumen-btn:hover {
                background: rgba(255,255,255,.13);
                border-color: rgba(255,255,255,.2);
            }

            .vn-wb-resumen-btn i.chevron {
                font-size: 0.65rem;
                transition: transform var(--transition-med);
                color: rgba(255,255,255,.4);
            }

            .vn-wb-resumen-btn.open i.chevron {
                transform: rotate(180deg);
            }

        .vn-wb-resumen-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success-color);
            flex-shrink: 0;
        }

        .vn-wb-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 240px;
            background: var(--primary-blue);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: var(--table-radius);
            box-shadow: var(--shadow-lg);
            z-index: 200;
            overflow: hidden;
        }

            .vn-wb-dropdown.open {
                display: block;
            }

        .vn-wb-dd-header {
            background: var(--primary-blue-dark);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .vn-wb-dd-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            letter-spacing: .04em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .vn-wb-dd-title i {
                color: var(--warning-color);
                font-size: 0.7rem;
            }

        .vn-wb-dd-badge {
            font-size: 0.62rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: var(--badge-radius);
            background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.6);
            letter-spacing: .05em;
        }

        .vn-wb-dd-body {
            padding: 0.75rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .vn-wb-dd-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
        }

        .vn-wb-dd-lbl {
            color: rgba(255,255,255,.4);
        }

        .vn-wb-dd-val {
            color: rgba(255,255,255,.85);
            font-weight: 500;
            text-align: right;
        }

        .vn-wb-dd-sep {
            height: 1px;
            background: rgba(255,255,255,.07);
        }

        .vn-wb-dd-step-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.5rem 0.75rem;
            border-radius: 7px;
            background: rgba(255,255,255,.05);
        }

        .vn-wb-dd-step-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .vn-wb-dd-step-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: rgba(255,255,255,.85);
        }

        .vn-wb-dd-step-sub {
            font-size: 0.7rem;
            color: rgba(255,255,255,.4);
        }

        .vn-wb-dd-footer {
            padding: 0.6rem 1rem;
            border-top: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .vn-wb-dd-btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.48rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 600;
            background: var(--accent-blue);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: opacity var(--transition-fast);
        }

            .vn-wb-dd-btn-primary:hover {
                opacity: .88;
            }

        .vn-wb-dd-btn-secondary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.44rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 500;
            background: transparent;
            color: rgba(255,255,255,.5);
            border: 1px solid rgba(255,255,255,.1);
            cursor: pointer;
            transition: background var(--transition-fast);
        }

            .vn-wb-dd-btn-secondary:hover {
                background: rgba(255,255,255,.07);
                color: rgba(255,255,255,.75);
            }

        /* ── LAYOUT ─────────────────────────────────────────── */
        .vn-layout {
            padding: 1.5rem;
            max-width: 900px;
            margin: 0 auto;
            transition: max-width var(--transition-med);
        }

            /* Cuando estamos en paso 2 en adelante, ancho libre */
            .vn-layout.vn-layout--wide {
                max-width: unset;
            }

        /* ── PANEL ──────────────────────────────────────────── */
        .vn-panel {
            display: none;
        }

            .vn-panel.active {
                display: block;
            }

        /* ── SECTION CARD ───────────────────────────────────── */
        .vn-section-card {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: var(--table-radius);
            margin-bottom: 1.25rem;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .vn-section-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
        }

        .vn-section-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--very-light-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .vn-section-title {
            font-size: 0.93rem;
            font-weight: 600;
            color: var(--text-dark);
            margin: 0;
        }

        .vn-section-sub {
            font-size: 0.78rem;
            color: var(--text-light);
            margin: 0;
        }

        .vn-section-body {
            padding: 1.25rem;
            background: var(--bg-gray);
        }

        /* ── PRODUCT CARDS ──────────────────────────────────── */
        .vn-type-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.875rem;
        }

        .vn-type-card {
            background: var(--primary-blue-dark);
            border: 1.5px solid var(--primary-blue);
            border-radius: var(--table-radius);
            padding: 1.1rem 1.15rem;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
        }

            .vn-type-card:hover {
                border-color: var(--accent-blue);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(59,130,246,.18);
            }

            .vn-type-card.selected {
                border-color: var(--accent-blue);
                background: var(--dark-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            }

            .vn-type-card input[type="radio"] {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

        .vn-card-icon-sm {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--primary-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.7rem;
            transition: background var(--transition-fast);
        }

        .vn-type-card.selected .vn-card-icon-sm {
            background: var(--accent-blue);
        }

        .vn-card-icon-sm svg {
            fill: var(--accent-blue);
            transition: fill var(--transition-fast);
        }

        .vn-type-card.selected .vn-card-icon-sm svg {
            fill: #fff;
        }

        .vn-card-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: #f9fafb;
            margin-bottom: 0.3rem;
        }

        .vn-card-desc {
            font-size: 0.76rem;
            color: var(--very-light-blue);
            line-height: 1.45;
            margin-bottom: 0.75rem;
        }

        .vn-card-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: var(--badge-radius);
            letter-spacing: .02em;
        }

        .vn-chip-oferta {
            background: rgba(249,115,22,.15);
            color: #fb923c;
        }

        .vn-chip-produccion {
            background: rgba(139,92,246,.15);
            color: var(--accent-purple);
        }

        .vn-chip-entrega {
            background: rgba(236,72,153,.15);
            color: #f472b6;
        }

        .vn-chip-cobro {
            background: rgba(16,185,129,.15);
            color: var(--success-color);
        }

        .vn-card-check {
            position: absolute;
            top: 0.7rem;
            right: 0.8rem;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-blue);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .vn-type-card.selected .vn-card-check {
            display: flex;
        }

        .vn-card-check i {
            color: #fff;
            font-size: 0.6rem;
        }

        /* ── STEP NAV ───────────────────────────────────────── */
        .vn-step-nav {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 1rem 0 0;
            margin-top: 0.5rem;
            border-top: 1px solid var(--border-light);
        }

        .vn-btn-step {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 0.5rem 1.35rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border-light);
            background: var(--bg-light);
            color: var(--text-dark);
            transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
        }

            .vn-btn-step:hover {
                background: var(--very-light-blue);
                border-color: var(--accent-blue);
                color: var(--accent-blue);
            }

            .vn-btn-step.next {
                background: var(--primary-blue-dark);
                border-color: var(--primary-blue-dark);
                color: #fff;
            }

                .vn-btn-step.next:hover {
                    background: var(--accent-blue);
                    border-color: var(--accent-blue);
                }

            .vn-btn-step.finish {
                background: var(--success-color);
                border-color: var(--success-color);
                color: #fff;
            }

                .vn-btn-step.finish:hover {
                    opacity: .88;
                }

        /* ── TOP BAR ────────────────────────────────────────── */
        .vn-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 1.25rem;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .vn-top-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #f9fafb;
        }

        .vn-pill {
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 5px;
            letter-spacing: .04em;
        }

        .vn-top-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: rgba(255,255,255,.45);
        }

        .vn-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--success-color);
        }

        /* Contenedor parciales */
        #vn-step2-contenido .vn-partial-wrap {
            display: none;
        }

            #vn-step2-contenido .vn-partial-wrap.active {
                display: block;
            }

        /* ── RESPONSIVE ─────────────────────────────────────── */
        @@media (max-width: 700px) {
            .vn-type-grid {
                grid-template-columns: 1fr;
            }

            .vn-wizard-step .vn-step-label {
                display: none;
            }

            .vn-layout {
                padding: 1rem;
            }
        }
    </style>
}

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />

<!-- TOP BAR -->
<div class="vn-top-bar">
    <div class="vn-top-brand">
        <span class="vn-pill">VN</span>
        Ventas Nacionales
    </div>
    <div class="vn-top-meta">
        <span class="vn-status-dot"></span>
        <span>NUEVO PROCESO</span>
        <span id="vn-tb-proceso">—</span>
    </div>
</div>

<!-- WIZARD BAR -->
<div class="vn-wizard-bar">
    <div class="vn-wizard-steps-group">
        <div class="vn-wizard-step active" data-step="1" onclick="vnGotoStep(1)">
            <div class="vn-step-num">1</div>
            <span class="vn-step-label">Tipo de proceso</span>
        </div>
        <div class="vn-wizard-divider"></div>
        <div class="vn-wizard-step" data-step="2" onclick="vnGotoStep(2)">
            <div class="vn-step-num">2</div>
            <span class="vn-step-label">Configuración</span>
        </div>
    </div>

    <!-- Resumen colapsado -->
    <div class="vn-wb-resumen">
        <button type="button" class="vn-wb-resumen-btn" id="vn-resumen-toggle" onclick="vnToggleResumen()">
            <span class="vn-wb-resumen-dot"></span>
            <span>Resumen</span>
            <span id="vn-wb-tipo-mini">Sin seleccionar</span>
            <i class="fas fa-chevron-down chevron"></i>
        </button>
        <div class="vn-wb-dropdown" id="vn-wb-dropdown">
            <div class="vn-wb-dd-header">
                <div class="vn-wb-dd-title">
                    <i class="fas fa-map-marked-alt"></i> Resumen VN
                </div>
                <span class="vn-wb-dd-badge">NUEVO</span>
            </div>
            <div class="vn-wb-dd-body">
                <div class="vn-wb-dd-row">
                    <span class="vn-wb-dd-lbl">Tipo de proceso</span>
                    <span class="vn-wb-dd-val" id="dd-tipo-name">Sin seleccionar</span>
                </div>
                <div class="vn-wb-dd-sep"></div>
                <div class="vn-wb-dd-row">
                    <span class="vn-wb-dd-lbl">Usuario</span>
                    <span class="vn-wb-dd-val" id="dd-vendedor">—</span>
                </div>
                <div class="vn-wb-dd-row">
                    <span class="vn-wb-dd-lbl">Sucursal</span>
                    <span class="vn-wb-dd-val" id="dd-sucursal">—</span>
                </div>
                <div class="vn-wb-dd-sep"></div>
                <div class="vn-wb-dd-step-row">
                    <div class="vn-wb-dd-step-num" id="dd-paso-num">1</div>
                    <div>
                        <div class="vn-wb-dd-step-name" id="dd-paso-name">Tipo de proceso</div>
                        <div class="vn-wb-dd-step-sub" id="dd-paso-sub">Selecciona el proceso de venta</div>
                    </div>
                </div>
            </div>
            <div class="vn-wb-dd-footer">
                <button type="button" class="vn-wb-dd-btn-primary" onclick="vnEnviarFormulario()">
                    <i class="fas fa-paper-plane" style="font-size:11px"></i> Guardar y procesar
                </button>
                <button type="button" class="vn-wb-dd-btn-secondary" onclick="vnGotoStep(1); vnToggleResumen(true)">
                    <i class="fas fa-redo" style="font-size:10px"></i> Reiniciar selección
                </button>
            </div>
        </div>
    </div>
</div>

<!-- LAYOUT -->
<div class="vn-layout" id="vn-layout">
    <form id="vn-form-1" novalidate>
        @Html.AntiForgeryToken()

        <!-- PASO 1 -->
        <div class="vn-panel active" id="vn-panel-1">
            <div class="vn-section-card">
                <div class="vn-section-head">
                    <div class="vn-section-icon"><i class="fas fa-map-marked-alt"></i></div>
                    <div>
                        <div class="vn-section-title">Selecciona el tipo de proceso de venta nacional</div>
                        <div class="vn-section-sub">Elige la opción que mejor describa el documento que necesitas configurar</div>
                    </div>
                </div>
                <div class="vn-section-body">
                    <fieldset aria-required="true">
                        <legend class="visually-hidden">Tipo de proceso de venta nacional</legend>
                        <div class="vn-type-grid">

                            <!-- Cotización -->
                            <div class="vn-type-card" data-option="cotizacion" onclick="vnSelectCard(this)">
                                <input type="radio" value="cotizacionV" class="proceso" name="proceso" id="cotizacion" autocomplete="off" required>
                                <div class="vn-card-check"><i class="fas fa-check"></i></div>
                                <div class="vn-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                                        <path d="M14 2v6h6" />
                                        <path d="M9 9h6v1h-6z" />
                                        <path d="M9 12h6v1h-6z" />
                                        <path d="M9 15h3v1h-3z" />
                                    </svg>
                                </div>
                                <div class="vn-card-title">Cotización</div>
                                <div class="vn-card-desc">Gestión de cotizaciones para clientes nacionales, con precios, descuentos y condiciones comerciales.</div>
                                <span class="vn-card-chip vn-chip-oferta">Etapa: oferta</span>
                            </div>

                            <!-- Pedido -->
                            <div class="vn-type-card" data-option="pedido" onclick="vnSelectCard(this)">
                                <input type="radio" value="pedidoV" class="proceso" name="proceso" id="pedido" autocomplete="off" required>
                                <div class="vn-card-check"><i class="fas fa-check"></i></div>
                                <div class="vn-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M19 7h-3V6a4 4 0 0 0-8 0v1H5a1 1 0 0 0-1 1v11a3 3 0 0 0 3 3h10a3 3 0 0 0 3-3V8a1 1 0 0 0-1-1zM10 6a2 2 0 0 1 4 0v1h-4V6zm8 13a1 1 0 0 1-1 1H7a1 1 0 0 1-1-1V9h2v1a1 1 0 0 0 2 0V9h4v1a1 1 0 0 0 2 0V9h2v10z" />
                                    </svg>
                                </div>
                                <div class="vn-card-title">Pedido</div>
                                <div class="vn-card-desc">Gestión de pedidos de venta, seguimiento de órdenes y control de inventario para ventas nacionales.</div>
                                <span class="vn-card-chip vn-chip-produccion">Etapa: producción</span>
                            </div>

                            <!-- Remisión -->
                            <div class="vn-type-card" data-option="remision" onclick="vnSelectCard(this)">
                                <input type="radio" value="remisionV" class="proceso" name="proceso" id="remision" autocomplete="off" required>
                                <div class="vn-card-check"><i class="fas fa-check"></i></div>
                                <div class="vn-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M20 6h-2.18c.11-.31.18-.65.18-1a2.996 2.996 0 0 0-5.5-1.65l-.5.67-.5-.68C10.96 2.54 10.05 2 9 2 7.34 2 6 3.34 6 5c0 .35.07.69.18 1H4c-1.11 0-1.99.89-1.99 2L2 19c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V8c0-1.11-.89-2-2-2zm-5-2c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1zM9 4c.55 0 1 .45 1 1s-.45 1-1 1-1-.45-1-1 .45-1 1-1z" />
                                        <path d="M7 12h10v2H7z" />
                                        <path d="M7 16h7v2H7z" />
                                    </svg>
                                </div>
                                <div class="vn-card-title">Remisión</div>
                                <div class="vn-card-desc">Gestión de remisiones de mercancía, control de entregas y documentación de despachos.</div>
                                <span class="vn-card-chip vn-chip-entrega">Etapa: entrega</span>
                            </div>

                            <!-- Facturación -->
                            <div class="vn-type-card" data-option="facturacion" onclick="vnSelectCard(this)">
                                <input type="radio" value="facturacionV" class="proceso" name="proceso" id="facturacion" autocomplete="off" required>
                                <div class="vn-card-check"><i class="fas fa-check"></i></div>
                                <div class="vn-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                                        <path d="M14 2v6h6M16 11a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1z" />
                                        <circle cx="11" cy="11" r="1" />
                                        <path d="M9 16h6v1H9zM9 18h4v1H9z" />
                                    </svg>
                                </div>
                                <div class="vn-card-title">Facturación</div>
                                <div class="vn-card-desc">Facturación electrónica para ventas nacionales, cálculo de impuestos y cumplimiento normativo.</div>
                                <span class="vn-card-chip vn-chip-cobro">Etapa: cobro</span>
                            </div>

                        </div><!-- /.vn-type-grid -->
                    </fieldset>
                </div>
            </div>

            <div class="vn-step-nav">
                <button type="button" class="vn-btn-step next" onclick="vnGotoStep(2)">
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div><!-- /#vn-panel-1 -->

        <!-- PASO 2 — contenedores parciales -->
        <div class="vn-panel" id="vn-panel-2">
            <div id="vn-step2-contenido">

                <div class="vn-partial-wrap" id="cotizacion-contenedor">
                    @Html.Partial("VentasNacionales/_Cotizacion")
                </div>

                <div class="vn-partial-wrap" id="pedido-contenedor">
                    @Html.Partial("VentasNacionales/_Pedido", Model.ParcialA)
                </div>

                <div class="vn-partial-wrap" id="remision-contenedor">
                    @Html.Partial("VentasNacionales/_Remision", Model.ParcialB)
                    @Html.Partial("VentasNacionales/_ModalEscaneoRemisionNacional")
                </div>

                <div class="vn-partial-wrap" id="facturacion-contenedor">
                    @Html.Partial("VentasNacionales/_Factura", Model.ParcialC)
                    @Html.Partial("VentasNacionales/_ModalRemisionesParcialesNacional")
                </div>

            </div>

            <div class="vn-step-nav" style="justify-content: space-between;">
                <button type="button" class="vn-btn-step" onclick="vnGotoStep(1)">
                    <i class="fas fa-arrow-left"></i> Anterior
                </button>
            </div>
        </div><!-- /#vn-panel-2 -->

    </form>
</div><!-- /.vn-layout -->

@section scripts {
    <script>
    const rol           = "@Utilities.GetUserRole(User.Identity.Name, "ERP_SRS")";
    const vendedor      = "@User.Identity.Name";
        const sucursal      = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    const sucursalText  = "@Utilities.GetSucursalName(User.Identity.Name)";
        const sucursalUsuario = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    let suc; let alm;
    </script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Ventas/credito-ventas.js"></script>
    <script src="~/Scripts/Ventas/reglas-precio-ventas.js"></script>
    <script src="~/Scripts/Ventas/escaneo-remision.js"></script>
    <script src="~/Scripts/Ventas/Nacionales/partial-vn-cotizacion.js"></script>
    <script src="~/Scripts/Ventas/Nacionales/partial-vn-pedido.js"></script>
    <script src="~/Scripts/Ventas/Nacionales/partial-vn-remision.js"></script>
    <script src="~/Scripts/Ventas/Nacionales/partial-vn-factura.js"></script>
    @* incluirPedimentos = false: la factura nacional deserializa productosJSON como
       Dictionary<string,string> y un arreglo la rompe. *@
    <script>
        window.FacturacionRemisionesConfig = {
            prefix: 'vn-fac',
            endpointRemisiones: '/DatosGenerales/BuscarDVNrem',
            incluirPedimentos: false
        };
    </script>
    <script src="~/Scripts/Ventas/facturacion-remisiones-parciales.js"></script>
    <script>
        /* ── CONFIG DE PASOS ──────────────────────────────── */
        const VN_STEPS = {
            1: { name: 'Tipo de proceso', sub: 'Selecciona el proceso de venta' },
            2: { name: 'Configuración', sub: 'Completa los datos del proceso' }
        };

        const VN_TIPOS = {
            cotizacionV: { label: 'Cotización', sub: 'Precios y condiciones comerciales', contenedor: 'cotizacion-contenedor' },
            pedidoV: { label: 'Pedido', sub: 'Órdenes e inventario', contenedor: 'pedido-contenedor' },
            remisionV: { label: 'Remisión', sub: 'Entregas y despachos', contenedor: 'remision-contenedor' },
            facturacionV: { label: 'Facturación', sub: 'Factura electrónica y DIAN', contenedor: 'facturacion-contenedor' },
        };

        let vnCurrentStep = 1;

        /* ── ANCHO DEL LAYOUT POR PASO ────────────────────── */
        function vnUpdateLayout(step) {
            const layout = document.getElementById('vn-layout');
            if (step >= 2) {
                layout.classList.add('vn-layout--wide');
            } else {
                layout.classList.remove('vn-layout--wide');
            }
        }

        /* ── DROPDOWN RESUMEN ─────────────────────────────── */
        function vnToggleResumen(forceClose) {
            const btn = document.getElementById('vn-resumen-toggle');
            const dd = document.getElementById('vn-wb-dropdown');
            const isOpen = dd.classList.contains('open');
            if (forceClose || isOpen) {
                dd.classList.remove('open');
                btn.classList.remove('open');
            } else {
                dd.classList.add('open');
                btn.classList.add('open');
            }
        }

        // Cerrar dropdown al hacer clic fuera
        document.addEventListener('click', function (e) {
            const wrap = document.querySelector('.vn-wb-resumen');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('vn-wb-dropdown').classList.remove('open');
                document.getElementById('vn-resumen-toggle').classList.remove('open');
            }
        });

        /* ── NAVEGACIÓN ───────────────────────────────────── */
        function vnGotoStep(targetStep) {
            if (targetStep > vnCurrentStep) {
                if (!vnValidateStep(vnCurrentStep)) return;
            }

            document.querySelectorAll('.vn-panel').forEach((p, i) => {
                p.classList.toggle('active', i + 1 === targetStep);
            });

            document.querySelectorAll('.vn-wizard-step').forEach(s => {
                const n = parseInt(s.dataset.step);
                s.classList.remove('active', 'done');
                if (n === targetStep) s.classList.add('active');
                if (n < targetStep) s.classList.add('done');
            });

            vnCurrentStep = targetStep;
            vnUpdateLayout(targetStep);
            vnUpdateSidebar();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /* ── VALIDACIÓN ───────────────────────────────────── */
        function vnValidateStep(step) {
            if (step === 1) {
                const sel = document.querySelector('input[name="proceso"]:checked');
                if (!sel) {
                    if (typeof toastMixin !== 'undefined') {
                        toastMixin.fire({ icon: 'error', title: 'Debes seleccionar el tipo de proceso de venta nacional.' });
                    } else {
                        alert('Debes seleccionar el tipo de proceso de venta nacional.');
                    }
                    return false;
                }
                return true;
            }
            if (step === 2) {
                if (typeof validarDatos === 'function') {
                    return validarDatos();
                }
            }
            return true;
        }

        /* ── SELECCIÓN DE CARD ────────────────────────────── */
        function vnSelectCard(card) {
            document.querySelectorAll('.vn-type-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');

            const radio = card.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;

            const valor = radio?.value;
            document.querySelectorAll('.vn-partial-wrap').forEach(w => w.classList.remove('active'));
            if (valor && VN_TIPOS[valor]) {
                document.getElementById(VN_TIPOS[valor].contenedor)?.classList.add('active');
            }

            document.getElementById('vn-tb-proceso').textContent = VN_TIPOS[valor]?.label ?? '—';
            vnUpdateSidebar();
        }

        /* ── ACTUALIZAR RESUMEN ───────────────────────────── */
        function vnUpdateSidebar() {
            const paso = VN_STEPS[vnCurrentStep];
            const sel = document.querySelector('input[name="proceso"]:checked');
            const tipoLabel = sel && VN_TIPOS[sel.value] ? VN_TIPOS[sel.value].label : 'Sin seleccionar';

            document.getElementById('vn-wb-tipo-mini').textContent = tipoLabel;
            document.getElementById('dd-paso-num').textContent = vnCurrentStep;
            document.getElementById('dd-paso-name').textContent = paso?.name ?? '—';
            document.getElementById('dd-paso-sub').textContent = paso?.sub ?? '';
            document.getElementById('dd-vendedor').textContent = vendedor ?? '—';
            document.getElementById('dd-sucursal').textContent = sucursalText ?? '—';
            document.getElementById('dd-tipo-name').textContent = tipoLabel;
        }

        ///* ── ENVÍO FINAL ──────────────────────────────────── */
        //function vnEnviarFormulario() {
        //    if (vnCurrentStep < 2) {
        //        if (!vnValidateStep(1)) return;
        //        vnGotoStep(2);
        //        return;
        //    }
        //    if (!vnValidateStep(2)) return;
        //    console.log('Enviar formulario VN');
        //}

        /* ── INIT ─────────────────────────────────────────── */
        vnUpdateSidebar();
        vnUpdateLayout(vnCurrentStep);
    </script>
}
