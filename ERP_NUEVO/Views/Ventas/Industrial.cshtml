    </form>
</div><!-- /.vi-layout -->

@section scripts {
    <script>
    const rol           = "@Utilities.GetUserRole(User.Identity.Name, "ERP_SRS")";
    const vendedor      = "@User.Identity.Name";
        const sucursal      = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    const sucursalText  = "@Utilities.GetSucursalName(User.Identity.Name)";
        const sucursalUsuario = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    let suc; let alm;
    </script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Ventas/credito-ventas.js"></script>
    <script src="~/Scripts/Ventas/reglas-precio-ventas.js"></script>
    <script src="~/Scripts/Ventas/Industriales/partial-vi-cotizacion.js"></script>
    <script src="~/Scripts/Ventas/Industriales/partial-vi-pedido.js"></script>
    <script src="~/Scripts/Ventas/Industriales/partial-vi-remision.js"></script>
    <script src="~/Scripts/Ventas/Industriales/partial-vi-factura.js"></script>
    <script src="~/Scripts/Ventas/Industriales/partial-vi-factura-anticipo.js"></script>
    @* El modal de facturación especial es el mismo módulo para todos los canales;
       la configuración de abajo es lo único propio de Industriales. *@
    <script>
        window.FacturacionRemisionesConfig = {
            prefix: 'vi-fac',
            endpointRemisiones: '/DatosGenerales/BuscarDVIrem'
        };
    </script>
    <script src="~/Scripts/Ventas/facturacion-remisiones-parciales.js"></script>
    <script>
        /* ── CONFIG DE PASOS ──────────────────────────────── */
        const VI_STEPS = {
            1: { name: 'Tipo de proceso', sub: 'Selecciona el proceso industrial' },
            2: { name: 'Configuración', sub: 'Completa los datos del proceso' }
        };

        const VI_TIPOS = {
            cotizacionIndustrialV: { label: 'Cotización Industrial', sub: 'Especificaciones y plazos', contenedor: 'cotizacion-industrial-contenedor' },
            pedidoIndustrialV: { label: 'Pedido Industrial', sub: 'Órdenes y certificaciones', contenedor: 'pedido-industrial-contenedor' },
            remisionIndustrialV: { label: 'Remisión Industrial', sub: 'Despacho con documentación', contenedor: 'remision-industrial-contenedor' },
            facturacionIndustrialV: { label: 'Facturación Industrial', sub: 'Anticipos y retenciones', contenedor: 'facturacion-industrial-contenedor' },
            facturacionIndustrialVAnticipo: { label: 'Anticipo Industrial', sub: 'Pagos anticipados y saldos', contenedor: 'anticipo-industrial-contenedor' },
        };

        let viCurrentStep = 1;

        /* ── ANCHO DEL LAYOUT POR PASO ────────────────────── */
        function viUpdateLayout(step) {
            const layout = document.getElementById('vi-layout');
            if (step >= 2) {
                layout.classList.add('vi-layout--wide');
            } else {
                layout.classList.remove('vi-layout--wide');
            }
        }

        /* ── DROPDOWN RESUMEN ─────────────────────────────── */
        function viToggleResumen(forceClose) {
            const btn = document.getElementById('vi-resumen-toggle');
            const dd = document.getElementById('vi-wb-dropdown');
            const isOpen = dd.classList.contains('open');
            if (forceClose || isOpen) {
                dd.classList.remove('open');
                btn.classList.remove('open');
            } else {
                dd.classList.add('open');
                btn.classList.add('open');
            }
        }

        // Cerrar dropdown al hacer clic fuera
        document.addEventListener('click', function (e) {
            const wrap = document.querySelector('.vi-wb-resumen');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('vi-wb-dropdown').classList.remove('open');
                document.getElementById('vi-resumen-toggle').classList.remove('open');
            }
        });

        /* ── NAVEGACIÓN ───────────────────────────────────── */
        function viGotoStep(targetStep) {
            if (targetStep > viCurrentStep) {
                if (!viValidateStep(viCurrentStep)) return;
            }

            document.querySelectorAll('.vi-panel').forEach((p, i) => {
                p.classList.toggle('active', i + 1 === targetStep);
            });

            document.querySelectorAll('.vi-wizard-step').forEach(s => {
                const n = parseInt(s.dataset.step);
                s.classList.remove('active', 'done');
                if (n === targetStep) s.classList.add('active');
                if (n < targetStep) s.classList.add('done');
            });

            viCurrentStep = targetStep;
            viUpdateLayout(targetStep);
            viUpdateSidebar();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /* ── VALIDACIÓN ───────────────────────────────────── */
        function viValidateStep(step) {
            if (step === 1) {
                const sel = document.querySelector('input[name="proceso"]:checked');
                if (!sel) {
                    if (typeof toastMixin !== 'undefined') {
                        toastMixin.fire({ icon: 'error', title: 'Debes seleccionar el tipo de proceso industrial.' });
                    } else {
                        alert('Debes seleccionar el tipo de proceso industrial.');
                    }
                    return false;
                }
                return true;
            }
            if (step === 2) {
                if (typeof validarDatos === 'function') {
                    return validarDatos();
                }
            }
            return true;
        }

        /* ── SELECCIÓN DE CARD ────────────────────────────── */
        function viSelectCard(card) {
            document.querySelectorAll('.vi-type-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');

            const radio = card.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;

            const valor = radio?.value;
            document.querySelectorAll('.vi-partial-wrap').forEach(w => w.classList.remove('active'));
            if (valor && VI_TIPOS[valor]) {
                document.getElementById(VI_TIPOS[valor].contenedor)?.classList.add('active');
            }

            document.getElementById('vi-tb-proceso').textContent = VI_TIPOS[valor]?.label ?? '—';
            viUpdateSidebar();
        }

        /* ── ACTUALIZAR RESUMEN ───────────────────────────── */
        function viUpdateSidebar() {
            const paso = VI_STEPS[viCurrentStep];
            const sel = document.querySelector('input[name="proceso"]:checked');
            const tipoLabel = sel && VI_TIPOS[sel.value] ? VI_TIPOS[sel.value].label : 'Sin seleccionar';

            document.getElementById('vi-wb-tipo-mini').textContent = tipoLabel;
            document.getElementById('dd-paso-num').textContent = viCurrentStep;
            document.getElementById('dd-paso-name').textContent = paso?.name ?? '—';
            document.getElementById('dd-paso-sub').textContent = paso?.sub ?? '';
            document.getElementById('dd-vendedor').textContent = vendedor ?? '—';
            document.getElementById('dd-sucursal').textContent = sucursalText ?? '—';
            document.getElementById('dd-tipo-name').textContent = tipoLabel;
        }

        ///* ── ENVÍO FINAL ──────────────────────────────────── */
        //function viEnviarFormulario() {
        //    if (viCurrentStep < 2) {
        //        if (!viValidateStep(1)) return;
        //        viGotoStep(2);
        //        return;
        //    }
        //    if (!viValidateStep(2)) return;
        //    console.log('Enviar formulario VI');
        //}

        /* ── INIT ─────────────────────────────────────────── */
        viUpdateSidebar();
        viUpdateLayout(viCurrentStep);
    </script>
}