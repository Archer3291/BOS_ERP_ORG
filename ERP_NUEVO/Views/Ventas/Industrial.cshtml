                        </div><!-- /.vi-type-grid -->
                    </fieldset>
                </div>
            </div>

            <div class="vi-step-nav">
                <button type="button" class="vi-btn-step next" onclick="viGotoStep(2)">
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div><!-- /#vi-panel-1 -->
        <!-- PASO 2 — contenedores parciales -->
        <div class="vi-panel" id="vi-panel-2">
            <div id="vi-step2-contenido">

                <div class="vi-partial-wrap" id="cotizacion-industrial-contenedor">
                    @Html.Partial("VentasIndustriales/_CotizacionIndustrial")
                </div>

                <div class="vi-partial-wrap" id="pedido-industrial-contenedor">
                    @Html.Partial("VentasIndustriales/_PedidoIndustrial", Model.ParcialA)
