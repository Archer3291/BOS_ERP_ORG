                                        <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                                    </svg>
                                </div>
                                <div class="vi-card-title">Remisión industrial</div>
                                <div class="vi-card-desc">Despacho de equipos con documentación técnica, manuales y certificados de calidad.</div>
                                <span class="vi-card-chip vi-chip-entrega">Etapa: entrega</span>
                            </div>

                            <!-- Facturación Industrial -->
                            <div class="vi-type-card" data-option="facturacion-industrial" onclick="viSelectCard(this)">
                                <input type="radio" value="facturacionIndustrialV" class="proceso" name="proceso" id="facturacion-industrial" autocomplete="off" required>
                                <div class="vi-card-check"><i class="fas fa-check"></i></div>
                                <div class="vi-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                                        <path d="M14 2v6h6M16 11a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1z" />
                                        <circle cx="11" cy="11" r="1" />
                                        <path d="M9 16h6v1H9zM9 18h4v1H9z" />
                                    </svg>
                                </div>
                                <div class="vi-card-title">Facturación industrial</div>
                                <div class="vi-card-desc">Facturación con manejo de anticipos, retenciones especiales y garantías técnicas.</div>
                                <span class="vi-card-chip vi-chip-cobro">Etapa: cobro</span>
                            </div>

                            <!-- Facturación Anticipo Industrial -->
                            <div class="vi-type-card" data-option="anticipo-industrial" onclick="viSelectCard(this)">
                                <input type="radio" value="facturacionIndustrialVAnticipo" class="proceso" name="proceso" id="facturacion-industrial-anticipo" autocomplete="off" required>
                                <div class="vi-card-check"><i class="fas fa-check"></i></div>
                                <div class="vi-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                                        <path d="M14 2v6h6M16 11a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1z" />
                                        <circle cx="11" cy="11" r="1" />
                                        <path d="M9 16h6v1H9zM9 18h4v1H9z" />
                                    </svg>
                                </div>
                                <div class="vi-card-title">Anticipo industrial</div>
                                <div class="vi-card-desc">Registro de pagos anticipados vinculados a pedidos con control de saldo pendiente.</div>
                                <span class="vi-card-chip vi-chip-anticipo">Etapa: anticipo</span>
