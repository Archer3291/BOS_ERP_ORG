@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfoGroup
@{
        ViewBag.Title = "Zonas";
        ViewBag.PageTitle = "Ventas Industriales";
        Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        /* ── WIZARD BAR ─────────────────────────────────────── */
        .vi-wizard-bar {
            display: flex;
            align-items: center;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.08);
            padding: 0 1.25rem;
            height: 52px;
            position: sticky;
            top: 0;
            z-index: 100;
            gap: 0;
        }

        .vi-wizard-steps-group {
            display: flex;
            align-items: center;
            gap: 0;
            flex: 1;
        }

        .vi-wizard-step {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 1rem;
            height: 52px;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: border-color var(--transition-fast), color var(--transition-fast);
            user-select: none;
        }

            .vi-wizard-step:hover .vi-step-label {
                color: var(--accent-blue);
            }

            .vi-wizard-step.active {
                border-bottom-color: var(--accent-blue);
            }

                .vi-wizard-step.active .vi-step-num {
                    background: var(--accent-blue);
                    color: #fff;
                }

                .vi-wizard-step.active .vi-step-label {
                    color: var(--accent-blue);
                    font-weight: 600;
                }

            .vi-wizard-step.done .vi-step-num {
                background: var(--success-color);
                color: #fff;
            }

            .vi-wizard-step.done .vi-step-label {
                color: rgba(255,255,255,.55);
            }

        .vi-step-num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            color: rgba(255,255,255,.6);
            font-size: 0.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background var(--transition-fast), color var(--transition-fast);
        }

        .vi-step-label {
            font-size: 0.82rem;
            font-weight: 500;
            color: rgba(255,255,255,.45);
            transition: color var(--transition-fast);
            white-space: nowrap;
        }

        .vi-wizard-divider {
            width: 24px;
            height: 1px;
            background: rgba(255,255,255,.15);
            flex-shrink: 0;
            margin: 0 0.25rem;
        }

        /* ── RESUMEN DROPDOWN EN WIZARD BAR ─────────────────── */
        .vi-wb-resumen {
            position: relative;
            margin-left: auto;
        }

        .vi-wb-resumen-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.35rem 0.85rem;
            border-radius: 7px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            color: rgba(255,255,255,.75);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition-fast), border-color var(--transition-fast);
            white-space: nowrap;
        }

            .vi-wb-resumen-btn:hover {
                background: rgba(255,255,255,.13);
                border-color: rgba(255,255,255,.2);
            }

            .vi-wb-resumen-btn i.chevron {
                font-size: 0.65rem;
                transition: transform var(--transition-med);
                color: rgba(255,255,255,.4);
            }

            .vi-wb-resumen-btn.open i.chevron {
                transform: rotate(180deg);
            }

        .vi-wb-resumen-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success-color);
            flex-shrink: 0;
        }

        .vi-wb-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 240px;
            background: var(--primary-blue);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: var(--table-radius);
            box-shadow: var(--shadow-lg);
            z-index: 200;
            overflow: hidden;
        }

            .vi-wb-dropdown.open {
                display: block;
            }

        .vi-wb-dd-header {
            background: var(--primary-blue-dark);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .vi-wb-dd-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            letter-spacing: .04em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .vi-wb-dd-title i {
                color: var(--warning-color);
                font-size: 0.7rem;
            }

        .vi-wb-dd-badge {
            font-size: 0.62rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: var(--badge-radius);
            background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.6);
            letter-spacing: .05em;
        }

        .vi-wb-dd-body {
            padding: 0.75rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .vi-wb-dd-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
        }

        .vi-wb-dd-lbl {
            color: rgba(255,255,255,.4);
        }

        .vi-wb-dd-val {
            color: rgba(255,255,255,.85);
            font-weight: 500;
            text-align: right;
        }

        .vi-wb-dd-sep {
            height: 1px;
            background: rgba(255,255,255,.07);
        }

        .vi-wb-dd-step-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.5rem 0.75rem;
            border-radius: 7px;
            background: rgba(255,255,255,.05);
        }

        .vi-wb-dd-step-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .vi-wb-dd-step-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: rgba(255,255,255,.85);
        }

        .vi-wb-dd-step-sub {
            font-size: 0.7rem;
            color: rgba(255,255,255,.4);
        }

        .vi-wb-dd-footer {
            padding: 0.6rem 1rem;
            border-top: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .vi-wb-dd-btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.48rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 600;
            background: var(--accent-blue);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: opacity var(--transition-fast);
        }

            .vi-wb-dd-btn-primary:hover {
                opacity: .88;
            }

        .vi-wb-dd-btn-secondary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.44rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 500;
            background: transparent;
            color: rgba(255,255,255,.5);
            border: 1px solid rgba(255,255,255,.1);
            cursor: pointer;
            transition: background var(--transition-fast);
        }

            .vi-wb-dd-btn-secondary:hover {
                background: rgba(255,255,255,.07);
                color: rgba(255,255,255,.75);
            }

        /* ── LAYOUT ─────────────────────────────────────────── */
        .vi-layout {
            padding: 1.5rem;
            max-width: 900px;
            margin: 0 auto;
            transition: max-width var(--transition-med);
        }

            /* Cuando estamos en paso 2 en adelante, ancho libre */
            .vi-layout.vi-layout--wide {
                max-width: unset;
            }

        /* ── PANEL ──────────────────────────────────────────── */
        .vi-panel {
            display: none;
        }

            .vi-panel.active {
                display: block;
            }

        /* ── SECTION CARD ───────────────────────────────────── */
        .vi-section-card {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: var(--table-radius);
            margin-bottom: 1.25rem;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .vi-section-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
        }

        .vi-section-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--very-light-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .vi-section-title {
            font-size: 0.93rem;
            font-weight: 600;
            color: var(--text-dark);
            margin: 0;
        }

        .vi-section-sub {
            font-size: 0.78rem;
            color: var(--text-light);
            margin: 0;
        }

        .vi-section-body {
            padding: 1.25rem;
            background: var(--bg-gray);
        }

        /* ── PRODUCT CARDS ──────────────────────────────────── */
        .vi-type-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.875rem;
        }

        .vi-type-card {
            background: var(--primary-blue-dark);
            border: 1.5px solid var(--primary-blue);
            border-radius: var(--table-radius);
            padding: 1.1rem 1.15rem;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
        }

            .vi-type-card:hover {
                border-color: var(--accent-blue);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(59,130,246,.18);
            }

            .vi-type-card.selected {
                border-color: var(--accent-blue);
                background: var(--dark-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            }

            .vi-type-card input[type="radio"] {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

        .vi-card-icon-sm {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--primary-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.7rem;
            transition: background var(--transition-fast);
        }

        .vi-type-card.selected .vi-card-icon-sm {
            background: var(--accent-blue);
        }

        .vi-card-icon-sm svg {
            fill: var(--accent-blue);
            transition: fill var(--transition-fast);
        }

        .vi-type-card.selected .vi-card-icon-sm svg {
            fill: #fff;
        }

        .vi-card-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: #f9fafb;
            margin-bottom: 0.3rem;
        }

        .vi-card-desc {
            font-size: 0.76rem;
            color: var(--very-light-blue);
            line-height: 1.45;
            margin-bottom: 0.75rem;
        }

        .vi-card-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: var(--badge-radius);
            letter-spacing: .02em;
        }

        .vi-chip-oferta {
            background: rgba(249,115,22,.15);
            color: #fb923c;
        }

        .vi-chip-produccion {
            background: rgba(139,92,246,.15);
            color: var(--accent-purple);
        }

        .vi-chip-entrega {
            background: rgba(236,72,153,.15);
            color: #f472b6;
        }

        .vi-chip-cobro {
            background: rgba(16,185,129,.15);
            color: var(--success-color);
        }

        .vi-card-check {
            position: absolute;
            top: 0.7rem;
            right: 0.8rem;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-blue);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .vi-type-card.selected .vi-card-check {
            display: flex;
        }

        .vi-card-check i {
            color: #fff;
            font-size: 0.6rem;
        }

        /* ── STEP NAV ───────────────────────────────────────── */
        .vi-step-nav {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 1rem 0 0;
            margin-top: 0.5rem;
            border-top: 1px solid var(--border-light);
        }

        .vi-btn-step {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 0.5rem 1.35rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border-light);
            background: var(--bg-light);
            color: var(--text-dark);
            transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
        }

            .vi-btn-step:hover {
                background: var(--very-light-blue);
                border-color: var(--accent-blue);
                color: var(--accent-blue);
            }

            .vi-btn-step.next {
                background: var(--primary-blue-dark);
                border-color: var(--primary-blue-dark);
                color: #fff;
            }

                .vi-btn-step.next:hover {
                    background: var(--accent-blue);
                    border-color: var(--accent-blue);
                }

            .vi-btn-step.finish {
                background: var(--success-color);
                border-color: var(--success-color);
                color: #fff;
            }

                .vi-btn-step.finish:hover {
                    opacity: .88;
                }

        /* ── TOP BAR ────────────────────────────────────────── */
        .vi-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 1.25rem;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .vi-top-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #f9fafb;
        }

        .vi-pill {
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 5px;
            letter-spacing: .04em;
        }

        .vi-top-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: rgba(255,255,255,.45);
        }

        .vi-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--success-color);
        }

        .vi-chip-anticipo {
            background: rgba(234, 179, 8, .15);
            color: #facc15;
        }
        /* Contenedor parciales */
        #vi-step2-contenido .vi-partial-wrap {
            display: none;
        }

            #vi-step2-contenido .vi-partial-wrap.active {
                display: block;
            }

        /* ── RESPONSIVE ─────────────────────────────────────── */
        @@media (max-width: 700px) {
            .vi-type-grid {
                grid-template-columns: 1fr;
            }

            .vi-wizard-step .vi-step-label {
                display: none;
            }

            .vi-layout {
                padding: 1rem;
            }
        }
    </style>
}

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />

<!-- TOP BAR -->
<div class="vi-top-bar">
    <div class="vi-top-brand">
        <span class="vi-pill">VI</span>
        Ventas Industriales
    </div>
    <div class="vi-top-meta">
        <span class="vi-status-dot"></span>
        <span>NUEVO PROCESO</span>
        <span id="vi-tb-proceso">—</span>
    </div>
</div>

<!-- WIZARD BAR -->
<div class="vi-wizard-bar">
    <div class="vi-wizard-steps-group">
        <div class="vi-wizard-step active" data-step="1" onclick="viGotoStep(1)">
            <div class="vi-step-num">1</div>
            <span class="vi-step-label">Tipo de proceso</span>
        </div>
        <div class="vi-wizard-divider"></div>
        <div class="vi-wizard-step" data-step="2" onclick="viGotoStep(2)">
            <div class="vi-step-num">2</div>
            <span class="vi-step-label">Configuración</span>
        </div>
    </div>

    <!-- Resumen colapsado -->
    <div class="vi-wb-resumen">
        <button type="button" class="vi-wb-resumen-btn" id="vi-resumen-toggle" onclick="viToggleResumen()">
            <span class="vi-wb-resumen-dot"></span>
            <span>Resumen</span>
            <span id="vi-wb-tipo-mini">Sin seleccionar</span>
            <i class="fas fa-chevron-down chevron"></i>
        </button>
        <div class="vi-wb-dropdown" id="vi-wb-dropdown">
            <div class="vi-wb-dd-header">
                <div class="vi-wb-dd-title">
                    <i class="fas fa-industry"></i> Resumen VI
                </div>
                <span class="vi-wb-dd-badge">NUEVO</span>
            </div>
            <div class="vi-wb-dd-body">
                <div class="vi-wb-dd-row">
                    <span class="vi-wb-dd-lbl">Tipo de proceso</span>
                    <span class="vi-wb-dd-val" id="dd-tipo-name">Sin seleccionar</span>
                </div>
                <div class="vi-wb-dd-sep"></div>
                <div class="vi-wb-dd-row">
                    <span class="vi-wb-dd-lbl">Usuario</span>
                    <span class="vi-wb-dd-val" id="dd-vendedor">—</span>
                </div>
                <div class="vi-wb-dd-row">
                    <span class="vi-wb-dd-lbl">Sucursal</span>
                    <span class="vi-wb-dd-val" id="dd-sucursal">—</span>
                </div>
                <div class="vi-wb-dd-sep"></div>
                <div class="vi-wb-dd-step-row">
                    <div class="vi-wb-dd-step-num" id="dd-paso-num">1</div>
                    <div>
                        <div class="vi-wb-dd-step-name" id="dd-paso-name">Tipo de proceso</div>
                        <div class="vi-wb-dd-step-sub" id="dd-paso-sub">Selecciona el proceso industrial</div>
                    </div>
                </div>
            </div>
            <div class="vi-wb-dd-footer">
                <button type="button" class="vi-wb-dd-btn-primary" onclick="viEnviarFormulario()">
                    <i class="fas fa-paper-plane" style="font-size:11px"></i> Guardar y procesar
                </button>
                <button type="button" class="vi-wb-dd-btn-secondary" onclick="viGotoStep(1); viToggleResumen(true)">
                    <i class="fas fa-redo" style="font-size:10px"></i> Reiniciar selección
                </button>
            </div>
        </div>
    </div>
</div>

<!-- LAYOUT -->
<div class="vi-layout" id="vi-layout">
    <form id="vi-form-1" novalidate>
        @Html.AntiForgeryToken()

        <!-- PASO 1 -->
        <div class="vi-panel active" id="vi-panel-1">
            <div class="vi-section-card">
                <div class="vi-section-head">
                    <div class="vi-section-icon"><i class="fas fa-industry"></i></div>
                    <div>
                        <div class="vi-section-title">Selecciona el tipo de proceso industrial</div>
                        <div class="vi-section-sub">Elige la opción que mejor describa el documento que necesitas configurar</div>
                    </div>
                </div>
                <div class="vi-section-body">
                    <fieldset aria-required="true">
                        <legend class="visually-hidden">Tipo de proceso industrial</legend>
                        <div class="vi-type-grid">

                            <!-- Cotización Industrial -->
                            <div class="vi-type-card" data-option="cotizacion-industrial" onclick="viSelectCard(this)">
                                <input type="radio" value="cotizacionIndustrialV" class="proceso" name="proceso" id="cotizacion-industrial" autocomplete="off" required>
                                <div class="vi-card-check"><i class="fas fa-check"></i></div>
                                <div class="vi-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M9 11H7v9a2 2 0 0 0 2 2h8a2 2 0 0 0 2-2V9h-2v8a1 1 0 0 1-1 1H9v-7z" />
                                        <path d="M13 2.05v3.03c3.39.49 6 3.39 6 6.92 0 .9-.18 1.75-.5 2.54l3.58 3.58A11.9 11.9 0 0 0 24 12c0-6.08-4.36-11.12-10.13-11.95z" />
                                        <path d="M12 19c-3.87 0-7-3.13-7-7 0-3.53 2.61-6.43 6-6.92V2.05C5.87.95 1 5.92 1 12c0 6.08 4.92 11 11 11 1.66 0 3.24-.37 4.65-1.02l-2.54-2.54A6.9 6.9 0 0 1 12 19z" />
                                    </svg>
                                </div>
                                <div class="vi-card-title">Cotización industrial</div>
                                <div class="vi-card-desc">Proyectos con especificaciones técnicas, costos de ingeniería y plazos de fabricación.</div>
                                <span class="vi-card-chip vi-chip-oferta">Etapa: oferta</span>
                            </div>

                            <!-- Pedido Industrial -->
                            <div class="vi-type-card" data-option="pedido-industrial" onclick="viSelectCard(this)">
                                <input type="radio" value="pedidoIndustrialV" class="proceso" name="proceso" id="pedido-industrial" autocomplete="off" required>
                                <div class="vi-card-check"><i class="fas fa-check"></i></div>
                                <div class="vi-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" />
                                        <path d="M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zm0 4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
                                    </svg>
                                </div>
                                <div class="vi-card-title">Pedido industrial</div>
                                <div class="vi-card-desc">Órdenes de compra para maquinaria pesada con hitos de fabricación y certificaciones.</div>
                                <span class="vi-card-chip vi-chip-produccion">Etapa: producción</span>
                            </div>

                            <!-- Remisión Industrial -->
