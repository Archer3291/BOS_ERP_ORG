@model List<BOS_ERP.Models.SolicitudCreditoVM>
@{
    ViewBag.Title = "Solicitudes pendientes de crédito";
    string fmt(decimal v) => v.ToString("C", new System.Globalization.CultureInfo("es-MX"));
    var totalExcedente = Model.Sum(x => x.Excedente);
    var totalPedidos = Model.Sum(x => x.MontoPedido);
}
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<style>
    /* ─── Estilos de la vista ─── */
    .section-icon {
        width: 32px;
        height: 32px;
        border-radius: 8px;
        background: var(--primary-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .section-title {
        font-size: .95rem;
        font-weight: 700;
        color: var(--primary-blue);
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 0;
    }

    .badge-pending {
        background: color-mix(in srgb, var(--warning-color) 12%, transparent);
        color: var(--warning-color);
        font-size: 10px;
        font-weight: 700;
        padding: 3px 10px;
        border-radius: var(--badge-radius);
        border: 1px solid color-mix(in srgb, var(--warning-color) 30%, transparent);
    }

    .stat-card {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius);
        padding: 14px 18px;
        box-shadow: var(--shadow);
        transition: var(--transition-fast);
    }

        .stat-card:hover {
            box-shadow: var(--shadow-lg);
            transform: translateY(-1px);
        }

    .stat-label {
        font-size: 10px;
        text-transform: uppercase;
        letter-spacing: .07em;
        color: var(--text-light);
        margin-bottom: 3px;
    }

    .stat-value {
        font-size: 1.3rem;
        font-weight: 700;
        color: var(--text-dark);
    }

        .stat-value.danger {
            color: var(--danger-color);
        }

        .stat-value.success {
            color: var(--success-color);
        }

        .stat-value.accent {
            color: var(--accent-blue);
        }

    .table-card {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

        .table-card thead tr {
            background: var(--primary-blue);
        }

        .table-card thead th {
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .07em;
            color: #fff;
            border: none;
            padding: 11px 14px;
            font-weight: 600;
        }

        .table-card tbody td {
            padding: 11px 14px;
            vertical-align: middle;
            border-bottom: 1px solid var(--border-light);
            font-size: 13px;
            color: var(--text-dark);
            transition: background var(--transition-fast);
        }

        .table-card tbody tr:last-child td {
            border-bottom: none;
        }

        .table-card tbody tr:hover td {
            background: var(--light-blue);
        }

    .folio-badge {
        font-family: monospace;
        font-size: 11px;
        background: color-mix(in srgb, var(--accent-blue) 10%, transparent);
        color: var(--accent-blue);
        padding: 3px 8px;
        border-radius: 5px;
        border: 1px solid color-mix(in srgb, var(--accent-blue) 25%, transparent);
        font-weight: 600;
    }

    .excedente-val {
        color: var(--danger-color);
        font-weight: 700;
    }

    .fecha-text {
        font-size: 11px;
        color: var(--text-light);
    }

    .btn-aprobar {
        background: color-mix(in srgb, var(--success-color) 12%, transparent);
        color: var(--success-color);
        border: 1px solid color-mix(in srgb, var(--success-color) 30%, transparent);
        font-size: 11px;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: var(--row-radius);
        transition: var(--transition-fast);
    }

        .btn-aprobar:hover {
            background: var(--success-color);
            color: #fff;
            border-color: var(--success-color);
        }

    .btn-rechazar {
        background: color-mix(in srgb, var(--danger-color) 10%, transparent);
        color: var(--danger-color);
        border: 1px solid color-mix(in srgb, var(--danger-color) 25%, transparent);
        font-size: 11px;
        font-weight: 600;
        padding: 5px 11px;
        border-radius: var(--row-radius);
        transition: var(--transition-fast);
    }

        .btn-rechazar:hover {
            background: var(--danger-color);
            color: #fff;
            border-color: var(--danger-color);
        }

    @@media (max-width: 768px) {
        .col-hide-sm {
            display: none !important;
        }
    }
</style>

<div class="container-fluid mt-4 px-3 px-md-4">

    <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
        <div class="section-icon">
            <svg width="16" height="16" viewBox="0 0 20 20" fill="none">
                <rect x="2" y="4" width="16" height="13" rx="2" stroke="#fff" stroke-width="1.5" />
                <path d="M2 8h16" stroke="#fff" stroke-width="1.5" />
                <circle cx="6" cy="12" r="1.5" fill="#fff" />
            </svg>
        </div>
        <h5 class="section-title">
            Autorización de pedidos — Crédito excedido
            @if (Model.Any())
            {
                <span class="badge-pending">
                    @Model.Count pendiente@(Model.Count != 1 ? "s" : "")
                </span>
            }
        </h5>
    </div>

    @if (!Model.Any())
    {
        <div class="alert rounded-3"
             style="background:color-mix(in srgb,var(--success-color) 10%,transparent);
                    color:var(--success-color);
                    border:1px solid color-mix(in srgb,var(--success-color) 25%,transparent);">
            No hay solicitudes pendientes de autorización.
        </div>
    }
    else
    {
        <div class="row g-2 mb-3">
            <div class="col-6 col-md-4">
                <div class="stat-card">
                    <div class="stat-label">Solicitudes</div>
                    <div class="stat-value accent">@Model.Count</div>
                </div>
            </div>
            <div class="col-6 col-md-4">
                <div class="stat-card">
                    <div class="stat-label">Total excedente</div>
                    <div class="stat-value danger">@fmt(totalExcedente)</div>
                </div>
            </div>
            <div class="col-12 col-md-4">
                <div class="stat-card">
                    <div class="stat-label">Monto total pedidos</div>
                    <div class="stat-value success">@fmt(totalPedidos)</div>
                </div>
            </div>
        </div>

        <div class="contenedor-tabla" id="contenedor-tablaCotPendientes">
            <div class="table-card">
                <div class="table-responsive">
                    <table class="modern-table" id="tblSolicitudes">
                        <thead>
                            <tr>
                                <th>Folio</th>
                                <th>Cliente</th>
                                <th class="col-hide-sm">Límite</th>
                                <th class="col-hide-sm">Usado</th>
                                <th>Total pedido</th>
                                <th>Excedente</th>
                                <th class="col-hide-sm">Fecha</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in Model)
                            {
                                <tr id="row-@s.PedidoId">
                                    <td><span class="folio-badge">@s.Folio</span></td>
                                    <td><span style="font-weight:600;">@s.NombreCliente</span></td>
                                    <td class="col-hide-sm">@fmt(s.CreditoLimite)</td>
                                    <td class="col-hide-sm">@fmt(s.CreditoUsado)</td>
                                    <td><strong>@fmt(s.MontoPedido)</strong></td>
                                    <td><span class="excedente-val">@fmt(s.Excedente)</span></td>
                                    <td class="col-hide-sm">
                                        <span class="fecha-text">
                                            @s.FechaSolicitud.ToString("dd/MM/yy HH:mm")
                                        </span>
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <button class="btn btn-aprobar btn-accion"
                                                    data-id="@s.PedidoId"
                                                    data-folio="@s.Folio"
                                                    data-tipo="Aprobar">
                                                ✓ Aprobar
                                            </button>
                                            <button class="btn btn-rechazar btn-accion"
                                                    data-id="@s.PedidoId"
                                                    data-folio="@s.Folio"
                                                    data-tipo="Rechazar">
                                                ✕ Rechazar
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function getCssVar(name) {
            return getComputedStyle(document.documentElement).getPropertyValue(name).trim();
        }

        document.querySelectorAll('.btn-accion').forEach(btn => {
            btn.addEventListener('click', () => {
                const { id, folio, tipo } = btn.dataset;
                const esAprobar = tipo === 'Aprobar';
                const confirmColor = getCssVar(esAprobar ? '--success-color' : '--danger-color');
                const cancelColor = getCssVar('--secondary-blue');

                Swal.fire({
                    title: esAprobar ? '¿Aprobar pedido?' : '¿Rechazar pedido?',
                    html: `Pedido <strong>${folio}</strong> será
                                           ${esAprobar
                            ? `<span style="color:${confirmColor};font-weight:700;">aprobado</span>`
                            : `<span style="color:${confirmColor};font-weight:700;">rechazado</span>`}.`,
                    icon: esAprobar ? 'question' : 'warning',
                    showCancelButton: true,
                    confirmButtonText: esAprobar ? '✓ Sí, aprobar' : '✕ Sí, rechazar',
                    cancelButtonText: 'Cancelar',
                    confirmButtonColor: confirmColor,
                    cancelButtonColor: cancelColor,
                    reverseButtons: true,
                    focusCancel: true
                }).then(async result => {
                    if (!result.isConfirmed) return;

                    const url = esAprobar ? '/VIPedido/Aprobar' : '/VIPedido/Rechazar';
                    try {
                        const res = await fetch(url, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                            body: `pedidoId=${id}`
                        });
                        const data = await res.json();

                        if (data.success) {
                            await Swal.fire({
                                title: esAprobar ? '¡Pedido aprobado!' : 'Pedido rechazado',
                                html: `El pedido <strong>${folio}</strong> fue procesado correctamente.`,
                                icon: esAprobar ? 'success' : 'error',
                                timer: 2200, timerProgressBar: true, showConfirmButton: false
                            });
                            document.getElementById(`row-${id}`)?.remove();
                            const remaining = document.querySelectorAll('#tblSolicitudes tbody tr').length;
                            if (remaining === 0) location.reload();
                        } else {
                            Swal.fire({
                                title: 'Error', text: data.message, icon: 'error',
                                confirmButtonColor: getCssVar('--accent-blue')
                            });
                        }
                    } catch {
                        Swal.fire({
                            title: 'Error de conexión',
                            text: 'No se pudo procesar la solicitud. Intenta de nuevo.',
                            icon: 'error',
                            confirmButtonColor: getCssVar('--accent-blue')
                        });
                    }
                });
            });
        });
    </script>
}
