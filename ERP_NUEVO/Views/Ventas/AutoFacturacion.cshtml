/* ════════════════════════════════════════════
   ANIMATED BACKGROUND CANVAS
════════════════════════════════════════════ */
(function () {
    const canvas = document.getElementById('af-bg-canvas');
    const ctx    = canvas.getContext('2d');

    const CONFIG = {
        nodeCount:      120,
        nodeBaseRadius: 2.4,
        nodePulseAmp:   1.1,
        nodeSpeed:      0.28,
        connectDist:    180,
        lineOpacityMax: 0.25,
        dotOpacity:     0.25,
        colorA:         [37, 99, 235],    /* blue */
        colorB:         [16, 185, 129],   /* emerald */
        bgColor:        '#0d1e33',
        pulseSpeed:     0.025
    };

    let W, H, nodes = [];

    function resize() {
        W = canvas.width  = window.innerWidth;
        H = canvas.height = window.innerHeight;
    }
    window.addEventListener('resize', resize);
    resize();

    function mkNode() {
        const angle = Math.random() * Math.PI * 2;
        const speed = CONFIG.nodeSpeed * (0.4 + Math.random() * 0.6);
        return {
            x: Math.random() * W, y: Math.random() * H,
            vx: Math.cos(angle) * speed, vy: Math.sin(angle) * speed,
            r: CONFIG.nodeBaseRadius * (0.7 + Math.random() * 0.6),
            phase: Math.random() * Math.PI * 2,
            t: Math.random()
        };
    }
    for (let i = 0; i < CONFIG.nodeCount; i++) nodes.push(mkNode());

    function lerpColor(a, b, t) {
        return [
            Math.round(a[0] + (b[0]-a[0])*t),
            Math.round(a[1] + (b[1]-a[1])*t),
            Math.round(a[2] + (b[2]-a[2])*t)
        ];
    }

    function draw() {
        ctx.fillStyle = CONFIG.bgColor;
        ctx.fillRect(0, 0, W, H);

        /* grid sutil */
        ctx.strokeStyle = 'rgba(37,99,235,0.035)';
        ctx.lineWidth   = 1;
        const G = 68;
        for (let x=0; x<W; x+=G) { ctx.beginPath(); ctx.moveTo(x,0); ctx.lineTo(x,H); ctx.stroke(); }
        for (let y=0; y<H; y+=G) { ctx.beginPath(); ctx.moveTo(0,y); ctx.lineTo(W,y); ctx.stroke(); }

        /* mover nodos */
        nodes.forEach(n => {
            n.x += n.vx; n.y += n.vy;
            if (n.x < -10) n.x = W+10;
            if (n.x > W+10) n.x = -10;
            if (n.y < -10) n.y = H+10;
            if (n.y > H+10) n.y = -10;
            n.phase += CONFIG.pulseSpeed;
        });

        /* conexiones */
        for (let i=0; i<nodes.length; i++) {
            for (let j=i+1; j<nodes.length; j++) {
                const a=nodes[i], b=nodes[j];
                const dx=a.x-b.x, dy=a.y-b.y;
                const d=Math.sqrt(dx*dx+dy*dy);
                if (d > CONFIG.connectDist) continue;
                const alpha = (1-d/CONFIG.connectDist)*CONFIG.lineOpacityMax;
                const [r,g,bl] = lerpColor(CONFIG.colorA, CONFIG.colorB, (a.t+b.t)/2);
                ctx.beginPath(); ctx.moveTo(a.x,a.y); ctx.lineTo(b.x,b.y);
                ctx.strokeStyle = `rgba(${r},${g},${bl},${alpha})`;
                ctx.lineWidth = 1; ctx.stroke();
            }
        }

        /* puntos */
        nodes.forEach(n => {
            const radius = n.r + Math.sin(n.phase)*CONFIG.nodePulseAmp;
            const [r,g,b] = lerpColor(CONFIG.colorA, CONFIG.colorB, n.t);
            ctx.beginPath();
            ctx.arc(n.x, n.y, radius, 0, Math.PI*2);
            ctx.fillStyle = `rgba(${r},${g},${b},${CONFIG.dotOpacity})`;
            ctx.fill();
        });

        /* viñeta radial suave */
        const vig = ctx.createRadialGradient(W/2,H/2,H*0.15, W/2,H/2,H*0.75);
        vig.addColorStop(0, 'rgba(13,30,51,0)');
        vig.addColorStop(1, 'rgba(7,17,31,0.45)');
        ctx.fillStyle = vig;
        ctx.fillRect(0, 0, W, H);

        requestAnimationFrame(draw);
    }
    draw();
})();

/* ════════════════════════════════════════════
   CONFIG
════════════════════════════════════════════ */
const AF_STEPS = {
    1: { name: 'Folio de compra',  sub: 'Ingresa tu número de ticket' },
    2: { name: 'Datos fiscales',   sub: 'RFC, régimen y uso del CFDI' },
    3: { name: 'Vista previa',     sub: 'Revisa antes de timbrar' },
    4: { name: 'Descarga',         sub: 'CFDI timbrado y listo' }
};

const AF_EMISOR = {
    nombre:  '@Html.Raw(Context.Session.GetString("EmpresaNombre") ?? "COMERCIALIZADORA EL NORTE SA DE CV")',
    rfc:     '@Html.Raw(Context.Session.GetString("EmpresaRFC")    ?? "CEN200101ABC")',
    regimen: '601 · General de Ley Personas Morales',
    cp:      '@Html.Raw(Context.Session.GetString("EmpresaCP")     ?? "78000")',
    lugar:   '@Html.Raw(Context.Session.GetString("EmpresaLugar")  ?? "78000, San Luis Potosí, S.L.P.")'
};

let afStep            = 1;
let ticketActual      = null;
let datosActual       = null;
let ticketTokenActual = null;

/* ════════════════════════════════════════════
   HELPERS
════════════════════════════════════════════ */
const fmt = n => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(n);
const $el  = id => document.getElementById(id);

function afPost(url, data) {
    const body  = new URLSearchParams();
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (token) body.append('__RequestVerificationToken', token);
    Object.entries(data).forEach(([k, v]) => body.append(k, v));
    return fetch(url, {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString()
    }).then(r => {
        if (!r.ok) throw new Error('HTTP ' + r.status);
        return r.json();
    });
}

/* ════════════════════════════════════════════
   SUMMARY DROPDOWN
════════════════════════════════════════════ */
function afToggleSummary(forceClose) {
    const btn  = $el('af-summary-btn');
    const dd   = $el('af-summary-dd');
    const open = dd.classList.contains('open');
    if (forceClose || open) {
        dd.classList.remove('open'); btn.classList.remove('open');
    } else {
        dd.classList.add('open');    btn.classList.add('open');
    }
}

document.addEventListener('click', function(e) {
    const wrap = document.querySelector('.af-progress-summary');
    if (wrap && !wrap.contains(e.target)) {
        $el('af-summary-dd')?.classList.remove('open');
        $el('af-summary-btn')?.classList.remove('open');
    }
});

/* ════════════════════════════════════════════
   NAVIGATION
════════════════════════════════════════════ */
function afGoto(target) {
    if (target > afStep && !afValidateStep(afStep)) return;

    document.querySelectorAll('.af-panel').forEach((p, i) => {
        p.classList.toggle('is-active', i+1 === target);
    });
    document.querySelectorAll('.af-step').forEach(s => {
        const n = parseInt(s.dataset.step);
        s.classList.remove('is-active','is-done');
        if (n === target) s.classList.add('is-active');
        if (n < target)   s.classList.add('is-done');
    });

    afStep = target;
    $el('af-prog-fill').style.width = (afStep/4*100) + '%';
    afUpdateSummary();
    window.scrollTo({ top: 0, behavior: 'smooth' });
}

function afValidateStep(step) {
    if (step === 1) {
        if (!ticketActual) {
            const err = $el('err-folio');
            err.textContent = 'Primero busca y selecciona un folio.';
            err.classList.add('is-visible');
            return false;
        }
        return true;
    }
    if (step === 2) return afValidarCampos();
    return true;
}

/* ════════════════════════════════════════════
   PASO 1 — FOLIO
════════════════════════════════════════════ */
function afBuscarFolio() {
    const val   = $el('inp-folio').value.trim().toUpperCase();
    const errEl = $el('err-folio');
    const inpEl = $el('inp-folio');

    errEl.classList.remove('is-visible');
    inpEl.classList.remove('is-error');

    if (!val) {
        errEl.textContent = 'Ingresa un folio.';
        errEl.classList.add('is-visible');
        inpEl.classList.add('is-error');
        return;
    }

    const btn = document.querySelector('[onclick="afBuscarFolio()"]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Buscando...';

   const AF_PUNTO = document.getElementById('af-punto').value;

afPost('@Url.Action("BuscarFolio", "AutoFacturacionPublica")', { punto: AF_PUNTO, folio: val })
        .then(function(res) {
            if (!res?.success) {
                errEl.textContent = res?.message ?? 'Folio no encontrado.';
                errEl.classList.add('is-visible');
                inpEl.classList.add('is-error');
                return;
            }
            ticketActual      = res.ticket;
            ticketTokenActual = res.ticket.ticketToken;
            afRenderTicket(res.ticket);

            if (res.ticket.rfc)         $el('inp-rfc').value   = res.ticket.rfc;
            if (res.ticket.razonSocial) $el('inp-razon').value = res.ticket.razonSocial;
            if (res.ticket.correo)      $el('inp-email').value = res.ticket.correo;
            if (res.ticket.cp)          $el('inp-cp').value    = res.ticket.cp;
            if (res.ticket.regimen)     [...$el('inp-regimen').options].forEach(o => { if (o.value===res.ticket.regimen) o.selected=true; });
            if (res.ticket.usoCfdi)     [...$el('inp-uso').options].forEach(o => { if (o.value===res.ticket.usoCfdi) o.selected=true; });

            $el('af-ticket-found').style.display = 'block';
            $el('af-tb-folio').textContent = res.ticket.folio;
            afUpdateSummary();
        })
        .catch(function() {
            errEl.textContent = 'Error al consultar el folio. Intenta de nuevo.';
            errEl.classList.add('is-visible');
        })
        .finally(function() {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-search" style="font-size:.78rem"></i> Buscar';
        });
}

function afRenderTicket(t) {
    $el('tc-folio').textContent = t.folio;
    $el('tc-date').textContent  = t.fecha;
    $el('tc-items').textContent = t.conceptos.length + ' concepto' + (t.conceptos.length>1?'s':'') + ' · ' + t.sucursal;
    $el('tc-total').textContent = fmt(t.total);
    $el('dt-total').textContent = fmt(t.total);

    $el('tb-conceptos').innerHTML =
        t.conceptos.map(c =>
            '<tr><td>' + c.desc + '</td>'
            + '<td class="mono text-center">' + c.cant + '</td>'
            + '<td class="mono">' + fmt(c.pu) + '</td>'
            + '<td class="mono" style="font-weight:600">' + fmt(c.sub) + '</td></tr>'
        ).join('')
        + '<tr style="background:rgba(255,255,255,0.04)">'
        +   '<td colspan="3" style="font-weight:600;font-size:.74rem;color:rgba(255,255,255,.45)">Subtotal</td>'
        +   '<td class="mono" style="font-weight:600">' + fmt(t.subtotal) + '</td></tr>'
        + '<tr style="background:rgba(255,255,255,0.04)">'
        +   '<td colspan="3" style="font-weight:600;font-size:.74rem;color:rgba(255,255,255,.45)">IVA (16%)</td>'
        +   '<td class="mono" style="font-weight:600">' + fmt(t.iva) + '</td></tr>';
}

function afResetFolio() {
    $el('inp-folio').value = '';
    $el('af-ticket-found').style.display = 'none';
    ticketActual = null;
    ticketTokenActual = null;
    $el('af-tb-folio').textContent = 'Sin folio';
    afUpdateSummary();
}

$el('inp-folio').addEventListener('keydown', e => { if (e.key==='Enter') afBuscarFolio(); });

/* ════════════════════════════════════════════
   PASO 2 — DATOS FISCALES
════════════════════════════════════════════ */
function afValidarCampos() {
    let ok = true;
    const fields = [
        ['inp-rfc',     'err-rfc',     v => /^([A-ZÑ&]{3,4})(\d{6})([A-Z0-9]{3})$/.test(v), 'RFC inválido.'],
        ['inp-razon',   'err-razon',   v => v.length > 2,                                      'Campo requerido.'],
        ['inp-regimen', 'err-regimen', v => v !== '',                                           'Selecciona un régimen.'],
        ['inp-uso',     'err-uso',     v => v !== '',                                           'Selecciona el uso del CFDI.'],
        ['inp-cp',      'err-cp',      v => /^\d{5}$/.test(v),                                 'CP de 5 dígitos.'],
        ['inp-email',   'err-email',   v => /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(v),          'Correo inválido.']
    ];

    fields.forEach(([inpId, errId, validate, msg]) => {
        const el  = $el(inpId);
        const err = $el(errId);
        const val = el.value.trim();
        if (!validate(val)) {
            err.textContent = msg;
            err.classList.add('is-visible');
            el.classList.add('is-error');
            ok = false;
        } else {
            err.classList.remove('is-visible');
            el.classList.remove('is-error');
        }
    });
    return ok;
}

function afValidarDatos() {
    if (!afValidarCampos()) return;
    datosActual = {
        rfc:          $el('inp-rfc').value.trim(),
        razon:        $el('inp-razon').value.trim(),
        regimen:      $el('inp-regimen').value,
        regimenLabel: $el('inp-regimen').options[$el('inp-regimen').selectedIndex].text,
        uso:          $el('inp-uso').value,
        usoLabel:     $el('inp-uso').options[$el('inp-uso').selectedIndex].text,
        cp:           $el('inp-cp').value.trim(),
        email:        $el('inp-email').value.trim()
    };
    afRenderPreview();
    afGoto(3);
}

/* ════════════════════════════════════════════
   PASO 3 — PREVIEW
════════════════════════════════════════════ */
