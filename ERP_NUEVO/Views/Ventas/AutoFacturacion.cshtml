/* ════════════════════════════════════════════
   PASO 4 — TIMBRAR
════════════════════════════════════════════ */
function afTimbrar() {
    if (afStep < 3) {
        if (!afValidateStep(afStep)) return;
        afGoto(afStep+1);
        return;
    }

    const btn = $el('btn-timbrar');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Timbrando...';
    const AF_PUNTO = document.getElementById('af-punto').value;
    const val   = $el('inp-folio').value.trim().toUpperCase();
    afPost('@Url.Action("TimbrarCFDI", "AutoFacturacionPublica")', {
        punto: AF_PUNTO, folio: val ,
        ticketToken: ticketTokenActual,
        rfc:     datosActual.rfc,
        razon:   datosActual.razon,
        regimen: datosActual.regimen,
        uso:     datosActual.uso,
        cp:      datosActual.cp,
        email:   datosActual.email
    })
    .then(function(res) {
        if (!res?.success) { afToast('error', res?.message ?? 'Error al timbrar.'); return; }
        $el('folio-fiscal-chip').textContent = 'UUID: ' + res.uuid;
        $el('email-enviado').textContent     = datosActual.email;
        $el('inp-reenvio').value             = datosActual.email;
        afGoto(4);

        if (res.correoEnviado === false) {
            afToast('warning', 'La factura se timbró, pero no se pudo enviar el correo. Descárgala aquí.');
        }

        // Ticket imprimible del CFDI. Se guarda para el botón de reimpresión y se manda
        // a imprimir solo, ya con la factura emitida y el correo enviado.
        if (res.ticketUrl) {
            afTicketUrl = res.ticketUrl;
            $el('btn-ticket')?.classList.remove('d-none');
            afImprimirTicket(true);
        }
    })
    .catch(function() { afToast('error', 'Error de conexión. Intenta de nuevo.'); })
    .finally(function() {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane"></i> Confirmar y timbrar';
    });
}

/* ════════════════════════════════════════════
   TICKET IMPRIMIBLE DEL CFDI
════════════════════════════════════════════ */
let afTicketUrl = null;

/* El enlace va firmado y vence a los 30 minutos: si el cliente vuelve más tarde,
   se le pide reimprimir desde mostrador en vez de mostrar un 404 sin explicación. */
function afImprimirTicket(automatico) {
    if (!afTicketUrl) {
        afToast('error', 'El ticket ya no está disponible. Solicítalo en mostrador.');
        return;
    }

    const v = window.open(afTicketUrl + '&print=1', 'ticketFactura', 'width=420,height=780');

    if (!v && !automatico) {
        afToast('error', 'Permite las ventanas emergentes para imprimir el ticket.');
    } else if (!v && automatico) {
        /* Con la impresión automática el bloqueo del navegador es lo normal:
           no se molesta al cliente con un error, se le deja el botón. */
        afToast('info', 'Usa el botón "Imprimir ticket" para obtener tu comprobante.');
    }
}

/* ════════════════════════════════════════════
   DOWNLOAD & RESEND
════════════════════════════════════════════ */
function afDescargar(tipo) {
    const uuid = $el('folio-fiscal-chip').textContent.replace('UUID: ','').trim();
    window.location.href = '@Url.Action("Descargar", "AutoFacturacionPublica")'
        + '?tipo=' + tipo + '&uuid=' + encodeURIComponent(uuid);
}

function afReenviar() {
    const mail = $el('inp-reenvio').value.trim();
    if (!/^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/.test(mail)) { afToast('error', 'Ingresa un correo válido.'); return; }
    const uuid = $el('folio-fiscal-chip').textContent.replace('UUID: ','').trim();
    afPost('@Url.Action("ReenviarCFDI", "AutoFacturacionPublica")', { email: mail, uuid })
        .then(res => afToast(res.success ? 'success' : 'error', res.message))
        .catch(() => afToast('error', 'Error al reenviar.'));
}

/* ════════════════════════════════════════════
   TOAST
════════════════════════════════════════════ */
function afToast(icon, title) {
    if (typeof toastMixin !== 'undefined') { toastMixin.fire({ icon, title }); }
    else { alert(title); }
}

/* ════════════════════════════════════════════
   RESET
════════════════════════════════════════════ */
function afReset() {
    ticketActual = datosActual = ticketTokenActual = null;
    ['inp-folio','inp-rfc','inp-razon','inp-cp','inp-email','inp-reenvio'].forEach(id => { const el=$el(id); if(el) el.value=''; });
    ['inp-regimen','inp-uso'].forEach(id => { const el=$el(id); if(el) el.value=''; });
    $el('af-ticket-found').style.display = 'none';
    $el('af-tb-folio').textContent = 'Sin folio';
    document.querySelectorAll('.af-error').forEach(e => e.classList.remove('is-visible'));
    document.querySelectorAll('.af-input,.af-select').forEach(e => e.classList.remove('is-error'));
    afStep = 1;
    document.querySelectorAll('.af-panel').forEach((p,i) => p.classList.toggle('is-active', i===0));
    document.querySelectorAll('.af-step').forEach(s => {
        s.classList.remove('is-active','is-done');
        if (parseInt(s.dataset.step)===1) s.classList.add('is-active');
    });
    $el('af-prog-fill').style.width = '25%';
    afUpdateSummary();
}

/* ════════════════════════════════════════════
   SUMMARY UPDATE
════════════════════════════════════════════ */
function afUpdateSummary() {
    const p = AF_STEPS[afStep];
    $el('dd-step-num').textContent  = afStep;
    $el('dd-step-name').textContent = p?.name ?? '—';
    $el('dd-step-sub').textContent  = p?.sub  ?? '';
    $el('dd-folio').textContent     = ticketActual?.folio ?? 'Sin seleccionar';
    $el('dd-total').textContent     = ticketActual ? fmt(ticketActual.total) : '—';
    $el('af-wb-folio-mini').textContent = ticketActual?.folio ?? 'Sin folio';
    $el('dd-rfc').textContent   = datosActual?.rfc   ?? '—';
    $el('dd-razon').textContent = datosActual?.razon ?? '—';
}
        /* ════════════════════════════════════════════
           QR SCANNER
        ════════════════════════════════════════════ */
        let qrStream = null;
        let qrRafId = null;
        let qrDetected = false;

        function afAbrirQR() {
            qrDetected = false;
            const overlay = $el('af-qr-overlay');
            overlay.classList.add('open');
            afQRSetStatus('', '<i class="fas fa-camera" style="font-size:.8rem"></i> Apunta la cámara al código QR de tu ticket');

            navigator.mediaDevices.getUserMedia({ video: { facingMode: 'environment' } })
                .then(function (stream) {
                    qrStream = stream;
                    const video = $el('af-qr-video');
                    video.srcObject = stream;
                    video.play();
                    video.addEventListener('loadedmetadata', afQRTick, { once: true });
                })
                .catch(function (err) {
                    afQRSetStatus('err', '<i class="fas fa-exclamation-circle"></i> Sin acceso a la cámara. Verifica los permisos.');
                    console.warn('QR cam error:', err);
                });
        }

        function afCerrarQR() {
            $el('af-qr-overlay').classList.remove('open');
            if (qrRafId) { cancelAnimationFrame(qrRafId); qrRafId = null; }
            if (qrStream) { qrStream.getTracks().forEach(t => t.stop()); qrStream = null; }
            const video = $el('af-qr-video');
            video.srcObject = null;
        }

        function afQROverlayClick(e) {
            if (e.target === $el('af-qr-overlay')) afCerrarQR();
        }

        function afQRTick() {
            if (!qrStream) return;
            const video = $el('af-qr-video');
            const canvas = $el('af-qr-canvas');
            const ctx = canvas.getContext('2d');

            if (video.readyState !== video.HAVE_ENOUGH_DATA) {
                qrRafId = requestAnimationFrame(afQRTick);
                return;
            }

            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);

            const imageData = ctx.getImageData(0, 0, canvas.width, canvas.height);
            const code = jsQR(imageData.data, imageData.width, imageData.height, { inversionAttempts: 'dontInvert' });

            if (code && !qrDetected) {
                qrDetected = true;
                const raw = code.data.trim();

                /* Extraer el folio del contenido QR:
                   · Si el QR es solo el folio (ej. "TKT-2024-00412") → úsalo directo
                   · Si es una URL con ?folio=XXX o /folio/XXX → extrae el parámetro
                   · Si lleva JSON → intenta parsear y tomar campo folio/ticket/id      */
                let folio = afExtraerFolioQR(raw);

                afQRSetStatus('ok', '<i class="fas fa-check-circle"></i> QR detectado · <strong>' + folio + '</strong>');

                setTimeout(function () {
                    afCerrarQR();
                    $el('inp-folio').value = folio;
                    $el('err-folio').classList.remove('is-visible');
                    $el('inp-folio').classList.remove('is-error');
                    afBuscarFolio();
                }, 700);

                return; /* no seguir con rAF */
            }

            qrRafId = requestAnimationFrame(afQRTick);
        }

        /* Heurística para extraer el folio del payload del QR */
        function afExtraerFolioQR(raw) {
            /* 1. JSON */
            try {
                const obj = JSON.parse(raw);
                return String(obj.folio ?? obj.ticket ?? obj.id ?? obj.numero ?? raw).toUpperCase();
            } catch (_) { }

            /* 2. URL con query string ?folio=XXX o ?ticket=XXX */
            try {
                const url = new URL(raw);
                const params = url.searchParams;
                const val = params.get('folio') ?? params.get('ticket') ?? params.get('id');
                if (val) return val.toUpperCase();
                /* 3. Segmento de ruta final */
                const segs = url.pathname.split('/').filter(Boolean);
                if (segs.length) return segs[segs.length - 1].toUpperCase();
            } catch (_) { }

            /* 4. Texto plano — quitar espacios y convertir a mayúsculas */
            return raw.replace(/\s+/g, '').toUpperCase();
        }

        function afQRSetStatus(type, html) {
            const el = $el('af-qr-status');
            el.className = 'af-qr-status' + (type ? ' ' + type : '');
            el.innerHTML = html;
        }
/* INIT */
afUpdateSummary();

/* Si el ticket se escaneó con la cámara del teléfono, el folio llega en la URL:
   se busca solo para que el cliente no tenga que teclear ni pulsar nada. */
(function () {
    const precargado = $el('inp-folio')?.value.trim();
    if (precargado) {
        document.addEventListener('DOMContentLoaded', afBuscarFolio);
        if (document.readyState !== 'loading') afBuscarFolio();
    }
})();
    </script>

