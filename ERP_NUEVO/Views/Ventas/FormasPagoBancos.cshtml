@{
    ViewBag.Title = "Formas de Pago y Cuentas Bancarias";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        .fpb-header {
            background: linear-gradient(135deg, #0f766e 0%, #134e4a 100%);
            color: #fff;
            padding: 28px 32px;
            border-radius: 14px;
            margin-bottom: 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 16px;
            box-shadow: 0 4px 24px rgba(15, 118, 110, .25);
        }

            .fpb-header h1 {
                font-size: 1.6rem;
                font-weight: 700;
                margin: 0;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .fpb-header p {
                margin: 4px 0 0;
                opacity: .85;
                font-size: .95rem;
                max-width: 62ch;
            }

        .fpb-alcance {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            background: #fff;
            border: 1px solid #e5e7eb;
            border-radius: 12px;
            padding: 14px 18px;
            margin-bottom: 20px;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }

            .fpb-alcance label {
                font-size: .8rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .04em;
                color: #6b7280;
                margin: 0;
            }

            .fpb-alcance select {
                min-width: 260px;
                padding: .5rem .75rem;
                border: 1px solid #d1d5db;
                border-radius: 8px;
                font-size: .92rem;
            }

            .fpb-alcance .hint {
                font-size: .84rem;
                color: #6b7280;
            }

        .fpb-aviso {
            background: #fef3c7;
            border: 1px solid #fcd34d;
            color: #92400e;
            border-radius: 10px;
            padding: 12px 16px;
            margin-bottom: 20px;
            font-size: .9rem;
        }

        .fpb-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(340px, 1fr));
            gap: 16px;
        }

        .fpb-card {
            background: #fff;
            border: 1px solid #e5e7eb;
            border-left: 5px solid #0f766e;
            border-radius: 12px;
            padding: 16px 18px;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
            display: flex;
            flex-direction: column;
        }

            .fpb-card.sin-config {
                border-left-color: #d1d5db;
            }

            .fpb-card.heredada {
                border-left-color: #b45309;
            }

        .fpb-card-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            margin-bottom: 12px;
        }

        .fpb-forma {
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 700;
            color: #111827;
        }

            .fpb-forma i {
                color: #0f766e;
                width: 20px;
                text-align: center;
            }

        .fpb-cve {
            background: #ccfbf1;
            color: #115e59;
            border-radius: 50px;
            padding: .1rem .55rem;
            font-size: .74rem;
            font-weight: 700;
        }

        .fpb-cuentas {
            list-style: none;
            margin: 0 0 12px;
            padding: 0;
            flex: 1;
        }

            .fpb-cuentas li {
                display: flex;
                align-items: flex-start;
                gap: 8px;
                padding: .45rem 0;
                border-bottom: 1px solid #f3f4f6;
                font-size: .88rem;
            }

                .fpb-cuentas li:last-child {
                    border-bottom: 0;
                }

        .fpb-cuenta-nombre {
            font-weight: 600;
            color: #111827;
        }

        .fpb-cuenta-codigo {
            display: block;
            font-size: .78rem;
            color: #6b7280;
            font-variant-numeric: tabular-nums;
        }

        .fpb-badge {
            display: inline-block;
            border-radius: 50px;
            padding: .12rem .5rem;
            font-size: .7rem;
            font-weight: 700;
            white-space: nowrap;
        }

            .fpb-badge.default {
                background: #d1fae5;
                color: #065f46;
            }

            .fpb-badge.sin-cuenta {
                background: #fee2e2;
                color: #991b1b;
            }

            .fpb-badge.hereda {
                background: #fef3c7;
                color: #92400e;
            }

        .fpb-vacio {
            font-size: .86rem;
            color: #6b7280;
            padding: .5rem 0 1rem;
        }

        .fpb-btn {
            border: 1px solid #0f766e;
            background: #0f766e;
            color: #fff;
            border-radius: 8px;
            padding: .45rem .9rem;
            font-size: .86rem;
            font-weight: 600;
            cursor: pointer;
        }

            .fpb-btn.ghost {
                background: #fff;
                color: #0f766e;
            }

        /* ── Modal de asignación ── */
        .fpb-buscador {
            width: 100%;
            padding: .55rem .85rem;
            border: 1px solid #d1d5db;
            border-radius: 8px;
            font-size: .92rem;
            margin-bottom: 12px;
        }

        .fpb-lista-bancos {
            max-height: 46vh;
            overflow-y: auto;
            border: 1px solid #e5e7eb;
            border-radius: 10px;
        }

        .fpb-banco {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: .6rem .85rem;
            border-bottom: 1px solid #f3f4f6;
        }

            .fpb-banco:last-child {
                border-bottom: 0;
            }

            .fpb-banco.oculto {
                display: none;
            }

            .fpb-banco .info {
                flex: 1;
                min-width: 0;
            }

            .fpb-banco .nombre {
                font-weight: 600;
                font-size: .9rem;
                color: #111827;
            }

            .fpb-banco .codigo {
                font-size: .78rem;
                color: #6b7280;
                font-variant-numeric: tabular-nums;
            }

            .fpb-banco .pred {
                display: flex;
                align-items: center;
                gap: 6px;
                font-size: .78rem;
                color: #6b7280;
                white-space: nowrap;
            }

        .fpb-modal-nota {
            font-size: .82rem;
            color: #6b7280;
            margin-top: 10px;
        }

        [data-theme="dark"] .fpb-alcance,
        [data-theme="dark"] .fpb-card {
            background: #1f2937;
            border-color: #374151;
        }

        [data-theme="dark"] .fpb-forma,
        [data-theme="dark"] .fpb-cuenta-nombre,
        [data-theme="dark"] .fpb-banco .nombre {
            color: #f9fafb;
        }

        @@media (max-width: 640px) {
            .fpb-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
}

<div class="fpb-header">
    <div>
        <h1><i class="fas fa-university"></i> Formas de Pago y Cuentas Bancarias</h1>
        <p>
            Define en qué cuenta de banco entra el dinero de cada forma de pago del punto de venta.
            Si una forma de pago tiene una sola cuenta, el POS la usa sin preguntar; si tiene varias,
            el cajero elige cuál se usa al cobrar y al facturar.
        </p>
    </div>
    <button class="btn btn-light" onclick="cargarConfiguracion()">
        <i class="fas fa-sync-alt"></i> Actualizar
    </button>
</div>

<div class="fpb-alcance">
    <label for="selSucursal">Alcance</label>
    <select id="selSucursal" onchange="cargarConfiguracion()">
        <option value="0">Todas las sucursales</option>
    </select>
    <span class="hint" id="hintAlcance">
        Lo configurado para una sucursal concreta gana sobre la configuración general.
    </span>
</div>

<div id="aviso"></div>

<div class="fpb-grid" id="grid"></div>


<!-- ════════ Modal: asignar cuentas a una forma de pago ════════ -->
<div class="modal fade" id="modalAsignar" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h6 class="modal-title d-flex align-items-center gap-2">
                    <i class="fas fa-university"></i>
                    <span id="modalTitulo">Cuentas de la forma de pago</span>
                </h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <input type="search" id="buscadorBancos" class="fpb-buscador"
                       placeholder="Buscar por nombre, cuenta contable o número de cuenta..."
                       oninput="filtrarBancos()" autocomplete="off">

                <div class="fpb-lista-bancos" id="listaBancos"></div>

                <p class="fpb-modal-nota" id="notaHerencia" style="display:none;"></p>

                <p class="fpb-modal-nota">
                    Marca las cuentas que puede usar esta forma de pago y señala cuál es la
                    predeterminada. Si dejas todas sin marcar, la configuración se elimina y el
                    punto de venta vuelve a ofrecer el catálogo completo.
                </p>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" id="btnGuardar" onclick="guardarAsignacion()">
                    <i class="fas fa-save"></i> Guardar
                </button>
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        let bancos = [];
        let formas = [];
        let formaEnEdicion = null;
        let configurable = true;

        document.addEventListener('DOMContentLoaded', cargarConfiguracion);

        function sucursalSeleccionada() {
            return parseInt(document.getElementById('selSucursal').value, 10) || 0;
        }

        async function cargarConfiguracion() {
            try {
                const data = await GetData({
                    path: '/PuntoVentaAdministracion/ObtenerConfiguracionFormasPago',
                    data: { sucursal: sucursalSeleccionada() }
                });

                if (!data || !data.success) {
                    Swal.fire({ icon: 'error', title: 'Error', text: (data && data.message) || 'No se pudo cargar la configuración.' });
                    return;
                }

                bancos = data.bancos || [];
                formas = data.formas || [];
                configurable = data.configurable !== false;

                pintarSucursales(data.sucursales || [], data.sucursal || 0);
                pintarAviso(configurable ? '' : data.message);
                render();
            } catch (e) {
                Swal.fire({ icon: 'error', title: 'Error inesperado', text: String(e) });
            }
        }

        function pintarSucursales(lista, seleccionada) {
            const sel = document.getElementById('selSucursal');
            if (sel.dataset.cargado === '1') return;

            sel.innerHTML = '<option value="0">Todas las sucursales</option>'
                + lista.map(s => `<option value="${s.id_sucursal}">${s.cve_sucursal} - ${s.descripcion || ''}</option>`).join('');
            sel.value = String(seleccionada || 0);
            sel.dataset.cargado = '1';
        }

        function pintarAviso(mensaje) {
            document.getElementById('aviso').innerHTML = mensaje
                ? `<div class="fpb-aviso"><i class="fas fa-triangle-exclamation"></i> ${mensaje}</div>`
                : '';
        }

        function render() {
            const grid = document.getElementById('grid');
            const enSucursal = sucursalSeleccionada() !== 0;

            grid.innerHTML = formas.map(f => {
                const propias = f.cuentas || [];
                const heredadas = f.heredadas || [];
                const usaHeredadas = propias.length === 0 && heredadas.length > 0;
                const mostrar = propias.length > 0 ? propias : heredadas;

                let clase = 'fpb-card';
                if (usaHeredadas) clase += ' heredada';
                else if (propias.length === 0) clase += ' sin-config';

                let cuerpo;
                if (mostrar.length === 0) {
                    cuerpo = `<p class="fpb-vacio">
                                  Sin cuentas asignadas. El punto de venta ofrece el catálogo completo
                                  de bancos para esta forma de pago.
                              </p>`;
                } else {
                    cuerpo = `<ul class="fpb-cuentas">
                        ${mostrar.map(c => `
                            <li>
                                <div style="flex:1; min-width:0;">
                                    <span class="fpb-cuenta-nombre">${c.nombre || ''}</span>
                                    <span class="fpb-cuenta-codigo">${c.cuenta_contable || ''}${c.cuenta_banco ? ' · ' + c.cuenta_banco : ''}</span>
                                </div>
                                ${c.predeterminada ? '<span class="fpb-badge default">Predeterminada</span>' : ''}
                                ${c.contabilizable ? '' : '<span class="fpb-badge sin-cuenta" title="No tiene cuenta en cuentas_finanzas: la póliza del cobro fallaría">Sin cuenta contable</span>'}
                            </li>`).join('')}
                    </ul>`;
                }

                const nota = usaHeredadas
                    ? '<div style="margin-bottom:10px;"><span class="fpb-badge hereda">Heredadas de Todas las sucursales</span></div>'
                    : '';

                return `
                    <div class="${clase}">
                        <div class="fpb-card-head">
                            <div class="fpb-forma">
                                <i class="fas ${f.icono}"></i>
                                <span>${f.descripcion}</span>
                            </div>
                            <span class="fpb-cve">${f.cve_sat}</span>
                        </div>
                        ${nota}
                        ${cuerpo}
                        <div>
                            <button class="fpb-btn ${propias.length ? '' : 'ghost'}"
                                    onclick="abrirModal(${f.id_f_pago})"
                                    ${configurable ? '' : 'disabled'}>
                                <i class="fas fa-sliders"></i>
                                ${propias.length ? 'Editar cuentas' : (enSucursal && heredadas.length ? 'Configurar para esta sucursal' : 'Asignar cuentas')}
                            </button>
                        </div>
                    </div>`;
            }).join('');

            if (!formas.length) {
                grid.innerHTML = `<div class="fpb-aviso">
                    No se encontraron las formas de pago del punto de venta en el catálogo cat_f_pago.
                </div>`;
            }
        }

        /* ─── Modal ─── */

        function abrirModal(idFPago) {
            formaEnEdicion = formas.find(f => f.id_f_pago === idFPago);
            if (!formaEnEdicion) return;

            const asignadas = (formaEnEdicion.cuentas && formaEnEdicion.cuentas.length)
                ? formaEnEdicion.cuentas
                : [];

            const ids = asignadas.map(c => c.banco_id);
            const pred = (asignadas.find(c => c.predeterminada) || {}).banco_id;

            document.getElementById('modalTitulo').textContent =
                `Cuentas para ${formaEnEdicion.descripcion} (${formaEnEdicion.cve_sat})`;
            document.getElementById('buscadorBancos').value = '';

            // Al configurar una sucursal que hoy hereda de "Todas las sucursales", el
            // modal arranca vacío a propósito: lo que se guarde aquí deja de heredar.
            const nota = document.getElementById('notaHerencia');
            const heredadas = formaEnEdicion.heredadas || [];
            if (!asignadas.length && heredadas.length) {
                nota.innerHTML = `Hoy esta sucursal hereda de <strong>Todas las sucursales</strong>:
                    ${heredadas.map(c => c.nombre).join(', ')}. Lo que guardes aquí sustituye esa
                    herencia sólo para esta sucursal.`;
                nota.style.display = 'block';
            } else {
                nota.style.display = 'none';
            }

            document.getElementById('listaBancos').innerHTML = bancos.map(b => `
                <div class="fpb-banco" data-busqueda="${(`${b.nombre} ${b.cuenta_contable} ${b.cuenta_banco || ''}`).toLowerCase()}">
                    <input type="checkbox" class="form-check-input mt-0 chk-banco"
                           value="${b.banco_id}" ${ids.includes(b.banco_id) ? 'checked' : ''}
                           onchange="sincronizarPredeterminada(this)">
                    <div class="info">
                        <div class="nombre">
                            ${b.nombre || ''}
                            ${b.contabilizable ? '' : '<span class="fpb-badge sin-cuenta">Sin cuenta contable</span>'}
                        </div>
                        <div class="codigo">${b.cuenta_contable || ''}${b.cuenta_banco ? ' · ' + b.cuenta_banco : ''}</div>
                    </div>
                    <label class="pred">
                        <input type="radio" name="predeterminada" class="form-check-input mt-0"
                               value="${b.banco_id}" ${pred === b.banco_id ? 'checked' : ''}
                               ${ids.includes(b.banco_id) ? '' : 'disabled'}>
                        Predeterminada
                    </label>
                </div>`).join('');

            if (!bancos.length) {
                document.getElementById('listaBancos').innerHTML =
                    '<div style="padding:1rem; color:#6b7280;">No hay cuentas de banco dadas de alta en el catálogo.</div>';
            }

            bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAsignar')).show();
        }

        // El radio de "predeterminada" sólo tiene sentido en cuentas marcadas; al
        // desmarcar una cuenta que era la predeterminada, se libera la selección.
        function sincronizarPredeterminada(chk) {
            const fila = chk.closest('.fpb-banco');
            const radio = fila.querySelector('input[type="radio"]');
            radio.disabled = !chk.checked;
            if (!chk.checked) radio.checked = false;
        }

        function filtrarBancos() {
            const texto = document.getElementById('buscadorBancos').value.trim().toLowerCase();
            document.querySelectorAll('#listaBancos .fpb-banco').forEach(fila => {
                fila.classList.toggle('oculto', texto !== '' && !fila.dataset.busqueda.includes(texto));
            });
        }

        async function guardarAsignacion() {
            if (!formaEnEdicion) return;

            const seleccionados = Array.from(document.querySelectorAll('#listaBancos .chk-banco:checked'))
                .map(c => parseInt(c.value, 10));

            const radioPred = document.querySelector('#listaBancos input[name="predeterminada"]:checked');
            const predeterminada = radioPred ? parseInt(radioPred.value, 10) : (seleccionados[0] || 0);

            if (seleccionados.length === 0) {
                const confirmar = await Swal.fire({
                    icon: 'warning',
                    title: 'Quitar la configuración',
                    text: 'Sin cuentas asignadas, el punto de venta volverá a ofrecer el catálogo completo para esta forma de pago.',
                    showCancelButton: true,
                    confirmButtonText: 'Sí, quitar',
                    cancelButtonText: 'Cancelar'
                });
                if (!confirmar.isConfirmed) return;
            }

            const btn = document.getElementById('btnGuardar');
            btn.disabled = true;

            try {
                const resp = await GetData({
                    path: '/PuntoVentaAdministracion/GuardarCuentasFormaPago',
                    data: {
                        fPagoId: formaEnEdicion.id_f_pago,
                        sucursal: sucursalSeleccionada(),
                        bancos: seleccionados,
                        predeterminada: predeterminada
                    }
                });

                if (resp && resp.icon === 'success') {
                    bootstrap.Modal.getOrCreateInstance(document.getElementById('modalAsignar')).hide();
                    toastMixin.fire({ icon: 'success', title: resp.title });
                    await cargarConfiguracion();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: (resp && resp.title) || 'No se pudo guardar',
                        text: (resp && resp.html) || ''
                    });
                }
            } catch (e) {
                Swal.fire({ icon: 'error', title: 'Error inesperado', text: String(e) });
            } finally {
                btn.disabled = false;
            }
        }
    </script>
}
