    // ============================================
    // TICKETS DE VENTAS PENDIENTES
    // ============================================
    // Se abre en un modal y no navegando a Pendientes de Entrega: el cajero puede estar a
    // media venta y perdería el carrito. Reutiliza el mismo endpoint que esa pantalla.
    async function abrirTicketsPendientes() {
        Swal.fire({
            title: 'Consultando ventas pendientes',
            didOpen: () => Swal.showLoading(),
            allowOutsideClick: false,
            showConfirmButton: false
        });

        try {
            const r = await fetch('/PuntoDeVenta/ObtenerTicketsPendientes');
            const data = await r.json();

            if (data.sessionExpired) {
                Swal.fire({ icon: 'warning', title: 'Sesión expirada', text: data.message })
                    .then(() => window.location.reload());
                return;
            }

            if (!data.success) {
                Swal.fire({ icon: 'error', title: 'No se pudo consultar', text: data.message || 'Error desconocido' });
                return;
            }

            const ventas = data.ventas || [];

            if (ventas.length === 0) {
                Swal.fire({
                    icon: 'info',
                    title: 'Nada pendiente',
                    text: `No hay ventas sin facturar, con pago parcial ni con material por entregar en los últimos ${data.resumen.dias} días.`
                });
                return;
            }

            // Una venta puede caer en varias situaciones a la vez; se etiquetan todas.
            const etiqueta = (txt, color, fondo) =>
                `<span style="display:inline-block; background:${fondo}; color:${color};
                        border-radius:4px; padding:1px 6px; font-size:.7rem; font-weight:600;
                        margin-right:4px;">${txt}</span>`;

            const filas = ventas.map(v => {
                const tags = [
                    v.sinFacturar ? etiqueta('Sin facturar', '#7c2d12', '#ffedd5') : '',
                    v.pagoParcial ? etiqueta('Pago parcial', '#7f1d1d', '#fee2e2') : '',
                    v.articulosPendientes > 0
                        ? etiqueta(`Falta entregar (${v.articulosPendientes})`, '#1e3a8a', '#dbeafe') : ''
                ].join('');

                return `
                <tr>
                    <td style="text-align:left; padding:.5rem .4rem; border-bottom:1px solid #e5e7eb;">
                        <div style="font-weight:600;">${v.folio || '(sin folio)'}</div>
                        <div style="font-size:.78rem; color:#6b7280; margin:.15rem 0;">
                            ${v.cliente || 'Sin cliente'} · ${v.fecha} · hace ${v.dias} día(s)
                        </div>
                        <div>${tags}</div>
                    </td>
                    <td style="text-align:right; padding:.5rem .4rem; border-bottom:1px solid #e5e7eb; white-space:nowrap;">
                        <div style="font-weight:600; margin-bottom:.3rem;">$${Number(v.total).toFixed(2)}</div>
                        ${v.importePendiente > 0
                            ? `<div style="font-size:.72rem; color:#b45309; margin-bottom:.3rem;">
                                   por cobrar $${Number(v.importePendiente).toFixed(2)}</div>` : ''}
                        <button type="button" class="swal2-styled"
                                style="background:#059669; margin:0; padding:.35rem .7rem; font-size:.8rem;"
                                onclick="imprimirTicketVenta(${v.ventaId})">
                            <i class="fas fa-print"></i> Ticket
                        </button>
                    </td>
                </tr>`;
            }).join('');

            const res = data.resumen;

            Swal.fire({
                title: `<i class="fas fa-receipt"></i> Tickets pendientes`,
                html: `
                    <p style="font-size:.85rem; color:#6b7280; margin-bottom:.75rem;">
                        ${res.total} venta(s) en los últimos ${res.dias} días ·
                        ${res.sinFacturar} sin facturar ·
                        ${res.pagoParcial} con pago parcial ·
                        ${res.faltaEntregar} con material por entregar
                    </p>
                    <div style="max-height:52vh; overflow-y:auto;">
                        <table style="width:100%; border-collapse:collapse;">${filas}</table>
                    </div>`,
                width: '720px',
                showConfirmButton: true,
                confirmButtonText: 'Cerrar'
            });

        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error de conexión', text: e.message });
        }
    }

    // ============================================
    // TICKET DE MOSTRADOR
    // ============================================
    // Se abre en ventana aparte con ?print=1 para que dispare el diálogo de impresión
    // solo. El ticket se arma del encabezado de la VENTA, que es donde están los cobros
    // y los pendientes de entrega.
    function imprimirTicketVenta(ventaId) {
        if (!ventaId) return;

        const ventana = window.open(`/PuntoDeVenta/Ticket/${ventaId}?print=1`,
            'ticketVenta', 'width=420,height=760');

        if (!ventana) {
            Swal.showValidationMessage?.('');
            alert('El navegador bloqueó la ventana emergente. Permite las ventanas emergentes de este sitio para imprimir el ticket.');
        }
    }

