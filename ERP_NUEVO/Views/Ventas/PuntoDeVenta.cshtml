    // El valor que viaja al servidor es el código de cuenta contable: es lo que
    // GenerarDatosPoliza usa para el asiento del cobro. Se ofrecen únicamente las
    // cuentas configuradas para la forma de pago elegida; si no hay ninguna, el
    // catálogo completo, para no dejar la caja sin poder facturar.
    function llenarCuentasBancoFactura(bancoPreferido) {
        const selForma = document.getElementById('facturaFormaPago');
        const selCuenta = document.getElementById('facturaCuentaBanco');
        const hint = document.getElementById('facturaCuentaBancoHint');
        if (!selForma || !selCuenta) return;

        const idFPago = parseInt(selForma.value, 10) || 0;
        const configuradas = CuentasBancoPos.porIdFPago(idFPago);
        const usaConfiguracion = configuradas.length > 0;
        const cuentas = usaConfiguracion ? configuradas : CuentasBancoPos.todas;

        const seleccionPrevia = selCuenta.value;

        selCuenta.innerHTML = '<option value="">Seleccione una cuenta...</option>'
            + cuentas.map(c => `
                <option value="${c.cuenta_contable || ''}" data-banco="${c.banco_id}">
                    ${c.nombre || ''}${c.cuenta_contable ? ' · ' + c.cuenta_contable : ''}
                </option>`).join('');

        const codigoDe = (bancoId) =>
            (cuentas.find(c => String(c.banco_id) === String(bancoId)) || {}).cuenta_contable || '';

        // Prioridad: la cuenta del cobro > la predeterminada de la forma de pago >
        // lo que ya estuviera seleccionado.
        let elegida = bancoPreferido ? codigoDe(bancoPreferido) : '';

        if (!elegida && usaConfiguracion) {
            const pred = CuentasBancoPos.predeterminada(configuradas);
            elegida = pred ? (pred.cuenta_contable || '') : '';
        }

        if (!elegida && cuentas.some(c => c.cuenta_contable === seleccionPrevia)) {
            elegida = seleccionPrevia;
        }

        selCuenta.value = elegida || '';

        // Con una sola cuenta configurada no hay nada que elegir.
        selCuenta.disabled = usaConfiguracion && cuentas.length === 1 && !!elegida;

        if (!hint) return;

        if (idFPago && !usaConfiguracion) {
            hint.textContent = 'Esta forma de pago no tiene cuentas configuradas; se muestra el catálogo completo.';
            hint.style.display = 'block';
        } else {
            hint.style.display = 'none';
        }
    }

