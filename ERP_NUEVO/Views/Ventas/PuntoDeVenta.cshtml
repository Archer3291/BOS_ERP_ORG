        // Ajusta la pantalla cuando se está entregando mercancía pendiente:
        // si ya se pagó en la venta original, se esconde la captura de pagos y el
        // total se muestra en cero. Antes seguía pidiendo el cobro y el cajero no
        // sabía si tenía que volver a cobrar.
        function aplicarModoEntrega() {
            const yaPagado = window.modoComplemento && !window.requiereCobroPendiente;
            const aCredito = window.ventaACredito === true;

            // En los dos casos la caja no recibe dinero, así que la captura de pagos
            // estorba: en la entrega porque ya se pagó, y a crédito porque el importe
            // se va a la cuenta del cliente.
            const sinCaptura = yaPagado || aCredito;

            const aviso = document.getElementById('avisoYaPagado');
            const contenedorPagos = document.getElementById('paymentMethodsContainer');
            const btnAgregarPago = document.querySelector('[onclick="openPaymentMethodSelector()"]');

            if (aviso) aviso.style.display = yaPagado ? 'block' : 'none';
            if (contenedorPagos) contenedorPagos.style.display = sinCaptura ? 'none' : '';
            if (btnAgregarPago) btnAgregarPago.style.display = sinCaptura ? 'none' : '';

            if (aCredito) {
                // El total sí importa —es lo que se va a cargar a la cartera—, así que
                // sólo se limpian los pagos y el cambio.
                selectedPaymentMethods = [];
                const changeRow = document.getElementById('changeRow');
                if (changeRow) changeRow.style.display = 'none';
                const box = document.getElementById('modoCobroBox');
                if (box) box.style.display = 'none';
            }

            if (yaPagado) {
                // Sin importe por cobrar: los totales de la entrega son informativos.
                selectedPaymentMethods = [];
                ['subtotal', 'discount', 'iva', 'grandTotal', 'totalDisplay'].forEach(id => {
                    const el = document.getElementById(id);
                    if (el) el.textContent = '$0.00';
                });
                const changeRow = document.getElementById('changeRow');
                if (changeRow) changeRow.style.display = 'none';
            }
        }

        // Aviso permanente mientras la cotización cargada sea a crédito: el cajero
        // tiene que ver de un golpe que aquí no se cobra y cómo va la línea del cliente.
        function mostrarBannerCredito() {
            const anterior = document.getElementById('banner-credito');
            if (anterior) anterior.remove();

            if (!window.ventaACredito) return;

            const c = window.creditoCliente || {};
            const money = n => `$${(parseFloat(n) || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
            const sinLimite = c.estatus === 'SIN_LIMITE';

            const detalle = sinLimite
                ? 'El cliente no tiene límite de crédito configurado.'
                : `Límite ${money(c.limite)} · Usado ${money(c.usado)} · <strong>Disponible ${money(c.disponible)}</strong>`;

            const alerta = (c.permitido === false)
                ? `<div style="margin-top:.5rem; font-weight:700; color:#991b1b;">
                       <i class="fas fa-triangle-exclamation"></i> ${c.mensaje || 'El crédito del cliente no alcanza para esta venta.'}
                   </div>`
                : '';

            const banner = document.createElement('div');
            banner.id = 'banner-credito';
