        // ✅ F8 - Solo abrir selector de pago con efectivo preseleccionado
        if (e.key === 'F8') {
            e.preventDefault();
            const totalText = document.getElementById('grandTotal').textContent.replace(/[$,]/g, '').trim();
            const total = parseFloat(totalText) || 0;

            if (total > 0) {
