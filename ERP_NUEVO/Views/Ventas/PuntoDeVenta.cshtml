    // ==================== PASO 5: FUNCIONES PRINCIPALES DE BÚSQUEDA Y CARGA ==================== -->

    // La pantalla de Pendientes de Entrega manda aquí con ?folio=...
    // para que el cajero no tenga que teclearlo.
    document.addEventListener('DOMContentLoaded', () => {
        const folio = new URLSearchParams(window.location.search).get('folio');
        if (!folio) return;

        const input = document.getElementById('searchFolio');
        if (!input) return;

        input.value = folio;
        searchAndLoadFolio();
