            // ═══════════════════════════════════════════════════════════════
            //  STEP 3 — VALIDACIONES  (usa appState.selectedCFDI real)
            // ═══════════════════════════════════════════════════════════════
            function buildValidations() {
                const cfdi = AppState.selectedCFDI;
                const tipo = AppState.selectedType;

                const checks = [
                    {
                        label: 'CFDI vigente en SAT',
                        ok: cfdi.estado.includes('vigente') || cfdi.estado.includes('timbra'),
                        msg: 'El CFDI ya fue cancelado o no está vigente'
                    },
                    {
                        label: 'Sin proceso de cancelación pendiente',
                        ok: !cfdi.estado.includes('pendiente'),
                        msg: 'Ya existe solicitud de cancelación activa'
                    },
                    { label: 'RFC emisor activo en SAT', ok: true, msg: '' },
                    { label: 'RFC receptor activo en SAT', ok: true, msg: '' },
                    {
                        label: 'Sin CFDI global relacionado',
                        ok: !['G', 'g'].includes(cfdi.tipo),
                        msg: 'Requiere egreso parcial del global primero'
                    },
                    { label: 'Período fiscal abierto', ok: true, msg: '' },
                    {
                        label: 'Sin complementos de pago activos',
                        ok: !(cfdi.tieneComplementos && tipo.id === 'metodo-pago'),
                        msg: cfdi.tieneComplementos && tipo.id === 'metodo-pago'
                            ? 'Debe cancelar los complementos de pago primero' : ''
                    },
                    {
                        label: 'Anticipo sin egresos relacionados',
                        ok: !(cfdi.anticipos.length > 0 && tipo.id === 'anticipo'),
                        msg: cfdi.anticipos.length > 0 && tipo.id === 'anticipo'
                            ? 'Verificar CFDI de egreso relacionado' : ''
                    },
                    { label: 'Moneda / tipo de cambio validado', ok: true, msg: '' },
                    { label: 'Sin retenciones pendientes', ok: true, msg: '' },
                ];

                document.getElementById('checklistPanel').innerHTML = checks.map(c => `
                                                                                                                                                                                                        <div class="checklist-item ${c.ok ? 'checked' : 'error'}">
                                                                                                                                                                                                          <div class="check-icon"><i class="fas ${c.ok ? 'fa-check' : 'fa-xmark'}"></i></div>
                                                                                                                                                                                                          <div>
                                                                                                                                                                                                            <div style="font-size:.85rem;font-weight:500;color:var(--text-dark)">${c.label}</div>
                                                                                                                                                                                                            ${!c.ok && c.msg
                        ? `<div style="font-size:.75rem;color:var(--danger-color)">${c.msg}</div>` : ''}
                                                                                                                                                                                                          </div>
                                                                                                                                                                                                        </div>`).join('');

                const hasErrors = checks.some(c => !c.ok);

                // Estado "validando": el veredicto final (badge + botón) lo decide el backend,
                // que es la fuente de verdad de la cadena documental (complementos/anticipos/notas).
                const badge = document.getElementById('validBadge');
                badge.className = 'status-badge pendiente';
                badge.innerHTML = `<i class="fas fa-spinner fa-spin" style="font-size:.7rem"></i> Validando...`;
                document.getElementById('btnStep3Next').disabled = true;

                buildFlow();
                aplicarValidacionBackend(hasErrors);
            }

            // Alerta compacta reutilizable.
            function _alertBox(kind, icon, title, msg) {
                return `<div class="alert-custom alert-${kind}-custom mb-2"><i class="fas ${icon}"></i>
                    <div><strong>${title}:</strong> ${esc(msg)}</div></div>`;
            }

            // Guía de "cómo desbloquear" + atajos a los módulos donde se resuelven los hijos.
            // Botón Revalidar: tras resolver afuera, re-corre la validación sin re-seleccionar el CFDI.
            function _guiaDesbloqueo(an) {
                let pasos = '';
                if ((an.complementosVigentes || 0) > 0)
                    pasos += `<li>Cancela los <strong>${an.complementosVigentes} complemento(s) de pago</strong> (del más reciente al más antiguo) en el módulo de complementos; luego regresa y pulsa <strong>Revalidar</strong>.</li>`;
                if ((an.notasAnticipo || 0) > 0)
                    pasos += `<li>Cancela la(s) <strong>${an.notasAnticipo} nota(s) de crédito por aplicación de anticipo</strong>; tras refacturar hay que volver a emitirla contra el CFDI nuevo.</li>`;
                if ((an.notasDebito || 0) > 0)
                    pasos += `<li>Resuelve/cancela las <strong>${an.notasDebito} nota(s) de débito</strong> relacionada(s).</li>`;
                if ((an.sustitutosVigentes || 0) > 0)
                    pasos += `<li>Ya existe un <strong>CFDI sustituto vigente</strong>; localízalo y confirma si esta refacturación todavía aplica.</li>`;
                if (!pasos) return '';

                let botones = `<button class="btn-secondary-custom btn-sm-custom" onclick="buildValidations()"><i class="fas fa-rotate"></i> Revalidar</button>`;
                if ((an.complementosVigentes || 0) > 0)
                    botones += ` <a class="btn-primary-custom btn-sm-custom" href="/CreditoCobranza/ComplementoPago" target="_blank" rel="noopener"><i class="fas fa-up-right-from-square"></i> Ir a Complementos de pago</a>`;

                return `<div class="alert-custom alert-warning-custom mb-2"><i class="fas fa-list-check"></i>
                    <div style="width:100%">
                        <strong>¿Cómo desbloquear?</strong> Primero se cancelan los documentos hijos y luego se refactura.
                        <ul style="margin:.4rem 0 .6rem 1.1rem;padding:0">${pasos}</ul>
                        <div style="display:flex;gap:.5rem;flex-wrap:wrap">${botones}</div>
                    </div></div>`;
            }

            // Riesgos informativos propios del tipo (los de complementos/anticipos ahora los
            // reporta el backend de forma autoritativa, así que aquí solo quedan los genéricos).
            function _riesgosDelTipo() {
                const tipo = AppState.selectedType;
                let html = '';
                if (tipo.risk === 'very-high')
                    html += _alertBox('danger', 'fa-radiation', 'Riesgo fiscal muy alto',
                        'Consulta con el área contable antes de proceder.');
                if (tipo.id === 'impuestos')
                    html += _alertBox('danger', 'fa-percent', 'Cambio de impuestos',
                        'Puede generar diferencias en declaraciones ya presentadas.');
                return html;
            }

            // Alerta informativa de las REMISIONES que originaron la factura. En este ERP el
            // inventario lo mueve la remisión, así que importa saber si la factura viene de varias
            // y/o si alguna quedó facturada parcialmente (eso habilita las 3 estrategias del Step 4).
            // Guarda el resultado en AppState.remisionesOrigen para que conceptos.js lo reutilice.
            async function _alertaRemisiones() {
                const cfdi = AppState.selectedCFDI;
                AppState.remisionesOrigen = null;

                let data;
                try {
                    const resp = await fetch(`${API.remisionesOrigen}?encabezadoId=${encodeURIComponent(cfdi.encabezadoId)}`);
                    data = await resp.json();
                } catch (e) { return ''; }

                if (!data || !data.success || !(data.remisiones || []).length) return '';
                AppState.remisionesOrigen = data;

                const filas = data.remisiones.map(r => {
                    const pend = (r.pendientes || []).map(p =>
                        `<li>${esc(p.cveprod)} ${esc(p.descripcion || '')} — pendiente <strong>${p.pendiente}</strong>
                         de ${p.cantidadoriginal}</li>`).join('');
                    return `<li><strong>${esc(r.folio || ('#' + r.encabezado))}</strong>
                        ${r.fecha ? ' · ' + new Date(r.fecha).toLocaleDateString('es-MX') : ''}
                        ${r.compartida ? ' <span class="status-badge cancelada">respalda otras facturas</span>' : ''}
                        ${pend ? `<ul style="margin:.25rem 0 .25rem 1rem">${pend}</ul>` : ''}</li>`;
                }).join('');

                let titulo, cuerpo, kind = 'info', icon = 'fa-truck-ramp-box';
                if (data.multiples) {
                    titulo = `Esta factura se compone de ${data.remisiones.length} remisiones`;
                    cuerpo = 'Al refacturar se cancelarán todas y se generará <strong>una sola remisión de variación</strong> con las partidas resultantes.';
                } else {
                    titulo = 'Remisión de origen';
                    cuerpo = 'Al refacturar se cancelará y se generará una <strong>remisión de variación</strong> con las partidas resultantes.';
                }
                if (data.tieneParciales) {
                    kind = 'warning'; icon = 'fa-triangle-exclamation';
                    cuerpo += ' Hay partidas <strong>pendientes de facturar</strong>; en el siguiente paso podrás elegir qué hacer con ellas.';
                }

                return `<div class="alert-custom alert-${kind}-custom mb-2"><i class="fas ${icon}"></i>
                    <div><strong>${titulo}:</strong> ${cuerpo}
                    <ul style="margin:.4rem 0 0 1rem">${filas}</ul></div></div>`;
            }

            // Validación autoritativa de la cadena documental (mismo AnalizadorDocumentos que el
            // backend usa para bloquear la ejecución). Bloquea el botón "Continuar" si hay bloqueos.
            async function aplicarValidacionBackend(clientHasErrors) {
                const cfdi = AppState.selectedCFDI;
                const tipo = AppState.selectedType;
                const btn = document.getElementById('btnStep3Next');
                const badge = document.getElementById('validBadge');

                let val;
                try {
                    const url = `${API.validarDocs}?encabezadoId=${encodeURIComponent(cfdi.encabezadoId)}&tipoId=${encodeURIComponent(tipo.id)}`;
                    const resp = await fetch(url);
                    val = await resp.json();
                } catch (e) {
                    // Sin validación no se avanza (el backend revalida igual al ejecutar).
                    val = {
                        puedeRefacturar: false,
                        bloqueos: ['No se pudo validar la cadena documental (error de conexión). Reintenta.'],
                        advertencias: [], sugerenciaNotaCredito: null
                    };
                }

                const bloqueos = val.bloqueos || [];
                const advertencias = val.advertencias || [];
                const puede = !!val.puedeRefacturar && !clientHasErrors;

                let html = '';
                bloqueos.forEach(b => html += _alertBox('danger', 'fa-ban', 'Bloqueo', b));
                if (!puede && bloqueos.length > 0)
                    html += _guiaDesbloqueo(val.analisis || {});
                html += await _alertaRemisiones();
                advertencias.forEach(a => html += _alertBox('warning', 'fa-triangle-exclamation', 'Advertencia', a));
                if (val.sugerenciaNotaCredito)
                    html += _alertBox('info', 'fa-lightbulb', 'Sugerencia', val.sugerenciaNotaCredito);
                html += _riesgosDelTipo();
                if (puede)
                    html += `<div class="alert-custom alert-success-custom"><i class="fas fa-circle-check"></i>
                        <div>Todas las validaciones pasaron. Puedes continuar con la configuración.</div></div>`;

                document.getElementById('riskAlerts').innerHTML = html;

                btn.disabled = !puede;
                if (puede) {
                    badge.className = 'status-badge vigente';
                    badge.innerHTML = `<i class="fas fa-check" style="font-size:.7rem"></i> Válido`;
                } else {
                    badge.className = 'status-badge cancelada';
                    badge.innerHTML = `<i class="fas fa-ban" style="font-size:.7rem"></i> ${bloqueos.length > 0 ? 'Bloqueado' : 'Con observaciones'}`;
                }
            }

