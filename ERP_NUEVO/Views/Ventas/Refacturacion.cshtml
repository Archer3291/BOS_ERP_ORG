            function buildResumenFiltros() {
                const partes = [];
                const uuid = document.getElementById('uuidInput')?.value.trim();
                const folio = document.getElementById('folioInput')?.value.trim();
                const rfc = document.getElementById('rfcInput')?.value.trim();
                const desde = document.getElementById('dateFrom')?.value;
                const hasta = document.getElementById('dateTo')?.value;
                const tipo = document.getElementById('tipoCFDI')?.value;
                const estado = document.getElementById('estadoSATSelect')?.value;

                if (uuid) partes.push('UUID: ' + uuid.substring(0, 8) + '…');
                if (folio) partes.push('Folio: ' + folio);
                if (rfc) partes.push('RFC: ' + rfc);
                if (desde && hasta) partes.push(fmtFecha(desde) + ' – ' + fmtFecha(hasta));
                if (tipo) partes.push(tipo);
                if (estado) partes.push(estado);

                return partes.length ? partes.join(' · ') : 'Sin filtros activos';
            }

