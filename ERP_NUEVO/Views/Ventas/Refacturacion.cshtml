            function goStep(n) {
                if (n === 2 && !AppState.selectedType) { showToast('warning', 'Selecciona un tipo de refacturación.'); return; }
                if (n === 3 && !AppState.selectedCFDI) { showToast('warning', 'Selecciona un CFDI original.'); return; }

                for (let i = 1; i <= 6; i++) {
                    const el = document.getElementById('step' + i);
                    if (el) el.style.display = 'none';
                }
                document.getElementById('step' + n).style.display = 'block';
                AppState.currentStep = n;
                updateWizard();

                // Al entrar al paso 2, siempre mostrar contraído
                if (n === 2) {
                    filtrosAbiertos = true;   // forzamos el estado opuesto
                    toggleFiltros();          // así toggleFiltros lo deja en cerrado (false)
                }

                if (n === 3) setTimeout(buildValidations, 400);
                if (n === 4) buildStep4();
                if (n === 5) buildStep5();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            function updateWizard() {
                const n = AppState.currentStep;
                document.querySelectorAll('.wizard-step').forEach(el => {
                    const s = parseInt(el.dataset.step);
                    el.classList.remove('active', 'done');
                    if (s === n) el.classList.add('active');
                    else if (s < n) el.classList.add('done');
                });
                document.querySelectorAll('.step-connector').forEach((c, i) => {
                    c.style.background = i < n - 1 ? 'var(--success-color)' : 'var(--border-light)';
                });
            }

