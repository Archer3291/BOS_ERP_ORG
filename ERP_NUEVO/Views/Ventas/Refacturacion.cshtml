            // ═══════════════════════════════════════════════════════════════
            //  EJECUCIÓN Y RESULTADO  (Step 6)
            // ═══════════════════════════════════════════════════════════════
            // Anima los pasos de ejecución (visual) sin bloquear la llamada al back.
            let _execIv = null;
            function _animateExecSteps() {
                const steps = document.querySelectorAll('#execStepsList .progress-step-item');
                let i = 0;
                _execIv = setInterval(() => {
                    if (i > 0 && steps[i - 1]) {
                        steps[i - 1].classList.remove('psi-active');
                        steps[i - 1].classList.add('psi-done');
                        const num = steps[i - 1].querySelector('.psi-num');
                        if (num) num.innerHTML = '<i class="fas fa-check" style="font-size:.6rem"></i>';
                    }
                    if (i < steps.length) { if (steps[i]) steps[i].classList.add('psi-active'); i++; }
                    else { clearInterval(_execIv); _execIv = null; }
                }, 500);
            }
            function _finishExecSteps() {
                if (_execIv) { clearInterval(_execIv); _execIv = null; }
                document.querySelectorAll('#execStepsList .progress-step-item').forEach(s => {
                    s.classList.remove('psi-active');
                    s.classList.add('psi-done');
                    const num = s.querySelector('.psi-num');
                    if (num) num.innerHTML = '<i class="fas fa-check" style="font-size:.6rem"></i>';
                });
            }

            // Guarda el último payload para poder reintentar con los mismos datos.
            let _lastRefactPayload = null;

            async function executeRefacturacion() {
                closeModal('modalConfirm', 'backdropConfirm');

                const tipo = AppState.selectedType;
                const cfdi = AppState.selectedCFDI;
                const handler = STEP4_HANDLERS[tipo?.id];

                // ── Armar el payload que espera EjecutarRefacturacion([FromBody] RefacturacionRequest) ──
                const cambios = handler && typeof handler.collectChanges === 'function'
                    ? handler.collectChanges(cfdi)
                    : {};

                const payload = {
                    tipoId: tipo?.id,
                    encabezadoIdOriginal: cfdi?.encabezadoId,
                    uuidOriginal: cfdi?.uuid,
                    rfcEmisor: cfdi?.rfcEmisor || '',
                    motivo: AppState.motivo || '01',
                    tipoRelacion: document.getElementById('tipoRelacion')?.value || handler?.tipoRelacion || '04',
                    cambios: cambios,
                };

                // Validaciones mínimas antes de tocar el back.
                if (!payload.encabezadoIdOriginal || !payload.uuidOriginal) {
                    showToast('error', 'Selecciona un CFDI válido antes de ejecutar.');
                    return;
                }

                _lastRefactPayload = payload;
                await _runRefacturacion(payload);
            }

            // Reintenta la refacturación con el mismo payload de la última ejecución.
            function retryRefacturacion() {
                if (!_lastRefactPayload) { showToast('error', 'No hay datos para reintentar.'); return; }
                showToast('info', 'Reintentando refacturación...');
                _runRefacturacion(_lastRefactPayload);
            }

            async function _runRefacturacion(payload) {
                goStep(6);
                _animateExecSteps();

                try {
                    const resp = await fetch(API.ejecutar, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload),
                    });

                    let data = {};
                    try { data = await resp.json(); } catch { data = {}; }

                    _finishExecSteps();

                    if (resp.ok && data.success) {
                        showResult(data.uuidNuevo, data.message, data.xmlUrl, data.pdfUrl);
                        showToast('success', data.message || '¡Refacturación completada con éxito!');
                    } else {
                        showResultError(data.message || `El servidor respondió ${resp.status}.`);
                        showToast('error', data.message || 'La refacturación falló.');
                    }
                } catch (err) {
                    console.error(err);
                    _finishExecSteps();
                    showResultError('No se pudo contactar al servidor: ' + err.message);
                    showToast('error', 'Error de red al ejecutar la refacturación.');
                }
            }

            // Descarga vía fetch + blob para NO navegar la página (evita la "recarga" al descargar).
            // El PDF se genera bajo demanda en el servidor; el toast cubre esa espera.
            async function descargarArchivo(url, filename) {
                try {
                    showToast('info', 'Preparando descarga...');
                    const resp = await fetch(url);
                    if (!resp.ok) {
                        let msg = resp.status;
                        try { msg = await resp.text(); } catch { }
                        showToast('error', 'No se pudo descargar: ' + msg);
                        return;
                    }
                    const blob = await resp.blob();
                    const blobUrl = URL.createObjectURL(blob);
                    const a = document.createElement('a');
                    a.href = blobUrl;
                    a.download = filename || 'archivo';
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    setTimeout(() => URL.revokeObjectURL(blobUrl), 2000);
                } catch (err) {
                    showToast('error', 'Error al descargar: ' + err.message);
                }
            }

