            function calcRow(inp, i) {
                const row = document.getElementById('cr-' + i);
                if (!row) return;
                const inputs = row.querySelectorAll('input[type=number]');
                const qty = parseFloat(inputs[0].value) || 0;
                const pu = parseFloat(inputs[1].value) || 0;
                const desc = parseFloat(inputs[2].value) || 0;
                const imp = qty * pu * (1 - desc / 100);
                const el = document.getElementById('imp-' + i);
                if (el) el.value = imp.toFixed(2);
                recalcTotals();
            }

            function recalcTotals() {
                let sub = 0;
                document.querySelectorAll('#conceptBody tr').forEach((r, i) => {
                    sub += parseFloat(document.getElementById('imp-' + i)?.value || 0) || 0;
                });
                const iva = sub * 0.16, total = sub + iva;
                const s = document.getElementById('summSubtotal');
                const v = document.getElementById('summIVA');
                const t = document.getElementById('summTotal');
                if (s) s.textContent = '$' + fmtMoney(sub);
                if (v) v.textContent = '$' + fmtMoney(iva);
                if (t) t.textContent = '$' + fmtMoney(total);
            }

            function removeRow(i) {
                const row = document.getElementById('cr-' + i);
                if (row) row.remove();
                recalcTotals();
            }

