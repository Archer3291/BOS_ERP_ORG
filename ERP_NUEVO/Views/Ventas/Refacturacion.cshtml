@{
    ViewBag.Title = "Refacturación";
    ViewBag.PageTitle = "Refacturación";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <style>

        /* ─── TOPBAR ─── */
        .topbar {
            background: var(--primary-blue);
            color: #fff;
            height: 60px;
            display: flex;
            align-items: center;
            padding: 0 1.5rem;
            gap: 1rem;
            box-shadow: var(--shadow-lg);
            position: static;
            top: 0;
            z-index: 1030;
        }

        .topbar-brand {
            font-weight: 700;
            font-size: 1.1rem;
            letter-spacing: 0.02em;
            color: #fff;
            display: flex;
            align-items: center;
            gap: .6rem;
        }

            .topbar-brand .badge-version {
                font-size: .65rem;
                background: rgba(255,255,255,0.18);
                border-radius: 20px;
                padding: 2px 8px;
                font-weight: 500;
            }

        .topbar-actions {
            margin-left: auto;
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .btn-topbar {
            background: rgba(255,255,255,0.12);
            border: 1px solid rgba(255,255,255,0.18);
            color: #fff;
            border-radius: 8px;
            padding: 5px 12px;
            font-size: .82rem;
            font-weight: 500;
            transition: background var(--transition-fast);
            cursor: pointer;
        }

            .btn-topbar:hover {
                background: rgba(255,255,255,0.22);
            }

        /* ─── BREADCRUMB ─── */
        .page-header {
            background: var(--bg-light);
            border-bottom: 1px solid var(--border-light);
            padding: .75rem 1.5rem;
        }

        .breadcrumb {
            margin: 0;
            font-size: .82rem;
        }

        .breadcrumb-item a {
            color: var(--accent-blue);
            text-decoration: none;
        }

        .breadcrumb-item.active {
            color: var(--text-light);
        }

        .page-title {
            font-size: 1.4rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
        }

        .page-subtitle {
            font-size: .84rem;
            color: var(--text-light);
            margin: 0;
        }

        /* ─── CONTENT ─── */
        .main-content {
            padding: 1.5rem;
        }

        /* ─── STEP WIZARD ─── */
        .wizard-steps {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 1.5rem;
            overflow-x: auto;
            padding-bottom: .5rem;
        }

        .wizard-step {
            display: flex;
            align-items: center;
            gap: .5rem;
            flex: 1;
            min-width: 130px;
        }

        .step-circle {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--border-light);
            color: var(--text-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 700;
            font-size: .85rem;
            flex-shrink: 0;
            transition: all var(--transition-med);
            border: 2px solid var(--border-light);
        }

        .step-label {
            font-size: .78rem;
            color: var(--text-light);
            font-weight: 500;
            line-height: 1.2;
            transition: color var(--transition-fast);
        }

        .step-connector {
            height: 2px;
            flex: 1;
            background: var(--border-light);
            margin: 0 .25rem;
            transition: background var(--transition-med);
            min-width: 20px;
        }

        .wizard-step.active .step-circle {
            background: var(--accent-blue);
            border-color: var(--accent-blue);
            color: #fff;
            box-shadow: 0 0 0 4px rgba(59,130,246,0.18);
        }

        .wizard-step.active .step-label {
            color: var(--accent-blue);
            font-weight: 600;
        }

        .wizard-step.done .step-circle {
            background: var(--success-color);
            border-color: var(--success-color);
            color: #fff;
        }

        .wizard-step.done .step-label {
            color: var(--success-color);
        }

        .wizard-step.done + .step-connector {
            background: var(--success-color);
        }

        /* ─── CARDS ─── */
        .card-custom {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: var(--table-radius);
            box-shadow: var(--shadow);
            transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
        }

            .card-custom:hover {
                box-shadow: var(--shadow-lg);
            }

        .card-header-custom {
            padding: 1rem 1.25rem .75rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: .75rem;
        }

            .card-header-custom .card-title {
                font-weight: 700;
                font-size: 1rem;
                color: var(--text-dark);
                margin: 0;
                display: flex;
                align-items: center;
                gap: .5rem;
            }

                .card-header-custom .card-title i {
                    color: var(--accent-blue);
                }

        .card-body-custom {
            padding: 1.25rem;
        }

        /* ─── TIPO SELECTOR ─── */
        .type-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(210px, 1fr));
            gap: .85rem;
        }

        .type-card {
            border: 2px solid var(--border-light);
            border-radius: 12px;
            padding: 1rem;
            cursor: pointer;
            transition: all var(--transition-fast);
            background: var(--bg-gray);
            position: relative;
            overflow: hidden;
        }

            .type-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: transparent;
                transition: background var(--transition-fast);
            }

            .type-card:hover {
                border-color: var(--accent-blue);
                background: var(--bg-light);
                box-shadow: var(--shadow);
            }

                .type-card:hover::before {
                    background: var(--accent-blue);
                }

            .type-card.selected {
                border-color: var(--accent-blue);
                background: var(--bg-light);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
            }

                .type-card.selected::before {
                    background: var(--accent-blue);
                }

            .type-card.risk-high {
            }

                .type-card.risk-high:hover, .type-card.risk-high.selected {
                    border-color: var(--danger-color);
                }

                .type-card.risk-high::before {
                    background: var(--danger-color) !important;
                }

            .type-card.risk-med:hover, .type-card.risk-med.selected {
                border-color: var(--warning-color);
            }

            .type-card.risk-med::before {
                background: var(--warning-color) !important;
            }

            /* Tipos deshabilitados: solo "Corrección de Adenda" está disponible por ahora */
            .type-card-disabled,
            .type-card-disabled:hover {
                cursor: not-allowed;
                opacity: 0.45;
                filter: grayscale(0.85);
                border-color: var(--border-light) !important;
                background: var(--bg-gray);
                box-shadow: none;
                transform: none;
            }

                .type-card-disabled:hover::before {
                    background: transparent;
                }

        .type-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.2rem;
            margin-bottom: .6rem;
        }

            .type-icon.blue {
                background: rgba(59,130,246,0.12);
                color: var(--accent-blue);
            }

            .type-icon.orange {
                background: rgba(217,119,6,0.12);
                color: var(--warning-color);
            }

            .type-icon.red {
                background: rgba(220,38,38,0.12);
                color: var(--danger-color);
            }

            .type-icon.green {
                background: rgba(5,150,105,0.12);
                color: var(--success-color);
            }

            .type-icon.purple {
                background: rgba(99,102,241,0.12);
                color: var(--accent-purple);
            }

        .type-name {
            font-size: .88rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: .2rem;
        }

        .type-desc {
            font-size: .75rem;
            color: var(--text-light);
            line-height: 1.4;
        }

        .type-badge {
            display: inline-block;
            font-size: .65rem;
            font-weight: 600;
            border-radius: 20px;
            padding: 1px 7px;
            margin-top: .4rem;
        }

            .type-badge.low {
                background: rgba(5,150,105,0.12);
                color: var(--success-color);
            }

            .type-badge.med {
                background: rgba(217,119,6,0.12);
                color: var(--warning-color);
            }

            .type-badge.high {
                background: rgba(220,38,38,0.12);
                color: var(--danger-color);
            }

            .type-badge.very-high {
                background: rgba(220,38,38,0.18);
                color: var(--danger-color);
                border: 1px solid rgba(220,38,38,0.3);
            }

        /* ─── SEARCH CFDI ─── */
        .cfdi-search-box {
            display: flex;
            gap: .5rem;
            align-items: center;
        }

        .uuid-input {
            font-family: 'JetBrains Mono', monospace;
            font-size: .82rem;
            letter-spacing: .03em;
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            border-radius: 8px;
            padding: .55rem .9rem;
            color: var(--text-dark);
            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
            flex: 1;
        }

            .uuid-input:focus {
                outline: none;
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
                background: var(--bg-light);
            }

        .form-control-custom {
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            border-radius: 8px;
            padding: .55rem .9rem;
            color: var(--text-dark);
            font-size: .88rem;
            transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
            width: 100%;
        }

            .form-control-custom:focus {
                outline: none;
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
                background: var(--bg-light);
            }

        .form-label-custom {
            font-size: .8rem;
            font-weight: 600;
            color: var(--text-light);
            text-transform: uppercase;
            letter-spacing: .04em;
            margin-bottom: .35rem;
            display: block;
        }

        select.form-control-custom {
            appearance: none;
            background-repeat: no-repeat;
            background-position: right .75rem center;
            background-size: 14px;
            padding-right: 2rem;
            cursor: pointer;
        }

        /* ─── CFDI CARD RESULT ─── */
        .cfdi-result-card {
            border: 1.5px solid var(--border-light);
            border-radius: 12px;
            background: var(--bg-gray);
            padding: 1rem;
            transition: all var(--transition-fast);
        }

            .cfdi-result-card .cfdi-uuid {
                font-family: 'JetBrains Mono', monospace;
                font-size: .75rem;
                color: var(--text-light);
                word-break: break-all;
            }

            .cfdi-result-card .cfdi-amount {
                font-size: 1.2rem;
                font-weight: 700;
                color: var(--primary-blue);
            }

            .cfdi-result-card .cfdi-receptor {
                font-size: .88rem;
                font-weight: 600;
                color: var(--text-dark);
            }

            .cfdi-result-card:hover {
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.1), var(--shadow);
                transform: translateY(-1px);
                transition: all .15s ease;
            }

                .cfdi-result-card:hover .select-hint {
                    opacity: 1 !important;
                }

            .cfdi-result-card.selected {
                border-color: var(--accent-blue);
                background: var(--bg-light);
                box-shadow: 0 0 0 3px rgba(59,130,246,0.15);
            }

                .cfdi-result-card.selected > div:first-child {
                    background: rgba(59,130,246,0.06);
                }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: .3rem;
            padding: 3px 10px;
            border-radius: 20px;
            font-size: .73rem;
            font-weight: 600;
        }

            .status-badge.vigente {
                background: rgba(5,150,105,0.1);
                color: var(--success-color);
            }

            .status-badge.cancelado {
                background: rgba(220,38,38,0.1);
                color: var(--danger-color);
            }

            .status-badge.pendiente {
                background: rgba(217,119,6,0.1);
                color: var(--warning-color);
            }

            .status-badge.sustituido {
                background: rgba(99,102,241,0.1);
                color: var(--accent-purple);
            }

        /* ─── ALERT BOXES ─── */
        .alert-custom {
            border-radius: 10px;
            padding: .8rem 1rem;
            font-size: .84rem;
            display: flex;
            gap: .6rem;
            align-items: flex-start;
            border: 1.5px solid transparent;
        }

            .alert-custom i {
                flex-shrink: 0;
                margin-top: .1rem;
            }

        .alert-warning-custom {
            background: rgba(217,119,6,0.08);
            border-color: rgba(217,119,6,0.3);
            color: var(--warning-color);
        }

        .alert-danger-custom {
            background: rgba(220,38,38,0.08);
            border-color: rgba(220,38,38,0.3);
            color: var(--danger-color);
        }

        .alert-info-custom {
            background: rgba(59,130,246,0.08);
            border-color: rgba(59,130,246,0.3);
            color: var(--accent-blue);
        }

        .alert-success-custom {
            background: rgba(5,150,105,0.08);
            border-color: rgba(5,150,105,0.3);
            color: var(--success-color);
        }

        /* ─── TABLE ─── */
        .table-custom {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
        }

            .table-custom thead th {
                background: var(--bg-gray);
                color: var(--text-light);
                font-size: .75rem;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: .06em;
                padding: .65rem 1rem;
                border-bottom: 2px solid var(--border-light);
                white-space: nowrap;
            }

            .table-custom tbody tr {
                transition: background var(--transition-fast);
            }

                .table-custom tbody tr:hover td {
                    background: rgba(59,130,246,0.04);
                }

            .table-custom td {
                padding: .7rem 1rem;
                border-bottom: 1px solid var(--border-light);
                font-size: .86rem;
                color: var(--text-dark);
                vertical-align: middle;
            }

            .table-custom tbody tr:last-child td {
                border-bottom: none;
            }

        .table-wrapper {
            overflow-x: auto;
            border-radius: var(--table-radius);
            border: 1px solid var(--border-light);
        }

        /* ─── DIFF PANEL ─── */
        .diff-panel {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 1rem;
        }

        .diff-original {
            border-radius: 10px;
            background: rgba(220,38,38,0.04);
            border: 1px solid rgba(220,38,38,0.2);
            padding: 1rem;
        }

        .diff-new {
            border-radius: 10px;
            background: rgba(5,150,105,0.04);
            border: 1px solid rgba(5,150,105,0.2);
            padding: 1rem;
        }

        .diff-header {
            font-size: .75rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin-bottom: .75rem;
        }

        .diff-original .diff-header {
            color: var(--danger-color);
        }

        .diff-new .diff-header {
            color: var(--success-color);
        }

        .diff-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: .84rem;
            padding: .3rem 0;
            border-bottom: 1px dashed var(--border-light);
        }

            .diff-row:last-child {
                border-bottom: none;
            }

        .diff-label {
            color: var(--text-light);
            font-size: .78rem;
        }

        .diff-value {
            font-weight: 600;
            color: var(--text-dark);
            font-family: 'JetBrains Mono', monospace;
            font-size: .78rem;
        }

        .diff-changed {
            color: var(--danger-color);
            text-decoration: line-through;
        }

        .diff-new-val {
            color: var(--success-color);
        }

        /* ─── CHECKLIST ─── */
        .checklist-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            padding: .6rem .9rem;
            border-radius: 8px;
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            margin-bottom: .4rem;
            font-size: .85rem;
            transition: all var(--transition-fast);
        }

            .checklist-item.checked {
                background: rgba(5,150,105,0.06);
                border-color: rgba(5,150,105,0.25);
            }

            .checklist-item.error {
                background: rgba(220,38,38,0.06);
                border-color: rgba(220,38,38,0.25);
            }

            .checklist-item .check-icon {
                width: 24px;
                height: 24px;
                border-radius: 6px;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
                font-size: .8rem;
            }

            .checklist-item.checked .check-icon {
                background: rgba(5,150,105,0.12);
                color: var(--success-color);
            }

            .checklist-item.error .check-icon {
                background: rgba(220,38,38,0.12);
                color: var(--danger-color);
            }

            .checklist-item:not(.checked):not(.error) .check-icon {
                background: var(--border-light);
                color: var(--text-light);
            }

        /* ─── FLOW TIMELINE ─── */
        .flow-timeline {
            position: relative;
            padding-left: 2rem;
        }

            .flow-timeline::before {
                content: '';
                position: absolute;
                left: .6rem;
                top: .5rem;
                bottom: .5rem;
                width: 2px;
                background: var(--border-light);
                border-radius: 2px;
            }

        .flow-step {
            position: relative;
            margin-bottom: 1.1rem;
        }

            .flow-step::before {
                content: '';
                position: absolute;
                left: -1.5rem;
                top: .45rem;
                width: 10px;
                height: 10px;
                border-radius: 50%;
                background: var(--border-light);
                border: 2px solid var(--bg-light);
                transition: all var(--transition-fast);
            }

            .flow-step.done::before {
                background: var(--success-color);
            }

            .flow-step.active::before {
                background: var(--accent-blue);
                box-shadow: 0 0 0 4px rgba(59,130,246,0.2);
            }

            .flow-step.pending::before {
                background: var(--border-light);
            }

            .flow-step.warning::before {
                background: var(--warning-color);
            }

        .flow-step-title {
            font-size: .88rem;
            font-weight: 600;
            color: var(--text-dark);
        }

        .flow-step-desc {
            font-size: .78rem;
            color: var(--text-light);
            margin-top: .1rem;
        }

        /* ─── TABS ─── */
        .tabs-custom {
            display: flex;
            gap: .25rem;
            border-bottom: 2px solid var(--border-light);
            margin-bottom: 1.25rem;
            overflow-x: auto;
        }

        .tab-btn {
            padding: .55rem 1rem;
            font-size: .84rem;
            font-weight: 600;
            color: var(--text-light);
            background: none;
            border: none;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            margin-bottom: -2px;
            white-space: nowrap;
            transition: all var(--transition-fast);
            border-radius: 6px 6px 0 0;
        }

            .tab-btn:hover {
                color: var(--text-dark);
                background: var(--bg-gray);
            }

            .tab-btn.active {
                color: var(--accent-blue);
                border-bottom-color: var(--accent-blue);
            }

        .tab-pane {
            display: none;
        }

            .tab-pane.active {
                display: block;
            }

        /* ─── BUTTONS ─── */
        .btn-primary-custom {
            background: var(--accent-blue);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .55rem 1.25rem;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .btn-primary-custom:hover {
                background: var(--primary-blue);
                box-shadow: var(--shadow);
            }

        .btn-secondary-custom {
            background: var(--bg-light);
            color: var(--text-dark);
            border: 1.5px solid var(--border-light);
            border-radius: 8px;
            padding: .52rem 1.2rem;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .btn-secondary-custom:hover {
                border-color: var(--accent-blue);
                color: var(--accent-blue);
            }

        .btn-danger-custom {
            background: var(--danger-color);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .55rem 1.25rem;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .btn-danger-custom:hover {
                background: #b91c1c;
            }

        .btn-success-custom {
            background: var(--success-color);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .55rem 1.25rem;
            font-size: .88rem;
            font-weight: 600;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: inline-flex;
            align-items: center;
            gap: .4rem;
        }

            .btn-success-custom:hover {
                background: #047857;
            }

        .btn-sm-custom {
            padding: .35rem .8rem;
            font-size: .78rem;
        }

        /* ─── CONCEPT TABLE ─── */
        .concept-row-removed td {
            background: rgba(220,38,38,0.04);
            color: var(--text-light);
            text-decoration: line-through;
        }

        .concept-row-added td {
            background: rgba(5,150,105,0.04);
        }

        .concept-row-modified td {
            background: rgba(217,119,6,0.04);
        }

        /* ─── AMOUNT SUMMARY ─── */
        .amount-summary {
            background: var(--bg-gray);
            border: 1px solid var(--border-light);
            border-radius: 10px;
            padding: 1rem;
        }

        .amount-row {
            display: flex;
            justify-content: space-between;
            padding: .3rem 0;
            font-size: .86rem;
        }

            .amount-row .label {
                color: var(--text-light);
            }

            .amount-row .value {
                font-weight: 600;
                color: var(--text-dark);
                font-family: 'JetBrains Mono', monospace;
            }

        .amount-total {
            border-top: 2px solid var(--border-light);
            margin-top: .4rem;
            padding-top: .6rem;
        }

            .amount-total .label {
                font-weight: 700;
                color: var(--text-dark);
            }

            .amount-total .value {
                font-size: 1.1rem;
                color: var(--primary-blue);
            }

        /* ─── MASIVA ─── */
        .queue-item {
            display: flex;
            align-items: center;
            gap: .75rem;
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 8px;
            padding: .6rem 1rem;
            margin-bottom: .35rem;
            transition: all var(--transition-fast);
        }

            .queue-item .progress-bar-mini {
                flex: 1;
                height: 4px;
                background: var(--border-light);
                border-radius: 4px;
                overflow: hidden;
            }

            .queue-item .progress-fill {
                height: 100%;
                border-radius: 4px;
                transition: width .5s ease;
            }

                .queue-item .progress-fill.success {
                    background: var(--success-color);
                }

                .queue-item .progress-fill.error {
                    background: var(--danger-color);
                }

                .queue-item .progress-fill.running {
                    background: var(--accent-blue);
                    animation: pulse-bar 1s ease-in-out infinite alternate;
                }

        @@keyframes pulse-bar {
            from {
                opacity: .7;
            }

            to {
                opacity: 1;
            }
        }

        /* ─── MODAL ─── */
        .modal-custom {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2000;
            overflow-y: auto;
            padding: 2rem 1rem;
        }

            .modal-custom.show {
                display: flex;
                align-items: flex-start;
                justify-content: center;
            }

        .modal-backdrop-custom {
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.45);
            z-index: 1999;
            display: none;
            backdrop-filter: blur(2px);
        }

            .modal-backdrop-custom.show {
                display: block;
            }

        .modal-dialog-custom {
            background: var(--bg-light);
            border-radius: 16px;
            width: 100%;
            max-width: 520px;
            box-shadow: var(--shadow-lg);
            border: 1px solid var(--border-light);
            overflow: hidden;
            position: relative;
            z-index: 2001;
            animation: modal-in .22s ease;
        }

        @@keyframes modal-in {
            from {
                opacity: 0;
                transform: translateY(-18px) scale(.97);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .modal-header-custom {
            padding: 1.1rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
            display: flex;
            align-items: center;
            gap: .75rem;
        }

        .modal-title-custom {
            font-size: 1rem;
            font-weight: 700;
            color: var(--text-dark);
            margin: 0;
            flex: 1;
        }

        .modal-close {
            background: none;
            border: none;
            cursor: pointer;
            width: 30px;
            height: 30px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-light);
            transition: background var(--transition-fast);
        }

            .modal-close:hover {
                background: var(--bg-gray);
                color: var(--text-dark);
            }

        .modal-body-custom {
            padding: 1.25rem;
        }

        .modal-footer-custom {
            padding: .9rem 1.25rem;
            border-top: 1px solid var(--border-light);
            display: flex;
            justify-content: flex-end;
            gap: .5rem;
        }

        /* ─── BITÁCORA ─── */
        .log-entry {
            display: flex;
            gap: .75rem;
            padding: .6rem 0;
            border-bottom: 1px solid var(--border-light);
        }

            .log-entry:last-child {
                border-bottom: none;
            }

        .log-icon {
            width: 30px;
            height: 30px;
            border-radius: 8px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .8rem;
        }

        .log-info .log-icon {
            background: rgba(59,130,246,0.1);
            color: var(--accent-blue);
        }

        .log-success .log-icon {
            background: rgba(5,150,105,0.1);
            color: var(--success-color);
        }

        .log-warning .log-icon {
            background: rgba(217,119,6,0.1);
            color: var(--warning-color);
        }

        .log-error .log-icon {
            background: rgba(220,38,38,0.1);
            color: var(--danger-color);
        }

        .log-time {
            font-size: .72rem;
            color: var(--text-light);
            font-family: 'JetBrains Mono', monospace;
        }

        .log-msg {
            font-size: .84rem;
            color: var(--text-dark);
            font-weight: 500;
        }

        .log-detail {
            font-size: .76rem;
            color: var(--text-light);
            margin-top: .1rem;
        }

        /* ─── PROGRESS STEPS ─── */
        .progress-steps-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .progress-step-item {
            display: flex;
            gap: .75rem;
            padding: .5rem 0;
            align-items: flex-start;
            font-size: .85rem;
        }

        .psi-num {
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: var(--border-light);
            color: var(--text-light);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .7rem;
            font-weight: 700;
            flex-shrink: 0;
            margin-top: .05rem;
        }

        .psi-done .psi-num {
            background: var(--success-color);
            color: #fff;
        }

        .psi-active .psi-num {
            background: var(--accent-blue);
            color: #fff;
        }

        .psi-text {
            color: var(--text-dark);
            font-weight: 500;
        }

        .psi-sub {
            font-size: .76rem;
            color: var(--text-light);
        }

        /* ─── TOAST ─── */
        .toast-container {
            position: fixed;
            bottom: 1.5rem;
            right: 1.5rem;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: .5rem;
        }

        .toast-item {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 10px;
            padding: .75rem 1rem;
            box-shadow: var(--shadow-lg);
            display: flex;
            gap: .6rem;
            align-items: center;
            min-width: 280px;
            max-width: 380px;
            animation: toast-in .22s ease;
        }

        @@keyframes toast-in {
            from {
                opacity: 0;
                transform: translateX(20px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .toast-item.toast-success {
            border-left: 3px solid var(--success-color);
        }

        .toast-item.toast-warning {
            border-left: 3px solid var(--warning-color);
        }

        .toast-item.toast-error {
            border-left: 3px solid var(--danger-color);
        }

        .toast-item.toast-info {
            border-left: 3px solid var(--accent-blue);
        }

        .toast-item i {
            font-size: .95rem;
            flex-shrink: 0;
        }

        .toast-success i {
            color: var(--success-color);
        }

        .toast-warning i {
            color: var(--warning-color);
        }

        .toast-error i {
            color: var(--danger-color);
        }

        .toast-info i {
            color: var(--accent-blue);
        }

        .toast-msg {
            font-size: .84rem;
            font-weight: 500;
            color: var(--text-dark);
            flex: 1;
        }

        /* ─── KPI CARDS ─── */
        .kpi-card {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 12px;
            padding: 1rem 1.25rem;
        }

        .kpi-label {
            font-size: .75rem;
            color: var(--text-light);
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: .05em;
        }

        .kpi-value {
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text-dark);
            line-height: 1.2;
            margin: .2rem 0;
        }

        .kpi-sub {
            font-size: .78rem;
            color: var(--text-light);
        }

        .kpi-icon {
            width: 40px;
            height: 40px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
            float: right;
            margin-top: -.2rem;
        }

        /* ─── ANTICIPO ─── */
        .anticipo-chain {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem;
            align-items: center;
        }

        .chain-node {
            background: var(--bg-gray);
            border: 1.5px solid var(--border-light);
            border-radius: 8px;
            padding: .4rem .8rem;
            font-size: .78rem;
            font-weight: 600;
            color: var(--text-dark);
            position: relative;
        }

            .chain-node.cancelled {
                border-color: var(--danger-color);
                background: rgba(220,38,38,0.04);
                text-decoration: line-through;
                color: var(--danger-color);
            }

            .chain-node.new-node {
                border-color: var(--success-color);
                background: rgba(5,150,105,0.06);
                color: var(--success-color);
            }

        .chain-arrow {
            color: var(--text-light);
            font-size: .85rem;
        }

        /* ─── DARK MODE FORM OVERRIDES ─── */
        [data-theme="dark"] .uuid-input,
        [data-theme="dark"] .form-control-custom {
            background: var(--bg-gray);
            color: var(--text-dark);
        }

        /* ─── RESPONSIVE ─── */
        @@media (max-width: 767px) {
            .diff-panel {
                grid-template-columns: 1fr;
            }

            .type-grid {
                grid-template-columns: 1fr 1fr;
            }

            .main-content {
                padding: 1rem;
            }

            .wizard-step .step-label {
                display: none;
            }

            .cfdi-search-box {
                flex-direction: column;
                align-items: stretch;
            }
        }

        @@media (max-width: 480px) {
            .type-grid {
                grid-template-columns: 1fr;
            }
        }

        /* ─── ANIMATIONS ─── */
        .fade-in {
            animation: fadeIn .3s ease;
        }

        @@keyframes fadeIn {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: none;
            }
        }

        .section {
            animation: fadeIn .25s ease;
        }

        /* ─── SCROLL ─── */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: transparent;
        }

        ::-webkit-scrollbar-thumb {
            background: var(--border-light);
            border-radius: 6px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: var(--secondary-blue);
            }

        /* ─── DIVIDER ─── */
        .section-divider {
            height: 1px;
            background: var(--border-light);
            margin: 1.25rem 0;
        }

        /* ─── CONCEPT EDITOR ─── */
        .concept-editor-row td input, .concept-editor-row td select {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 6px;
            padding: .3rem .5rem;
            font-size: .82rem;
            color: var(--text-dark);
            width: 100%;
        }

            .concept-editor-row td input:focus, .concept-editor-row td select:focus {
                outline: none;
                border-color: var(--accent-blue);
            }

        /* ─── PARTIAL GRID ─── */
        .partial-row {
            display: flex;
            gap: .5rem;
            align-items: center;
            padding: .5rem;
            background: var(--bg-gray);
            border-radius: 8px;
            margin-bottom: .35rem;
        }

        .partial-check {
            width: 18px;
            height: 18px;
            accent-color: var(--accent-blue);
        }

        /* ─── MOTIVO SELECT ─── */
        .motivo-card {
            border: 1.5px solid var(--border-light);
            border-radius: 8px;
            padding: .6rem .9rem;
            cursor: pointer;
            transition: all var(--transition-fast);
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: .4rem;
        }

            .motivo-card:hover {
                border-color: var(--accent-blue);
                background: rgba(59,130,246,0.03);
            }

            .motivo-card.selected {
                border-color: var(--accent-blue);
                background: rgba(59,130,246,0.06);
            }

            .motivo-card input[type=radio] {
                accent-color: var(--accent-blue);
            }

            .motivo-card .motivo-text {
                font-size: .86rem;
                font-weight: 500;
                color: var(--text-dark);
            }

            .motivo-card .motivo-sub {
                font-size: .75rem;
                color: var(--text-light);
            }

        /* ─── SUSTITUCIÓN CHAIN ─── */
        .relation-indicator {
            display: inline-flex;
            align-items: center;
            gap: .4rem;
            font-size: .76rem;
            font-weight: 600;
            background: rgba(99,102,241,0.1);
            color: var(--accent-purple);
            border-radius: 20px;
            padding: 2px 10px;
        }
    </style>
}
<body>

    <!-- ═══════════════════════════════════ PAGE HEADER ═══════════════════════════════════ -->
    <div class="page-header">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a href="#">Facturación</a></li><li class="breadcrumb-item active">Refacturación</li></ol></nav>
                <h1 class="page-title"><i class="fas fa-rotate me-2" style="color:var(--accent-blue)"></i>Módulo de Refacturación</h1>
                <p class="page-subtitle">Corrección, sustitución y trazabilidad de CFDI · Todos los casos SAT</p>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="kpi-card" style="min-width:120px">
                    <div class="kpi-label">Pendientes</div>
                    <div class="kpi-value" style="font-size:1.3rem;color:var(--warning-color)">8</div>
                </div>
                <div class="kpi-card" style="min-width:120px">
                    <div class="kpi-label">Hoy</div>
                    <div class="kpi-value" style="font-size:1.3rem;color:var(--success-color)">24</div>
                </div>
                <div class="kpi-card" style="min-width:120px">
                    <div class="kpi-label">Riesgo Alto</div>
                    <div class="kpi-value" style="font-size:1.3rem;color:var(--danger-color)">3</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ═══════════════════════════════════ MAIN ═══════════════════════════════════ -->
    <!-- WIZARD STEPS -->
    <br />
    <div class="wizard-steps" id="wizardSteps">
        <div class="wizard-step active" data-step="1">
            <div class="step-circle">1</div>
            <div class="step-label">Tipo de<br>Refacturación</div>
        </div>
        <div class="step-connector"></div>
        <div class="wizard-step" data-step="2">
            <div class="step-circle">2</div>
            <div class="step-label">Buscar<br>CFDI Original</div>
        </div>
        <div class="step-connector"></div>
        <div class="wizard-step" data-step="3">
            <div class="step-circle">3</div>
            <div class="step-label">Validar<br>Prerrequisitos</div>
        </div>
        <div class="step-connector"></div>
        <div class="wizard-step" data-step="4">
            <div class="step-circle">4</div>
            <div class="step-label">Configurar<br>Cambios</div>
        </div>
        <div class="step-connector"></div>
        <div class="wizard-step" data-step="5">
            <div class="step-circle">5</div>
            <div class="step-label">Confirmación<br>y Emisión</div>
        </div>
        <div class="step-connector"></div>
        <div class="wizard-step" data-step="6">
            <div class="step-circle">6</div>
            <div class="step-label">Resultado<br>Final</div>
        </div>
    </div>

    <!-- ─── STEP 1: TIPO ─── -->
    <div id="step1" class="section">
        <div class="card-custom mb-3">
            <div class="card-header-custom">
                <span class="card-title"><i class="fas fa-list-check"></i> Selecciona el tipo de refacturación</span>
                <span class="status-badge vigente"><i class="fas fa-circle" style="font-size:.5rem"></i>Paso 1 de 6</span>
            </div>
            <div class="card-body-custom">
                <div class="alert-custom alert-info-custom mb-3">
                    <i class="fas fa-circle-info"></i>
                    <div>Identifica correctamente el caso para aplicar el flujo SAT correspondiente. Algunos casos implican <strong>cancelación previa</strong> y otros permiten <strong>sustitución directa</strong>.</div>
                </div>
                <div class="type-grid" id="typeGrid">
                    <!-- Tarjetas generadas por JS -->
                </div>
            </div>
        </div>
        <div class="d-flex justify-content-end">
            <button class="btn-primary-custom" onclick="goStep(2)" id="btnStep1Next" disabled>Continuar <i class="fas fa-arrow-right"></i></button>
        </div>
    </div>

    <!-- ─── STEP 2: BUSCAR CFDI ─── -->
    <div id="step2" class="section" style="display:none">
        <div class="card-custom mb-3">
            <div class="card-header-custom" style="cursor:pointer;user-select:none"
                 onclick="toggleFiltros()">
                <span class="card-title">
                    <i class="fas fa-magnifying-glass"></i> Buscar CFDI Original
                </span>
                <div style="display:flex;align-items:center;gap:.75rem">
                    <span class="relation-indicator">
                        <i class="fas fa-link"></i>Relación 04 - Sustitución
                    </span>
                    <span id="filtrosResumen"
                          style="font-size:.75rem;color:var(--text-light);font-weight:500"></span>
                    <div id="filtrosChevron"
                         style="width:28px;height:28px;border-radius:7px;background:var(--bg-gray);
                            display:flex;align-items:center;justify-content:center;
                            color:var(--text-light);transition:transform .2s ease;flex-shrink:0">
                        <i class="fas fa-chevron-down" style="font-size:.75rem"></i>
                    </div>
                </div>
            </div>

            <!-- Cuerpo colapsable -->
            <div id="filtrosBody" style="overflow:hidden;transition:max-height .3s ease;max-height:0">
                <div class="card-body-custom">
                    <!-- Fila 1 -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label-custom">UUID / Folio Fiscal</label>
                            <div class="cfdi-search-box">
                                <input class="uuid-input" type="text" id="uuidInput"
                                       placeholder="XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX"
                                       maxlength="40">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Folio / Receptor</label>
                            <input class="form-control-custom" type="text" id="folioInput"
                                   placeholder="001-0001234 o nombre">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">RFC Receptor</label>
                            <input class="form-control-custom" type="text" id="rfcInput"
                                   placeholder="XAXX010101000"
                                   style="text-transform:uppercase">
                        </div>
                    </div>
                    <!-- Fila 2 -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label-custom">Fecha Desde</label>
                            <input class="form-control-custom" type="date" id="dateFrom">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Fecha Hasta</label>
                            <input class="form-control-custom" type="date" id="dateTo">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Tipo CFDI</label>
                            <select class="form-control-custom" id="tipoCFDI">
                                <option value="">Todos</option>
                                <option>Ingreso</option>
                                <option>Egreso</option>
                                <option>Traslado</option>
                                <option>Anticipo</option>
                                <option>Complemento de Pago</option>
                                <option>Global</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label-custom">Estado SAT</label>
                            <select class="form-control-custom" id="estadoSATSelect">
                                <option value="">Todos</option>
                                <option>Vigente</option>
                                <option>Cancelado</option>
                                <option>Pendiente cancelación</option>
                            </select>
                        </div>
                    </div>
                    <!-- Acciones -->
                    <div style="display:flex;gap:.5rem;align-items:center;flex-wrap:wrap">
                        <button class="btn-primary-custom" onclick="searchCFDI()">
                            <i class="fas fa-search"></i> Buscar
                        </button>
                        <button class="btn-secondary-custom" onclick="limpiarFiltros()">
                            <i class="fas fa-rotate-left"></i> Limpiar
                        </button>
                        <button class="btn-secondary-custom" onclick="advSearch()">
                            <i class="fas fa-sliders"></i> Avanzado
                        </button>
                    </div>
                </div>
            </div>

            <!-- Barra compacta cuando está cerrado -->
            <div id="filtrosCompacto" style="display:none;padding:.6rem 1.25rem;
             border-top:1px solid var(--border-light);background:var(--bg-gray)">
                <div style="display:flex;align-items:center;gap:.75rem;flex-wrap:wrap">
                    <button class="btn-primary-custom btn-sm-custom" onclick="searchCFDI()">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                    <span style="font-size:.78rem;color:var(--text-light)">
                        Expande los filtros para cambiar los criterios
                    </span>
                </div>
            </div>
        </div>

        <!-- Panel CFDI seleccionado -->
        <div id="cfdiSelectedPanel" style="display:none" class="card-custom mb-3 fade-in">
            <div class="card-header-custom">
                <span class="card-title">
                    <i class="fas fa-file-check"></i> CFDI Seleccionado
                </span>
                <div class="d-flex gap-2">
                    <span class="status-badge vigente">
                        <i class="fas fa-circle" style="font-size:.5rem"></i>Vigente SAT
                    </span>
