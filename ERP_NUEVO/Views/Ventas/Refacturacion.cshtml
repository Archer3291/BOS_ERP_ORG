            // ─── Seleccionar CFDI → carga detalle completo ─────────────────
            function selectCFDI(encabezadoId, uuidPreview) {
                closeModal('modalResultados', 'backdropResultados');
                // Resaltar
                document.querySelectorAll('.cfdi-result-card').forEach(c => c.classList.remove('selected'));
                const card = document.getElementById('rc-' + encabezadoId);
                if (card) card.classList.add('selected');

                // Panel de detalle en estado loading
                const panel = document.getElementById('cfdiSelectedPanel');
                panel.style.display = 'block';
                document.getElementById('cfdiDetailView').innerHTML = `
                                                                                                                     <div class="col-12" style="text-align:center;padding:1.5rem;color:var(--text-light)">
                                                                                                                       <i class="fas fa-spinner fa-spin fa-lg"></i>
                                                                                                                       <div style="font-size:.84rem;margin-top:.5rem">Cargando detalle del CFDI...</div>
                                                                                                                     </div>`;
                document.getElementById('btnStep2Next').disabled = true;

                fetch(`${API.detalle}?id=${encabezadoId}`)
                    .then(r => r.json())
                    .then(res => {
                        // Parsear documento (puede venir como string JSON desde jsonb_build_object)
                        const rawDoc = res.documento?.[0]?.documento ?? res.documento?.[0];
                        const doc = typeof rawDoc === 'string' ? JSON.parse(rawDoc) : rawDoc;
                        if (!doc) { showToast('error', 'No se pudo cargar el detalle del CFDI.'); return; }

                        const fa = doc.facturas?.[0] ?? {};

                        // Normalizar al mismo "shape" que usaba el mock
                        AppState.selectedCFDI = {
                            uuid: fa.uuid ?? uuidPreview ?? '',
                            folio: fa.folio ?? '',
                            receptor: fa.rsocliente ?? '',
                            rfc: fa.rfccliente ?? '',
                            rfcEmisor: fa.rfcemisor ?? '',
                            fecha: (fa.fecha ?? '').split('T')[0],
                            total: parseFloat(fa.total ?? 0),
                            subtotal: parseFloat(fa.subtotal ?? 0),
                            iva: parseFloat(fa.iva ?? 0),
                            moneda: fa.moneda ?? 'MXN',
                            tipoCambio: parseFloat(fa.tdc ?? 1),
                            metodoPago: fa.mdpfactura ?? '',
                            formaPago: '', // se llena desde el XML timbrado (enriquecido abajo)
                            estado: statusLabel(fa.statusfactura ?? '').toLowerCase(),
                            tipo: fa.serie ?? '',
                            usoCFDI: fa.usocfdi ?? '',
                            regimen: fa.reg_fisr ?? '',
                            cp: '',
                            idCliente: fa.idcliente ?? null,
                            encabezadoId: encabezadoId,
                            // Conceptos mapeados desde dfactura
                            conceptos: (fa.productos ?? []).map(p => ({
                                desc: p.descripcion ?? '',
                                qty: parseFloat(p.cantidad ?? 1),
                                pu: parseFloat(p.precio ?? 0),
                                importe: parseFloat(p.cantidad ?? 1) * parseFloat(p.precio ?? 0),
                                clave: p.claveprodserv ?? p.claveprod ?? '',
                                unidad: p.udm ?? '',
                                numero: p.claveprod ?? '',
                                idProducto: p.idproducto ?? 0,   // para el ajuste de inventario
                            })),
                            // Extra para Step 3
                            tieneComplementos: (res.complementos ?? []).length > 0,
                            complementos: res.complementos ?? [],
                            anticipos: res.anticipos ?? [],
                            creditoInfo: res.creditoInfo ?? null,
                        };

                        // El detalle (FacturaDetail) no trae forma de pago / uso / régimen / CP fiables;
                        // se toman del XML timbrado (fa.textfactura), que ya tiene el formato de catálogo.
                        const _cfdiXml = _parseCfdiComprobante(fa.textfactura || '');
                        if (_cfdiXml) {
                            AppState.selectedCFDI.formaPago = _cfdiXml.formaPago || AppState.selectedCFDI.formaPago;
                            AppState.selectedCFDI.metodoPago = _cfdiXml.metodoPago || AppState.selectedCFDI.metodoPago;
                            AppState.selectedCFDI.usoCFDI = _cfdiXml.usoCFDI || AppState.selectedCFDI.usoCFDI;
                            AppState.selectedCFDI.regimen = _cfdiXml.regimen || AppState.selectedCFDI.regimen;
                            AppState.selectedCFDI.cp = _cfdiXml.cp || AppState.selectedCFDI.cp;
                            if (_cfdiXml.moneda) AppState.selectedCFDI.moneda = _cfdiXml.moneda;
                            if (_cfdiXml.tipoCambio) AppState.selectedCFDI.tipoCambio = parseFloat(_cfdiXml.tipoCambio) || AppState.selectedCFDI.tipoCambio;
                        }

                        renderCFDISeleccionado(AppState.selectedCFDI);

                        // Auto-fill UUID relacionado (Step 4)
                        const relInput = document.getElementById('uuidRelacionado');
                        if (relInput) relInput.value = AppState.selectedCFDI.uuid;

                        document.getElementById('btnStep2Next').disabled = false;
                    })
                    .catch(err => {
                        console.error(err);
                        showToast('error', 'Error al cargar el detalle del CFDI.');
                        document.getElementById('cfdiDetailView').innerHTML = `
                                                                                                                                                                                                                <div class="col-12">
                                                                                                                                                                                                                  <div class="alert-custom alert-danger-custom">
                                                                                                                                                                                                                    <i class="fas fa-triangle-exclamation"></i>
                                                                                                                                                                                                                    <div>No se pudo cargar el detalle. Intenta de nuevo.</div>
                                                                                                                                                                                                                  </div>
                                                                                                                                                                                                                </div>`;
                    });
            }

            // ─── Panel "CFDI Seleccionado" — mismos campos que el mock ─────
            // Extrae de un XML CFDI 4.0 (string) los datos de catálogo con su formato correcto.
            function _parseCfdiComprobante(xmlStr) {
                if (!xmlStr || xmlStr.indexOf('<') === -1) return null;
                try {
                    const doc = new DOMParser().parseFromString(xmlStr, 'application/xml');
                    if (doc.getElementsByTagName('parsererror').length) return null;
                    const comp = doc.documentElement; // cfdi:Comprobante
                    const receptor = doc.getElementsByTagName('cfdi:Receptor')[0]
                        || doc.getElementsByTagName('Receptor')[0];
                    const g = (el, attr) => (el && el.getAttribute(attr)) || '';
                    return {
                        formaPago: g(comp, 'FormaPago'),
                        metodoPago: g(comp, 'MetodoPago'),
                        moneda: g(comp, 'Moneda'),
                        tipoCambio: g(comp, 'TipoCambio'),
                        usoCFDI: g(receptor, 'UsoCFDI'),
                        regimen: g(receptor, 'RegimenFiscalReceptor'),
                        cp: g(receptor, 'DomicilioFiscalReceptor'),
                    };
                } catch { return null; }
            }

            // Devuelve la descripción del catálogo para una clave (o la clave si no está).
            function _catDesc(cat, code) {
                if (!code) return '';
                const item = cat.find(i => i.clave === code);
                return item ? item.desc : code;
            }

            function _metodoPagoLabel(code) {
                if (code === 'PUE') return 'PUE · Pago en una sola exhibición';
                if (code === 'PPD') return 'PPD · Pago en parcialidades o diferido';
                return code || '';
            }

