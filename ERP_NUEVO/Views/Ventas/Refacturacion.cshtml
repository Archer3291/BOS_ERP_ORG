                                                                                                                                                                                                          <div class="form-label-custom">Forma de pago</div>
                                                                                                                                                                                                          <div style="font-size:.85rem">${esc(_catDesc(CAT_FORMA_PAGO, cfdi.formaPago))}</div>
                                                                                                                                                                                                        </div>
                                                                                                                                                                                                        <div class="col-md-2">
                                                                                                                                                                                                          <div class="form-label-custom">Moneda</div>
                                                                                                                                                                                                          <div style="font-size:.85rem">${esc(cfdi.moneda)}
                                                                                                                                                                                                            ${cfdi.moneda !== 'MXN' ? ' · TC ' + cfdi.tipoCambio : ''}
                                                                                                                                                                                                          </div>
                                                                                                                                                                                                        </div>
