    <!-- ═══════════════════════════════════ TOAST CONTAINER ═══════════════════════════════════ -->
    <div class="toast-container" id="toastContainer"></div>
    @section Scripts {
        @{ var jsv = DateTime.Now.Ticks; }
        <script src="~/Scripts/Refacturacion/utils.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/catalogos.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/state.js?v=@jsv"></script>

        <script src="~/Scripts/Refacturacion/handlers/datos-fiscales.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/metodo-pago.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/conceptos.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/moneda.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/forma-pago.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/parcial.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/devolucion.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/anticipo.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/factura-pagada.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/complemento-pago.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/impuestos.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/handlers/adenda-handler.js?v=@jsv"></script>

        <script src="~/Scripts/Refacturacion/step4.js?v=@jsv"></script>
        <script src="~/Scripts/Refacturacion/step5.js?v=@jsv"></script>
        <script>
            let filtrosAbiertos = false;
            // ═══════════════════════════════════════════════════════════════
            //  ENDPOINTS  — ajusta el prefijo si tu ruta base es diferente
            // ═══════════════════════════════════════════════════════════════
            const API = {
                buscar: '/DatosGeneralesRefacturacion/ObtenerFacturas',
                detalle: '/DatosGeneralesRefacturacion/FacturaDetail',
                kpis: '/DatosGeneralesRefacturacion/ObtenerKPIs',
                ejecutar: '/DatosGeneralesRefacturacion/EjecutarRefacturacion',
                validarDocs: '/DatosGeneralesRefacturacion/ValidarDocumentos',
                remisionesOrigen: '/DatosGeneralesRefacturacion/RemisionesOrigen',
            };

            // ═══════════════════════════════════════════════════════════════
            //  INIT
            // ═══════════════════════════════════════════════════════════════
            document.addEventListener('DOMContentLoaded', () => {
                renderTypeGrid();
                setDates();
                renderMassiveQueue();
                renderBitacora();
                loadKPIs();
            });

            function setDates() {
                const today = new Date();
                const prior = new Date(today);
                prior.setMonth(prior.getMonth() - 3);
                document.getElementById('dateTo').value = today.toISOString().split('T')[0];
                document.getElementById('dateFrom').value = prior.toISOString().split('T')[0];
            }

            // ═══════════════════════════════════════════════════════════════
            //  KPIs
            // ═══════════════════════════════════════════════════════════════
            function loadKPIs() {
                fetch(API.kpis)
                    .then(r => r.json())
                    .then(k => {
                        const p = document.getElementById('kpiPendientes');
                        const h = document.getElementById('kpiHoy');
                        const r = document.getElementById('kpiRiesgo');
                        if (p) p.textContent = k.pendientes ?? 0;
                        if (h) h.textContent = k.hoy ?? 0;
                        if (r) r.textContent = k.riesgo_alto ?? 0;
                    })
                    .catch(() => { }); // silencioso si no existe la tabla aún
            }

            // ═══════════════════════════════════════════════════════════════
            //  TYPE GRID
            // ═══════════════════════════════════════════════════════════════
            // Tipos de refacturación habilitados. Para activar más, agrega su id aquí
            // (ids definidos en TIPOS_REFACTURACION de catalogos.js). OJO: solo habilita tipos
            // que YA tengan handler en el back registrado en Program.cs (hoy: adenda, datos-fiscales, metodo-pago),
            // de lo contrario la ejecución falla con "No hay handler registrado para el tipo '...'".
                const TIPOS_HABILITADOS = ['adenda', 'datos-fiscales', 'metodo-pago', 'moneda', 'conceptos'];

            function renderTypeGrid() {
                document.getElementById('typeGrid').innerHTML = TIPOS_REFACTURACION.map(t => {
                    const bloqueado = !TIPOS_HABILITADOS.includes(t.id);
                    return `
                            <div class="type-card ${t.risk === 'very-high' || t.risk === 'high' ? 'risk-' + t.risk : ''} ${bloqueado ? 'type-card-disabled' : ''}"
                                 ${bloqueado ? 'aria-disabled="true"' : `onclick="selectType('${t.id}')"`} id="tc-${t.id}">
                              <div class="type-icon ${t.color}"><i class="fas ${t.icon}"></i></div>
                              <div class="type-name">${t.name}</div>
                              <div class="type-desc">${t.desc}</div>
                              ${bloqueado
                                ? '<span class="type-badge" style="background:#9ca3af;color:#fff"><i class="fas fa-lock"></i> No disponible</span>'
                                : `<span class="type-badge ${t.risk}">${t.riskLabel}</span>`}
                            </div>`;
                }).join('');
            }

            function selectType(id) {
                if (!TIPOS_HABILITADOS.includes(id)) return; // solo los tipos habilitados se pueden seleccionar
                document.querySelectorAll('.type-card').forEach(c => c.classList.remove('selected'));
                document.getElementById('tc-' + id).classList.add('selected');
                AppState.selectedType = TIPOS_REFACTURACION.find(t => t.id === id);
                document.getElementById('btnStep1Next').disabled = false;
                const rel = document.getElementById('uuidRelacionado');
                if (rel) rel.value = '';
            }

            // ═══════════════════════════════════════════════════════════════
            //  STEP 2 — BÚSQUEDA REAL
            // ═══════════════════════════════════════════════════════════════
            function searchCFDI() {
                const nombre = document.getElementById('folioInput').value.trim();
                const uuid = document.getElementById('uuidInput').value.trim();
                const rfc = document.getElementById('rfcInput').value.trim();
                const fechaDesde = document.getElementById('dateFrom').value;
                const fechaHasta = document.getElementById('dateTo').value;
                const tipoCFDI = document.getElementById('tipoCFDI').value;
                // El select de estado SAT ya existe en tu HTML como cuarto select; le agregamos un id aquí abajo.
                const estadoSAT = document.getElementById('estadoSATSelect')
                    ? document.getElementById('estadoSATSelect').value : '';

                // NUEVO — abre modal con spinner
                document.getElementById('resultsList').innerHTML = `
                                                                                                                      <div style="text-align:center;padding:2rem;color:var(--text-light)">
                                                                                                                          <i class="fas fa-spinner fa-spin fa-lg"></i>
                                                                                                                          <div style="font-size:.84rem;margin-top:.5rem">Buscando facturas...</div>
                                                                                                                      </div>`;
                document.getElementById('modalResultados').classList.add('show');
                document.getElementById('backdropResultados').classList.add('show');

                const qs = new URLSearchParams({ nombre, uuid, rfc, fechaDesde, fechaHasta, tipoCFDI, estadoSAT, page: 1, pageSize: 50 });

                fetch(`${API.buscar}?${qs}`)
                    .then(r => r.json())
                    .then(res => {
                        const resultados = res.data ?? [];
                        const total = parseInt(res.total ?? 0);
                        document.getElementById('resultsCount').textContent =
                            `(${total} encontrado${total !== 1 ? 's' : ''})`;
                        renderResultados(resultados);
                    })
                    .catch(() => {
                        document.getElementById('resultsList').innerHTML = `
                                                                                                                           <div class="alert-custom alert-danger-custom">
                                                                                                                             <i class="fas fa-triangle-exclamation"></i>
                                                                                                                             <div>Error al buscar facturas. Intenta de nuevo.</div>
                                                                                                                           </div>`;
                    });
            }

            // ─── Renderizar tarjetas de resultados ─────────────────────────
