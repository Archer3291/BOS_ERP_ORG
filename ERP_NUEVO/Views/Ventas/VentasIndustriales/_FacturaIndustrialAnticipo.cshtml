<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-clock"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nuevo Anticipo</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar la factura de anticipo</p>
            </div>
        </div>

        <form id="vi-fac-ant-formCotizacion" method="post">
            <input type="hidden" name="tipo" value="anticipo">

            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo fijo Anticipo -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                            <h2 class="vi-section-title">Tipo de Factura</h2>
                        </div>
                        <span class="vi-ant-badge">
                            <i class="fas fa-clock"></i> Anticipo
                        </span>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vi-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vi-fac-ant-folio" value="@Model.Folio" name="folio"
                                       class="vi-control" readonly autocomplete="off">
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vi-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vi-fac-ant-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vi-control" id="vi-fac-ant-cliente"
                                           placeholder="Seleccione un cliente…" disabled
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vi-fac-ant-rfc" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Info adicional -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vi-control" id="vi-fac-ant-info-proveedor" rows="3" readonly autocomplete="off"></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vi-control form-select" name="vendedor" id="vi-fac-ant-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vi-control form-select" name="moneda" id="vi-fac-ant-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vi-fac-ant-paridad" name="paridad" class="vi-control" value="1" autocomplete="off">
                            </div>

                            <!-- Referencia -->
                            <div class="col-12 col-sm-8">
                                <label class="vi-label"><i class="fas fa-comment"></i>Referencia</label>
                                <input type="text" id="vi-fac-ant-concepto" name="concepto" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Adendas (oculto por defecto) -->
                            <div class="col-12" id="vi-fac-ant-seccion-adendas" style="display:none;">
                                <label class="vi-label"><i class="fas fa-file-contract"></i>Seleccionar Adenda</label>
                                <div id="vi-fac-ant-adendas-container" class="adendas-radio-group"
                                     style="display:flex;flex-direction:column;gap:.75rem;padding:1rem;background:var(--vi-gray-50);border-radius:var(--vi-radius);border:1px solid var(--vi-gray-200);max-height:380px;overflow-y:auto;">
                                </div>
                                <input type="hidden" id="vi-fac-ant-adenda-seleccionada" name="adenda-seleccionada">
                            </div>
                        </div>
                    </div><!-- /tarjeta cliente -->
                    <!-- TARJETA: Condiciones del Anticipo -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vi-section-title">Condiciones del Anticipo</h2>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-dollar-sign"></i>Monto Anticipo</label>
                                <input type="number" id="vi-fac-ant-monto-anticipo" name="monto-anticipo"
                                       class="vi-control" placeholder="0.00" autocomplete="off">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-calendar"></i>Fecha de Anticipo</label>
                                <input type="date" id="vi-fac-ant-fecha-anticipo" name="fecha-anticipo" class="vi-control">
                            </div>

                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Método de Pago</label>
                                <select class="vi-control form-select disabled-field"
                                        id="vi-fac-ant-metodo-pago" name="metodo-pago" disabled>
                                    <option value="PUE" selected>PUE - Pago en una sola exhibición</option>
                                </select>
                                <input type="hidden" id="vi-fac-ant-metodo-pago-hidden" name="metodo-pago-hidden" value="PUE">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Forma de Pago</label>
                                <select class="vi-control form-select" id="vi-fac-ant-forma-pago" name="forma-pago">
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Cheque nominativo</option>
                                    <option value="03">03 - Transferencia electrónica</option>
                                    <option value="04">04 - Tarjeta de crédito</option>
                                    <option value="28">28 - Tarjeta de débito</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-file-invoice"></i>Uso CFDI</label>
                                <select class="vi-control form-select" id="vi-fac-ant-uso-cfdi" name="uso-cfdi">
                                    <option selected>G03 - Gastos en general</option>
                                    <option value="D01">D01 - Honorarios médicos</option>
                                    <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                    <option value="P01">P01 - Por definir</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Comentarios -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-comment-dots"></i></div>
                            <h2 class="vi-section-title">Comentarios Adicionales</h2>
                        </div>
                        <textarea class="vi-control" id="vi-fac-ant-comentarios" name="comentarios" rows="4"
                                  placeholder="Observaciones, condiciones especiales, etc."></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA: RESUMEN ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem; z-index:0;">

                        <!-- Ticket resumen -->
                        <div class="vi-ticket mb-3">
                            <div class="vi-ticket-head">
                                <i class="fas fa-calculator vi-ticket-head-icon"></i>
                                <div class="vi-ticket-head-label">Resumen de Anticipo</div>
                            </div>
                            <div class="vi-ticket-body">
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Subtotal</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-ant-total-subtotal1-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">IVA (16%)</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-ant-iva-display">$0.00</span>
                                </div>
                            </div>
                            <div class="vi-ticket-footer">
                                <div class="vi-ticket-total-row">
                                    <span class="vi-ticket-total-label"><i class="fas fa-money-bill-wave me-1"></i>Total</span>
                                    <strong class="vi-ticket-total-val" id="vi-fac-ant-total-final-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vi-fac-ant-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vi-fac-ant-iva" name="iva" value="0.00">
                            <input type="hidden" id="vi-fac-ant-importe" name="importe" value="0.00">
                            <input type="hidden" id="vi-fac-ant-total-final-h" name="total-final" value="0.00">
                            <input type="hidden" id="vi-fac-ant-total-anticipos" name="totalAnticipos" value="0">
                            <input type="hidden" id="vi-fac-ant-total-final" name="totalFinal" value="0">
                            <input type="hidden" id="vi-fac-ant-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vi-btn vi-btn-success vi-fac-ant-btn-submit"
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-paper-plane"></i> Generar Anticipo
                            </button>
                            <a href="#" class="vi-btn vi-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div><!-- /col derecha -->

            </div><!-- /row -->
        </form>
    </div><!-- /container -->
</div><!-- /vi-page -->
<!-- ===== MODAL: BUSCAR CLIENTE ===== -->
<div class="modal fade" id="vi-fac-ant-modalBuscarCliente" tabindex="-1"
     aria-labelledby="vi-fac-ant-modalBuscarClienteLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title" id="vi-fac-ant-modalBuscarClienteLabel">
                    <i class="fas fa-search me-2"></i> Buscar Cliente
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="input-group mb-3">
                    <input type="text" id="vi-fac-ant-inputBuscarCliente" class="form-control" placeholder="Nombre o RFC…">
                    <button type="button" class="btn btn-outline-secondary" id="vi-fac-ant-btnLimpiarClientes">
                        <i class="fas fa-eraser"></i> Limpiar
                    </button>
                </div>
                <ul class="list-unstyled" id="vi-fac-ant-listaResultadosClientes" style="max-height:400px;overflow-y:auto;"></ul>
            </div>
            <div class="modal-footer flex-column gap-2">
                <div class="w-100 d-flex justify-content-between align-items-center flex-wrap">
                    <small class="text-muted">
                        Mostrando <strong id="vi-fac-ant-recordsFromClientes">0</strong> a
                        <strong id="vi-fac-ant-recordsToClientes">0</strong> de
                        <strong id="vi-fac-ant-totalRecordsClientes">0</strong> registros
                    </small>
                    <div class="d-flex align-items-center gap-2">
                        <select id="vi-fac-ant-pageSizeClientes" class="form-select form-select-sm" style="width:auto;">
                            <option value="25">25 / pág</option>
                            <option value="50" selected>50 / pág</option>
                            <option value="100">100 / pág</option>
                        </select>
                        <div id="vi-fac-ant-spinnerClientes" class="spinner-border spinner-border-sm text-primary d-none"></div>
                    </div>
                </div>
                <nav class="w-100">
                    <ul class="pagination justify-content-center mb-0" id="vi-fac-ant-paginationClientes"></ul>
                </nav>
            </div>
        </div>
    </div>
</div>

<script>
    /* ===== CÁLCULO DE TOTALES ===== */
    document.getElementById('vi-fac-ant-monto-anticipo')?.addEventListener('input', calcularTotalesAnticipo);

    function calcularTotalesAnticipo() {
        const monto = parseFloat(document.getElementById('vi-fac-ant-monto-anticipo')?.value) || 0;
        const iva = Math.round(monto * 0.16 * 100) / 100;
        const total = monto + iva;

        const fmt = v => '$' + v.toFixed(2);
        document.getElementById('vi-fac-ant-total-subtotal1-display').textContent = fmt(monto);
        document.getElementById('vi-fac-ant-iva-display').textContent = fmt(iva);
        document.getElementById('vi-fac-ant-total-final-display').textContent = fmt(total);

        document.getElementById('vi-fac-ant-total-subtotal1').value = monto.toFixed(2);
        document.getElementById('vi-fac-ant-iva').value = iva.toFixed(2);
        document.getElementById('vi-fac-ant-importe').value = total.toFixed(2);
        document.getElementById('vi-fac-ant-total-final-h').value = total.toFixed(2);
        document.getElementById('vi-fac-ant-total-anticipos').value = '0.00';
        document.getElementById('vi-fac-ant-total-final').value = total.toFixed(2);
    }
</script>
