<!-- ===== JS: toggle de 3 estados (lógica original intacta) ===== -->
<script>
    let paymentStates2 = ['contado', 'credito', 'anticipo'];
    let currentStateIndex2 = 0;

    // REEMPLAZA todo el bloque de toggle (incluyendo limpiarCampos* y calcularAnticipo*)
    // por esto:

    function setTipoPagoRemision(nuevoEstado) {
        const toggle = document.getElementById('vi-rem-toggle-pago');
        const camposCredito = document.getElementById('vi-rem-campos-credito');
        const seccionProductos = document.getElementById('vi-rem-seccion-productos');

        toggle.setAttribute('data-state', nuevoEstado);

        document.querySelectorAll('#vi-rem-toggle-pago .vi-pay-btn').forEach(btn => {
            btn.classList.toggle('active', btn.dataset.val === nuevoEstado);
        });

        if (nuevoEstado === 'contado') {
            camposCredito.style.display = 'none';
            seccionProductos.style.display = '';
            limpiarCamposCreditoRemision();
        } else if (nuevoEstado === 'credito') {
            camposCredito.style.display = 'block';
            seccionProductos.style.display = '';
        }

        // El crédito solo se valida en ventas a crédito.
        window.CreditoVentas?.evaluar('vi-rem');
    }

    // Mantén estas dos funciones auxiliares que siguen siendo usadas:
    function limpiarCamposCreditoRemision() {
        document.getElementById('vi-rem-limite-credito').value = '0.00';
        document.getElementById('vi-rem-plazo').value = '';
        document.getElementById('vi-rem-fecha-pago').value = '';
    }

    function limpiarCamposRemision() {
        limpiarCamposCreditoRemision();
    }

    function limpiarCamposAnticipoRemision() {
        document.getElementById('vi-rem-porcentaje-anticipo').value = '';
        document.getElementById('vi-rem-monto-anticipo').value = '';
        document.getElementById('vi-rem-saldo-pendiente').value = '';
        document.getElementById('vi-rem-fecha-anticipo').value = '';
        document.getElementById('vi-rem-fecha-pago-final').value = '';
    }

    function calcularAnticipoRemision() {
        const porcentaje = parseFloat(document.getElementById('vi-rem-porcentaje-anticipo').value) || 0;
        const totalVenta = parseFloat(document.getElementById('vi-rem-importe').value) || 0;
        const montoAnticipo = (totalVenta * porcentaje) / 100;
        const saldoPendiente = totalVenta - montoAnticipo;
        document.getElementById('vi-rem-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vi-rem-saldo-pendiente').value = saldoPendiente.toFixed(2);
    }
</script>

<script>
    /* ===== TOGGLE FLETE — lógica original intacta ===== */
    document.getElementById('vi-rem-flete').addEventListener('change', function () {
        const inp = document.getElementById('vi-rem-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA — lógica original intacta ===== */
    document.getElementById('vi-rem-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vi-rem-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>
