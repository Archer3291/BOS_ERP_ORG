@{ var role = Utilities.GetUserRole(User.Identity.Name); }

<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nuevo Pedido</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar el pedido</p>
            </div>
        </div>

        <form id="vi-ped-formCotizacion" class="vi-ped-formCotizacion" method="post">

            <!-- ===== FILA PRINCIPAL ===== -->
            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vi-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vi-ped-tipo-pago" value="contado">
                        <div class="vi-pay-toggle" id="vi-ped-toggle-pago">
                            <button type="button" class="vi-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoPed('contado')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vi-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoPed('credito')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vi-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vi-ped-folio" value="@Model.Folio" name="folio"
                                       class="vi-control" readonly autocomplete="off">
                            </div>
                            <!-- Sucursal / Almacén (ocultos por defecto) -->
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-building"></i>Sucursal</label>
                                <select class="vi-control form-select" id="vi-ped-sucursal" name="sucursal">
                                    <option selected>CEDIS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-warehouse"></i>Almacén</label>
                                <select class="vi-control form-select" id="vi-ped-almacen" name="almacen">
                                    <option selected>ALMACÉN GENERAL</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vi-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vi-ped-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vi-control" id="vi-ped-cliente"
                                           placeholder="Seleccione un cliente…" readonly
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vi-ped-rfc" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Banner crédito -->
                            <div class="col-12">
                                <div id="vi-ped-credit-banner" style="display:none;" class="vi-credit-banner">
                                    <div id="vi-ped-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vi-ped-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vi-ped-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vi-banner-bar-wrap" id="vi-ped-credit-bar-wrap">
                                            <div class="vi-banner-bar-fill" id="vi-ped-credit-bar" style="width:0%;"></div>
                                        </div>
                                    </div>
                                    <div id="vi-ped-credit-pct" style="font-size:.8rem;font-weight:600;flex-shrink:0;"></div>
                                </div>
                            </div>

                            <!-- Info adicional cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vi-control" id="vi-ped-info-proveedor" rows="3" readonly autocomplete="off"></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vi-control form-select" name="vendedor" id="vi-ped-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vi-control form-select" name="moneda" id="vi-ped-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vi-ped-paridad" name="paridad" class="vi-control" value="1" autocomplete="off">
                            </div>

                            <!-- Referencia -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-comment"></i>Referencia</label>
                                <input type="text" id="vi-ped-concepto" name="concepto" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Incoterm (oculto) -->
