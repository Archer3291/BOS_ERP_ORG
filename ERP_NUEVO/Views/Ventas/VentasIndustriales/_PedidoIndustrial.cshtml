<script>
    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    function selectTipoPagoPed(val) {
        document.querySelectorAll('#vi-ped-toggle-pago .vi-pay-btn')
            .forEach(o => o.classList.toggle('active', o.dataset.val === val));
        document.getElementById('vi-ped-tipo-pago').value = val;

        // ★ Sincronizar select de método de pago con el toggle
        const metodoPagoEl = document.getElementById('vi-ped-metodo-pago');
        if (metodoPagoEl) {
            metodoPagoEl.value = val === 'credito' ? 'PPD' : 'PUE';
        }

        const camposCredito = document.getElementById('vi-ped-campos-credito');
        const secProductos = document.getElementById('vi-ped-seccion-productos');
        camposCredito.style.display = 'none';

        if (val === 'contado') {
            limpiarCamposPed();
            secProductos.style.display = '';
        } else if (val === 'credito') {
            camposCredito.style.display = 'block';
            secProductos.style.display = '';
        }

        // El crédito solo se valida en ventas a crédito.
        window.CreditoVentas?.evaluar('vi-ped');
    }

    function limpiarCamposPed() {
        limpiarCamposCreditoP();
    }

    function limpiarCamposCreditoP() {
        document.getElementById('vi-ped-limite-credito').value = '0.00';
        document.getElementById('vi-ped-plazo').value = '';
        document.getElementById('vi-ped-fecha-pago').value = '';
    }
    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vi-ped-flete').addEventListener('change', function () {
        const inp = document.getElementById('vi-ped-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vi-ped-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vi-ped-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>
