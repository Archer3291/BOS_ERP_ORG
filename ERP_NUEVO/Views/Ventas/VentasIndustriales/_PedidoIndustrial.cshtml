    /* ===== BOTÓN FLOTANTE ===== */
    .vi-floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--primary-blue-dark);
        color: #fff;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(30,58,95,.4);
        transition: transform .3s, box-shadow .3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .vi-floating-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(30,58,95,.5);
        }

    .vi-floating-tooltip {
        position: fixed;
        bottom: 38px;
        right: 96px;
        background: var(--primary-blue-dark);
        color: #fff;
        padding: .4rem .9rem;
        border-radius: 8px;
        font-size: .8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s;
        z-index: 999;
    }

    .vi-floating-btn:hover + .vi-floating-tooltip {
        opacity: 1;
    }

