                        </div>
                        <textarea class="vi-control" id="vi-ped-comentarios" name="comentarios" rows="5"
                                  placeholder="Ingrese observaciones, condiciones de entrega, vigencia, etc."></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA: RESUMEN ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem; z-index:0;">

                        <!-- Ticket resumen -->
                        <div class="vi-ticket mb-3">
                            <div class="vi-ticket-head">
                                <i class="fas fa-calculator vi-ticket-head-icon"></i>
                                <div class="vi-ticket-head-label">Resumen de Pedido</div>
                            </div>
                            <div class="vi-ticket-body">
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Subtotal 1</span>
                                    <span class="vi-ticket-row-val" id="vi-ped-total-subtotal1-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Descuento</span>
                                    <span class="vi-ticket-row-val vi-negative" id="vi-ped-total-descuento-display">-$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Flete</span>
                                    <span class="vi-ticket-row-val" id="vi-ped-total-flete-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--vi-gray-200);border-bottom:none;">
                                    <span class="vi-ticket-row-label">Subtotal 2</span>
                                    <span class="vi-ticket-row-val" id="vi-ped-total-subtotal2-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">IVA (16%)</span>
                                    <span class="vi-ticket-row-val" id="vi-ped-iva-display">$0.00</span>
                                </div>
                            </div>
                            <div class="vi-ticket-footer">
                                <div class="vi-ticket-total-row">
                                    <span class="vi-ticket-total-label"><i class="fas fa-coins me-1"></i>Total</span>
                                    <strong class="vi-ticket-total-val" id="vi-ped-importe-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vi-ped-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vi-ped-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vi-ped-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vi-ped-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vi-ped-iva" name="iva" value="0.00">
                            <input type="hidden" id="vi-ped-importe" name="importe" value="0.00">
                            <input type="hidden" id="vi-ped-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vi-btn vi-btn-outline d-none"
                                    data-bs-toggle="modal" data-bs-target="#vi-ped-modalVistaPrevia"
                                    onclick="actualizarVistaPreviaPedido()"
                                    style="width:100%;justify-content:center;">
                                <i class="fas fa-eye"></i> Vista Previa
                            </button>
                            <button type="button" class="vi-btn vi-btn-success vi-ped-btn-submit"
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-paper-plane"></i> Generar Pedido
                            </button>
                            <a href="#" class="vi-btn vi-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div><!-- /col derecha -->

            </div><!-- /row -->
        </form>
    </div><!-- /container -->
</div><!-- /vi-page -->
