                            <label class="vi-switch" for="vi-ped-flete">
                                <input type="checkbox" id="vi-ped-flete">
                                <span class="vi-switch-track"></span>
                                <span class="vi-switch-label"><i class="fas fa-truck me-1"></i>Con Flete</span>
                            </label>
                            <input type="number" class="vi-control d-none" name="flete"
                                   id="vi-ped-flete-val" placeholder="Costo de flete" style="max-width:180px;">
                        </div>

                        <!-- Orden de compra -->
                        <div class="d-flex align-items-center gap-3">
                            <label class="vi-switch" for="vi-ped-orden-compra-check">
                                <input type="checkbox" id="vi-ped-orden-compra-check">
                                <span class="vi-switch-track"></span>
                                <span class="vi-switch-label"><i class="fas fa-file-alt me-1"></i>Con Orden de Compra</span>
                            </label>
                            <input type="text" class="vi-control d-none" name="ordenCompra"
                                   id="vi-ped-orden-compra-val" placeholder="Número de orden de compra"
                                   autocomplete="off" style="max-width:220px;">
                        </div>
                    </div><!-- /tarjeta artículos -->
                    <!-- TARJETA: Condiciones de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-file-invoice"></i></div>
                            <h2 class="vi-section-title">Condiciones de Pago</h2>
                        </div>

                        <!-- Campos crédito -->
                        <div id="vi-ped-campos-credito" style="display:none;">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-credit-card"></i>Límite de Crédito</label>
                                    <input type="number" id="vi-ped-limite-credito" name="limite-credito"
                                           value="0.00" readonly class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-credit-card"></i>Crédito Disponible</label>
                                    <input type="number" id="vi-ped-limite-disponible" name="limite-disponible"
                                           value="0.00" readonly class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-calendar-day"></i>Plazo (días)</label>
                                    <input type="number" id="vi-ped-plazo" name="plazo" class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-calendar"></i>Fecha de Pago</label>
                                    <input type="date" id="vi-ped-fecha-pago" name="fecha-pago" class="vi-control">
                                </div>
                            </div>
                        </div>                

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Método de Pago</label>
                                <select class="vi-control form-select" id="vi-ped-metodo-pago" name="metodo-pago" required>
                                    <option value="" selected disabled>Seleccione un método de pago</option>
                                    <option value="PUE">PUE - Pago en una sola exhibición</option>
                                    <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Forma de Pago</label>
                                <select class="vi-control form-select" id="vi-ped-forma-pago" name="forma-pago">
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Cheque nominativo</option>
                                    <option value="03">03 - Transferencia electrónica</option>
                                    <option value="04">04 - Tarjeta de crédito</option>
                                    <option value="28">28 - Tarjeta de débito</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-file-invoice"></i>Uso CFDI</label>
                                <select class="vi-control form-select" id="vi-ped-uso-cfdi" name="uso-cfdi">
                                    <option>G03 - Gastos en general</option>
                                    <option value="D01">D01 - Honorarios médicos</option>
                                    <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                    <option value="P01">P01 - Por definir</option>
                                </select>
                            </div>
                        </div>
