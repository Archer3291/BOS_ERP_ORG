        }

        .adenda-option.selected {
            border-color: #3b82f6;
            background: var(--vi-blue-50);
        }

        .adenda-option input[type="radio"] {
            width: 18px;
            height: 18px;
            margin-right: .85rem;
            margin-top: .15rem;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

    .adenda-label {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: .4rem;
        cursor: pointer;
    }

    .adenda-nombre {
        font-weight: 700;
        color: var(--vi-blue-600);
        font-size: .9rem;
    }

    /* ===== ANTICIPOS TABLE ===== */
    #tabla-anticipo {
        border-radius: var(--vi-radius-lg);
        border: 1px solid var(--vi-gray-200);
        box-shadow: var(--vi-shadow);
    }

    .vi-fac-btn-delete {
        background: var(--vi-red-600);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: .35rem .75rem;
        font-size: .8rem;
        cursor: pointer;
        transition: background .2s, transform .15s;
    }

        .vi-fac-btn-delete:hover {
            background: #b91c1c;
            transform: translateY(-1px);
        }

        .vi-fac-btn-delete:active {
            transform: scale(.96);
        }

        .vi-fac-btn-delete:disabled {
            background: #bdbdbd;
            cursor: not-allowed;
            opacity: .7;
        }
</style>*@


@{ var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS"); }

<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nueva Factura</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar la factura</p>
            </div>
            <!-- Botones de acción rápida en el header -->
            <div class="ms-auto d-flex gap-2">
                <button type="button" class="vi-btn vi-btn-primary"
                        data-bs-toggle="modal" data-bs-target="#vi-fac-modalBuscarDocumentos">
                    <i class="fas fa-file-alt"></i> Buscar Documentos
                </button>
                @* Se habilita desde facturacion-remisiones-parciales.js en cuanto
                   hay un cliente seleccionado: el modal filtra por cliente. *@
                <button type="button" class="vi-btn vi-btn-success"
                        id="vi-fac-btnEspeciales" disabled
                        title="Selecciona primero un cliente">
                    <i class="fas fa-folder-gear"></i> Especiales
                </button>
            </div>
        </div>

        <form id="vi-fac-formCotizacion" class="vi-fac-formCotizacion" method="post">

            <!-- ===== FILA PRINCIPAL ===== -->
            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-file-invoice-dollar"></i></div>
                            <h2 class="vi-section-title">Tipo de Factura</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vi-fac-tipo-pago-hidden-state" value="contado">
                        <div class="vi-pay-toggle" id="vi-fac-toggle-pago" data-state="contado"
                             style="grid-template-columns: 1fr 1fr;">
                            <button type="button" class="vi-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoFac('contado', event)">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vi-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoFac('credito', event)">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vi-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vi-fac-folio" value="@Model.Folio" name="folio"
                                       class="vi-control" readonly autocomplete="off">
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-building"></i>Sucursal</label>
                                <select class="vi-control form-select" id="vi-fac-sucursal" name="sucursal">
                                    <option selected>CEDIS</option>
                                    <option>Sucursal Centro</option>
                                    <option>Sucursal Norte</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-warehouse"></i>Almacén</label>
                                <select class="vi-control form-select" id="vi-fac-almacen" name="almacen">
                                    <option selected>ALMACÉN GENERAL</option>
                                    <option>ALMACÉN A</option>
                                    <option>ALMACÉN B</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vi-section-title">Información del Cliente</h2>
                            <button type="button" class="vi-btn vi-btn-primary ms-auto"
                                    data-bs-toggle="modal" data-bs-target="#vi-fac-modalBuscarAnticipos"
                                    id="btn-anticipos">
                                <i class="fas fa-plus"></i> Buscar Anticipos
                            </button>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vi-fac-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vi-control" id="vi-fac-cliente"
                                           placeholder="Seleccione un cliente…" disabled
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vi-fac-rfc" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Banner crédito (solo se muestra en ventas a crédito) -->
                            <div class="col-12">
                                <div id="vi-fac-credit-banner" style="display:none;" class="vi-credit-banner">
                                    <div id="vi-fac-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vi-fac-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vi-fac-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vi-banner-bar-wrap" id="vi-fac-credit-bar-wrap">
                                            <div class="vi-banner-bar-fill" id="vi-fac-credit-bar" style="width:0%;"></div>
                                        </div>
                                    </div>
                                    <div id="vi-fac-credit-pct" style="font-size:.8rem;font-weight:600;flex-shrink:0;"></div>
                                </div>
                            </div>

                            <!-- Info adicional -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vi-control" id="vi-fac-info-proveedor" rows="3" readonly autocomplete="off"></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vi-control form-select" name="vendedor" id="vi-fac-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vi-control form-select" name="moneda" id="vi-fac-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vi-fac-paridad" name="paridad" class="vi-control" value="1" autocomplete="off">
                            </div>

                            <!-- Referencia -->
                            <div class="col-12 col-sm-8">
                                <label class="vi-label"><i class="fas fa-comment"></i>Referencia</label>
                                <input type="text" id="vi-fac-concepto" name="concepto" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Incoterm (oculto) -->
                            <div class="col-12 d-none">
                                <label class="vi-label"><i class="fas fa-shipping-fast"></i>Incoterm</label>
                                <select class="vi-control form-select" name="incoterm" id="vi-fac-incoterm">
                                    <option selected disabled>Seleccionar Incoterm</option>
                                    <option value="EXW">EXW – En fábrica</option>
                                    <option value="FOB">FOB – Libre a bordo</option>
                                    <option value="CFR">CFR – Costo y flete</option>
                                    <option value="CIF">CIF – Costo, seguro y flete</option>
                                    <option value="DAP">DAP – Entregado en lugar</option>
                                    <option value="DDP">DDP – Entregado con derechos pagados</option>
                                </select>
                            </div>

                            <!-- Adendas (oculto por defecto) -->
                            <div class="col-12" id="vi-fac-seccion-adendas" style="display:none;">
                                <label class="vi-label"><i class="fas fa-file-contract"></i>Seleccionar Adenda</label>
                                <div id="vi-fac-adendas-container" class="adendas-radio-group">
                                    <!-- Se llenará dinámicamente -->
                                </div>
                                <input type="hidden" id="vi-fac-adenda-seleccionada" name="adenda-seleccionada">
                            </div>
                        </div>
                    </div><!-- /tarjeta cliente -->
                    <!-- TARJETA: Artículos -->
                    <div class="vi-card p-4 mb-4" id="vi-fac-seccion-productos">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-box-open"></i></div>
                            <h2 class="vi-section-title">Artículos y Productos</h2>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="vi-badge vi-badge-blue">
                                <i class="fas fa-list"></i> Lista de productos
                            </span>
                            <div class="d-flex gap-2">
                                <button type="button" class="vi-btn vi-btn-success"
                                        data-bs-toggle="modal" data-bs-target="#vi-fac-modalBuscarProducto">
                                    <i class="fas fa-plus"></i> Agregar
                                </button>
                                <button type="button" id="vi-fac-btn-validar-sat"
                                        class="vi-btn vi-btn-amber" onclick="validarPartidasSAT()">
                                    <i class="fas fa-shield-check"></i> Validar SAT
                                </button>
                            </div>
                        </div>

                        <div class="vi-table-wrap">
                            <table class="vi-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th>Existencia</th>
                                        <th>Cantidad</th>
                                        <th>Unidad</th>
                                        <th>Precio</th>
                                        @if (role == "Gerente")
                                        {
                                            <th>Desc %</th>
                                        }
                                        <th>Importe</th>
                                        <th>Comentario</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="vi-fac-productosTable">
                                    <tr>
                                        <td colspan="11" class="vi-table-empty">
                                            <i class="fas fa-box-open"></i>
                                            <div class="fw-semibold mb-1">Sin productos</div>
                                            <small style="color:var(--vi-gray-400)">Haz clic en "Agregar" para comenzar</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <hr class="vi-sep">

                        <!-- Flete -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label class="vi-switch" for="vi-fac-flete">
                                <input type="checkbox" id="vi-fac-flete">
                                <span class="vi-switch-track"></span>
                                <span class="vi-switch-label"><i class="fas fa-truck me-1"></i>Con Flete</span>
                            </label>
                            <input type="number" class="vi-control d-none" name="flete"
                                   id="vi-fac-flete-val" placeholder="Costo de flete" style="max-width:180px;">
                        </div>

                        <!-- Orden de compra -->
                        <div class="d-flex align-items-center gap-3">
                            <label class="vi-switch" for="vi-fac-orden-compra-check">
                                <input type="checkbox" id="vi-fac-orden-compra-check">
                                <span class="vi-switch-track"></span>
                                <span class="vi-switch-label"><i class="fas fa-file-alt me-1"></i>Con Orden de Compra</span>
                            </label>
                            <input type="text" class="vi-control d-none" name="ordenCompra"
                                   id="vi-fac-orden-compra-val" placeholder="Número de orden de compra"
                                   autocomplete="off" style="max-width:220px;">
                        </div>
                    </div><!-- /tarjeta artículos -->
                    <!-- TARJETA: Anticipos aplicados -->
                    <div class="vi-card p-4 mb-4" id="tabla-anticipo">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-wallet"></i></div>
                            <h2 class="vi-section-title">Anticipos Aplicados</h2>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead style="background:var(--vi-blue-50);">
                                    <tr>
                                        <th>Folio</th>
                                        <th>Cliente</th>
                                        <th>Fecha</th>
                                        <th>Monto</th>
                                        <th></th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="vi-fac-anticiposTable">
                                    <tr class="vi-fac-empty-state-anticipos">
                                        <td colspan="6" class="text-center py-3">
                                            <small style="color:var(--vi-gray-400)">No hay anticipos agregados</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- TARJETA: Condiciones de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vi-section-title">Condiciones de Pago</h2>
                        </div>

                        <!-- Campos crédito -->
                        <div id="vi-fac-campos-credito" style="display:none;">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-credit-card"></i>Límite de Crédito</label>
                                    <input type="number" id="vi-fac-limite-credito" name="limite-credito"
                                           value="0.00" readonly class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-credit-card"></i>Crédito Disponible</label>
                                    <input type="number" id="vi-fac-limite-disponible" name="limite-disponible"
                                           value="0.00" readonly class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-calendar-day"></i>Plazo (días)</label>
                                    <input type="number" id="vi-fac-plazo" name="plazo" class="vi-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-calendar"></i>Fecha de Pago</label>
                                    <input type="date" id="vi-fac-fecha-pago" name="fecha-pago" class="vi-control">
                                </div>
                            </div>
                        </div>

                        <!-- Campos anticipo -->
                        <div id="vi-fac-campos-anticipo" style="display:none;">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6" hidden>
                                    <label class="vi-label"><i class="fas fa-percent"></i>Porcentaje de Anticipo (%)</label>
                                    <input type="number" id="vi-fac-porcentaje-anticipo" name="porcentaje-anticipo"
                                           class="vi-control" placeholder="Ej: 50" min="0" max="100"
                                           oninput="calcularAnticipoFactura()" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-dollar-sign"></i>Monto Anticipo</label>
                                    <input type="number" id="vi-fac-monto-anticipo" name="monto-anticipo"
                                           class="vi-control" placeholder="0.00" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6" hidden>
                                    <label class="vi-label"><i class="fas fa-dollar-sign"></i>Saldo Pendiente</label>
                                    <input type="number" id="vi-fac-saldo-pendiente" name="saldo-pendiente"
                                           class="vi-control" placeholder="0.00" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vi-label"><i class="fas fa-calendar"></i>Fecha de Anticipo</label>
                                    <input type="date" id="vi-fac-fecha-anticipo" name="fecha-anticipo" class="vi-control">
                                </div>
                                <div class="col-12 col-sm-6" hidden>
                                    <label class="vi-label"><i class="fas fa-calendar-alt"></i>Fecha Pago Final</label>
                                    <input type="date" id="vi-fac-fecha-pago-final" name="fecha-pago-final" class="vi-control">
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Método de Pago</label>
                                <select class="vi-control form-select disabled-field"
                                        id="vi-fac-metodo-pago"
                                        name="metodo-pago"
                                        data-no-toggle="true">
                                    <option value="PUE">PUE - Pago en una sola exhibición</option>
                                    <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                                </select>
                                <input type="hidden" id="vi-fac-metodo-pago-hidden" name="metodo-pago-hidden" value="PUE">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-money-bill"></i>Forma de Pago</label>
                                <select class="vi-control form-select" id="vi-fac-forma-pago" name="forma-pago">
                                    <option selected>Efectivo</option>
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Cheque nominativo</option>
                                    <option value="03">03 - Transferencia electrónica</option>
                                    <option value="04">04 - Tarjeta de crédito</option>
                                    <option value="28">28 - Tarjeta de débito</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-file-invoice"></i>Uso CFDI</label>
                                <select class="vi-control form-select" id="vi-fac-uso-cfdi" name="uso-cfdi">
                                    <option selected>G03 - Gastos en general</option>
                                    <option value="D01">D01 - Honorarios médicos</option>
                                    <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                    <option value="P01">P01 - Por definir</option>
                                </select>
                            </div>
                        </div>
                    </div><!-- /tarjeta condiciones pago -->
                    <!-- TARJETA: Comentarios -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-comment-dots"></i></div>
                            <h2 class="vi-section-title">Comentarios Adicionales</h2>
                        </div>
                        <textarea class="vi-control" id="vi-fac-comentarios" name="comentarios" rows="4"
                                  placeholder="Observaciones, condiciones especiales, etc."></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA: RESUMEN ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem; z-index:0;">

                        <!-- Ticket resumen -->
                        <div class="vi-ticket mb-3">
                            <div class="vi-ticket-head">
                                <i class="fas fa-calculator vi-ticket-head-icon"></i>
                                <div class="vi-ticket-head-label">Resumen de Factura</div>
                            </div>
                            <div class="vi-ticket-body">
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Subtotal 1</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-total-subtotal1-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Descuento</span>
                                    <span class="vi-ticket-row-val vi-negative" id="vi-fac-total-descuento-display">-$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Flete</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-total-flete-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--vi-gray-200);border-bottom:none;">
                                    <span class="vi-ticket-row-label">Subtotal 2</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-total-subtotal2-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">IVA (16%)</span>
                                    <span class="vi-ticket-row-val" id="vi-fac-iva-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--vi-gray-200);border-bottom:none;">
                                    <span class="vi-ticket-row-label"><i class="fas fa-coins me-1"></i>Total</span>
                                    <strong class="vi-ticket-row-val" id="vi-fac-importe-display">$0.00</strong>
                                </div>
                                <div class="vi-ticket-row" id="total-anticipo">
                                    <span class="vi-ticket-row-label">Anticipos</span>
                                    <span class="vi-ticket-row-val vi-positive" id="vi-fac-total-anticipos-display">-$0.00</span>
                                </div>
                            </div>
                            <div class="vi-ticket-footer">
                                <div class="vi-ticket-total-row">
                                    <span class="vi-ticket-total-label"><i class="fas fa-money-bill-wave me-1"></i>Total</span>
                                    <strong class="vi-ticket-total-val" id="vi-fac-total-final-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vi-fac-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vi-fac-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vi-fac-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vi-fac-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vi-fac-iva" name="iva" value="0.00">
                            <input type="hidden" id="vi-fac-importe" name="importe" value="0.00">
                            <input type="hidden" id="vi-fac-total-anticipos" name="total-anticipos" value="0.00">
                            <input type="hidden" id="vi-fac-total-final" name="total-final" value="0.00">
                            <input type="hidden" id="vi-fac-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
