<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.7.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>

<script>
    /* ===== TOGGLE TIPO PAGO — reemplaza la lógica del toggle original ===== */
    function selectTipoPagoFac(val, event) {
        event?.preventDefault();
        event?.stopPropagation();

        document.querySelectorAll('#vi-fac-toggle-pago .vi-pay-btn')
            .forEach(b => b.classList.toggle('active', b.dataset.val === val));

        document.getElementById('vi-fac-toggle-pago').setAttribute('data-state', val);
        document.getElementById('vi-fac-tipo-pago-hidden-state').value = val;

        const camposCredito = document.getElementById('vi-fac-campos-credito');
        const camposAnticipo = document.getElementById('vi-fac-campos-anticipo');
        const secProductos = document.getElementById('vi-fac-seccion-productos');
        const tAnticipo = document.getElementById('tabla-anticipo');
        const btnAnticipo = document.getElementById('btn-anticipos');
        const totalAnticipo = document.getElementById('total-anticipo');

        camposCredito.style.display = 'none';
        camposAnticipo.style.display = 'none';

        if (val === 'contado') {
            limpiarCamposFactura();
            secProductos.style.display = '';
            tAnticipo.style.display = '';
            btnAnticipo.style.display = '';
            totalAnticipo.style.display = '';
        } else if (val === 'credito') {
            camposCredito.style.display = 'block';
            tAnticipo.style.display = 'none';
            btnAnticipo.style.display = 'none';
            totalAnticipo.style.display = 'none';
            limpiarCamposAnticipoFactura();
            secProductos.style.display = '';
        }

        setMetodoPagoSegunTipoView(val);

        // El crédito solo se valida en ventas a crédito.
        window.CreditoVentas?.evaluar('vi-fac');
    }

    /* Compatibilidad con toggleCreditoContadoFactura() que puede llamar código externo */
    // Compatibilidad — solo 2 estados ahora
    let paymentStates2Factura = ['contado', 'credito'];
    let currentStateIndex2Factura = 0;
    function toggleCreditoContadoFactura() {
        currentStateIndex2Factura = (currentStateIndex2Factura + 1) % paymentStates2Factura.length;
        selectTipoPagoFac(paymentStates2Factura[currentStateIndex2Factura]);
    }

    function setMetodoPagoSegunTipoView(estado) {
        const hidden = document.getElementById('vi-fac-metodo-pago-hidden');
        const select = document.getElementById('vi-fac-metodo-pago');
        const mapa = { contado: 'PUE', credito: 'PPD', anticipo: 'PUE' };
        const valor = mapa[estado] || 'PUE';

        if (hidden) hidden.value = valor;

        if (select) {
            // Quitar disabled temporalmente para poder cambiar el valor
            select.removeAttribute('disabled');
            // Seleccionar la opción correcta iterando (más confiable que .value en selects disabled)
            Array.from(select.options).forEach(opt => {
                opt.selected = opt.value === valor;
            });
            // Volver a deshabilitar
            select.setAttribute('disabled', 'disabled');
        }
    }
    function limpiarCamposFactura() { limpiarCamposCreditoFactura(); limpiarCamposAnticipoFactura(); }
    function limpiarCamposCreditoFactura() {
        document.getElementById('vi-fac-limite-credito').value = '0.00';
        document.getElementById('vi-fac-plazo').value = '';
        document.getElementById('vi-fac-fecha-pago').value = '';
    }
    function limpiarCamposAnticipoFactura() {
        document.getElementById('vi-fac-porcentaje-anticipo').value = '';
        document.getElementById('vi-fac-monto-anticipo').value = '';
        document.getElementById('vi-fac-saldo-pendiente').value = '';
        document.getElementById('vi-fac-fecha-anticipo').value = '';
        document.getElementById('vi-fac-fecha-pago-final').value = '';
    }

    function calcularAnticipoFactura() {
        const porcentaje = parseFloat(document.getElementById('vi-fac-porcentaje-anticipo').value) || 0;
        const totalVenta = parseFloat(document.getElementById('vi-fac-importe').value) || 0;
        const montoAnticipo = (totalVenta * porcentaje) / 100;
        document.getElementById('vi-fac-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vi-fac-saldo-pendiente').value = (totalVenta - montoAnticipo).toFixed(2);
    }

    /* ===== FLETE ===== */
    document.getElementById('vi-fac-flete').addEventListener('change', function () {
        const inp = document.getElementById('vi-fac-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== ORDEN DE COMPRA ===== */
    document.getElementById('vi-fac-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vi-fac-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>

<!-- ===== SCRIPTS PDF / VISTA PREVIA / SAT (sin cambios de lógica) ===== -->
<script>
    /* --- actualizarVistaPreviaFactura, descargarVistaPreviaFacturaPDF,
           validarPartidasSAT, enviarAlertaSAT, escapeHtml
           → mantener exactamente igual que en el archivo original --- */

    function actualizarVistaPreviaFactura() {
        const getValue = (id, d = '-') => document.getElementById(id)?.value?.trim() || d;
        const getSelectedText = (id, d = '-') => { const e = document.getElementById(id); return e?.options?.[e.selectedIndex]?.text?.trim() || d; };
        const setText = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
        const getDisplayValue = (id, d = '$0.00') => document.getElementById(id)?.textContent?.trim() || d;
        const getTomValueText = (key) => { const i = tomManager?.getInstance(key); const v = i?.getValue(); return i?.getItem(v)?.textContent?.trim() || ''; };

        setText('vi-fac-preview-folio', getValue('vi-fac-folio', 'Sin asignar'));
        setText('vi-fac-preview-sucursal', getSelectedText('vi-fac-sucursal', 'CEDIS'));
        setText('vi-fac-preview-fecha', new Date().toLocaleDateString('es-MX'));
        setText('vi-fac-preview-cliente', getValue('vi-fac-cliente'));
        setText('vi-fac-preview-rfc', getValue('vi-fac-rfc'));
        setText('vi-fac-preview-vendedor', getTomValueText('vi-fac-vendedor'));
        setText('vi-fac-preview-moneda', getTomValueText('vi-fac-moneda'));
        setText('vi-fac-preview-incoterm', getTomValueText('vi-fac-incoterm'));
        setText('vi-fac-preview-concepto', getValue('vi-fac-concepto'));

        setText('vi-fac-preview-subtotal1', getDisplayValue('vi-fac-total-subtotal1-display'));
        setText('vi-fac-preview-descuento', getDisplayValue('vi-fac-total-descuento-display'));
        setText('vi-fac-preview-flete', getDisplayValue('vi-fac-total-flete-display'));
        setText('vi-fac-preview-subtotal2', getDisplayValue('vi-fac-total-subtotal2-display'));
        setText('vi-fac-preview-iva', getDisplayValue('vi-fac-iva-display'));
        setText('vi-fac-preview-total', getDisplayValue('vi-fac-importe-display'));

        setText('vi-fac-preview-forma-pago', getTomValueText('vi-fac-forma-pago'));
        setText('vi-fac-preview-metodo-pago', getSelectedText('vi-fac-metodo-pago'));
        setText('vi-fac-preview-plazo', getValue('vi-fac-plazo'));
        setText('vi-fac-preview-fecha-pago', getValue('vi-fac-fecha-pago'));
        setText('vi-fac-preview-uso-cfdi', getTomValueText('vi-fac-uso-cfdi'));

        const comentarios = getValue('vi-fac-comentarios', '');
        const secCom = document.getElementById('vi-fac-preview-comentarios-section');
        const txtCom = document.getElementById('vi-fac-preview-comentarios');
        if (secCom) secCom.style.display = comentarios ? 'block' : 'none';
        if (txtCom && comentarios) txtCom.textContent = comentarios;

        // Productos
        const tbody = document.getElementById('vi-fac-productosTable');
        const preview = document.getElementById('vi-fac-preview-productos');
        if (!preview) return;
        preview.innerHTML = '';
        const rows = tbody ? Array.from(tbody.querySelectorAll('tr')).filter(r => !r.classList.contains('vi-fac-empty-state')) : [];
        if (rows.length === 0) {
            preview.innerHTML = '<tr><td colspan="7" style="padding:2rem;text-align:center;color:#999;">No hay productos agregados</td></tr>';
        } else {
            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                if (cols.length >= 8) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `<td style="padding:.5rem;border:1px solid #ddd;">${cols[0]?.textContent?.trim()}</td>
                        <td style="padding:.5rem;border:1px solid #ddd;">${cols[1]?.textContent?.trim()}</td>
                        <td style="padding:.5rem;text-align:center;border:1px solid #ddd;">${cols[3]?.querySelector('input')?.value || '0'}</td>
                        <td style="padding:.5rem;text-align:center;border:1px solid #ddd;">${cols[4]?.textContent?.trim()}</td>
                        <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">$${cols[5]?.querySelector('input')?.value || '0.00'}</td>
                        <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">${cols[6]?.querySelector('input')?.value || '0'}%</td>
                        <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">${cols[7]?.textContent?.trim()}</td>`;
                    preview.appendChild(tr);
                }
            });
        }
    }

    function escapeHtml(text) {
        const d = document.createElement('div');
        d.textContent = String(text ?? '');
        return d.innerHTML;
    }

    // ============================================
    // VALIDACIÓN SAT — INDEPENDIENTE DEL FLUJO PRINCIPAL
    // ============================================
    async function validarPartidasSAT() {
        const productos = FacturasApp?.productManagerInstance?.getFacturasProductosData?.() || [];

        if (!productos || productos.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Sin productos',
                text: 'Agrega al menos un producto antes de validar.',
                confirmButtonColor: '#f59e0b'
            });
            return;
        }

        // Botón: estado de carga
        const btn = document.getElementById('vi-fac-btn-validar-sat');
        const originalHtml = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Validando...';

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);
            formData.append('productosJSON', JSON.stringify(productos));

            const response = await fetch('/VIFactura/ValidarPartidsSAT', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) throw new Error(`HTTP ${response.status}`);

            const result = await response.json();

            if (!result.success) {
                Swal.fire({ icon: 'error', title: 'Error', text: result.message, confirmButtonColor: '#ef4444' });
                return;
            }

            mostrarResultadosValidacionSAT(result);

        } catch (error) {
            console.error('Error validando SAT:', error);
            Swal.fire({ icon: 'error', title: 'Error de conexión', text: error.message, confirmButtonColor: '#ef4444' });
        } finally {
            btn.disabled = false;
            btn.innerHTML = originalHtml;
        }
    }

    function mostrarResultadosValidacionSAT(result) {
        const { todoValido, totalProductos, productosValidos, productosInvalidos, resultados } = result;

        // Guardar globalmente para el envío
        window._satResultadosActuales = resultados;

        const filas = resultados.map(r => {
            const estadoIcon = r.valido
                ? '<span style="color:#10b981;font-size:1.1rem;">✅</span>'
                : '<span style="color:#ef4444;font-size:1.1rem;">❌</span>';

            const faltantes = !r.valido && r.camposFaltantes?.length
                ? `<div style="color:#ef4444;font-size:0.72rem;margin-top:3px;">
                 ⚠ ${r.camposFaltantes.join(' · ')}
               </div>`
                : '';

            const satInfo = r.valido
                ? `<span style="font-family:monospace;font-size:0.75rem;color:#6b7280;">
                 ${escapeHtml(r.prodSat)} / ${escapeHtml(r.udSat)} / ${escapeHtml(r.objImp)}
               </span>`
                : '<span style="color:#9ca3af;font-size:0.75rem;">—</span>';

            return `
            <tr style="border-bottom:1px solid #f1f5f9;">
              <td style="padding:8px 10px;text-align:center;">${estadoIcon}</td>
              <td style="padding:8px 10px;font-weight:600;font-size:0.82rem;color:#1e293b;">
                ${escapeHtml(r.productoId)}
              </td>
              <td style="padding:8px 10px;font-size:0.82rem;color:#475569;
                         max-width:180px;overflow:hidden;text-overflow:ellipsis;
                         white-space:nowrap;"
                  title="${escapeHtml(r.descripcion)}">
                ${escapeHtml(r.descripcion)}
              </td>
              <td style="padding:8px 10px;">${satInfo}${faltantes}</td>
            </tr>`;
        }).join('');

        // Sección correo — solo si hay errores
        const seccionCorreo = !todoValido ? `
        <div style="margin-top:16px;padding:14px 16px;background:#f0f9ff;
                    border:1.5px solid #bae6fd;border-radius:10px;">
          <div style="font-size:0.82rem;font-weight:700;color:#0369a1;margin-bottom:10px;">
            📧 Notificar al equipo de catálogos
          </div>

          <!-- Input de destinatarios -->
          <div style="margin-bottom:8px;">
            <input
              type="text"
              id="sat-alert-emails"
              placeholder="correo1@empresa.com, correo2@empresa.com"
              style="width:100%;box-sizing:border-box;padding:8px 12px;
                     border:1.5px solid #bae6fd;border-radius:8px;
                     font-size:0.82rem;color:#1e293b;background:#fff;
                     outline:none;"/>
            <div style="font-size:0.7rem;color:#64748b;margin-top:4px;">
              Separa múltiples correos con coma o punto y coma
            </div>
          </div>

          <!-- Botón de envío -->
          <button
            type="button"
            id="sat-alert-send-btn"
            onclick="enviarAlertaSAT()"
            style="width:100%;padding:9px 16px;
                   background:linear-gradient(135deg,#0ea5e9,#0369a1);
                   color:#fff;border:none;border-radius:8px;
                   font-size:0.83rem;font-weight:600;
                   cursor:pointer;transition:opacity .2s;
                   display:flex;align-items:center;justify-content:center;gap:6px;">
            <i class="fas fa-paper-plane"></i> Enviar alerta por correo
          </button>

          <!-- Feedback de envío (oculto inicialmente) -->
          <div id="sat-alert-feedback" style="display:none;margin-top:8px;
               padding:8px 12px;border-radius:8px;font-size:0.8rem;
               font-weight:600;text-align:center;"></div>
        </div>` : '';

        const headerColor = todoValido ? '#10b981' : '#f59e0b';
        const headerEmoji = todoValido ? '✅' : '⚠️';
        const headerTitulo = todoValido ? 'Todos los productos son válidos' : 'Revisión requerida';

        Swal.fire({
            title: `${headerEmoji} ${headerTitulo}`,
            html: `
            <div style="text-align:left;">

              <!-- Tarjetas de resumen -->
              <div style="display:flex;gap:10px;margin-bottom:16px;">
                <div style="flex:1;background:#f0fdf4;border:1.5px solid #bbf7d0;
                            border-radius:10px;padding:10px 14px;text-align:center;">
                  <div style="font-size:1.4rem;font-weight:700;color:#10b981;">
                    ${productosValidos}
                  </div>
                  <div style="font-size:0.72rem;color:#065f46;font-weight:600;
                              text-transform:uppercase;letter-spacing:.5px;">Válidos</div>
                </div>
                <div style="flex:1;background:#fff7ed;border:1.5px solid #fed7aa;
                            border-radius:10px;padding:10px 14px;text-align:center;">
                  <div style="font-size:1.4rem;font-weight:700;color:#f59e0b;">
                    ${totalProductos}
                  </div>
                  <div style="font-size:0.72rem;color:#92400e;font-weight:600;
                              text-transform:uppercase;letter-spacing:.5px;">Total</div>
                </div>
                <div style="flex:1;background:#fef2f2;border:1.5px solid #fecaca;
                            border-radius:10px;padding:10px 14px;text-align:center;">
                  <div style="font-size:1.4rem;font-weight:700;color:#ef4444;">
                    ${productosInvalidos}
                  </div>
                  <div style="font-size:0.72rem;color:#991b1b;font-weight:600;
                              text-transform:uppercase;letter-spacing:.5px;">Con errores</div>
                </div>
              </div>

              <!-- Tabla de detalle -->
              <div style="max-height:260px;overflow-y:auto;
                          border:1px solid #e2e8f0;border-radius:10px;">
                <table style="width:100%;border-collapse:collapse;
                              font-family:system-ui,sans-serif;">
                  <thead>
                    <tr style="background:#f8fafc;border-bottom:2px solid #e2e8f0;
                               position:sticky;top:0;z-index:1;">
                      <th style="padding:8px 10px;font-size:0.72rem;color:#64748b;
                                 font-weight:700;text-transform:uppercase;
                                 width:40px;text-align:center;">Estado</th>
                      <th style="padding:8px 10px;font-size:0.72rem;color:#64748b;
                                 font-weight:700;text-transform:uppercase;
                                 width:90px;">Clave</th>
                      <th style="padding:8px 10px;font-size:0.72rem;color:#64748b;
                                 font-weight:700;text-transform:uppercase;">Descripción</th>
                      <th style="padding:8px 10px;font-size:0.72rem;color:#64748b;
                                 font-weight:700;text-transform:uppercase;">
                        Datos SAT / Faltantes</th>
                    </tr>
                  </thead>
                  <tbody>${filas}</tbody>
                </table>
              </div>

              ${seccionCorreo}
            </div>`,
            icon: todoValido ? 'success' : 'warning',
            confirmButtonText: todoValido ? '¡Listo!' : 'Cerrar',
            confirmButtonColor: headerColor,
            width: '700px'
        });
    }

    // ============================================
    // ENVÍO DE ALERTA SAT — INDEPENDIENTE
    // ============================================
    async function enviarAlertaSAT() {
        const emailInput = document.getElementById('sat-alert-emails');
        const sendBtn = document.getElementById('sat-alert-send-btn');
        const feedback = document.getElementById('sat-alert-feedback');
        const emails = emailInput?.value?.trim();

        // Validar campo vacío
        if (!emails) {
            emailInput.style.borderColor = '#ef4444';
            emailInput.placeholder = '⚠ Ingresa al menos un correo';
            setTimeout(() => {
                emailInput.style.borderColor = '#bae6fd';
                emailInput.placeholder = 'correo1@empresa.com, correo2@empresa.com';
            }, 2500);
            return;
        }

        const invalidos = (window._satResultadosActuales || []).filter(r => !r.valido);
        if (invalidos.length === 0) return;

        // Estado de carga
        const originalHtml = sendBtn.innerHTML;
        sendBtn.disabled = true;
        sendBtn.style.opacity = '0.65';
        sendBtn.innerHTML = `
        <i class="fas fa-spinner fa-spin"></i> Enviando correo...`;

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const folio = document.getElementById('vi-fac-folio')?.value || 'Sin folio';
            const cliente = document.getElementById('vi-fac-cliente')?.value || 'Sin cliente';

            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);
            formData.append('emails', emails);
            formData.append('resultadosJson', JSON.stringify(invalidos));
            formData.append('folio', folio);
            formData.append('cliente', cliente);

            const response = await fetch('/VIFactura/EnviarAlertaSAT', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) throw new Error(`Error HTTP ${response.status}`);

            const result = await response.json();

            if (result.success) {
                // ✅ Éxito — feedback inline
                sendBtn.innerHTML = '<i class="fas fa-check"></i> ¡Correo enviado!';
                sendBtn.style.background = 'linear-gradient(135deg,#10b981,#059669)';
                sendBtn.style.opacity = '1';

                feedback.style.display = 'block';
                feedback.style.background = '#f0fdf4';
                feedback.style.color = '#065f46';
                feedback.style.border = '1px solid #bbf7d0';
                feedback.innerHTML = `✅ ${result.message}`;

                // Deshabilitar para evitar reenvíos
                emailInput.disabled = true;
                emailInput.style.background = '#f8fafc';
                emailInput.style.color = '#94a3b8';

            } else {
                throw new Error(result.message || 'No se pudo enviar el correo');
            }

        } catch (error) {
            console.error('Error enviando alerta SAT:', error);

            // ❌ Error — restaurar botón y mostrar feedback
            sendBtn.disabled = false;
            sendBtn.style.opacity = '1';
            sendBtn.innerHTML = originalHtml;

            feedback.style.display = 'block';
            feedback.style.background = '#fef2f2';
            feedback.style.color = '#991b1b';
            feedback.style.border = '1px solid #fecaca';
            feedback.innerHTML = `❌ ${error.message}`;

            // Auto-ocultar el error después de 4 segundos
            setTimeout(() => { feedback.style.display = 'none'; }, 4000);
        }
    }

    // Helper HTML escape
    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = String(text ?? '');
        return div.innerHTML;
    }
</script>

