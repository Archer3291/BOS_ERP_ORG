    .vi-search-item {
        padding: .7rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--vi-gray-200);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color .2s, background .2s, transform .15s;
        background: var(--bg-light, #fff);
        color: var(--vi-gray-800);
    }

        .vi-search-item:hover {
            border-color: #3b82f6;
            background: var(--vi-blue-50);
            transform: translateX(3px);
        }

    /* ===== BADGE ===== */
    .vi-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .2rem .6rem;
        border-radius: 99px;
    }

    .vi-badge-blue {
        background: var(--vi-blue-50);
        color: var(--vi-blue-600);
    }

    .vi-badge-green {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    .document-badge {
        display: inline-block;
        padding: .2rem .7rem;
        border-radius: 99px;
        font-size: .7rem;
        font-weight: 700;
    }

    .badge-pending {
        background: var(--vi-amber-50);
        color: var(--vi-amber-600);
    }

    .badge-approved {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    .badge-cancelled {
        background: var(--vi-red-50);
        color: var(--vi-red-600);
    }

    /* ===== BOTÓN FLOTANTE ===== */
    .vi-floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--vi-blue-600);
        color: #fff;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(30,58,95,.4);
        transition: transform .3s, box-shadow .3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .vi-floating-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(30,58,95,.5);
        }

    .vi-floating-tooltip {
        position: fixed;
        bottom: 38px;
        right: 96px;
        background: var(--vi-gray-800);
        color: #fff;
        padding: .4rem .9rem;
        border-radius: 8px;
        font-size: .8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s;
        z-index: 999;
    }

    .vi-floating-btn:hover + .vi-floating-tooltip {
        opacity: 1;
    }

    /* ===== ADENDAS ===== */
    .adendas-radio-group {
        display: flex;
        flex-direction: column;
        gap: .75rem;
        padding: 1rem;
        background: var(--vi-gray-50);
        border-radius: var(--vi-radius);
        border: 1px solid var(--vi-gray-200);
        max-height: 380px;
        overflow-y: auto;
    }

    .adenda-option {
        display: flex;
        align-items: flex-start;
        padding: .85rem 1rem;
        background: var(--bg-light, #fff);
        border-radius: 8px;
        border: 1.5px solid var(--vi-gray-200);
        cursor: pointer;
        transition: border-color .2s, transform .15s;
    }

        .adenda-option:hover {
            border-color: #3b82f6;
