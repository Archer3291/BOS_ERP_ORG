@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfo

<style>
    /* ===== ADENDAS — set completo ===== */
    .adendas-radio-group {
        display: flex;
        flex-direction: column;
        gap: .65rem;
        padding: 1rem;
        background: var(--vi-gray-50);
        border-radius: var(--vi-radius);
        border: 1px solid var(--vi-gray-200);
        max-height: 480px;
        overflow-y: auto;
    }

    .adenda-option {
        position: relative;
        display: flex;
        align-items: flex-start;
        padding: .9rem 1rem;
        background: var(--bg-light, #fff);
        border-radius: 10px;
        border: 1.5px solid var(--vi-gray-200);
        cursor: pointer;
        transition: border-color .2s, transform .15s, box-shadow .2s;
    }

        .adenda-option::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 4px;
            border-radius: 10px 0 0 10px;
            background: #3b82f6;
            opacity: 0;
            transition: opacity .2s;
        }

        .adenda-option:hover {
            border-color: #3b82f6;
            transform: translateX(3px);
            box-shadow: var(--vi-shadow);
        }

        .adenda-option.selected {
            border-color: #3b82f6;
            background: var(--vi-blue-50);
            box-shadow: 0 2px 10px rgba(59,130,246,.15);
        }

            .adenda-option.selected::before {
                opacity: 1;
            }

        .adenda-option input[type="radio"] {
            width: 18px;
            height: 18px;
            margin-right: .85rem;
            margin-top: .15rem;
            accent-color: #3b82f6;
            flex-shrink: 0;
        }

    .adenda-label {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: .6rem;
        cursor: pointer;
        min-width: 0; /* permite que el contenido se encoja en vez de desbordar */
    }

    /* ---- Header: nombre + badges ---- */
    .adenda-header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .5rem;
    }

    .adenda-nombre {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-weight: 700;
        color: var(--vi-blue-600);
        font-size: .92rem;
    }

    .adenda-badges {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
    }

    .adenda-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .68rem;
        font-weight: 700;
        padding: .15rem .55rem;
        border-radius: 99px;
        background: var(--vi-gray-100);
        color: var(--vi-gray-600);
        white-space: nowrap;
    }

    .badge-version {
        background: var(--vi-blue-50);
        color: var(--vi-blue-600);
    }

    .badge-prefix {
        background: var(--vi-gray-100);
        color: var(--vi-gray-600);
    }

    .badge-conceptos {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    /* ---- Detalles (ID, namespace) ---- */
    .adenda-details {
        display: flex;
        flex-wrap: wrap;
        gap: 1rem;
        padding: .5rem .75rem;
        background: var(--vi-gray-50);
        border-radius: 8px;
        border: 1px solid var(--vi-gray-200);
    }

    .adenda-detail-item {
        display: flex;
        flex-direction: column;
        gap: .15rem;
        min-width: 110px;
    }

    .detail-label {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
        color: var(--vi-gray-400);
    }

    .detail-value {
        font-size: .78rem;
        color: var(--vi-gray-800);
        font-family: 'Courier New', monospace;
        word-break: break-all;
    }

    /* ---- Acordeón JSON Template ---- */
    .adenda-template-accordion {
        border: 1px solid var(--vi-gray-200);
        border-radius: 8px;
        overflow: hidden;
    }

    .adenda-template-toggle {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: .5rem .75rem;
        background: var(--vi-gray-50);
        border: none;
        font-size: .8rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        cursor: pointer;
        transition: background .15s;
    }

        .adenda-template-toggle:hover {
            background: var(--vi-blue-50);
            color: var(--vi-blue-600);
        }

        .adenda-template-toggle i.fa-chevron-down {
            transition: transform .2s;
            font-size: .7rem;
        }

        .adenda-template-toggle.expanded i.fa-chevron-down {
            transform: rotate(180deg);
        }

    .adenda-template-content {
        max-height: 0;
        overflow: hidden;
        transition: max-height .25s ease;
        background: var(--vi-gray-900, #1e293b);
    }

        .adenda-template-content.show {
            max-height: 260px;
            overflow-y: auto;
        }

    .template-content {
        margin: 0;
        padding: .75rem .9rem;
        font-family: 'Courier New', monospace;
        font-size: .72rem;
        line-height: 1.5;
        color: #d4d4d4;
        white-space: pre-wrap;
        word-break: break-word;
    }

    /* ---- Timestamp ---- */
    .adenda-timestamp {
        display: flex;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: .5rem;
        font-size: .7rem;
        color: var(--vi-gray-400);
        padding-top: .4rem;
        border-top: 1px dashed var(--vi-gray-200);
    }

    /* ---- Mensaje sin adendas ---- */
    .no-adendas-message {
        text-align: center;
        padding: 2.5rem 1rem;
        color: var(--vi-gray-400);
    }

        .no-adendas-message i {
            font-size: 2.2rem;
            display: block;
            margin-bottom: .6rem;
            opacity: .35;
        }
</style>
