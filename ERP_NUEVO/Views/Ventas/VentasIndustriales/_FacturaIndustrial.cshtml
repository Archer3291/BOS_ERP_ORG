        }

    .vi-btn-amber {
        background: var(--vi-amber-600);
        color: #fff;
    }

        .vi-btn-amber:hover {
            background: #b45309;
            box-shadow: 0 4px 14px rgba(217,119,6,.3);
        }

    /* ===== TICKET / RESUMEN ===== */
    .vi-ticket {
        border: 1px solid var(--vi-gray-200);
        border-radius: var(--vi-radius-lg);
        overflow: hidden;
        box-shadow: var(--vi-shadow);
    }

    .vi-ticket-head {
        background: var(--vi-blue-600);
        color: #fff;
        padding: 1.1rem 1.4rem;
        text-align: center;
    }

    .vi-ticket-head-icon {
        font-size: 1.5rem;
        opacity: .9;
        display: block;
        margin-bottom: .2rem;
    }

    .vi-ticket-head-label {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .vi-ticket-body {
        padding: 1.1rem 1.4rem;
        background: var(--bg-light, #fff);
    }

    .vi-ticket-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .55rem 0;
        border-bottom: 1px dashed var(--vi-gray-200);
        font-size: .85rem;
        color: var(--vi-gray-800);
    }

        .vi-ticket-row:last-child {
            border-bottom: none;
        }

    .vi-ticket-row-label {
        color: var(--vi-gray-600);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vi-ticket-row-val {
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: var(--vi-gray-800);
    }

        .vi-ticket-row-val.vi-negative {
            color: var(--vi-red-600);
        }

        .vi-ticket-row-val.vi-positive {
            color: var(--vi-green-600);
        }

    .vi-ticket-footer {
        background: var(--vi-blue-50);
        border-top: 2px dashed var(--vi-blue-100);
