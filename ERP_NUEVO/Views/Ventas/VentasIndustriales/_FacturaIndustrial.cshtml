        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vi-ticket-total-val {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--vi-blue-600);
        font-family: 'Courier New', monospace;
    }

    /* ===== SWITCH ===== */
    .vi-switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .vi-switch-track {
        position: relative;
        width: 52px;
        height: 28px;
        border-radius: 99px;
        background: var(--vi-gray-200);
        transition: background .3s;
        flex-shrink: 0;
    }

        .vi-switch-track::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 3px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
            transition: transform .3s;
        }

    .vi-switch input {
        display: none;
    }

        .vi-switch input:checked ~ .vi-switch-track {
            background: var(--vi-green-600);
        }

            .vi-switch input:checked ~ .vi-switch-track::after {
                transform: translateX(24px);
            }

    .vi-switch-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        user-select: none;
    }

    /* ===== SEPARADOR ===== */
    .vi-sep {
        border: none;
        border-top: 1px dashed var(--vi-gray-200);
        margin: 1.25rem 0;
    }

    /* ===== MODAL ===== */
    .vi-modal-header {
        background: var(--vi-blue-600);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vi-modal-header .btn-close {
            filter: invert(1);
        }

