            const result = await Swal.fire({
                title: '<i class="fas fa-file-invoice-dollar"></i> Contabilizar autofacturadas',
                html: `
                    <p style="font-size:.85rem; color:#6b7280; text-align:left;">
                        Estas ventas ya tienen CFDI emitido por el cliente en el portal, pero les
                        falta su pedido, remisión, factura y póliza. Se generarán ahora;
                        <strong>no se timbrará nada de nuevo</strong>.
                    </p>
                    ${data.resumen.sinCfdiRegistrado > 0 ? `
                    <p style="font-size:.8rem; background:#fef3c7; border:1px solid #fcd34d;
                              border-radius:6px; padding:.5rem; text-align:left;">
                        <strong>${data.resumen.sinCfdiRegistrado}</strong> venta(s) tienen un uuid
                        que no corresponde a ninguna factura registrada. Revísalas antes de
                        contabilizarlas.
                    </p>` : ''}
                    <div style="max-height:46vh; overflow-y:auto; margin-top:.5rem;">
                        <table style="width:100%; border-collapse:collapse;">${filas}</table>
                    </div>`,
                width: '700px',
                showCancelButton: true,
                confirmButtonText: '<i class="fas fa-check"></i> Contabilizar seleccionadas',
                cancelButtonText: 'Cerrar',
                preConfirm: () => {
                    const ids = Array.from(document.querySelectorAll('.chk-autofact:checked'))
                        .map(c => c.value);
                    if (ids.length === 0) {
                        Swal.showValidationMessage('Selecciona al menos una venta.');
                        return false;
                    }
                    return ids;
                }
            });

            if (result.isConfirmed) await contabilizarAutofacturadas(result.value);

        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error de conexión', text: e.message });
        }
    }

    async function contabilizarAutofacturadas(ids) {
        // La póliza de cobro necesita la cuenta bancaria; se pide igual que en el cierre.
        const cuenta = await pedirCuentaBancaria();
        if (!cuenta) return;

        Swal.fire({
            title: 'Generando documentos y pólizas',
            html: `Procesando ${ids.length} venta(s)...`,
            didOpen: () => Swal.showLoading(),
            allowOutsideClick: false,
            showConfirmButton: false
        });

        try {
            const formData = new FormData();
            formData.append('ids', ids.join(','));
            formData.append('banco', cuenta);

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            if (token) formData.append('__RequestVerificationToken', token);

            const r = await fetch('/PuntoDeVenta/ContabilizarAutofacturadas', {
                method: 'POST', body: formData
            });
            const data = await r.json();

            if (data.sessionExpired) {
                Swal.fire({ icon: 'warning', title: 'Sesión expirada', text: data.message })
                    .then(() => window.location.reload());
                return;
            }

            const fallidas = data.fallidas || [];
            const detalleFallos = fallidas.length
                ? `<div style="text-align:left; margin-top:.75rem; font-size:.8rem;">
                       <strong>Pendientes:</strong>
                       <ul style="margin:.3rem 0 0 1rem; padding:0;">
                           ${fallidas.map(f => `<li>Venta #${f.ventaId}: ${f.error}</li>`).join('')}
                       </ul>
                   </div>`
                : '';

            await Swal.fire({
                icon: data.success ? 'success' : 'warning',
                title: data.success ? 'Contabilización completada' : 'Completada con pendientes',
                html: `${data.message}${detalleFallos}`,
                width: '620px'
            });

            window.location.reload();

        } catch (e) {
            Swal.fire({ icon: 'error', title: 'Error', text: e.message });
        }
    }

