    //DatosGeneral
    // Calcular totales generales
    function calcularTotales() {
        const initialFund = parseFloat(document.getElementById('initialFund').textContent.replace(',', '')) || 0;
        const withdrawals = parseFloat(document.getElementById('withdrawalsAmount')?.textContent || 0);
        const expenses = parseFloat(document.getElementById('expensesAmount')?.textContent || 0);
        const returns = parseFloat(document.getElementById('returnsAmount')?.textContent || 0);
        // Calcular ventas totales de forma dinámica
        let totalSales = 0;
        let cashSales = 0;

        METODOS_PAGO.forEach(metodo => {
            const salesElement = document.getElementById(`${metodo.id}SalesAuto`);
            const sales = salesElement ? parseFloat(salesElement.textContent) || 0 : 0;
            totalSales += sales;

            // Identificar efectivo para el cálculo de caja
            if (metodo.normalizado === 'Efectivo') {
                cashSales = sales;
            }
        });

        document.getElementById('totalSales').textContent = totalSales.toFixed(2);

        // Calcular efectivo esperado
        const expectedCash = initialFund + cashSales - withdrawals - expenses - returns;
        document.getElementById('expectedCash').textContent = expectedCash.toFixed(2);
        document.getElementById('expectedTotal').textContent = expectedCash.toFixed(2);

        // Calcular diferencia
        const difference = expectedCash;
        const differenceElement = document.getElementById('difference');
        differenceElement.textContent = '$' + Math.abs(difference).toFixed(2);

        if (difference > 0) {
            differenceElement.className = 'difference-positive';
            differenceElement.textContent = '+$' + difference.toFixed(2);
        } else if (difference < 0) {
            differenceElement.className = 'difference-negative';
            differenceElement.textContent = '-$' + Math.abs(difference).toFixed(2);
        } else {
            differenceElement.className = '';
            differenceElement.textContent = '$0.00';
        }

        document.getElementById('totalTransactions').textContent = tickets.length;
    }

    // ============================================
    // OBTENER DOCUMENTOS PENDIENTES
    // ============================================
    async function obtenerDocumentosPendientes() {
        try {
            const response = await fetch('/PuntoVentaAdministracion/ObtenerTodosDocumentosFacturables', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: '__RequestVerificationToken=' + document.querySelector('input[name="__RequestVerificationToken"]')?.value
            });

            if (!response.ok) {
                throw new Error(`Error HTTP ${response.status}`);
            }

            const result = await response.json();

            if (!result.success) {
                Swal.fire({
                    icon: 'error',
                    title: 'Error al obtener documentos',
                    text: result.message || 'No se pudieron obtener los documentos'
                });
                return [];
            }

            return result.data ? result.data.filter(d => !d.invoiced) : [];

        } catch (error) {
            console.error('Error al obtener documentos:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error de conexión',
                text: error.message
            });
            return [];
        }
    }


    // ==================== FACTURACIÓN MASIVA ====================

    async function facturarTodosDocumentos() {
        // Obtener todos los documentos pendientes (sin filtrar aún)
        const documentosPendientes = await obtenerDocumentosPendientes();

        if (!documentosPendientes || documentosPendientes.length === 0) {
            Swal.fire({
                icon: 'info',
                title: 'Sin documentos',
                text: 'No hay documentos disponibles para procesar'
            });
            return;
        }

        // El servidor ya clasificó cada venta (ClasificarDestinoFacturacion):
        //   global      → cobrada 100% en efectivo, va dentro de la factura global
        //   individual  → cualquier otra forma de pago, comprobante propio a público
        //                 en general con SU forma de pago
        //   credito     → ya se facturó nominativa al registrarse
        //   facturado   → ya tiene factura
        const documentosGlobal = documentosPendientes.filter(d => d.destino === 'global');
        const documentosIndividuales = documentosPendientes.filter(d => d.destino === 'individual');
        const documentosCredito = documentosPendientes.filter(d => d.destino === 'credito');

        const documentosSinFacturar = documentosGlobal.concat(documentosIndividuales);
        const documentosYaFacturados = documentosPendientes.filter(d => d.destino === 'facturado').length;

        // Verificar si hay documentos para procesar
        if (documentosSinFacturar.length === 0) {
            Swal.fire({
                icon: 'warning',
                title: 'Todos los documentos ya están facturados',
                html: `
                <div style="text-align: left; padding: 1rem;">
                    <p style="color: #6b7280;">
                        Los ${documentosPendientes.length} documento(s) encontrado(s) ya han sido timbrados previamente.
                    </p>
                    <p style="color: #059669; margin-top: 1rem;">
                        <i class="fas fa-check-circle"></i> No hay documentos pendientes de facturar.
                    </p>
                </div>
            `,
                width: '500px'
            });
            return;
        }

        // Las cuentas de depósito se resuelven ANTES de mostrar nada: cada forma de
        // pago ya trae la suya configurada en Punto de Venta Administrativo, así que el
        // resumen las muestra preseleccionadas en vez de pedirlas a ciegas al final.
        await CuentasBancoCierre.cargar();

        const formasDelCorte = formasDePagoDelCorte(documentosGlobal, documentosIndividuales);

        const htmlResumen =
            generarResumenDestinos(documentosGlobal, documentosIndividuales, documentosCredito) +
            generarSelectorCuentas(formasDelCorte) +
            generarResumenDocumentos(documentosSinFacturar, documentosYaFacturados);

        const confirmResumen = await Swal.fire({
            title: '📋 Resumen de Facturación del Corte',
            html: htmlResumen,
            icon: 'info',
            showCancelButton: true,
            confirmButtonText: 'Continuar',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#6b7280',
            width: '700px',
            customClass: {
                popup: 'resumen-facturacion-popup'
            },
            preConfirm: () => {
                const cuentas = {};
                let faltante = null;

                formasDelCorte.forEach(f => {
                    const sel = document.getElementById(`cuenta-forma-${f.cve}`);
                    const valor = sel ? sel.value : '';
                    if (!valor) faltante = f.nombre;
                    cuentas[f.cve] = valor;
                });

                if (faltante) {
                    Swal.showValidationMessage(`Falta la cuenta de depósito de ${faltante}`);
                    return false;
                }

                return cuentas;
            }
        });

        if (!confirmResumen.isConfirmed) return;

        const cuentasPorForma = confirmResumen.value || {};

        // Confirmar acción final
        const confirmResult = await Swal.fire({
            title: '⚠️ Confirmar Facturación Global',
            html: `
            <div style="text-align: left; padding: 1rem;">
                <p style="color: #dc2626; font-weight: 600; margin-bottom: 1rem;">
                    <i class="fas fa-exclamation-triangle"></i>
                    Se timbrarán ${(documentosGlobal.length ? 1 : 0) + documentosIndividuales.length} comprobante(s).
                </p>
                <ul style="margin-left: 1.5rem; color: #6b7280;">
                    ${documentosGlobal.length
                        ? `<li><b>1 factura global</b> con ${documentosGlobal.length} venta(s) en efectivo</li>`
                        : '<li>No hay ventas en efectivo: no se emite factura global</li>'}
                    ${documentosIndividuales.length
                        ? `<li><b>${documentosIndividuales.length} factura(s) individual(es)</b> a público en general, una por venta con otra forma de pago</li>`
                        : ''}
                </ul>
                <p style="margin-top: 1rem; color: #059669;">
                    <i class="fas fa-info-circle"></i>
                    Este proceso puede tardar varios minutos.
                </p>
            </div>
        `,
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, procesar todos',
            cancelButtonText: 'Cancelar',
            confirmButtonColor: '#7c3aed',
            cancelButtonColor: '#6b7280',
            width: '600px'
        });

        if (!confirmResult.isConfirmed) return;

        // La cuenta de cada comprobante ya se eligió en el resumen: no hay un segundo
        // diálogo pidiendo "una" cuenta sin decir para qué factura era.

        // Mostrar modal de progreso mejorado
        const progressModal = mostrarModalProgresoMejorado(documentosSinFacturar.length);

        try {
            // Cada comprobante es una llamada y una transacción aparte: si el PAC rechaza
            // una venta con tarjeta, la global del efectivo y las demás ya timbradas se
            // conservan. Antes iba todo en un solo CFDI y un problema tumbaba el corte.
            const lotes = [];

            if (documentosGlobal.length) {
                lotes.push({
                    clase: 'global',
                    titulo: `Factura global · ${documentosGlobal.length} venta(s) en efectivo`,
                    ids: documentosGlobal.map(d => d.id_encabezado),
                    banco: cuentasPorForma['01'],
                    docs: documentosGlobal
                });
            }

            documentosIndividuales.forEach(doc => {
                lotes.push({
                    clase: 'individual',
                    titulo: `${doc.folio} · ${doc.forma_pago_nombre || 'Otra forma de pago'}`,
                    ids: [doc.id_encabezado],
                    banco: cuentasPorForma[doc.forma_pago_clave],
                    docs: [doc]
                });
            });

            const resultados = [];

            for (let i = 0; i < lotes.length; i++) {
                const lote = lotes[i];

                actualizarProgresoDetallado(
                    progressModal, i, `Timbrando ${i + 1} de ${lotes.length}: ${lote.titulo}`, lotes.length);

                const resultado = await timbrarLoteCorte(lote);
                resultados.push({ lote, resultado });

                // Un rechazo no detiene el corte: se sigue con los demás y al final se
                // informa cuáles quedaron pendientes y por qué.
                actualizarProgresoDetallado(
                    progressModal, i + 1, `Timbrando ${i + 1} de ${lotes.length}: ${lote.titulo}`, lotes.length);
            }

            cerrarModalProgreso(progressModal);
            mostrarResumenCorte(resultados);

        } catch (error) {
            cerrarModalProgreso(progressModal);
            mostrarErrorConexion(error);
        }
    }

    // Una llamada al pipeline de facturación por lote. Devuelve siempre un objeto con
    // `success`, para que el corte pueda seguir con los demás comprobantes.
    async function timbrarLoteCorte(lote) {
        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const formData = new FormData();
            if (token) formData.append('__RequestVerificationToken', token);

            formData.append('idsDocumentos', lote.ids.join(','));

            // Sólo el comprobante del efectivo es GLOBAL (GLFAC/91): es el único que
            // agrupa varias ventas de un periodo. Cada venta con otra forma de pago se
            // timbra como VSFAC/52 con el destino "publico": mismo documento de venta de
            // sucursal, pero al receptor genérico de público en general, porque esos
            // clientes tampoco pidieron factura a su nombre.
            //
            // Todo lo demás (forma de pago, uso de CFDI, régimen) lo resuelve el
            // servidor desde el documento; no se manda nada desde aquí.
            formData.append('tipo', lote.clase === 'global' ? 'global' : 'publico');
            formData.append('banco', lote.banco || '');

            const response = await fetch('/PuntoDeVenta/ProcesarDocumentosAsync', {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                const texto = await response.text();
                return { success: false, error: `HTTP ${response.status}`, detalle: texto.slice(0, 300) };
            }

            return await response.json();
        } catch (e) {
            return { success: false, error: String(e) };
        }
    }

    // Resultado del corte completo: qué se timbró y qué no, comprobante por comprobante.
    function mostrarResumenCorte(resultados) {
        const money = n => `$${(parseFloat(n) || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const ok = resultados.filter(r => r.resultado && r.resultado.success);
        const fallidos = resultados.filter(r => !r.resultado || !r.resultado.success);

        const fila = (r, exito) => {
            const total = r.lote.docs.reduce((s, d) => s + (parseFloat(d.imp) || 0), 0);
            const icono = exito ? '✅' : '❌';
            const d = (r.resultado && r.resultado.detalles) || {};
            const detalle = exito
                ? `<div style="font-size:.72rem; color:#6b7280; word-break:break-all;">
                       ${d.serie || ''}${d.folio || ''} ${d.uuid || ''}
                   </div>`
                : `<div style="font-size:.75rem; color:#b91c1c;">${(r.resultado && (r.resultado.error || r.resultado.message)) || 'Error desconocido'}</div>`;

            return `
                <div style="display:flex; justify-content:space-between; gap:12px; padding:.5rem 0; border-bottom:1px solid #f3f4f6;">
                    <div style="min-width:0;">
                        <div style="font-weight:600;">${icono} ${r.lote.titulo}</div>
                        ${detalle}
                    </div>
                    <div style="white-space:nowrap; font-weight:600;">${money(total)}</div>
                </div>`;
        };

        Swal.fire({
            icon: fallidos.length === 0 ? 'success' : (ok.length === 0 ? 'error' : 'warning'),
            title: fallidos.length === 0
                ? 'Corte facturado'
                : (ok.length === 0 ? 'No se pudo facturar el corte' : 'Corte facturado con pendientes'),
            html: `
                <div style="text-align:left; max-height:55vh; overflow-y:auto;">
                    <p style="color:#6b7280; font-size:.9rem;">
                        ${ok.length} comprobante(s) timbrado(s)${fallidos.length ? `, ${fallidos.length} con error` : ''}.
                    </p>
                    ${ok.map(r => fila(r, true)).join('')}
                    ${fallidos.map(r => fila(r, false)).join('')}
                    ${fallidos.length ? `
                        <p style="margin-top:1rem; color:#92400e; font-size:.85rem;">
                            Lo que falló NO se guardó: esas ventas siguen pendientes y se pueden
                            volver a intentar sin duplicar nada.
                        </p>` : ''}
                </div>`,
            width: '720px',
            confirmButtonText: 'Entendido'
        }).then(() => window.location.reload());
    }

    // Formas de pago que intervienen en este corte, cada una con la cuenta que le
    // toca. El efectivo entra sólo si hay factura global; las demás salen de las
    // ventas que se van a timbrar por separado.
    function formasDePagoDelCorte(docsGlobal, docsIndividuales) {
        const formas = [];

        if (docsGlobal.length) {
            formas.push({
                cve: '01',
                nombre: 'Efectivo (factura global)',
                comprobantes: 1,
                ventas: docsGlobal.length
            });
        }

        const porClave = {};
        docsIndividuales.forEach(d => {
            const cve = d.forma_pago_clave || '';
            if (!porClave[cve]) {
                porClave[cve] = {
                    cve,
                    nombre: d.forma_pago_nombre || 'Sin forma de pago',
                    comprobantes: 0,
                    ventas: 0
                };
            }
            porClave[cve].comprobantes++;
            porClave[cve].ventas++;
        });

        return formas.concat(Object.values(porClave));
    }

    // Un select por forma de pago, ya preseleccionado con la cuenta configurada. No se
    // pregunta a ciegas "una" cuenta al final del proceso: aquí se ve para qué
    // comprobante es cada una y se puede cambiar el día que haga falta.
    function generarSelectorCuentas(formas) {
        if (!formas.length) return '';

        const cuentasDe = cve => {
            const forma = (CuentasBancoCierre.formas || []).find(f => f.cve_sat === cve);
            const configuradas = (forma && forma.cuentas) || [];
            if (configuradas.length) return { lista: configuradas, configurado: true };

            // Sin configuración se ofrece el catálogo, descartando las cuentas sin
            // cuenta contable: con ésas la póliza del cobro fallaría.
            const todas = (CuentasBancoCierre.todas || [])
                .filter(c => c.cuenta_contable && c.contabilizable);
            return { lista: todas, configurado: false };
        };

        const filas = formas.map(f => {
            const { lista, configurado } = cuentasDe(f.cve);
            const pred = lista.find(c => c.predeterminada) || lista[0];

            const opciones = lista.length
                ? lista.map(c => `
                    <option value="${c.cuenta_contable}" ${pred && c.cuenta_contable === pred.cuenta_contable ? 'selected' : ''}>
                        ${c.nombre}${c.cuenta_contable ? ' · ' + c.cuenta_contable : ''}
                    </option>`).join('')
                : '<option value="">No hay cuentas dadas de alta</option>';

            const aviso = configurado
                ? ''
                : `<div style="font-size:.72rem; color:#92400e;">
                       Esta forma de pago no tiene cuenta configurada en Formas de Pago y Bancos.
                   </div>`;

            return `
                <div style="display:flex; align-items:center; gap:10px; padding:.4rem 0; border-bottom:1px solid #f3f4f6;">
                    <div style="flex:1; min-width:0;">
                        <div style="font-weight:600; font-size:.85rem;">${f.nombre}</div>
                        <div style="font-size:.72rem; color:#6b7280;">
                            ${f.comprobantes} comprobante(s) · ${f.ventas} venta(s)
                        </div>
                        ${aviso}
                    </div>
                    <select id="cuenta-forma-${f.cve}" class="form-select form-select-sm" style="max-width:280px;">
                        ${opciones}
                    </select>
                </div>`;
        }).join('');

        return `
            <div style="text-align:left; border:1px solid #e5e7eb; border-radius:8px; padding:.75rem 1rem; margin-bottom:.75rem;">
                <strong style="font-size:.9rem;">🏦 Cuenta de depósito por forma de pago</strong>
                <div style="font-size:.78rem; color:#6b7280; margin:.25rem 0 .5rem;">
                    Cada comprobante registra su cobro en la cuenta de su forma de pago.
                    Vienen preseleccionadas de la configuración; cámbialas si hoy toca otra.
                </div>
                ${filas}
            </div>`;
    }

    // Explica, venta por venta, a qué comprobante va y por qué. Es la parte que
    // faltaba: antes el corte mandaba todo a la global sin decir qué llevaba dentro.
    function generarResumenDestinos(docsGlobal, docsIndividuales, docsCredito) {
        const money = n => `$${(parseFloat(n) || 0).toLocaleString('es-MX', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}`;
        const sumar = ds => ds.reduce((s, d) => s + (parseFloat(d.imp) || 0), 0);

        const listar = ds => ds.map(d => `
            <div style="display:flex; justify-content:space-between; gap:10px; padding:.35rem 0; border-bottom:1px solid #f3f4f6;">
                <div style="min-width:0;">
                    <div style="font-weight:600; font-size:.85rem;">${d.folio}</div>
                    <div style="font-size:.75rem; color:#6b7280;">${d.motivo || ''}</div>
                </div>
                <div style="white-space:nowrap; font-size:.85rem;">${money(d.imp)}</div>
            </div>`).join('');

        const bloque = (titulo, color, fondo, ds, nota) => !ds.length ? '' : `
            <div style="border-left:4px solid ${color}; background:${fondo}; border-radius:8px; padding:.75rem 1rem; margin-bottom:.75rem;">
                <div style="display:flex; justify-content:space-between; align-items:center; gap:10px;">
                    <strong style="color:${color};">${titulo}</strong>
                    <span style="font-weight:700;">${money(sumar(ds))}</span>
                </div>
                <div style="font-size:.78rem; color:#6b7280; margin:.25rem 0 .5rem;">${nota}</div>
                <div style="max-height:22vh; overflow-y:auto;">${listar(ds)}</div>
            </div>`;

        return `
            <div style="text-align:left;">
                ${bloque(
                    `🧾 Factura global · ${docsGlobal.length} venta(s)`,
                    '#059669', '#ecfdf5', docsGlobal,
                    'Un solo CFDI al público en general que agrupa todas las ventas cobradas en efectivo.')}
                ${bloque(
                    `💳 Facturas individuales · ${docsIndividuales.length}`,
                    '#b45309', '#fffbeb', docsIndividuales,
                    'Un CFDI por venta, también a público en general, cada uno declarando su propia forma de pago. Un comprobante sólo admite una FormaPago, y la global declara todo como efectivo.')}
                ${bloque(
                    `📄 Ventas a crédito · ${docsCredito.length}`,
                    '#7c3aed', '#f5f3ff', docsCredito,
                    'No se tocan aquí: ya se facturaron nominativas al registrar la venta y su importe está en la cartera del cliente.')}
            </div>`;
    }

    // ⭐ FUNCIÓN PARA GENERAR EL HTML DEL RESUMEN
    function generarResumenDocumentos(documentosSinFacturar, documentosYaFacturados) {

        // Se separan las ventas del dia de las que quedaron sin facturar en dias
        // anteriores. Antes el corte solo mostraba las de hoy y las rezagadas eran
        // invisibles; ahora se incluyen, pero mezclarlas en una sola lista confundia
        // sobre que se esta timbrando.
        const esRezagado = d => (parseInt(d.dias_rezago) || 0) > 0;
        const docsHoy       = documentosSinFacturar.filter(d => !esRezagado(d));
        const docsRezagados = documentosSinFacturar.filter(esRezagado);

        const sumar = ds => ds.reduce((s, d) => s + (parseFloat(d.imp) || 0), 0);
        const totalHoy       = sumar(docsHoy);
        const totalRezagados = sumar(docsRezagados);
        const totalGeneral   = totalHoy + totalRezagados;

        const maxVisible   = 10;
        const mostrarScroll = documentosSinFacturar.length > maxVisible;

        // Construye una tabla para un grupo de documentos.
        function construirTabla(docs, opciones) {
            const { resaltar, mostrarDias, offset } = opciones;
            const conScroll = docs.length > maxVisible;

            let filas = '';
            docs.forEach((doc, i) => {
                const folio   = doc.folio || doc.numero_documento || 'N/A';
                const cliente = doc.cliente || doc.n_cli || 'N/A';
                const total   = doc.imp ? `$${parseFloat(doc.imp).toFixed(2)}` : 'N/A';
                const dias    = parseInt(doc.dias_rezago) || 0;
                const fecha   = doc.fch ? new Date(doc.fch).toLocaleDateString('es-MX') : '—';

                const celdaFecha = mostrarDias
                    ? `<span style="color:#b45309;font-weight:600;">${fecha}
                           <span style="font-size:0.75rem;font-weight:400;">(hace ${dias} d)</span>
                       </span>`
                    : `<span style="color:#6b7280;">${fecha}</span>`;

                filas += `
                    <tr style="border-bottom:1px solid #e5e7eb;${resaltar ? 'background:#fffbeb;' : ''}">
                        <td style="padding:0.5rem;">${offset + i + 1}</td>
                        <td style="padding:0.5rem;font-weight:600;color:#7c3aed;">${folio}</td>
                        <td style="padding:0.5rem;color:#6b7280;">${cliente}</td>
                        <td style="padding:0.5rem;">${celdaFecha}</td>
                        <td style="padding:0.5rem;text-align:right;color:#059669;">${total}</td>
                    </tr>`;
            });

            return `
            <div style="max-height:${conScroll ? '260px' : 'auto'};overflow-y:${conScroll ? 'auto' : 'visible'};margin:0.5rem 0 1rem 0;">
                <table style="width:100%;border-collapse:collapse;font-size:0.9rem;">
                    <thead style="position:sticky;top:0;background:#f3f4f6;z-index:1;">
                        <tr>
                            <th style="padding:0.5rem;text-align:left;border-bottom:2px solid #d1d5db;">#</th>
                            <th style="padding:0.5rem;text-align:left;border-bottom:2px solid #d1d5db;">Folio</th>
                            <th style="padding:0.5rem;text-align:left;border-bottom:2px solid #d1d5db;">Cliente</th>
                            <th style="padding:0.5rem;text-align:left;border-bottom:2px solid #d1d5db;">Fecha</th>
                            <th style="padding:0.5rem;text-align:right;border-bottom:2px solid #d1d5db;">Total</th>
                        </tr>
                    </thead>
                    <tbody>${filas}</tbody>
                </table>
            </div>`;
        }

        const seccionHoy = docsHoy.length === 0 ? '' : `
            <h4 style="margin:1.25rem 0 0.25rem 0;color:#374151;font-size:1rem;display:flex;justify-content:space-between;align-items:center;">
                <span>📄 Ventas de hoy <span style="color:#6b7280;font-weight:400;">(${docsHoy.length})</span></span>
                <span style="color:#059669;font-size:0.95rem;">$${totalHoy.toFixed(2)}</span>
            </h4>
            ${construirTabla(docsHoy, { resaltar: false, mostrarDias: false, offset: 0 })}`;

        const seccionRezagados = docsRezagados.length === 0 ? '' : `
            <h4 style="margin:1.25rem 0 0.25rem 0;color:#92400e;font-size:1rem;display:flex;justify-content:space-between;align-items:center;">
                <span>🕐 Anteriores sin facturar <span style="color:#b45309;font-weight:400;">(${docsRezagados.length})</span></span>
                <span style="color:#b45309;font-size:0.95rem;">$${totalRezagados.toFixed(2)}</span>
            </h4>
            <p style="margin:0 0 0.25rem 0;color:#92400e;font-size:0.85rem;background:#fffbeb;border-left:3px solid #b45309;padding:0.5rem 0.75rem;border-radius:3px;">
                Ventas de días anteriores que nunca se facturaron. Se incluirán en este corte
                y se timbrarán junto con las de hoy.
            </p>
            ${construirTabla(docsRezagados, { resaltar: true, mostrarDias: true, offset: docsHoy.length })}`;

        return `
        <div style="text-align:left;padding:0.5rem;">
            <div style="background:#f0fdf4;border-left:4px solid #059669;padding:1rem;margin-bottom:0.5rem;border-radius:4px;">
                <p style="margin:0;font-weight:600;color:#059669;">
                    <i class="fas fa-check-circle"></i>
                    ${documentosSinFacturar.length} documento(s) pendiente(s) de facturar
                    ${docsRezagados.length > 0
                        ? `<span style="font-weight:400;color:#92400e;">
                               — ${docsHoy.length} de hoy y ${docsRezagados.length} de días anteriores
                           </span>`
                        : ''}
                </p>
            </div>

            ${documentosYaFacturados > 0 ? `
            <div style="background:#fef3c7;border-left:4px solid #f59e0b;padding:1rem;margin-bottom:0.5rem;border-radius:4px;">
                <p style="margin:0;color:#92400e;">
                    <i class="fas fa-info-circle"></i>
                    ${documentosYaFacturados} documento(s) ya facturado(s) (se omitirán)
                </p>
            </div>
            ` : ''}

            ${seccionHoy}
            ${seccionRezagados}

            <div style="background:#eff6ff;padding:1rem;border-radius:4px;margin-top:1rem;">
                <p style="margin:0;display:flex;justify-content:space-between;font-weight:600;color:#1e40af;">
                    <span>Total General:</span>
                    <span style="font-size:1.2rem;">$${totalGeneral.toFixed(2)}</span>
                </p>
            </div>

            ${mostrarScroll ? `
            <p style="margin-top:1rem;color:#6b7280;font-size:0.85rem;text-align:center;">
                <i class="fas fa-arrows-alt-v"></i> Desplázate para ver todos los documentos
            </p>
            ` : ''}
        </div>
    `;
    }
