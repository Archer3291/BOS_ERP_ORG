            </div>

            ${codigoSAT ? `
            <!-- Código de Error SAT -->
            <div style="
                background: linear-gradient(135deg, #fef3c7 0%, #fde68a 100%);
                padding: 1.25rem;
                border-radius: 10px;
                margin-bottom: 1rem;
                border-left: 4px solid #f59e0b;
