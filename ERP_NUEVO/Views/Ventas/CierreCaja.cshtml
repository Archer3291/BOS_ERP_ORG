    // Actualizar totales por método de pago
    function updatePaymentMethodTotals() {
        // Inicializar totales dinámicamente
        const totales = {};
        METODOS_PAGO.forEach(metodo => {
            totales[metodo.normalizado] = { total: 0, count: 0, tickets: [] };
        });

        // Procesar tickets
        tickets.forEach(ticket => {
            ticket.formasPago.forEach(formaPago => {
                const metodo = formaPago.metodo;
                const monto = formaPago.monto;

                if (totales[metodo]) {
                    totales[metodo].total += monto;

                    if (monto > 0) {
                        const ticketYaAgregado = totales[metodo].tickets.some(
                            t => t.id_encabezado === ticket.id_encabezado
                        );

                        if (!ticketYaAgregado) {
                            const ticketPorMetodo = {
                                ...ticket,
                                montoParcial: monto,
                                esTicketMixto: ticket.formasPago.length > 1
                            };
                            totales[metodo].tickets.push(ticketPorMetodo);
                            totales[metodo].count++;
                        }
                    }
                }
            });
        });

        // Actualizar UI dinámicamente
        METODOS_PAGO.forEach(metodo => {
            const total = totales[metodo.normalizado].total;
            const count = totales[metodo.normalizado].count;

            // Actualizar montos y contadores
            const salesElement = document.getElementById(`${metodo.id}SalesAuto`);
            const countElement = document.getElementById(`${metodo.id}TicketCount`);
            const tabCountElement = document.getElementById(`${metodo.id}TabCount`);

            if (salesElement) salesElement.textContent = total.toFixed(2);
            if (countElement) countElement.textContent = count;
            if (tabCountElement) tabCountElement.textContent = count;

            // Actualizar estilo de la card
            const card = document.querySelector(`[data-metodo-id="${metodo.id}"]`);
            if (card) {
                if (count === 0) {
                    card.style.opacity = '0.6';
                    card.style.cursor = 'not-allowed';
                } else {
                    card.style.opacity = '1';
                    card.style.cursor = 'pointer';
                }
            }
        });

        // Lo que no cayó en ninguna forma de pago conocida (una nota de crédito
        // aplicada como pago, por ejemplo) ya no se suma al efectivo, pero tampoco
        // puede desaparecer del corte sin decirlo. El aviso sólo aparece si hay algo.
        const noClasificado = tickets.reduce((suma, ticket) =>
            suma + ticket.formasPago
                .filter(fp => !totales[fp.metodo])
                .reduce((s, fp) => s + (fp.monto || 0), 0), 0);

        pintarAvisoNoClasificado(noClasificado);

        document.getElementById('ticketCount').textContent = tickets.length;

        // Actualizar tablas de tickets
        updateTicketTables(totales);
    }

