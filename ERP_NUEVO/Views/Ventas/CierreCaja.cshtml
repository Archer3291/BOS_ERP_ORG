</div>

<script>
    // ═══════════════════════════════════════════════════════════════
    // VENTAS AUTOFACTURADAS PENDIENTES DE CONTABILIZAR
    // ═══════════════════════════════════════════════════════════════
    // El portal de autofacturación timbra el CFDI y marca la venta, pero no levanta
    // pedido/remisión/factura ni la póliza: corre sin sesión y sin contexto de caja.
    // Aquí se completan. NO se vuelve a timbrar nada.

    // ════════════════════════════════════════════════════════════════════════
    //  Cuentas de banco que ofrece el cierre
    // ════════════════════════════════════════════════════════════════════════
    // Antes se listaba el catálogo contable completo y el usuario elegía cualquiera.
    // Ahora se ofrecen las cuentas configuradas para las formas de pago del punto de
    // venta (Punto de Venta Administrativo > Formas de Pago y Bancos). Si nadie ha
    // configurado nada todavía, se cae al catálogo completo para no frenar el cierre.
    const CuentasBancoCierre = {
        cargado: false,
        formas: [],
        todas: [],

        async cargar() {
            if (this.cargado) return;

            const data = await GetData({ path: '/PuntoVentaAdministracion/CuentasBancoFormasPago' });
            if (data && data.success) {
                this.formas = data.formas || [];
                this.todas = data.todas || [];
                this.cargado = true;
            }
        },

        // Unión, sin repetir, de lo configurado para todas las formas de pago: la
        // global cobra en varias a la vez, así que ninguna manda por sí sola.
        configuradas() {
            const vistas = new Set();
            const lista = [];

            this.formas.forEach(f => (f.cuentas || []).forEach(c => {
                if (c.cuenta_contable && !vistas.has(c.cuenta_contable)) {
                    vistas.add(c.cuenta_contable);
                    lista.push(c);
                }
            }));

            return lista;
        },

        // En un cierre casi todo es efectivo, así que su cuenta predeterminada es la
        // que se preselecciona.
        preferida() {
            const efectivo = this.formas.find(f => f.cve_sat === '01');
            const cuentas = (efectivo && efectivo.cuentas) || [];
            const pred = cuentas.find(c => c.predeterminada) || cuentas[0];
            return pred ? (pred.cuenta_contable || '') : '';
        }
    };

    async function llenarSelectCuentasCierre(sel) {
        if (!sel) return;

        try {
            await CuentasBancoCierre.cargar();

            const configuradas = CuentasBancoCierre.configuradas();

            // En el respaldo se prefieren las cuentas que sí tienen su cuenta contable
            // dada de alta: sin ella la póliza del cobro falla. Si el filtro dejara la
            // lista vacía se muestran todas, para no impedir el cierre.
            const todas = (CuentasBancoCierre.todas || []).filter(c => c.cuenta_contable);
            const contabilizables = todas.filter(c => c.contabilizable);
            const respaldo = contabilizables.length ? contabilizables : todas;

            const cuentas = configuradas.length ? configuradas : respaldo;

            if (!cuentas.length) {
                sel.innerHTML = `<option value="">No hay cuentas</option>`;
                return;
            }

            sel.innerHTML = `<option value="">-- Selecciona --</option>`
                + cuentas.map(c => `<option value="${c.cuenta_contable}">${c.cuenta_contable} - ${c.nombre}</option>`).join('');

            const preferida = CuentasBancoCierre.preferida();
            if (preferida && cuentas.some(c => c.cuenta_contable === preferida)) {
                sel.value = preferida;
            }
        } catch {
            sel.innerHTML = `<option value="">Error al cargar</option>`;
        }
    }

    // Selector de cuenta bancaria, el mismo que usa el cierre antes de facturar.
    async function pedirCuentaBancaria() {
        const { value } = await Swal.fire({
            title: 'Selecciona Cuenta Bancaria',
            html: `
            <div class="mb-2 text-start">
                <label class="form-label">Cuenta Bancaria</label>
                <select id="swal-cuenta-autofact" class="swal2-select w-100">
                    <option value="">Cargando cuentas...</option>
                </select>
            </div>`,
            showCancelButton: true,
            confirmButtonText: 'Continuar',
            cancelButtonText: 'Cancelar',
            focusConfirm: false,
            didOpen: async () => {
                await llenarSelectCuentasCierre(document.getElementById('swal-cuenta-autofact'));
            },
            preConfirm: () => {
                const c = document.getElementById('swal-cuenta-autofact').value;
                if (!c) { Swal.showValidationMessage('Selecciona una cuenta bancaria'); return false; }
                return c;
            }
        });

        return value;
    }

    async function cargarBadgeAutofacturadas() {
        try {
            const r = await fetch('/PuntoDeVenta/ObtenerAutofacturadasPendientes');
            const data = await r.json();
            if (!data.success) return;

            const badge = document.getElementById('badgeAutofacturadas');
            if (badge && data.resumen.total > 0) {
                badge.textContent = data.resumen.total;
                badge.style.display = 'inline-block';
            }
        } catch { /* el badge es informativo; su fallo no debe estorbar el cierre */ }
    }

    async function abrirAutofacturadasPendientes() {
        Swal.fire({
            title: 'Consultando ventas autofacturadas',
            didOpen: () => Swal.showLoading(),
            allowOutsideClick: false,
            showConfirmButton: false
        });

        try {
            const r = await fetch('/PuntoDeVenta/ObtenerAutofacturadasPendientes');
            const data = await r.json();

            if (data.sessionExpired) {
                Swal.fire({ icon: 'warning', title: 'Sesión expirada', text: data.message })
                    .then(() => window.location.reload());
                return;
            }
            if (!data.success) {
                Swal.fire({ icon: 'error', title: 'No se pudo consultar', text: data.message });
                return;
            }

            const ventas = data.ventas || [];

            if (ventas.length === 0) {
                Swal.fire({
                    icon: 'success',
                    title: 'Todo contabilizado',
                    text: 'No hay ventas autofacturadas pendientes de respaldo contable.'
                });
                return;
            }

            const filas = ventas.map(v => `
                <tr>
                    <td style="padding:.45rem .4rem; border-bottom:1px solid #e5e7eb; text-align:left;">
                        <label style="display:flex; gap:.5rem; align-items:flex-start; cursor:pointer; margin:0;">
                            <input type="checkbox" class="chk-autofact" value="${v.ventaId}" checked
                                   style="margin-top:.25rem;">
                            <span>
                                <span style="font-weight:600;">${v.folio}</span><br>
                                <span style="font-size:.78rem; color:#6b7280;">
                                    ${v.cliente || 'Sin cliente'} · ${v.fecha}<br>
                                    ${v.rfcCliente ? 'RFC ' + v.rfcCliente + ' · ' : ''}
                                    <span style="font-family:monospace; font-size:.72rem;">${v.uuid || ''}</span>
                                </span>
                                ${!v.tieneCfdiRegistrado ? `
                                    <span style="display:inline-block; margin-top:.2rem; background:#fee2e2;
