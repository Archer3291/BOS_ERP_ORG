    function abrirDetallesMovimiento(movimientoId) {
        const movimiento = MOVIMIENTOS_ADICIONALES.find(m => m.id === movimientoId);

        if (!movimiento) {
            toastMixin.fire({
                icon: 'error',
                title: 'Movimiento no encontrado'
            });
            return;
        }

        const monto = parseFloat(document.getElementById(`${movimientoId}Amount`)?.textContent || 0);

        if (monto === 0) {
            toastMixin.fire({
                icon: 'info',
                title: `No hay ${movimiento.nombre.toLowerCase()} registrados hoy`
            });
            return;
        }

        // Llamar a la función específica según el tipo
        switch (movimientoId) {
            case 'withdrawals':
                mostrarDetallesRetiros(monto);
                break;
            case 'expenses':
                mostrarDetallesGastos(monto);
                break;
            case 'returns':
                mostrarDetallesDevoluciones(monto);
                break;
            default:
                toastMixin.fire({
                    icon: 'warning',
                    title: 'Funcionalidad en desarrollo'
                });
        }
    }

