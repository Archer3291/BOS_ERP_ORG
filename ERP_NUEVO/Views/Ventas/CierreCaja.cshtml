@{
    ViewBag.Title = "Cierre de Caja";
    ViewBag.PageTitle = "Cierre de Caja";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@section styles {
    <link href="~/content/compras-nacionales.css" rel="stylesheet" />
    <style>
        .header-section {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-bottom: 30px;
        }

        .stat-card {
            background: var(--bg-light);
            border-radius: 10px;
            padding: 20px;
            box-shadow: var(--shadow);
            transition: transform 0.3s ease;
            margin-bottom: 20px;
            border-left: 4px solid var(--accent-blue);
        }

            .stat-card:hover {
                transform: translateY(-5px);
                box-shadow: var(--shadow-lg);
            }

            .stat-card.success {
                border-left-color: var(--success-color);
            }

            .stat-card.danger {
                border-left-color: var(--danger-color);
            }

            .stat-card.warning {
                border-left-color: var(--warning-color);
            }

        .stat-value {
            font-size: 2rem;
            font-weight: bold;
            color: var(--primary-blue);
        }

        .stat-label {
            color: var(--text-light);
            font-size: 0.9rem;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .table-container {
            background: var(--bg-light);
            border-radius: 12px;
            padding: 25px;
            margin-bottom: 20px;
            box-shadow: var(--shadow);
            border: 1px solid #e0e0e0;
        }

        .float-end {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .text-muted {
            color: #6c757d;
            font-size: 0.9rem;
        }

        .input-group-custom input {
            width: 100%;
            border: 1px solid var(--border-color, #ccc); /* Borde adaptable */
            background: var(--bg-gray);
            padding: 0.75rem;
            border-radius: 8px;
            font-size: 1.125rem;
            font-weight: 600;
            color: var(--text-dark);
            transition: all 0.2s;
        }

            .input-group-custom input:focus {
                outline: none;
                background: var(--bg-light);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

        .subtotal {
            font-weight: 600;
            color: var(--primary);
            font-size: 1rem;
            min-width: 100px;
        }

        tbody tr td:first-child {
            font-weight: 500;
            font-size: 1rem;
        }

        /* Estilo para billetes y monedas */
        tbody tr:not(.table-active) td:first-child::before {
            content: '💵';
            margin-right: 8px;
            font-size: 1.1rem;
        }

        /* Ajuste para monedas */
        tbody tr:nth-child(n+9):not(.table-active) td:first-child::before {
            content: '🪙';
        }

        /* Responsive */
        @@media (max-width: 768px) {
            .table-container {
                padding: 15px;
            }

            .section-title {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

            .float-end {
                width: 100%;
                justify-content: space-between;
            }

            .table thead th,
            .table tbody td {
                padding: 10px 12px;
                font-size: 0.85rem;
            }
        }

        .btn-custom {
            padding: 12px 30px;
            border-radius: 25px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1px;
            transition: all 0.3s ease;
        }

        .btn-primary-custom {
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--primary-blue) 100%);
            border: none;
            color: white;
        }

            .btn-primary-custom:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
            }

        .btn-success-custom {
            background: linear-gradient(135deg, var(--success-color) 0%, #047857 100%);
            border: none;
            color: white;
        }

            .btn-success-custom:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(5, 150, 105, 0.4);
            }

        .btn-danger-custom {
            background: linear-gradient(135deg, var(--danger-color) 0%, #b91c1c 100%);
            border: none;
            color: white;
        }

            .btn-danger-custom:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(220, 38, 38, 0.4);
            }

        .section-title {
            color: var(--primary-blue);
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 10px;
            border-bottom: 3px solid var(--accent-blue);
        }

        .total-section {
            background: linear-gradient(135deg, var(--warning-color) 0%, #d58d70 100%);
            color: white;
            padding: 25px;
            border-radius: 10px;
            margin-top: 30px;
        }

        .difference-positive {
            color: var(--success-color);
            font-weight: bold;
        }

        .difference-negative {
            color: var(--danger-color);
            font-weight: bold;
        }

        .notes-section {
            background: var(--very-light-blue);
            border-left: 4px solid var(--warning-color);
            padding: 20px;
            border-radius: 8px;
            margin-top: 20px;
        }

            .notes-section textarea {
                background: var(--bg-light);
                border: 1px solid var(--border-light);
                color: var(--text-dark);
            }


        .modal-xl {
            max-width: 1200px;
        }

        .modal-content {
            background: var(--bg-light);
            color: var(--text-dark);
        }

        .modal-header {
            border-bottom: 1px solid var(--border-light);
        }

        .nav-tabs {
            border-bottom: 2px solid var(--border-light);
        }

            .nav-tabs .nav-link {
                color: var(--text-dark);
                font-weight: 500;
                border: none;
                border-bottom: 3px solid transparent;
                padding: 12px 20px;
                transition: all 0.3s ease;
            }

                .nav-tabs .nav-link:hover {
                    border-bottom-color: var(--accent-blue);
                    background-color: var(--very-light-blue);
                }

                .nav-tabs .nav-link.active {
                    background-color: transparent;
                    color: var(--accent-blue);
                    border-bottom-color: var(--accent-blue);
                    font-weight: 600;
                }

        .ticket-row {
            cursor: pointer;
            transition: background-color 0.2s ease;
        }

            .ticket-row:hover {
                background-color: var(--very-light-blue);
            }

        .badge {
            padding: 6px 12px;
            font-weight: 500;
        }

        .btn-info {
            background: linear-gradient(135deg, var(--accent-blue) 0%, var(--primary-blue-dark) 100%);
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 25px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-info:hover {
                transform: scale(1.05);
                box-shadow: 0 5px 15px rgba(59, 130, 246, 0.4);
                color: white;
            }

        .form-control {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            color: var(--text-dark);
        }

            .form-control:focus {
                background: var(--bg-light);
                border-color: var(--accent-blue);
                color: var(--text-dark);
            }

        @@media print {
            body {
                background: white;
            }

            .no-print {
                display: none !important;
            }

            .main-container {
                box-shadow: none;
                padding: 15px;
            }

            .stat-card,
            .payment-method-card,
            .table-container {
                box-shadow: none;
                page-break-inside: avoid;
            }

            .modal {
                display: none !important;
            }
        }

        @@media (max-width: 768px) {
            .stat-value {
                font-size: 1.5rem;
            }

            .payment-amount {
                font-size: 1.4rem;
            }

            .btn-custom {
                padding: 10px 20px;
                font-size: 0.9rem;
            }

            .header-section h1 {
                font-size: 1.5rem;
            }

            .section-title {
                font-size: 1.2rem;
            }


            .table {
                font-size: 0.9rem;
            }
        }

        .payment-method-card {
            background: var(--very-light-blue);
            padding: 20px;
            border-radius: 10px;
            margin-bottom: 15px;
            transition: all 0.3s ease;
            border-left: 4px solid var(--accent-blue);
            box-shadow: var(--shadow);
            cursor: pointer; /* NUEVO */
            position: relative; /* NUEVO */
        }

            .payment-method-card:hover {
                transform: translateX(5px) scale(1.02); /* MODIFICADO */
                box-shadow: var(--shadow-lg);
                background: var(--bg-light); /* NUEVO */
            }

            /* NUEVO - Indicador visual de que es clickeable */
            .payment-method-card::after {
                content: '👁️ Click para ver detalles';
                position: absolute;
                bottom: 8px;
                right: 15px;
                font-size: 0.75rem;
                color: var(--text-light);
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .payment-method-card:hover::after {
                opacity: 1;
            }

        /* Incrementar z-index para modales apilados */
        .modal-backdrop.show:nth-of-type(2) {
            z-index: 1051 !important;
            opacity: 0.7 !important;
        }

        .modal.show:nth-of-type(2) {
            z-index: 1052 !important;
        }

        /* Reducir opacidad del primer modal cuando se abre el segundo */
        .modal.show.modal-dimmed {
            opacity: 0.4 !important;
            pointer-events: none !important;
            transition: opacity 0.3s ease;
        }

        /* Estilo para backdrop personalizado más oscuro */
        .modal-backdrop-dark {
            background-color: rgba(0, 0, 0, 0.85) !important;
        }

        /* Animación suave para modales */
        .modal.fade .modal-dialog {
            transition: transform 0.3s ease-out, opacity 0.3s ease-out;
        }
    </style>
}

