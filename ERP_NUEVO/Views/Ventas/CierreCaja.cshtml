<!-- Botones de Acción -->
<div class="row mt-4 no-print">
    @*<div class="col-md-4">
        <button class="btn btn-primary-custom btn-custom w-100" onclick="calcularTotales()">
            <i class="fas fa-calculator"></i> Calcular Totales
        </button>
    </div>*@
    <div class="col-md-4">
        <button class="btn btn-success-custom btn-custom w-100" onclick="facturarTodosDocumentos()">
            <i class="fas fa-print"></i> Imprimir Cierre
        </button>
    </div>
    @* Las ventas que el cliente facturó por el portal ya tienen CFDI, pero les falta la
       cadena documental y la póliza: eso se levanta aquí, al cerrar la caja. *@
    <div class="col-md-4">
        <button class="btn btn-primary-custom btn-custom w-100" onclick="abrirAutofacturadasPendientes()">
            <i class="fas fa-file-invoice-dollar"></i> Contabilizar autofacturadas
            <span id="badgeAutofacturadas" class="badge bg-danger ms-1" style="display:none;"></span>
        </button>
