    // Nueva función para procesar facturas
    function procesarFacturas(facturas) {
        tickets = [];
        ventasCredito = [];

        // Una venta a crédito no entró a la caja: no puede aparecer en el desglose por
        // método de pago. Antes caía aquí sin formas de pago (no las tiene) y el
        // respaldo la etiquetaba como EFECTIVO, inflando el efectivo esperado del corte.
        const esVentaCredito = f => (f.tipo_proceso || '').toLowerCase().includes('_credito');

        facturas.filter(esVentaCredito).forEach(f => {
            let horaCredito = '';
            if (f.fch1) {
                const fecha = new Date(f.fch1);
                horaCredito = `${String(fecha.getHours()).padStart(2, '0')}:${String(fecha.getMinutes()).padStart(2, '0')}`;
            }

            ventasCredito.push({
                folio: f.folio,
                hora: horaCredito,
                cliente: f.n_cli || 'Cliente',
                total: parseFloat(f.imp) || 0
            });
        });

        facturas.filter(f => !esVentaCredito(f)).forEach((factura, index) => {
            // Parsear las formas de pago desde JSON
            let formasPago = [];

            if (factura.formas_pago) {
                try {
                    // Si viene como string JSON, parsearlo
                    const formasPagoData = typeof factura.formas_pago === 'string'
                        ? JSON.parse(factura.formas_pago)
                        : factura.formas_pago;

                    formasPago = formasPagoData.map(fp => ({
                        metodo: normalizarMetodoPago(fp.metodo, fp.metodo_nombre),
                        monto: parseFloat(fp.monto) || 0
                    }));
                } catch (e) {
                    console.error('Error al parsear formas de pago:', e);
                    formasPago = [];
                }
            }

            // Sin desglose de cobros se usa la forma de pago del documento. NO se usa
            // `mdp` —que es PUE/PPD, el MÉTODO de pago— porque no es una forma de pago y
            // normalizarMetodoPago lo terminaba etiquetando como efectivo.
            if (formasPago.length === 0) {
                formasPago = [{
                    metodo: normalizarMetodoPago(factura.f_pago_cve_sat, factura.f_pago_cve_sat),
                    monto: parseFloat(factura.imp) || 0
                }];
            }

            // Extraer hora de la fecha
            let hora = '00:00';
            if (factura.fch1) {
                const fecha = new Date(factura.fch1);
                hora = `${String(fecha.getHours()).padStart(2, '0')}:${String(fecha.getMinutes()).padStart(2, '0')}`;
            }

            // Crear el ticket
            const ticket = {
                numero: String(index + 1).padStart(4, '0'),
                folio: factura.folio || `TICKET-${index + 1}`,
                id_encabezado: factura.id_encabezado,
                hora: hora,
                fecha: factura.fch1,
                productos: factura.productos_lista || 'Sin productos',
                productosDescripcion: factura.productos_descripciones || '',
                total: parseFloat(factura.imp) || 0,
                cliente: factura.n_cli || 'Público General',
                formasPago: formasPago
            };

            tickets.push(ticket);
        });

        // Ordenar por hora
        tickets.sort((a, b) => a.hora.localeCompare(b.hora));

        // Actualizar la interfaz. La tarjeta de crédito se pinta antes de los totales
        // para que quede arriba del aviso de formas de pago no clasificadas.
        pintarTarjetaCredito();
        updatePaymentMethodTotals();
        calcularTotales();
    }

    // Función para normalizar nombres de métodos de pago
    // Mapeo oficial de claves SAT. Ojo con el par tarjetas: 04 es CRÉDITO y 28 es
    // DÉBITO — estaba al revés, y el punto de venta manda justamente esas dos claves.
    const MAPA_CLAVES_SAT = {
        '01': 'Efectivo',
        '02': 'Cheque',
        '03': 'Transferencia',
        '04': 'Crédito',
        '28': 'Débito',
        '99': 'Otro'          // nota de crédito / por definir: no es dinero en caja
    };

    // La clave SAT manda sobre el nombre. Buscar sólo por texto confundía
    // "Nota de Crédito" con "Tarjeta de Crédito" (ambos contienen "crédito") y metía
    // notas de crédito en el conteo de tarjetas.
    function normalizarMetodoPago(clave, nombre) {
        const claveLimpia = (clave || '').toString().trim();
        if (MAPA_CLAVES_SAT[claveLimpia]) return MAPA_CLAVES_SAT[claveLimpia];

        const texto = (nombre || clave || '').toString().toLowerCase();
        if (!texto) return 'Otro';

        // Se revisa antes que las tarjetas, por la misma razón de arriba.
        if (texto.includes('nota de')) return 'Otro';

        for (const metodoPago of METODOS_PAGO) {
            const nombreLower = metodoPago.normalizado.toLowerCase();
            if (texto.includes(nombreLower)) return metodoPago.normalizado;
        }

        // Antes cualquier cosa desconocida caía en Efectivo, que es el peor lugar
        // posible: cuadrar la caja dependía de que nada se colara aquí.
        return 'Otro';
    }



