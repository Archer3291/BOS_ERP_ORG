    async function obtenerRetirosDelDia() {
        try {
            const response = await GetData({
                path: '/PuntoVentaAdministracion/ObtenerDocumentos'
            });

            if (
                response?.success &&
                Array.isArray(response.data?.movements)
            ) {
                return response.data.movements.map(retiro => ({
                    id: retiro.nombre,
                    hora: retiro.fch ?? '00:00',
                    concepto: retiro.concept ?? 'Sin especificar',
                    usuario: retiro.user ?? 'Sistema',
                    monto: Number(retiro.amount) || 0,
                    notas: retiro.notes ?? ''
                }));
            }

            console.warn('No se encontraron retiros válidos:', response.data);
            return [];

        } catch (error) {
            console.error('Error al obtener retiros:', error);
            return [];
        }
    }

