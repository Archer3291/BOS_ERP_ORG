    <script>
        function limpiarModal() {
            document.body.classList.remove('modal-open');
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.style.overflow = 'auto';
            setTimeout(() => {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            }, 300);
        }

        let table;           // Instancia global de DataTable
        const pageSize = 50; // Tamaño de página para la búsqueda

        $(document).ready(function () {
            // 1) Inicializa DataTable y guárdala en la variable
            const currentTheme = localStorage.getItem('theme') || 'light';
            table = $('#clientesTable').DataTable({
                responsive: true,
                select: true,
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'copyHtml5',
                                text: '<i class="fa-solid fa-copy"></i>',
                                titleAttr: 'Copiar'
                            },
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel"></i>',
                                titleAttr: 'Exportar a Excel'
                            },
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf"></i>',
                                titleAttr: 'Exportar a PDF'
                            },
                            'colvis',
                            {
                                text: '<i class="fa-duotone fa-solid fa-trash fa-beat"></i>',
                                titleAttr: 'Eliminar fila(s) seleccionada(s)',
                                className: 'btn btn-outline-danger',
                                action: function (e, dt, node, config) {
                                    var filas = dt.rows({ selected: true });
                                    if (!filas.count()) {
                                        toastr.warning('Selecciona al menos una fila para eliminar.');
                                        return;
                                    }

                                    Swal.fire({
                                        title: `¿Eliminar ${filas.count()} fila(s)?`,
                                        icon: 'warning',
                                        buttonsStyling: true,
                                        customClass: {
                                            confirmButton: "btn btn-outline-danger",
                                            cancelButton: "btn btn-outline-primary"
                                        },
                                        showCancelButton: true,
                                        confirmButtonText: '<i class="fa-duotone fa-solid fa-thumbs-up fa-beat"></i> ¡Sí, eliminar!',
                                        cancelButtonText: '<i class="fa-duotone fa-solid fa-xmark fa-beat"></i> Cancelar'
                                    }).then((result) => {
                                        if (result.isConfirmed) {
                                            filas.remove().draw(false);
                                            toastr.success(`${filas.count()} fila(s) eliminada(s).`);
                                            actualizarTotal();
                                        }
                                    });
                                }

                            }
                        ],
                        pageLength: {
                            menu: [5, 10, 25, 50]
                        }
                    }
                },
                lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
                pageLength: 10,
                language: {
                    select: { rows: '%d fila(s) seleccionada(s)' },
                    buttons: {
                        copyTitle: 'Copiado al portapapeles',
                        copySuccess: { _: '%d filas copiadas', 1: '1 fila copiada' }
                    }
                },
                columnDefs: [{ className: 'dt-center', targets: '_all' },
                { responsivePriority: 1, targets: 7 }
                ]
            });

        });

        function actualizarTotal() {
            let subtotal = 0;
            let totalIva = 0;
            let subtable1 = 0;

            const rows = table.rows().nodes().toArray(); // Obtener todas las filas como array normal

            rows.forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad')?.value || 0);
                const descuento = parseFloat(tr.querySelector('.descuento')?.value || 0);
                const precio = parseFloat(tr.querySelector('.precio')?.value || 0);
                const iva = parseFloat(tr.dataset.iva || 0);

                const importe = cantidad * precio * (1 - descuento / 100);
                const ivaImporte = importe * (iva / 100);

                subtotal += importe;
                totalIva += ivaImporte;
                subtable1 += cantidad * precio;

                const spanImporte = tr.querySelector('.importe');
                if (spanImporte) {
                    spanImporte.textContent = importe.toFixed(2);
                }
            });

            const totalConIva = subtotal + totalIva;

            document.getElementById('total-subtotal2').value = subtotal.toFixed(2);
            document.getElementById('iva').value = totalIva.toFixed(2);
            document.getElementById('importe').value = totalConIva.toFixed(2);
            document.getElementById('total-subtotal1').value = subtable1.toFixed(2);
        }

        //document.addEventListener('DOMContentLoaded', function () {
        //    fetch('/Operaciones/DatosSelect')
        //        .then(res => res.json())
        //        .then(data => {
        //            const select = document.getElementById('moneda');
        //            select.innerHTML = '';

        //            const monedas = data.monedas;

        //            monedas.forEach(item => {
        //                const option = document.createElement('option');
        //                option.value = item.c1;
        //                option.textContent = item.c2;
        //                select.appendChild(option);
        //            });
        //        })
        //        .catch(err => {
        //            console.error('Error al cargar monedas:', err);
        //        });
        //});

        fetch('/Operaciones/DatosSelect')
            .then(response => response.json())
            .then(data => {
                llenarSelect('moneda', data.monedas, 'c1', 'c2');
                llenarSelect('vendedor', data.vendedores, 'c2', 'c3');
                //llenarSelect('lineaProducto', data.lineas, 'c1', 'c2');
                //llenarSelect('naturalezaProducto', data.naturaleza, 'idnaturaleza', 'nombre');
                //llenarSelect('unidadProducto', data.udm, 'c1', 'c2');
            })
            .catch(error => {
                console.error('Error al obtener los datos: ', error);
            });

        function llenarSelect(selectId, datos, valueKey, textKey) {
            const select = document.getElementById(selectId);
            select.innerHTML = '<option value="">Selecciona una opcion</option>'; // limpia y agrega opción inicial

            datos.forEach(item => {
                const option = document.createElement('option');
                option.value = item[valueKey];
                option.textContent = item[textKey];
                select.appendChild(option);
            });
        }

    </script>

    <script>
        function obtenerDatosDeTabla() {
            const tabla = document.getElementById('clientesTable');
            const filas = tabla.querySelectorAll('tbody tr');
            const datos = [];

            filas.forEach(fila => {
                const celdas = fila.querySelectorAll('td');
                const filaData = {
                    articulo: celdas[0]?.textContent.trim(),
                    cantidad: celdas[1]?.querySelector('input')?.value.trim() || "",
                    existenciaGeneral: celdas[2]?.textContent.trim(),
                    existenciaMod: celdas[3]?.textContent.trim(),
                    unidad: celdas[4]?.textContent.trim(),
                    precioLista: celdas[5]?.querySelector('input')?.value.trim() || "",
                    descuento: celdas[6]?.querySelector('input')?.value.trim() || "",
                    importe: celdas[7]?.textContent.trim(),
                    descripcion: celdas[8]?.textContent.trim(),
                    minimo: celdas[9]?.textContent.trim(),
                    tipo: celdas[10]?.textContent.trim(),
                    locacion: celdas[11]?.textContent.trim(),
                    comentario: celdas[12]?.textContent.trim()
                };
                datos.push(filaData);
            });

            return datos;
        }

        document.getElementById('btnEnviar').addEventListener('click', function (event) {
            event.preventDefault();

            const tipoDocto = document.getElementById('tipo-docto-mov').value;
            const datosTabla = obtenerDatosDeTabla();
            const form = document.getElementById('formCotizacion');
            const formData = new FormData(form);

            formData.append('partidas', JSON.stringify(datosTabla));

            const url = `/Cotizacion/GuardarCotizacion?tipoDocto=${encodeURIComponent(tipoDocto)}`;

            fetch(url, {
                method: 'POST',
                body: formData
            })
                .then(response => response.json())
                .then(data => {
                    console.log(data);

                    if (data.ok) {
                        toastr.success('Cotización enviada correctamente');

                        // Esperar un poco antes de redireccionar o limpiar
                        setTimeout(() => {
                            // ✅ Limpiar formulario
                            form.reset();

                            // ✅ Redireccionar (opcional)
                            // window.location.reload();
                        }, 1500); // espera 1.5 segundos para que se vea el toastr
                    } else {
                        toastr.warning(data.message || 'Hubo un problema al enviar la cotización');
                    }
                })
                .catch(error => {
                    console.error('Error al enviar:', error);
                    toastr.error('Error de red al enviar la cotización');
                });
        });


    </script>


    <script>
        window.addEventListener("load", function () {
            const tipoSelect = document.getElementById("tipo-docto-mov");
            const btnBuscar = document.getElementById("btnBuscarFolio");

            function toggleBotonBuscar() {
                const tipo = tipoSelect.value;
                console.log("Seleccionado:", tipo);
                if (tipo === "modificacion" || tipo === "consulta") {
                    btnBuscar.classList.remove("d-none");
                } else {
                    btnBuscar.classList.add("d-none");
                }
            }

            toggleBotonBuscar();

            tipoSelect.addEventListener("change", toggleBotonBuscar);
        });
    </script>



    <script>

        // Buscar cotizaciones
        function buscarCotizaciones(filtro, page = 1) {
            fetch(`/Cotizacion/Buscar?nombre=${encodeURIComponent(filtro)}&page=${page}&pageSize=${pageSize}`)
                .then(res => res.json())
                .then(data => {
                    const lista = document.getElementById('listaResultadosCotizacion');
                    lista.innerHTML = '';

                    if (data.length === 0) {
                        lista.innerHTML = '<div class="p-3">No se encontraron cotizaciones.</div>';
                        return;
                    }

                    const tabla = document.createElement('table');
                    tabla.classList.add('table', 'table-hover', 'table-bordered');

                    tabla.innerHTML = `
                            <thead class="table-secondary">
                                <tr>
                                    <th>Genero</th>
                                    <th>Naturaleza</th>
                                    <th>Folio</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Importe</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        `;

                    const tbody = tabla.querySelector('tbody');

                    data.forEach(cotizacion => {
                        const fila = document.createElement('tr');
                        fila.style.cursor = 'pointer';
                        fila.innerHTML = `
                                <td>${cotizacion.gen}</td>
                                <td>${cotizacion.nat}</td>
                                <td>${cotizacion.fol_doc}</td>
                                <td>${cotizacion.cli_prov}</td>
                                <td>${formatearFecha(cotizacion.fch_cap)}</td>
                                <td>$ ${cotizacion.imp}</td>
                            `;

                        fila.addEventListener('click', () => {
                            cargarDetalleCotizacion(cotizacion.fol_doc, cotizacion.nat, cotizacion.gen); // ← aquí se llama a la nueva función con el folio
                            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalBuscarCotizacion'));
                            modal.hide();
                        });

                        //fila.addEventListener('click', () => {
                        //    // Lógica al seleccionar una cotización (por ejemplo, llenar campos del formulario)
                        //    document.getElementById('folio').value = cotizacion.fol_doc;
                        //    //document.getElementById('clienteCotizacion').value = cotizacion.cli_prov;
                        //    //document.getElementById('fechaCotizacion').value = cotizacion.fch_cap;

                        //    const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('modalBuscarCotizacion'));
                        //    modal.hide();
                        //});

                        tbody.appendChild(fila);
                    });

                    lista.appendChild(tabla);
                    actualizarPaginacionCotizacion(page, data.length);
                    lista.scrollTop = 0;
                })
                .catch(err => console.error('Error al buscar cotizaciones:', err));
        }
        function cargarDetalleCotizacion(folio, nat, gen) {
            fetch(`/Cotizacion/ObtenerDetalle?folio=${encodeURIComponent(folio)}&nat=${nat}&gen=${gen}`)
                .then(res => res.json())
                .then(data => {
                    if (!data) {
                        alert('No se pudo cargar la cotización.');
                        return;
                    }

                    // Llena los inputs con los datos recibidos (ajusta IDs según tu HTML)
                    document.getElementById('folio').value = data["cotizacionResult"][0].nat + "-" + data["cotizacionResult"][0].gen + "-" + data["cotizacionResult"][0].fol_doc;
                    document.getElementById('cliente').value = data["cotizacionResult"][0].cli_prov;
                    document.getElementById('rfc').value = data["cotizacionResult"][0].rfc;
                    document.getElementById('fecha').value = formatearFecha(data["cotizacionResult"][0].fch_cap);
                    document.getElementById('importe').value = data["cotizacionResult"][0].imp;

                    table.clear(); // Limpia tabla

                    data.partidasResult.forEach(p => {
                        const rowData = [
                            p.cve_prod ?? '',

                            `<input type="number" class="form-control cantidad" value="${p.cant_ud ?? 1}" min="1">`,

                            p.exis_prev_u ?? 'N/A',
                            p.exis_prev_peso ?? 'N/A',

                            p.ud ?? '',

                            `<input type="number" class="form-control precio" value="${parseFloat(p.pv_prod || 0).toFixed(2)}" min="0" readonly>`,

                            `<input type="number" class="form-control descuento" value="${parseFloat(p.dto1 || 0).toFixed(2)}" min="0" max="100">`,

                            `<span class="importe text-end">${parseFloat(p.imp_part || 0).toFixed(2)}</span>`,

                            p.descr_prod ?? '',

                            "N/A", // Mínimo
                            "N/A", // Tipo
                            "N/A", // Locación

                            p.refe ?? ''
                        ];
                        const rowNode = table.row.add(rowData).draw(false).node();

                        // Guardamos el IVA directamente en el <tr>
                        rowNode.dataset.iva = 16;
                        table.row.add(rowData);
                    });

                    table.draw(); // Renderiza
                    actualizarTotal();

                })
                .catch(err => console.error('Error al cargar detalle de la cotización:', err));
        }

        // Paginación
        function actualizarPaginacionCotizacion(page, currentCount) {
            const pagination = document.getElementById('paginationCotizacion');
            pagination.innerHTML = '';

            const anterior = document.createElement('button');
            anterior.classList.add('btn', 'btn-outline-primary');
            anterior.innerText = 'Anterior';
            anterior.disabled = page === 1;
            anterior.onclick = () => buscarCotizaciones(document.getElementById('inputBuscarCotizacion').value, page - 1);

            const siguiente = document.createElement('button');
            siguiente.classList.add('btn', 'btn-outline-primary');
            siguiente.innerText = 'Siguiente';
            siguiente.disabled = currentCount < pageSize;
            siguiente.onclick = () => buscarCotizaciones(document.getElementById('inputBuscarCotizacion').value, page + 1);

            pagination.appendChild(anterior);
            pagination.appendChild(siguiente);
        }

        // Eventos
        document.getElementById('modalBuscarCotizacion').addEventListener('shown.bs.modal', () => {
            buscarCotizaciones('');
        });

        document.getElementById('inputBuscarCotizacion').addEventListener('input', () => {
            buscarCotizaciones(document.getElementById('inputBuscarCotizacion').value);
        });

        document.getElementById('btnLimpiarResultadosCotizacion').addEventListener('click', () => {
            document.getElementById('inputBuscarCotizacion').value = '';
            document.getElementById('listaResultadosCotizacion').innerHTML = '';
            document.getElementById('inputBuscarCotizacion').focus();
        });

        function formatearFecha(jsonDate) {
            const timestamp = parseInt(jsonDate.replace(/\/Date\((\d+)\)\//, '$1'), 10);
            const date = new Date(timestamp);
            return date.toLocaleDateString('es-MX', {
                year: 'numeric',
                month: '2-digit',
                day: '2-digit'
            });
        }
    </script>




}

