@model BOS_ERP.Models.LoginViewModel
@{
    ViewBag.Title = "Cotización ";
    Layout = "~/Views/Shared/_Layout.cshtml";

}

<script>window.document.title = 'Cotización'</script>

@section styles {




}
<form id="formCotizacion" asp-action="" method="post">
    @Html.AntiForgeryToken()

    <div class="card">
        <div class="card-header text-bg-primary">
            <h2 class="animate__animated animate__rubberBand">Cotización</h2>
        </div>
        <div class="card-body">
            <ul class="nav nav-tabs nav-justified mb-3" id="formTabs" role="tablist">

                <li class="nav-item" role="presentation">
                    <a data-mdb-tab-init
                       class="nav-link active"
                       id="generales-tab"
                       href="#generales"
                       role="tab"
                       aria-controls="generales"
                       aria-selected="true"><i class="fa-duotone fa-solid fa-info-circle fa-beat me-1"></i> Datos</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a data-mdb-tab-init
                       class="nav-link"
                       id="detalle-tab"
                       href="#detalle"
                       role="tab"
                       aria-controls="detalle"
                       aria-selected="false"><i class="fa-duotone fa-solid fa-rectangle-list fa-beat me-1"></i> Detalle</a>
                </li>
                <li class="nav-item" role="presentation">
                    <a data-mdb-tab-init
                       class="nav-link"
                       id="articulos-tab"
                       href="#articulos"
                       role="tab"
                       aria-controls="articulos"
                       aria-selected="false"><i class="fa-duotone fa-solid fa-box-open fa-beat me-1"></i> Artículos</a>
                </li>

                <li class="nav-item" role="presentation">
                    <a data-mdb-tab-init
                       class="nav-link"
                       id="condiciones-tab"
                       href="#condiciones"
                       role="tab"
                       aria-controls="condiciones"
                       aria-selected="false"><i class="fa-duotone fa-solid fa-file-invoice-dollar fa-beat me-1"></i> Condiciones de Pago</a>
                </li>
            </ul>

            <div class="tab-content" id="formTabsContent">
                <!-- Tab: Datos Generales -->
                <div class="tab-pane fade show active" id="generales" role="tabpanel" aria-labelledby="generales-tab">
                    <div class="row">
                        <!-- Columna izquierda -->
                        <div class="col-md-6">
                            <h5 class="mb-3 fw-bold border-bottom pb-2 text-primary">Generales</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="sucursal" name="sucursal">
                                            <option selected value="2">CEDIS</option>
                                        </select>
                                        <label for="sucursal">Sucursal</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="almacen" name="almacen">
                                            <option selected>ALMACÉN GENERAL</option>
                                        </select>
                                        <label for="almacen">Almacén</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="grupo-docto" name="grupo_docto">
                                            <option selected>Cotización</option>
                                        </select>
                                        <label for="grupo-docto">Grupo docto</label>
                                    </div>
                                </div>
                                @*<p>Tipo recibido: @ViewBag.tipo</p>
                                    <p>Tipo recibido: @ViewBag.area</p>
                                    <p>Tipo recibido: @ViewBag.tpdocAb</p>
                                    <p>Tipo recibido: @ViewBag.anio</p>
                                    <p>Tipo recibido: @ViewBag.folio</p>
                                    <p>Tipo recibido: @ViewBag.tpdoc</p>
                                    <p>Tipo recibido: @ViewBag.idarea</p>*@
                                <input type="hidden" name="tpdoc" value="@ViewBag.tpdoc" />
                                <input type="hidden" name="idarea" value="@ViewBag.idarea" />
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="tipo-docto" name="tipo_docto">
                                            <option value="CTC" selected>Cotización al cliente</option>
                                        </select>
                                        <label for="tipo-docto">Tipo docto</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Columna derecha -->
                        <div class="col-md-6">
                            <h5 class="mb-3 fw-bold border-bottom pb-2 text-primary">Documento</h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="tipo-docto-mov" name="tipo-docto_mov">
                                            <option value="alta" selected>Alta</option>
                                            <option value="modificacion">Modificacion</option>
                                            <option value="consulta">Consulta</option>
                                        </select>
                                        <label for="tipo-docto-mov">Tipo docto</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="d-flex align-items-end">
                                        <!-- Input Folio -->
                                        <div class="form-outline flex-grow-1 me-2" data-mdb-input-init>
                                            <input type="text" id="folio" name="folio"
                                                   value="@ViewBag.tpdocAb-@ViewBag.area-@ViewBag.anio-@ViewBag.folio"
                                                   readonly class="form-control" />
                                            <label class="form-label" for="folio">Folio</label>
                                        </div>
                                        <!-- Botón Lupa para Cotizaciones -->
                                        <button id="btnBuscarFolio" type="button"
                                                class="btn btn-outline-primary d-none"
                                                title="Buscar folio"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalBuscarCotizacion">
                                            <i class="fas fa-search"></i>
                                        </button>

                                    </div>
                                </div>

                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <input type="date" id="fecha" name="fecha" value="2025-04-21" class="form-control active" />
                                        <label class="form-label" for="fecha">Fecha</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="detalle" role="tabpanel" aria-labelledby="detalle-tab">
                    <!-- Detalle del proveedor -->
                    <div class="row">
                        <div class="col-md-3 mb-3">
                            @*<div class="input-group h-100">
                                    <input type="text" class="form-control custom-input" id="cliente" required placeholder="Cliente" />
                                    <button class="btn btn-outline-primary custom-btn" type="button" id="btn-proveedor" data-bs-toggle="modal" data-bs-target="#modalBuscarCliente">Buscar</button>
                                </div>
                                <label for="proveedor"> </label>*@
                            <div class="input-group">
                                <input type="text"
                                       name="cliente"
                                       class="form-control"
                                       id="cliente"
                                       placeholder="Cliente"
                                       aria-label="Recipient's username"
                                       aria-describedby="button-addon2" />
                                <button class="btn btn-outline-primary" type="button" id="btn-proveedor" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms" data-bs-toggle="modal" data-bs-target="#modalBuscarCliente">
                                    <i class="fa-duotone fa-solid fa-search fa-beat"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            @*<input type="text" class="form-control" id="rfc" required placeholder="RFC" />
                                <label for="rfc">RFC</label>*@
                            <div class="form-outline" data-mdb-input-init>
                                <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                <input type="text" name="rfc" id="rfc" class="form-control form-icon-trailing  required" />
                                <label class="form-label" for="rfc">RFC</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            @*<div class="input-group h-100">
                                    <input type="text" class="form-control custom-input" id="docto-previo" required placeholder="Docto previo" />
                                    <button class="btn btn-outline-primary custom-btn" type="button" id="btn-docto-previo">Buscar</button>
                                </div>
                                <label for="docto-previo"> </label>*@
                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       name="docto-previo"
                                       id="docto-previo"
                                       placeholder="Docto previo"
                                       aria-label="Recipient's username"
                                       aria-describedby="button-addon2" />
                                <button class="btn btn-outline-primary" type="button" id="btn-docto-previo" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms">
                                    <i class="fa-duotone fa-solid fa-search fa-beat"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            @*<div class="input-group h-100">
                                    <input type="text" class="form-control custom-input" id="partidas-previas" required placeholder="Partidas previas" />
                                    <button class="btn btn-outline-primary custom-btn" type="button" id="btn-partidas-previas">Buscar</button>
                                </div>
                                <label for="partidas-previas"></label>*@
                            <div class="input-group">
                                <input type="text"
                                       class="form-control"
                                       name="partidas-previas"
                                       id="partidas-previas"
                                       placeholder="Partidas previas"
                                       aria-label="Recipient's username"
                                       aria-describedby="button-addon2" />
                                <button class="btn btn-outline-primary" type="button" id="btn-partidas-previas" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms">
                                    <i class="fa-duotone fa-solid fa-search fa-beat"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Columna para el textarea -->
                        <div class="col-md-6 mb-3">
                            @*<textarea class="form-control" id="info-proveedor" rows="4" placeholder="Información del proveedor" readonly
                                          style="padding-top: 1.5rem; height: auto;"></textarea>
                                <label for="info-proveedor" style="position: absolute; top: 0; left: 0; padding: .375rem .75rem; pointer-events: none; transition: all 0.2s ease-in-out;">Información del proveedor</label>*@
                            <div class="form-outline" data-mdb-input-init>
                                <textarea class="form-control" id="info-proveedor" rows="4" readonly></textarea>
                                <label class="form-label" for="info-proveedor">Información del proveedor</label>
                            </div>
                        </div>

                        <!-- Fila con descuentos y Dirección de entrega en 2 y 2 (con row) -->
                        <div class="col-md-6">
                            <div class="row">
                                <!-- Fila superior con Descuento 1 y Dirección de entrega -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" name="direccion" id="direccion" required aria-label="direccion">
                                            <option selected disabled>Dirección de entrega</option>
                                            <!-- Agrega más agentes si lo deseas -->
                                        </select>
                                        <label for="direccion">
                                            Dirección de entrega
                                        </label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                        <input type="number" id="descuento1" name="descuento1" class="form-control form-icon-trailing " />
                                        <label class="form-label" for="descuento1">Descuento 1</label>
                                    </div>
                                </div>
                                <!-- Fila inferior con Descuento 2 y 3 -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                        <input type="number" id="descuento2" name="descuento2" class="form-control form-icon-trailing " />
                                        <label class="form-label" for="descuento2">Descuento 2</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                        <input type="number" id="descuento3" name="descuento3" class="form-control form-icon-trailing " />
                                        <label class="form-label" for="descuento3">Descuento 3</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating shadow-sm rounded">
                                <select class="form-select" name="vendedor" id="vendedor" required aria-label="vendedor">
                                    <option selected disabled>Selecciona un Vendedor</option>
                                    <!-- Agrega más agentes si lo deseas -->
                                </select>
                                <label for="vendedor">
                                    Vendedor
                                </label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating shadow-sm rounded">
                                <select class="form-select" name="moneda" id="moneda" required>
                                    <option selected>PESOS</option>
                                </select>
                                <label for="moneda">Moneda</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-outline" data-mdb-input-init>
                                <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                <input type="text" id="paridad" name="paridad" class="form-control form-icon-trailing active" value="1.0000" required />
                                <label class="form-label" for="paridad">Paridad</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-outline" data-mdb-input-init>
                                <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                <input type="text" id="factura" name="factura" class="form-control form-icon-trailing " />
                                <label class="form-label" for="factura">Factura</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating shadow-sm rounded">
                                <select class="form-select" name="contacto" id="contacto" required aria-label="Contacto">
                                    <option selected disabled>Selecciona un contacto</option>
                                    <option value="juan_perez">Juan Pérez</option>
                                    <option value="ana_garcia">Ana García</option>
                                    <option value="luis_fernandez">Luis Fernández</option>
                                </select>
                                <label for="contacto">Contacto</label>
                            </div>
                        </div>
                        <!-- Formato en inglés -->
                        <div class="col-md-2 mb-3 d-flex align-items-center">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" name="formato_ingles" id="formato-ingles" />
                                <label class="form-check-label" for="formato-ingles">Formato en Inglés</label>
                            </div>
                        </div>
                        <!-- Concepto e Incoterm -->
                        <div class="col-md-3 mb-3">
                            <div class="form-outline" data-mdb-input-init>
                                <i class="fa-duotone fa-solid fa-keyboard trailing"></i>
                                <input type="text" id="concepto" name="concepto" class="form-control form-icon-trailing " />
                                <label class="form-label" for="concepto">Concepto</label>
                            </div>
                        </div>
                        <div class="col-md-3 mb-3">
                            <div class="form-floating shadow-sm rounded">
                                <select class="form-select" name="incoterm" id="incoterm" required aria-label="Incoterm">
                                    <option selected disabled>Selecciona un Incoterm</option>
                                    <option value="EXW">EXW – En fábrica</option>
                                    <option value="FOB">FOB – Libre a bordo</option>
                                    <option value="CFR">CFR – Costo y flete</option>
                                    <option value="CIF">CIF – Costo, seguro y flete</option>
                                    <option value="DAP">DAP – Entregado en lugar</option>
                                    <option value="DDP">DDP – Entregado con derechos pagados</option>
                                </select>
                                <label for="incoterm">
                                    Incoterm
                                </label>
                            </div>
                        </div>

                    </div>
                </div>
                <!-- Tabla de artículos -->
                <div class="tab-pane fade" id="articulos" role="tabpanel" aria-labelledby="detalle-tab">
                    <div class="card">
                        <div class="card-header text-bg-primary">
                            <h2 class="animate__animated animate__rubberBand">Artículos</h2>
                        </div>
                        <div class="card-body">
                            <div class="mb-3">
                                <input type="text" id="txtTotal" class="form-control fw-bold text-end" readonly>
                            </div>
                            @*<div class="d-flex justify-content-between align-items-center mb-3">
                                    <button type="button"
                                            class="btn btn-outline-primary"
                                            data-mdb-ripple-init
                                            data-mdb-ripple-color="primary"
                                            data-mdb-ripple-duration="1000ms"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalBuscarProducto">
                                        <i class="fas fa-plus fa-beat"></i> Nuevo Producto
                                    </button>
                                </div>*@
                            <div class="row">
                                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                                    <button type="button" class="btn btn-outline-primary mb-3" data-mdb-ripple-init data-mdb-ripple-color="primary" data-mdb-ripple-duration="1000ms" data-bs-toggle="modal" data-bs-target="#modalBuscarProducto">
                                        <i class="fa-duotone fa-solid fa-plus fa-beat"></i> Nuevo Producto
                                    </button>
                                </div>
                            </div>

                            <div class="table-responsive-sm">
                                <table id="clientesTable" class="table table-striped table-bordered table-hover" style="width:100%">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th>Artículo</th>
                                            <th>Cantidad</th>
                                            <th>Exist. Alm. Gral.</th>
                                            <th>Exist. Mod.</th>
                                            <th>Unidad</th>
                                            <th>Precio de lista</th>
                                            <th>Descuento</th>
                                            <th>Importe</th>
                                            <th>Descripción</th>
                                            <th>Mínimo</th>
                                            <th>Tipo</th>
                                            <th>Locación</th>
                                            <th>Comentario Partida</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <!-- Los datos se cargarán vía AJAX -->
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="tab-pane fade" id="condiciones" role="tabpanel" aria-labelledby="detalle-tab">
                    @*<h5 class="fw-bold text-primary mb-3">Condiciones de Pago y Crédito</h5>*@
                    <div class="row">
                        <!-- Columna combinada: Crédito + Condiciones de pago -->
                        <div class="col-md-6">
                            <div class="row">
                                <!-- Crédito -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-credit-card trailing"></i>
                                        <input type="number" id="limite-credito" name="limite-credito" value="0.00" readonly class="form-control form-icon-trailing active" />
                                        <label class="form-label" for="limite-credito">Límite de crédito</label>
                                    </div>
                                </div>
                                <!-- Condiciones de pago -->
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-calendar-day trailing"></i>
                                        <input type="number" id="plazo" name="plazo" class="form-control form-icon-trailing active" />
                                        <label class="form-label" for="plazo">Plazo</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <input type="date" id="fecha-pago" name="fecha-pago" value="2025-04-21" class="form-control active" />
                                        <label class="form-label" for="fecha-pago">Fecha de Pago</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <input type="time" id="hora-entrega" name="hora-entrega" value="12:00" class="form-control active" />
                                        <label class="form-label" for="hora-entrega">Hora de Entrega</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <i class="fa-duotone fa-solid fa-cogs trailing"></i>
                                        <input type="text" id="condiciones" name="condiciones" value="Pago de contado" class="form-control form-icon-trailing active" />
                                        <label class="form-label" for="condiciones">Condiciones</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="forma-pago" name="forma-pago" aria-label="Forma de Pago">
                                            <option selected>Efectivo</option>
                                            <option value="01">01 - Efectivo</option>
                                            <option value="02">02 - Cheque nominativo</option>
                                            <option value="03">03 - Transferencia electrónica</option>
                                            <option value="04">04 - Tarjeta de crédito</option>
                                            <option value="28">28 - Tarjeta de débito</option>
                                        </select>
                                        <label for="forma-pago">Forma de Pago</label>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="metodo-pago" name="metodo-pago" aria-label="Método de Pago">
                                            <option selected>Pago en parcialidades o diferido</option>
                                            <option value="PUE">PUE - Pago en una sola exhibición</option>
                                            <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                                        </select>
                                        <label for="metodo-pago">Método de Pago</label>
                                    </div>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <div class="form-floating shadow-sm rounded">
                                        <select class="form-select" id="uso-cfdi" name="uso-cfdi" aria-label="Uso CFDI">
                                            <option selected>G03 - Gastos en general</option>
                                            <option value="D01">D01 - Honorarios médicos</option>
                                            <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                            <option value="P01">P01 - Por definir</option>
                                            <option value="NOMINA">Nómina</option>
                                        </select>
                                        <label for="uso-cfdi">Uso CFDI</label>
                                    </div>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <textarea class="form-control active" id="direccion-entrega" name="direccion-entrega" rows="2"></textarea>
                                        <label class="form-label" for="direccion-entrega">Dirección de entrega</label>
                                    </div>
                                </div>
                                <div class="col-md-12 mb-3">
                                    <div class="form-outline" data-mdb-input-init>
                                        <textarea class="form-control active" id="comentarios" name="comentarios" rows="4"></textarea>
                                        <label class="form-label" for="comentarios">Comentarios</label>
                                    </div>
                                </div>
                            </div>
