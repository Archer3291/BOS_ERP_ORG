@section styles {
    <style>
        .section-title {
            font-size: 1.5rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 1.5rem;
            padding-bottom: 0.5rem;
            border-bottom: 3px solid var(--primary-blue);
        }

        .card {
            border: 1px solid var(--border-light);
            border-radius: 12px;
            box-shadow: var(--shadow);
            background-color: var(--bg-light);
            margin-bottom: 2rem;
        }

        .summary-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 1.5rem;
            margin-bottom: 2rem;
        }

        .summary-box {
            background: var(--bg-light);
            border-radius: 12px;
            padding: 1.5rem;
            box-shadow: var(--shadow);
            border-left: 5px solid;
            transition: transform 0.2s;
        }

            .summary-box:hover {
                transform: translateY(-3px);
                box-shadow: var(--shadow-lg);
            }

            .summary-box.success {
                border-left-color: var(--success-color);
            }

            .summary-box.danger {
                border-left-color: var(--danger-color);
            }

            .summary-box.primary {
                border-left-color: var(--primary-blue);
            }

            .summary-box.info {
                border-left-color: var(--accent-blue);
            }

        .summary-label {
            font-size: 0.875rem;
            color: var(--text-light);
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .summary-value {
            font-size: 2rem;
            font-weight: 700;
        }

        .input-group-custom {
            background: var(--bg-light);
            border: 2px solid var(--border-light);
            border-radius: 10px;
            padding: 1rem;
            margin-bottom: 1rem;
            transition: all 0.2s;
        }

            .input-group-custom:hover {
                border-color: var(--accent-blue);
                box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
            }

            .input-group-custom label {
                display: block;
                font-weight: 600;
                color: var(--text-dark);
                margin-bottom: 0.5rem;
                font-size: 0.875rem;
            }

            .input-group-custom input,
            .input-group-custom select {
                width: 100%;
                border: 1px solid var(--border-light);
                background: var(--bg-gray);
                padding: 0.75rem;
                border-radius: 8px;
                font-size: 1.125rem;
                font-weight: 600;
                color: var(--text-dark);
                transition: all 0.2s;
            }

                .input-group-custom input:focus,
                .input-group-custom select:focus {
                    outline: none;
                    background: var(--bg-light);
                    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.1);
                }

        .input-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 1rem;
        }

        .btn-action {
            padding: 0.875rem 2rem;
            border-radius: 10px;
            font-weight: 600;
            border: none;
            transition: all 0.2s;
            font-size: 1rem;
            cursor: pointer;
        }

        .btn-primary-custom {
            background: var(--primary-blue);
            color: white;
        }

            .btn-primary-custom:hover {
                background: var(--primary-blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

        .btn-success-custom {
            background: var(--success-color);
            color: white;
        }

            .btn-success-custom:hover {
                opacity: 0.9;
                transform: translateY(-2px);
            }

        .btn-danger-custom {
            background: var(--danger-color);
            color: white;
        }

            .btn-danger-custom:hover {
                opacity: 0.9;
                transform: translateY(-2px);
            }

        .movement-item {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: 10px;
            padding: 1.25rem;
            margin-bottom: 1rem;
            transition: all 0.2s;
        }

            .movement-item:hover {
                box-shadow: var(--shadow-lg);
                transform: translateX(5px);
            }

        .movement-header {
            display: flex;
            justify-content: space-between;
            align-items: start;
            margin-bottom: 0.75rem;
        }

        .movement-type {
            display: inline-block;
            padding: 0.375rem 1rem;
            border-radius: 20px;
            font-size: 0.75rem;
            font-weight: 700;
            text-transform: uppercase;
        }

            .movement-type.ingreso {
                background: rgba(5, 150, 105, 0.1);
                color: var(--success-color);
            }

            .movement-type.retiro {
                background: rgba(220, 38, 38, 0.1);
                color: var(--danger-color);
            }

        .movement-amount {
            font-size: 1.5rem;
            font-weight: 700;
        }

            .movement-amount.positive {
                color: var(--success-color);
            }

            .movement-amount.negative {
                color: var(--danger-color);
            }

        .movement-details {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            font-size: 0.875rem;
            color: var(--text-light);
        }

        .tabs-container {
            display: flex;
            gap: 1rem;
            margin-bottom: 2rem;
            border-bottom: 2px solid var(--border-light);
        }

        .tab-button {
            padding: 1rem 2rem;
            background: none;
            border: none;
            border-bottom: 3px solid transparent;
            color: var(--text-light);
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

            .tab-button:hover {
                color: var(--primary-blue);
            }

            .tab-button.active {
                color: var(--primary-blue);
                border-bottom-color: var(--primary-blue);
            }

        .tab-content {
            display: none;
        }

            .tab-content.active {
                display: block;
            }

        .empty-state {
            text-align: center;
            padding: 3rem;
            color: var(--text-light);
        }

            .empty-state i {
                font-size: 4rem;
                margin-bottom: 1rem;
                opacity: 0.3;
            }

        @@media (max-width: 768px) {
            .summary-value {
                font-size: 1.5rem;
            }

            .input-grid {
                grid-template-columns: 1fr;
            }
        }
}
    </style>
    <form>
        @Html.AntiForgeryToken()
    </form>
    <div class="mb-4">
        <h1 class="fw-bold" style="color: var(--text-dark);">
            <i class="fas fa-cash-register me-2"></i>Control de Caja
        </h1>
        <p style="color: var(--text-light);">Sistema de gestión de efectivo y movimientos</p>
    </div>

    <!-- Resumen Principal -->
    <div class="summary-grid">
        <div class="summary-box success">
            <div class="summary-label">
                <i class="fas fa-arrow-up"></i>
                TOTAL INGRESOS
            </div>
            <div class="summary-value" style="color: var(--success-color);" id="totalIngresos">$0.00</div>
        </div>

        <div class="summary-box danger">
            <div class="summary-label">
                <i class="fas fa-arrow-down"></i>
                TOTAL RETIROS
            </div>
            <div class="summary-value" style="color: var(--danger-color);" id="totalRetiros">$0.00</div>
        </div>

        <div class="summary-box primary">
            <div class="summary-label">
                <i class="fas fa-wallet"></i>
                BALANCE
            </div>
            <div class="summary-value" style="color: var(--primary-blue);" id="balance">$0.00</div>
        </div>

        <div class="summary-box info">
            <div class="summary-label">
                <i class="fas fa-sack-dollar"></i>
                TOTAL DISPONIBLE
            </div>
            <div class="summary-value" style="color: var(--accent-blue);" id="totalDisponible">$0.00</div>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <button class="tab-button active" onclick="switchTab('detalles')">
            <i class="fas fa-calculator me-2"></i>Detalles de Caja
        </button>
        <button class="tab-button" onclick="switchTab('movimientos')">
            <i class="fas fa-exchange-alt me-2"></i>Registrar Movimiento
        </button>
        <button class="tab-button" onclick="switchTab('historial')">
            <i class="fas fa-history me-2"></i>Historial
        </button>
    </div>

    <!-- TAB: Detalles de Caja -->
    <div id="tab-detalles" class="tab-content active">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="section-title">
                    <i class="fas fa-money-bill-wave me-2"></i>Formas de Pago
                </h5>
                <div class="input-grid">
                    <div class="input-group-custom">
                        <label><i class="fas fa-credit-card me-2"></i>Tarjeta</label>
                        <input type="number" id="tarjeta" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-money-bill-transfer me-2"></i>Transferencia</label>
                        <input type="number" id="transferencia" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-receipt me-2"></i>Notas de Crédito</label>
                        <input type="number" id="notasCredito" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                </div>

                <h5 class="section-title mt-4">
                    <i class="fas fa-hand-holding-dollar me-2"></i>Manejo de Efectivo
                </h5>
                <div class="input-grid">
                    <div class="input-group-custom">
                        <label><i class="fas fa-piggy-bank me-2"></i>Fondo Inicial</label>
                        <input type="number" id="fondoInicial" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-money-bills me-2"></i>Efectivo Recibido</label>
                        <input type="number" id="efectivo" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-building-columns me-2"></i>Depósitos</label>
                        <input type="number" id="depositos" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-hand-holding-dollar me-2"></i>Retiros de Efectivo (Manual)</label>
                        <input type="number" id="retirosEfectivo" step="0.01" placeholder="0.00" onchange="updateTotals()">
                    </div>
                    <div class="input-group-custom">
                        <label><i class="fas fa-users me-2"></i>Clientes Atendidos</label>
                        <input type="number" id="clientesAtendidos" placeholder="0">
                    </div>
                </div>

                <div class="card mt-4" style="background: rgba(59, 130, 246, 0.05); border: 2px solid var(--accent-blue);">
                    <div class="card-body">
                        <h6 style="color: var(--accent-blue); font-weight: 700;">
                            <i class="fas fa-calculator me-2"></i>EFECTIVO REAL EN CAJA
                        </h6>
                        <div style="font-size: 2rem; font-weight: 700; color: var(--accent-blue);" id="efectivoReal">$0.00</div>
                        <small style="color: var(--text-light);">Fondo Inicial + Efectivo + Depósitos + Ingresos - Retiros Manuales - Retiros de Movimientos</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB: Registrar Movimiento -->
    <div id="tab-movimientos" class="tab-content">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="section-title">Nuevo Movimiento</h5>

                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="input-group-custom">
                            <label>Tipo de Movimiento</label>
                            <select id="movementType">
                                <option value="ingreso">💰 Ingreso</option>
                                <option value="retiro">💸 Retiro</option>
                            </select>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-custom">
                            <label>Monto</label>
                            <input type="number" id="movementAmount" step="0.01" placeholder="0.00">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-custom">
                            <label>Concepto</label>
                            <input type="text" id="movementConcept" placeholder="Ej: Pago a proveedor" style="font-weight: normal;">
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="input-group-custom">
                            <label>Notas (opcional)</label>
                            <input type="text" id="movementNotes" placeholder="Detalles adicionales" style="font-weight: normal;">
                        </div>
                    </div>
                </div>

                <div class="mt-4 d-flex gap-3">
                    <button class="btn-action btn-success-custom" onclick="saveMovement()">
                        <i class="fas fa-check me-2"></i>Guardar Movimiento
                    </button>
                    <button class="btn-action btn-danger-custom" onclick="clearMovementForm()">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- TAB: Historial -->
    <div id="tab-historial" class="tab-content">
        <div class="card">
            <div class="card-body p-4">
                <h5 class="section-title">Movimientos Recientes</h5>
                <div id="movementsList"></div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script src="~/lib/signature_pad/dist/signature_pad.umd.min.js"></script>
        <script>
            let movements = [];

            GetData({
                path: '/PuntoVentaAdministracion/DatosGeneral',
            }).then((_res) => {
                const facturas = _res.facturas;
                const fondoInicial = _res.fondoInicial;
                const ingresosRetiros = _res.ingresosRetiros;

                if (facturas && facturas.length > 0) {
                    facturas.forEach(f => {
                        switch (f.forma_pago) {
                            case "01": // Efectivo
                                document.getElementById("efectivo").value = f.total_monto;
                                break;

                            case "28": // Tarjeta Débito
                                document.getElementById("tarjeta").value = f.total_monto;
                                break;

                            case "03": // Transferencia
                                document.getElementById("transferencia").value = f.total_monto;
                                break;
                        }
                    });
                }
                if (fondoInicial && fondoInicial.length > 0) {
                    document.getElementById("fondoInicial").value = fondoInicial[0].montoinicial;
                }
                if (ingresosRetiros && ingresosRetiros.length > 0) {
                    document.getElementById("retirosEfectivo").value = ingresosRetiros[0].total_dinero;
                }
            });

            function formatCurrency(amount) {
                return new Intl.NumberFormat('es-MX', {
                    style: 'currency',
                    currency: 'MXN',
                    minimumFractionDigits: 2
                }).format(amount);
            }

            function formatDateTime() {
                return new Date().toLocaleString('es-MX', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit',
                    hour: '2-digit',
                    minute: '2-digit'
                });
            }

            function switchTab(tabName) {
                // Remove active from all tabs
                document.querySelectorAll('.tab-button').forEach(btn => btn.classList.remove('active'));
                document.querySelectorAll('.tab-content').forEach(content => content.classList.remove('active'));

                // Add active to selected tab
                event.target.classList.add('active');
                document.getElementById('tab-' + tabName).classList.add('active');
            }

            function clearMovementForm() {
                document.getElementById('movementType').value = 'ingreso';
                document.getElementById('movementAmount').value = '';
                document.getElementById('movementConcept').value = '';
                document.getElementById('movementNotes').value = '';
            }

async function saveMovement() {
    const type = document.getElementById('movementType').value;
    const amount = parseFloat(document.getElementById('movementAmount').value);
    const concept = document.getElementById('movementConcept').value;
    const notes = document.getElementById('movementNotes').value;

    if (!amount || !concept) {
        alert('Por favor completa el monto y el concepto');
        return;
    }

    if (amount <= 0) {
        alert('El monto debe ser mayor a 0');
        return;
    }

    // 🔹 VALIDACIÓN: Si es retiro, verificar que hay suficiente efectivo
    if (type === 'retiro') {
        // Calcular efectivo disponible actual
        const fondoInicial = parseFloat(document.getElementById('fondoInicial').value) || 0;
        const efectivo = parseFloat(document.getElementById('efectivo').value) || 0;
        const depositos = parseFloat(document.getElementById('depositos').value) || 0;

        const ingresosMovimientos = movements
            .filter(m => m.type === 'ingreso')
            .reduce((sum, m) => sum + m.amount, 0);

        const retirosMovimientos = movements
            .filter(m => m.type === 'retiro')
            .reduce((sum, m) => sum + m.amount, 0);

        // Efectivo real disponible en caja
        const efectivoDisponible = fondoInicial + efectivo + depositos + ingresosMovimientos - retirosMovimientos;

        // Validar que hay suficiente efectivo
        if (amount > efectivoDisponible) {
            Swal.fire({
                icon: 'error',
                title: 'Efectivo Insuficiente',
                html: `
                    <p>No hay suficiente efectivo en caja para realizar este retiro.</p>
                    <div style="margin-top: 15px; padding: 15px; background: #f8f9fa; border-radius: 8px;">
                        <strong>Efectivo disponible:</strong> ${formatCurrency(efectivoDisponible)}<br>
                        <strong>Monto del retiro:</strong> ${formatCurrency(amount)}<br>
                        <strong style="color: #dc3545;">Faltante:</strong> ${formatCurrency(amount - efectivoDisponible)}
                    </div>
                `,
                confirmButtonText: 'Entendido'
            });
            return;
        }
    }

    const formData = new FormData();
    formData.append("type", type);
    formData.append("amount", amount);
    formData.append("concept", concept);
    formData.append("notes", notes);
    formData.append("user", "Usuario Actual");
    formData.append("date", formatDateTime());

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (token) {
        formData.append('__RequestVerificationToken', token);
    }

    // 🔹 Solicitar firma (igual que en OC)
    return Swal.fire({
        title: 'Firma el documento antes de continuar',
        html: `
            <div>
                <p>Firma del usuario</p>
                <canvas id="signatureMovement" width="400" height="200" style="border:1px solid #ccc;"></canvas>
                <button type="button" class="btn btn-secondary mt-2" id="limpiar_firma_mov">Limpiar</button>
            </div>
        `,
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
            const canvas = document.getElementById("signatureMovement");
            const signaturePad = new SignaturePad(canvas, {
                penColor: "rgb(0, 0, 0)",
                minWidth: 0.5,
                maxWidth: 1.0
            });

            // 🔹 Cargar firma previa del usuario (si existe)
            const firmaBase64 = '@Context.Session.GetString("Firma")';

            if (firmaBase64 && firmaBase64 !== "null" && firmaBase64.trim() !== "") {
                signaturePad.fromDataURL(firmaBase64);
            }

            document.getElementById('limpiar_firma_mov').addEventListener('click', () => {
                signaturePad.clear();
            });

            Swal.__signaturePadMovement = signaturePad;
        },
        preConfirm: () => {
            const pad = Swal.__signaturePadMovement;

            if (!pad || pad.isEmpty()) {
                Swal.showValidationMessage('Debes firmar antes de continuar.');
                return false;
            }

            const dataUrl = pad.toDataURL("image/png", 0.5);

            formData.append("firmaMovimiento", dataUrl);

            // 🔹 Enviar al backend
            return fetch("/PuntoVentaAdministracion/DocumentoRetiro", {
                method: "POST",
                body: formData
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    throw new Error(data.message || "No se pudo guardar.");
                }
                return data;
            })
            .catch(err => Swal.showValidationMessage(`Error: ${err.message}`));
        }
    }).then(async result => {
        if (result.isConfirmed) {
            // refrescar UI
            await renderMovements();
            updateTotals();
            clearMovementForm();

            toastMixin.fire({
                icon: "success",
                title: "Documento creado correctamente",
            });
        }
    });
}

            async function renderMovements() {
                const container = document.getElementById('movementsList');
                container.innerHTML = `<div class="loading-state">Cargando movimientos...</div>`;

                try {
                    const response = await fetch("/PuntoVentaAdministracion/ObtenerDocumentos");
                    const data = await response.json();

                    if (!response.ok) {
                        container.innerHTML = `<div class="error-state">Error al cargar movimientos</div>`;
                        return;
                    }

                    // 🚀 ACTUALIZAR EL ARRAY GLOBAL movements
                    movements = data.data?.movements || data.movements || data || [];

                    if (movements.length === 0) {
                        container.innerHTML = `
                <div class="empty-state">
                    <i class="fas fa-inbox"></i>
                    <p>No hay movimientos registrados</p>
                </div>`;
                        // 🚀 Actualizar summary incluso si está vacío
                        updateSummary();
                        return;
                    }

                    let html = '';

                    movements.forEach(m => {
                        const typeClass = m.type === 'ingreso' ? 'ingreso' : 'retiro';
                        const amountClass = m.type === 'ingreso' ? 'positive' : 'negative';
                        const amountSign = m.type === 'ingreso' ? '+' : '-';

                        html += `
                <div class="movement-item">
                    <div class="movement-header">
                        <div>
                            <span class="movement-type ${typeClass}">${m.type}</span>
                            <div class="mt-2"><strong>${m.concept}</strong></div>
                        </div>
                        <div class="movement-amount ${amountClass}">
                            ${amountSign}${formatCurrency(m.amount)}
                        </div>
                    </div>
                    <div class="movement-details">
                        <div><i class="fas fa-clock me-2"></i>${dateFormatter(m.date)}</div>
                        <div><i class="fas fa-user me-2"></i>${m.user}</div>
                        ${m.notes ? `<div><i class="fas fa-sticky-note me-2"></i>${m.notes}</div>` : ''}
                    </div>
                </div>`;
                    });

                    container.innerHTML = html;

                    // 🚀 Actualizar los cards globales después de cargar los movimientos
                    updateSummary();

                } catch (error) {
                    toastMixin.fire({
                        icon: 'error',
                        title: error
                    });
                }
            }

            function updateSummary() {
                // Obtener todos los valores de los inputs
                const tarjeta = parseFloat(document.getElementById('tarjeta').value) || 0;
                const transferencia = parseFloat(document.getElementById('transferencia').value) || 0;
                const notasCredito = parseFloat(document.getElementById('notasCredito').value) || 0;
                const fondoInicial = parseFloat(document.getElementById('fondoInicial').value) || 0;
                const efectivo = parseFloat(document.getElementById('efectivo').value) || 0;
                const depositos = parseFloat(document.getElementById('depositos').value) || 0;
                const retirosEfectivo = parseFloat(document.getElementById('retirosEfectivo').value) || 0;

                // Calcular movimientos
                const ingresosMovimientos = movements
                    .filter(m => m.type === 'ingreso')
                    .reduce((sum, m) => sum + m.amount, 0);

                const retirosMovimientos = movements
                    .filter(m => m.type === 'retiro')
                    .reduce((sum, m) => sum + m.amount, 0);

                // 🚀 TOTAL INGRESOS: Solo EFECTIVO que ENTRA físicamente a la caja
                const totalIngresos = fondoInicial + efectivo + depositos + ingresosMovimientos;

                // 🚀 TOTAL RETIROS: Solo EFECTIVO que SALE físicamente de la caja
                const totalRetiros =  retirosMovimientos;

                // 🚀 BALANCE: Efectivo neto en caja (Ingresos - Retiros)
                const balance = totalIngresos - totalRetiros;

                // Calcular efectivo real en caja
                const efectivoReal = balance;

                // 🚀 TOTAL DISPONIBLE: Efectivo en caja + Pagos electrónicos
                const totalDisponible = efectivoReal + tarjeta + transferencia + notasCredito;

                document.getElementById('totalIngresos').textContent = formatCurrency(totalIngresos);
                document.getElementById('totalRetiros').textContent = formatCurrency(totalRetiros);
                document.getElementById('balance').textContent = formatCurrency(balance);
                document.getElementById('totalDisponible').textContent = formatCurrency(totalDisponible);
                document.getElementById('efectivoReal').textContent = formatCurrency(efectivoReal);
            }

            function updateTotals() {
                // Esta función ahora solo se llama cuando cambian los inputs
                // pero los cálculos se hacen en updateSummary()
                updateSummary();
            }

            // 🚀 Inicializar - renderMovements ya llama a updateSummary internamente
            renderMovements().then(() => {
                updateTotals(); // Actualizar totales después de cargar movimientos
            });
        </script>
    }