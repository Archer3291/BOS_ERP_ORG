<div class="toast-area" id="toast-area"></div>

@section scripts {
    <script src="~/Scripts/TableBuilder.js"></script>
    <script>

        /* ══════════════════════════════════════════
           ESTADO GLOBAL
        ══════════════════════════════════════════ */
        const S = {
            pdfUrl: null,
            xmlUrl: null,
            bsModal: null,
            tabla: null,   // instancia de createTable
        };

        /* ══════════════════════════════════════════
           UTILIDADES
        ══════════════════════════════════════════ */
        const $el = id => document.getElementById(id);
        const setText = (id, v) => { const e = $el(id); if (e) e.textContent = v ?? '—'; };
        const setHtml = (id, v) => { const e = $el(id); if (e) e.innerHTML = v ?? ''; };
        const esc = t => { const d = document.createElement('div'); d.textContent = String(t ?? ''); return d.innerHTML; };

        const fmtMoney = (n, ccy = 'MXN') => {
            const sym = { MXN: '$', USD: 'US$', EUR: '€', CAD: 'CA$' };
            return (sym[ccy] || '$') + Number(n || 0).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
        };

        function ncToast(msg, type = 'info') {
            const zone = $el('toast-area');
            const t = document.createElement('div');
            const cls = { ok: 't-ok', err: 't-err', info: 't-inf' };
            const ico = { ok: 'check-circle', err: 'exclamation-circle', info: 'info-circle' };
            t.className = `nc-toast ${cls[type] || 't-inf'}`;
            t.innerHTML = `<i class="fas fa-${ico[type] || 'info-circle'}"></i> ${esc(msg)}`;
            zone.appendChild(t);
            setTimeout(() => {
                t.style.transition = 'opacity .3s,transform .3s';
                t.style.opacity = '0'; t.style.transform = 'translateY(6px)';
                setTimeout(() => t.remove(), 320);
            }, 3400);
        }

        /* ══════════════════════════════════════════
           METADATOS POR TIPO
        ══════════════════════════════════════════ */
        const TIPOS = {
            DEVOLUCION: { color: '#7c3aed', label: 'Devolución', cls: 'nb-purple' },
            DESCUENTO: { color: '#0891b2', label: 'Descuento', cls: 'nb-info' },
            PRECIO: { color: '#d97706', label: 'Error Precio', cls: 'nb-warn' },
            CANCELACION: { color: '#ef4444', label: 'Cancelación', cls: 'nb-danger' },
            BONIFICACION: { color: '#10b981', label: 'Bonificación', cls: 'nb-ok' },
            STANDALONE: { color: '#64748b', label: 'Sin Ref.', cls: 'nb-ghost' },
        };
        function tipoMeta(tipo) {
            if (!tipo) return { color: '#64748b', label: 'NC', cls: 'nb-ghost' };
            const k = Object.keys(TIPOS).find(k => tipo.toUpperCase().includes(k));
            return k ? TIPOS[k] : { color: '#64748b', label: tipo, cls: 'nb-ghost' };
        }
        function badgeEstatus(s) {
            const map = {
                TIMBRADA: ['nb-ok', 'Timbrada'],
                BORRADOR: ['nb-warn', 'Borrador'],
                CANCELADA: ['nb-danger', 'Cancelada'],
            };
            const [cls, lbl] = map[(s || '').toUpperCase()] || ['nb-ghost', s || '—'];
            return `<span class="nc-badge ${cls}">${lbl}</span>`;
        }

        /* ══════════════════════════════════════════
           KPI
        ══════════════════════════════════════════ */
        async function cargarKPI() {
            const desde = $el('f-fecha-desde')?.value || '';
            const hasta = $el('f-fecha-hasta')?.value || '';
            try {
                const res = await fetch(
                    `/ConsultaNotasCredito/ResumenKPI?fechaDesde=${desde}&fechaHasta=${hasta}`
                );
                const d = await res.json();
                setText('kpi-total', d.total_ncs || '0');
                setText('kpi-timbradas', d.ncs_timbradas || '0');
                setText('kpi-monto', fmtMoney(d.monto_total));
                setText('kpi-dev', fmtMoney(d.monto_devolucion));
                setText('kpi-desc', fmtMoney(d.monto_descuento));
                setText('kpi-saldo', fmtMoney(d.saldo_pendiente));
            } catch { /* KPI no crítico */ }
        }

        /* ══════════════════════════════════════════
           FILTROS EXTRA — se pasan a createTable
           como data() dinámico
        ══════════════════════════════════════════ */
        function getFiltrosExtra() {
            return {
                folio: $el('f-folio')?.value || '',
                tipo: $el('f-tipo')?.value || '',
                estatus: $el('f-estatus')?.value || '',
                fechaDesde: $el('f-fecha-desde')?.value || '',
                fechaHasta: $el('f-fecha-hasta')?.value || '',
            };
        }

        function recargarTabla() {
            S.tabla?.reload('');   // recarga desde página 1; los filtros extra se leen
            cargarKPI();           // via data() en el momento del fetch
        }

        function limpiarFiltros() {
            ['f-folio', 'f-tipo', 'f-estatus', 'f-fecha-desde', 'f-fecha-hasta']
                .forEach(id => { const e = $el(id); if (e) e.value = ''; });
            recargarTabla();
        }

        /* ══════════════════════════════════════════
           INICIALIZAR createTable
        ══════════════════════════════════════════ */
        document.addEventListener('DOMContentLoaded', () => {

            // Fechas default: último mes
            const hoy = new Date();
            const hace = new Date(); hace.setMonth(hace.getMonth() - 1);
            const iso = d => d.toISOString().slice(0, 10);
            $el('f-fecha-desde').value = iso(hace);
            $el('f-fecha-hasta').value = iso(hoy);

            cargarKPI();

            S.tabla = createTable({
                selector: '#tabla-nc',
                // El controller BuscarNC acepta POST con los campos extra
                path: '/ConsultaNotasCredito/BuscarNC',
                searchPlaceholder: 'Cliente o RFC...',
                defaultPageSize: 25,
                pageSizeOptions: [10, 25, 50, 100],

                // data() se evalúa en cada fetch → siempre lee los filtros actuales
                data: () => getFiltrosExtra(),

                exports: [
                    { type: 'excel', label: 'Exportar Excel', fileName: 'notas_credito' }
                ],

                columns: [
                    {
                        title: 'Folio',
                        data: 'folio',
                        formatter: (v, row) => {
                            const folio = (row.serie || '') + (v || '—');
                            return `<span style="font-family:'IBM Plex Mono',monospace;
                                                     font-weight:600;">
                                            ${esc(folio)}
                                        </span>`;
                        }
                    },
                    {
                        title: 'Cliente',
                        data: 'rsocliente',
                        formatter: (v, row) =>
                            `<div style="font-weight:500;font-size:12px;line-height:1.3;">${esc(v || '—')}</div>
                                 <div style="font-size:10px;color:var(--slate-400);
                                             font-family:'IBM Plex Mono',monospace;">${esc(row.rfccliente || '')}</div>`
                    },
                    {
                        title: 'Tipo',
                        data: 'tipo',
                        formatter: v => {
                            const m = tipoMeta(v);
                            return `<span class="nc-badge tipo-dot ${m.cls}"
                                              style="color:${m.color};background:${m.color}15;
                                                     border:1px solid ${m.color}38;font-size:9px;">
                                            ${esc(m.label)}
                                        </span>`;
                        }
                    },
                    {
                        title: 'Fecha',
                        data: 'fecha',
                        formatter: v => {
                            if (!v) return '—';
                            // Si viene como /Date(...)/ usa dateFormatter del site1
                            if (typeof dateFormatter === 'function' && /\/Date\(/.test(String(v))) {
                                return `<span style="font-family:'IBM Plex Mono',monospace;
                                                         font-size:11px;color:var(--slate-600);">
                                                ${dateFormatter(v)}
                                            </span>`;
                            }
                            // ISO o string normal
                            const d = new Date(v);
                            const fmt = isNaN(d) ? v
                                : d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
                            return `<span style="font-family:'IBM Plex Mono',monospace;
                                                     font-size:11px;color:var(--slate-600);">
                                            ${esc(fmt)}
                                        </span>`;
                        }
                    },
                    {
                        title: 'Facturas Origen',
                        data: 'facturas_origen',
                        formatter: v =>
                            `<span style="font-size:10px;color:var(--slate-600);
                                              max-width:130px;display:block;overflow:hidden;
                                              text-overflow:ellipsis;white-space:nowrap;"
                                       title="${esc(v)}">
                                    ${esc(v || '—')}
                                </span>`
                    },
                    {
                        title: 'Subtotal',
                        data: 'subtotal',
                        className: 'text-end',
                        formatter: (v, row) =>
                            `<span style="font-family:'IBM Plex Mono',monospace;font-size:11px;">
                                    ${fmtMoney(v, row.moneda)}
                                </span>`
                    },
                    {
                        title: 'IVA',
                        data: 'iva',
                        className: 'text-end',
                        formatter: (v, row) =>
                            `<span style="font-family:'IBM Plex Mono',monospace;font-size:11px;">
                                    ${fmtMoney(v, row.moneda)}
                                </span>`
                    },
                    {
                        title: 'Total',
                        data: 'total',
                        className: 'text-end',
                        formatter: (v, row) =>
                            `<span style="font-family:'IBM Plex Mono',monospace;
                                              font-size:11px;font-weight:600;">
                                    ${fmtMoney(v, row.moneda)}
                                </span>`
                    },
                    {
                        title: 'Saldo',
                        data: 'saldo',
                        className: 'text-end',
                        formatter: (v, row) => {
                            const total = parseFloat(row.total) || 0;
                            const saldo = parseFloat(v) || 0;
                            const pct = total > 0
                                ? Math.min(Math.round(((total - saldo) / total) * 100), 100)
                                : 0;
                            const color = pct >= 100 ? 'var(--ok)' : pct > 50 ? 'var(--amber)' : 'var(--danger)';
                            const lbl = pct === 0 ? 'Sin aplicar' : pct === 100 ? 'Aplicada' : `${pct}% apl.`;
                            return `<div style="font-family:'IBM Plex Mono',monospace;font-size:11px;">
                                            ${fmtMoney(saldo, row.moneda)}
                                        </div>
                                        <div class="saldo-bar">
                                            <div class="saldo-fill" style="width:${pct}%;background:${color}"></div>
                                        </div>
                                        <div style="font-size:9px;color:var(--slate-400);
                                                    font-family:'IBM Plex Mono',monospace;">
                                            ${lbl}
                                        </div>`;
                        }
                    },
                    {
                        title: 'Estatus',
                        data: 'statusfactura',
                        formatter: v => badgeEstatus(v)
                    },
                    {
                        title: 'Anticipo',
                        data: 'tiene_anticipo',
                        className: 'text-center',
                        formatter: v => v
                            ? `<span class="nc-badge nb-warn" title="Anticipo afectado">
                                       <i class="fas fa-coins"></i> Sí
                                   </span>`
                            : `<span style="color:var(--slate-300);font-size:13px;">—</span>`
                    },
                ],

                // Click en fila → abrir modal detalle
                RowsEvents: {
                    onRowClick: row => abrirDetalle(row.id)
                },

                // Cuando termina de cargar datos → refrescar KPI
                GlobalEvents: {
                    onDataLoaded: () => cargarKPI()
                },
            });

            // Enter en filtros
            ['f-folio', 'f-tipo', 'f-estatus', 'f-fecha-desde', 'f-fecha-hasta']
                .forEach(id => {
                    $el(id)?.addEventListener('keydown', e => {
                        if (e.key === 'Enter') recargarTabla();
                    });
                });
        });

        /* ══════════════════════════════════════════
           MODAL — ABRIR DETALLE
        ══════════════════════════════════════════ */
        async function abrirDetalle(id) {
            if (!S.bsModal) {
                S.bsModal = new bootstrap.Modal($el('modal-detalle'),
                    { backdrop: true, keyboard: true });
            }
            S.bsModal.show();
            showMdTab('mdt-general', document.querySelector('.md-tab-btn'));

            const resetIds = [
                'md-folio', 'md-rsocliente', 'md-rfccliente', 'md-cpr', 'md-regfise',
                'md-rsoemisor', 'md-rfcemisor', 'md-mdp', 'md-usocfdi', 'md-obs',
                'md-ticket', 'md-subtotal', 'md-descuento', 'md-iva', 'md-total',
                'md-saldo', 'md-fecha', 'md-fechatimbrado', 'md-moneda',
                'md-uuid', 'md-sellocfdi', 'md-sellosat', 'md-cadena',
            ];
            resetIds.forEach(i => setText(i, '…'));
            setHtml('md-tipo-lbl', '');
            setHtml('md-estatus-hd', '');

            try {
                const res = await fetch(`/ConsultaNotasCredito/DetalleNC?id=${id}`);
                const data = await res.json();

                if (!data.success) { ncToast(data.message || 'Error al cargar', 'err'); return; }

                const enc = data.encabezado;
                const ccy = enc.moneda || 'MXN';
                const m = tipoMeta(enc.tipo);

                S.pdfUrl = data.pdfUrl;
                S.xmlUrl = data.xmlUrl;

                // Header
                setText('md-folio', (enc.serie || '') + (enc.folio || '—'));
                setHtml('md-tipo-lbl',
                    `<span style="color:${m.color};font-family:'IBM Plex Mono',monospace;
                                      font-size:10px;letter-spacing:.1em;">
                            ● ${esc(m.label.toUpperCase())}
                         </span>`);

                // Fecha: soporta /Date(...)/ y ISO
                const fmtFecha = v => {
                    if (!v) return '—';
                    if (typeof dateFormatter === 'function' && /\/Date\(/.test(String(v)))
                        return dateFormatter(v);
                    const d = new Date(v);
                    return isNaN(d) ? v
                        : d.toLocaleDateString('es-MX', { day: '2-digit', month: 'short', year: 'numeric' });
                };
                setText('md-fecha', fmtFecha(enc.fecha));
                setText('md-fechatimbrado', fmtFecha(enc.fechatimbrado));
                setText('md-moneda', enc.moneda || '—');
                setHtml('md-estatus-hd', badgeEstatus(enc.statusfactura));

                // Totals
                setText('md-subtotal', fmtMoney(enc.subtotal, ccy));
                setText('md-descuento', fmtMoney(enc.descuento, ccy));
                setText('md-iva', fmtMoney(enc.iva, ccy));
                setText('md-total', fmtMoney(enc.total, ccy));
                setText('md-saldo', fmtMoney(enc.saldo, ccy));

                // Tab general
                setText('md-rsocliente', enc.rsocliente);
                setText('md-rfccliente', enc.rfccliente);
                setText('md-cpr', enc.cpr);
                setText('md-regfise', enc.reg_fise);
                setText('md-rsoemisor', enc.rsoemisor);
                setText('md-rfcemisor', enc.rfcemisor);
                setText('md-mdp', enc.mdpfactura);
                setText('md-usocfdi', `${enc.idusocfdi || ''} ${enc.usocfdi || ''}`);
                setText('md-obs', enc.observaciones);
                setText('md-ticket', enc.ticket);

                renderMdPartidas(data.partidas || [], ccy);
                renderMdRelacionadas(data.relacionadas || [], fmtFecha);

                const tieneAnt = (data.anticipos || []).length > 0;
                const btnAnt = $el('md-tab-anticipos-btn');
                if (btnAnt) btnAnt.style.display = tieneAnt ? '' : 'none';
                if (tieneAnt) renderMdAnticipos(data.anticipos, ccy, fmtFecha);

                setText('md-uuid', enc.uuid || 'Sin UUID — no timbrado');
                setText('md-sellocfdi', enc.sellocfdi || '—');
                setText('md-sellosat', enc.sellosat || '—');
                setText('md-cadena', enc.cadenaoriginal || '—');

                const qrEl = $el('md-qr');
                if (qrEl) { qrEl.src = data.qrUrl || ''; qrEl.style.display = data.qrUrl ? '' : 'none'; }

            } catch (e) { ncToast('Error de conexión: ' + e.message, 'err'); }
        }

        /* ══════════════════════════════════════════
           RENDER TABS
        ══════════════════════════════════════════ */
        function renderMdPartidas(partidas, ccy) {
            const tbody = $el('md-partidas-body');
            if (!partidas.length) {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align:center;padding:20px;
                        color:var(--slate-400);">Sin partidas registradas</td></tr>`;
                return;
            }
            tbody.innerHTML = partidas.map(p => `
                <tr>
                    <td class="pt-c" style="font-size:10px;color:var(--slate-400);">
                        ${esc(p.claveprod || p.claveprodserv || '—')}
                    </td>
                    <td class="pt-desc">
                        ${esc(p.descripcion || '—')}
                        ${p.lote && p.lote !== '-' ? `<small>Lote: ${esc(p.lote)}</small>` : ''}
                        ${p.comentario ? `<small style="color:var(--info);">${esc(p.comentario)}</small>` : ''}
                    </td>
                    <td class="pt-c">${Number(p.cantidad || 0).toFixed(2)}</td>
                    <td class="pt-r">${fmtMoney(p.precio, ccy)}</td>
                    <td class="pt-r">${fmtMoney(p.descuento, ccy)}</td>
                    <td class="pt-r" style="font-weight:600;">${fmtMoney(p.importe_total, ccy)}</td>
                    <td class="pt-c" style="color:var(--purple);">
                        ${(p.cant_ndc || 0) > 0
                    ? Number(p.cant_ndc).toFixed(2)
                    : '<span style="color:var(--slate-300)">—</span>'}
                    </td>
                    <td style="font-family:'IBM Plex Mono',monospace;font-size:10px;color:var(--slate-400);">
                        ${esc(p.udm || '—')}
                    </td>
                </tr>`).join('');
        }

        function renderMdRelacionadas(rels, fmtFecha) {
            const body = $el('md-relacionadas-body');
            if (!rels.length) {
                body.innerHTML = `<p style="color:var(--slate-400);font-size:12px;padding:8px 0;">
                        Sin facturas de origen vinculadas.</p>`;
                return;
            }
            body.innerHTML = rels.map(r => `
                <div class="rel-row">
                    <div class="flex-grow-1">
                        <div class="rel-folio">${esc((r.serie || '') + (r.folio || '—'))}</div>
                        <div class="rel-meta">
                            ${fmtFecha(r.fecha)}
                            &nbsp;·&nbsp; Total: ${fmtMoney(r.total)}
                            &nbsp;·&nbsp; Saldo: ${fmtMoney(r.saldo)}
                            &nbsp;·&nbsp; Tipo relación: <strong>${esc(r.tipo_relacion)}</strong>
                        </div>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-shrink-0">
                        ${badgeEstatus(r.statusfactura)}
                        <button class="btn-nc btn-nc-outline btn-nc-sm"
                                onclick="verFacturaOrigen('${esc(r.uuid || '')}')"
                                title="Abrir factura origen">
                            <i class="fas fa-external-link-alt"></i>
                            <span class="d-none d-sm-inline">Ver factura</span>
                        </button>
                    </div>
                </div>`).join('');
        }

        function renderMdAnticipos(ants, ccy, fmtFecha) {
            const body = $el('md-anticipos-body');
            body.innerHTML = ants.map(a => `
                <div class="antic-row">
                    <div class="antic-folio">
                        <i class="fas fa-coins me-2"></i>
                        Anticipo: <strong>${esc(a.anticipo_folio || '—')}</strong>
                        <span class="nc-badge nb-warn ms-2">${esc(a.tipo_aplicacion || '—')}</span>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 col-sm-3">
                            <div class="antic-field"><label>Monto acreditado</label>
                                <span>${fmtMoney(a.monto_acreditado, ccy)}</span></div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="antic-field"><label>Saldo antes</label>
                                <span>${fmtMoney(a.saldo_anticipo_antes, ccy)}</span></div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="antic-field"><label>Saldo después</label>
                                <span>${fmtMoney(a.saldo_anticipo_despues, ccy)}</span></div>
                        </div>
                        <div class="col-6 col-sm-3">
                            <div class="antic-field"><label>Fecha aplicación</label>
                                <span>${fmtFecha(a.fecha_aplicacion)}</span></div>
                        </div>
                    </div>
                    ${a.observaciones
                    ? `<div class="mt-2" style="font-size:11px;color:#92400e;">${esc(a.observaciones)}</div>`
                    : ''}
                </div>`).join('');
        }

        /* ══════════════════════════════════════════
           TABS DEL MODAL
        ══════════════════════════════════════════ */
        function showMdTab(tabId, btn) {
            document.querySelectorAll('.md-tab-panel').forEach(p => p.classList.remove('active'));
            document.querySelectorAll('.md-tab-btn').forEach(b => b.classList.remove('active'));
            $el(tabId)?.classList.add('active');
            document.querySelector(`.md-tab-btn[onclick*="${tabId}"]`)?.classList.add('active');
        }

        /* ══════════════════════════════════════════
           ACCIONES
        ══════════════════════════════════════════ */
        function descargarArchivo(tipo) {
            const url = tipo === 'pdf' ? S.pdfUrl : S.xmlUrl;
            if (!url) { ncToast(`Archivo ${tipo.toUpperCase()} no disponible`, 'err'); return; }
            const a = document.createElement('a');
            a.href = url; a.download = ''; a.target = '_blank'; a.click();
            ncToast(`Descargando ${tipo.toUpperCase()}...`, 'info');
        }

        function verFacturaOrigen(uuid) {
            if (!uuid) { ncToast('UUID no disponible', 'err'); return; }
            window.open(`/ConsultaFacturas/Index?uuid=${uuid}`, '_blank');
        }

        function copiarUUID() {
            const uuid = $el('md-uuid')?.textContent?.trim();
            if (!uuid || uuid === '—') { ncToast('Sin UUID disponible', 'err'); return; }
            navigator.clipboard.writeText(uuid)
                .then(() => ncToast('UUID copiado al portapapeles', 'ok'))
                .catch(() => ncToast('No se pudo copiar', 'err'));
        }
    </script>
}