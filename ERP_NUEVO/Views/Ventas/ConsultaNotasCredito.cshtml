                <button class="btn-nc btn-nc-ghost" onclick="limpiarFiltros()">
                    <i class="fas fa-eraser"></i> Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- createTable inyecta aquí su HTML completo -->
    <div id="tabla-nc"></div>

</div><!-- /nc-body -->
