@{
    ViewBag.Title = "Consulta de Notas de Crédito";
    ViewBag.PageTitle = "Notas de Crédito";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Syne:wght@500;600;700;800&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link href="~/content/TableBuilder.css" rel="stylesheet" />
    <style>
        /* ═══════════════════════════════════════════════════════════
           DESIGN SYSTEM — Consulta NC
        ═══════════════════════════════════════════════════════════ */
        :root {
            --navy: #0b1829;
            --navy-2: #152337;
            --navy-3: #1e3450;
            --amber: #f59e0b;
            --amber-lt: #fef3c7;
            --amber-md: #fde68a;
            --ok: #10b981;
            --ok-lt: #d1fae5;
            --danger: #ef4444;
            --danger-lt: #fee2e2;
            --info: #3b82f6;
            --info-lt: #dbeafe;
            --purple: #8b5cf6;
            --purple-lt: #ede9fe;
            --slate-50: #f8fafc;
            --slate-100: #f1f5f9;
            --slate-200: #e2e8f0;
            --slate-300: #cbd5e1;
            --slate-400: #94a3b8;
            --slate-600: #475569;
            --ink: #0f172a;
            --white: #ffffff;
            --mono: 'IBM Plex Mono', monospace;
            --display: 'Syne', sans-serif;
            --body: 'DM Sans', sans-serif;
            --radius-sm: 4px;
            --radius: 8px;
            --radius-lg: 12px;
            --shadow-sm: 0 1px 3px rgba(11,24,41,.07), 0 2px 8px rgba(11,24,41,.05);
            --shadow: 0 2px 8px rgba(11,24,41,.08), 0 8px 24px rgba(11,24,41,.06);
            --shadow-lg: 0 8px 32px rgba(11,24,41,.16);
        }

        /* ─── PAGE HEADER ─────────────────────────────────────── */
        .nc-page-header {
            background: var(--navy);
            position: sticky;
            top: 0;
            z-index: 200;
            box-shadow: 0 2px 20px rgba(0,0,0,.3);
        }

        .nc-header-top {
            padding: 16px 24px 0;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            flex-wrap: wrap;
        }

        .nc-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nc-pill {
            background: var(--amber);
            color: var(--navy);
            font-family: var(--mono);
            font-size: 10px;
            font-weight: 600;
            padding: 4px 10px;
            border-radius: var(--radius-sm);
            letter-spacing: .1em;
            flex-shrink: 0;
        }

        .nc-page-title {
            font-family: var(--display);
            font-size: 20px;
            font-weight: 700;
            color: var(--white);
            letter-spacing: -.02em;
            line-height: 1.1;
        }

        .nc-page-sub {
            font-size: 11px;
            color: rgba(255,255,255,.38);
            font-family: var(--mono);
            margin-top: 1px;
        }

        /* KPI Strip */
        .kpi-strip {
            display: flex;
            overflow-x: auto;
            border-top: 1px solid rgba(255,255,255,.07);
            margin-top: 14px;
            scrollbar-width: none;
        }

            .kpi-strip::-webkit-scrollbar {
                display: none;
            }

        .kpi-item {
            flex: 1;
            min-width: 120px;
            padding: 13px 20px 14px;
            border-right: 1px solid rgba(255,255,255,.05);
            transition: background .18s;
            cursor: default;
        }

            .kpi-item:last-child {
                border-right: none;
            }

            .kpi-item:hover {
                background: rgba(255,255,255,.04);
            }

        .kpi-label {
            font-family: var(--mono);
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: rgba(255,255,255,.32);
            margin-bottom: 4px;
        }

        .kpi-value {
            font-family: var(--mono);
            font-size: 17px;
            font-weight: 600;
            color: var(--white);
            line-height: 1;
            white-space: nowrap;
        }

            .kpi-value.v-amber {
                color: var(--amber);
            }

            .kpi-value.v-ok {
                color: #34d399;
            }

            .kpi-value.v-danger {
                color: #f87171;
            }

        .kpi-sub {
            font-size: 9.5px;
            color: rgba(255,255,255,.25);
            font-family: var(--mono);
            margin-top: 3px;
        }

        /* ─── LAYOUT BODY ─────────────────────────────────────── */
        .nc-body {
            padding: 24px;
        }

        /* ─── FILTER CARD ─────────────────────────────────────── */
        .filter-card {
            background: var(--white);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-lg);
            padding: 18px 20px 16px;
            box-shadow: var(--shadow-sm);
            margin-bottom: 20px;
        }

        .filter-card-title {
            font-family: var(--mono);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--slate-400);
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nc-label {
            display: block;
            font-family: var(--mono);
            font-size: 9.5px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-600);
            margin-bottom: 5px;
        }

        .nc-input, .nc-select {
            width: 100%;
            padding: 8px 10px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-sm);
            font-family: var(--body);
            font-size: 12px;
            background: var(--white);
            outline: none;
            transition: border-color .18s, box-shadow .18s;
            height: 36px;
        }

            .nc-input:focus, .nc-select:focus {
                border-color: var(--amber);
                box-shadow: 0 0 0 3px rgba(245,158,11,.14);
            }

            .nc-input::placeholder {
                color: var(--slate-400);
            }

        /* Botones */
        .btn-nc {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 8px 16px;
            border-radius: var(--radius-sm);
            font-family: var(--body);
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            border: none;
            transition: all .18s;
            white-space: nowrap;
            height: 36px;
        }

        .btn-nc-primary {
            background: var(--navy);
            color: var(--white);
        }

            .btn-nc-primary:hover {
                background: var(--navy-2);
            }

        .btn-nc-ghost {
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
        }

            .btn-nc-ghost:hover {
                background: var(--slate-200);
            }

        .btn-nc-amber {
            background: var(--amber);
            color: var(--navy);
        }

            .btn-nc-amber:hover {
                filter: brightness(.93);
            }

        .btn-nc-outline {
            background: transparent;
            color: var(--slate-600);
            border: 1px solid var(--slate-300);
        }

            .btn-nc-outline:hover {
                border-color: var(--navy);
                color: var(--navy);
            }

        .btn-nc-sm {
            padding: 5px 12px;
            font-size: 11px;
            height: 30px;
        }

        /* ─── Badges reutilizables ────────────────────────────── */
        .nc-badge {
            display: inline-flex;
            align-items: center;
            gap: 3px;
            font-family: var(--mono);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 20px;
            white-space: nowrap;
        }

        .nb-ok {
            background: var(--ok-lt);
            color: #065f46;
        }

        .nb-warn {
            background: var(--amber-lt);
            color: #92400e;
        }

        .nb-danger {
            background: var(--danger-lt);
            color: #991b1b;
        }

        .nb-info {
            background: var(--info-lt);
            color: #1e40af;
        }

        .nb-purple {
            background: var(--purple-lt);
            color: #5b21b6;
        }

        .nb-ghost {
            background: var(--slate-100);
            color: var(--slate-600);
            border: 1px solid var(--slate-200);
        }

        .tipo-dot::before {
            content: '●';
            margin-right: 5px;
            font-size: 8px;
        }

        /* Saldo mini bar */
        .saldo-bar {
            height: 3px;
            background: var(--slate-200);
            border-radius: 2px;
            margin-top: 3px;
            overflow: hidden;
        }

        .saldo-fill {
            height: 100%;
            border-radius: 2px;
            transition: width .3s;
        }

        /* ═══════════════════════════════════════════════════════════
           MODAL DETALLE
        ═══════════════════════════════════════════════════════════ */
        #modal-detalle .modal-dialog {
            max-width: 960px;
        }

        #modal-detalle .modal-content {
            border: none;
            border-radius: var(--radius-lg);
            overflow: hidden;
            box-shadow: var(--shadow-lg);
        }

        .md-head {
            background: var(--navy);
            padding: 20px 24px 0;
        }

        .md-head-top {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 12px;
            padding-bottom: 16px;
        }

        .md-folio {
            font-family: var(--mono);
            font-size: 22px;
            font-weight: 600;
            color: var(--white);
            line-height: 1;
        }

        .md-tipo-lbl {
            font-family: var(--mono);
            font-size: 10px;
            letter-spacing: .1em;
            text-transform: uppercase;
            margin-top: 5px;
        }

        .md-meta {
            display: flex;
            gap: 20px;
            flex-wrap: wrap;
            margin-top: 8px;
        }

        .md-meta-item {
            font-size: 10px;
            color: rgba(255,255,255,.4);
            font-family: var(--mono);
        }

            .md-meta-item strong {
                display: block;
                color: rgba(255,255,255,.8);
                font-size: 11px;
                margin-top: 1px;
            }

        .md-close {
            background: rgba(255,255,255,.1);
            border: none;
            color: rgba(255,255,255,.6);
            width: 32px;
            height: 32px;
            border-radius: 6px;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            transition: all .15s;
            flex-shrink: 0;
        }

            .md-close:hover {
                background: rgba(255,255,255,.18);
                color: var(--white);
            }

        /* Totals strip */
        .md-totals {
            display: flex;
            background: var(--navy-3);
            border-top: 1px solid rgba(255,255,255,.06);
            overflow-x: auto;
            scrollbar-width: none;
        }

            .md-totals::-webkit-scrollbar {
                display: none;
            }

        .mdt-item {
            flex: 1;
            min-width: 100px;
            padding: 11px 16px;
            border-right: 1px solid rgba(255,255,255,.05);
            text-align: right;
        }

            .mdt-item:last-child {
                border-right: none;
            }

        .mdt-lbl {
            font-family: var(--mono);
            font-size: 8px;
            font-weight: 600;
            letter-spacing: .1em;
            text-transform: uppercase;
            color: rgba(255,255,255,.3);
            margin-bottom: 3px;
        }

        .mdt-val {
            font-family: var(--mono);
            font-size: 14px;
            font-weight: 600;
            color: var(--white);
            white-space: nowrap;
        }

            .mdt-val.v-amber {
                color: var(--amber);
            }

            .mdt-val.v-ok {
                color: #34d399;
            }

        /* Modal tabs */
        .md-tabs {
            display: flex;
            background: var(--slate-100);
            border-bottom: 1px solid var(--slate-200);
            overflow-x: auto;
            scrollbar-width: none;
        }

            .md-tabs::-webkit-scrollbar {
                display: none;
            }

        .md-tab-btn {
            padding: 11px 18px;
            font-family: var(--mono);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-400);
            border: none;
            background: transparent;
            border-bottom: 2px solid transparent;
            cursor: pointer;
            white-space: nowrap;
            transition: all .15s;
        }

            .md-tab-btn:hover {
                color: var(--ink);
            }

            .md-tab-btn.active {
                color: var(--navy);
                border-bottom-color: var(--amber);
                background: var(--white);
            }

        .md-tab-panel {
            display: none;
            padding: 22px 24px;
        }

            .md-tab-panel.active {
                display: block;
            }

        /* Section titles */
        .md-sec {
            font-family: var(--mono);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
            color: var(--slate-400);
            padding-bottom: 7px;
            border-bottom: 1px solid var(--slate-200);
            margin-bottom: 14px;
            margin-top: 18px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .md-sec:first-child {
                margin-top: 0;
            }

        /* Info items */
        .md-info-item label {
            font-family: var(--mono);
            font-size: 9px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--slate-400);
            display: block;
            margin-bottom: 2px;
        }

        .md-info-item span {
            font-size: 12px;
            font-weight: 500;
        }

            .md-info-item span.mono {
                font-family: var(--mono);
                font-size: 11px;
            }

        /* Partidas table */
        .pt-tbl {
            width: 100%;
            border-collapse: collapse;
            font-size: 11px;
        }

            .pt-tbl thead th {
                background: var(--navy);
                color: rgba(255,255,255,.45);
                padding: 7px 10px;
                font-family: var(--mono);
                font-size: 8px;
                letter-spacing: .1em;
                text-transform: uppercase;
                font-weight: 600;
                text-align: left;
            }

                .pt-tbl thead th.r {
                    text-align: right;
                }

                .pt-tbl thead th.c {
                    text-align: center;
                }

            .pt-tbl tbody td {
                padding: 8px 10px;
                border-bottom: 1px solid var(--slate-100);
                vertical-align: top;
            }

            .pt-tbl tbody tr:last-child td {
                border-bottom: none;
            }

            .pt-tbl tbody tr:nth-child(even) {
                background: #fafbfd;
            }

        .pt-desc {
            font-weight: 500;
        }

            .pt-desc small {
                display: block;
                color: var(--slate-400);
                font-size: 9px;
                margin-top: 2px;
            }

        .pt-r {
            text-align: right;
            font-family: var(--mono);
        }

        .pt-c {
            text-align: center;
            font-family: var(--mono);
        }

        /* Relacionadas */
        .rel-row {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 12px;
            padding: 11px 14px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius);
            margin-bottom: 8px;
            background: var(--slate-50);
            transition: border-color .15s;
        }

            .rel-row:hover {
                border-color: var(--amber);
            }

        .rel-folio {
            font-family: var(--mono);
            font-weight: 600;
            font-size: 13px;
            color: var(--navy);
        }

        .rel-meta {
            font-size: 11px;
            color: var(--slate-600);
            margin-top: 2px;
        }

        /* Anticipos */
        .antic-row {
            border: 1px solid var(--amber-md);
            border-radius: var(--radius);
            padding: 13px 15px;
            margin-bottom: 10px;
            background: var(--amber-lt);
        }

        .antic-folio {
            font-family: var(--mono);
            font-weight: 600;
            color: #92400e;
            font-size: 12px;
            margin-bottom: 10px;
        }

        .antic-field label {
            font-family: var(--mono);
            font-size: 8.5px;
            font-weight: 600;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: #a16207;
            display: block;
            margin-bottom: 2px;
        }

        .antic-field span {
            font-family: var(--mono);
            font-size: 12px;
            color: #78350f;
            font-weight: 500;
        }

        /* Sellos */
        .sello-lbl {
            font-family: var(--mono);
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .08em;
            text-transform: uppercase;
            color: var(--slate-400);
            margin-top: 14px;
            margin-bottom: 5px;
        }

            .sello-lbl:first-child {
                margin-top: 0;
            }

        .sello-box {
            background: var(--slate-100);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-sm);
            padding: 9px 11px;
            font-family: var(--mono);
            font-size: 9.5px;
            color: var(--slate-600);
            word-break: break-all;
            white-space: pre-wrap;
            max-height: 80px;
            overflow-y: auto;
            line-height: 1.6;
        }

        .uuid-box {
            background: var(--slate-100);
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-sm);
            padding: 8px 11px;
            font-family: var(--mono);
            font-size: 10.5px;
            word-break: break-all;
            line-height: 1.5;
        }

        .qr-img {
            width: 110px;
            height: 110px;
            border: 1px solid var(--slate-200);
            border-radius: var(--radius-sm);
            background: var(--white);
            padding: 4px;
            object-fit: contain;
        }

        /* Toast */
        .toast-area {
            position: fixed;
            bottom: 20px;
            right: 20px;
            z-index: 9999;
            display: flex;
            flex-direction: column;
            gap: 8px;
            pointer-events: none;
        }

        .nc-toast {
            padding: 10px 16px;
            border-radius: var(--radius);
            font-size: 12px;
            font-family: var(--body);
            font-weight: 500;
            box-shadow: var(--shadow);
            display: flex;
            align-items: center;
            gap: 8px;
            min-width: 220px;
            max-width: 340px;
            pointer-events: auto;
            animation: toastIn .22s ease;
        }

        @@keyframes toastIn {
            from {
                transform: translateY(8px);
                opacity: 0
            }

            to {
                transform: translateY(0);
                opacity: 1
            }
        }

        .nc-toast.t-ok {
            background: var(--ok-lt);
            color: #065f46;
            border: 1px solid #6ee7b7;
        }

        .nc-toast.t-err {
            background: var(--danger-lt);
            color: #991b1b;
            border: 1px solid #fca5a5;
        }

        .nc-toast.t-inf {
            background: var(--info-lt);
            color: #1e40af;
            border: 1px solid #93c5fd;
        }

        /* Responsive */
        @@media (max-width: 576px) {
            .nc-body {
                padding: 12px;
            }

            .nc-header-top {
                padding: 12px 16px 0;
            }

            .kpi-item {
                min-width: 100px;
                padding: 10px 14px 11px;
            }

            .kpi-value {
                font-size: 14px;
            }

            #modal-detalle .modal-dialog {
                margin: 8px;
            }

            .md-tab-btn {
                padding: 10px 12px;
                font-size: 9px;
            }

            .md-tab-panel {
                padding: 16px;
            }

            .md-head {
                padding: 16px 16px 0;
            }
        }

        @@media (max-width: 768px) {
            .nc-page-title {
                font-size: 17px;
            }

            .filter-card {
                padding: 14px 14px 12px;
            }
        }
    </style>
}

<!-- ══════════════════════════════════════════
     PAGE HEADER + KPI
══════════════════════════════════════════ -->
<div class="nc-page-header">
    <div class="nc-header-top">
        <div class="nc-brand">
            <span class="nc-pill">NC</span>
            <div>
                <div class="nc-page-title">Notas de Crédito</div>
                <div class="nc-page-sub">Consulta · Detalle · Documentos fiscales</div>
            </div>
        </div>
    </div>
    <div class="kpi-strip">
        <div class="kpi-item">
            <div class="kpi-label">Total NCs</div>
            <div class="kpi-value" id="kpi-total">—</div>
            <div class="kpi-sub">documentos</div>
        </div>
        <div class="kpi-item">
            <div class="kpi-label">Monto Emitido</div>
            <div class="kpi-value v-amber" id="kpi-monto">—</div>
            <div class="kpi-sub">MXN</div>
        </div>
        <div class="kpi-item">
            <div class="kpi-label">Devoluciones</div>
            <div class="kpi-value" id="kpi-dev">—</div>
            <div class="kpi-sub">monto</div>
        </div>
        <div class="kpi-item">
            <div class="kpi-label">Descuentos</div>
            <div class="kpi-value" id="kpi-desc">—</div>
            <div class="kpi-sub">monto</div>
        </div>
        <div class="kpi-item">
            <div class="kpi-label">Timbradas SAT</div>
            <div class="kpi-value v-ok" id="kpi-timbradas">—</div>
            <div class="kpi-sub">documentos</div>
        </div>
        <div class="kpi-item">
            <div class="kpi-label">Saldo Pendiente</div>
            <div class="kpi-value v-danger" id="kpi-saldo">—</div>
            <div class="kpi-sub">por aplicar CxC</div>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════
     BODY — FILTROS EXTRA + TABLA
══════════════════════════════════════════ -->
<div class="nc-body">

    <!-- Filtros adicionales al buscador de createTable -->
    <div class="filter-card">
        <div class="filter-card-title">
            <i class="fas fa-sliders-h"></i> Filtros de búsqueda
        </div>
        <div class="row g-2 mb-2">
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="nc-label">Folio NC</label>
                <input type="text" id="f-folio" class="nc-input"
                       placeholder="NC-0001..." />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="nc-label">Tipo de NC</label>
                <select id="f-tipo" class="nc-select">
                    <option value="">Todos los tipos</option>
                    <option value="DEVOLUCION">Devolución</option>
                    <option value="DESCUENTO">Descuento</option>
                    <option value="PRECIO">Error en Precio</option>
                    <option value="CANCELACION">Cancelación Parcial</option>
                    <option value="BONIFICACION">Bonificación / Rappel</option>
                    <option value="STANDALONE">Sin Referencia</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-1">
                <label class="nc-label">Estatus</label>
                <select id="f-estatus" class="nc-select">
                    <option value="">Todos</option>
                    <option value="TIMBRADA">Timbrada</option>
                    <option value="BORRADOR">Borrador</option>
                    <option value="CANCELADA">Cancelada</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="nc-label">Fecha desde</label>
                <input type="date" id="f-fecha-desde" class="nc-input" />
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label class="nc-label">Fecha hasta</label>
                <input type="date" id="f-fecha-hasta" class="nc-input" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 d-flex align-items-end gap-2">
                <button class="btn-nc btn-nc-primary" onclick="recargarTabla()">
                    <i class="fas fa-search"></i> Buscar
