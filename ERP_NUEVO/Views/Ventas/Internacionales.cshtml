@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfoGroup
@{
    ViewBag.Title = "Zonas";
    ViewBag.PageTitle = "Ventas Internacionales";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section styles {
    <style>
        /* ── WIZARD BAR ─────────────────────────────────────── */
        .vin-wizard-bar {
            display: flex;
            align-items: center;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.08);
            padding: 0 1.25rem;
            height: 52px;
            position: sticky;
            top: 0;
            z-index: 100;
            gap: 0;
        }

        .vin-wizard-steps-group {
            display: flex;
            align-items: center;
            gap: 0;
            flex: 1;
        }

        .vin-wizard-step {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0 1rem;
            height: 52px;
            cursor: pointer;
            border-bottom: 3px solid transparent;
            transition: border-color var(--transition-fast), color var(--transition-fast);
            user-select: none;
        }

            .vin-wizard-step:hover .vin-step-label {
                color: var(--accent-blue);
            }

            .vin-wizard-step.active {
                border-bottom-color: var(--accent-blue);
            }

                .vin-wizard-step.active .vin-step-num {
                    background: var(--accent-blue);
                    color: #fff;
                }

                .vin-wizard-step.active .vin-step-label {
                    color: var(--accent-blue);
                    font-weight: 600;
                }

            .vin-wizard-step.done .vin-step-num {
                background: var(--success-color);
                color: #fff;
            }

            .vin-wizard-step.done .vin-step-label {
                color: rgba(255,255,255,.55);
            }

        .vin-step-num {
            width: 24px;
            height: 24px;
            border-radius: 50%;
            background: rgba(255,255,255,.12);
            color: rgba(255,255,255,.6);
            font-size: 0.75rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            transition: background var(--transition-fast), color var(--transition-fast);
        }

        .vin-step-label {
            font-size: 0.82rem;
            font-weight: 500;
            color: rgba(255,255,255,.45);
            transition: color var(--transition-fast);
            white-space: nowrap;
        }

        .vin-wizard-divider {
            width: 24px;
            height: 1px;
            background: rgba(255,255,255,.15);
            flex-shrink: 0;
            margin: 0 0.25rem;
        }

        /* ── RESUMEN DROPDOWN EN WIZARD BAR ─────────────────── */
        .vin-wb-resumen {
            position: relative;
            margin-left: auto;
        }

        .vin-wb-resumen-btn {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.35rem 0.85rem;
            border-radius: 7px;
            background: rgba(255,255,255,.08);
            border: 1px solid rgba(255,255,255,.12);
            color: rgba(255,255,255,.75);
            font-size: 0.8rem;
            font-weight: 500;
            cursor: pointer;
            transition: background var(--transition-fast), border-color var(--transition-fast);
            white-space: nowrap;
        }

            .vin-wb-resumen-btn:hover {
                background: rgba(255,255,255,.13);
                border-color: rgba(255,255,255,.2);
            }

            .vin-wb-resumen-btn i.chevron {
                font-size: 0.65rem;
                transition: transform var(--transition-med);
                color: rgba(255,255,255,.4);
            }

            .vin-wb-resumen-btn.open i.chevron {
                transform: rotate(180deg);
            }

        .vin-wb-resumen-dot {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--success-color);
            flex-shrink: 0;
        }

        .vin-wb-dropdown {
            display: none;
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 240px;
            background: var(--primary-blue);
            border: 1px solid rgba(255,255,255,.1);
            border-radius: var(--table-radius);
            box-shadow: var(--shadow-lg);
            z-index: 200;
            overflow: hidden;
        }

            .vin-wb-dropdown.open {
                display: block;
            }

        .vin-wb-dd-header {
            background: var(--primary-blue-dark);
            padding: 0.75rem 1rem;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,.08);
        }

        .vin-wb-dd-title {
            font-size: 0.78rem;
            font-weight: 700;
            color: rgba(255,255,255,.9);
            letter-spacing: .04em;
            text-transform: uppercase;
            display: flex;
            align-items: center;
            gap: 6px;
        }

            .vin-wb-dd-title i {
                color: var(--warning-color);
                font-size: 0.7rem;
            }

        .vin-wb-dd-badge {
            font-size: 0.62rem;
            font-weight: 700;
            padding: 2px 7px;
            border-radius: var(--badge-radius);
            background: rgba(255,255,255,.1);
            color: rgba(255,255,255,.6);
            letter-spacing: .05em;
        }

        .vin-wb-dd-body {
            padding: 0.75rem 1rem;
            display: flex;
            flex-direction: column;
            gap: 0.6rem;
        }

        .vin-wb-dd-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.78rem;
        }

        .vin-wb-dd-lbl {
            color: rgba(255,255,255,.4);
        }

        .vin-wb-dd-val {
            color: rgba(255,255,255,.85);
            font-weight: 500;
            text-align: right;
        }

        .vin-wb-dd-sep {
            height: 1px;
            background: rgba(255,255,255,.07);
        }

        .vin-wb-dd-step-row {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 0.5rem 0.75rem;
            border-radius: 7px;
            background: rgba(255,255,255,.05);
        }

        .vin-wb-dd-step-num {
            width: 26px;
            height: 26px;
            border-radius: 50%;
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.8rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
        }

        .vin-wb-dd-step-name {
            font-size: 0.8rem;
            font-weight: 600;
            color: rgba(255,255,255,.85);
        }

        .vin-wb-dd-step-sub {
            font-size: 0.7rem;
            color: rgba(255,255,255,.4);
        }

        .vin-wb-dd-footer {
            padding: 0.6rem 1rem;
            border-top: 1px solid rgba(255,255,255,.08);
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .vin-wb-dd-btn-primary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.48rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 600;
            background: var(--accent-blue);
            color: #fff;
            border: none;
            cursor: pointer;
            transition: opacity var(--transition-fast);
        }

            .vin-wb-dd-btn-primary:hover {
                opacity: .88;
            }

        .vin-wb-dd-btn-secondary {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            width: 100%;
            padding: 0.44rem;
            border-radius: 7px;
            font-size: 0.78rem;
            font-weight: 500;
            background: transparent;
            color: rgba(255,255,255,.5);
            border: 1px solid rgba(255,255,255,.1);
            cursor: pointer;
            transition: background var(--transition-fast);
        }

            .vin-wb-dd-btn-secondary:hover {
                background: rgba(255,255,255,.07);
                color: rgba(255,255,255,.75);
            }

        /* ── LAYOUT ─────────────────────────────────────────── */
        .vin-layout {
            padding: 1.5rem;
            max-width: 900px;
            margin: 0 auto;
            transition: max-width var(--transition-med);
        }

            /* Cuando estamos en paso 2 en adelante, ancho libre */
            .vin-layout.vin-layout--wide {
                max-width: unset;
            }

        /* ── PANEL ──────────────────────────────────────────── */
        .vin-panel {
            display: none;
        }

            .vin-panel.active {
                display: block;
            }

        /* ── SECTION CARD ───────────────────────────────────── */
        .vin-section-card {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            border-radius: var(--table-radius);
            margin-bottom: 1.25rem;
            overflow: hidden;
            box-shadow: var(--shadow);
        }

        .vin-section-head {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border-light);
        }

        .vin-section-icon {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--very-light-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--accent-blue);
            font-size: 0.95rem;
            flex-shrink: 0;
        }

        .vin-section-title {
            font-size: 0.93rem;
            font-weight: 600;
            color: var(--text-dark);
            margin: 0;
        }

        .vin-section-sub {
            font-size: 0.78rem;
            color: var(--text-light);
            margin: 0;
        }

        .vin-section-body {
            padding: 1.25rem;
            background: var(--bg-gray);
        }

        /* ── PRODUCT CARDS ──────────────────────────────────── */
        .vin-type-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.875rem;
        }

        .vin-type-card {
            background: var(--primary-blue-dark);
            border: 1.5px solid var(--primary-blue);
            border-radius: var(--table-radius);
            padding: 1.1rem 1.15rem;
            cursor: pointer;
            position: relative;
            overflow: hidden;
            transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
        }

            .vin-type-card:hover {
                border-color: var(--accent-blue);
                transform: translateY(-2px);
                box-shadow: 0 6px 20px rgba(59,130,246,.18);
            }

            .vin-type-card.selected {
                border-color: var(--accent-blue);
                background: var(--dark-blue);
                box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            }

            .vin-type-card input[type="radio"] {
                position: absolute;
                opacity: 0;
                pointer-events: none;
            }

        .vin-card-icon-sm {
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--primary-blue);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 0.7rem;
            transition: background var(--transition-fast);
        }

        .vin-type-card.selected .vin-card-icon-sm {
            background: var(--accent-blue);
        }

        .vin-card-icon-sm svg {
            fill: var(--accent-blue);
            transition: fill var(--transition-fast);
        }

        .vin-type-card.selected .vin-card-icon-sm svg {
            fill: #fff;
        }

        .vin-card-title {
            font-size: 0.88rem;
            font-weight: 600;
            color: #f9fafb;
            margin-bottom: 0.3rem;
        }

        .vin-card-desc {
            font-size: 0.76rem;
            color: var(--very-light-blue);
            line-height: 1.45;
            margin-bottom: 0.75rem;
        }

        .vin-card-chip {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            font-size: 0.7rem;
            font-weight: 600;
            padding: 3px 9px;
            border-radius: var(--badge-radius);
            letter-spacing: .02em;
        }

        .vin-chip-oferta {
            background: rgba(249,115,22,.15);
            color: #fb923c;
        }
        .vin-chip-asistida {
            background: rgba(14,165,233,.15);
            color: #38bdf8;
        }

        .vin-chip-produccion {
            background: rgba(139,92,246,.15);
            color: var(--accent-purple);
        }

        .vin-chip-entrega {
            background: rgba(236,72,153,.15);
            color: #f472b6;
        }

        .vin-chip-cobro {
            background: rgba(16,185,129,.15);
            color: var(--success-color);
        }

        .vin-card-check {
            position: absolute;
            top: 0.7rem;
            right: 0.8rem;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            background: var(--accent-blue);
            display: none;
            align-items: center;
            justify-content: center;
        }

        .vin-type-card.selected .vin-card-check {
            display: flex;
        }

        .vin-card-check i {
            color: #fff;
            font-size: 0.6rem;
        }

        /* ── STEP NAV ───────────────────────────────────────── */
        .vin-step-nav {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            padding: 1rem 0 0;
            margin-top: 0.5rem;
            border-top: 1px solid var(--border-light);
        }

        .vin-btn-step {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 0.5rem 1.35rem;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            cursor: pointer;
            border: 1px solid var(--border-light);
            background: var(--bg-light);
            color: var(--text-dark);
            transition: background var(--transition-fast), border-color var(--transition-fast), color var(--transition-fast);
        }

            .vin-btn-step:hover {
                background: var(--very-light-blue);
                border-color: var(--accent-blue);
                color: var(--accent-blue);
            }

            .vin-btn-step.next {
                background: var(--primary-blue-dark);
                border-color: var(--primary-blue-dark);
                color: #fff;
            }

                .vin-btn-step.next:hover {
                    background: var(--accent-blue);
                    border-color: var(--accent-blue);
                }

            .vin-btn-step.finish {
                background: var(--success-color);
                border-color: var(--success-color);
                color: #fff;
            }

                .vin-btn-step.finish:hover {
                    opacity: .88;
                }

        /* ── TOP BAR ────────────────────────────────────────── */
        .vin-top-bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 0.65rem 1.25rem;
            background: var(--primary-blue-dark);
            border-bottom: 1px solid rgba(255,255,255,.07);
        }

        .vin-top-brand {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 600;
            font-size: 0.9rem;
            color: #f9fafb;
        }

        .vin-pill {
            background: var(--accent-blue);
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 5px;
            letter-spacing: .04em;
        }

        .vin-top-meta {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 0.78rem;
            color: rgba(255,255,255,.45);
        }

        .vin-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--success-color);
        }

        /* Contenedor parciales */
        #vin-step2-contenido .vin-partial-wrap {
            display: none;
        }

            #vin-step2-contenido .vin-partial-wrap.active {
                display: block;
            }

        /* ── RESPONSIVE ─────────────────────────────────────── */
        @@media (max-width: 700px) {
            .vin-type-grid {
                grid-template-columns: 1fr;
            }

            .vin-wizard-step .vin-step-label {
                display: none;
            }

            .vin-layout {
                padding: 1rem;
            }
        }
    </style>
}

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />

<!-- TOP BAR -->
<div class="vin-top-bar">
    <div class="vin-top-brand">
        <span class="vin-pill">VI</span>
        Ventas internacionales
    </div>
    <div class="vin-top-meta">
        <span class="vin-status-dot"></span>
        <span>NUEVO PROCESO</span>
        <span id="vin-tb-proceso">—</span>
    </div>
</div>

<!-- WIZARD BAR -->
<div class="vin-wizard-bar">
    <div class="vin-wizard-steps-group">
        <div class="vin-wizard-step active" data-step="1" onclick="viGotoStep(1)">
            <div class="vin-step-num">1</div>
            <span class="vin-step-label">Tipo de proceso</span>
        </div>
        <div class="vin-wizard-divider"></div>
        <div class="vin-wizard-step" data-step="2" onclick="viGotoStep(2)">
            <div class="vin-step-num">2</div>
            <span class="vin-step-label">Configuración</span>
        </div>
    </div>

    <!-- Resumen colapsado -->
    <div class="vin-wb-resumen">
        <button type="button" class="vin-wb-resumen-btn" id="vin-resumen-toggle" onclick="viToggleResumen()">
            <span class="vin-wb-resumen-dot"></span>
            <span>Resumen</span>
            <span id="vin-wb-tipo-mini">Sin seleccionar</span>
            <i class="fas fa-chevron-down chevron"></i>
        </button>
        <div class="vin-wb-dropdown" id="vin-wb-dropdown">
            <div class="vin-wb-dd-header">
                <div class="vin-wb-dd-title">
                    <i class="fas fa-industry"></i> Resumen VI
                </div>
                <span class="vin-wb-dd-badge">NUEVO</span>
            </div>
            <div class="vin-wb-dd-body">
                <div class="vin-wb-dd-row">
                    <span class="vin-wb-dd-lbl">Tipo de proceso</span>
                    <span class="vin-wb-dd-val" id="dd-tipo-name">Sin seleccionar</span>
                </div>
                <div class="vin-wb-dd-sep"></div>
                <div class="vin-wb-dd-row">
                    <span class="vin-wb-dd-lbl">Usuario</span>
                    <span class="vin-wb-dd-val" id="dd-vendedor">—</span>
                </div>
                <div class="vin-wb-dd-row">
                    <span class="vin-wb-dd-lbl">Sucursal</span>
                    <span class="vin-wb-dd-val" id="dd-sucursal">—</span>
                </div>
                <div class="vin-wb-dd-sep"></div>
                <div class="vin-wb-dd-step-row">
                    <div class="vin-wb-dd-step-num" id="dd-paso-num">1</div>
                    <div>
                        <div class="vin-wb-dd-step-name" id="dd-paso-name">Tipo de proceso</div>
                        <div class="vin-wb-dd-step-sub" id="dd-paso-sub">Selecciona el proceso internacional</div>
                    </div>
                </div>
            </div>
            <div class="vin-wb-dd-footer">
                <button type="button" class="vin-wb-dd-btn-primary" onclick="viEnviarFormulario()">
                    <i class="fas fa-paper-plane" style="font-size:11px"></i> Guardar y procesar
                </button>
                <button type="button" class="vin-wb-dd-btn-secondary" onclick="viGotoStep(1); viToggleResumen(true)">
                    <i class="fas fa-redo" style="font-size:10px"></i> Reiniciar selección
                </button>
            </div>
        </div>
    </div>
</div>

