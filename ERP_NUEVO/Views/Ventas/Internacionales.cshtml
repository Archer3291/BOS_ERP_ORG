                </div>
            </div>

            <div class="vin-step-nav" style="justify-content: space-between;">
                <button type="button" class="vin-btn-step" onclick="viGotoStep(1)">
                    <i class="fas fa-arrow-left"></i> Anterior
                </button>
                <button type="button" class="vin-btn-step finish" onclick="viEnviarFormulario()">
                    <i class="fas fa-paper-plane"></i> Guardar y procesar
                </button>
            </div>
