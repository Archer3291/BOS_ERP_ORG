                                <div class="vin-card-check"><i class="fas fa-check"></i></div>
                                <div class="vin-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14c-2.76 0-5-2.24-5-5s2.24-5 5-5 5 2.24 5 5-2.24 5-5 5z" />
                                        <path d="M12 9c-1.66 0-3 1.34-3 3s1.34 3 3 3 3-1.34 3-3-1.34-3-3-3zm0 4c-.55 0-1-.45-1-1s.45-1 1-1 1 .45 1 1-.45 1-1 1z" />
                                    </svg>
                                </div>
                                <div class="vin-card-title">Pedido internacional</div>
                                <div class="vin-card-desc">Órdenes de compra para maquinaria pesada con hitos de fabricación y certificaciones.</div>
                                <span class="vin-card-chip vin-chip-produccion">Etapa: producción</span>
                            </div>

                            <!-- Remisión internacional -->
                            <div class="vin-type-card" data-option="remision-internacional" onclick="viSelectCard(this)">
                                <input type="radio" value="remisioninternacionalV" class="proceso" name="proceso" id="remision-internacional" autocomplete="off" required>
                                <div class="vin-card-check"><i class="fas fa-check"></i></div>
                                <div class="vin-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M20 8h-3V4H3c-1.1 0-2 .9-2 2v11h2c0 1.66 1.34 3 3 3s3-1.34 3-3h6c0 1.66 1.34 3 3 3s3-1.34 3-3h2v-5l-3-4zM6 18.5c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zm13.5-9l1.96 2.5H17V9.5h2.5zm-1.5 9c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5z" />
                                    </svg>
                                </div>
                                <div class="vin-card-title">Remisión internacional</div>
                                <div class="vin-card-desc">Despacho de equipos con documentación técnica, manuales y certificados de calidad.</div>
                                <span class="vin-card-chip vin-chip-entrega">Etapa: entrega</span>
                            </div>

                            <!-- Facturación internacional -->
                            <div class="vin-type-card" data-option="facturacion-internacional" onclick="viSelectCard(this)">
                                <input type="radio" value="facturacioninternacionalV" class="proceso" name="proceso" id="facturacion-internacional" autocomplete="off" required>
                                <div class="vin-card-check"><i class="fas fa-check"></i></div>
                                <div class="vin-card-icon-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8l-6-6z" />
                                        <path d="M14 2v6h6M16 11a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-1a3 3 0 0 1 3-3h4a3 3 0 0 1 3 3v1z" />
