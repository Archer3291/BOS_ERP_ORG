                        </div><!-- /.vin-type-grid -->
                    </fieldset>
                </div>
            </div>

            <div class="vin-step-nav">
                <button type="button" class="vin-btn-step next" onclick="viGotoStep(2)">
                    Siguiente <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </div><!-- /#vin-panel-1 -->
        <!-- PASO 2 — contenedores parciales -->
        <div class="vin-panel" id="vin-panel-2">
            <div id="vin-step2-contenido">

                <div class="vin-partial-wrap" id="cotizacion-asistida-contenedor">
                    @Html.Partial("VentasInternacionales/_CotizacionInternacionalAsistida")
                </div>

                <div class="vin-partial-wrap" id="cotizacion-internacional-contenedor">
                   @* @Html.Partial("VentasInternacionales/_CotizacionInternacional")*@
                </div>

                <div class="vin-partial-wrap" id="pedido-internacional-contenedor">
                    @Html.Partial("VentasInternacionales/_PedidoInternacional", Model.ParcialA)
                </div>

                <div class="vin-partial-wrap" id="remision-internacional-contenedor">
                    @Html.Partial("VentasInternacionales/_Remisioninternacional", Model.ParcialB)
                </div>

                <div class="vin-partial-wrap" id="facturacion-internacional-contenedor">
                    @Html.Partial("Ventasinternacionales/_Facturainternacional", Model.ParcialC)
