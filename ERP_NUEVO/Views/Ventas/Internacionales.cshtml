    </form>
</div><!-- /.vin-layout -->

@section scripts {
    <script>
    const rol           = "@Utilities.GetUserRole(User.Identity.Name, "ERP_SRS")";
    const vendedor      = "@User.Identity.Name";
    const sucursal      = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    const sucursalText  = "@Utilities.GetSucursalName(User.Identity.Name)";
    const sucursalUsuario = @Convert.ToInt32(Context.Session.GetInt32("Sucursal"));
    let suc; let alm;
    </script>
    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/Scripts/General/general.js"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script src="~/Scripts/Ventas/Internacionales/partial-vin-cotizacion-asistida.js"></script>
    @*<script src="~/Scripts/Ventas/Internacionales/partial-vin-cotizacion.js"></script>*@
    <script src="~/Scripts/Ventas/Internacionales/partial-vin-pedido.js"></script>
    <script src="~/Scripts/Ventas/Internacionales/partial-vin-remision.js"></script>
    <script src="~/Scripts/Ventas/Internacionales/partial-vin-factura.js"></script>
    <script src="~/Scripts/Ventas/Internacionales/FacturasRemisionParcialesManager_VIN.js"></script>
    <script>
        /* ── CONFIG DE PASOS ──────────────────────────────── */
        const VI_STEPS = {
            1: { name: 'Tipo de proceso', sub: 'Selecciona el proceso internacional' },
            2: { name: 'Configuración', sub: 'Completa los datos del proceso' }
        };

        const VI_TIPOS = {
            cotizacioninternacionalV: { label: 'Cotización internacional', sub: 'Especificaciones y plazos', contenedor: 'cotizacion-internacional-contenedor' },
            cotizacionasistidaV: { label: 'Cotización asistida', sub: 'Guiada con validación y márgenes', contenedor: 'cotizacion-asistida-contenedor' },
            pedidointernacionalV: { label: 'Pedido internacional', sub: 'Órdenes y certificaciones', contenedor: 'pedido-internacional-contenedor' },
            remisioninternacionalV: { label: 'Remisión internacional', sub: 'Despacho con documentación', contenedor: 'remision-internacional-contenedor' },
            facturacioninternacionalV: { label: 'Facturación internacional', sub: 'Anticipos y retenciones', contenedor: 'facturacion-internacional-contenedor' }
        };

        let viCurrentStep = 1;

        /* ── ANCHO DEL LAYOUT POR PASO ────────────────────── */
        function viUpdateLayout(step) {
            const layout = document.getElementById('vin-layout');
            if (step >= 2) {
                layout.classList.add('vin-layout--wide');
            } else {
                layout.classList.remove('vin-layout--wide');
            }
        }

        /* ── DROPDOWN RESUMEN ─────────────────────────────── */
        function viToggleResumen(forceClose) {
            const btn = document.getElementById('vin-resumen-toggle');
            const dd = document.getElementById('vin-wb-dropdown');
            const isOpen = dd.classList.contains('open');
            if (forceClose || isOpen) {
                dd.classList.remove('open');
                btn.classList.remove('open');
            } else {
                dd.classList.add('open');
                btn.classList.add('open');
            }
        }

        // Cerrar dropdown al hacer clic fuera
        document.addEventListener('click', function (e) {
            const wrap = document.querySelector('.vin-wb-resumen');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('vin-wb-dropdown').classList.remove('open');
                document.getElementById('vin-resumen-toggle').classList.remove('open');
            }
        });

        /* ── NAVEGACIÓN ───────────────────────────────────── */
        function viGotoStep(targetStep) {
            if (targetStep > viCurrentStep) {
                if (!viValidateStep(viCurrentStep)) return;
            }

            document.querySelectorAll('.vin-panel').forEach((p, i) => {
                p.classList.toggle('active', i + 1 === targetStep);
            });

            document.querySelectorAll('.vin-wizard-step').forEach(s => {
                const n = parseInt(s.dataset.step);
                s.classList.remove('active', 'done');
                if (n === targetStep) s.classList.add('active');
                if (n < targetStep) s.classList.add('done');
            });

            viCurrentStep = targetStep;
            viUpdateLayout(targetStep);
            viUpdateSidebar();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        /* ── VALIDACIÓN ───────────────────────────────────── */
        function viValidateStep(step) {
            if (step === 1) {
                const sel = document.querySelector('input[name="proceso"]:checked');
                if (!sel) {
                    if (typeof toastMixin !== 'undefined') {
                        toastMixin.fire({ icon: 'error', title: 'Debes seleccionar el tipo de proceso internacional.' });
                    } else {
                        alert('Debes seleccionar el tipo de proceso internacional.');
                    }
                    return false;
                }
                return true;
            }
            if (step === 2) {
                if (typeof validarDatos === 'function') {
                    return validarDatos();
                }
            }
            return true;
        }

        /* ── SELECCIÓN DE CARD ────────────────────────────── */
        function viSelectCard(card) {
            document.querySelectorAll('.vin-type-card').forEach(c => c.classList.remove('selected'));
            card.classList.add('selected');

            const radio = card.querySelector('input[type="radio"]');
            if (radio) radio.checked = true;

            const valor = radio?.value;
            document.querySelectorAll('.vin-partial-wrap').forEach(w => w.classList.remove('active'));
            if (valor && VI_TIPOS[valor]) {
                document.getElementById(VI_TIPOS[valor].contenedor)?.classList.add('active');
            }

            document.getElementById('vin-tb-proceso').textContent = VI_TIPOS[valor]?.label ?? '—';
            viUpdateSidebar();
        }

        /* ── ACTUALIZAR RESUMEN ───────────────────────────── */
        function viUpdateSidebar() {
            const paso = VI_STEPS[viCurrentStep];
            const sel = document.querySelector('input[name="proceso"]:checked');
            const tipoLabel = sel && VI_TIPOS[sel.value] ? VI_TIPOS[sel.value].label : 'Sin seleccionar';

            document.getElementById('vin-wb-tipo-mini').textContent = tipoLabel;
            document.getElementById('dd-paso-num').textContent = viCurrentStep;
            document.getElementById('dd-paso-name').textContent = paso?.name ?? '—';
            document.getElementById('dd-paso-sub').textContent = paso?.sub ?? '';
            document.getElementById('dd-vendedor').textContent = vendedor ?? '—';
            document.getElementById('dd-sucursal').textContent = sucursalText ?? '—';
            document.getElementById('dd-tipo-name').textContent = tipoLabel;
        }

              /* ── INIT ─────────────────────────────────────────── */
        viUpdateSidebar();
        viUpdateLayout(viCurrentStep);
    </script>
}