@model BOS_ERP.Models.Factura
@using BOS_ERP.Controllers
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <style>
        body {
            font-family: 'Segoe UI', Calibri, Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.3;
            letter-spacing: 0.5px;
            margin: 0;
            padding: 0;
        }

        .header-container {
            width: 100%;
            border: 1px solid #e0e0e0;
            border-bottom: 3px solid #d32f2f;
            padding: 10px;
            margin-bottom: 2px;
            background: #fafafa;
        }

        .header-table {
            width: 100%;
            border-collapse: collapse;
        }

        .logo-cell {
            width: 18%;
            vertical-align: middle;
            padding-right: 8px;
            text-align: center;
        }

            .logo-cell img {
                width: 100px;
                max-height: 75px;
                display: block;
                margin: 0 auto;
                border-radius: 3px;
            }

        .emisor-cell {
            width: 50%;
            vertical-align: middle;
            padding: 0 10px;
            border-left: 2px solid #e0e0e0;
            border-right: 2px solid #e0e0e0;
        }

        .factura-cell {
            width: 32%;
            vertical-align: middle;
            padding: 8px 10px;
            background: #f5f5f5;
            border-radius: 3px;
        }

        .header-title {
            font-size: 13px;
            font-weight: bold;
            color: #d32f2f;
            margin: 0 0 6px 0;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .refact-badge {
            display: inline-block;
            font-size: 7.5px;
            font-weight: bold;
            color: #fff;
            background: #d32f2f;
            border-radius: 3px;
            padding: 1px 5px;
            margin-left: 4px;
            vertical-align: middle;
        }

        .emisor-info,
        .factura-info {
            font-size: 8px;
            line-height: 1.6;
        }

            .emisor-info div,
            .factura-info div {
                margin: 2px 0;
            }

            .emisor-info strong {
                color: #1976d2;
                font-weight: bold;
                display: inline-block;
                min-width: 90px;
            }

            .factura-info strong {
                color: #555;
                font-weight: bold;
                display: inline-block;
                min-width: 70px;
            }

        .uuid-highlight {
            background: white;
            padding: 4px 6px;
            border-radius: 2px;
            margin-top: 6px;
            font-size: 7.5px;
            word-break: break-all;
            border-left: 3px solid #1976d2;
            box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        }

            .uuid-highlight strong {
                color: #1976d2;
                min-width: auto;
            }
    </style>
</head>
<body>
    <div class="header-container">
        <table class="header-table">
            <tr>
                @{
                    // Logo incrustado como base64 (sin red): wkhtmltopdf lo pinta directo y no se
                    // cuelga trayéndolo por HTTP/HTTPS ni requiere --enable-local-file-access.
                    var empresaFactura = Context.Session.GetString("EmpresaFactura") ?? "";
                    var logoFisico = System.IO.Path.Combine(Env.WebRootPath, "content", "img", empresaFactura, "logo.png");
                    var logoSrc = System.IO.File.Exists(logoFisico)
                        ? "data:image/png;base64," + Convert.ToBase64String(System.IO.File.ReadAllBytes(logoFisico))
                        : "";
                }
                <!-- Logo -->
                <td class="logo-cell">
                    @if (!string.IsNullOrEmpty(logoSrc))
                    {
                        <img src="@logoSrc" alt="Logo" />
                    }
                </td>

                <!-- Datos del Emisor -->
                <td class="emisor-cell">
                    <div class="header-title">
                        Comprobante Fiscal Digital
                        <span class="refact-badge">CFDI SUSTITUTO</span>
                    </div>
                    <div class="emisor-info">
                        <div><strong>RFC:</strong> @Model.RfcEmisor</div>
                        <div><strong>Razón Social:</strong> @Model.RsoEmisor</div>
                        <div><strong>Régimen Fiscal:</strong> @Model.Rege @(string.IsNullOrEmpty(Model.regimenEText) ? "" : "-- " + Model.regimenEText)</div>
                        <div><strong>Lugar Expedición:</strong> @Model.LugarExpedicion</div>
                    </div>
                </td>

                <!-- Datos de la Factura -->
                <td class="factura-cell">
                    <div class="factura-info">
                        <div><strong>Fecha:</strong> @Model.Fecha.ToString("dd/MM/yyyy HH:mm")</div>
                        <div><strong>Tipo:</strong> @Model.TipoDeComprobante</div>
                        <div><strong>Serie:</strong> @Model.Serie</div>
                        <div><strong>Folio:</strong> @Model.Folio</div>
                        @if (!string.IsNullOrEmpty(Model.Oc))
                        {
                            <div><strong>Orden de Compra:</strong> @Model.Oc</div>
                        }
                    </div>
                    <div class="uuid-highlight">
                        <strong>Folio Fiscal:</strong> @Model.UUID
                    </div>
                </td>
            </tr>
        </table>
    </div>
</body>
</html>
