@using BOS_ERP.Controllers
<style>

    /* ===== LAYOUT DE PÁGINA ===== */
    .vn-page {
        background: var(--bg-gray);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    /* ===== TARJETA PRINCIPAL ===== */
    .vn-card {
        background: var(--bg-light);
        border-radius: var(--table-radius);
        border: 1px solid var(--border-light);
        box-shadow: var(--shadow-lg);
        overflow: hidden;
    }

    /* ===== CABECERA DE SECCIÓN ===== */
    .vn-section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-bottom: .75rem;
        border-bottom: 2px solid var(--light-blue);
        margin-bottom: 1.25rem;
    }

    .vn-section-icon {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 10px;
        background: var(--primary-blue);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .vn-section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--text-dark);
        margin: 0;
    }

    /* ===== CAMPOS DE FORMULARIO ===== */
    .vn-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--secondary-blue);
        margin-bottom: .3rem;
        display: block;
    }

        .vn-label i {
            color: var(--accent-blue);
            margin-right: .3rem;
        }

    .vn-control {
        border: 1.5px solid var(--border-light);
        border-radius: var(--row-radius);
        padding: .65rem 1rem;
        font-size: .9rem;
        background: var(--very-light-blue);
        color: var(--text-dark);
        width: 100%;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

        .vn-control:focus {
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            outline: none;
            background: var(--bg-light);
        }

        .vn-control[readonly] {
            background: var(--bg-gray);
            cursor: default;
        }

    /* ===== TOGGLE CONTADO / CRÉDITO ===== */
    .vn-pay-toggle {
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        background: var(--bg-gray);
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius);
        padding: 4px;
    }

    .vn-pay-btn {
        position: relative;
        border: none;
        border-radius: 7px;
        padding: .55rem 1.5rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--secondary-blue);
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
        white-space: nowrap;
        transition: color var(--transition-fast);
    }

        .vn-pay-btn .vn-pay-pill {
            position: absolute;
            inset: 0;
            border-radius: 7px;
            opacity: 0;
            pointer-events: none;
            transition: opacity var(--transition-med), background var(--transition-med);
        }

        .vn-pay-btn.active {
            color: var(--primary-blue);
        }

            .vn-pay-btn.active .vn-pay-pill {
                opacity: 1;
                background: var(--light-blue);
            }

        .vn-pay-btn[data-val="credito"].active {
            color: var(--success-color);
        }

            .vn-pay-btn[data-val="credito"].active .vn-pay-pill {
                background: rgba(5, 150, 105, .1);
            }

        .vn-pay-btn i, .vn-pay-btn span {
            position: relative;
            z-index: 1;
        }

    /* ===== BANNER CRÉDITO ===== */
    .vn-credit-banner {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 14px;
        border-radius: var(--row-radius);
        border: 1px solid;
        font-size: .8rem;
        margin-top: .75rem;
        transition: all .3s;
    }

        .vn-credit-banner.disponible {
            background: rgba(5, 150, 105, .08);
            border-color: var(--success-color);
            color: var(--success-color);
        }

        .vn-credit-banner.por-vencer {
            background: rgba(217, 119, 6, .08);
            border-color: var(--warning-color);
            color: var(--warning-color);
        }

        .vn-credit-banner.excedido {
            background: rgba(220, 38, 38, .08);
            border-color: var(--danger-color);
            color: var(--danger-color);
        }

        .vn-credit-banner.sin-limite {
            background: var(--light-blue);
            border-color: var(--accent-blue);
            color: var(--primary-blue);
        }

    .vn-banner-bar-wrap {
        margin-top: 5px;
        height: 4px;
        border-radius: 99px;
        background: rgba(0,0,0,.1);
        overflow: hidden;
    }

    .vn-banner-bar-fill {
        height: 100%;
        border-radius: 99px;
    }

    .vn-credit-banner.disponible .vn-banner-bar-fill {
        background: var(--success-color);
    }

    .vn-credit-banner.por-vencer .vn-banner-bar-fill {
        background: var(--warning-color);
    }

    .vn-credit-banner.excedido .vn-banner-bar-fill {
        background: var(--danger-color);
    }

    /* ===== TABLA PRODUCTOS ===== */
    .vn-table-wrap {
        border-radius: var(--row-radius);
        border: 1px solid var(--border-light);
        overflow: hidden;
        overflow-x: auto;
        max-height: 420px;
        overflow-y: auto;
    }

    .vn-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        font-size: .82rem;
    }

        .vn-table thead {
            background: var(--primary-blue);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .vn-table th {
            padding: .65rem .6rem;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
        }

        .vn-table td {
            padding: .65rem .6rem;
            border-bottom: 1px solid var(--border-light);
            vertical-align: middle;
            color: var(--text-dark);
        }

        .vn-table tbody tr:hover {
            background: var(--light-blue);
        }

    .vn-table-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--text-light);
    }

        .vn-table-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: .75rem;
            opacity: .35;
        }

    /* ===== BOTONES ===== */
    .vn-btn {
        border: none;
        border-radius: var(--row-radius);
        padding: .6rem 1.25rem;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: transform var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .vn-btn:hover {
            transform: translateY(-1px);
        }

    .vn-btn-primary {
        background: var(--primary-blue);
        color: #fff;
    }

        .vn-btn-primary:hover {
            background: var(--primary-blue-dark);
            box-shadow: 0 4px 14px rgba(15, 23, 41, .3);
        }

    .vn-btn-success {
        background: var(--success-color);
        color: #fff;
    }

        .vn-btn-success:hover {
            background: #047857;
            box-shadow: 0 4px 14px rgba(5,150,105,.3);
        }

    .vn-btn-danger {
        background: var(--danger-color);
        color: #fff;
        padding: .35rem .75rem;
        font-size: .8rem;
    }

        .vn-btn-danger:hover {
            background: #b91c1c;
        }

    .vn-btn-outline {
        background: transparent;
        color: var(--accent-blue);
        border: 1.5px solid var(--accent-blue);
    }

        .vn-btn-outline:hover {
            background: var(--accent-blue);
            color: #fff;
        }

    .vn-btn-ghost {
        background: transparent;
        color: var(--danger-color);
        border: 1.5px solid var(--danger-color);
    }

        .vn-btn-ghost:hover {
            background: var(--danger-color);
            color: #fff;
        }

    /* ===== TICKET / RESUMEN ===== */
    .vn-ticket {
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius);
        overflow: hidden;
        box-shadow: var(--shadow);
    }

    .vn-ticket-head {
        background: var(--primary-blue);
        color: #fff;
        padding: 1.1rem 1.4rem;
        text-align: center;
    }

    .vn-ticket-head-icon {
        font-size: 1.5rem;
        opacity: .9;
        display: block;
        margin-bottom: .2rem;
    }

    .vn-ticket-head-label {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .vn-ticket-body {
        padding: 1.1rem 1.4rem;
        background: var(--bg-light);
    }

    .vn-ticket-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .55rem 0;
        border-bottom: 1px dashed var(--border-light);
        font-size: .85rem;
        color: var(--text-dark);
    }

        .vn-ticket-row:last-child {
            border-bottom: none;
        }

    .vn-ticket-row-label {
        color: var(--secondary-blue);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vn-ticket-row-val {
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: var(--text-dark);
    }

        .vn-ticket-row-val.vn-negative {
            color: var(--danger-color);
        }

    .vn-ticket-footer {
        background: var(--light-blue);
        border-top: 2px dashed var(--border-light);
        padding: 1.1rem 1.4rem;
    }

    .vn-ticket-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .vn-ticket-total-label {
        font-size: .85rem;
        color: var(--primary-blue);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vn-ticket-total-val {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--primary-blue);
        font-family: 'Courier New', monospace;
    }

    /* ===== TOGGLE CHECK (switch) ===== */
    .vn-switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .vn-switch-track {
        position: relative;
        width: 52px;
        height: 28px;
        border-radius: 99px;
        background: var(--border-light);
        transition: background .3s;
        flex-shrink: 0;
    }

        .vn-switch-track::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 3px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
            transition: transform .3s;
        }

    .vn-switch input {
        display: none;
    }

        .vn-switch input:checked ~ .vn-switch-track {
            background: var(--success-color);
        }

            .vn-switch input:checked ~ .vn-switch-track::after {
                transform: translateX(24px);
            }

    .vn-switch-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--secondary-blue);
        user-select: none;
    }

    /* ===== SEPARADOR ===== */
    .vn-sep {
        border: none;
        border-top: 1px dashed var(--border-light);
        margin: 1.25rem 0;
    }

    /* ===== MODAL ===== */
    .vn-modal-header {
        background: var(--primary-blue);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vn-modal-header .btn-close {
            filter: invert(1);
        }

    /* ===== SEARCH RESULT ITEM ===== */
    .vn-search-item {
        padding: .7rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--border-light);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color var(--transition-fast), background var(--transition-fast), transform var(--transition-fast);
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .vn-search-item:hover {
            border-color: var(--accent-blue);
            background: var(--light-blue);
            transform: translateX(3px);
        }

    /* ===== UTILIDADES ===== */
    .vn-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .2rem .6rem;
        border-radius: var(--badge-radius);
    }

    .vn-badge-blue {
        background: var(--light-blue);
        color: var(--primary-blue);
    }

    .vn-badge-green {
        background: rgba(5, 150, 105, .1);
        color: var(--success-color);
    }

    .vn-cot-btn-delete {
        background-color: var(--danger-color);
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all var(--transition-fast);
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .vn-cot-btn-delete:hover {
            background-color: #b91c1c;
            transform: translateY(-1px);
        }

        .vn-cot-btn-delete:active {
            transform: scale(0.96);
        }

        .vn-cot-btn-delete:disabled {
            background-color: var(--disabled-color);
            cursor: not-allowed;
            opacity: 0.7;
        }
</style>

@{
    var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS");
}

<div class="vn-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vn-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--text-dark)">Nueva Cotización</h1>
                <p class="mb-0 small" style="color:var(--secondary-blue)">Complete los datos para generar la cotización</p>
            </div>
        </div>

        <form id="vn-cot-formCotizacion" method="post">

            <!-- ===== FILA PRINCIPAL ===== -->
            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vn-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vn-cot-tipo-pago" value="contado">
                        <div class="vn-pay-toggle" id="vn-cot-toggle-pago">
                            <button type="button" class="vn-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoCot('contado')">
                                <div class="vn-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vn-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoCot('credito')">
                                <div class="vn-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vn-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap: nowrap">
                                    <button class="vn-btn vn-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vn-cot-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vn-control" id="vn-cot-cliente"
                                           placeholder="Seleccione un cliente…" readonly
                                           style="border-radius:0 var(--row-radius) var(--row-radius) 0; border-left: none;">
                                </div>
                            </div>

                            <!-- Lista precios + RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vn-label"><i class="fas fa-tags"></i>Lista de Precios</label>
                                <input type="text" id="vn-cot-lista-precios" class="vn-control"
                                       name="listaPrecios" readonly placeholder="—">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vn-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vn-cot-rfc" class="vn-control">
                            </div>

                            <!-- Banner crédito -->
                            <div class="col-12">
                                <div id="vn-cot-credit-banner" style="display:none;" class="vn-credit-banner">
                                    <div id="vn-cot-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vn-cot-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vn-cot-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vn-banner-bar-wrap" id="vn-cot-credit-bar-wrap">
                                            <div class="vn-banner-bar-fill" id="vn-cot-credit-bar" style="width:0%;"></div>
                                        </div>
                                    </div>
                                    <div id="vn-cot-credit-pct" style="font-size:.8rem;font-weight:600;flex-shrink:0;"></div>
                                </div>
                            </div>

                            <!-- Info adicional proveedor -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vn-control" id="vn-cot-info-proveedor" rows="3" readonly></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vn-control form-select" name="vendedor" id="vn-cot-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vn-control form-select" name="moneda" id="vn-cot-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vn-cot-paridad" name="paridad" class="vn-control" value="1.0000">
                            </div>

                            <!-- Concepto -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-comment"></i>Concepto</label>
                                <input type="text" id="vn-cot-concepto" name="concepto" class="vn-control">
                            </div>
                        </div>
                    </div><!-- /tarjeta cliente -->
                    <!-- TARJETA: Artículos -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-box-open"></i></div>
                            <h2 class="vn-section-title">Artículos y Productos</h2>
                        </div>

                        <!-- Header tabla -->
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="vn-badge vn-badge-blue">
                                <i class="fas fa-list"></i> Lista de productos
                            </span>
                            <button type="button" class="vn-btn vn-btn-success"
                                    data-bs-toggle="modal" data-bs-target="#vn-cot-modalBuscarProducto">
                                <i class="fas fa-plus"></i> Agregar producto
                            </button>
                        </div>

                        <div class="vn-table-wrap">
                            <table class="vn-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th>Cantidad</th>
                                        <th>Unidad</th>
                                        <th>Precio</th>
                                        <th>Desc %</th>
                                        <th>Importe</th>
                                        <th>Comentario</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="vn-cot-productosTable">
                                    <tr>
                                        <td colspan="10" class="vn-table-empty">
                                            <i class="fas fa-box-open"></i>
                                            <div class="fw-semibold mb-1">Sin productos</div>
                                            <small style="color:var(--text-light)">Haz clic en "Agregar producto" para comenzar</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <hr class="vn-sep">

                        <!-- Flete -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label class="vn-switch" for="vn-cot-flete">
                                <input type="checkbox" id="vn-cot-flete">
                                <span class="vn-switch-track"></span>
                                <span class="vn-switch-label"><i class="fas fa-truck me-1"></i>Con Flete</span>
                            </label>
                            <input type="number" class="vn-control d-none" name="flete"
                                   id="vn-cot-flete-val" placeholder="Costo de flete" style="max-width:180px;">
                        </div>

                        <!-- Orden de compra -->
                        <div class="d-flex align-items-center gap-3">
                            <label class="vn-switch" for="vn-cot-orden-compra-check">
                                <input type="checkbox" id="vn-cot-orden-compra-check">
                                <span class="vn-switch-track"></span>
                                <span class="vn-switch-label"><i class="fas fa-file-alt me-1"></i>Con Orden de Compra</span>
                            </label>
                            <input type="text" class="vn-control d-none" name="ordenCompra"
                                   id="vn-cot-orden-compra-val" placeholder="Número de orden de compra"
                                   autocomplete="off" style="max-width:220px;">
                        </div>
                    </div><!-- /tarjeta artículos -->
                    <!-- TARJETA: Comentarios -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-comment-dots"></i></div>
                            <h2 class="vn-section-title">Comentarios Adicionales</h2>
                        </div>
                        <textarea class="vn-control" id="vn-cot-comentarios" name="comentarios" rows="5"
                                  placeholder="Ingrese observaciones, condiciones de entrega, vigencia, etc."></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA: RESUMEN ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem; z-index: 0">

                        <!-- Ticket resumen -->
                        <div class="vn-ticket mb-3">
                            <div class="vn-ticket-head">
                                <i class="fas fa-calculator vn-ticket-head-icon"></i>
                                <div class="vn-ticket-head-label">Resumen de Cotización</div>
                            </div>
                            <div class="vn-ticket-body">
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Subtotal 1</span>
                                    <span class="vn-ticket-row-val" id="vn-cot-total-subtotal1-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Descuento</span>
                                    <span class="vn-ticket-row-val vn-negative" id="vn-cot-total-descuento-display">-$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Flete</span>
                                    <span class="vn-ticket-row-val" id="vn-cot-total-flete-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--border-light);border-bottom:none;">
                                    <span class="vn-ticket-row-label">Subtotal 2</span>
                                    <span class="vn-ticket-row-val" id="vn-cot-total-subtotal2-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">IVA (16%)</span>
                                    <span class="vn-ticket-row-val" id="vn-cot-iva-display">$0.00</span>
                                </div>
                            </div>
                            <div class="vn-ticket-footer">
                                <div class="vn-ticket-total-row">
                                    <span class="vn-ticket-total-label"><i class="fas fa-coins me-1"></i>Total</span>
                                    <strong class="vn-ticket-total-val" id="vn-cot-importe-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vn-cot-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vn-cot-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vn-cot-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vn-cot-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vn-cot-iva" name="iva" value="0.00">
                            <input type="hidden" id="vn-cot-importe" name="importe" value="0.00">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vn-btn vn-btn-outline d-none"
                                    data-bs-toggle="modal" data-bs-target="#vn-cot-modalVistaPrevia"
                                    style="width:100%;justify-content:center;">
                                <i class="fas fa-eye"></i> Vista Previa
                            </button>
                            <button type="button" class="vn-btn vn-btn-success vn-cot-btn-submit"
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-paper-plane"></i> Generar Cotización
                            </button>
                            <a href="#" class="vn-btn vn-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div><!-- /col derecha -->

            </div><!-- /row -->
        </form>
    </div><!-- /container -->
</div><!-- /vn-page -->
