<script>
    /* ===== TOGGLE TIPO PAGO ===== */
    function selectTipoPagoCot(val) {
        document.querySelectorAll('#vn-cot-toggle-pago .vn-pay-btn')
            .forEach(o => o.classList.toggle('active', o.dataset.val === val));
        document.getElementById('vn-cot-tipo-pago').value = val;
        // El crédito solo se evalúa en ventas a crédito; el módulo oculta el banner solo.
        window.CreditoVentas?.evaluar('vn-cot');
    }

    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vn-cot-flete').addEventListener('change', function () {
        const inp = document.getElementById('vn-cot-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vn-cot-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vn-cot-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>
