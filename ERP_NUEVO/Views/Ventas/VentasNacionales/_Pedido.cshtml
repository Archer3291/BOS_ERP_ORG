<script>
    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    function selectTipoPagoPed(val) {
    document.querySelectorAll('#vn-ped-toggle-pago .vn-pay-btn')
    .forEach(o => o.classList.toggle('active', o.dataset.val === val));
    document.getElementById('vn-ped-tipo-pago').value = val;

    // ★ Sincronizar select de método de pago con el toggle
    const metodoPagoEl = document.getElementById('vn-ped-metodo-pago');
    if (metodoPagoEl) {
    metodoPagoEl.value = val === 'credito' ? 'PPD' : 'PUE';
    }

    const camposCredito = document.getElementById('vn-ped-campos-credito');
    const secProductos = document.getElementById('vn-ped-seccion-productos');
    camposCredito.style.display = 'none';

    if (val === 'contado') {
    limpiarCamposPed();
    secProductos.style.display = '';
    } else if (val === 'credito') {
    camposCredito.style.display = 'block';
    secProductos.style.display = '';
    }

    // El crédito solo se valida en ventas a crédito.
    window.CreditoVentas?.evaluar('vn-ped');
    }

    function limpiarCamposPed() {
    limpiarCamposCreditoP();
    }

    function limpiarCamposCreditoP() {
    document.getElementById('vn-ped-limite-credito').value = '0.00';
    document.getElementById('vn-ped-plazo').value = '';
    document.getElementById('vn-ped-fecha-pago').value = '';
    }
    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vn-ped-flete').addEventListener('change', function () {
    const inp = document.getElementById('vn-ped-flete-val');
    inp.classList.toggle('d-none', !this.checked);
    if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vn-ped-orden-compra-check').addEventListener('change', function () {
    const inp = document.getElementById('vn-ped-orden-compra-val');
    inp.classList.toggle('d-none', !this.checked);
    if (!this.checked) inp.value = '';
    });
</script>
