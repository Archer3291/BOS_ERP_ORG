                            <div class="vn-section-icon"><i class="fas fa-comment-dots"></i></div>
                            <h2 class="vn-section-title">Comentarios Adicionales</h2>
                        </div>
                        <textarea class="vn-control" id="vn-ped-comentarios" name="comentarios" rows="5"
                                  placeholder="Ingrese observaciones, condiciones de entrega, vigencia, etc."></textarea>
                    </div>

                </div><!-- /col izquierda -->
                <!-- ========== COLUMNA DERECHA: RESUMEN ========== -->
                <div class="col-12 col-xl-4">
                    <div class="sticky-top" style="top:5rem; z-index:0;">

                        <!-- Ticket resumen -->
                        <div class="vn-ticket mb-3">
                            <div class="vn-ticket-head">
                                <i class="fas fa-calculator vn-ticket-head-icon"></i>
                                <div class="vn-ticket-head-label">Resumen de Pedido</div>
                            </div>
                            <div class="vn-ticket-body">
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Subtotal 1</span>
                                    <span class="vn-ticket-row-val" id="vn-ped-total-subtotal1-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Descuento</span>
                                    <span class="vn-ticket-row-val vn-negative" id="vn-ped-total-descuento-display">-$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">Flete</span>
                                    <span class="vn-ticket-row-val" id="vn-ped-total-flete-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--vn-gray-200);border-bottom:none;">
                                    <span class="vn-ticket-row-label">Subtotal 2</span>
                                    <span class="vn-ticket-row-val" id="vn-ped-total-subtotal2-display">$0.00</span>
                                </div>
                                <div class="vn-ticket-row">
                                    <span class="vn-ticket-row-label">IVA (16%)</span>
                                    <span class="vn-ticket-row-val" id="vn-ped-iva-display">$0.00</span>
                                </div>
                            </div>
                            <div class="vn-ticket-footer">
                                <div class="vn-ticket-total-row">
                                    <span class="vn-ticket-total-label"><i class="fas fa-coins me-1"></i>Total</span>
                                    <strong class="vn-ticket-total-val" id="vn-ped-importe-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vn-ped-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vn-ped-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vn-ped-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vn-ped-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vn-ped-iva" name="iva" value="0.00">
                            <input type="hidden" id="vn-ped-importe" name="importe" value="0.00">
                            <input type="hidden" id="vn-ped-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vn-btn vn-btn-outline d-none"
                                    data-bs-toggle="modal" data-bs-target="#vn-ped-modalVistaPrevia"
                                    onclick="actualizarVistaPreviaPedido()"
                                    style="width:100%;justify-content:center;">
                                <i class="fas fa-eye"></i> Vista Previa
                            </button>
                            <button type="button" class="vn-btn vn-btn-success vn-ped-btn-submit"
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-paper-plane"></i> Generar Pedido
                            </button>
                            <a href="#" class="vn-btn vn-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div><!-- /col derecha -->

            </div><!-- /row -->
        </form>
    </div><!-- /container -->
</div><!-- /vn-page -->
