<div class="modal fade" id="vn-ped-modalVistaPrevia" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vn-modal-header">
                <h5 class="modal-title"><i class="fas fa-file-pdf me-2"></i>Vista Previa de Pedido</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-0">
                <div id="vn-ped-previewPDF" style="background:#525659;padding:2rem;min-height:600px;max-height:80vh;overflow-y:auto;">
                    <div class="vista-previa-pedido" id="vista-previa-pedido"
                         style="background:white;max-width:850px;margin:0 auto;padding:3rem;box-shadow:0 0 20px rgba(0,0,0,.3);font-family:Arial,sans-serif;">

                        <div style="border-bottom:3px solid #1e3a5f;padding-bottom:1rem;margin-bottom:2rem;">
                            <div style="display:flex;justify-content:space-between;align-items:start;">
                                <div>
                                    <h1 style="color:#1e3a5f;margin:0;font-size:2rem;">PEDIDO</h1>
                                    <p style="margin:.5rem 0 0;color:#666;">Folio: <strong id="vn-ped-preview-folio">-</strong></p>
                                </div>
                                <div style="text-align:right;color:#333;">
                                    <p style="margin:0;font-size:.9rem;"><strong>Fecha:</strong> <span id="vn-ped-preview-fecha">-</span></p>
                                    <p style="margin:.3rem 0 0;font-size:.9rem;"><strong>Sucursal:</strong> <span id="vn-ped-preview-sucursal">-</span></p>
                                </div>
                            </div>
                        </div>

                        <div style="margin-bottom:2rem;">
                            <h3 style="color:#1e3a5f;border-bottom:2px solid #e0e0e0;padding-bottom:.5rem;font-size:1.1rem;">INFORMACIÓN DEL CLIENTE</h3>
