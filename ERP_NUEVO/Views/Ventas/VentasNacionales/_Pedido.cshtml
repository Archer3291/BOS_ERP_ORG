@{
    var role = Utilities.GetUserRole(User.Identity.Name);
}

<div class="vn-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vn-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vn-gray-800)">Nuevo Pedido</h1>
                <p class="mb-0 small" style="color:var(--vn-gray-600)">Complete los datos para generar el pedido</p>
            </div>
        </div>

        <form id="vn-ped-formCotizacion" class="vn-ped-formCotizacion" method="post">

            <!-- ===== FILA PRINCIPAL ===== -->
            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vn-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vn-ped-tipo-pago" value="contado">
                        <div class="vn-pay-toggle" id="vn-ped-toggle-pago">
                            <button type="button" class="vn-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoPed('contado')">
                                <div class="vn-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vn-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoPed('credito')">
                                <div class="vn-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vn-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vn-ped-folio" value="@Model.Folio" name="folio"
                                       class="vn-control" readonly autocomplete="off">
                            </div>
                            <!-- Sucursal / Almacén (ocultos por defecto) -->
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vn-label"><i class="fas fa-building"></i>Sucursal</label>
                                <select class="vn-control form-select" id="vn-ped-sucursal" name="sucursal">
                                    <option selected>CEDIS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vn-label"><i class="fas fa-warehouse"></i>Almacén</label>
                                <select class="vn-control form-select" id="vn-ped-almacen" name="almacen">
                                    <option selected>ALMACÉN GENERAL</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vn-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vn-btn vn-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vn-ped-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vn-control" id="vn-ped-cliente"
                                           placeholder="Seleccione un cliente…" readonly
                                           style="border-radius:0 var(--vn-radius) var(--vn-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vn-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vn-ped-rfc" class="vn-control" autocomplete="off">
                            </div>

                            <!-- Banner crédito -->
                            <div class="col-12">
                                <div id="vn-ped-credit-banner" style="display:none;" class="vn-credit-banner">
                                    <div id="vn-ped-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vn-ped-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vn-ped-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vn-banner-bar-wrap" id="vn-ped-credit-bar-wrap">
                                            <div class="vn-banner-bar-fill" id="vn-ped-credit-bar" style="width:0%;"></div>
                                        </div>
                                    </div>
                                    <div id="vn-ped-credit-pct" style="font-size:.8rem;font-weight:600;flex-shrink:0;"></div>
                                </div>
                            </div>

                            <!-- Info adicional cliente -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vn-control" id="vn-ped-info-proveedor" rows="3" readonly autocomplete="off"></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vn-control form-select" name="vendedor" id="vn-ped-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vn-control form-select" name="moneda" id="vn-ped-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vn-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vn-ped-paridad" name="paridad" class="vn-control" value="1" autocomplete="off">
                            </div>

                            <!-- Referencia -->
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-comment"></i>Referencia</label>
                                <input type="text" id="vn-ped-concepto" name="concepto" class="vn-control" autocomplete="off">
                            </div>

                            <!-- Incoterm (oculto) -->
                            <div class="col-12 d-none">
                                <label class="vn-label"><i class="fas fa-shipping-fast"></i>Incoterm</label>
                                <select class="vn-control form-select" name="incoterm" id="vn-ped-incoterm">
                                    <option selected disabled>Seleccionar Incoterm</option>
                                    <option value="EXW">EXW – En fábrica</option>
                                    <option value="FOB">FOB – Libre a bordo</option>
                                    <option value="CFR">CFR – Costo y flete</option>
                                    <option value="CIF">CIF – Costo, seguro y flete</option>
                                    <option value="DAP">DAP – Entregado en lugar</option>
                                    <option value="DDP">DDP – Entregado con derechos pagados</option>
                                </select>
                            </div>
                        </div>
                    </div><!-- /tarjeta cliente -->
                    <!-- TARJETA: Artículos -->
                    <div class="vn-card p-4 mb-4" id="vn-ped-seccion-productos">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-box-open"></i></div>
                            <h2 class="vn-section-title">Artículos y Productos</h2>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="vn-badge vn-badge-blue">
                                <i class="fas fa-list"></i> Lista de productos
                            </span>
                            <button type="button" class="vn-btn vn-btn-success"
                                    data-bs-toggle="modal" data-bs-target="#vn-ped-modalBuscarProducto">
                                <i class="fas fa-plus"></i> Agregar producto
                            </button>
                        </div>

                        <div class="vn-table-wrap">
                            <table class="vn-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
                                        <th>Artículo</th>
                                        <th>Descripción</th>
                                        <th title="Existencia en almacenes tipo Stock de esta sucursal">Exist. Stock</th>
                                        <th title="Existencia en almacenes tipo Modula de esta sucursal">Exist. Modula</th>
                                        <th>Cantidad</th>
                                        <th>Unidad</th>
                                        <th>Precio</th>
                                        @if (role == "Gerente")
                                        {
                                            <th>Desc %</th>
                                        }
                                        <th>Importe</th>
                                        <th>Comentario</th>
                                        <th>Acción</th>
                                    </tr>
                                </thead>
                                <tbody id="vn-ped-productosTable">
                                    <tr>
                                        <td colspan="12" class="vn-table-empty">
                                            <i class="fas fa-box-open"></i>
                                            <div class="fw-semibold mb-1">Sin productos</div>
                                            <small style="color:var(--vn-gray-400)">Haz clic en "Agregar producto" para comenzar</small>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <hr class="vn-sep">

                        <!-- Flete -->
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <label class="vn-switch" for="vn-ped-flete">
                                <input type="checkbox" id="vn-ped-flete">
                                <span class="vn-switch-track"></span>
                                <span class="vn-switch-label"><i class="fas fa-truck me-1"></i>Con Flete</span>
                            </label>
                            <input type="number" class="vn-control d-none" name="flete"
                                   id="vn-ped-flete-val" placeholder="Costo de flete" style="max-width:180px;">
                        </div>

                        <!-- Orden de compra -->
                        <div class="d-flex align-items-center gap-3">
                            <label class="vn-switch" for="vn-ped-orden-compra-check">
                                <input type="checkbox" id="vn-ped-orden-compra-check">
                                <span class="vn-switch-track"></span>
                                <span class="vn-switch-label"><i class="fas fa-file-alt me-1"></i>Con Orden de Compra</span>
                            </label>
                            <input type="text" class="vn-control d-none" name="ordenCompra"
                                   id="vn-ped-orden-compra-val" placeholder="Número de orden de compra"
                                   autocomplete="off" style="max-width:220px;">
                        </div>
                    </div><!-- /tarjeta artículos -->
                    <!-- TARJETA: Condiciones de Pago -->
                    <div class="vn-card p-4 mb-4">
                        <div class="vn-section-header">
                            <div class="vn-section-icon"><i class="fas fa-file-invoice"></i></div>
                            <h2 class="vn-section-title">Condiciones de Pago</h2>
                        </div>

                        <!-- Campos crédito -->
                        <div id="vn-ped-campos-credito" style="display:none;">
                            <div class="row g-3 mb-3">
                                <div class="col-12 col-sm-6">
                                    <label class="vn-label"><i class="fas fa-credit-card"></i>Límite de Crédito</label>
                                    <input type="number" id="vn-ped-limite-credito" name="limite-credito"
                                           value="0.00" readonly class="vn-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vn-label"><i class="fas fa-credit-card"></i>Crédito Disponible</label>
                                    <input type="number" id="vn-ped-limite-disponible" name="limite-disponible"
                                           value="0.00" readonly class="vn-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vn-label"><i class="fas fa-calendar-day"></i>Plazo (días)</label>
                                    <input type="number" id="vn-ped-plazo" name="plazo" class="vn-control" autocomplete="off">
                                </div>
                                <div class="col-12 col-sm-6">
                                    <label class="vn-label"><i class="fas fa-calendar"></i>Fecha de Pago</label>
                                    <input type="date" id="vn-ped-fecha-pago" name="fecha-pago" class="vn-control">
                                </div>
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-12 col-sm-6">
                                <label class="vn-label"><i class="fas fa-money-bill"></i>Método de Pago</label>
                                <select class="vn-control form-select" id="vn-ped-metodo-pago" name="metodo-pago" required>
                                    <option value="" selected disabled>Seleccione un método de pago</option>
                                    <option value="PUE">PUE - Pago en una sola exhibición</option>
                                    <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vn-label"><i class="fas fa-money-bill"></i>Forma de Pago</label>
                                <select class="vn-control form-select" id="vn-ped-forma-pago" name="forma-pago">
                                    <option value="01">01 - Efectivo</option>
                                    <option value="02">02 - Cheque nominativo</option>
                                    <option value="03">03 - Transferencia electrónica</option>
                                    <option value="04">04 - Tarjeta de crédito</option>
                                    <option value="28">28 - Tarjeta de débito</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="vn-label"><i class="fas fa-file-invoice"></i>Uso CFDI</label>
                                <select class="vn-control form-select" id="vn-ped-uso-cfdi" name="uso-cfdi">
                                    <option>G03 - Gastos en general</option>
                                    <option value="D01">D01 - Honorarios médicos</option>
                                    <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                    <option value="P01">P01 - Por definir</option>
                                </select>
                            </div>
                        </div>
