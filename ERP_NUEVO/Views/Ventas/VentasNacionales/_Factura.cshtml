<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.7.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
<script>
    async function descargarVistaPreviaFacturaPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'mm', 'a4');
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 12;
        let y = margin;

        // ============ CONFIGURACIÓN DE COLORES ============
        const colors = {
            primary: [13, 35, 75],        // Azul marino oscuro
            secondary: [59, 130, 246],    // Azul primario
            accent: [34, 197, 94],        // Verde esmeralda
            highlight: [249, 115, 22],    // Naranja energético
            dark: [30, 30, 40],           // Gris muy oscuro
            text: [60, 70, 85],           // Gris texto
            light: [248, 250, 252],       // Gris ultra claro
            border: [219, 224, 231],      // Gris borde
            white: [255, 255, 255]
        };

        // ============ FUNCIONES AUXILIARES ============
        const getValue = (id, defaultVal = '-') =>
            document.getElementById(id)?.value?.trim() || defaultVal;

        const getSelectedText = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            if (!el) return defaultVal;
            return el.options[el.selectedIndex]?.text?.trim() || defaultVal;
        };

        const formatCurrency = val =>
            parseFloat(val || 0).toLocaleString('es-MX', {
                style: 'currency',
                currency: 'MXN'
            });

        const getTomSelectText = (id) => {
            const instance = tomManager.getInstance(id);
            return instance?.getItem(instance?.getValue())?.textContent || '';
        };

        // ============ OBTENER DATOS ============
        const tipoFactura = document.getElementById('vn-fac-toggle-pago')?.getAttribute('data-state') || 'contado';
        const folio = getValue('vn-fac-folio', 'S/A');
        const fecha = new Date().toLocaleDateString('es-MX');
        const sucursal = getSelectedText('vn-fac-sucursal', 'CEDIS');

        // ============ HEADER CON LOGO ============
        await drawHeaderFactura(doc, colors, margin, pageWidth, folio, fecha, sucursal, tipoFactura);
        y = 41;

        // ============ TARJETAS DE INFORMACIÓN ============
        y = drawInfoCardsFactura(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue, formatCurrency);

        // ============ SECCIÓN DE PRODUCTOS O ANTICIPO ============
        y = await drawProductsSectionFactura(doc, colors, margin, pageWidth, y, tipoFactura, getValue, formatCurrency);

        // ============ RESUMEN FINANCIERO ============
        drawFinancialSummaryFactura(doc, colors, margin, pageWidth, y);

        // ============ CONDICIONES DE PAGO ============
        y += 40;
        y = drawPaymentConditionsFactura(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue);

        // ============ COMENTARIOS ============
        y = drawCommentsFactura(doc, colors, margin, pageWidth, pageHeight, y, getValue);

        // ============ FOOTER ============
        drawFooterFactura(doc, colors, margin, pageWidth, pageHeight);

        // ============ GUARDAR PDF ============
        doc.save(`factura-${folio}-${Date.now()}.pdf`);
    }

    // ============ FUNCIÓN: HEADER CON LOGO ============
    async function drawHeaderFactura(doc, colors, margin, pageWidth, folio, fecha, sucursal, tipoFactura) {
        const headerHeight = 18;

        // Fondo principal
        doc.setFillColor(...colors.primary);
        doc.rect(0, 0, pageWidth, headerHeight, 'F');

        // Línea de acento vertical izquierda
        doc.setFillColor(...colors.accent);
        doc.rect(0, 0, 2.5, headerHeight, 'F');

        // ============ LOGO ============
        const logoUrl = `/Content/img/${empresa}/logo-light.png`;
        try {
            const img = await loadImageFactura(logoUrl);
            doc.addImage(img, 'PNG', margin, 2, 17, 7.5, '', 'FAST');
        } catch (error) {
            // Fallback simple
            doc.setFillColor(...colors.secondary);
            doc.roundedRect(margin, 2, 6.5, 7.5, 1, 1, 'F');
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(6);
            doc.setTextColor(...colors.white);
            doc.text('LOGO', margin + 3.25, 5.75, { align: 'center' });
        }

        // ============ TÍTULO ============
        const titleX = margin + 19;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(...colors.white);
        doc.text('FACTURA', titleX, 6);

        // Línea decorativa bajo título
        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(0.5);
        doc.line(titleX, 6.8, titleX + 20, 6.8);

        // ============ BADGE DE ESTADO COMPACTO ============
        const badgeX = titleX;
        const badgeY = 7.2;

        const estadoConfig = {
            contado: { color: colors.accent, label: 'CONTADO' },
            credito: { color: colors.secondary, label: 'CRÉDITO' },
            anticipo: { color: colors.highlight, label: 'ANTICIPO' }
        };

        const config = estadoConfig[tipoFactura] || estadoConfig.contado;

        doc.setFillColor(...config.color);
        doc.roundedRect(badgeX, badgeY, 13, 3.5, 0.8, 0.8, 'F');
        doc.setTextColor(...colors.white);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(7);
        doc.text(config.label, badgeX + 6.5, badgeY + 2.1, { align: 'center' });

        // ============ INFORMACIÓN DERECHA ============
        const rightX = pageWidth - margin;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);
        doc.setTextColor(...colors.light);

        doc.text(`Folio: ${folio}`, rightX, 3.5, { align: 'right' });
        doc.text(`${fecha}`, rightX, 6.5, { align: 'right' });
        doc.text(`${sucursal}`, rightX, 9.5, { align: 'right' });

        // Línea divisoria inferior
        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(0.6);
        doc.line(0, headerHeight, pageWidth, headerHeight);
    }

    // ============ FUNCIÓN: CARGAR IMAGEN ============
    function loadImageFactura(url) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = reject;
            img.src = url;
        });
    }

    // ============ FUNCIÓN: TARJETAS DE INFORMACIÓN ============
    function drawInfoCardsFactura(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue, formatCurrency) {
        const cardHeight = 22;
        const cardWidth = (pageWidth - 3 * margin) / 2;

        // TARJETA 1: CLIENTE
        drawCardFactura(doc, colors, margin, y, cardWidth, cardHeight);

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(8);
        doc.setTextColor(...colors.primary);
        doc.text('CLIENTE', margin + 3, y + 4);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);
        doc.setTextColor(...colors.text);

        const clienteName = getValue('vn-fac-cliente');
        const clienteDisplay = clienteName.length > 40 ? clienteName.substring(0, 40) + '...' : clienteName;

        doc.text(clienteDisplay, margin + 3, y + 8);
        doc.text(`RFC: ${getValue('vn-fac-rfc')}`, margin + 3, y + 11);
        doc.text(`Vendedor: ${getTomSelectText('vn-fac-vendedor')}`, margin + 3, y + 14);

        const conceptoVal = getValue('vn-fac-concepto');
        const conceptoDisplay = conceptoVal.length > 25 ? conceptoVal.substring(0, 25) + '...' : conceptoVal;
        doc.text(`Concepto: ${conceptoDisplay}`, margin + 3, y + 17);
        doc.text(`Uso CFDI: ${getTomSelectText('vn-fac-uso-cfdi')}`, margin + 3, y + 20);

        // TARJETA 2: PARÁMETROS
        const card2X = margin + cardWidth + margin;
        drawCardFactura(doc, colors, card2X, y, cardWidth, cardHeight);

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(8);
        doc.setTextColor(...colors.primary);
        doc.text('PARÁMETROS', card2X + 3, y + 4);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);
        doc.setTextColor(...colors.text);

        doc.text(`Moneda: ${getTomSelectText('vn-fac-moneda')}`, card2X + 3, y + 8);
        doc.text(`Incoterm: ${getTomSelectText('vn-fac-incoterm')}`, card2X + 3, y + 11);

        if (tipoFactura === 'credito') {
            doc.text(`Plazo: ${getValue('vn-fac-plazo')} días`, card2X + 3, y + 14);
            doc.text(`Vencimiento: ${getValue('vn-fac-fecha-pago')}`, card2X + 3, y + 17);
        } else if (tipoFactura === 'anticipo') {
            doc.text(`Monto: ${formatCurrency(getValue('vn-fac-monto-anticipo'))}`, card2X + 3, y + 14);
        }

        doc.text(`Forma de Pago: ${getTomSelectText('vn-fac-forma-pago')}`, card2X + 3, y + 20);

        return y + cardHeight + margin + 3;
    }

    // ============ FUNCIÓN: DIBUJAR TARJETA BASE ============
    function drawCardFactura(doc, colors, x, y, width, height) {
        doc.setDrawColor(...colors.border);
        doc.setLineWidth(0.5);
        doc.setFillColor(...colors.white);
        doc.roundedRect(x, y, width, height, 2, 2, 'FD');
    }

    // ============ FUNCIÓN: SECCIÓN DE PRODUCTOS ============
    async function drawProductsSectionFactura(doc, colors, margin, pageWidth, y, tipoFactura, getValue, formatCurrency) {
        if (tipoFactura === 'anticipo') {
            return drawAnticipoSectionFactura(doc, colors, margin, pageWidth, y, getValue, formatCurrency);
        } else {
            return await drawProductsTableFactura(doc, colors, margin, pageWidth, y, formatCurrency);
        }
    }

    // ============ FUNCIÓN: BANNER DE ANTICIPO ============
    function drawAnticipoSectionFactura(doc, colors, margin, pageWidth, y, getValue, formatCurrency) {
        doc.setFillColor(...colors.highlight);
        doc.roundedRect(margin, y, pageWidth - 2 * margin, 12, 2, 2, 'F');

        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(...colors.white);
        doc.text('ANTICIPO REQUERIDO', pageWidth / 2, y + 4.5, { align: 'center' });

        doc.setFontSize(13);
        doc.text(formatCurrency(getValue('vn-fac-monto-anticipo')), pageWidth / 2, y + 9, { align: 'center' });

        return y + 14;
    }

    // ============ FUNCIÓN: TABLA DE PRODUCTOS ============
    async function drawProductsTableFactura(doc, colors, margin, pageWidth, y, formatCurrency) {
        // Título
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(...colors.primary);
        doc.text('ARTÍCULOS', margin, y);

        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(1.2);
        doc.line(margin, y + 1.2, margin + 25, y + 1.2);
        y += 5;

        // Obtener datos de productos
        const rows = getProductRowsFactura(formatCurrency);

        // Generar tabla
        doc.autoTable({
            startY: y,
            head: [['Artículo', 'Descripción', 'Cant.', 'Unidad', 'P. Unitario', 'Desc %', 'Importe']],
            body: rows,
            theme: 'grid',
            headStyles: {
                fillColor: colors.primary,
                textColor: colors.white,
                fontSize: 7,
                fontStyle: 'bold',
                halign: 'center',
                valign: 'middle',
                cellPadding: 2.5,
                lineColor: colors.secondary,
                lineWidth: 0.5
            },
            bodyStyles: {
                fontSize: 7,
                textColor: colors.text,
                cellPadding: 2,
                lineColor: colors.border,
                lineWidth: 0.2
            },
            alternateRowStyles: {
                fillColor: [253, 254, 255]
            },
            columnStyles: {
                0: { halign: 'left', cellWidth: 20 },
                1: { halign: 'left' },
                2: { halign: 'center', cellWidth: 12 },
                3: { halign: 'center', cellWidth: 12 },
                4: { halign: 'right', cellWidth: 18 },
                5: { halign: 'center', cellWidth: 12 },
                6: { halign: 'right', fontStyle: 'bold', textColor: colors.secondary, cellWidth: 18 }
            },
            margin: { left: margin, right: margin }
        });

        return doc.lastAutoTable.finalY + 6;
    }

    // ============ FUNCIÓN: OBTENER FILAS DE PRODUCTOS ============
    function getProductRowsFactura(formatCurrency) {
        const productosTable = document.getElementById('vn-fac-productosTable');
        const rows = [];

        if (productosTable) {
            Array.from(productosTable.querySelectorAll('tr')).forEach(row => {
                if (!row.classList.contains('vn-fac-empty-state')) {
                    const cols = row.querySelectorAll('td');
                    if (cols.length >= 8) {
                        rows.push([
                            cols[0]?.textContent?.trim() || '-',
                            cols[1]?.textContent?.trim() || '-',
                            cols[3]?.querySelector('input')?.value || '0',
                            cols[4]?.textContent?.trim() || '-',
                            formatCurrency(cols[5]?.querySelector('input')?.value),
                            cols[6]?.querySelector('input')?.value || '0' + '%',
                            cols[7]?.textContent?.trim() || formatCurrency(0)
                        ]);
                    }
                }
            });
        }

        if (rows.length === 0) {
            rows.push(['Sin artículos agregados', '', '', '', '', '', '']);
        }

        return rows;
    }

    // ============ FUNCIÓN: RESUMEN FINANCIERO ============
    function drawFinancialSummaryFactura(doc, colors, margin, pageWidth, y) {
        const summaryX = pageWidth - margin - 58;
        const summaryWidth = 54;

        // Caja de resumen
        doc.setFillColor(...colors.light);
        doc.setDrawColor(...colors.border);
        doc.setLineWidth(0.4);
        doc.roundedRect(summaryX - 1.5, y - 1, summaryWidth + 3, 38, 1.5, 1.5, 'FD');

        // Items del resumen
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);

        let summaryY = y + 2;
        const items = [
            { label: 'Subtotal:', id: 'vn-fac-total-subtotal1-display' },
            { label: 'Descuento:', id: 'vn-fac-total-descuento-display' },
            { label: 'Flete:', id: 'vn-fac-total-flete-display' },
            { label: 'Subtotal 2:', id: 'vn-fac-total-subtotal2-display' },
            { label: 'IVA (16%):', id: 'vn-fac-iva-display' }
        ];

        items.forEach(item => {
            doc.setTextColor(...colors.text);
            doc.text(item.label, summaryX + 1.5, summaryY);
            doc.setTextColor(...colors.dark);
            doc.text(
                document.getElementById(item.id)?.textContent || '$0.00',
                summaryX + summaryWidth - 1.5,
                summaryY,
                { align: 'right' }
            );
            summaryY += 3.2;
        });

        // Línea separadora
        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(0.8);
        doc.line(summaryX + 0.5, summaryY - 0.5, summaryX + summaryWidth - 0.5, summaryY - 0.5);
        summaryY += 1.5;

        // Total destacado con fondo
        doc.setFillColor(...colors.secondary);
        doc.roundedRect(summaryX - 0.5, summaryY - 2.5, summaryWidth + 1, 4, 0.5, 0.5, 'F');

        doc.setTextColor(...colors.white);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(9);
        doc.text('TOTAL:', summaryX + 1.5, summaryY);
        doc.text(
            document.getElementById('vn-fac-importe-display')?.textContent || '$0.00',
            summaryX + summaryWidth - 1.5,
            summaryY,
            { align: 'right' }
        );
    }

    // ============ FUNCIÓN: CONDICIONES DE PAGO ============
    function drawPaymentConditionsFactura(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue) {
        const getSelectedText = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            if (!el) return defaultVal;
            const selected = el.options[el.selectedIndex];
            return selected?.text?.trim() || defaultVal;
        };

        // Título
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(10);
        doc.setTextColor(...colors.primary);
        doc.text('CONDICIONES', margin, y);

        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(1.2);
        doc.line(margin, y + 1.2, margin + 30, y + 1.2);
        y += 5;

        // Caja de condiciones
        const condHeight = tipoFactura === 'credito' ? 12 : 9;
        doc.setFillColor(...colors.white);
        doc.setDrawColor(...colors.border);
        doc.setLineWidth(0.4);
        doc.roundedRect(margin, y, pageWidth - 2 * margin, condHeight, 1.5, 1.5, 'FD');

        y += 3;

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);
        doc.setTextColor(...colors.text);

        if (tipoFactura === 'contado') {
            drawLabelValueFactura(doc, colors, 'Forma de Pago:', getTomSelectText('vn-fac-forma-pago'), margin + 2.5, y);
            drawLabelValueFactura(doc, colors, 'Método:', getSelectedText('vn-fac-metodo-pago'), margin + 55, y);
            drawLabelValueFactura(doc, colors, 'CFDI:', getTomSelectText('vn-fac-uso-cfdi'), pageWidth - margin - 45, y);

        } else if (tipoFactura === 'credito') {
            drawLabelValueFactura(doc, colors, 'Forma de Pago:', getTomSelectText('vn-fac-forma-pago'), margin + 2.5, y);
            drawLabelValueFactura(doc, colors, 'Método:', getSelectedText('vn-fac-metodo-pago'), margin + 55, y);
            drawLabelValueFactura(doc, colors, 'Plazo:', `${getValue('vn-fac-plazo')} días`, pageWidth - margin - 45, y);

            y += 3.5;

            drawLabelValueFactura(doc, colors, 'Vencimiento:', getValue('vn-fac-fecha-pago'), margin + 2.5, y);
            drawLabelValueFactura(doc, colors, 'CFDI:', getTomSelectText('vn-fac-uso-cfdi'), pageWidth - margin - 45, y);

        } else if (tipoFactura === 'anticipo') {
            drawLabelValueFactura(doc, colors, 'Forma de Pago:', getTomSelectText('vn-fac-forma-pago'), margin + 2.5, y);
            drawLabelValueFactura(doc, colors, 'Método:', getSelectedText('vn-fac-metodo-pago'), margin + 55, y);
            drawLabelValueFactura(doc, colors, 'CFDI:', getTomSelectText('vn-fac-uso-cfdi'), pageWidth - margin - 45, y);
        }

        return y + condHeight - 1;
    }

    // ============ FUNCIÓN: DIBUJAR LABEL Y VALOR ============
    function drawLabelValueFactura(doc, colors, label, value, x, y) {
        doc.setFont('helvetica', 'bold');
        doc.setTextColor(...colors.primary);
        doc.text(label, x, y);

        doc.setFont('helvetica', 'normal');
        doc.setTextColor(...colors.text);
        doc.text(value, x + doc.getTextWidth(label) + 2, y);
    }

    // ============ FUNCIÓN: COMENTARIOS ============
    function drawCommentsFactura(doc, colors, margin, pageWidth, pageHeight, y, getValue) {
        const comentarios = getValue('vn-fac-comentarios', '');

        if (comentarios && y < pageHeight - 18) {
            y += 4;

            // Título
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(10);
            doc.setTextColor(...colors.primary);
            doc.text('NOTAS', margin, y);

            doc.setDrawColor(...colors.secondary);
            doc.setLineWidth(1.2);
            doc.line(margin, y + 1.2, margin + 15, y + 1.2);
            y += 4;

            // Caja de comentarios
            const splitComments = doc.splitTextToSize(comentarios, pageWidth - 2 * margin - 4);
            const commentHeight = Math.min(splitComments.length * 3 + 3, pageHeight - y - 12);

            doc.setFillColor(...colors.white);
            doc.setDrawColor(...colors.border);
            doc.setLineWidth(0.4);
            doc.roundedRect(margin, y, pageWidth - 2 * margin, commentHeight, 1.5, 1.5, 'FD');

            doc.setFont('helvetica', 'normal');
            doc.setFontSize(7);
            doc.setTextColor(...colors.text);
            doc.text(splitComments, margin + 2, y + 3, { maxWidth: pageWidth - 2 * margin - 4 });
        }

        return y;
    }

    // ============ FUNCIÓN: FOOTER ============
    function drawFooterFactura(doc, colors, margin, pageWidth, pageHeight) {
        doc.setDrawColor(...colors.primary);
        doc.setLineWidth(0.6);
        doc.line(0, pageHeight - 8, pageWidth, pageHeight - 8);

        doc.setFont('helvetica', 'normal');
        doc.setFontSize(6);
        doc.setTextColor(...colors.text);
        doc.text('Generado automáticamente • Confidencial', margin, pageHeight - 4);
        doc.text(
            new Date().toLocaleString('es-MX'),
            pageWidth - margin,
            pageHeight - 4,
            { align: 'right' }
        );
    }
</script>

<script>
    const chkOrdenCompraFac = document.getElementById("vn-fac-orden-compra-check");
    const inputOrdenCompraFac = document.getElementById("vn-fac-orden-compra-val");

    chkOrdenCompraFac.addEventListener("change", () => {
        if (chkOrdenCompraFac.checked) {
            inputOrdenCompraFac.classList.remove("d-none");
        } else {
            inputOrdenCompraFac.classList.add("d-none");
            inputOrdenCompraFac.value = "";
        }
    });
</script>