        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        z-index: 1;
    }

    .toggle-labels {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        pointer-events: none;
        padding: 0;
    }

    .toggle-label {
        font-size: 10.5px;
        font-weight: 700;
        color: #94a3b8;
        transition: all 0.3s ease;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        text-shadow: 0 1px 2px rgba(255,255,255,0.8);
        flex: 1;
