<script>
    // Solo 2 estados en el toggle (como industrial): Contado / Crédito.
    // El estado "anticipo" sigue soportado por aplicarEstadoPagoFactura pero ya
    // no forma parte del ciclo del toggle.
    let paymentStates2Factura = ['contado', 'credito'];
    let currentStateIndex2Factura = 0;

    // Selección directa desde los botones-píldora del toggle.
    function selectTipoPagoFac(val, event) {
        event?.preventDefault();
        event?.stopPropagation();
        aplicarEstadoPagoFactura(val);
    }

    // Compatibilidad: el toggle cíclico anterior sigue disponible por si algún
    // código externo lo invoca.
    function toggleCreditoContadoFactura() {
        currentStateIndex2Factura = (currentStateIndex2Factura + 1) % paymentStates2Factura.length;
        aplicarEstadoPagoFactura(paymentStates2Factura[currentStateIndex2Factura]);
    }

    // Aplica un estado de pago concreto (contado | credito | anticipo): sincroniza el
    // índice del ciclo, el data-state del toggle, la visibilidad de secciones y la
    // preselección del método de pago. Se usa desde el toggle, al iniciar y al cargar
    // un documento, para que todo quede siempre consistente.
    function aplicarEstadoPagoFactura(newState) {
        const toggle = document.getElementById('vn-fac-toggle-pago');
        const camposCredito = document.getElementById('vn-fac-campos-credito');
        const camposAnticipo = document.getElementById('vn-fac-campos-anticipo');
        const seccionProductos = document.getElementById('vn-fac-seccion-productos');
        const fleteval = document.getElementById('vn-fac-flete-val');
        const tAnticipo = document.getElementById('tabla-anticipo');
        const btnAnticipo = document.getElementById('btn-anticipos');
        const totalAnticipo = document.getElementById('total-anticipo');

        // Mantener el índice del ciclo alineado con el estado aplicado.
        const idx = paymentStates2Factura.indexOf(newState);
        if (idx >= 0) currentStateIndex2Factura = idx;

        if (toggle) toggle.setAttribute('data-state', newState);

        // Sincronizar los botones-píldora del toggle con el estado aplicado.
        document.querySelectorAll('#vn-fac-toggle-pago .vi-pay-btn')
            .forEach(b => b.classList.toggle('active', b.dataset.val === newState));

        if (camposCredito) camposCredito.style.display = 'none';
        if (camposAnticipo) camposAnticipo.style.display = 'none';

        if (newState === 'contado') {
            limpiarCamposFactura();
            if (seccionProductos) seccionProductos.style.display = '';
            if (tAnticipo) tAnticipo.style.display = '';
            if (btnAnticipo) btnAnticipo.style.display = '';
            if (totalAnticipo) totalAnticipo.style.display = '';
        } else if (newState === 'credito') {
            if (camposCredito) camposCredito.style.display = 'block';
            if (tAnticipo) tAnticipo.style.display = 'none';
            if (btnAnticipo) btnAnticipo.style.display = 'none';
            if (totalAnticipo) totalAnticipo.style.display = 'none';
            limpiarCamposAnticipoFactura();
            if (seccionProductos) seccionProductos.style.display = '';
        } else if (newState === 'anticipo') {
            if (camposAnticipo) camposAnticipo.style.display = 'block';
            limpiarCamposCreditoFactura();
            if (seccionProductos) seccionProductos.style.display = 'none';
            if (tAnticipo) tAnticipo.style.display = 'none';
            if (btnAnticipo) btnAnticipo.style.display = 'none';
            if (totalAnticipo) totalAnticipo.style.display = 'none';
            if (fleteval) fleteval.value = 0;
        }

        // ★ Preseleccionar el método de pago según el tipo:
        //   contado/anticipo → PUE (una sola exhibición), crédito → PPD (parcialidades/diferido).
        setMetodoPagoSegunTipoView(newState);

        // El crédito solo se valida en ventas a crédito.
        window.CreditoVentas?.evaluar('vn-fac');
    }

    // Preselecciona (y bloquea) el método de pago según el estado del toggle. El select
    // queda deshabilitado porque lo gobierna el toggle; aun así se envía, porque el JS de
    // la factura lee su .value directamente (no depende del submit nativo del form).
    function setMetodoPagoSegunTipoView(estado) {
        const select = document.getElementById('vn-fac-metodo-pago');
        if (!select) return;
        const mapa = { contado: 'PUE', credito: 'PPD', anticipo: 'PUE' };
        const valor = mapa[estado] || 'PUE';

        select.removeAttribute('disabled');
        // Iterar en vez de .value es más confiable con selects deshabilitados.
        Array.from(select.options).forEach(opt => { opt.selected = opt.value === valor; });
        select.setAttribute('disabled', 'disabled');
    }

    // Estado inicial: contado → método PUE preseleccionado.
    document.addEventListener('DOMContentLoaded', () => setMetodoPagoSegunTipoView('contado'));

    function limpiarCamposFactura() {
        limpiarCamposCreditoFactura();
        limpiarCamposAnticipoFactura();
    }

    function limpiarCamposCreditoFactura() {
        document.getElementById('vn-fac-limite-credito').value = '0.00';
        document.getElementById('vn-fac-plazo').value = '';
        document.getElementById('vn-fac-fecha-pago').value = '';
    }

    function limpiarCamposAnticipoFactura() {
        document.getElementById('vn-fac-porcentaje-anticipo').value = '';
        document.getElementById('vn-fac-monto-anticipo').value = '';
        document.getElementById('vn-fac-saldo-pendiente').value = '';
        document.getElementById('vn-fac-fecha-anticipo').value = '';
        document.getElementById('vn-fac-fecha-pago-final').value = '';
    }

    function calcularAnticipoFactura() {
        const porcentaje = parseFloat(document.getElementById('vn-fac-porcentaje-anticipo').value) || 0;
        // Obtener el total desde tu campo de importe total
        const totalVenta = parseFloat(document.getElementById('vn-fac-importe').value) || 0;

        const montoAnticipo = (totalVenta * porcentaje) / 100;
        const saldoPendiente = totalVenta - montoAnticipo;

        document.getElementById('vn-fac-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vn-fac-saldo-pendiente').value = saldoPendiente.toFixed(2);
    }
</script>
<script>
    function actualizarVistaPreviaFactura() {
        console.log('Modal abierto - actualizando vista previa...');

        // === Helpers ===
        const getValue = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            return (el?.value ?? '').toString().trim() || defaultVal;
        };

        const getSelectedText = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            const selected = el?.options?.[el.selectedIndex];
            return selected?.text?.trim() || defaultVal;
        };

        const setText = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        };

        const getDisplayValue = (id, defaultVal = '$0.00') => {
            const el = document.getElementById(id);
            return el?.textContent?.trim() || defaultVal;
        };

        // === TomSelect helper ===
        const getTomValueText = (key) => {
            const inst = tomManager.getInstance(key);
            const val = inst?.getValue();
            return inst?.getItem(val)?.textContent?.trim() || '';
        };

        const textVendedor = getTomValueText('vn-fac-vendedor');
        const textMoneda = getTomValueText('vn-fac-moneda');
        const textIncoterm = getTomValueText('vn-fac-incoterm');
        const textCFDI = getTomValueText('vn-fac-uso-cfdi');
        const textForma = getTomValueText('vn-fac-forma-pago');

        // === Info general y cliente ===
        setText('vn-fac-preview-folio', getValue('vn-fac-folio', 'Sin asignar'));
        setText('vn-fac-preview-sucursal', getSelectedText('vn-fac-sucursal', 'CEDIS'));
        const hoy = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' });
        setText('vn-fac-preview-fecha', hoy);

        setText('vn-fac-preview-cliente', getValue('vn-fac-cliente'));
        setText('vn-fac-preview-rfc', getValue('vn-fac-rfc'));
        setText('vn-fac-preview-vendedor', textVendedor);
        setText('vn-fac-preview-moneda', textMoneda);
        setText('vn-fac-preview-incoterm', textIncoterm);
        setText('vn-fac-preview-concepto', getValue('vn-fac-concepto'));

        // === Productos: helpers que permiten re-render seguro ===
        const productosTable = document.getElementById('vn-fac-productosTable');
        // seccionProductos: contenedor general donde están la tabla/tbody de preview y la vista de anticipo
        const previewProductos = document.getElementById('vn-fac-preview-productos');

        // Buscar o crear un contenedor para el mensaje de anticipo (no sobrescribe el DOM principal)
        const seccionProductos = previewProductos ? previewProductos.closest('div') : document.getElementById('vn-fac-preview-productos-container') || null;
        let anticipoDiv = seccionProductos ? seccionProductos.querySelector('.vn-fac-anticipo-info') : null;

        if (seccionProductos && !anticipoDiv) {
            // crear anticipoDiv (inserta al principio del contenedor, oculto por defecto)
            anticipoDiv = document.createElement('div');
            anticipoDiv.className = 'vn-fac-anticipo-info';
            anticipoDiv.style.display = 'none';
            seccionProductos.insertBefore(anticipoDiv, seccionProductos.firstChild);
        }

        // función que renderiza la tabla/tbody de productos desde productosTable
        function renderProductosPreview() {
            // Asegurarnos de que exista previewProductos; si no existe, intentar crearlo (tbody dentro de una tabla)
            let preview = document.getElementById('vn-fac-preview-productos');
            if (!preview && seccionProductos) {
                // crear una tabla simple con tbody#vn-fac-preview-productos
                const table = document.createElement('table');
                table.className = 'table table-sm';
                table.style.width = '100%';
                const thead = document.createElement('thead');
                thead.innerHTML = `<tr>
                <th>Clave</th><th>Descripción</th><th>Cant.</th><th>UM</th><th>Precio</th><th>% Desc</th><th>Importe</th>
            </tr>`;
                table.appendChild(thead);
                const tbody = document.createElement('tbody');
                tbody.id = 'vn-fac-preview-productos';
                table.appendChild(tbody);
                seccionProductos.appendChild(table);
                preview = tbody;
            }

            if (!preview) return; // no hay donde renderizar

            // Vaciar y volver a generar
            preview.innerHTML = '';

            if (!productosTable) {
                preview.innerHTML = `
                <tr>
                    <td colspan="7" style="padding:2rem; text-align:center; color:#999; border:1px solid #ddd">
                        No hay productos agregados
                    </td>
                </tr>`;
                return;
            }

            const rows = Array.from(productosTable.querySelectorAll('tr')).filter(r => !r.classList.contains('vn-fac-empty-state'));
            if (rows.length === 0) {
                preview.innerHTML = `
                <tr>
                    <td colspan="7" style="padding:2rem; text-align:center; color:#999; border:1px solid #ddd">
                        No hay productos agregados
                    </td>
                </tr>`;
                return;
            }

            rows.forEach(row => {
                const cols = row.querySelectorAll('td');
                if (cols.length >= 8) {
                    const tr = document.createElement('tr');
                    tr.innerHTML = `
                    <td style="padding:.5rem; border:1px solid #ddd;">${cols[0]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; border:1px solid #ddd;">${cols[1]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; text-align:center; border:1px solid #ddd;">${cols[3]?.querySelector('input')?.value || '0'}</td>
                    <td style="padding:.5rem; text-align:center; border:1px solid #ddd;">${cols[4]?.textContent?.trim() || '-'}</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">$${cols[5]?.querySelector('input')?.value || '0.00'}</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">${cols[6]?.querySelector('input')?.value || '0'}%</td>
                    <td style="padding:.5rem; text-align:right; border:1px solid #ddd;">${cols[7]?.textContent?.trim() || '$0.00'}</td>
                `;
                    preview.appendChild(tr);
                }
            });
        }

        // === Totales ===
        setText('vn-fac-preview-subtotal1', getDisplayValue('vn-fac-total-subtotal1-display'));
        setText('vn-fac-preview-descuento', getDisplayValue('vn-fac-total-descuento-display'));
        setText('vn-fac-preview-flete', getDisplayValue('vn-fac-total-flete-display'));
        setText('vn-fac-preview-subtotal2', getDisplayValue('vn-fac-total-subtotal2-display'));
        setText('vn-fac-preview-iva', getDisplayValue('vn-fac-iva-display'));
        setText('vn-fac-preview-total', getDisplayValue('vn-fac-importe-display'));

        // === Condiciones de pago ===
        setText('vn-fac-preview-forma-pago', textForma);
        setText('vn-fac-preview-metodo-pago', getSelectedText('vn-fac-metodo-pago'));
        setText('vn-fac-preview-plazo', getValue('vn-fac-plazo'));
        setText('vn-fac-preview-fecha-pago', getValue('vn-fac-fecha-pago'));
        setText('vn-fac-preview-uso-cfdi', textCFDI);

        // === Comentarios ===
        const comentarios = getValue('vn-fac-comentarios', '');
        const comentariosSection = document.getElementById('vn-fac-preview-comentarios-section');
        const comentariosText = document.getElementById('vn-fac-preview-comentarios');
        if (comentarios && comentariosSection && comentariosText) {
            comentariosSection.style.display = 'block';
            comentariosText.textContent = comentarios;
        } else if (comentariosSection) {
            comentariosSection.style.display = 'none';
        }

        // === Tipo de factura y comportamiento ===
        const tipoFactura = document.getElementById('vn-fac-toggle-pago')?.getAttribute('data-state') || 'contado';

        const campoPlazo = document.querySelector('#vn-fac-preview-plazo')?.parentElement || null;
        const campoFechaPago = document.querySelector('#vn-fac-preview-fecha-pago')?.parentElement || null;
        const campoFormaPago = document.querySelector('#vn-fac-preview-forma-pago')?.parentElement || null;

        // Mostrar todo por defecto
        [campoPlazo, campoFechaPago, campoFormaPago].forEach(c => { if (c) c.style.display = ''; });
        if (seccionProductos) seccionProductos.style.display = '';

        // ocultar anticipo div por defecto y luego lo mostraremos sólo si aplica
        if (anticipoDiv) anticipoDiv.style.display = 'none';

        if (tipoFactura === 'contado') {
            if (campoPlazo) campoPlazo.style.display = 'none';
            if (campoFechaPago) campoFechaPago.style.display = 'none';
            // mostrar productos
            if (seccionProductos) {
                // asegurarse de que la tabla de productos esté visible y actualizada
                renderProductosPreview();
                if (previewProductos) previewProductos.style.display = '';
            }
        } else if (tipoFactura === 'anticipo') {
            // ocultar campos de plazo/fecha
            if (campoPlazo) campoPlazo.style.display = 'none';
            if (campoFechaPago) campoFechaPago.style.display = 'none';

            // mostrar mensaje de anticipo y ocultar la tabla de productos
            const montoAnt = parseFloat(getValue('vn-fac-monto-anticipo') || 0);
            if (anticipoDiv && seccionProductos) {
                anticipoDiv.innerHTML = `
                <div class="text-center my-4 p-4 border rounded shadow-sm bg-light">
                    <h5 class="fw-bold text-success mb-2">💰 Anticipo registrado</h5>
                    <p class="fs-5 mb-0" style="color:black">
                        Monto del anticipo: <strong>$${montoAnt.toLocaleString('es-MX', { minimumFractionDigits: 2 })} MXN</strong>
                    </p>
                </div>
            `;
                anticipoDiv.style.display = '';
            }
            // ocultar la tabla de productos si existe
            if (previewProductos) previewProductos.style.display = 'none';
        } else {
            // otro tipo: mostrar productos de nuevo
            renderProductosPreview();
            if (previewProductos) previewProductos.style.display = '';
        }

        console.log('Vista previa actualizada correctamente para tipo:', tipoFactura);
    }

</script>
<script>
    const chkFleteFactura = document.getElementById("vn-fac-flete");
    const inputFleteFactura = document.getElementById("vn-fac-flete-val");
    chkFleteFactura.addEventListener("change", () => {
        if (chkFleteFactura.checked) {
            inputFleteFactura.classList.remove("d-none"); // mostrar
        } else {
