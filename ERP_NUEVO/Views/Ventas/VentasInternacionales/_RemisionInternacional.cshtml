<script>
    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    function selectTipoPagoVinRem(val) {
        document.querySelectorAll('#vin-rem-toggle-pago .vi-pay-btn')
            .forEach(btn => btn.classList.toggle('active', btn.dataset.val === val));
        document.getElementById('vin-rem-tipo-pago').value = val;

        const camposCredito = document.getElementById('vin-rem-campos-credito');
        const camposAnticipo = document.getElementById('vin-rem-campos-anticipo');
        const secProductos = document.getElementById('vin-rem-seccion-productos');

        camposCredito.style.display = 'none';
        camposAnticipo.style.display = 'none';

        if (val === 'contado') {
            limpiarCamposRemision();
            secProductos.style.display = '';
        } else if (val === 'credito') {
            camposCredito.style.display = 'block';
            limpiarCamposAnticipoRemision();
            secProductos.style.display = '';
        } else if (val === 'anticipo') {
            camposAnticipo.style.display = 'block';
            limpiarCamposCreditoRemision();
            secProductos.style.display = 'none';
            document.getElementById('vin-rem-flete-val').value = 0;
        }
    }

    function limpiarCamposRemision() {
        limpiarCamposCreditoRemision();
        limpiarCamposAnticipoRemision();
    }

    function limpiarCamposCreditoRemision() {
        document.getElementById('vin-rem-limite-credito').value = '0.00';
        document.getElementById('vin-rem-plazo').value = '';
        document.getElementById('vin-rem-fecha-pago').value = '';
    }

    function limpiarCamposAnticipoRemision() {
        document.getElementById('vin-rem-porcentaje-anticipo').value = '';
        document.getElementById('vin-rem-monto-anticipo').value = '';
        document.getElementById('vin-rem-saldo-pendiente').value = '';
        document.getElementById('vin-rem-fecha-anticipo').value = '';
        document.getElementById('vin-rem-fecha-pago-final').value = '';
    }

    function calcularAnticipoRemision() {
        const porcentaje = parseFloat(document.getElementById('vin-rem-porcentaje-anticipo').value) || 0;
        const totalVenta = parseFloat(document.getElementById('vin-rem-importe').value) || 0;
        const montoAnticipo = (totalVenta * porcentaje) / 100;
        const saldoPendiente = totalVenta - montoAnticipo;
        document.getElementById('vin-rem-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vin-rem-saldo-pendiente').value = saldoPendiente.toFixed(2);
    }

    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vin-rem-flete').addEventListener('change', function () {
        const inp = document.getElementById('vin-rem-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vin-rem-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vin-rem-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>


