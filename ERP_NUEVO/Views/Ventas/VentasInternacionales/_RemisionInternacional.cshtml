@using BOS_ERP.Controllers
@model BOS_ERP.Models.FolioInfo

<style>
    /* ===== VARIABLES Y BASE (idénticas a vi-rem) ===== */
    :root {
        --vi-blue-50: #e1e7ef;
        --vi-blue-100: #c7d4e4;
        --vi-blue-600: #1e3a5f;
        --vi-blue-700: #0f1729;
        --vi-blue-800: #0f1729;
        --vi-green-50: #d1fae5;
        --vi-green-600: #059669;
        --vi-green-700: #047857;
        --vi-red-50: #fee2e2;
        --vi-red-600: #dc2626;
        --vi-amber-50: #fef3c7;
        --vi-amber-600: #d97706;
        --vi-gray-50: #f8fafc;
        --vi-gray-100: #f8fafc;
        --vi-gray-200: #e2e8f0;
        --vi-gray-400: #94a3b8;
        --vi-gray-600: #64748b;
        --vi-gray-800: #0f172a;
        --vi-radius: 10px;
        --vi-radius-lg: 16px;
        --vi-shadow: 0 1px 3px 0 rgba(0,0,0,.1), 0 1px 2px 0 rgba(0,0,0,.06);
        --vi-shadow-md: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -2px rgba(0,0,0,.05);
    }

    [data-theme="dark"] {
        --vi-blue-50: #334155;
        --vi-blue-100: #475569;
        --vi-blue-600: #475569;
        --vi-blue-700: #cbd5e1;
        --vi-blue-800: #f1f5f9;
        --vi-green-50: #064e3b;
        --vi-green-600: #10b981;
        --vi-green-700: #34d399;
        --vi-red-50: #450a0a;
        --vi-red-600: #ef4444;
        --vi-amber-50: #451a03;
        --vi-amber-600: #f59e0b;
        --vi-gray-50: #1e293b;
        --vi-gray-100: #1e293b;
        --vi-gray-200: #475569;
        --vi-gray-400: #8191a7;
        --vi-gray-600: #cbd5e1;
        --vi-gray-800: #f1f5f9;
        --vi-shadow: 0 1px 3px 0 rgba(0,0,0,.3), 0 1px 2px 0 rgba(0,0,0,.2);
        --vi-shadow-md: 0 10px 15px -3px rgba(0,0,0,.3), 0 4px 6px -2px rgba(0,0,0,.2);
    }

    /* ===== LAYOUT DE PÁGINA ===== */
    .vi-page {
        background: var(--vi-gray-100);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    /* ===== TARJETA PRINCIPAL ===== */
    .vi-card {
        background: var(--bg-light, #fff);
        border-radius: var(--vi-radius-lg);
        border: 1px solid var(--vi-gray-200);
        box-shadow: var(--vi-shadow-md);
        overflow: hidden;
    }

    /* ===== CABECERA DE SECCIÓN ===== */
    .vi-section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-bottom: .75rem;
        border-bottom: 2px solid var(--vi-blue-50);
        margin-bottom: 1.25rem;
    }

    .vi-section-icon {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 10px;
        background: var(--vi-blue-600);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .vi-section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--vi-gray-800);
        margin: 0;
    }

    /* ===== CAMPOS DE FORMULARIO ===== */
    .vi-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        margin-bottom: .3rem;
        display: block;
    }

        .vi-label i {
            color: #3b82f6;
            margin-right: .3rem;
        }

    .vi-control {
        border: 1.5px solid var(--vi-gray-200);
        border-radius: var(--vi-radius);
        padding: .65rem 1rem;
        font-size: .9rem;
        background: var(--vi-gray-50);
        color: var(--vi-gray-800);
        width: 100%;
        transition: border-color .2s, box-shadow .2s;
    }

        .vi-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            outline: none;
            background: var(--bg-light, #fff);
        }

        .vi-control[readonly] {
            background: var(--vi-gray-100);
            cursor: default;
        }

    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    .vi-pay-toggle {
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        background: var(--vi-gray-100);
        border: 1px solid var(--vi-gray-200);
        border-radius: var(--vi-radius);
        padding: 4px;
    }

    .vi-pay-btn {
        position: relative;
        border: none;
        border-radius: 7px;
        padding: .55rem 1.25rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
        white-space: nowrap;
        transition: color .18s;
    }

        .vi-pay-btn .vi-pay-pill {
            position: absolute;
            inset: 0;
            border-radius: 7px;
            opacity: 0;
            pointer-events: none;
            transition: opacity .22s, background .22s;
        }

        .vi-pay-btn.active {
            color: var(--vi-blue-600);
        }

            .vi-pay-btn.active .vi-pay-pill {
                opacity: 1;
                background: var(--vi-blue-50);
            }

        .vi-pay-btn[data-val="credito"].active {
            color: var(--vi-green-700);
        }

            .vi-pay-btn[data-val="credito"].active .vi-pay-pill {
                background: var(--vi-green-50);
            }

        .vi-pay-btn[data-val="anticipo"].active {
            color: var(--vi-amber-600);
        }

            .vi-pay-btn[data-val="anticipo"].active .vi-pay-pill {
                background: var(--vi-amber-50);
            }

        .vi-pay-btn i, .vi-pay-btn span {
            position: relative;
            z-index: 1;
        }

    /* ===== TABLA PRODUCTOS ===== */
    .vi-table-wrap {
        border-radius: var(--vi-radius);
        border: 1px solid var(--vi-gray-200);
        overflow: hidden;
        overflow-x: auto;
        max-height: 420px;
        overflow-y: auto;
    }

    .vi-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1100px;
        font-size: .82rem;
    }

        .vi-table thead {
            background: var(--vi-blue-600);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .vi-table th {
            padding: .65rem .6rem;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
        }

        .vi-table td {
            padding: .65rem .6rem;
            border-bottom: 1px solid var(--vi-gray-200);
            vertical-align: middle;
            color: var(--vi-gray-800);
        }

        .vi-table tbody tr:hover {
            background: var(--vi-blue-50);
        }

    .vi-table-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--vi-gray-400);
    }

        .vi-table-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: .75rem;
            opacity: .35;
        }

    /* ===== BOTONES ===== */
    .vi-btn {
        border: none;
        border-radius: var(--vi-radius);
        padding: .6rem 1.25rem;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s, background .2s;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .vi-btn:hover {
            transform: translateY(-1px);
        }

    .vi-btn-primary {
        background: var(--vi-blue-600);
        color: #fff;
    }

        .vi-btn-primary:hover {
            background: var(--vi-blue-700);
            box-shadow: 0 4px 14px rgba(30,58,95,.3);
        }

    .vi-btn-success {
        background: var(--vi-green-600);
        color: #fff;
    }

        .vi-btn-success:hover {
            background: var(--vi-green-700);
            box-shadow: 0 4px 14px rgba(5,150,105,.3);
        }

    .vi-btn-danger {
        background: var(--vi-red-600);
        color: #fff;
        padding: .35rem .75rem;
        font-size: .8rem;
    }

        .vi-btn-danger:hover {
            background: #b91c1c;
        }

    .vi-btn-outline {
        background: transparent;
        color: #3b82f6;
        border: 1.5px solid #3b82f6;
    }

        .vi-btn-outline:hover {
            background: #3b82f6;
            color: #fff;
        }

    .vi-btn-ghost {
        background: transparent;
        color: var(--vi-red-600);
        border: 1.5px solid var(--vi-red-600);
    }

        .vi-btn-ghost:hover {
            background: var(--vi-red-600);
            color: #fff;
        }

    /* ===== TOGGLE SWITCH ===== */
    .vi-switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .vi-switch-track {
        position: relative;
        width: 52px;
        height: 28px;
        border-radius: 99px;
        background: var(--vi-gray-200);
        transition: background .3s;
        flex-shrink: 0;
    }

        .vi-switch-track::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 3px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
            transition: transform .3s;
        }

    .vi-switch input {
        display: none;
    }

        .vi-switch input:checked ~ .vi-switch-track {
            background: var(--vi-green-600);
        }

            .vi-switch input:checked ~ .vi-switch-track::after {
                transform: translateX(24px);
            }

    .vi-switch-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        user-select: none;
    }

    /* ===== SEPARADOR ===== */
    .vi-sep {
        border: none;
        border-top: 1px dashed var(--vi-gray-200);
        margin: 1.25rem 0;
    }

    /* ===== MODAL ===== */
    .vi-modal-header {
        background: var(--vi-blue-600);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vi-modal-header .btn-close {
            filter: invert(1);
        }

    /* ===== SEARCH RESULT ITEM ===== */
    .vi-search-item {
        padding: .7rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--vi-gray-200);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color .2s, background .2s, transform .15s;
        background: var(--bg-light, #fff);
        color: var(--vi-gray-800);
    }

        .vi-search-item:hover {
            border-color: #3b82f6;
            background: var(--vi-blue-50);
            transform: translateX(3px);
        }

    /* ===== UTILIDADES ===== */
    .vi-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .2rem .6rem;
        border-radius: 99px;
    }

    .vi-badge-blue {
        background: var(--vi-blue-50);
        color: var(--vi-blue-600);
    }

    .vi-badge-green {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    /* ===== BOTÓN FLOTANTE ===== */
    .vi-floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--vi-blue-600);
        color: #fff;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(30,58,95,.4);
        transition: transform .3s, box-shadow .3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .vi-floating-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(30,58,95,.5);
        }

    .vi-floating-tooltip {
        position: fixed;
        bottom: 38px;
        right: 96px;
        background: var(--vi-gray-800);
        color: #fff;
        padding: .4rem .9rem;
        border-radius: 8px;
        font-size: .8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s;
        z-index: 999;
    }

    .vi-floating-btn:hover + .vi-floating-tooltip {
        opacity: 1;
    }

    /* ===== DOCUMENT BADGE ===== */
    .document-badge {
        display: inline-block;
        padding: .2rem .7rem;
        border-radius: 99px;
        font-size: .7rem;
        font-weight: 700;
    }

    .badge-pending {
        background: var(--vi-amber-50);
        color: var(--vi-amber-600);
    }

    .badge-approved {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    .badge-cancelled {
        background: var(--vi-red-50);
        color: var(--vi-red-600);
    }

    /* ===== DELETE BTN ===== */
    .vi-rem-btn-delete {
        background: var(--vi-red-600);
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: .35rem .75rem;
        font-size: .8rem;
        cursor: pointer;
        transition: background .2s, transform .15s;
    }

        .vi-rem-btn-delete:hover {
            background: #b91c1c;
            transform: translateY(-1px);
        }

        .vi-rem-btn-delete:active {
            transform: scale(.96);
        }

        .vi-rem-btn-delete:disabled {
            background: #bdbdbd;
            cursor: not-allowed;
            opacity: .7;
        }
</style>

@{var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS"); }

<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nueva Remisión Internacional</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar la remisión</p>
            </div>
        </div>

        <form id="vin-rem-formCotizacion" class="vin-rem-formCotizacion" method="post">

            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-12">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vi-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vin-rem-tipo-pago" value="contado">
                        <div class="vi-pay-toggle" id="vin-rem-toggle-pago">
                            <button type="button" class="vi-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoVinRem('contado')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vi-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoVinRem('credito')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vi-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vin-rem-folio" value="@Model.Folio" name="folio"
                                       class="vi-control" readonly autocomplete="off">
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-building"></i>Sucursal</label>
                                <select class="vi-control form-select" id="vin-rem-sucursal" name="sucursal">
                                    <option selected>CEDIS</option>
                                    <option>Sucursal Centro</option>
                                    <option>Sucursal Norte</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-warehouse"></i>Almacén</label>
                                <select class="vi-control form-select" id="vin-rem-almacen" name="almacen">
                                    <option selected>ALMACÉN GENERAL</option>
                                    <option>ALMACÉN A</option>
                                    <option>ALMACÉN B</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vi-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vin-rem-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vi-control" id="vin-rem-cliente"
                                           placeholder="Seleccione un cliente…"
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vin-rem-rfc" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Info adicional -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vi-control" id="vin-rem-info-proveedor" rows="3" readonly autocomplete="off"></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vi-control form-select" name="vendedor" id="vin-rem-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vi-control form-select" name="moneda" id="vin-rem-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vin-rem-paridad" name="paridad" class="vi-control" value="1" autocomplete="off">
                            </div>

                            <!-- Referencia -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-comment"></i>Referencia</label>
                                <input type="text" id="vin-rem-concepto" name="concepto" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Incoterm — oculto, ID intacto -->
                            <div class="col-12 d-none">
                                <label class="vi-label"><i class="fas fa-shipping-fast"></i>Incoterm</label>
                                <select class="vi-control form-select" name="incoterm" id="vin-rem-incoterm">
                                    <option selected disabled>Seleccionar Incoterm</option>
                                    <option value="EXW">EXW – En fábrica</option>
                                    <option value="FOB">FOB – Libre a bordo</option>
                                    <option value="CFR">CFR – Costo y flete</option>
                                    <option value="CIF">CIF – Costo, seguro y flete</option>
                                    <option value="DAP">DAP – Entregado en lugar</option>
                                    <option value="DDP">DDP – Entregado con derechos pagados</option>
                                </select>
                            </div>
                        </div>
                    </div><!-- /tarjeta cliente -->
                    <!-- TARJETA: Artículos -->
                    <div class="vi-card p-4 mb-4" id="vin-rem-seccion-productos">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-box-open"></i></div>
                            <h2 class="vi-section-title">Artículos y Productos</h2>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
                            <span class="vi-badge vi-badge-blue">
                                <i class="fas fa-list"></i> Lista de productos
                            </span>
                            <div class="d-flex gap-2 flex-wrap">
                                <button type="button" class="vi-btn"
                                        id="vin-rem-btn-validar-fracciones"
                                        style="background:var(--vi-amber-50);color:var(--vi-amber-600);
                       border:1.5px solid var(--vi-amber-600);"
                                        onclick="RemisionesApp.validarFraccionesArancelarias()">
                                    <i class="fas fa-shield-alt"></i> Validar Fracción Arancelaria
                                </button>
                                <button type="button" class="vi-btn vi-btn-success"
                                        data-bs-toggle="modal" data-bs-target="#vin-rem-modalBuscarProducto">
                                    <i class="fas fa-plus"></i> Agregar producto
                                </button>
                            </div>
                        </div>

                        <div class="vi-table-wrap">
                            <table class="vi-table">
                                <thead>
                                    <tr>
                                        <th>#</th>
