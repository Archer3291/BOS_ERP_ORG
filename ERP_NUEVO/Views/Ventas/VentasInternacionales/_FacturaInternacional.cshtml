<script src="~/Scripts/Facturas/manejo-respuestas.js"></script>
<script>

    /* ===== TOGGLE TIPO PAGO — 3 estados: contado / credito / anticipo ===== */
    function selectTipoPagoVIN(val, event) {
        event?.preventDefault();
        event?.stopPropagation();

        document.querySelectorAll('#vin-fac-toggle-pago .vi-pay-btn')
            .forEach(b => b.classList.toggle('active', b.dataset.val === val));

        document.getElementById('vin-fac-toggle-pago').setAttribute('data-state', val);
        document.getElementById('vin-fac-tipo-pago-hidden-state').value = val;

        const camposCredito = document.getElementById('vin-fac-campos-credito');
        const camposAnticipo = document.getElementById('vin-fac-campos-anticipo');
        const secProductos = document.getElementById('vin-fac-seccion-productos');
        const tAnticipo = document.getElementById('tabla-anticipo');
        const btnAnticipo = document.getElementById('btn-anticipos');
        const totalAnticipo = document.getElementById('total-anticipo');
        const fleteval = document.getElementById('vin-fac-flete-val');

        camposCredito.style.display = 'none';
        camposAnticipo.style.display = 'none';

        if (val === 'contado') {
            limpiarCamposFactura();
            secProductos.style.display = '';
            tAnticipo.style.display = '';
            btnAnticipo.style.display = '';
            totalAnticipo.style.display = '';
        } else if (val === 'credito') {
            camposCredito.style.display = 'block';
            tAnticipo.style.display = 'none';
            btnAnticipo.style.display = 'none';
            totalAnticipo.style.display = 'none';
            limpiarCamposAnticipoFactura();
            secProductos.style.display = '';
        } else if (val === 'anticipo') {
            camposAnticipo.style.display = 'block';
            limpiarCamposCreditoFactura();
            secProductos.style.display = 'none';
            tAnticipo.style.display = 'none';
            btnAnticipo.style.display = 'none';
            totalAnticipo.style.display = 'none';
            if (fleteval) fleteval.value = 0;
        }

        setMetodoPagoSegunTipoVIN(val);
    }

    /* Compatibilidad con código externo que llame toggleCreditoContadoFactura() */
    let paymentStates2Factura = ['contado', 'credito', 'anticipo'];
    let currentStateIndex2Factura = 0;
    function toggleCreditoContadoFactura() {
        currentStateIndex2Factura = (currentStateIndex2Factura + 1) % paymentStates2Factura.length;
        selectTipoPagoVIN(paymentStates2Factura[currentStateIndex2Factura]);
    }

    function setMetodoPagoSegunTipoVIN(estado) {
        const hidden = document.getElementById('vin-fac-metodo-pago-hidden');
        const select = document.getElementById('vin-fac-metodo-pago');
        const mapa = { contado: 'PUE', credito: 'PPD', anticipo: 'PUE' };
        const valor = mapa[estado] || 'PUE';

        if (hidden) hidden.value = valor;
        if (select) {
            select.removeAttribute('disabled');
            Array.from(select.options).forEach(opt => { opt.selected = opt.value === valor; });
            select.setAttribute('disabled', 'disabled');
        }
    }

    function limpiarCamposFactura() { limpiarCamposCreditoFactura(); limpiarCamposAnticipoFactura(); }

    function limpiarCamposCreditoFactura() {
        document.getElementById('vin-fac-limite-credito').value = '0.00';
        document.getElementById('vin-fac-plazo').value = '';
        document.getElementById('vin-fac-fecha-pago').value = '';
    }

    function limpiarCamposAnticipoFactura() {
        document.getElementById('vin-fac-porcentaje-anticipo').value = '';
        document.getElementById('vin-fac-monto-anticipo').value = '';
        document.getElementById('vin-fac-saldo-pendiente').value = '';
        document.getElementById('vin-fac-fecha-anticipo').value = '';
        document.getElementById('vin-fac-fecha-pago-final').value = '';
    }

    function calcularAnticipoFactura() {
        const porcentaje = parseFloat(document.getElementById('vin-fac-porcentaje-anticipo').value) || 0;
        const totalVenta = parseFloat(document.getElementById('vin-fac-importe').value) || 0;
        const montoAnticipo = (totalVenta * porcentaje) / 100;
        document.getElementById('vin-fac-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vin-fac-saldo-pendiente').value = (totalVenta - montoAnticipo).toFixed(2);
    }

    /* ===== TOGGLE COMERCIO EXTERIOR ===== */
    function toggleCE() {
        const chk = document.getElementById('vin-fac-chk-ce');
        const campos = document.getElementById('vin-fac-campos-comercio-exterior');
        const alerta = document.getElementById('vin-fac-ce-alerta');
        const lbl = document.getElementById('vin-fac-lbl-ce');

        if (chk.checked) {
            campos.classList.remove('d-none');
            alerta.classList.add('d-none');
            lbl.textContent = 'Activo';
            lbl.className = 'badge bg-success';
            setCEFieldsRequired(true);
        } else {
            campos.classList.add('d-none');
            alerta.classList.remove('d-none');
            lbl.textContent = 'Inactivo';
            lbl.className = 'badge bg-secondary';
            setCEFieldsRequired(false);
        }
    }

    function setCEFieldsRequired(required) {
        ['vin-fac-incoterm', 'vin-fac-tipo-cambio-usd',
            'vin-fac-receptor-pais', 'vin-fac-receptor-cp'].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                required ? el.setAttribute('required', '') : el.removeAttribute('required');
            });
    }

    /* ===== ORDEN DE COMPRA ===== */
    document.getElementById('vin-fac-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vin-fac-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== INIT ===== */
    document.addEventListener('DOMContentLoaded', function () {
        const chk = document.getElementById('vin-fac-chk-ce');
        if (chk) {
            chk.addEventListener('change', toggleCE);
            setCEFieldsRequired(true);
        }
    });
</script>
