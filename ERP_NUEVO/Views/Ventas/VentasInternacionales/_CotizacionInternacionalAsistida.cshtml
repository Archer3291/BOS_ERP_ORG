@using BOS_ERP.Controllers
<style>
    :root {
        --vi-blue-50: #e1e7ef;
        --vi-blue-100: #c7d4e4;
        --vi-blue-600: #1e3a5f;
        --vi-blue-700: #0f1729;
        --vi-blue-800: #0f1729;
        --vi-green-50: #d1fae5;
        --vi-green-600: #059669;
        --vi-green-700: #047857;
        --vi-red-50: #fee2e2;
        --vi-red-600: #dc2626;
        --vi-amber-50: #fef3c7;
        --vi-amber-600: #d97706;
        --vi-purple-50: #ede9fe;
        --vi-purple-600: #7c3aed;
        --vi-purple-700: #6d28d9;
        --vi-gray-50: #f8fafc;
        --vi-gray-100: #f8fafc;
        --vi-gray-200: #e2e8f0;
        --vi-gray-400: #94a3b8;
        --vi-gray-600: #64748b;
        --vi-gray-800: #0f172a;
        --vi-radius: 10px;
        --vi-radius-lg: 16px;
        --vi-shadow: 0 1px 3px 0 rgba(0,0,0,.1), 0 1px 2px 0 rgba(0,0,0,.06);
        --vi-shadow-md: 0 10px 15px -3px rgba(0,0,0,.1), 0 4px 6px -2px rgba(0,0,0,.05);
    }

    [data-theme="dark"] {
        --vi-blue-50: #334155;
        --vi-blue-100: #475569;
        --vi-blue-600: #475569;
        --vi-blue-700: #cbd5e1;
        --vi-blue-800: #f1f5f9;
        --vi-green-50: #064e3b;
        --vi-green-600: #10b981;
        --vi-green-700: #34d399;
        --vi-red-50: #450a0a;
        --vi-red-600: #ef4444;
        --vi-amber-50: #451a03;
        --vi-amber-600: #f59e0b;
        --vi-purple-50: #2e1065;
        --vi-purple-600: #a78bfa;
        --vi-purple-700: #c4b5fd;
        --vi-gray-50: #1e293b;
        --vi-gray-100: #1e293b;
        --vi-gray-200: #475569;
        --vi-gray-400: #8191a7;
        --vi-gray-600: #cbd5e1;
        --vi-gray-800: #f1f5f9;
        --vi-shadow: 0 1px 3px 0 rgba(0,0,0,.3), 0 1px 2px 0 rgba(0,0,0,.2);
        --vi-shadow-md: 0 10px 15px -3px rgba(0,0,0,.3), 0 4px 6px -2px rgba(0,0,0,.2);
    }

    .vin-page {
        background: var(--vi-gray-100);
        min-height: 100vh;
        padding: 2rem 0 4rem;
    }

    .vin-card {
        background: var(--bg-light, #fff);
        border-radius: var(--vi-radius-lg);
        border: 1px solid var(--vi-gray-200);
        box-shadow: var(--vi-shadow-md);
        overflow: hidden;
    }

    .vin-section-header {
        display: flex;
        align-items: center;
        gap: .75rem;
        padding-bottom: .75rem;
        border-bottom: 2px solid var(--vi-blue-50);
        margin-bottom: 1.25rem;
    }

    .vin-section-icon {
        width: 2.25rem;
        height: 2.25rem;
        border-radius: 10px;
        background: var(--vi-blue-600);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

    .vin-section-title {
        font-size: 1.05rem;
        font-weight: 700;
        color: var(--vi-gray-800);
        margin: 0;
    }

    .vin-label {
        font-size: .8rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        margin-bottom: .3rem;
        display: block;
    }

        .vin-label i {
            color: #3b82f6;
            margin-right: .3rem;
        }

    .vin-control {
        border: 1.5px solid var(--vi-gray-200);
        border-radius: var(--vi-radius);
        padding: .65rem 1rem;
        font-size: .9rem;
        background: var(--vi-gray-50);
        color: var(--vi-gray-800);
        width: 100%;
        transition: border-color .2s, box-shadow .2s;
    }

        .vin-control:focus {
            border-color: #3b82f6;
            box-shadow: 0 0 0 3px rgba(59,130,246,.15);
            outline: none;
            background: var(--bg-light, #fff);
        }

        .vin-control[readonly] {
            background: var(--vi-gray-100);
            cursor: default;
        }

    /* Toggle tipo pago */
    .vin-pay-toggle {
        display: inline-grid;
        grid-template-columns: 1fr 1fr;
        gap: 4px;
        background: var(--vi-gray-100);
        border: 1px solid var(--vi-gray-200);
        border-radius: var(--vi-radius);
        padding: 4px;
    }

    .vin-pay-btn {
        position: relative;
        border: none;
        border-radius: 7px;
        padding: .55rem 1.5rem;
        font-size: .85rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        background: transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: 6px;
        justify-content: center;
        white-space: nowrap;
        transition: color .18s;
    }

        .vin-pay-btn .vin-pay-pill {
            position: absolute;
            inset: 0;
            border-radius: 7px;
            opacity: 0;
            pointer-events: none;
            transition: opacity .22s, background .22s;
        }

        .vin-pay-btn.active {
            color: var(--vi-blue-600);
        }

            .vin-pay-btn.active .vin-pay-pill {
                opacity: 1;
                background: var(--vi-blue-50);
            }

        .vin-pay-btn[data-val="credito"].active {
            color: var(--vi-green-700);
        }

            .vin-pay-btn[data-val="credito"].active .vin-pay-pill {
                background: var(--vi-green-50);
            }

        .vin-pay-btn i, .vin-pay-btn span {
            position: relative;
            z-index: 1;
        }

    /* Banner crédito */
    .vin-credit-banner {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 10px 14px;
        border-radius: var(--vi-radius);
        border: 1px solid;
        font-size: .8rem;
        margin-top: .75rem;
        transition: all .3s;
    }

        .vin-credit-banner.disponible {
            background: var(--vi-green-50);
            border-color: var(--vi-green-600);
            color: var(--vi-green-700);
        }

        .vin-credit-banner.por-vencer {
            background: var(--vi-amber-50);
            border-color: var(--vi-amber-600);
            color: var(--vi-amber-600);
        }

        .vin-credit-banner.excedido {
            background: var(--vi-red-50);
            border-color: var(--vi-red-600);
            color: var(--vi-red-600);
        }

        .vin-credit-banner.sin-limite {
            background: var(--vi-blue-50);
            border-color: #3b82f6;
            color: var(--vi-blue-600);
        }

    .vin-banner-bar-wrap {
        margin-top: 5px;
        height: 4px;
        border-radius: 99px;
        background: rgba(0,0,0,.1);
        overflow: hidden;
    }

    .vin-banner-bar-fill {
        height: 100%;
        border-radius: 99px;
    }

    .vin-credit-banner.disponible .vin-banner-bar-fill {
        background: var(--vi-green-600);
    }

    .vin-credit-banner.por-vencer .vin-banner-bar-fill {
        background: var(--vi-amber-600);
    }

    .vin-credit-banner.excedido .vin-banner-bar-fill {
        background: var(--vi-red-600);
    }

    /* Tabla */
    .vin-table-wrap {
        border-radius: var(--vi-radius);
        border: 1px solid var(--vi-gray-200);
        overflow: hidden;
        overflow-x: auto;
        max-height: 420px;
        overflow-y: auto;
    }

    .vin-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 1200px;
        font-size: .82rem;
    }

        .vin-table thead {
            background: var(--vi-blue-600);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 1;
        }

        .vin-table th {
            padding: .65rem .6rem;
            font-weight: 600;
            white-space: nowrap;
            text-align: left;
        }

        .vin-table td {
            padding: .65rem .6rem;
            border-bottom: 1px solid var(--vi-gray-200);
            vertical-align: middle;
            color: var(--vi-gray-800);
        }

        .vin-table tbody tr:hover {
            background: var(--vi-blue-50);
        }

    .vin-table-empty {
        text-align: center;
        padding: 3rem 1rem;
        color: var(--vi-gray-400);
    }

        .vin-table-empty i {
            font-size: 2.5rem;
            display: block;
            margin-bottom: .75rem;
            opacity: .35;
        }

    /* Botones */
    .vin-btn {
        border: none;
        border-radius: var(--vi-radius);
        padding: .6rem 1.25rem;
        font-weight: 600;
        font-size: .85rem;
        cursor: pointer;
        transition: transform .2s, box-shadow .2s, background .2s;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
    }

        .vin-btn:hover {
            transform: translateY(-1px);
        }

    .vin-btn-primary {
        background: var(--vi-blue-600);
        color: #fff;
    }

        .vin-btn-primary:hover {
            background: var(--vi-blue-700);
            box-shadow: 0 4px 14px rgba(30,58,95,.3);
        }

    .vin-btn-success {
        background: var(--vi-green-600);
        color: #fff;
    }

        .vin-btn-success:hover {
            background: var(--vi-green-700);
            box-shadow: 0 4px 14px rgba(5,150,105,.3);
        }

    .vin-btn-danger {
        background: var(--vi-red-600);
        color: #fff;
        padding: .35rem .75rem;
        font-size: .8rem;
    }

        .vin-btn-danger:hover {
            background: #b91c1c;
        }

    .vin-btn-purple {
        background: var(--vi-purple-600);
        color: #fff;
    }

        .vin-btn-purple:hover {
            background: var(--vi-purple-700);
            box-shadow: 0 4px 14px rgba(124,58,237,.3);
        }

    .vin-btn-outline {
        background: transparent;
        color: #3b82f6;
        border: 1.5px solid #3b82f6;
    }

        .vin-btn-outline:hover {
            background: #3b82f6;
            color: #fff;
        }

    .vin-btn-ghost {
        background: transparent;
        color: var(--vi-red-600);
        border: 1.5px solid var(--vi-red-600);
    }

        .vin-btn-ghost:hover {
            background: var(--vi-red-600);
            color: #fff;
        }

    /* Ticket resumen */
    .vin-ticket {
        border: 1px solid var(--vi-gray-200);
        border-radius: var(--vi-radius-lg);
        overflow: hidden;
        box-shadow: var(--vi-shadow);
    }

    .vin-ticket-head {
        background: var(--vi-blue-600);
        color: #fff;
        padding: 1.1rem 1.4rem;
        text-align: center;
    }

    .vin-ticket-head-icon {
        font-size: 1.5rem;
        opacity: .9;
        display: block;
        margin-bottom: .2rem;
    }

    .vin-ticket-head-label {
        font-size: .75rem;
        font-weight: 700;
        letter-spacing: 1.2px;
        text-transform: uppercase;
    }

    .vin-ticket-body {
        padding: 1.1rem 1.4rem;
        background: var(--bg-light, #fff);
    }

    .vin-ticket-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: .55rem 0;
        border-bottom: 1px dashed var(--vi-gray-200);
        font-size: .85rem;
        color: var(--vi-gray-800);
    }

        .vin-ticket-row:last-child {
            border-bottom: none;
        }

    .vin-ticket-row-label {
        color: var(--vi-gray-600);
        font-size: .78rem;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vin-ticket-row-val {
        font-weight: 700;
        font-family: 'Courier New', monospace;
        color: var(--vi-gray-800);
    }

        .vin-ticket-row-val.vin-negative {
            color: var(--vi-red-600);
        }

    .vin-ticket-footer {
        background: var(--vi-blue-50);
        border-top: 2px dashed var(--vi-blue-100);
        padding: 1.1rem 1.4rem;
    }

    .vin-ticket-total-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .vin-ticket-total-label {
        font-size: .85rem;
        color: var(--vi-blue-600);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .vin-ticket-total-val {
        font-size: 1.6rem;
        font-weight: 700;
        color: var(--vi-blue-600);
        font-family: 'Courier New', monospace;
    }

    /* Switch */
    .vin-switch {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
    }

    .vin-switch-track {
        position: relative;
        width: 52px;
        height: 28px;
        border-radius: 99px;
        background: var(--vi-gray-200);
        transition: background .3s;
        flex-shrink: 0;
    }

        .vin-switch-track::after {
            content: '';
            position: absolute;
            left: 3px;
            top: 3px;
            width: 22px;
            height: 22px;
            border-radius: 50%;
            background: #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,.2);
            transition: transform .3s;
        }

    .vin-switch input {
        display: none;
    }

        .vin-switch input:checked ~ .vin-switch-track {
            background: var(--vi-green-600);
        }

            .vin-switch input:checked ~ .vin-switch-track::after {
                transform: translateX(24px);
            }

    .vin-switch-label {
        font-size: .85rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        user-select: none;
    }

    /* Separador */
    .vin-sep {
        border: none;
        border-top: 1px dashed var(--vi-gray-200);
        margin: 1.25rem 0;
    }

    /* Modales */
    .vin-modal-header {
        background: var(--vi-blue-600);
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vin-modal-header .btn-close {
            filter: invert(1);
        }

    .vin-modal-header-purple {
        background: #5b21b6;
        color: #fff;
        border-radius: .5rem .5rem 0 0;
    }

        .vin-modal-header-purple .btn-close {
            filter: invert(1);
        }

    /* Search items */
    .vin-search-item {
        padding: .7rem 1rem;
        border-radius: 8px;
        border: 1px solid var(--vi-gray-200);
        margin-bottom: .5rem;
        cursor: pointer;
        transition: border-color .2s, background .2s, transform .15s;
        background: var(--bg-light, #fff);
        color: var(--vi-gray-800);
    }

        .vin-search-item:hover {
            border-color: #3b82f6;
            background: var(--vi-blue-50);
            transform: translateX(3px);
        }

    /* Badges */
    .vin-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: .7rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
        padding: .2rem .6rem;
        border-radius: 99px;
    }

    .vin-badge-blue {
        background: var(--vi-blue-50);
        color: var(--vi-blue-600);
    }

    .vin-badge-green {
        background: var(--vi-green-50);
        color: var(--vi-green-600);
    }

    .vin-badge-purple {
        background: var(--vi-purple-50);
        color: var(--vi-purple-600);
    }

    .vin-cot-btn-delete {
        background-color: #dc3545;
        color: white;
        border: none;
        padding: 8px 14px;
        border-radius: 6px;
        cursor: pointer;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.25s ease;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

        .vin-cot-btn-delete:hover {
            background-color: #bb2d3b;
            transform: translateY(-1px);
        }

        .vin-cot-btn-delete:active {
            transform: scale(0.96);
        }

        .vin-cot-btn-delete:disabled {
            background-color: #bdbdbd;
            cursor: not-allowed;
            opacity: 0.7;
        }
</style>

@{ var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS"); }

<div class="vin-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vin-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nueva Cotización Internacional</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar la cotización</p>
            </div>
        </div>

        <form id="vin-cot-formCotizacion" method="post">

            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vin-card p-4 mb-4">
                        <div class="vin-section-header">
                            <div class="vin-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vin-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vin-cot-tipo-pago" value="contado">
                        <div class="vin-pay-toggle" id="vin-cot-toggle-pago">
                            <button type="button" class="vin-pay-btn active" data-val="contado">
                                <div class="vin-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vin-pay-btn" data-val="credito">
                                <div class="vin-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vin-card p-4 mb-4">
                        <div class="vin-section-header">
                            <div class="vin-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vin-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vin-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap;">
                                    <button class="vin-btn vin-btn-purple" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vin-cot-modalImportarKepler">
                                        <i class="fas fa-file-import"></i> Importar Kepler
                                    </button>
                                    <button class="vin-btn vin-btn-primary d-none" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vin-cot-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vin-control" id="vin-cot-cliente"
                                           placeholder="Seleccione un cliente…" readonly
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- Lista precios + RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vin-label"><i class="fas fa-tags"></i>Lista de Precios</label>
                                <input type="text" id="vin-cot-lista-precios" class="vin-control"
                                       name="listaPrecios" readonly placeholder="—">
                            </div>
                            <div class="col-12 col-sm-6">
                                <label class="vin-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vin-cot-rfc" class="vin-control">
                            </div>

                            <!-- Banner crédito -->
                            <div class="col-12">
                                <div id="vin-cot-credit-banner" style="display:none;" class="vin-credit-banner">
                                    <div id="vin-cot-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vin-cot-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vin-cot-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vin-banner-bar-wrap" id="vin-cot-credit-bar-wrap">
                                            <div class="vin-banner-bar-fill" id="vin-cot-credit-bar" style="width:0%;"></div>
                                        </div>
                                    </div>
                                    <div id="vin-cot-credit-pct" style="font-size:.8rem;font-weight:600;flex-shrink:0;"></div>
                                </div>
                            </div>

                            <!-- Info adicional cliente -->
                            <div class="col-12">
                                <label class="vin-label"><i class="fas fa-info-circle"></i>Información del Cliente</label>
                                <textarea class="vin-control" id="vin-cot-info-proveedor" rows="3" readonly></textarea>
                            </div>

                            <!-- Vendedor + Moneda + Paridad -->
                            <div class="col-12 col-sm-4">
                                <label class="vin-label"><i class="fas fa-user-tie"></i>Vendedor</label>
                                <select class="vin-control form-select" name="vendedor" id="vin-cot-vendedor">
                                    <option selected disabled>Seleccionar vendedor</option>
                                    <option value="1">Carlos Mendoza</option>
                                    <option value="2">Ana García</option>
                                    <option value="3">Luis Fernández</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vin-label"><i class="fas fa-dollar-sign"></i>Moneda</label>
                                <select class="vin-control form-select" name="moneda" id="vin-cot-moneda">
                                    <option selected disabled>Seleccione una moneda</option>
                                    <option>PESOS</option>
                                    <option>DOLARES</option>
                                    <option>EUROS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4">
                                <label class="vin-label"><i class="fas fa-exchange-alt"></i>Paridad</label>
                                <input type="text" id="vin-cot-paridad" name="paridad" class="vin-control" value="1.0000">
                            </div>

                            <!-- Concepto -->
                            <div class="col-12">
                                <label class="vin-label"><i class="fas fa-comment"></i>Concepto</label>
                                <input type="text" id="vin-cot-concepto" name="concepto" class="vin-control">
                            </div>
