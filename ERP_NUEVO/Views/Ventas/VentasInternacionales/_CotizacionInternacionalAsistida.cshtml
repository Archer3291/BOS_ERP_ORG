<script>
    /* ===== TOGGLE TIPO PAGO ===== */
    function selectTipoPagoVin(val) {
        document.querySelectorAll('#vin-cot-toggle-pago .vin-pay-btn')
            .forEach(o => o.classList.toggle('active', o.dataset.val === val));
        document.getElementById('vin-cot-tipo-pago').value = val;
        const banner = document.getElementById('vin-cot-credit-banner');
        if (banner) banner.style.display = val === 'credito' ? '' : 'none';
    }

    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vin-cot-flete').addEventListener('change', function () {
        const inp = document.getElementById('vin-cot-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vin-cot-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vin-cot-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    document.addEventListener('DOMContentLoaded', function () {

        // ===== TOGGLE TIPO PAGO =====
        document.querySelectorAll('#vin-cot-toggle-pago .vin-pay-btn')
            .forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var val = this.dataset.val;

                    document.querySelectorAll('#vin-cot-toggle-pago .vin-pay-btn')
                        .forEach(function (b) {
                            b.classList.toggle('active', b.dataset.val === val);
                        });

                    document.getElementById('vin-cot-tipo-pago').value = val;

                    var banner = document.getElementById('vin-cot-credit-banner');
                    if (banner) banner.style.display = val === 'credito' ? '' : 'none';
                });
            });

        // ===== TOGGLE FLETE =====
        document.getElementById('vin-cot-flete').addEventListener('change', function () {
            var inp = document.getElementById('vin-cot-flete-val');
            inp.classList.toggle('d-none', !this.checked);
            if (!this.checked) inp.value = '';
        });

        // ===== TOGGLE ORDEN DE COMPRA =====
        document.getElementById('vin-cot-orden-compra-check').addEventListener('change', function () {
            var inp = document.getElementById('vin-cot-orden-compra-val');
            inp.classList.toggle('d-none', !this.checked);
            if (!this.checked) inp.value = '';
        });

    });
</script>