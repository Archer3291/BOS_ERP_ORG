                                    <strong class="vi-ticket-total-val" id="vin-ped-importe-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vin-ped-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vin-ped-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vin-ped-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vin-ped-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vin-ped-iva" name="iva" value="0.00">
                            <input type="hidden" id="vin-ped-importe" name="importe" value="0.00">
                            <input type="hidden" id="vin-ped-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vi-btn vi-btn-outline d-none"
                                    data-bs-toggle="modal" data-bs-target="#vin-ped-modalVistaPrevia"
