<script>
    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    function selectTipoPagoVin(val) {
        document.querySelectorAll('#vin-ped-toggle-pago .vi-pay-btn')
            .forEach(o => o.classList.toggle('active', o.dataset.val === val));
        document.getElementById('vin-ped-tipo-pago').value = val;

        const metodoPagoEl = document.getElementById('vin-ped-metodo-pago');
        if (metodoPagoEl) {
            metodoPagoEl.value = val === 'credito' ? 'PPD' : 'PUE';
        }

        const camposCredito = document.getElementById('vin-ped-campos-credito');
        const camposAnticipo = document.getElementById('vin-ped-campos-anticipo');
        const secProductos = document.getElementById('vin-ped-seccion-productos');

        camposCredito.style.display = 'none';
        camposAnticipo.style.display = 'none';

        if (val === 'contado') {
            limpiarCamposVin();
            secProductos.style.display = '';
        } else if (val === 'credito') {
            camposCredito.style.display = 'block';
            limpiarCamposAnticipoVin();
            secProductos.style.display = '';
        } else if (val === 'anticipo') {
            camposAnticipo.style.display = 'block';
            limpiarCamposCreditoVin();
            secProductos.style.display = 'none';
            document.getElementById('vin-ped-flete-val').value = 0;
        }
    }

    function limpiarCamposVin() {
        limpiarCamposCreditoVin();
        limpiarCamposAnticipoVin();
    }

    function limpiarCamposCreditoVin() {
        document.getElementById('vin-ped-limite-credito').value = '0.00';
        document.getElementById('vin-ped-plazo').value = '';
        document.getElementById('vin-ped-fecha-pago').value = '';
    }

    function limpiarCamposAnticipoVin() {
        document.getElementById('vin-ped-porcentaje-anticipo').value = '';
        document.getElementById('vin-ped-monto-anticipo').value = '';
        document.getElementById('vin-ped-saldo-pendiente').value = '';
        document.getElementById('vin-ped-fecha-anticipo').value = '';
        document.getElementById('vin-ped-fecha-pago-final').value = '';
    }

    function calcularAnticipo() {
        const porcentaje = parseFloat(document.getElementById('vin-ped-porcentaje-anticipo').value) || 0;
        const totalVenta = parseFloat(document.getElementById('vin-ped-importe').value) || 0;
        const montoAnticipo = (totalVenta * porcentaje) / 100;
        const saldoPendiente = totalVenta - montoAnticipo;
        document.getElementById('vin-ped-monto-anticipo').value = montoAnticipo.toFixed(2);
        document.getElementById('vin-ped-saldo-pendiente').value = saldoPendiente.toFixed(2);
    }

    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vin-ped-flete').addEventListener('change', function () {
        const inp = document.getElementById('vin-ped-flete-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vin-ped-orden-compra-check').addEventListener('change', function () {
        const inp = document.getElementById('vin-ped-orden-compra-val');
        inp.classList.toggle('d-none', !this.checked);
        if (!this.checked) inp.value = '';
    });
</script>

<script>
    /* ===== VISTA PREVIA ===== */
    function actualizarVistaPreviaPedido() {
        const getValue = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            return (el?.value ?? '').toString().trim() || defaultVal;
        };
        const getSelectedText = (id, defaultVal = '-') => {
            const el = document.getElementById(id);
            const selected = el?.options?.[el.selectedIndex];
            return selected?.text?.trim() || defaultVal;
        };
        const setText = (id, value) => {
            const el = document.getElementById(id);
            if (el) el.textContent = value;
        };
        const getDisplayValue = (id, defaultVal = '$0.00') => {
            const el = document.getElementById(id);
            return el?.textContent?.trim() || defaultVal;
        };
        const getTomValueText = (key) => {
            const inst = tomManager?.getInstance(key);
            const val = inst?.getValue();
            return inst?.getItem(val)?.textContent?.trim() || '';
        };

        setText('vin-ped-preview-folio', getValue('vin-ped-folio', 'Sin asignar'));
        setText('vin-ped-preview-sucursal', getSelectedText('vin-ped-sucursal', 'CEDIS'));
        const hoy = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: 'numeric' });
        setText('vin-ped-preview-fecha', hoy);
        setText('vin-ped-preview-cliente', getValue('vin-ped-cliente'));
        setText('vin-ped-preview-rfc', getValue('vin-ped-rfc'));
        setText('vin-ped-preview-vendedor', getTomValueText('vin-ped-vendedor'));
        setText('vin-ped-preview-moneda', getTomValueText('vin-ped-moneda'));
        setText('vin-ped-preview-concepto', getValue('vin-ped-concepto'));

        const previewProductos = document.getElementById('vin-ped-preview-productos');
        const productosTable = document.getElementById('vin-ped-productosTable');

        if (previewProductos) {
            previewProductos.innerHTML = '';
            const rows = productosTable
                ? Array.from(productosTable.querySelectorAll('tr')).filter(r => !r.classList.contains('vi-table-empty') && !r.querySelector('.vi-table-empty'))
                : [];

            if (rows.length === 0) {
                previewProductos.innerHTML = `<tr><td colspan="7" style="padding:2rem;text-align:center;color:#999;border:1px solid #ddd;">No hay productos agregados</td></tr>`;
            } else {
                rows.forEach(row => {
                    const cols = row.querySelectorAll('td');
                    if (cols.length >= 8) {
                        const tr = document.createElement('tr');
                        tr.innerHTML = `
                            <td style="padding:.5rem;border:1px solid #ddd;">${cols[0]?.textContent?.trim() || '-'}</td>
                            <td style="padding:.5rem;border:1px solid #ddd;">${cols[1]?.textContent?.trim() || '-'}</td>
                            <td style="padding:.5rem;text-align:center;border:1px solid #ddd;">${cols[3]?.querySelector('input')?.value || '0'}</td>
                            <td style="padding:.5rem;text-align:center;border:1px solid #ddd;">${cols[4]?.textContent?.trim() || '-'}</td>
                            <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">$${cols[5]?.querySelector('input')?.value || '0.00'}</td>
                            <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">${cols[6]?.querySelector('input')?.value || '0'}%</td>
                            <td style="padding:.5rem;text-align:right;border:1px solid #ddd;">${cols[7]?.textContent?.trim() || '$0.00'}</td>`;
                        previewProductos.appendChild(tr);
                    }
                });
            }
        }

        setText('vin-ped-preview-subtotal1', getDisplayValue('vin-ped-total-subtotal1-display'));
        setText('vin-ped-preview-descuento', getDisplayValue('vin-ped-total-descuento-display'));
        setText('vin-ped-preview-flete', getDisplayValue('vin-ped-total-flete-display'));
        setText('vin-ped-preview-subtotal2', getDisplayValue('vin-ped-total-subtotal2-display'));
        setText('vin-ped-preview-iva', getDisplayValue('vin-ped-iva-display'));
        setText('vin-ped-preview-total', getDisplayValue('vin-ped-importe-display'));
        setText('vin-ped-preview-forma-pago', getTomValueText('vin-ped-forma-pago'));
        setText('vin-ped-preview-metodo-pago', getSelectedText('vin-ped-metodo-pago'));
        setText('vin-ped-preview-plazo', getValue('vin-ped-plazo'));
        setText('vin-ped-preview-fecha-pago', getValue('vin-ped-fecha-pago'));
        setText('vin-ped-preview-uso-cfdi', getTomValueText('vin-ped-uso-cfdi'));

        const comentarios = getValue('vin-ped-comentarios', '');
        const secComentarios = document.getElementById('vin-ped-preview-comentarios-section');
        const txtComentarios = document.getElementById('vin-ped-preview-comentarios');
        if (secComentarios) secComentarios.style.display = comentarios ? 'block' : 'none';
        if (txtComentarios) txtComentarios.textContent = comentarios;
    }
</script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.7.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.29/jspdf.plugin.autotable.min.js"></script>
<script>
    /* ===== DESCARGA PDF (misma lógica que vin original) ===== */
    async function descargarVistaPreviaPDF() {
        const { jsPDF } = window.jspdf;
        const doc = new jsPDF('p', 'mm', 'a4');
        const pageWidth = doc.internal.pageSize.getWidth();
        const pageHeight = doc.internal.pageSize.getHeight();
        const margin = 12;
        let y = margin;

        const colors = {
            primary: [13, 35, 75],
            secondary: [59, 130, 246],
            accent: [34, 197, 94],
            highlight: [249, 115, 22],
            dark: [30, 30, 40],
            text: [60, 70, 85],
            light: [248, 250, 252],
            border: [219, 224, 231],
            white: [255, 255, 255]
        };

        const getValue = (id, d = '-') => document.getElementById(id)?.value?.trim() || d;
        const getSelectedText = (id, d = '-') => {
            const el = document.getElementById(id);
            return el?.options?.[el.selectedIndex]?.text?.trim() || d;
        };
        const formatCurrency = val => parseFloat(val || 0).toLocaleString('es-MX', { style: 'currency', currency: 'MXN' });
        const getTomSelectText = (id) => {
            const inst = tomManager?.getInstance(id);
            return inst?.getItem(inst?.getValue())?.textContent || '';
        };

        const tipoFactura = document.getElementById('vin-ped-tipo-pago')?.value || 'contado';
        const folio = getValue('vin-ped-folio', 'S/A');
        const fecha = new Date().toLocaleDateString('es-MX');
        const sucursal = getSelectedText('vin-ped-sucursal', 'CEDIS');

        await drawHeader(doc, colors, margin, pageWidth, folio, fecha, sucursal, tipoFactura);
        y = 41;
        y = drawInfoCards(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue, formatCurrency);
        y = await drawProductsSection(doc, colors, margin, pageWidth, y, tipoFactura, getValue, formatCurrency);
        drawFinancialSummary(doc, colors, margin, pageWidth, y);
        y += 40;
        y = drawPaymentConditions(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue);
        y = drawComments(doc, colors, margin, pageWidth, pageHeight, y, getValue);
        drawFooter(doc, colors, margin, pageWidth, pageHeight);

        doc.save(`pedido-${folio}-${Date.now()}.pdf`);
    }

    async function drawHeader(doc, colors, margin, pageWidth, folio, fecha, sucursal, tipoFactura) {
        const headerHeight = 18;
        doc.setFillColor(...colors.primary);
        doc.rect(0, 0, pageWidth, headerHeight, 'F');
        doc.setFillColor(...colors.accent);
        doc.rect(0, 0, 2.5, headerHeight, 'F');

        const logoUrl = `/Content/img/${empresa}/logo-light.png`;
        try {
            const img = await loadImage(logoUrl);
            doc.addImage(img, 'PNG', margin, 2, 17, 7.5, '', 'FAST');
        } catch (e) {
            doc.setFillColor(...colors.secondary);
            doc.roundedRect(margin, 2, 6.5, 7.5, 1, 1, 'F');
            doc.setFont('helvetica', 'bold');
            doc.setFontSize(6);
            doc.setTextColor(...colors.white);
            doc.text('LOGO', margin + 3.25, 5.75, { align: 'center' });
        }

        const titleX = margin + 19;
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(18);
        doc.setTextColor(...colors.white);
        doc.text('PEDIDO', titleX, 6);
        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(0.5);
        doc.line(titleX, 6.8, titleX + 16, 6.8);

        const estadoConfig = {
            contado: { color: colors.accent, label: 'CONTADO' },
            credito: { color: colors.secondary, label: 'CRÉDITO' },
            anticipo: { color: colors.highlight, label: 'ANTICIPO' }
        };
        const config = estadoConfig[tipoFactura] || estadoConfig.contado;
        doc.setFillColor(...config.color);
        doc.roundedRect(titleX, 7.2, 13, 3.5, 0.8, 0.8, 'F');
        doc.setTextColor(...colors.white);
        doc.setFont('helvetica', 'bold');
        doc.setFontSize(7);
        doc.text(config.label, titleX + 6.5, 9.3, { align: 'center' });

        const rightX = pageWidth - margin;
        doc.setFont('helvetica', 'normal');
        doc.setFontSize(7);
        doc.setTextColor(...colors.light);
        doc.text(`Folio: ${folio}`, rightX, 3.5, { align: 'right' });
        doc.text(fecha, rightX, 6.5, { align: 'right' });
        doc.text(sucursal, rightX, 9.5, { align: 'right' });
        doc.setDrawColor(...colors.secondary);
        doc.setLineWidth(0.6);
        doc.line(0, headerHeight, pageWidth, headerHeight);
    }

    function loadImage(url) {
        return new Promise((resolve, reject) => {
            const img = new Image();
            img.crossOrigin = 'Anonymous';
            img.onload = () => resolve(img);
            img.onerror = reject;
            img.src = url;
        });
    }

    function drawCard(doc, colors, x, y, width, height) {
        doc.setDrawColor(...colors.border);
        doc.setLineWidth(0.5);
        doc.setFillColor(...colors.white);
        doc.roundedRect(x, y, width, height, 2, 2, 'FD');
    }

    function drawInfoCards(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue, formatCurrency) {
        const cardHeight = 22;
        const cardWidth = (pageWidth - 3 * margin) / 2;

        drawCard(doc, colors, margin, y, cardWidth, cardHeight);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(...colors.primary);
        doc.text('CLIENTE', margin + 3, y + 4);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(...colors.text);
        const cn = getValue('vin-ped-cliente');
        doc.text(cn.length > 40 ? cn.substring(0, 40) + '…' : cn, margin + 3, y + 8);
        doc.text(`RFC: ${getValue('vin-ped-rfc')}`, margin + 3, y + 11);
        doc.text(`Vendedor: ${getTomSelectText('vin-ped-vendedor')}`, margin + 3, y + 14);
        const cv = getValue('vin-ped-concepto');
        doc.text(`Concepto: ${cv.length > 25 ? cv.substring(0, 25) + '…' : cv}`, margin + 3, y + 17);
        doc.text(`Uso CFDI: ${getTomSelectText('vin-ped-uso-cfdi')}`, margin + 3, y + 20);

        const c2x = margin + cardWidth + margin;
        drawCard(doc, colors, c2x, y, cardWidth, cardHeight);
        doc.setFont('helvetica', 'bold'); doc.setFontSize(8); doc.setTextColor(...colors.primary);
        doc.text('PARÁMETROS', c2x + 3, y + 4);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(...colors.text);
        doc.text(`Moneda: ${getTomSelectText('vin-ped-moneda')}`, c2x + 3, y + 8);
        doc.text(`Incoterm: ${getTomSelectText('vin-ped-incoterm')}`, c2x + 3, y + 11);
        if (tipoFactura === 'credito') {
            doc.text(`Plazo: ${getValue('vin-ped-plazo')} días`, c2x + 3, y + 14);
            doc.text(`Vencimiento: ${getValue('vin-ped-fecha-pago')}`, c2x + 3, y + 17);
        } else if (tipoFactura === 'anticipo') {
            doc.text(`Monto: ${formatCurrency(getValue('vin-ped-monto-anticipo'))}`, c2x + 3, y + 14);
        }
        doc.text(`Forma de Pago: ${getTomSelectText('vin-ped-forma-pago')}`, c2x + 3, y + 20);

        return y + cardHeight + margin + 3;
    }

    async function drawProductsSection(doc, colors, margin, pageWidth, y, tipoFactura, getValue, formatCurrency) {
        if (tipoFactura === 'anticipo') {
            doc.setFillColor(...colors.highlight);
            doc.roundedRect(margin, y, pageWidth - 2 * margin, 12, 2, 2, 'F');
            doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(...colors.white);
            doc.text('ANTICIPO REQUERIDO', pageWidth / 2, y + 4.5, { align: 'center' });
            doc.setFontSize(13);
            doc.text(formatCurrency(getValue('vin-ped-monto-anticipo')), pageWidth / 2, y + 9, { align: 'center' });
            return y + 14;
        }

        doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(...colors.primary);
        doc.text('ARTÍCULOS', margin, y);
        doc.setDrawColor(...colors.secondary); doc.setLineWidth(1.2);
        doc.line(margin, y + 1.2, margin + 25, y + 1.2);
        y += 5;

        const productosTable = document.getElementById('vin-ped-productosTable');
        const rows = [];
        if (productosTable) {
            Array.from(productosTable.querySelectorAll('tr')).forEach(row => {
                if (!row.querySelector('.vi-table-empty') && !row.classList.contains('vi-table-empty')) {
                    const cols = row.querySelectorAll('td');
                    if (cols.length >= 8) {
                        rows.push([
                            cols[0]?.textContent?.trim() || '-',
                            cols[1]?.textContent?.trim() || '-',
                            cols[3]?.querySelector('input')?.value || '0',
                            cols[4]?.textContent?.trim() || '-',
                            formatCurrency(cols[5]?.querySelector('input')?.value),
                            (cols[6]?.querySelector('input')?.value || '0') + '%',
                            cols[7]?.textContent?.trim() || formatCurrency(0)
                        ]);
                    }
                }
            });
        }
        if (rows.length === 0) rows.push(['Sin artículos agregados', '', '', '', '', '', '']);

        doc.autoTable({
            startY: y,
            head: [['Artículo', 'Descripción', 'Cant.', 'Unidad', 'P. Unitario', 'Desc %', 'Importe']],
            body: rows,
            theme: 'grid',
            headStyles: { fillColor: colors.primary, textColor: colors.white, fontSize: 7, fontStyle: 'bold', halign: 'center', valign: 'middle', cellPadding: 2.5 },
            bodyStyles: { fontSize: 7, textColor: colors.text, cellPadding: 2 },
            alternateRowStyles: { fillColor: [253, 254, 255] },
            columnStyles: {
                0: { halign: 'left', cellWidth: 20 },
                1: { halign: 'left' },
                2: { halign: 'center', cellWidth: 12 },
                3: { halign: 'center', cellWidth: 12 },
                4: { halign: 'right', cellWidth: 18 },
                5: { halign: 'center', cellWidth: 12 },
                6: { halign: 'right', fontStyle: 'bold', textColor: colors.secondary, cellWidth: 18 }
            },
            margin: { left: margin, right: margin }
        });

        return doc.lastAutoTable.finalY + 6;
    }

    function drawFinancialSummary(doc, colors, margin, pageWidth, y) {
        const summaryX = pageWidth - margin - 58;
        const summaryWidth = 54;
        doc.setFillColor(...colors.light);
        doc.setDrawColor(...colors.border);
        doc.setLineWidth(0.4);
        doc.roundedRect(summaryX - 1.5, y - 1, summaryWidth + 3, 38, 1.5, 1.5, 'FD');

        doc.setFont('helvetica', 'normal'); doc.setFontSize(7);
        let sy = y + 2;
        [
            { label: 'Subtotal:', id: 'vin-ped-total-subtotal1-display' },
            { label: 'Descuento:', id: 'vin-ped-total-descuento-display' },
            { label: 'Flete:', id: 'vin-ped-total-flete-display' },
            { label: 'Subtotal 2:', id: 'vin-ped-total-subtotal2-display' },
        ].forEach(item => {
            doc.setTextColor(...colors.text);
            doc.text(item.label, summaryX + 1.5, sy);
            doc.setTextColor(...colors.dark);
            doc.text(document.getElementById(item.id)?.textContent || '$0.00', summaryX + summaryWidth - 1.5, sy, { align: 'right' });
            sy += 3.2;
        });

        doc.setDrawColor(...colors.secondary); doc.setLineWidth(0.8);
        doc.line(summaryX + 0.5, sy - 0.5, summaryX + summaryWidth - 0.5, sy - 0.5);
        sy += 1.5;

        doc.setFillColor(...colors.secondary);
        doc.roundedRect(summaryX - 0.5, sy - 2.5, summaryWidth + 1, 4, 0.5, 0.5, 'F');
        doc.setTextColor(...colors.white); doc.setFont('helvetica', 'bold'); doc.setFontSize(9);
        doc.text('TOTAL:', summaryX + 1.5, sy);
        doc.text(document.getElementById('vin-ped-importe-display')?.textContent || '$0.00', summaryX + summaryWidth - 1.5, sy, { align: 'right' });
    }

    function drawPaymentConditions(doc, colors, margin, pageWidth, y, tipoFactura, getTomSelectText, getValue) {
        const getSelectedText = (id, d = '-') => {
            const el = document.getElementById(id);
            return el?.options?.[el.selectedIndex]?.text?.trim() || d;
        };
        doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(...colors.primary);
        doc.text('CONDICIONES', margin, y);
        doc.setDrawColor(...colors.secondary); doc.setLineWidth(1.2);
        doc.line(margin, y + 1.2, margin + 30, y + 1.2);
        y += 5;

        const condHeight = tipoFactura === 'credito' ? 12 : 9;
        doc.setFillColor(...colors.white); doc.setDrawColor(...colors.border); doc.setLineWidth(0.4);
        doc.roundedRect(margin, y, pageWidth - 2 * margin, condHeight, 1.5, 1.5, 'FD');
        y += 3;
        doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(...colors.text);

        const drawLV = (lbl, val, x, yy) => {
            doc.setFont('helvetica', 'bold'); doc.setTextColor(...colors.primary);
            doc.text(lbl, x, yy);
            doc.setFont('helvetica', 'normal'); doc.setTextColor(...colors.text);
            doc.text(val, x + doc.getTextWidth(lbl) + 2, yy);
        };

        if (tipoFactura === 'contado') {
            drawLV('Forma de Pago:', getTomSelectText('vin-ped-forma-pago'), margin + 2.5, y);
            drawLV('Método:', getSelectedText('vin-ped-metodo-pago'), margin + 55, y);
            drawLV('CFDI:', getTomSelectText('vin-ped-uso-cfdi'), pageWidth - margin - 45, y);
        } else if (tipoFactura === 'credito') {
            drawLV('Forma de Pago:', getTomSelectText('vin-ped-forma-pago'), margin + 2.5, y);
            drawLV('Método:', getSelectedText('vin-ped-metodo-pago'), margin + 55, y);
            drawLV('Plazo:', `${getValue('vin-ped-plazo')} días`, pageWidth - margin - 45, y);
            y += 3.5;
            drawLV('Vencimiento:', getValue('vin-ped-fecha-pago'), margin + 2.5, y);
            drawLV('CFDI:', getTomSelectText('vin-ped-uso-cfdi'), pageWidth - margin - 45, y);
        } else if (tipoFactura === 'anticipo') {
            drawLV('Forma de Pago:', getTomSelectText('vin-ped-forma-pago'), margin + 2.5, y);
            drawLV('Método:', getSelectedText('vin-ped-metodo-pago'), margin + 55, y);
            drawLV('CFDI:', getTomSelectText('vin-ped-uso-cfdi'), pageWidth - margin - 45, y);
        }
        return y + condHeight - 1;
    }

    function drawComments(doc, colors, margin, pageWidth, pageHeight, y, getValue) {
        const comentarios = getValue('vin-ped-comentarios', '');
        if (comentarios && y < pageHeight - 18) {
            y += 4;
            doc.setFont('helvetica', 'bold'); doc.setFontSize(10); doc.setTextColor(...colors.primary);
            doc.text('NOTAS', margin, y);
            doc.setDrawColor(...colors.secondary); doc.setLineWidth(1.2);
            doc.line(margin, y + 1.2, margin + 15, y + 1.2);
            y += 4;
            const split = doc.splitTextToSize(comentarios, pageWidth - 2 * margin - 4);
            const h = Math.min(split.length * 3 + 3, pageHeight - y - 12);
            doc.setFillColor(...colors.white); doc.setDrawColor(...colors.border); doc.setLineWidth(0.4);
            doc.roundedRect(margin, y, pageWidth - 2 * margin, h, 1.5, 1.5, 'FD');
            doc.setFont('helvetica', 'normal'); doc.setFontSize(7); doc.setTextColor(...colors.text);
            doc.text(split, margin + 2, y + 3, { maxWidth: pageWidth - 2 * margin - 4 });
        }
        return y;
    }

    function drawFooter(doc, colors, margin, pageWidth, pageHeight) {
        doc.setDrawColor(...colors.primary); doc.setLineWidth(0.6);
        doc.line(0, pageHeight - 8, pageWidth, pageHeight - 8);
        doc.setFont('helvetica', 'normal'); doc.setFontSize(6); doc.setTextColor(...colors.text);
        doc.text('Generado automáticamente • Confidencial', margin, pageHeight - 4);
        doc.text(new Date().toLocaleString('es-MX'), pageWidth - margin, pageHeight - 4, { align: 'right' });
    }
</script>
