            loading.style.display = 'block';
            tbody.innerHTML = '';
            noResultsMsg.style.display = 'none';

            try {
                const data = await GetData({
                    path: "/ProcesoComprasInternacional/GetPedimentos"
                });

                pedimentosListData = data.pedimentos || [];
                filteredPedimentosData = [...pedimentosListData];

                loading.style.display = 'none';

