        // Guardar pedimento
        async function guardarPedimento() {
            // Validar formulario
            if (!validarFormularioPedimento()) {
                return;
            }

            const guardarBtn = document.getElementById('guardarPedimentoBtn');
            const originalText = guardarBtn.innerHTML;

            guardarBtn.disabled = true;
            guardarBtn.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i> Procesando...';

            try {
                const formData = new FormData();

                // Agregar ID si está en modo edición
                if (isEditMode) {
                    formData.append("pedimentoId", document.getElementById("pedimentoId").value);
                }

                formData.append("pedimento", document.getElementById("pedimento").value);
                formData.append("agencia", tomManager.getInstance('agencia')?.getValue() || "");
                formData.append("aduana", tomManager.getInstance('aduana')?.getValue() || "");
                formData.append("fecha", document.getElementById("fecha").value);
                formData.append("patenteSat", tomManager.getInstance('patente')?.getValue() || "");
                formData.append("consecutivoSat", document.getElementById("consecutivoSat").value);
                formData.append("numeroPedimentoSat", document.getElementById("numeroPedimentoSat").value);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) formData.append('__RequestVerificationToken', token);

                const endpoint = isEditMode
                    ? "/ProcesoComprasInternacional/ActualizarPedimento"
                    : "/ProcesoComprasInternacional/GuardarPedimento";

                const response = await fetch(endpoint, {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    throw new Error(`Error HTTP: ${response.status} ${response.statusText}`);
                }

                const result = await response.json();

                if (result.success) {
                    bootstrap.Modal.getInstance(document.getElementById("modalPedimento")).hide();

                    toastMixin.fire({
                        icon: 'success',
                        title: result.message || (isEditMode ? 'Pedimento actualizado' : 'Pedimento guardado')
                    });

                    // Recargar datos
                    await cargarTablaPedimentos();
                    loadPedimentos();

                    // Si el modal de lista está abierto, mostrarlo de nuevo
                    const modalLista = bootstrap.Modal.getInstance(document.getElementById("modalListaPedimentos"));
                    if (modalLista) {
                        setTimeout(() => {
                            modalLista.show();
                        }, 300);
                    }

                } else {
                    toastMixin.fire({
                        icon: 'error',
                        title: result.message || 'Error al procesar pedimento'
                    });
                }

            } catch (error) {
                console.error("Error en fetch:", error);
                toastMixin.fire({
                    icon: 'error',
                    title: 'Error inesperado: ' + error.message
                });
            } finally {
                guardarBtn.disabled = false;
                guardarBtn.innerHTML = originalText;
            }
        }

