        // Funciones auxiliares
        function truncateText(text, maxLength) {
            if (!text) return '';
            return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
        }

        function formatDate(dateString) {
            if (!dateString) return '';

            try {
                let date;

                // Verificar si es formato .NET /Date(timestamp)/
                const dotNetMatch = dateString.match(/\/Date\((\d+)\)\//);
                if (dotNetMatch) {
                    const timestamp = parseInt(dotNetMatch[1]);
                    date = new Date(timestamp);
                } else {
                    date = new Date(dateString);
                }

                if (isNaN(date.getTime())) {
                    return dateString; // Retornar original si no se puede parsear
                }

                return date.toLocaleDateString('es-MX', {
                    year: 'numeric',
                    month: '2-digit',
                    day: '2-digit'
                });
            } catch (error) {
                console.error('Error formateando fecha:', error);
                return dateString;
            }
        }

        function getEstadoBadgeClass(estado) {
            switch (estado?.toLowerCase()) {
                case 'activo':
                case 'active':
                    return 'bg-success';
                case 'inactivo':
                case 'inactive':
                    return 'bg-secondary';
                case 'pendiente':
                case 'pending':
                    return 'bg-warning';
                default:
                    return 'bg-info';
            }
        }

        function getEstadoText(estado) {
            return estado || 'Activo';
        }

        // Función para filtrar pedimentos
        function filtrarPedimentos() {
            const searchTerm = document.getElementById('searchPedimentos').value.toLowerCase().trim();

            if (!searchTerm) {
                filteredPedimentosData = [...pedimentosListData];
            } else {
                filteredPedimentosData = pedimentosListData.filter(pedimento => {
                    return (
                        (pedimento.pedimento_sat || '').toLowerCase().includes(searchTerm) ||
                        (pedimento.pedimento_aduanal || '').toLowerCase().includes(searchTerm) ||
                        (pedimento.descripcion || '').toLowerCase().includes(searchTerm) ||
                        (pedimento.descripcion_larga || '').toLowerCase().includes(searchTerm)
                    );
                });
            }

            renderTablaPedimentos(filteredPedimentosData);
        }

        // Función para limpiar el formulario
        function limpiarFormularioPedimento() {
            document.getElementById('formPedimento').reset();
            document.getElementById('pedimentoId').value = '';
            document.getElementById('numeroPedimentoSat').value = '';

            // Limpiar TomSelects
            const selects = ['agencia', 'aduana', 'patenteSat'];
            selects.forEach(selectId => {
                const instance = tomManager.getInstance(selectId);
                if (instance) {
                    instance.clear();
                }
            });

            // Remover clases de validación
            document.querySelectorAll('.form-control').forEach(input => {
                input.classList.remove('is-valid', 'is-invalid');
            });
        }

        // Función para preparar modal para nuevo pedimento
        function prepararNuevoPedimento() {
            isEditMode = false;
            limpiarFormularioPedimento();

            document.getElementById('modalPedimentoTitulo').textContent = 'Nuevo Pedimento';
            document.getElementById('guardarPedimentoTexto').textContent = 'Guardar';

            // Establecer fecha actual por defecto
            const today = new Date().toISOString().split('T')[0];
            document.getElementById('fecha').value = today;
        }

        // Función para editar pedimento
        async function editarPedimento(pedimentoId) {
            try {
                // Buscar el pedimento en los datos cargados
                const pedimento = pedimentosListData.find(p => p.id_pedimento === pedimentoId);

                if (!pedimento) {
                    toastMixin.fire({
                        icon: 'error',
                        title: 'Pedimento no encontrado'
                    });
                    return;
                }

                isEditMode = true;
                limpiarFormularioPedimento();

                // Cerrar modal de lista y abrir modal de formulario
                bootstrap.Modal.getInstance(document.getElementById('modalListaPedimentos')).hide();

                setTimeout(() => {
                    // Llenar formulario con datos del pedimento
                    document.getElementById('pedimentoId').value = pedimento.id_pedimento;
                    document.getElementById('pedimento').value = pedimento.pedimento_aduanal || '';
                    document.getElementById('consecutivoSat').value = pedimento.consecutivo_sat || '';
                    document.getElementById('numeroPedimentoSat').value = pedimento.pedimento_sat || '';

                    const agenciaTS = tomManager.getInstance('agencia');
                    const valorActual = agenciaTS?.getValue();
                    agenciaTS?.setValue(pedimento.agente_id || '');

                    const aduanaTS = tomManager.getInstance('aduana');
                    aduanaTS?.setValue(pedimento.aduana_id || '');

                    const patenteSatTS = tomManager.getInstance('patente');
                    patenteSatTS?.setValue(pedimento.patente_id || '');


                    // Manejar la fecha con formato especial
                    const fechaOriginal = dateFormatter(pedimento.fecha);
                    // Separar fecha y hora
                    const [soloFecha] = fechaOriginal.split(" "); // "01/09/40"
                    const [dia, mes, anioCorto] = soloFecha.split("/");

                    // Convertir a entero (para manejar bien el siglo)
                    let anio = parseInt(anioCorto, 10);

                    // ⚡ regla simple: si el año < 50, asumimos 2000+, si no 1900+
                    // (puedes ajustar el umbral según tu caso)
                    anio = anio < 50 ? 2000 + anio : 1900 + anio;

                    // Crear objeto Date
                    const fecha = new Date(anio, mes - 1, dia);

                    // Formato compatible con input[type="date"]
                    const fechaISO = fecha.toISOString().split("T")[0]; // "2040-09-01"

                    document.getElementById("fecha").value = fechaISO;

                    // Establecer valores en TomSelects con más tiempo de espera
                    setTimeout(() => {
                        // Preseleccionar Agencia Aduanal
                        if (pedimento.id_agencia_aduanal) {
                            const agenciaInstance = tomManager.getInstance('agencia');
                            if (agenciaInstance) {
                                console.log('Configurando agencia:', pedimento.id_agencia_aduanal);
                                agenciaInstance.setValue(pedimento.id_agencia_aduanal.toString());
                            }
                        }

                        // Preseleccionar Aduana
                        if (pedimento.id_aduana) {
                            const aduanaInstance = tomManager.getInstance('aduana');
                            if (aduanaInstance) {
                                console.log('Configurando aduana:', pedimento.id_aduana);
                                aduanaInstance.setValue(pedimento.id_aduana.toString());
                            }
                        }

                        // Preseleccionar Patente SAT
                        if (pedimento.id_patente_sat) {
                            const patenteInstance = tomManager.getInstance('patenteSat');
                            if (patenteInstance) {
                                console.log('Configurando patente SAT:', pedimento.id_patente_sat);
                                patenteInstance.setValue(pedimento.id_patente_sat.toString());
                            }
                        }
                    }, 500); // Aumentar tiempo de espera

                    // Actualizar títulos
                    document.getElementById('modalPedimentoTitulo').textContent = 'Editar Pedimento';
                    document.getElementById('guardarPedimentoTexto').textContent = 'Actualizar';

                    // Mostrar modal
                    new bootstrap.Modal(document.getElementById('modalPedimento')).show();
                    generarNumeroPedimento();
                }, 300);

            } catch (error) {
                console.error('Error preparando edición:', error);
                toastMixin.fire({
                    icon: 'error',
                    title: 'Error al preparar la edición'
                });
            }
        }

        // Función para eliminar pedimento
        async function eliminarPedimento(pedimentoId) {
            const pedimento = pedimentosListData.find(p => p.id_pedimento === pedimentoId);
            const nombrePedimento = pedimento ? pedimento.pedimento_sat || pedimento.pedimento_aduanal : 'este pedimento';

            const result = await Swal.fire({
                title: '¿Estás seguro?',
                text: `¿Deseas eliminar ${nombrePedimento}? Esta acción no se puede deshacer.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sí, eliminar',
                cancelButtonText: 'Cancelar'
            });

            if (!result.isConfirmed) return;

            try {
                const formData = new FormData();
                formData.append('pedimentoId', pedimentoId);

                const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                if (token) formData.append('__RequestVerificationToken', token);

                const response = await fetch('/ProcesoComprasInternacional/EliminarPedimento', {
                    method: 'POST',
                    body: formData
                });

                const data = await response.json();

                if (data.success) {
                    toastMixin.fire({
                        icon: 'success',
                        title: data.message || 'Pedimento eliminado correctamente'
                    });

                    // Recargar tabla
                    await cargarTablaPedimentos();

                    // Recargar pedimentos en el select principal
                    loadPedimentos();
                } else {
                    toastMixin.fire({
                        icon: 'error',
                        title: data.message || 'Error al eliminar pedimento'
                    });
                }

            } catch (error) {
                console.error('Error eliminando pedimento:', error);
                toastMixin.fire({
                    icon: 'error',
                    title: 'Error inesperado al eliminar'
                });
            }
        }
        // Función para validar formulario
        function validarFormularioPedimento() {
            const requiredFields = [
                { id: 'pedimento', name: 'Pedimento aduanal' },
                { id: 'fecha', name: 'Fecha' },
                { id: 'consecutivoSat', name: 'Consecutivo SAT' }
            ];

            let isValid = true;

            requiredFields.forEach(field => {
                const input = document.getElementById(field.id);
                const value = input.value.trim();

                if (!value) {
                    input.classList.add('is-invalid');
                    input.classList.remove('is-valid');
                    isValid = false;
                } else {
                    input.classList.add('is-valid');
                    input.classList.remove('is-invalid');
                }
            });

            if (!isValid) {
                toastMixin.fire({
                    icon: 'warning',
                    title: 'Campos requeridos',
                    text: 'Por favor completa todos los campos requeridos'
                });
            }

            return isValid;
        }
    </script>
}