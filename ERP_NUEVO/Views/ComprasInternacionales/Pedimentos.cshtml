            document.getElementById('clearSelectionBtn').addEventListener('click', clearAssignmentSelection);

            // Event listener para guardar pedimento
            const saveButton = document.querySelector("#modalPedimento .btn-primary");
            if (saveButton) {
                saveButton.removeEventListener("click", guardarPedimento); // Remover listener anterior
                saveButton.addEventListener("click", guardarPedimento);
            }
            // Validación en tiempo real
            document.querySelectorAll('#formPedimento input[required]').forEach(input => {
                input.addEventListener('blur', () => {
                    if (input.value.trim()) {
                        input.classList.add('is-valid');
                        input.classList.remove('is-invalid');
                    } else {
                        input.classList.add('is-invalid');
                        input.classList.remove('is-valid');
