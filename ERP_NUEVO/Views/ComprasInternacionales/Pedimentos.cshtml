            // 3. Inicializar los TomSelects del pedimento
            GetData({
                path: '/ProcesoComprasInternacional/GetPedimentoDataSelect',
            }).then((data) => {
                const pedimentoConfigs = {
                    agencia: allConfigs.agencia,
                    patente: allConfigs.patente,
                    aduana: allConfigs.aduana
                };

                const results = tomManager.initializeFromConfig(data, pedimentoConfigs);

                Object.entries(results).forEach(([id, result]) => {
                    if (!result.success) {
                        console.warn(`No se pudo inicializar TomSelect '${id}':`, result.error);
                    }
                });

                // Configurar eventos para generar número de pedimento
                setTimeout(() => {
                    const instances = ['agencia', 'patente', 'aduana'];
                    instances.forEach(instanceName => {
                        const instance = tomManager.getInstance(instanceName);
                        if (instance) {
                            instance.on("change", generarNumeroPedimento);
                        }
                    });
                }, 100);

                // Cargar pedimentos
                loadPedimentos();
            }).catch((error) => {
                console.error('Error al obtener los datos para TomSelects:', error);
            });
        });

        function selectAllProducts() {
            if (!documentsData.partidas || documentsData.partidas.length === 0) {
                toastMixin.fire({
                    icon: "warning",
                    title: "No hay productos disponibles para seleccionar"
                });
                return;
            }

            let selectedCount = 0;
            let invalidCount = 0;
            const invalidProducts = [];

            documentsData.partidas.forEach(product => {
                const productId = product.id_partidas;
                const checkbox = document.getElementById(`product_${productId}`);
                const quantityInput = document.getElementById(`quantity_${productId}`);
                const element = document.querySelector(`[data-product-id="${productId}"]`);

                if (checkbox && !checkbox.checked) {
                    // Verificar si el producto tiene cantidad disponible
                    if (product.cantidad_pendiente > 0) {
                        // Simular click en el checkbox
                        checkbox.checked = true;
                        handleProductSelection(productId, true, element);
                        selectedCount++;
                    } else {
                        invalidProducts.push(product.descripcion);
                        invalidCount++;
                    }
                }
            });

            // Mostrar resultado
            if (selectedCount > 0) {
                toastMixin.fire({
                    icon: "success",
                    title: `${selectedCount} productos seleccionados`,
                    text: invalidCount > 0 ? `${invalidCount} productos sin stock disponible fueron omitidos` : undefined
                });

                // Scroll hacia la sección de asignación si está visible
                const assignmentSection = document.getElementById('assignmentSection');
                if (assignmentSection.style.display !== 'none') {
                    assignmentSection.scrollIntoView({
                        behavior: "smooth",
                        block: "start"
                    });
                }
            } else {
                const message = invalidCount > 0
                    ? "No hay productos con stock disponible para seleccionar"
                    : "Todos los productos ya están seleccionados";

                toastMixin.fire({
                    icon: "info",
                    title: message
                });
            }
        }

        function updateSelectAllButton() {
            const selectAllBtn = document.getElementById('selectAllBtn');
            if (!selectAllBtn || !documentsData.partidas) return;

            const totalProducts = documentsData.partidas.length;
            const selectedProducts = selectedProductsForAssignment.size;

            if (selectedProducts === 0) {
                selectAllBtn.innerHTML = '<i class="fas fa-check-double me-1"></i> Seleccionar Todo';
                selectAllBtn.className = 'btn btn-info';
            } else if (selectedProducts === totalProducts) {
                selectAllBtn.innerHTML = '<i class="fas fa-square-check me-1"></i> Todo Seleccionado';
                selectAllBtn.className = 'btn btn-success';
            } else {
                selectAllBtn.innerHTML = '<i class="fas fa-check-double me-1"></i> Seleccionar Restantes';
                selectAllBtn.className = 'btn btn-info';
            }
        }
