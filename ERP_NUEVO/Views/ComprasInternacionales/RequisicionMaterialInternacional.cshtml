<script>
    document.getElementById('form-subir-csv').addEventListener('submit', function (e) {
        e.preventDefault();

        const inputFile = document.getElementById('archivoCsv');
        const archivo = inputFile.files[0];
        if (!archivo) {
            alert("Selecciona un archivo CSV.");
            return;
        }

        const formData = new FormData();
        formData.append("archivoCsv", archivo);

        const progressBar = document.querySelector('.progress-bar-modern');
        const progressFill = document.querySelector('.progress-fill');

        // Mostrar barra
        progressBar.classList.remove('d-none');
        progressFill.style.width = '0%';

        // Simular progreso mientras esperamos respuesta
        let progress = 0;
        const interval = setInterval(() => {
            progress += Math.random() * 10;
            if (progress >= 95) {
                progress = 95; // Detenemos el avance aquí hasta que el servidor responda
            }
            progressFill.style.width = progress + '%';
        }, 200);

        fetch('/Planeador/ProcesarCsv', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(res => {
                clearInterval(interval);
                progressFill.style.width = '100%';

                setTimeout(() => {
                    progressBar.classList.add('d-none');
                    progressFill.style.width = '0%';
                }, 800);

                if (res.success) {
                    const tbody = document.querySelector('#tabla-materiales tbody');
                    //tbody.innerHTML = ""; // limpiar

                    res.data.forEach((fila, index) => {
                        const tr = document.createElement('tr');

                        tr.innerHTML = `
                        <td><input type="checkbox" checked /></td>
                        <td>${index + 1}</td>
                        <td class="input-cantidad">${fila["Cantidad"] || 0}</td>
                        <td>${fila["Clave Producto"] || ''}</td>
                        <td>${fila["Unidad Medida"] || ''}</td>
                        <td contenteditable="true" class="precio-unitario">$ ${fila["Precio Unitario"] || '0.00'}</td>
                        <td class="total-fila">${(parseFloat(fila["Cantidad"]) * parseFloat(fila["Precio Unitario"])) || 0}</td>
                    `;

                        tbody.appendChild(tr);
                    });
                    calcularTotales();
                } else {
                    alert(res.message || "Error al procesar el archivo.");
                }
            })
            .catch(err => {
                clearInterval(interval);
                progressBar.classList.add('d-none');
                progressFill.style.width = '0%';
                console.error(err);
                alert("Error en la solicitud.");
            });
    });


    document.getElementById('btnAgregarFila').addEventListener('click', async function () {
        await cargarProveedores(); // ← Llenar proveedoresList antes de insertar cualquier fila

        const tbody = document.querySelector('#tabla-materiales tbody');
        const rowCount = tbody.rows.length;

        const tr = document.createElement('tr');
        tr.innerHTML = `
            <td><input type="checkbox" checked /></td>
            <td>${rowCount + 1}</td>
            <td class="input-cantidad" contenteditable="true">0</td>
            <td contenteditable="true"></td>
            <td contenteditable="true"></td>
            <td contenteditable="true"></td>
            <td contenteditable="true" class="precio-unitario">$ 0.00</td>
            <td class="total-fila">0</td>
        `;


        tbody.appendChild(tr);

        calcularTotales(); // si quieres que se actualicen los totales inmediatamente
    });


    let proveedoresList = [];
    async function cargarProveedores() {
        const prov = await fetch('/Requisicion/getListaProveedores');
        proveedoresList = await prov.json();
    }
    function inicializarTomSelectProveedor(select, valor = null) {
        const ts = new TomSelect(select, {
            persist: false,
            createOnBlur: true,
            create: true,
            options: proveedoresList,
            valueField: "id",
            labelField: "nombre",
            searchField: ["clave", "nombre"],
            render: {
                option: function (data, escape) {
                    return `<div style="color: var(--text-dark)">${escape(data.nombre)}</div>`;
                },
                item: function (data, escape) {
                    return `<div style="color: var(--text-dark)">${escape(data.nombre)}</div>`;
                }
            }
        });

        if (valor) ts.setValue(valor);
    }

    document.getElementById('btnEliminarSeleccionados').addEventListener('click', function () {
        const tbody = document.querySelector('#tabla-materiales tbody');
        const filas = tbody.querySelectorAll('tr');

        filas.forEach(fila => {
            const checkbox = fila.querySelector('input[type="checkbox"]');
            if (checkbox && checkbox.checked) {
                fila.remove();
            }
        });

        reenumerarFilas();
        calcularTotales();
    });


    function reenumerarFilas() {
        const filas = document.querySelectorAll('#tabla-materiales tbody tr');
        filas.forEach((tr, index) => {
            tr.children[1].textContent = index + 1; // actualizar el número de fila
        });
    }
</script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const tablaWrapper = document.getElementById("tabla-materiales-wrapper");
        const contenidoParcialidades = document.getElementById("contenido-parcialidades");

        function toggleContenido() {
            const radioExhibicion = document.getElementById("exhibicion");
            const radioParcialidades = document.getElementById("parcialidades");

            if (radioExhibicion?.checked) {
                tablaWrapper?.classList.remove("d-none");
                contenidoParcialidades?.classList.add("d-none");
            } else if (radioParcialidades?.checked) {
                tablaWrapper?.classList.add("d-none");
                contenidoParcialidades?.classList.remove("d-none");
            } else {
                tablaWrapper?.classList.add("d-none");
                contenidoParcialidades?.classList.add("d-none");
            }
        }

        // Escuchar evento de cambio de paso
        $('#smartwizard').on("showStep", function (e, anchorObject, stepIndex, stepDirection) {
            if (stepIndex === 1) { // paso 2 (índice 1)
                toggleContenido();
            }
        });

        // También actualizar al hacer clic en tarjetas
        document.querySelectorAll('.product-card').forEach(card => {
            card.addEventListener('click', function () {
                document.querySelectorAll('.product-card').forEach(c => c.classList.remove('selected'));
                this.classList.add('selected');

                const radio = this.querySelector('input[type="radio"]');
                radio.checked = true;

                // Ejecutar el toggle
                toggleContenido();
            });
        });

    });
</script>
<script>
    // Funcionalidad de drag & drop
    const uploadZone = document.querySelector('.upload-zone');
    const fileInput = document.getElementById('archivoCsv');
    const form = document.getElementById('form-subir-csv');
    const progressBar = document.querySelector('.progress-bar-modern');
    const progressFill = document.querySelector('.progress-fill');

    // Prevenir comportamiento por defecto
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        uploadZone.addEventListener(eventName, preventDefaults, false);
        document.body.addEventListener(eventName, preventDefaults, false);
    });

    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    // Highlighting de la zona de drop
    ['dragenter', 'dragover'].forEach(eventName => {
        uploadZone.addEventListener(eventName, highlight, false);
    });

    ['dragleave', 'drop'].forEach(eventName => {
        uploadZone.addEventListener(eventName, unhighlight, false);
    });

    function highlight(e) {
        uploadZone.classList.add('dragover');
    }

    function unhighlight(e) {
        uploadZone.classList.remove('dragover');
    }

    // Manejo del drop
    uploadZone.addEventListener('drop', handleDrop, false);

    function handleDrop(e) {
        const dt = e.dataTransfer;
        const files = dt.files;

        if (files.length > 0) {
            fileInput.files = files;
            updateFileDisplay(files[0]);
        }
    }

    // Actualizar display cuando se selecciona archivo
    fileInput.addEventListener('change', function (e) {
        if (e.target.files.length > 0) {
            updateFileDisplay(e.target.files[0]);
        }
    });

    function updateFileDisplay(file) {
        const uploadContent = document.querySelector('.upload-content');
        uploadContent.innerHTML = `
                <i class="fas fa-file-csv upload-icon text-success"></i>
                <h5 class="mb-3 text-success fw-bold">Archivo seleccionado</h5>
                <p class="text-muted mb-0">${file.name}</p>
                <small class="text-muted d-block mt-2">Tamaño: ${(file.size / 1024 / 1024).toFixed(2)} MB</small>
            `;
    }

</script>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const select = document.getElementById('documentSelect');
        const btnCargar = document.getElementById('btnCargarDocumento');

        if (!select || !btnCargar) {
            console.error('Elementos no encontrados:', { select: !!select, btnCargar: !!btnCargar });
            return;
        }

        // Cargar documentos
        GetData({
            path: '/RequisicionInternacional/GetDocumentos',
            data: {}
        }).then((_res) => {
            if (_res.success) {
                select.innerHTML = `<option value="" selected>-- Selecciona un documento --</option>`;
                _res.result.forEach(doc => {
                    const option = document.createElement('option');
                    const value = doc.id_encabezado || doc.codigo;
                    const text = doc.nombre || doc.descripcion;
                    if (value) { // Solo agregar si tiene valor válido
                        option.value = value;
                        option.textContent = text;
                        select.appendChild(option);
                    }
                });
            } else {
                toastMixin.fire({
                    icon: 'error',
                    title: _res.message || 'Error al obtener documentos.'
                });
            }
        }).catch(err => {
            toastMixin.fire({
                icon: 'error',
                title: 'Ocurrió un error al cargar documentos.'
            });
        });

        // Event listener para cargar documento
        btnCargar.addEventListener('click', function () {
            const selectedValue = select.value;
            if (!selectedValue || selectedValue === '') {
                alert('Por favor selecciona un documento');
                return;
            }

            const formData = new FormData();
            formData.append('encabezado_id', selectedValue);

            fetch('/RequisicionInternacional/GetDocumentosAndPartidasData', {
                method: 'POST',
                body: formData
            })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        // Llenar la tabla con los datos obtenidos
                        llenarTablaMateriales(data.result || data.data || data);
                        let divi = document.getElementById('divisa');
                        divi.value = data.result[0]['ccy'];
                        divi.dispatchEvent(new Event('change'));
                        tsProveedor.setValue(data.result[0]['refe']);

                        toastMixin.fire({
                            icon: 'success',
                            title: 'Documento cargado correctamente.'
                        });
                    } else {
                        toastMixin.fire({
                            icon: 'error',
                            title: data.message || 'Error al cargar documento.'
                        });
                    }
                })
                .catch(err => {
                    toastMixin.fire({
                        icon: 'error',
                        title: 'Error en la comunicación con el servidor.'
                    });
                });
        });

        // Función para llenar la tabla de materiales
        function llenarTablaMateriales(data) {
            const tbody = document.querySelector('#tabla-materiales tbody');

            // Limpiar tabla existente
            tbody.innerHTML = "";

            // Llenar tabla con los datos
            data.forEach((fila, index) => {
                const tr = document.createElement('tr');

                // Calcular total de la fila
                const cantidad = parseFloat(fila["cant_ud"] || 0);
                const precioUnitario = parseFloat(fila["pv_prod"] || 0);
                const total = (cantidad * precioUnitario).toFixed(2);

                tr.innerHTML = `
                <td><input type="checkbox" checked /></td>
                <td>${index + 1}</td>
                <td class="input-cantidad">${cantidad}</td>
                <td>${fila["cve_prod"] || ''}</td>
                <td>${fila["descr_prod"] || ''}</td>
                <td>${fila["ud"] || ''}</td>
                <td contenteditable="true" class="precio-unitario">$ ${precioUnitario.toFixed(2)}</td>
                <td class="total-fila">$ ${total}</td>
            `;

                tbody.appendChild(tr);
            });

            // Calcular totales después de llenar la tabla
            if (typeof calcularTotales === 'function') {
                calcularTotales();
            }
        }

        // Event listeners adicionales para actualizar totales cuando se editen precios
        document.addEventListener('input', function (e) {
            if (e.target.classList.contains('precio-unitario')) {
                actualizarTotalFila(e.target);
                if (typeof calcularTotales === 'function') {
                    calcularTotales();
                }
            }
        });

        // Función para actualizar el total de una fila específica
        function actualizarTotalFila(precioElement) {
            const fila = precioElement.closest('tr');
            const cantidadElement = fila.querySelector('.input-cantidad');
            const totalElement = fila.querySelector('.total-fila');

            if (cantidadElement && totalElement) {
                const cantidad = parseFloat(cantidadElement.textContent || 0);
                const precio = parseFloat(precioElement.textContent.replace('$', '').trim() || 0);
                const total = (cantidad * precio).toFixed(2);

                totalElement.textContent = `$ ${total}`;
            }
        }
    });
</script>