<div class="progress">
    <div class="progress-bar" role="progressbar" style="width: 25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100"></div>
</div>


<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/smartwizard/dist/js/jquery.smartWizard.min.js"></script>
<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>


<script>

    let tsProveedor;

    document.addEventListener('DOMContentLoaded', async () => {
        await cargarProveedores();
        tsProveedor = new TomSelect('#proveedorSelect', {
            persist: false,
            createOnBlur: true,
            create: true,
            options: proveedoresList,
            valueField: "id",
            labelField: "nombre",
            searchField: ["clave", "nombre"],
            render: {
                option: (data, escape) => `<div style="color: var(--text-dark)">${escape(data.nombre)}</div>`,
                item: (data, escape) => `<div style="color: var(--text-dark)">${escape(data.nombre)}</div>`
            }
        });
    });

    $('#smartwizard').smartWizard({
        selected: 0,
        theme: 'basic',
        justified: true,
        autoAdjustHeight: true,
        backButtonSupport: true,
        enableUrlHash: true,
        enableFormValidation: true,
        transition: {
            animation: 'slideHorizontal',
            speed: '400',
        },
        toolbar: {
            position: 'both',
            showNextButton: true,
            showPreviousButton: true,
        },
        anchor: {
            enableNavigation: true,
            enableNavigationAlways: false,
            enableDoneState: true,
            markPreviousStepsAsDone: true,
            unDoneOnBackNavigation: false,
            enableDoneStateNavigation: true
        },
        lang: {
            next: 'Siguiente',
            previous: 'Anterior'
        }
    });

    // Validación manual con clases
    $("#smartwizard").on("leaveStep", function (e, anchorObject, currentStepIdx, nextStepIdx, stepDirection) {
        if (stepDirection === 'forward') {
            const form = document.getElementById('form-' + (currentStepIdx + 1));
            const navItem = document.querySelector(`.nav-link[href="#step-${currentStepIdx + 1}"]`);

            const tabla = document.getElementById('tabla-materiales');

            if (form && !form.checkValidity()) {
                form.classList.add('was-validated');
                if ((currentStepIdx + 1) === 2) {
                    navItem?.classList.add('error');
                    toastMixin.fire({
                        icon: 'error',
                        title: 'Debes seleccionar un usuario.'
                    })
                    return false;
                }

                // Marca el paso como inválido visualmente
                navItem?.classList.add('error');

                toastMixin.fire({
                    icon: 'error',
                    title: 'Debes seleccionar el tipo de producto.'
                })

                return false;
            }

            // Quita el estilo de error si ya es válido
            if ((currentStepIdx + 1) === 2) {
                var validate = validarDatos();
                if (!validate) {
                    navItem?.classList.add('error');
                    return false;
                }

                generarResumen();
                navItem?.classList.remove('error');
            }

            navItem?.classList.remove('error');
        }
    });


    $('#smartwizard').smartWizard("reset");

    document.querySelectorAll('.product-card').forEach(card => {
        card.addEventListener('click', function () {
            // Remover selección anterior
            document.querySelectorAll('.product-card').forEach(c => c.classList.remove('selected'));

            // Seleccionar la tarjeta actual
            this.classList.add('selected');

            // Marcar el radio button
            const radio = this.querySelector('input[type="radio"]');
            radio.checked = true;
        });
    });
    const limpiarNumero = (str) => str.replace(/[^\d.]/g, '');
    document.getElementById("divisa").addEventListener("change", function () {
        const selected = this.value;
        const tasaCambioInput = document.getElementById("tipoCambio");

        const tasa = {
            PESOS: parseFloat(this.dataset.mxn),
            DLLS: parseFloat(this.dataset.usd),
            EURO: parseFloat(this.dataset.eur)
        }[selected] || 1;

        tasaCambioInput.value = tasa.toFixed(4);

        // Recalcula los totales ajustados al tipo de cambio
        calcularTotales();
    });

    function calcularTotales() {
        if (typeof Currency === 'undefined' || typeof CurrencyUSD === 'undefined' || typeof CurrencyEUR === 'undefined') {
            console.warn("Los formateadores de moneda aún no están definidos.");
            return; // Salir de la función para evitar errores
        }

        let subtotal = 0;
        const filas = document.querySelectorAll("#tabla-materiales tbody tr");
        const tipoCambio = parseFloat(document.getElementById("tipoCambio")?.value) || 1;
        const divisa = document.getElementById("divisa")?.value || 'PESOS';

        filas.forEach((row, i) => {
            row.cells[1].innerText = i + 1;
            const cantidad = limpiarNumero(row.cells[2].innerText);
            const costoUnitario = limpiarNumero(row.cells[6].innerText);
            const total = cantidad * costoUnitario;
            row.querySelector(".total-fila").innerText = total ? `$ ${total.toFixed(2)}` : "$ 0.00";
            subtotal += total;
        });

        const formatters = {
            'PESOS': Currency,
            'DLLS': CurrencyUSD,
            'EURO': CurrencyEUR
        };

        const totalFinalPesos = subtotal * tipoCambio;

        document.getElementById("total").value = formatters[divisa]?.format(subtotal) || Currency.format(subtotal);

        const pesos = document.getElementById("totalpesos");
        pesos.innerHTML = (divisa !== 'PESOS') ? `Total: ${Currency.format(totalFinalPesos)} MXN` : '';
    }

    // Escuchar cambios en celdas iniciales
    document.querySelectorAll("#tabla-materiales tbody td[contenteditable='true']").forEach(cell => {
        cell.addEventListener("input", calcularTotales);
    });

    calcularTotales();



    document.getElementById("btn-enviar").addEventListener("click", async function () {
        const radioExhibicion = document.getElementById('exhibicion');
        const radioParcialidades = document.getElementById('parcialidades');
        const esExhibicion = radioExhibicion?.checked;
        const esParcialidades = radioParcialidades?.checked;
        const esVenta = document.getElementById("venta")?.checked === true;

        const observaciones = document.getElementById("observaciones")?.value.trim();
        const observaciones2 = document.getElementById("observaciones2")?.value.trim();        
        const divisa = document.getElementById("divisa")?.value;
        const total = limpiarNumero(document.getElementById("total")?.value.trim(),divisa);
        const incoterm = document.getElementById("incoterm")?.value;
        const padre = document.getElementById("documentSelect")?.value;

        const tipoSeleccionado = document.querySelector('input[name="tpnom"]:checked')?.value;
        const archivoPdf = document.getElementById("archivoPdf")?.files?.[0];
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

        const datosEnviar = {
            observaciones,
            observaciones2,
            total,
            tpnom: tipoSeleccionado,
            tipo_producto: esVenta ? 'directo' : 'indirecto',
            divisaSeleccionado: divisa || null,
            incotermSeleccionado: incoterm || null,
            padre: padre || null,
            proveedor: document.getElementById("proveedorSelect")?.value.trim() || '—' || null,
        };

        // FLUJO PARCIALIDADES (PDF)
        if (esParcialidades) {
            if (!archivoPdf) {
                Swal.fire('Error', 'Debes subir un archivo PDF.', 'error');
                return;
            }

            const formData = new FormData();
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            if (token) {
                formData.append("__RequestVerificationToken", token.value);
            }
            formData.append('archivoPdf', archivoPdf);
            formData.append('observaciones', observaciones);
            formData.append('observaciones2', observaciones2);
            formData.append('tpnom', tipoSeleccionado);
            formData.append('tipo_producto', datosEnviar.tipo_producto);
            formData.append('total', total);
            formData.append('divisa', divisa);
            formData.append('incoterm', incoterm);
            formData.append('proveedor', document.getElementById("proveedorSelect")?.value.trim() || '—' || null);

            Swal.fire({
                title: 'Enviando solicitud con PDF',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });

            try {
                const response = await fetch('/RequisicionInternacional/CreateParcialidades', {
                    method: 'POST',
                    body: formData
                });

                const res = await response.json();
                Swal.close();

                if (res.success) {
                    _SwalReload({
                        icon: 'success',
                        title: 'Solicitud enviada con PDF',
                        html: `<p>${res.message}</p><p><strong>Folio:</strong> ${res.folio_generado}</p>`,
                        showCancelButton: false,
                    });
                } else {
                    Swal.fire('Error', res.message || 'Error al enviar solicitud.', 'error');
                }
            } catch (err) {
                Swal.close();
                Swal.fire('Error', 'Ocurrió un error al enviar el PDF.', 'error');
            }

            return;
        }

        // FLUJO EXHIBICIÓN (tabla de materiales)
        const filasMateriales = [];
        let errorFila = false;

        document.querySelectorAll("#tabla-materiales tbody tr").forEach((fila) => {
            const cantidad = limpiarNumero(fila.cells[2]?.innerText.trim());
            const codigo = fila.cells[3]?.innerText.trim();
            const descripcion = fila.cells[4]?.innerText.trim();
            const unidad = fila.cells[5]?.innerText.trim();
            const costoUnitario = limpiarNumero(fila.cells[6]?.innerText.trim());

            let totalFila, precioVenta;
            let filaValida = cantidad && cantidad !== "0" && codigo && unidad && costoUnitario && costoUnitario !== "0.00";


            totalFila = limpiarNumero(fila.cells[7]?.innerText.trim());


            if (filaValida) {
                filasMateriales.push({
                    cantidad,
                    codigo,
                    descripcion,
                    unidad,
                    costoUnitario,
                    total: totalFila
                });
            } else {
                errorFila = true;
            }
        });

        if (filasMateriales.length === 0 || errorFila) {
            Swal.fire('Error', 'Hay filas incompletas o vacías en la tabla.', 'error');
            return;
        }

        if (!total || total === "0.00") {
            Swal.fire('Error', 'El total es obligatorio y debe ser mayor a 0.', 'error');
            return;
        }

        Swal.fire({
            title: 'Enviando solicitud',
            allowOutsideClick: false,
            allowEscapeKey: false,
            showConfirmButton: false,
            didOpen: () => Swal.showLoading()
        });

        try {
            const res = await GetData({
                path: '/RequisicionInternacional/OrdenDeCompraInternacional',
                data: {
                    ...datosEnviar,
                    materiales: JSON.stringify(filasMateriales)
                }
            });

            Swal.close();

            if (res.success) {
                _SwalReload({
                    icon: 'success',
                    title: 'Solicitud creada',
                    html: `<p>${res.message}</p><p><strong>Folio:</strong> ${res.folio_generado}</p>`,
                    showCancelButton: false,
                });
            } else {
                Swal.fire('Error', res.message || 'No se pudo completar el proceso.', 'error');
            }
        } catch (err) {
            Swal.close();
            Swal.fire('Error', 'Ocurrió un error al enviar la solicitud.', 'error');
        }
    });


    // Validar datos de la tabla
    function validarDatos() {
        const radioExhibicion = document.getElementById('exhibicion');
        const radioParcialidades = document.getElementById('parcialidades');
        const esExhibicion = radioExhibicion?.checked;
        const esParcialidades = radioParcialidades?.checked;

        const observaciones = document.getElementById("observaciones")?.value.trim();
        const total = limpiarNumero(document.getElementById("total")?.value.trim());

        // Validación cuando es proveedor con pago en parcialidades (solo PDF)
        if (esParcialidades) {
            const archivoPdf = document.getElementById("archivoPdf");

            if (!archivoPdf || archivoPdf.files.length === 0) {
                toastMixin.fire({
                    icon: 'error',
                    title: 'Debes subir un archivo PDF.'
                });
                return false;
            }

            return true;
        }

        // Validación para proveedor con pago en una sola exhibición (usa tabla)
        const filasMateriales = [];
        let errorFila = false;

        document.querySelectorAll("#tabla-materiales tbody tr").forEach((fila) => {
            const cantidad = limpiarNumero(fila.cells[2]?.innerText.trim());
            const codigo = fila.cells[3]?.innerText.trim();
            const descripcion = fila.cells[4]?.innerText.trim();
            const unidad = fila.cells[5]?.innerText.trim();
            const costoUnitario = limpiarNumero(fila.cells[6]?.innerText.trim());


            let filaValida = cantidad && cantidad !== "0" && codigo && unidad && costoUnitario && costoUnitario !== "0.00";

            if (filaValida) {
                filasMateriales.push({ cantidad, codigo, unidad, costoUnitario });
            } else {
                errorFila = true;
            }
        });

        if (filasMateriales.length === 0 || errorFila) {
            toastMixin.fire({
                icon: 'error',
                title: 'Hay filas incompletas o vacías. Revisa que todos los campos obligatorios estén llenos.'
            });
            return false;
        }

        if (!total || total === "0.00") {
            toastMixin.fire({
                icon: 'error',
                title: 'El total es obligatorio y debe ser mayor a 0.'
            });
            return false;
        }

        return true;
    }


    // Formatear campos numericos
    const radios = document.querySelectorAll('input[name="tpnom"]');
    const tabla = document.querySelector(`#tabla-materiales`);

    tabla.addEventListener("blur", (e) => {
        if (e.target.matches("td.precio-unitario") || e.target.matches("td.precio-venta")) {
            const tr = e.target.closest("tr");
            const tdPrecio = tr.querySelector(".precio-unitario");

            const tdTotal = tr.querySelector(".total-fila");

            // Sanitizar ambos
            let precioStr = tdPrecio.innerText.replace(/[^0-9.,]/g, '').replace(',', '.');
            let precio = parseFloat(precioStr);
            if (isNaN(precio)) precio = 0;
            tdPrecio.innerText = `$ ${precio.toFixed(2)}`;

            const cantidad = parseFloat(tr.querySelector(".input-cantidad")?.innerText) || 0;
            const total = precio * cantidad;
            tdTotal.innerText = `$ ${total.toFixed(2)}`;
            calcularTotales()
        }
    }, true);

    // Limpieza visual al enfocar ambos campos
    tabla.addEventListener("focusin", (e) => {
        if (e.target.matches("td.precio-unitario") || e.target.matches("td.precio-venta")) {
            const raw = e.target.innerText.replace(/[^0-9.,]/g, '').replace(',', '.');
            e.target.innerText = raw ? parseFloat(raw) : '';
        }
    });
    function limpiarNumerototal(valor, divisa) {
        if (!valor) return 0;

        let limpio = valor.trim();

        // Quitar símbolos de moneda
        limpio = limpio.replace(/[$€\s]/g, ''); // quitar espacios también

        if (divisa === 'EURO') {
            // Si hay punto y coma europeo
            // "1.234,56" → "1234.56"
            if (limpio.includes(',')) {
                // quitar todos los puntos (separador de miles)
                limpio = limpio.replace(/\./g, '');
                // reemplazar la coma decimal por punto
                limpio = limpio.replace(/,/g, '.');
            }
        } else {
            // Formato normal: quitar comas de miles
            limpio = limpio.replace(/,/g, '');
        }

                return Currency.format(limpio) || 0;


    }

    // Resumen para el tercer paso del wizard
    function generarResumen() {
        const resumenDiv = document.getElementById('resumen');
        resumenDiv.innerHTML = '';

        const esVenta = document.getElementById("venta")?.checked === true;
        const esCompraDirecta = document.getElementById("modoCompraDirecta")?.checked === true;
        const esExhibicion = document.getElementById("exhibicion")?.checked === true;

        const observaciones = document.getElementById("observaciones")?.value.trim() || '—';
        const observaciones2 = document.getElementById("observaciones2")?.value.trim() || '—';
        const divisa = document.getElementById("divisa")?.value.trim() || '—';
        const incoterm = document.getElementById("incoterm")?.value.trim() || '—';
        const proveedor = tsProveedor.getItem(tsProveedor.getValue())?.textContent || '—';
        const total = limpiarNumerototal(document.getElementById("total")?.value, divisa);
        const totalPesos = document.getElementById("totalpesos");
        const datos = [
            { titulo: "Total", valor: `${total}`, badge: true },
            { titulo: "Observaciones", valor: observaciones },
            { titulo: "Divisa", valor: divisa },
            { titulo: "incoterm", valor: incoterm },
            { titulo: "proveedor", valor: proveedor },
        ];

        let cardsHtml = '';
        let tipoMensaje = '';
        if (esExhibicion) {
            tipoMensaje = 'Estos productos fueron seleccionados para <strong>proveedores con pago en una sola exhibición</strong>.';
        } else if (document.getElementById("parcialidades")?.checked) {
            tipoMensaje = 'Estos productos fueron seleccionados para <strong>proveedores con pago en parcialidades o diferido</strong>.';
        } else {
            tipoMensaje = 'No se ha seleccionado el tipo de proveedor.';
        }

        let contenidoCentral = '';
        const filasMateriales = document.querySelectorAll("#tabla-materiales tbody tr");
        const tieneMateriales = filasMateriales.length > 0;
