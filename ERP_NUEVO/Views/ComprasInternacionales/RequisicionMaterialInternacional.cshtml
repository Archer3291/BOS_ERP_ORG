@using BOS_ERP.Controllers;
﻿@{
    ViewBag.Title = "Orden de compra internacional";
    ViewBag.PageTitle = "Orden de compra internacional";
    Layout = "~/Views/Shared/_Layout.cshtml";

}
<link href="~/content/Site.css" rel="stylesheet" />
<style>
    :root {
        /* Wizard colors adaptados a tu paleta */
        --sw-border-color: var(--border-light);
        --sw-toolbar-btn-color: var(--bg-light);
        --sw-toolbar-btn-background-color: var(--primary-blue);
        --sw-anchor-default-primary-color: var(--very-light-blue);
        --sw-anchor-default-secondary-color: var(--text-light);
        --sw-anchor-active-primary-color: var(--primary-blue);
        --sw-anchor-active-secondary-color: var(--bg-light);
        --sw-anchor-done-primary-color: var(--light-blue);
        --sw-anchor-done-secondary-color: var(--bg-light);
        --sw-anchor-disabled-primary-color: var(--very-light-blue);
        --sw-anchor-disabled-secondary-color: var(--border-light);
        --sw-anchor-error-primary-color: #dc3545; /* Mantengo el rojo original para errores */
        --sw-anchor-error-secondary-color: var(--bg-light);
        --sw-anchor-warning-primary-color: #ffc107; /* Mantengo el amarillo original para warnings */
        --sw-anchor-warning-secondary-color: var(--bg-light);
        --sw-progress-color: var(--primary-blue);
        --sw-progress-background-color: var(--very-light-blue);
        --sw-loader-color: var(--primary-blue);
        --sw-loader-background-color: var(--very-light-blue);
        --sw-loader-background-wrapper-color: rgba(255, 255, 255, 0.7);
    }

    [data-theme="dark"] {
        /* Wizard colors para tema oscuro */
        --sw-border-color: var(--border-light);
        --sw-toolbar-btn-color: var(--bg-light);
        --sw-toolbar-btn-background-color: var(--primary-blue);
        --sw-anchor-default-primary-color: var(--very-light-blue);
        --sw-anchor-default-secondary-color: var(--text-light);
        --sw-anchor-active-primary-color: var(--primary-blue);
        --sw-anchor-active-secondary-color: var(--bg-light);
        --sw-anchor-done-primary-color: var(--light-blue);
        --sw-anchor-done-secondary-color: var(--bg-light);
        --sw-anchor-disabled-primary-color: var(--very-light-blue);
        --sw-anchor-disabled-secondary-color: var(--border-light);
        --sw-anchor-error-primary-color: #ef4444; /* Rojo más suave para tema oscuro */
        --sw-anchor-error-secondary-color: var(--bg-light);
        --sw-anchor-warning-primary-color: #f59e0b; /* Amarillo más suave para tema oscuro */
        --sw-anchor-warning-secondary-color: var(--bg-light);
        --sw-progress-color: var(--primary-blue);
        --sw-progress-background-color: var(--very-light-blue);
        --sw-loader-color: var(--primary-blue);
        --sw-loader-background-color: var(--very-light-blue);
        --sw-loader-background-wrapper-color: rgba(17, 24, 39, 0.7); /* Ajustado para tema oscuro */
    }

    .form-header {
        text-align: center;
        margin-bottom: 2rem;
    }

        .form-header h4 {
            color: var(--primary-blue);
            font-weight: 600;
            margin-bottom: 0.5rem;
        }

        .form-header p {
            color: var(--text-light);
            font-size: 0.95rem;
        }

    .purchase-mode-toggle {
        background: linear-gradient(135deg, var(--very-light-blue), var(--light-blue));
        border-radius: 12px;
        padding: 1rem;
        margin-bottom: 2rem;
        border: 1px solid var(--border-light);
    }

    .modern-switch {
        width: 60px;
        height: 24px;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .modern-switch:checked {
            background-color: var(--primary-blue);
            border-color: var(--primary-blue);
        }

    .form-switch .form-check-input {
        width: 3em;
    }

    .switch-label {
        font-weight: 500;
        color: var(--text-dark);
        cursor: pointer;
    }

    .switch-icon {
        font-size: 1.2rem;
        margin-right: 0.5rem;
    }

    .product-card {
        background: var(--bg-light);
        border: 2px solid var(--border-light);
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        cursor: pointer;
        position: relative;
        overflow: hidden;
    }

        .product-card:hover {
            border-color: var(--primary-blue);
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

        .product-card.selected {
            border-color: var(--primary-blue);
            background: linear-gradient(135deg, var(--very-light-blue), var(--light-blue));
        }

        .product-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-blue), var(--secondary-blue));
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .product-card.selected::before {
            opacity: 1;
        }

        .product-card.selected .product-icon {
            color: var(--primary-blue-dark);
        }

    .product-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.5rem;
    }

    .product-description {
        color: var(--text-light);
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .product-features {
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid var(--border-light);
    }

    .feature-item {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
        color: var(--text-light);
        font-size: 0.85rem;
    }

        .feature-item i {
            color: var(--primary-blue);
            margin-right: 0.5rem;
            width: 16px;
        }

    .btn-check {
        position: absolute;
        clip: rect(0, 0, 0, 0);
        pointer-events: none;
    }

    .invalid-feedback {
        display: block;
        width: 100%;
        margin-top: 0.25rem;
        font-size: 0.875rem;
        color: #dc3545;
    }

    .form-actions {
        text-align: center;
        margin-top: 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--border-light);
    }

    @@media (max-width: 768px) {
        .form-container {
            margin: 1rem;
            padding: 1.5rem;
        }

        .product-card {
            padding: 1rem;
        }
    }

    .info-panel {
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        border: 1px solid #f59e0b;
        border-radius: 8px;
        padding: 1rem;
        margin-bottom: 1.5rem;
    }

        .info-panel .info-title {
            color: #92400e;
            font-weight: 600;
            margin-bottom: 0.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .info-panel .info-text {
            color: #92400e;
            margin: 0;
            font-size: 0.9rem;
        }

    .card-resumen {
        background-color: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 0.75rem;
        box-shadow: var(--shadow);
        padding: 1.25rem 1.5rem;
        transition: background 0.3s ease;
    }

        .card-resumen h6 {
            color: var(--text-light);
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .card-resumen p {
            color: var(--text-dark);
            font-size: 1rem;
        }

    .badge-tag {
        background-color: var(--light-blue);
        color: var(--primary-blue);
        font-weight: 600;
        padding: 0.35rem 0.75rem;
        border-radius: 0.5rem;
        font-size: 0.875rem;
    }

    .table-resumen {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.9rem;
    }

        .table-resumen th {
            background-color: var(--very-light-blue);
            color: var(--dark-blue);
            text-align: left;
            padding: 0.6rem;
            border-bottom: 1px solid var(--border-light);
        }

        .table-resumen td {
            padding: 0.6rem;
            color: var(--text-dark);
            border-bottom: 1px solid var(--border-light);
        }

        .table-resumen tbody tr:nth-child(even) {
            background-color: var(--bg-gray);
        }

    .alert-info-resumen {
        background-color: var(--light-blue);
        color: var(--dark-blue);
        border: 1px solid var(--accent-blue);
        border-radius: 0.75rem;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        font-size: 0.95rem;
        box-shadow: var(--shadow);
    }

    .main-card {
        background: rgba(255, 255, 255, 0.95);
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
        transition: all 0.3s ease;
    }

        .main-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.15);
        }

    .upload-zone {
        border: 3px dashed #007bff;
        border-radius: 5px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .upload-zone::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            transition: left 0.5s;
        }

        .upload-zone:hover {
            border-color: #0056b3;
            transform: scale(1.02);
        }

            .upload-zone:hover::before {
                left: 100%;
            }

        .upload-zone.dragover {
            border-color: #28a745;
            background: linear-gradient(145deg, #e8f5e8 0%, #c8e6c9 100%);
            transform: scale(1.05);
        }

        .upload-zone input[type="file"] {
            position: absolute;
            inset: 0; /* shorthand para top: 0; right: 0; bottom: 0; left: 0 */
            width: 100%;
            height: 100%;
            opacity: 0;
            cursor: pointer;
            z-index: 10;
        }

    .file-input {
        opacity: 0;
        position: absolute;
        width: 100%;
        height: 100%;
        cursor: pointer;
    }

    .upload-content {
        pointer-events: none;
        z-index: 1;
        position: relative;
    }

    .upload-icon {
        font-size: 3rem;
        color: #007bff;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
    }

    .upload-zone:hover .upload-icon {
        transform: scale(1.1) rotate(5deg);
    }

    .btn-modern {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        border: none;
        border-radius: 5px;
        padding: 12px 30px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        transition: all 0.3s ease;
        position: relative;
        overflow: hidden;
    }

        .btn-modern::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 123, 255, 0.3);
        }

            .btn-modern:hover::before {
                left: 100%;
            }

    .btn-outline-modern {
        background: transparent;
        border: 2px solid #007bff;
        color: #007bff;
        border-radius: 5px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-outline-modern:hover {
            background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
            color: white;
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 123, 255, 0.2);
        }

    .btn-danger-modern {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%);
        border: none;
        border-radius: 5px;
        padding: 10px 25px;
        font-weight: 600;
        transition: all 0.3s ease;
    }

        .btn-danger-modern:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220, 53, 69, 0.3);
        }

    .title-section {
        background: linear-gradient(135deg, #007bff 0%, #6610f2 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        font-weight: 700;
        margin-bottom: 2rem;
    }

    .feature-card {
        background: rgba(255, 255, 255, 0.8);
        border-radius: 5px;
        padding: 1.5rem;
        margin-bottom: 1rem;
        transition: all 0.3s ease;
        border: 1px solid rgba(0, 123, 255, 0.1);
    }

        .feature-card:hover {
            background: rgba(255, 255, 255, 0.95);
            transform: translateX(10px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }

    .pulse-animation {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            transform: scale(1);
        }

        50% {
            transform: scale(1.05);
        }

        100% {
            transform: scale(1);
        }
    }

    .floating-elements {
        position: absolute;
        width: 100%;
        height: 100%;
        overflow: hidden;
        pointer-events: none;
    }

    .floating-element {
        position: absolute;
        opacity: 0.1;
        animation: float 20s infinite linear;
    }

    @@keyframes float {
        0% {
            transform: translateY(100vh) rotate(0deg);
        }

        100% {
            transform: translateY(-100px) rotate(360deg);
        }
    }

    .progress-bar-modern {
        height: 8px;
        border-radius: 10px;
        background: #e9ecef;
        overflow: hidden;
        margin-top: 1rem;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #007bff, #28a745);
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    #totalpesos {
        font-weight: bold;
        text-align: right;
        border: 1px solid #ced4da;
        border-radius: 0.375rem; /* igual que Bootstrap */
        padding: 0.375rem 0.75rem;
        margin: 0;
    }
</style>

<link href="~/lib/smartwizard/dist/css/smart_wizard_all.min.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<!-- SmartWizard html -->
<div id="smartwizard">
    <ul class="nav nav-progress">
        <li class="nav-item">
            <a class="nav-link" style="background:transparent;" href="#step-1">
                <div class="num">1</div>
                Tipo de proveedor
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" style="background:transparent;" href="#step-2">
                <span class="num">2</span>
                Seleccionar productos
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link" style="background:transparent;" href="#step-3">
                <span class="num">3</span>
                Resumen
            </a>
        </li>
    </ul>

    <div class="tab-content" style="overflow:auto;">
        <div id="step-1" class="tab-pane" style="overflow:auto; height:auto !important;" role="tabpanel" aria-labelledby="step-1">
            <form id="form-1" novalidate>
                <!-- Form Header -->
                <div class="form-header">
                    <h4>Selecciona el tipo de proveedor </h4>
                    <p>Elige la opción que mejor describa el propósito de tu producto </p>
                </div>


                <!-- Opciones de Proveedor -->
                <fieldset class="row g-3" aria-required="true">
                    <legend class="visually-hidden">Tipo de Proveedor</legend>

                    <!-- Proveedor con pago en una sola exhibición -->
                    <div class="col-sm-12 col-md-6">
                        <div class="product-card" data-option="exhibicion">
                            @{
                                @*if (Utilities.GetAreaName(User.Identity.Name) == "Taller")
                                    {
                                        <input type="radio" value="SCTZT" class="btn-check" name="tpnom" id="exhibicion" autocomplete="off" required>
                                    }
                                    else if (Utilities.GetAreaName(User.Identity.Name) == "Ventas Industriales")
                                    {
                                        <input type="radio" value="SCTZI" class="btn-check" name="tpnom" id="exhibicion" autocomplete="off" required>
                                    }
                                    else
                                    {

                                    }*@
                                <input type="radio" value="OCDI" class="btn-check" name="tpnom" id="exhibicion" autocomplete="off" required>
                            }
                            <label for="exhibicion" class="w-100 h-100 d-block">
                                <div class="product-title">Proveedor con pago en una sola exhibición</div>
                                <div class="product-description">
                                    Se utiliza para proveedores que requieren el pago completo al momento de la entrega o factura.
                                </div>
                                <div class="product-features">
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Pago inmediato</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Uso común para compras de productos listos</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Sin gestión de crédito</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>

                    <!-- Proveedor con pago en parcialidades -->
                    <div class="col-sm-12 col-md-6">
                        <div class="product-card" data-option="parcialidades">
                            @{
                                @*if (Utilities.GetAreaName(User.Identity.Name) == "Taller")
                                    {
                                        <input type="radio" value="SCTZT" class="btn-check" name="tpnom" id="parcialidades" autocomplete="off" required>
                                    }
                                    else if (Utilities.GetAreaName(User.Identity.Name) == "Ventas Industriales")
                                    {
                                        <input type="radio" value="SCTZI" class="btn-check" name="tpnom" id="parcialidades" autocomplete="off" required>
                                    }
                                    else
                                    {
                                        <input type="radio" value="SCTZ" class="btn-check" name="tpnom" id="parcialidades" autocomplete="off" required>
                                    }*@
                                <input type="radio" value="PI" class="btn-check" name="tpnom" id="parcialidades" autocomplete="off" required>
                            }
                            <label for="parcialidades" class="w-100 h-100 d-block">
                                <div class="product-title">Proveedor con pago en parcialidades o diferido</div>
                                <div class="product-description">
                                    Se utiliza para proveedores con acuerdos de crédito, pagos programados o financiamiento.
                                </div>
                                <div class="product-features">
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Acuerdo de crédito o financiamiento</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Pagos a plazos o diferidos</span>
                                    </div>
                                    <div class="feature-item">
                                        <i class="fas fa-check"></i>
                                        <span>Seguimiento de pagos programados</span>
                                    </div>
                                </div>
                            </label>
                        </div>
                    </div>
                </fieldset>
            </form>
        </div>
        <div id="step-2" class="tab-pane" style="overflow:auto; height:auto !important;" role="tabpanel" aria-labelledby="step-2">
            <!-- Campos compartidos que aparecen en ambos casos -->
            <div class="container py-4">
                <div class="card main-card rounded-4 border-0 shadow-sm" style="z-index:2;">
                    <div class="card-body p-4">
                        <!-- Divisas y tipo de cambio - COMPARTIDOS -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" id="divisa"
                                            data-usd="@ViewBag.TasaUSD"
                                            data-eur="@ViewBag.TasaEUR"
                                            data-mxn="@ViewBag.TasaMXN">
                                        <option value="PESOS" selected>MXN</option>
                                        <option value="DLLS">USD</option>
                                        <option value="EURO">EUR</option>
                                    </select>
                                    <label for="divisa">Divisa</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="number" class="form-control" id="tipoCambio" step="0.0001" min="0" value="1" placeholder="Tipo de cambio">
                                    <label for="tipoCambio">Tipo de cambio</label>
                                </div>
                            </div>
                        </div>

                        <!-- Incoterm y proveedor - COMPARTIDOS -->
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select class="form-select" id="incoterm" name="incoterm">
                                        <option value="" disabled selected>Selecciona un incoterm</option>
                                        @foreach (var item in ViewBag.Incoterms as List<Dictionary<string, object>>)
                                        {
                                            if (item.ContainsKey("activo") && Convert.ToBoolean(item["activo"]))
                                            {
                                                <option value="@item["codigo"]">@item["descripcion"]</option>
                                            }
                                        }
                                    </select>
                                    <label for="incoterm">Incoterm</label>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <label for="proveedorSelect" class="form-label fw-semibold text-dark mb-2">
                                    <i class="fas fa-truck me-2"></i> Seleccionar proveedor:
                                </label>
                                <select id="proveedorSelect" placeholder="Buscar o agregar proveedor..." class="form-select"></select>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Contenido específico para exhibición (tabla de materiales) -->
            <div id="tabla-materiales-wrapper">
                <div class="container py-5">
                    <div class="card main-card rounded-4 border-0 shadow-sm" style="z-index: 1;">
                        <div class="card-body p-4">
                            <!-- Título -->
                            <div class="text-center mb-4">
                                <h2 class="title-section mb-2">
                                    <i class="fas fa-cloud-upload-alt me-2"></i> Cargar productos
                                </h2>
                                <p class="text-muted">Sube, edita y gestiona tus datos fácilmente</p>
                            </div>

                            <div class="row g-4">
                                <!-- Columna izquierda: acordeones -->
                                <div class="col-lg-6">
                                    <div class="accordion" id="accordionCsvUpload">
                                        <!-- Acordeón CSV -->
                                        <div class="accordion-item border rounded-4 mb-3">
                                            <h2 class="accordion-header" id="headingCsv">
                                                <button class="accordion-button collapsed fw-semibold text-primary" type="button"
                                                        data-bs-toggle="collapse" data-bs-target="#collapseCsv"
                                                        aria-expanded="false" aria-controls="collapseCsv" style="border-radius: 15px;">
                                                    <i class="fas fa-file-csv me-2"></i> Subir archivo CSV
                                                </button>
                                            </h2>
                                            <div id="collapseCsv" class="accordion-collapse collapse" aria-labelledby="headingCsv"
                                                 data-bs-parent="#accordionCsvUpload">
                                                <div class="accordion-body p-3">
                                                    <form id="form-subir-csv" enctype="multipart/form-data">
                                                        <div class="upload-zone text-center p-3 position-relative border rounded bg-light-subtle">
                                                            <input type="file" name="archivoCsv" id="archivoCsv"
                                                                   class="file-input" accept=".csv" required />
