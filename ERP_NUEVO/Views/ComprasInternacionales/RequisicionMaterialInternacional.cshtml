                        <div class="card-body">
                            <h5 class="card-title mb-4">
                                <i class="fas fa-file-pdf me-2 text-danger"></i> Subir archivo PDF
                            </h5>
                            <form id="form-subir-pdf" enctype="multipart/form-data">
                                <div class="mb-3">
                                    <label for="archivoPdf" class="form-label">Selecciona tu archivo .pdf</label>
                                    <input type="file" name="archivoPdf" id="archivoPdf" class="form-control" accept=".pdf" required />
                                </div>

                                <div class="form-floating mb-4">
                                    <textarea class="form-control" id="observaciones2" rows="3"></textarea>
                                    <label class="form-label" for="observaciones2"><i class="bi bi-journal-text"></i> Observaciones</label>
