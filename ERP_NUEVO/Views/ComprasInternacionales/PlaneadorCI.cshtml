                                    <td class="excel-cell">140</td>
                                    <td class="excel-cell">260.58</td>
                                    <td class="excel-cell">0.62</td>
                                    <td class="excel-cell">53.0472</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </li>
        </ul>
    </div>
</div>

<script>
    const fileInput = document.getElementById('fileInput');
    const uploadBox = document.getElementById('uploadBox');
    const selectedFile = document.getElementById('selectedFile');
    const fileName = document.getElementById('fileName');
    const removeFile = document.getElementById('removeFile');
    const submitBtn = document.getElementById('submitBtn');
    const btnText = document.getElementById('btnText');
    const loadingDots = document.getElementById('loadingDots');
    const uploadForm = document.getElementById('uploadForm');

    // Prevenir comportamientos por defecto en toda la página
    function preventDefaults(e) {
        e.preventDefault();
        e.stopPropagation();
    }

    // Prevenir drag and drop en toda la página EXCEPTO en uploadBox
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        document.addEventListener(eventName, (e) => {
            if (!uploadBox.contains(e.target)) {
                preventDefaults(e);
            }
        }, false);
    });

    // Eventos drag and drop específicos del upload box
    uploadBox.addEventListener('dragenter', (e) => {
        preventDefaults(e);
        uploadBox.classList.add('drag-over');
    });

    uploadBox.addEventListener('dragover', (e) => {
        preventDefaults(e);
        uploadBox.classList.add('drag-over');
    });

    uploadBox.addEventListener('dragleave', (e) => {
        preventDefaults(e);
        // Solo remover la clase si realmente salimos del uploadBox
        if (!uploadBox.contains(e.relatedTarget)) {
            uploadBox.classList.remove('drag-over');
        }
    });

    uploadBox.addEventListener('drop', (e) => {
        preventDefaults(e);
        uploadBox.classList.remove('drag-over');
        handleDrop(e);
    });

    function handleDrop(e) {
        const files = e.dataTransfer.files;

        if (files.length > 0) {
            const file = files[0];
            if (file.name.toLowerCase().endsWith('.xlsx')) {
                // Verificar tamaño del archivo (10MB = 10 * 1024 * 1024 bytes)
                if (file.size > 10 * 1024 * 1024) {
                    showError('El archivo es demasiado grande. El tamaño máximo es 10MB.');
                    return;
                }

                // Crear un nuevo DataTransfer para asignar el archivo al input
                const dataTransfer = new DataTransfer();
                dataTransfer.items.add(file);
                fileInput.files = dataTransfer.files;
                handleFileSelect();
            } else {
                showError('Por favor selecciona un archivo .xlsx válido');
            }
        }
    }

    // Manejar selección de archivo del input
    fileInput.addEventListener('change', handleFileSelect);

    function handleFileSelect() {
        const file = fileInput.files[0];
        if (file) {
            if (file.name.toLowerCase().endsWith('.xlsx')) {
                // Verificar tamaño del archivo (10MB = 10 * 1024 * 1024 bytes)
                if (file.size > 10 * 1024 * 1024) {
                    showError('El archivo es demasiado grande. El tamaño máximo es 10MB.');
                    resetUpload();
                    return;
                }

                fileName.textContent = file.name;
                selectedFile.style.display = 'flex';
                uploadBox.classList.add('file-ready');
                submitBtn.disabled = false;
                btnText.textContent = 'Procesar Archivo';
            } else {
                showError('Por favor selecciona un archivo .xlsx válido');
                resetUpload();
            }
        } else {
            resetUpload();
        }
    }

    function resetUpload() {
        fileInput.value = '';
        selectedFile.style.display = 'none';
        uploadBox.classList.remove('file-ready');
        submitBtn.disabled = true;
        btnText.textContent = 'Selecciona un archivo';
    }

    function showError(message) {
        alert(message);
    }

    // Manejar click en el botón de eliminar archivo
    removeFile.addEventListener('click', function (e) {
        // Prevenir completamente la propagación del evento
        e.preventDefault();
        e.stopPropagation();
        e.stopImmediatePropagation();
        resetUpload();
        return false;
    });

    // Manejar click en el upload box para abrir selector de archivos
    uploadBox.addEventListener('click', function (e) {
        // Verificar si el click fue en el área de archivo seleccionado o sus hijos
        if (selectedFile.contains(e.target) || e.target.closest('.selected-file')) {
            return false; // No hacer nada si se hace click en el área del archivo
        }
        fileInput.click();
    });

    // Manejar envío del formulario
    uploadForm.addEventListener('submit', async function (e) {
        e.preventDefault();

        if (!fileInput.files[0]) {
            showError('Por favor selecciona un archivo Excel antes de continuar');
            return;
        }

        // Mostrar estado de carga
        loadingDots.style.display = 'block';
        btnText.textContent = 'Procesando datos...';
        submitBtn.disabled = true;

        const formData = new FormData(uploadForm);
        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        try {
            const response = await fetch('/PlaneadorComercioInternacional/GuardarExcel', {
                method: 'POST',
                body: formData
            });

            const result = await response.json();

            if (result.success) {
                resetUpload(); // Limpiar formulario si es necesario

                Swal.fire({
                    icon: 'success',
                    title: '¡Éxito!',
                    html: result.message.replace(/\n/g, '<br>')
                }).then(() => {
                    // Esto se ejecuta cuando el usuario cierra el SweetAlert
                    location.reload();
                });
            } else {
                // ⚠️ Mostrar error si success = false
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    html: result.message.replace(/\n/g, '<br>')
                });
            }

        } catch (error) {
            Swal.fire({
                icon: 'error',
                title: 'Error inesperado',
                text: error.message
            });
        }
 finally {
            // Restaurar estado del botón
            loadingDots.style.display = 'none';
            btnText.textContent = 'Selecciona un archivo';
            submitBtn.disabled = false;
        }
    });



    // Funcionalidad del tooltip modificada para funcionar con click
    const tooltipTrigger = document.getElementById('dataTooltip');
    const tooltip = document.getElementById('tooltip');

    // Manejar click en el trigger del tooltip
    tooltipTrigger.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        tooltip.classList.toggle('show');
    });

    // Prevenir que el tooltip se cierre cuando se hace click dentro de él
    tooltip.addEventListener('click', (e) => {
        e.stopPropagation();
    });

    // Cerrar tooltip al hacer click fuera de él
    document.addEventListener('click', (e) => {
        if (!tooltipTrigger.contains(e.target) && !tooltip.contains(e.target)) {
            tooltip.classList.remove('show');
        }
    });

</script>
