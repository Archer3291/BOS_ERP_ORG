<div class="container">
    <!-- Estadísticas rápidas -->
    <div class="stats-bar">
        <div class="stat-card">
            <div class="stat-number" id="existentesCount">@Model.ProductosYProveedoresExistentes?.Count ?? 0</div>
            <div class="stat-label">Productos Existentes</div>
        </div>
        <div class="stat-card">
            <div class="stat-number" id="sinProveedorCount">@Model.ProductosConProveedorInexistente?.Count ?? 0</div>
            <div class="stat-label">Sin Proveedor</div>
        </div>
        <div class="stat-card">
            <div class="stat-number" id="nuevosCount">@Model.ProductosNuevos?.Count ?? 0</div>
            <div class="stat-label">Productos Nuevos</div>
        </div>
    </div>

    <!-- Productos y proveedores existentes -->
    <div class="section-card">
        <div class="section-header success">
            <h3 class="section-title">
                <i class="fas fa-check-circle section-icon"></i>
                Productos y proveedores existentes
            </h3>
        </div>
        <div class="table-container p-3">
            <table class="modern-table" id="existentesTable">
                <thead>
                    <tr>
                        @foreach (var enc in Model.EncabezadosGeneral as List<string>)
                        {
                            <th>@enc</th>
                        }
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody >
                    @if (Model.ProductosYProveedoresExistentes != null)
                    {
                        foreach (var fila in Model.ProductosYProveedoresExistentes)
                        {
                            <tr>
                                @foreach (var val in fila.General)
                                {
                                    <td>@val</td>
                                }
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.Proveedor)), "proveedor")'>
                                        Proveedor
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.ProductoSAT)), "productoSAT")'>
                                        Producto SAT
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Productos con proveedor no registrado -->
    <div class="section-card">
        <div class="section-header warning">
            <h3 class="section-title">
                <i class="fas fa-exclamation-triangle section-icon"></i>
                Productos con proveedor no registrado
            </h3>
        </div>
        <div class="table-container p-3">
            <table class="modern-table" id="sinProveedorTable">
                <thead>
                    <tr>
                        @foreach (var enc in Model.EncabezadosGeneral as List<string>)
                        {
                            <th>@enc</th>
                        }
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductosConProveedorInexistente != null)
                    {
                        foreach (var fila in Model.ProductosConProveedorInexistente)
                        {
                            <tr>
                                @foreach (var val in fila.General)
                                {
                                    <td>@val</td>
                                }
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.Proveedor)), "proveedor")'>
                                        Proveedor
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.ProductoSAT)), "productoSAT")'>
                                        Producto SAT
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Productos NUEVOS -->
    <div class="section-card">
        <div class="section-header primary">
            <h3 class="section-title">
                <i class="fas fa-plus-circle section-icon"></i>
                Productos nuevos a insertar
            </h3>
        </div>
        <div class="table-container p-3">
            <table class="modern-table" id="nuevosTable">
                <thead>
                    <tr>
                        @foreach (var enc in Model.EncabezadosGeneral as List<string>)
                        {
                            <th>@enc</th>
                        }
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.ProductosNuevos != null)
                    {
                        for (int i = 0; i < Model.ProductosNuevos.Count; i++)
                        {
                            var fila = Model.ProductosNuevos[i];
                            <tr data-index="@i">
                                @foreach (var val in fila.General)
                                {
                                    <td contenteditable="true" class="editable-cell">@val</td>
                                }
                                <td>
                                    <button type="button" class="btn btn-outline-info btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.Proveedor)), "proveedor")'>
                                        Proveedor
                                    </button>
                                    <button type="button" class="btn btn-outline-secondary btn-sm"
                                            onclick='mostrarDetalleDesdeFila(@Html.Raw(JsonSerializer.Serialize(fila.ProductoSAT)), "productoSAT")'>
                                        Producto SAT
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div style="padding: 2rem;">
            <div class="success-message" id="successMessage" style="display:none;">
                <i class="fas fa-check-circle"></i>
                <span>Productos guardados exitosamente</span>
            </div>
            <div class="error-message" id="errorMessage" style="display:none;">
                <i class="fas fa-exclamation-circle"></i>
                <span>Error al guardar productos</span>
            </div>

            <button class="action-button" onclick="enviarProductos()">
                <i class="fas fa-save"></i>
                Enviar Productos
            </button>
        </div>
    </div>
</div>

<!-- Modal Bootstrap -->
<div class="modal fade" id="detalleModal" tabindex="-1" aria-labelledby="detalleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleModalLabel">Detalle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="detalleModalBody">
                <!-- Contenido dinámico aquí -->
            </div>
        </div>
    </div>
</div>

<!-- Modal Bootstrap -->
<div class="modal fade" id="detalleModal" tabindex="-1" aria-labelledby="detalleModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleModalLabel">Detalle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="detalleModalBody">
                <!-- Contenido dinámico aquí -->
            </div>
        </div>
    </div>
</div>
<script src="~/lib/jquery/jquery.min.js"></script>
<script>

        const proveedores = @Html.Raw(JsonSerializer.Serialize(Model.Proveedor ?? new List<List<string>>()));
        const productosSAT = @Html.Raw(JsonSerializer.Serialize(Model.ProductoSAT ?? new List<List<string>>()));
        const encabezadoProveedores = @Html.Raw(JsonSerializer.Serialize(Model.EncabezadosProveedor ?? new List<string>()));
        const encabezadoProductosSAT = @Html.Raw(JsonSerializer.Serialize(Model.EncabezadosProductoSat ?? new List<string>()));
        const productosSATNuevos = @Html.Raw(JsonSerializer.Serialize(Model.ProductosNuevos.Select(p => p.ProductoSAT).ToList()));
    const proveedoresNuevos = @Html.Raw(JsonSerializer.Serialize(Model.ProductosNuevos.Select(p => p.Proveedor).ToList()));
    function mostrarDetalleDesdeFila(fila, tipo) {
        let data, encabezado, titulo;

        if (tipo === 'proveedor') {
            data = fila; // fila ya es solo proveedor
            encabezado = encabezadoProveedores;
            titulo = 'Detalle del Proveedor';
        } else if (tipo === 'productoSAT') {
            data = fila; // fila solo productoSAT también
            encabezado = encabezadoProductosSAT;
            titulo = 'Detalle del Producto SAT';
        } else {
            console.warn('Tipo desconocido:', tipo);
            return;
        }

        const cuerpo = data.map((val, idx) => `
            <tr>
                <th scope="row">${encabezado[idx]}</th>
                <td>${val}</td>
            </tr>
        `).join('');

        document.getElementById('detalleModalLabel').innerText = titulo;
        document.getElementById('detalleModalBody').innerHTML = `
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <tbody>${cuerpo}</tbody>
                </table>
            </div>
        `;

        const modal = new bootstrap.Modal(document.getElementById('detalleModal'));
        modal.show();
    }

    // Función para mostrar detalle por índice si la necesitas
    function mostrarDetalle(index, tipo) {
        let data, encabezado, titulo;
        if (tipo === 'proveedor') {
            data = proveedores[index];
            encabezado = encabezadoProveedores;
            titulo = 'Detalle del Proveedor';
        } else if (tipo === 'productoSAT') {
            data = productosSAT[index];
            encabezado = encabezadoProductosSAT;
            titulo = 'Detalle del Producto SAT';
        } else {
            console.warn('Tipo desconocido:', tipo);
            return;
        }

        const cuerpo = data.map((val, idx) => `
            <tr>
                <th scope="row">${encabezado[idx]}</th>
                <td>${val}</td>
            </tr>
        `).join('');

        document.getElementById('detalleModalLabel').innerText = titulo;
        document.getElementById('detalleModalBody').innerHTML = `
            <div class="table-responsive">
                <table class="table table-striped table-sm">
                    <tbody>${cuerpo}</tbody>
                </table>
            </div>
        `;

        const modal = new bootstrap.Modal(document.getElementById('detalleModal'));
        modal.show();
    }

    // Actualiza los contadores que se muestran en pantalla
    function updateCounters() {
        const existentesRows = document.querySelectorAll('#existentesTable tbody tr');
        const sinProveedorRows = document.querySelectorAll('#sinProveedorTable tbody tr');
        const nuevosRows = document.querySelectorAll('#nuevosTable tbody tr'); // corregido id

        document.getElementById('existentesCount').textContent = existentesRows.length;
        document.getElementById('sinProveedorCount').textContent = sinProveedorRows.length;
        document.getElementById('nuevosCount').textContent = nuevosRows.length;
    }

    // Detectar cambios en las celdas editables
    function inicializarEditableCells() {
        document.querySelectorAll('.editable-cell').forEach(cell => {
            cell.dataset.original = cell.innerText;

            cell.addEventListener('input', () => {
                if (cell.innerText.trim() !== cell.dataset.original.trim()) {
                    cell.classList.add('editado');
                } else {
                    cell.classList.remove('editado');
                }
            });

            // Mejorar UX en focus/blur
            cell.addEventListener('focus', () => {
                cell.style.outline = 'none';
            });
        });
    }

    // Enviar productos nuevos al servidor vía fetch
    function enviarProductos() {
        const button = document.querySelector('.action-button');
        const originalText = button.innerHTML;
        const successMessage = document.getElementById('successMessage');
        const errorMessage = document.getElementById('errorMessage');

        successMessage.style.display = 'none';
        errorMessage.style.display = 'none';
        button.innerHTML = '<div class="loading-spinner"></div>Enviando...';
        button.disabled = true;

        const tabla = $('#nuevosTable').DataTable();
        const rows = tabla.rows().nodes().toArray();
        const productos = [];
        rows.forEach((row) => {
            const celdas = row.querySelectorAll(".editable-cell");
            const datosFila = [];

            celdas.forEach(celda => {
                datosFila.push(celda.innerText.trim());
            });

            // Obtener el índice real de DataTable
            const realIndex = parseInt(row.getAttribute('data-index'));

            const productoSAT = productosSATNuevos[realIndex] ?? [];
            const proveedor = proveedoresNuevos[realIndex] ?? [];

            productos.push({
                producto: datosFila,
                sat: productoSAT,
                proveedor: proveedor
            });
        });


        const formData = new FormData();
        formData.append("productos_completos", JSON.stringify(productos));

        fetch('/Planeador/GuardarProductosNuevos', {
            method: 'POST',
            body: formData
        })
            .then(resp => resp.json())
            .then(data => {
                if (data.success) {
                    successMessage.style.display = 'flex';
                    successMessage.querySelector('span').textContent = 'Productos guardados exitosamente';
                    document.querySelectorAll('.editable-cell.editado').forEach(cell => {
                        cell.classList.remove('editado');
                        cell.dataset.original = cell.innerText;
                    });
                    setTimeout(() => location.reload(), 1500);
                } else {
                    errorMessage.style.display = 'flex';
                    errorMessage.querySelector('span').textContent = data.message || 'Error al guardar productos';
                }
            })
            .catch(err => {
                console.error(err);
                errorMessage.style.display = 'flex';
                errorMessage.querySelector('span').textContent = 'Error de conexión al enviar datos';
            })
            .finally(() => {
                button.innerHTML = originalText;
                button.disabled = false;
            });
    }


    // Esperar que cargue DOM para inicializar todo
    document.addEventListener('DOMContentLoaded', function () {
        updateCounters();
        inicializarEditableCells();

        // Agregar efecto de aparición suave a secciones
        document.querySelectorAll('.section-card').forEach((card, index) => {
            card.style.opacity = '0';
            card.style.transform = 'translateY(20px)';
            setTimeout(() => {
                card.style.transition = 'all 0.5s ease';
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            }, index * 200);
        });
    });

    $(document).ready(function () {
        $('#existentesTable').DataTable({
            responsive: true,
        });

        $('#sinProveedorTable').DataTable({
            responsive: true,
        });

        $('#nuevosTable').DataTable({
            responsive: false,
        });
    });
</script>
