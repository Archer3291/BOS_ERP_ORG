    const hayDatos = hayDatosRealesEnTabla();

    if (hayDatos) {
    initializeDataTable();
    } else {
    // Si no hay datos, mostrar skeleton y esperar
    const inventoryLoader = new InventoryLoader();
    inventoryLoader.generateSkeletonRows(10);

    inventoryLoader.startLoading().then(() => {
    // Después del loader, verificar nuevamente
    setTimeout(() => {
    if (hayDatosRealesEnTabla()) {
    initializeDataTable();
    } else {
    initializeDataTable();
    }
    }, 500);
    });
