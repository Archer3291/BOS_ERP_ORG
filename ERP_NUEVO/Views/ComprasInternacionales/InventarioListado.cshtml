@using BOS_ERP.Models
@model List<InventarioProducto>
<link href="~/content/Site.css" rel="stylesheet" />
<style>
    .container-fluid {
        padding: 2rem;
    }

    .card {
        box-shadow: 0 15px 35px rgba(0, 0, 0, 0.1);
        border-radius: 20px;
        border: none;
        backdrop-filter: blur(10px);
        background: rgba(255, 255, 255, 0.95);
    }

    .card-header {
        background: linear-gradient(135deg, #2c3e50, #34495e);
        color: white;
        border-radius: 20px 20px 0 0 !important;
        padding: 1.5rem;
        border: none;
    }

    .card-title {
        margin: 0;
        font-size: 1.8rem;
        font-weight: 600;
    }

    .card-subtitle {
        margin: 0.5rem 0 0 0;
        opacity: 0.9;
        font-size: 0.95rem;
    }

    /* Panel de acciones mejorado */
    .action-panel {
        border-bottom: 2px solid #dee2e6;
        padding: 1.5rem;
        margin: 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .action-controls {
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
    }

    .selection-info {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        background: var(--bg-gray);
        padding: 0.75rem 1.25rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        border: 2px solid transparent;
        transition: all 0.3s ease;
    }

        .selection-info.has-selection {
            border-color: #3498db;
            background: linear-gradient(135deg, rgba(52, 152, 219, 0.1), rgba(52, 152, 219, 0.05));
        }

    .selection-count {
        font-weight: 700;
        font-size: 1.1rem;
        color: #2c3e50;
        margin: 0;
    }

        .selection-count.active {
            color: #3498db;
        }

    .selection-text {
        color: #7f8c8d;
        font-size: 0.9rem;
        margin: 0;
    }

    .btn-enviar-seleccionados {
        background: linear-gradient(135deg, #27ae60, #2ecc71);
        border: none;
        color: white;
        padding: 0.875rem 2rem;
        border-radius: 12px;
        font-weight: 600;
        font-size: 1rem;
        transition: all 0.3s ease;
        box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
        min-height: 48px;
        position: relative;
        overflow: hidden;
    }

        .btn-enviar-seleccionados:before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s;
        }

        .btn-enviar-seleccionados:hover:before {
            left: 100%;
        }

        .btn-enviar-seleccionados:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(39, 174, 96, 0.4);
            background: linear-gradient(135deg, #2ecc71, #27ae60);
        }

        .btn-enviar-seleccionados:active {
            transform: translateY(0);
        }

        .btn-enviar-seleccionados:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            transform: none;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            background: linear-gradient(135deg, #95a5a6, #7f8c8d);
        }

            .btn-enviar-seleccionados:disabled:hover {
                transform: none;
                box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
            }

    .btn-icon {
        font-size: 1.1rem;
    }

    #tablaInventario {
        margin: 0 !important;
        font-size: 0.9rem;
    }

        #tablaInventario thead th {
            background: linear-gradient(135deg, #3498db, #2980b9);
            color: white;
            font-weight: 600;
            text-align: center;
            vertical-align: middle;
            border: none;
            padding: 1rem 0.75rem;
            position: sticky;
            top: 0;
            z-index: 10;
        }

        #tablaInventario tbody td {
            padding: 0.75rem;
            vertical-align: middle;
            text-align: center;
            transition: all 0.2s ease;
        }

        #tablaInventario tbody tr:hover {
            background-color: rgba(52, 152, 219, 0.1);
            transform: scale(1.01);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }

        /* Estilos para filas seleccionadas */
        #tablaInventario tbody tr.selected {
            background-color: rgba(52, 152, 219, 0.25) !important;
            border-left: 4px solid #3498db;
        }

            #tablaInventario tbody tr.selected:hover {
                background-color: rgba(52, 152, 219, 0.35) !important;
            }
    /* Celda del checkbox completamente separada */
    .checkbox-cell {
        width: 40px;
        text-align: center;
        padding: 0.75rem 0.5rem !important;
        cursor: pointer;
    }

    .form-check-input {
        width: 1.3em;
        height: 1.3em;
        cursor: pointer;
        margin: 0;
        position: relative;
        z-index: 1;
    }

        .form-check-input:checked {
            background-color: #3498db;
            border-color: #3498db;
        }

        .form-check-input:focus {
            box-shadow: 0 0 0 0.25rem rgba(52, 152, 219, 0.25);
        }

    /* Colores específicos para columnas importantes */
    .col-parte {
        font-weight: 600;
        color: #2c3e50;
        background-color: rgba(52, 152, 219, 0.05);
    }

    .col-descripcion {
        text-align: left !important;
        max-width: 200px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .col-peso {
        font-family: 'Courier New', monospace;
        font-weight: 500;
    }

    /* Badges para unidades de medida */
    .badge-unidad {
        font-size: 0.75rem;
        padding: 0.35rem 0.6rem;
    }

    /* Mejoras para DataTables */
    .dataTables_wrapper .dataTables_length select,
    .dataTables_wrapper .dataTables_filter input {
        border-radius: 8px;
        border: 1px solid #ddd;
        padding: 0.375rem 0.75rem;
    }

        .dataTables_wrapper .dataTables_filter input:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }

    .dataTables_wrapper .dataTables_paginate .paginate_button {
        border-radius: 6px;
        margin: 0 2px;
    }

        .dataTables_wrapper .dataTables_paginate .paginate_button.current {
            background: #3498db !important;
            border-color: #3498db !important;
            color: white !important;
        }

    /* Responsive mejoras */
    @@media (max-width: 768px) {
        .container-fluid {
            padding: 1rem;
        }

        .card-header {
            padding: 1rem;
        }

        .card-title {
            font-size: 1.4rem;
        }

        .action-panel {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
            padding: 1rem;
        }

        .action-controls {
            justify-content: center;
            flex-direction: column;
        }

        .selection-info {
            justify-content: center;
        }

        .btn-enviar-seleccionados {
            justify-content: center;
            width: 100%;
        }

        #tablaInventario {
            font-size: 0.8rem;
        }

            #tablaInventario thead th,
            #tablaInventario tbody td {
                padding: 0.5rem 0.25rem;
            }


        .checkbox-cell {
            width: 35px;
            padding: 0.5rem 0.25rem !important;
        }
    }

    /* Animaciones */
    .card {
        animation: slideIn 0.6s ease-out;
    }

    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Efecto de pulso para botón activo */
    .btn-enviar-seleccionados.pulse {
        animation: pulse 2s infinite;
    }

    @@keyframes pulse {
        0% {
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }

        50% {
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.6);
        }

        100% {
            box-shadow: 0 4px 15px rgba(39, 174, 96, 0.3);
        }
    }

    table td, table th {
        padding: 5px;
    }
    /* cursor bonito */
    .dt-scroll-body {
        cursor: grab;
        user-select: none;
    }

        .dt-scroll-body:active {
            cursor: grabbing;
        }

    .page-loader {
        position: fixed;
        width: 75%;
        height: 100%;
        background: var(--bg-gray);
        backdrop-filter: blur(5px);
        z-index: 9999;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        transition: all 0.5s ease;
    }

        .page-loader.hidden {
            opacity: 0;
            pointer-events: none;
        }

    /* Spinner principal */
    .loader-spinner {
        width: 60px;
        height: 60px;
        border: 4px solid #f3f4f6;
        border-top: 4px solid #3498db;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 1.5rem;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    /* Texto del loader */
    .loader-text {
        color: #2c3e50;
        font-size: 1.1rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
        text-align: center;
    }

    .loader-subtext {
        color: #7f8c8d;
        font-size: 0.9rem;
        text-align: center;
        max-width: 300px;
    }

    /* Barra de progreso */
    .progress-container {
        width: 300px;
        height: 6px;
        background: #ecf0f1;
        border-radius: 3px;
        margin-top: 1rem;
        overflow: hidden;
    }

    .progress-bar {
        height: 100%;
        background: linear-gradient(90deg, #3498db, #2980b9);
        border-radius: 3px;
        width: 0%;
        transition: width 0.3s ease;
        position: relative;
    }

        .progress-bar::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            width: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.6), transparent);
            animation: shimmer 1.5s infinite;
        }

    @@keyframes shimmer {
        0% {
            transform: translateX(-100%);
        }

        100% {
            transform: translateX(100%);
        }
    }

    /* Loader para DataTable específico */
    .datatable-loader {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.9);
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        z-index: 1000;
        border-radius: 10px;
    }

        .datatable-loader .loader-spinner {
            width: 40px;
            height: 40px;
            border-width: 3px;
            margin-bottom: 1rem;
        }

    /* Skeleton loading para las filas */
    .skeleton-row {
        animation: pulse 1.5s ease-in-out infinite;
    }

    .skeleton-cell {
        background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
        background-size: 200% 100%;
        animation: loading 1.5s infinite;
        height: 20px;
        border-radius: 4px;
        margin: 2px 0;
    }

    @@keyframes loading {
        0% {
            background-position: 200% 0;
        }

        100% {
            background-position: -200% 0;
        }
    }

    @@keyframes pulse {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    /* Estilos adicionales para integración */
    .card-loading {
        position: relative;
        overflow: hidden;
    }

        .card-loading::after {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
            animation: cardShimmer 2s infinite;
        }

    @@keyframes cardShimmer {
        0% {
            left: -100%;
        }

        100% {
            left: 100%;
        }
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .loader-text {
            font-size: 1rem;
        }

        .progress-container {
            width: 250px;
        }

        .loader-subtext {
            font-size: 0.8rem;
            max-width: 250px;
        }
    }

</style>
<div>
    <div id="pageLoader" class="page-loader">
        <div class="loader-spinner"></div>
        <div class="loader-text">Cargando Inventario</div>
        <div class="loader-subtext">Procesando datos del Excel, por favor espere...</div>
        <div class="progress-container">
            <div id="progressBar" class="progress-bar"></div>
        </div>
    </div>
</div>
<div class="card">
    <div class="card-header">
        <h2 class="card-title">
            <i class="fas fa-boxes me-3"></i>
            Control de Inventario
        </h2>
        <p class="card-subtitle">
            <i class="fas fa-calendar-alt me-2"></i>
            Sistema de Facturación - Gestión de Productos
        </p>
    </div>

    <div class="action-panel">
        <div class="action-controls">
            <div id="selectionInfo" class="selection-info">
                <i class="fas fa-check-square" style="color: #3498db; font-size: 1.2rem;"></i>
                <div>
                    <p id="selectionCount" class="selection-count">0</p>
                    <p id="selectionText" class="selection-text">productos seleccionados</p>
                </div>
            </div>
        </div>

        <button type="button" id="btnEnviarSeleccionados" class="btn btn-enviar-seleccionados" disabled>
            <i class="fas fa-paper-plane btn-icon"></i>
            <span>Enviar Seleccionados</span>
        </button>
    </div>

    <div class="card-body p-0">
        <div>
            <table id="tablaInventario" class="table display nowrap">
                <thead>
                    <tr>
                        <th class="checkbox-cell" style="width: 40px;">
                            <input type="checkbox" id="selectAll" class="form-check-input">
                        </th>
                        <th><i class="fas fa-barcode me-2"></i>No. Parte SRS</th>
                        <th><i class="fas fa-tag me-2"></i>Descripción</th>
                        <th><i class="fas fa-ruler me-2"></i>U.M.</th>
                        <th style="width:40px;"><i class="fas fa-warehouse me-2"></i>Total Almacenes</th>
                        <th style="width:40px;"><i class="fas fa-chart-line me-2"></i>Consumo Mes</th>
                        <th><i class="fas fa-exclamation-triangle me-2"></i>Por Cubrir</th>
                        <th><i class="fas fa-check-circle me-2"></i>En Fab (Listo)</th>
                        <th><i class="fas fa-cog me-2"></i>En Fabricación</th>
                        <th><i class="fas fa-level-up-alt me-2"></i>Invt. Máximo</th>
                        <th><i class="fa-solid fa-cart-shopping"></i>Compra</th>
                        <th><i class="fas fa-weight me-2"></i>Peso</th>
                        <th><i class="fas fa-weight-hanging me-2"></i>Peso Total</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr data-parte="@item.NoParteSRS">
                            <td class="checkbox-cell">
                                <input type="checkbox" class="form-check-input row-checkbox"
                                       data-no-parte="@item.NoParteSRS"
                                       data-descripcion="@item.DescripcionProducto"
                                       data-unidad="@item.UnidadMedida"
                                       data-total-almacenes="@item.TotalAlmacenes"
                                       data-consumo-mes="@item.ConsumoMes"
                                       data-por-cubrir="@item.PorCubrir"
                                       data-en-fab-listo="@item.EnFabricacionListo"
                                       data-en-fabricacion="@item.EnFabricacion"
                                       data-inventario-maximo="@item.InventarioMaximo"
                                       data-compra="@item.Compra"
                                       data-peso="@item.Peso"
                                       data-peso-total="@item.PesoTotal">
                            </td>
                            <td contenteditable='true' class="col-parte">@item.NoParteSRS</td>
                            <td contenteditable='true' class="col-descripcion" title="@item.DescripcionProducto">@item.DescripcionProducto</td>
                            <td>
                                @{
                                    var badgeClass = "bg-primary";
                                    switch (item.UnidadMedida?.ToUpper())
                                    {
                                        case "PZA":
                                        case "PIEZA":
                                            badgeClass = "bg-primary";
                                            break;
                                        case "KG":
                                        case "KILOGRAMO":
                                            badgeClass = "bg-success";
                                            break;
                                        case "MTS":
                                        case "METRO":
                                            badgeClass = "bg-warning";
                                            break;
                                        case "LITRO":
                                        case "LT":
                                            badgeClass = "bg-info";
                                            break;
                                        default:
                                            badgeClass = "bg-secondary";
                                            break;
                                    }
                                }
                                <span class="badge @badgeClass badge-unidad">@item.UnidadMedida</span>
                            </td>
                            <td contenteditable='true' class="col-cantidad @(item.TotalAlmacenes < (item.ConsumoMes * 2) ? "negativo" : item.TotalAlmacenes > (item.ConsumoMes * 5) ? "positivo" : "neutro")">
                                @item.TotalAlmacenes.ToString("N2")
                            </td>
                            <td contenteditable='true' class="col-cantidad neutro">@item.ConsumoMes.ToString("N2")</td>
                            <td contenteditable='true' class="col-cantidad @(item.PorCubrir < 0 ? "negativo" : item.PorCubrir > 0 ? "positivo" : "neutro")">
                                @item.PorCubrir.ToString("N2")
                            </td>
                            <td contenteditable='true' class="col-cantidad positivo">@item.EnFabricacionListo.ToString("N2")</td>
                            <td contenteditable='true' class="col-cantidad neutro">@item.EnFabricacion.ToString("N2")</td>
                            <td contenteditable='true' class="col-cantidad">@item.InventarioMaximo.ToString("N2")</td>
                            <td contenteditable='true' class="col-cantidad">@item.Compra.ToString("N2")</td>
                            <td contenteditable='true' class="col-peso">@item.Peso.ToString("N3")</td>
                            <td class="col-peso">@item.PesoTotal.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
<script>
    window.encabezadoId = '@ViewBag.IdEncabezado';
</script>
<script src="~/lib/jquery/jquery.min.js"></script>
<script src="~/lib/signature_pad/dist/signature_pad.umd.min.js"></script>
<script>

    // Variables dinámicas para localStorage basadas en ID
    let currentEncabezadoId = null;
    let STORAGE_KEY = 'inventario_productos_seleccionados';
    let STORAGE_EXPIRY_KEY = 'inventario_seleccion_expiry';
    const EXPIRY_HOURS = 24; // Los datos expirarán en 24 horas

    let tablaInventario;
    let productosSeleccionados = [];

    // Detectar si hay datos reales en la tabla
    function hayDatosRealesEnTabla() {
    const filasReales = $('#tablaInventario tbody tr').filter(function () {
    const fila = $(this);
    // Verificar que no sea skeleton y que tenga contenido real
    return !fila.hasClass('skeleton-row') &&
    fila.find('td').length > 0 &&
    fila.find('td').eq(1).text().trim() !== '';
    });
    return filasReales.length > 0;
    }

    // Función simplificada para inicializar DataTable
    function initializeDataTable() {
    // Verificar que la tabla existe
    if (!$('#tablaInventario').length) {
    ocultarLoader();
    return;
    }

    // Si DataTable ya existe, destruirlo
    if ($.fn.DataTable.isDataTable('#tablaInventario')) {
    $('#tablaInventario').DataTable().destroy();
    }

    // NO eliminar skeleton rows aquí - let them be processed by DataTable
    const totalFilas = $('#tablaInventario tbody tr').length;

    try {
    tablaInventario = $('#tablaInventario').DataTable({
    language: {
    url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/es-ES.json'
    },
    scrollX: true,
    pageLength: 25,
    lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "Todos"]],
    order: [[2, 'asc']],
    // Importante: no procesar datos si son skeleton
    processing: false,
    deferRender: true,
    columnDefs: [
    {
    targets: [0],
    orderable: false,
    searchable: false,
    className: 'checkbox-cell',
    width: '40px'
    },
    {
    targets: [1],
    width: '200px'
    },
    {
    targets: [2],
    width: '150px'
    },
    {
    targets: [4, 5, 6, 7, 8, 9, 10, 11, 12],
    width: '20px',
    render: function (data, type, row) {
    if (type === 'display' && data && data.toString().trim() !== '') {
    const numData = parseFloat(data.toString().replace(/[^0-9.-]/g, ''));
    if (!isNaN(numData)) {
    return numData.toLocaleString('es-MX', {
    minimumFractionDigits: numData % 1 !== 0 ? 2 : 0,
    maximumFractionDigits: 2
    });
    }
    }
    return data;
    }
    }
    ],
    dom: '<"row"<"col-sm-12 col-md-6"l><"col-sm-12 col-md-6"f>>' +
    '<"row"<"col-sm-12"tr>>' +
    '<"row"<"col-sm-12 col-md-5"i><"col-sm-12 col-md-7"p>>',
    initComplete: function () {

    ocultarLoader();
    setupUIElements();
    aplicarSeleccionesGuardadas();

    // Si hay datos reales, limpiar skeletons después de inicializar
    if (hayDatosRealesEnTabla()) {
    setTimeout(() => {
    $('#tablaInventario tbody .skeleton-row').remove();
    tablaInventario.rows().invalidate().draw();
    }, 100);
    }
    },
    drawCallback: function () {
    aplicarSeleccionesEnPaginaActual();
    }
    });

    } catch (error) {
    toastMixin.fire({
    title: 'Error al inicializar la tabla',
    text: error.message
    });
    ocultarLoader();
    }
    }

    function ocultarLoader() {
    const pageLoader = document.getElementById('pageLoader');
    if (pageLoader) {
    pageLoader.classList.add('hidden');
    setTimeout(() => {
    pageLoader.style.display = 'none';
    }, 500);
    }
    }

    function setupUIElements() {
    // Configurar elementos de interfaz
    $('.dataTables_filter input').attr('placeholder', 'Buscar productos...');

    // Configurar scroll draggable si existe la tabla
    if (tablaInventario) {
    let mx = 0, sx = 0;
    const $scrollBody = $(tablaInventario.table().container()).find('.dt-scroll-body');

    $scrollBody.on({
    mousemove: function (e) {
    const mx2 = e.pageX - this.offsetLeft;
    if (mx) this.scrollLeft = sx + mx - mx2;
    },
    mousedown: function (e) {
    sx = this.scrollLeft;
    mx = e.pageX - this.offsetLeft;
    }
    });

    $(document).on("mouseup", function () {
    mx = 0;
    });
    }
    }

    class InventoryLoader {
    constructor() {
    this.progressBar = document.getElementById('progressBar');
    this.pageLoader = document.getElementById('pageLoader');
    this.steps = [
    { text: 'Conectando al servidor...', progress: 15 },
    { text: 'Leyendo datos del Excel...', progress: 35 },
    { text: 'Procesando información...', progress: 55 },
    { text: 'Validando productos...', progress: 75 },
    { text: 'Inicializando tabla...', progress: 90 },
    { text: 'Finalizando carga...', progress: 100 }
    ];
    }

    generateSkeletonRows(count = 8) {
    const tbody = $('#tablaInventario tbody');

    // Solo generar skeleton si no hay contenido
    if (tbody.children().length === 0) {
    for (let i = 0; i < count; i++) {
    const skeletonRow = `
    <tr class="skeleton-row">
    <td><div class="skeleton-cell" style="width: 20px; height: 16px;"></div></td>
    <td><div class="skeleton-cell" style="width: 120px;"></div></td>
    <td><div class="skeleton-cell" style="width: 200px;"></div></td>
    <td><div class="skeleton-cell" style="width: 60px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 80px;"></div></td>
    <td><div class="skeleton-cell" style="width: 70px;"></div></td>
    <td><div class="skeleton-cell" style="width: 70px;"></div></td>
    </tr>`;
    tbody.append(skeletonRow);
    }
    }
    }

    async startLoading() {
    for (let i = 0; i < this.steps.length; i++) {
    this.updateProgress(i);
    const delay = i === 1 ? 800 : i === 2 ? 600 : 400;
    await new Promise(resolve => setTimeout(resolve, delay));
    }
    }

    updateProgress(stepIndex) {
    const step = this.steps[stepIndex];
    if (!step || !this.progressBar) return;

    this.progressBar.style.width = step.progress + '%';
    const loaderText = document.querySelector('.loader-text');
    const loaderSubtext = document.querySelector('.loader-subtext');

    if (loaderText) loaderText.textContent = step.text;
    if (loaderSubtext) loaderSubtext.textContent = `Paso ${stepIndex + 1} de ${this.steps.length}`;
    }
    }

    $(document).ready(function () {

    // Configurar datos básicos
    obtenerEncabezadoId();
