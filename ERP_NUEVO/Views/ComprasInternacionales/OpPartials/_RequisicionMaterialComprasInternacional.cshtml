                if (!proveedorExiste) {
                    console.error('El proveedor guardado no existe en la lista de proveedores disponibles');
                    console.log('Proveedor buscado:', proveedorGuardado);
                    console.log('IDs disponibles:', proveedoresList.map(p => p.id));
                }
            }

            tomSelectProveedor = inicializarTomSelectProveedor(proveedorSelect, proveedorGuardado);

            if (!tomSelectProveedor) {
