<!-- Modal para subir CSV y visualizar materiales -->
<div class="modal fade" id="modalSubirMateriales" tabindex="-1" aria-labelledby="modalSubirMaterialesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSubirMaterialesLabel">
                    <i class="fas fa-cloud-upload-alt me-2"></i> Cargar productos
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Contenido principal -->
                <div class="text-center mb-4">
                    <p class="text-muted">Sube, edita y gestiona tus datos fácilmente</p>
                </div>

                <div class="row g-4">
                    <!-- Columna izquierda: acordeones de carga -->
                    <div class="col-md-6">
                        <div class="accordion" id="accordionCsvUpload">
                            <!-- Acordeón CSV existente -->
                            <div class="accordion-item border rounded-4 mb-3">
                                <h2 class="accordion-header" id="headingCsv">
                                    <button class="accordion-button collapsed fw-semibold text-primary" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapseCsv"
                                            aria-expanded="false" aria-controls="collapseCsv" style="border-radius: 15px;">
                                        <i class="fas fa-file-csv me-2"></i> Subir archivo CSV
                                    </button>
                                </h2>
                                <div id="collapseCsv" class="accordion-collapse collapse" aria-labelledby="headingCsv"
                                     data-bs-parent="#accordionCsvUpload">
                                    <div class="accordion-body p-3">
                                        <!-- Formulario -->
                                        <form id="form-subir-csv" enctype="multipart/form-data">
                                            <div class="upload-zone text-center p-3 position-relative border rounded bg-light-subtle">
                                                <input type="file"
                                                       name="archivoCsv"
                                                       id="archivoCsv"
                                                       class="file-input"
                                                       accept=".csv"
                                                       required />
                                                <div class="upload-content">
                                                    <i class="fas fa-cloud-upload-alt upload-icon pulse-animation text-primary"></i>
                                                    <h6 class="fw-bold mb-1">Arrastra tu archivo aquí</h6>
                                                    <p class="text-muted small mb-0">o haz clic para seleccionar</p>
                                                    <small class="text-muted">Formatos: .csv | máx. 10MB</small>
                                                </div>
                                            </div>

                                            <!-- Progreso -->
                                            <div class="progress-bar-modern d-none mt-3">
                                                <div class="progress-fill" style="width: 0%"></div>
                                            </div>

                                            <div class="text-center mt-3">
                                                <button type="submit" class="btn btn-modern btn-sm shadow-sm">
                                                    <i class="fas fa-rocket me-1"></i> Procesar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>

                            <!-- Nuevo acordeón para cargar desde documento -->
                            <div class="accordion-item border rounded-4">
                                <h2 class="accordion-header" id="headingDocument">
                                    <button class="accordion-button collapsed fw-semibold text-primary" type="button"
                                            data-bs-toggle="collapse" data-bs-target="#collapseDocument"
                                            aria-expanded="false" aria-controls="collapseDocument" style="border-radius: 15px;">
                                        <i class="fas fa-file-alt me-2"></i> Cargar desde documento
                                    </button>
                                </h2>
                                <div id="collapseDocument" class="accordion-collapse collapse" aria-labelledby="headingDocument"
                                     data-bs-parent="#accordionCsvUpload">
                                    <div class="accordion-body p-3">
                                        <div class="select-container">
                                            <label for="documentSelect" class="form-label fw-semibold text-dark mb-2">
                                                <i class="fas fa-folder-open me-2"></i> Seleccionar documento:
                                            </label>
                                            <select id="documentSelect" class="form-select">
                                                <option value="" selected>-- Selecciona un documento --</option>
                                                <option value="plantilla-productos">Plantilla de productos</option>
                                                <option value="inventario-actual">Inventario actual</option>
                                                <option value="catalogo-proveedores">Catálogo de proveedores</option>
                                                <option value="precios-actualizados">Lista de precios actualizados</option>
                                                <option value="productos-temporada">Productos de temporada</option>
                                            </select>

                                            <div class="text-center mt-3">
                                                <button type="button" id="btnCargarDocumento" class="btn btn-modern btn-sm shadow-sm">
                                                    <i class="fas fa-download me-1"></i> Cargar documento
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Columna derecha: acciones -->
                    <div class="col-md-6 d-flex flex-column justify-content-start gap-3">
                        <button id="btnAgregarFila" type="button"
                                class="btn btn-outline-modern w-100 d-flex align-items-center justify-content-center gap-2 shadow-sm">
                            <i class="fas fa-plus-circle"></i> <span>Agregar Nueva Fila</span>
