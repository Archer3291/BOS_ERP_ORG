    function agregarOpciones(btn) {
        idEncabezadoSeleccionado = btn.dataset.encabezado;
        const select = document.getElementById("selectOpcion");
        const fechaInput = document.getElementById("fechaEstimada"); // tu input de fecha

        // resetear controles
        select.innerHTML = `<option value="">-- Selecciona una opción --</option>`;
        fechaInput.value = "";

        // Mostrar el modal
        const modal = new bootstrap.Modal(document.getElementById('modalOpciones'));
        modal.show();

        // Cargar opciones dinámicamente
        GetData({
            path: '/ProcesoComprasInternacional/Movimientos',
            data: { id: idEncabezadoSeleccionado }
        }).then(res => {
            if (res.success) {
                // llenar el select
                res.result.movimientos.forEach(op => {
                    const option = document.createElement("option");
                    option.value = op.id_movimiento;
                    option.textContent = op.tipo_movimiento;
                    select.appendChild(option);
                });

                // asignar fecha si existe
                if (res.result.fecha && res.result.fecha.length > 0) {
                    let fecha = res.result.fecha[0].fch_pg_entrega;
                    if (fecha) {
                        // formato: "/Date(1758520800000)/"
                        const ticks = parseInt(fecha.replace(/\/Date\((\d+)\)\//, "$1"), 10);
                        const fechaObj = new Date(ticks);
                        const fechaFormateada = fechaObj.toISOString().split("T")[0];
                        fechaInput.value = fechaFormateada;
                    }
                }
            } else {
                toastr.error("No se pudieron cargar las opciones.");
            }
        });
    }

    //NEW
    function enviarOpcionSeleccionada() {
        const select = document.getElementById("selectOpcion");
        const opcion = select.value;
        const fecha = document.getElementById("fechaEstimada").value;
        const btn = document.getElementById("btnEnviarOpcion");

        if (!opcion && !fecha) {
            toastr.error("Debes seleccionar al menos una opción o una fecha estimada de entrega");
            return;
        }

        btn.disabled = true;

        const formData = new FormData();
        formData.append("id_encabezado", idEncabezadoSeleccionado);

        if (opcion) formData.append("opcion", opcion);
        if (fecha) formData.append("fecha_estimada", fecha);

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        fetch('/ProcesoComprasInternacional/AgregarMovimientos', {
            method: 'POST',
            body: formData
        })
            .then(async res => {
                let data;
                try {
                    data = await res.json();
                } catch {
                    throw new Error("Respuesta inválida del servidor");
                }

                if (!res.ok || !data.success) {
                    throw new Error(data.error || "No se pudo completar la operación");
                }

                toastr.success("Operación realizada exitosamente");
                bootstrap.Modal.getInstance(document.getElementById('modalOpciones')).hide();
            })
            .catch(err => {
                console.error("Error en fetch", err);
                toastr.error("Error: " + err.message);
            })
            .finally(() => {
                btn.disabled = false;
            });
    }

