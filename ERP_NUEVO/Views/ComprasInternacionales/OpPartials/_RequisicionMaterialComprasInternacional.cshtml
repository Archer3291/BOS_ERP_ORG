async function AprobarODCI(idEncabezado) {
    const formData = new FormData();
    formData.append("id_encabezado", idEncabezado);

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    if (token) {
        formData.append('__RequestVerificationToken', token);
    }

    // 🔹 1. Obtener centros de costos
    const centrosResponse = await GetData({ path: '/DatosGenerales/DatosCentroCostos' });

    if (!centrosResponse.success) {
        Swal.fire({
            icon: 'error',
            title: centrosResponse.message || 'Error al cargar centros de costos'
        });
        return;
    }

    const centros = centrosResponse.data || centrosResponse.result || []; // ajusta según tu API
    if (centros.length === 0) {
        Swal.fire({
            icon: 'warning',
            title: 'No hay centros de costos disponibles'
        });
        return;
    }

    // 🔹 2. Crear el HTML del select para mostrar en el SweetAlert
    // 🔹 Convertir el array de objetos a objeto { valor: texto }
    const inputOptions = centros.reduce((acc, c) => {
        acc[c.areaid] = c.nombre;
        return acc;
    }, {});

    // 🔹 Mostrar SweetAlert con select
    const { value: centroSeleccionado } = await Swal.fire({
        title: 'Selecciona el Centro de Costos',
        theme: 'auto',
        input: 'select',
        inputOptions, // ✅ Ahora sí correcto
        inputPlaceholder: 'Selecciona un centro de costos',
        showCancelButton: true,
        confirmButtonText: 'Continuar',
        cancelButtonText: 'Cancelar',
        inputValidator: (value) => {
            if (!value) return 'Por favor selecciona un centro de costos';
        },
        confirmButtonText: 'Continuar',
        focusConfirm: false,
        preConfirm: (valuw) => {
            if (!valuw)
                Swal.showValidationMessage('Por favor selecciona un centro de costos');

          
            Swal.fire({
                title: 'Firma para aprobar la orden',
                html: `
                <div class="border-1">
                    <p>Firma del usuario</p>
                    <canvas id="signature" width="400" height="200" style="border:1px solid #ccc;"></canvas>
                    <button type="button" class="btn btn-sm btn-warning mt-2" id="limpiar_firma">Limpiar</button>
                </div>`,
                confirmButtonText: 'Aprobar',
                didOpen: () => {
                    const canvas = document.getElementById("signature");
                    const signaturePad = new SignaturePad(canvas, {
                        penColor: "rgb(0, 0, 0)",
                        minWidth: 0.5,
                        maxWidth: 1.0,
                        throttle: 16,
                        minDistance: 3
                    });

                    const firmaBase64 = '@Context.Session.GetString("Firma")';
                    if (firmaBase64 && firmaBase64 !== 'null' && firmaBase64.trim() !== '') {
                        signaturePad.fromDataURL(firmaBase64);
                    }

                    document.getElementById('limpiar_firma').addEventListener('click', () => {
                        signaturePad.clear();
                    });

                    Swal.__signaturePad = signaturePad;
                    Swal.__canvas = canvas;
                },
                preConfirm: async () => {
                    const signaturePad = Swal.__signaturePad;
                    const canvas = Swal.__canvas;

                    if (!signaturePad || signaturePad.isEmpty()) {
                        Swal.showValidationMessage('Debes firmar antes de continuar.');
                        return false;
                    }
                    const trimmed = getTrimmedCanvas(canvas);
                    const dataUrl = trimmed.toDataURL("image/png", 0.5);
                    formData.append('firma', dataUrl);
                    formData.append("centro", parseInt(valuw));

                    return fetch('/ProcesoComprasInternacional/AprobarODCI', {
                        method: 'POST',
                        body: formData
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (!data.success) {
                                throw new Error(data.message || 'No se pudo aprobar la orden.');
                            }
                            return data;
                        })
                        .catch(err => {
                            Swal.showValidationMessage(`Error: ${err.message}`);
                        });
                }}).then(result => {
                    if (result.isConfirmed && result.value) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Orden Aprobada',
                            text: result.value.message || 'La orden fue aprobada exitosamente.'
                        }).then(() => {
                            // 🔄 Refrescar DataTable después de cerrar el Swal de éxito
                            $('#tablaOCDI').DataTable().ajax.reload(null, false);
                        });
                    }
            });
            return valuw;
        }
    });
}


