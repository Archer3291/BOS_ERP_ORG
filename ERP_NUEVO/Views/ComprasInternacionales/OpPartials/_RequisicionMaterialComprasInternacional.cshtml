    async function convertirADecimal(moneda) {
        const dataToSend = {};

        try {
            const _res = await GetData({
                path: '/RequisicionInternacional/TasasDeCambio',
                data: dataToSend
            });

            if (_res?.success) {
                console.log(_res.result[0]["dolar"]);
                const tasaDolar = _res.result[0]["dolar"]; // USD → MXN
                const tasaEuro = _res.result[0]["euro"];   // EUR → MXN

                if (moneda === "DLLS") {
                    return parseFloat(tasaDolar.toFixed(2));
                } else if (moneda === "EURO") {
                    return parseFloat(tasaEuro.toFixed(2));
                } else {
                    return ""; // retorna cadena vacía si no coincide
                }
            }
            return ""; // retorna cadena vacía si no hay éxito
        } catch (error) {
            console.error("Error al obtener tasas de cambio:", error);
            return "";
        }
    }


    let proveedoresList = [];
    async function cargarProveedores() {
        const prov = await fetch('/Requisicion/getListaProveedores');
        proveedoresList = await prov.json();
    }

    // 3. MEJORAR LA FUNCIÓN DE INICIALIZACIÓN DE TOMSELECT
    function inicializarTomSelectProveedor(select, valor = null) {
        // Verificar que el elemento select exista
        if (!select) {
            return null;
        }

        // Verificar que proveedoresList tenga datos
        if (!proveedoresList || proveedoresList.length === 0) {

            return null;
        }

        // Configurar TomSelect
        const ts = new TomSelect(select, {
            persist: false,
            createOnBlur: false,
            create: false,
            maxItems: 1,
            options: proveedoresList,
            valueField: "id",
            labelField: "nombre",
            searchField: ["clave", "nombre"],
            placeholder: "Buscar proveedor...",
            render: {
                option: function (data, escape) {
                    return `<div>
                    <strong>${escape(data.clave || data.id)}</strong> - ${escape(data.nombre)}
                </div>`;
                },
                item: function (data, escape) {
                    return `<div>${escape(data.nombre)}</div>`;
                },
                no_results: function (data, escape) {
                    return '<div class="no-results">No se encontraron proveedores</div>';
                }
            },
            onInitialize: function () {
                // Establecer valor después de la inicialización
                if (valor) {
                    this.setValue(valor);

                    // Verificar si el valor se estableció correctamente
                    setTimeout(() => {
                        const valorActual = this.getValue();

                        if (valorActual !== valor) {
                            // Verificar si el proveedor existe en la lista
                            const proveedorExiste = proveedoresList.find(p => p.id == valor);
                            if (proveedorExiste) {
                                this.setValue(valor);
                            } else {
                                console.error('Proveedor no encontrado en lista:', valor);
                            }
                        }
                    }, 100);
                }
            },
            onChange: function (value) {
                console.log('Proveedor seleccionado:', value);
            }
        });

        return ts;
    }

    // 4. CORRECCIÓN EN LA FUNCIÓN DE INICIALIZACIÓN DEL SELECTOR
    const inicializarSelectorProveedor = async () => {
        try {
            // Asegurar que proveedoresList esté cargado
            if (!proveedoresList || proveedoresList.length === 0) {
                await cargarProveedores();
