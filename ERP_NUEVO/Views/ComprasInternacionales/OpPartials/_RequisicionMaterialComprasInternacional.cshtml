            }

            // Aplicar estilos específicos para el modal (mantener código existente)
            const tomSelectWrapper = proveedorSelect.closest('.proveedor-selector').querySelector('.ts-wrapper');
            if (tomSelectWrapper) {
                // ... estilos existentes
            }


        } catch (error) {
            toastMixin.fire({
                icon: 'warning',
                title: 'Error al cargar proveedores: ' + error.message
            });
        }
    };


