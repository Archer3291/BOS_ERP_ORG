                  </div>
                `;

                mainContainer.appendChild(tableContainer);

                const tbody = tableContainer.querySelector(`#${tableId} tbody`);
                const divisaSelect = mainContainer.querySelector('#divisa');
                const btnGuardarDivisa = mainContainer.querySelector('#btnGuardarDivisa');
                const proveedorSelect = mainContainer.querySelector('#proveedor');
                const btnGuardarProveedor = mainContainer.querySelector('#btnGuardarProveedor');

                // Obtener tipo de cambio inicial
                let tipoCambio = await convertirADecimal(divisaSelect.value);
                console.log('Tipo de cambio inicial:', tipoCambio);

                // Inicializar TomSelect para proveedores
                let tomSelectProveedor = null;

                // Función para inicializar el selector de proveedores
                const inicializarSelectorProveedor = async () => {
                    try {
                        // Asegurar que proveedoresList esté cargado
                        if (!proveedoresList || proveedoresList.length === 0) {
                            await cargarProveedores();
                        }

                        tomSelectProveedor = inicializarTomSelectProveedor(proveedorSelect, proveedorGuardado);

                        // Aplicar estilos específicos para el modal
                        const tomSelectWrapper = proveedorSelect.closest('.proveedor-selector').querySelector('.ts-wrapper');
                        if (tomSelectWrapper) {
                            tomSelectWrapper.style.backgroundColor = 'rgba(255,255,255,0.15)';
                            tomSelectWrapper.style.border = '1px solid rgba(255,255,255,0.3)';
                            tomSelectWrapper.style.borderRadius = '0.375rem';
                            tomSelectWrapper.style.backdropFilter = 'blur(10px)';

                            const control = tomSelectWrapper.querySelector('.ts-control');
                            if (control) {
                                control.style.backgroundColor = 'transparent';
                                control.style.border = 'none';
                                control.style.color = 'white';
                                control.style.minHeight = '32px';
                            }

                            // Estilizar el placeholder
                            const input = tomSelectWrapper.querySelector('input');
                            if (input) {
                                input.style.color = 'white';
                                input.setAttribute('placeholder', 'Buscar proveedor...');
                            }
                        }
                    } catch (error) {
                        console.error('Error al inicializar selector de proveedor:', error);
                        toastMixin.fire({
                            icon: 'warning',
                            title: 'Error al cargar proveedores'
                        });
                    }
                };

                // Función para guardar la divisa
                const guardarDivisa = async () => {
                    const estadoOriginal = {
                        innerHTML: btnGuardarDivisa.innerHTML,
                        disabled: btnGuardarDivisa.disabled,
                        className: btnGuardarDivisa.className
                    };

                    try {
                        // Deshabilitar botón y mostrar loading
                        btnGuardarDivisa.disabled = true;
                        btnGuardarDivisa.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                        const formData = new FormData();
                        formData.append('_token', getCSRFToken());
                        formData.append('requisicion_id', id);
                        formData.append('ccy', divisaSelect.value);

                        const response = await fetch('/ProcesoComprasInternacional/GuardarDivisa', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            throw new Error(`Error HTTP: ${response.status} - ${response.statusText}`);
                        }

                        const resultado = await response.json();

                        if (resultado.success) {
                            toastMixin.fire({
                                icon: 'success',
                                title: 'Divisa guardada correctamente',
                                timer: 1500
                            });

                            // Mostrar éxito temporalmente
                            btnGuardarDivisa.innerHTML = '<i class="fas fa-check"></i>';
                            btnGuardarDivisa.classList.add('btn-success');
                            btnGuardarDivisa.classList.remove('btn-light');

                            // Restaurar después de mostrar el éxito
                            setTimeout(() => {
                                btnGuardarDivisa.innerHTML = estadoOriginal.innerHTML;
                                btnGuardarDivisa.className = estadoOriginal.className;
                            }, 2000);

                        } else {
                            throw new Error(resultado.message || 'Error desconocido del servidor');
                        }

                    } catch (error) {
                        console.error('Error al guardar divisa:', error);

                        let mensajeError = 'Error de conexión';
                        if (error.message) {
                            mensajeError = error.message;
                        }

                        toastMixin.fire({
                            icon: 'error',
                            title: mensajeError
                        });

                        // Mostrar error en el botón temporalmente
                        btnGuardarDivisa.innerHTML = '<i class="fas fa-times"></i>';
                        btnGuardarDivisa.classList.add('btn-danger');
                        btnGuardarDivisa.classList.remove('btn-light');

                    } finally {
                        // Siempre restaurar el estado del botón después de un delay
                        setTimeout(() => {
                            if (btnGuardarDivisa) {
                                btnGuardarDivisa.disabled = estadoOriginal.disabled;
                                btnGuardarDivisa.innerHTML = estadoOriginal.innerHTML;
                                btnGuardarDivisa.className = estadoOriginal.className;
                            }
                        }, 2000);
                    }
                };

                // Función para guardar el proveedor
                const guardarProveedor = async () => {
                    const estadoOriginal = {
                        innerHTML: btnGuardarProveedor.innerHTML,
                        disabled: btnGuardarProveedor.disabled,
                        className: btnGuardarProveedor.className
                    };

                    try {
                        // Deshabilitar botón y mostrar loading
                        btnGuardarProveedor.disabled = true;
                        btnGuardarProveedor.innerHTML = '<i class="fas fa-spinner fa-spin"></i>';

                        // MEJORA: Múltiples formas de obtener el valor del proveedor
                        let proveedorSeleccionado = '';

                        // Método 1: Desde la instancia de TomSelect
                        if (tomSelectProveedor && typeof tomSelectProveedor.getValue === 'function') {
                            proveedorSeleccionado = tomSelectProveedor.getValue();
                        }

                        // Método 2: Fallback - obtener directamente del select
                        if (!proveedorSeleccionado && proveedorSelect) {
                            proveedorSeleccionado = proveedorSelect.value;
                        }

                        // Método 3: Fallback - buscar el input hidden de TomSelect
                        if (!proveedorSeleccionado) {
                            const hiddenInput = document.querySelector('input[name="proveedor_select"]');
                            if (hiddenInput) {
                                proveedorSeleccionado = hiddenInput.value;
                            }
                        }

                        // DEBUGGING: Agregar logs para diagnóstico
                        console.log('DEBUG - Valores obtenidos:');
                        console.log('tomSelectProveedor existe:', !!tomSelectProveedor);
                        console.log('proveedorSelect existe:', !!proveedorSelect);
                        console.log('Valor de TomSelect:', tomSelectProveedor ? tomSelectProveedor.getValue() : 'N/A');
                        console.log('Valor del select:', proveedorSelect ? proveedorSelect.value : 'N/A');
                        console.log('Proveedor seleccionado final:', proveedorSeleccionado);

                        if (!proveedorSeleccionado || proveedorSeleccionado === '') {
                            throw new Error('Por favor seleccione un proveedor');
                        }

                        const formData = new FormData();
                        formData.append('_token', getCSRFToken());
                        formData.append('requisicion_id', id);
                        formData.append('proveedor_id', proveedorSeleccionado);

                        const response = await fetch('/ProcesoComprasInternacional/GuardarProveedor', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        if (!response.ok) {
                            throw new Error(`Error HTTP: ${response.status} - ${response.statusText}`);
                        }

                        const resultado = await response.json();

                        if (resultado.success) {
                            toastMixin.fire({
                                icon: 'success',
                                title: 'Proveedor guardado correctamente',
                                timer: 1500
                            });

                            // Mostrar éxito temporalmente
                            btnGuardarProveedor.innerHTML = '<i class="fas fa-check"></i>';
                            btnGuardarProveedor.classList.add('btn-success');
                            btnGuardarProveedor.classList.remove('btn-light');

                            // Restaurar después de mostrar el éxito
                            setTimeout(() => {
                                btnGuardarProveedor.innerHTML = estadoOriginal.innerHTML;
                                btnGuardarProveedor.className = estadoOriginal.className;
                            }, 2000);
                        } else {
                            throw new Error(resultado.message || 'Error desconocido del servidor');
                        }

                    } catch (error) {
                        console.error('Error al guardar proveedor:', error);
                        let mensajeError = 'Error de conexión';
                        if (error.message) {
                            mensajeError = error.message;
                        }

                        toastMixin.fire({
                            icon: 'error',
                            title: mensajeError
                        });

                        // Mostrar error en el botón temporalmente
                        btnGuardarProveedor.innerHTML = '<i class="fas fa-times"></i>';
                        btnGuardarProveedor.classList.add('btn-danger');
                        btnGuardarProveedor.classList.remove('btn-light');
                    } finally {
                        // Siempre restaurar el estado del botón después de un delay
                        setTimeout(() => {
                            if (btnGuardarProveedor) {
                                btnGuardarProveedor.disabled = estadoOriginal.disabled;
                                btnGuardarProveedor.innerHTML = estadoOriginal.innerHTML;
                                btnGuardarProveedor.className = estadoOriginal.className;
                            }
                        }, 2000);
                    }
                };

                // Event listeners para los botones
                btnGuardarDivisa.addEventListener('click', guardarDivisa);
                btnGuardarProveedor.addEventListener('click', guardarProveedor);

                // Función para obtener información de divisa
                const getDivisaInfo = () => {
                    const selectedOption = divisaSelect.options[divisaSelect.selectedIndex];
                    return {
                        codigo: selectedOption.value,
                        simbolo: selectedOption.getAttribute('data-symbol')
                    };
                };

                // Función para obtener el token CSRF
                const getCSRFToken = () => {
                    const metaToken = document.querySelector('meta[name="csrf-token"]');
                    if (metaToken) {
                        return metaToken.getAttribute('content');
                    }
                    // Alternativa: buscar en inputs hidden
                    const inputToken = document.querySelector('input[name="_token"]');
                    if (inputToken) {
                        return inputToken.value;
                    }
                    return null;
                };

                // Función para guardar cambios via fetch
                const guardarCambiosPartida = async (datosPartida, botonGuardar) => {
                    // Validar que el botón existe
                    if (!botonGuardar) {
                        console.error('Botón no encontrado');
                        return;
                    }

                    // Guardar estado original del botón
                    const estadoOriginal = {
                        innerHTML: botonGuardar.innerHTML,
                        disabled: botonGuardar.disabled,
                        className: botonGuardar.className
                    };

                    try {
                        // Deshabilitar botón y mostrar loading
                        botonGuardar.disabled = true;
                        botonGuardar.innerHTML = '<i class="fas fa-spinner fa-spin me-2"></i>Guardando...';

                        // Validar datos requeridos
                        if (!datosPartida || !datosPartida.partidaId) {
                            throw new Error('Datos de partida incompletos');
                        }

                        const formData = new FormData();
                        formData.append('_token', getCSRFToken());
                        formData.append('item_id', datosPartida.itemId);
                        formData.append('partida_id', datosPartida.partidaId);
                        formData.append('precio', datosPartida.precio || 0);
                        formData.append('cantidad', datosPartida.cantidad || 0);
                        formData.append('requisicion_id', id);

                        const response = await fetch('/ProcesoComprasInternacional/ActualizarPartida', {
                            method: 'POST',
                            body: formData,
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });

                        // Verificar que la respuesta sea OK
                        if (!response.ok) {
                            throw new Error(`Error HTTP: ${response.status} - ${response.statusText}`);
                        }

                        const resultado = await response.json();

                        if (resultado.success) {
                            toastMixin.fire({
                                icon: 'success',
                                title: 'Cambios guardados correctamente',
                                timer: 1500
                            });

                            // Mostrar éxito temporalmente
                            botonGuardar.innerHTML = '<i class="fas fa-check me-2"></i>Guardado';
                            botonGuardar.classList.add('btn-success');

                            // Restaurar después de mostrar el éxito
                            setTimeout(() => {
                                botonGuardar.innerHTML = estadoOriginal.innerHTML;
                                botonGuardar.className = estadoOriginal.className;
                            }, 2000);

                        } else {
                            throw new Error(resultado.message || 'Error desconocido del servidor');
                        }

                    } catch (error) {
                        console.error('Error en guardarCambiosPartida:', error);

                        // Mostrar error específico
                        let mensajeError = 'Error de conexión';
                        if (error.message) {
                            mensajeError = error.message;
                        }

                        toastMixin.fire({
                            icon: 'error',
                            title: mensajeError
                        });

                        // Mostrar error en el botón temporalmente
                        botonGuardar.innerHTML = '<i class="fas fa-times me-2"></i>Error';
                        botonGuardar.classList.add('btn-danger');

                    } finally {
                        // Siempre restaurar el estado del botón después de un delay
                        setTimeout(() => {
                            if (botonGuardar) {
                                botonGuardar.disabled = estadoOriginal.disabled;
                                botonGuardar.innerHTML = estadoOriginal.innerHTML;
                                botonGuardar.className = estadoOriginal.className;
                            }
                        }, 2000);
                    }
                };

                // Función para actualizar el total de una fila
                const actualizarTotal = (fila, precio, cantidad) => {
                    const total = precio * cantidad;
                    const divisaInfo = getDivisaInfo();
                    const totalCell = fila.querySelector('.total-cell');

                    if (totalCell) {
                        totalCell.innerHTML = `${divisaInfo.simbolo}${total.toFixed(2)} <small class="divisa-code">${divisaInfo.codigo}</small>`;
                        totalCell.setAttribute('data-total', total);
                    }

                    actualizarTotalGlobal();
                    return total;
                };

                // Función para actualizar el total global
                const actualizarTotalGlobal = () => {
                    const totales = Array.from(document.querySelectorAll('.total-cell'))
                        .map(cell => parseFloat(cell.getAttribute('data-total')) || 0);
                    const nuevoTotalEnDivisaSeleccionada = totales.reduce((sum, val) => sum + val, 0);
                    const divisaInfo = getDivisaInfo();

                    // Mostrar total en la divisa seleccionada
                    const totalElement = document.querySelector('.total-global-amount');
                    if (totalElement) {
                        totalElement.innerHTML = `${divisaInfo.simbolo}${nuevoTotalEnDivisaSeleccionada.toFixed(2)} <small class="divisa-code-global">${divisaInfo.codigo}</small>`;
                    }

                    // Mostrar conversión a pesos mexicanos si no es la divisa seleccionada
                    const conversionElement = document.getElementById('conversion');
                    if (conversionElement) {
                        if (divisaInfo.codigo !== 'PESOS') {
                            const totalEnPesos = nuevoTotalEnDivisaSeleccionada * tipoCambio;
                            conversionElement.innerHTML = `Total: ${totalEnPesos.toFixed(2)} MXN`;
                        } else {
                            conversionElement.innerHTML = "";
                        }
                    }
                };

                // Función para actualizar todas las divisas mostradas
                const actualizarTodasLasDivisas = () => {
                    const divisaInfo = getDivisaInfo();

                    // Actualizar símbolos en inputs de precio
                    const simbolosPrecios = document.querySelectorAll('.input-group-text');
                    simbolosPrecios.forEach(simbolo => {
                        if (simbolo.textContent === '$' || simbolo.textContent === '€') {
                            simbolo.textContent = divisaInfo.simbolo;
                        }
                    });

                    // Recalcular todos los totales
                    const filas = document.querySelectorAll('.table-row-enhanced');
                    filas.forEach(fila => {
                        const precioInput = fila.querySelector('.precio-input');
                        const cantidadInput = fila.querySelector('.cantidad-input');
                        if (precioInput && cantidadInput) {
                            const precio = Math.max(0, parseFloat(precioInput.value) || 0);
                            const cantidad = Math.max(0, parseFloat(cantidadInput.value) || 0);
                            actualizarTotal(fila, precio, cantidad);
                        }
                    });
                };

                // Event listener para cambio de divisa
                divisaSelect.addEventListener('change', async (e) => {
                    console.log('Cambiando divisa a:', e.target.value);
                    tipoCambio = await convertirADecimal(e.target.value);
                    console.log('Nuevo tipo de cambio:', tipoCambio);
                    actualizarTodasLasDivisas();
                });

                // Función para validar y corregir cantidad
                const validarCantidad = (input) => {
                    let valor = parseFloat(input.value) || 0;
                    if (valor < 0) {
                        valor = 0;
                        input.value = valor;
                    }
                    return valor;
                };

                // Crear filas agrupadas por partida
                Object.entries(partidasAgrupadas).forEach(([partidaId, grupo]) => {
                    grupo.items.forEach((item, index) => {
                        const precio = parseFloat(item.pv_prod) || 0;
                        const cantidad = Math.max(0, parseFloat(item.cant_ud) || 0); // Asegurar que no sea negativo
                        const total = precio * cantidad;
                        totalGlobal += total;

                        const fila = document.createElement('tr');
                        fila.className = 'table-row-enhanced';
                        fila.setAttribute('data-partida-id', partidaId);
                        fila.setAttribute('data-item-id', item.id || index);

                        // Solo mostrar información de partida en la primera fila del grupo
                        const mostrarInfoPartida = index === 0;
                        const divisaInfo = getDivisaInfo();

                        fila.innerHTML = `
                        <td class="partida-info">
                            ${mostrarInfoPartida ? `
                                <div class="partida-badge">
                                    <div class="fw-bold text-primary">${grupo.info.cve_prod}</div>
                                    <small class="text-muted">${grupo.info.descr_prod}</small>
                                </div>
                            ` : '<span class="text-muted">↳</span>'}
                        </td>

                        <td>
                            <span class="badge bg-info text-dark">${item.ud || '-'}</span>
                        </td>
                        <td>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text">${divisaInfo.simbolo}</span>
                                <input type="number"
                                       class="form-control precio-input"
                                       value="${precio.toFixed(2)}"
                                       min="0"
                                       step="0.01"
                                       style="max-width: 100px;">
                            </div>
                        </td>
                        <td>
                            <input type="number"
                                   class="form-control form-control-sm cantidad-input"
                                   value="${cantidad}"
                                   min="0"
                                   step="1"
                                   style="max-width: 80px;">
                        </td>
                        <td>
                            <span class="badge bg-success fs-6 total-cell" data-total="${total}">${divisaInfo.simbolo}${total.toFixed(2)} <small class="divisa-code">${divisaInfo.codigo}</small></span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-primary btn-sm guardar-btn" title="Guardar cambios">
