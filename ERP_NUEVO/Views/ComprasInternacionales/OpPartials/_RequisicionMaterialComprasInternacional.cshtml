<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
<script src="~/lib/signature_pad/dist/signature_pad.umd.min.js"></script>
<script>
    let idEncabezadoSeleccionado = null;
    let proveedorGuardado = null;
    function setIdEncabezadoModal(btn) {
        idEncabezadoSeleccionado = btn.getAttribute("data-idencabezado");
    }
    document.addEventListener("DOMContentLoaded", function () {
        actualizarTabla()
    });

    function actualizarTabla() {
        cargarTabla("#tablaOCDI", "/ProcesoComprasInternacional/GetOrdenesDeCompra");
        cargarTabla("#tablaREQ", "/ProcesoComprasInternacional/GetRequisiciones");
        cargarTabla("#tablaSCI", "/ProcesoComprasInternacional/GetSolicitudesDeCotizacion");
    }

    function cargarTabla(selector, url) {
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');

        const tabla = $(selector).DataTable({
            destroy: true,
            responsive: true,
            autoWidth: false,
            ajax: {
                url: url,
                data: { id: id }, // Si necesitas pasarlo al backend
                dataSrc: "data"
            },
            columns: [
                { data: "nuevo_codigo" },
                {
                    data: "fch",
                    render: function (data, type, row) {
                        if (data && data.startsWith("/Date(")) {
                            const timestamp = parseInt(data.match(/\d+/)[0]);
                            const date = new Date(timestamp);
                            return date.toLocaleDateString('es-MX');
                        }
                        return "";
                    }
                },
                { data: "responsable" },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        if (meta.settings.nTable.id === "tablaOCDI") {
                            return `$${parseFloat(data.imp).toFixed(2)}`;
                        }
                        if (meta.settings.nTable.id === "tablaREQ") {
                            return `${(data.total_partidas)}`;
                        }
                        return "";
                    },
                },
                { data: "coment_aut" },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        let botones = `` +
                            `<div class="d-flex gap-1" role="group">`;
                        if (meta.settings.nTable.id === "tablaOCDI") {
                            botones += '' +
                                `   <button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Agregar Acción" data-encabezado="${data.id_encabezado}" data-nvocodigo="${data.nuevo_codigo}" onclick="agregarOpciones(this)">` +
                                `       <i class="fa-solid fa-plus-large"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm cyan-700" style="color: var(--icon-color)" title="Aprobar" onclick="AprobarODCI(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-check"></i>` +
                                `   </button>`;
                            if (!data.reclasificacion) {
                                botones +=
                                    `<button class="btn btn-sm indigo-500" title="Reclasificar" onclick="GenerarReclasificador(${data.id_encabezado})">
                                        <i class="fa-solid fa-list"></i>
                                    </button>`;
                            }
                            botones += '' +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Descargar PDF" onclick="GenerarPDFGeneral(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-download"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Ver detalles" onclick="GetInfoGeneral(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-circle-info"></i>` +
                                `   </button>`;
                        }
                        if (meta.settings.nTable.id === "tablaREQ") {
                            botones += '' +
                                `<button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Archivar requisición" data-idencabezado="${data.id_encabezado}" data-bs-toggle="modal" data-bs-target="#modalSubirMateriales" onclick="setIdEncabezadoModal(this)">` +
                                `       <i class="fa-solid fa-plus-large"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm lime-500" style="color: var(--icon-color)" title="Crear orden de compra" onclick="CrearODCI(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-file-check"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Ver detalles" onclick="VerDetalleRequisicion(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-circle-info"></i>` +
                                `   </button>`;
                        }
                        if (meta.settings.nTable.id === "tablaSCI") {
                            botones += '' +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Descargar PDF" onclick="GenerarPDFGeneral(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-download"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Ver detalles" onclick="VerDetalleSolocitud(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-circle-info"></i>` +
                                `   </button>`;
                        }
                        botones += `</div>`;
                        return botones
                    },

                },
                { data: "id_encabezado", visible: false, searchable: true }
            ],
        });

        // 👇 Espera a que la tabla esté completamente cargada y luego aplica la búsqueda
        if (id) {
            $(selector).on('xhr.dt', function () {
                tabla.search(id).draw();
            });
        }
    }

    const limpiarNumero = (str) => str.replace(/[^\d.]/g, '');
    function VerDetalleRequisicion(id) {
        GetData({
            path: '/ProcesoComprasInternacional/GetRequisicionesData',
            data: { id: id }
        }).then((_res) => {
            if (_res.success) {
                const body = document.getElementById('modalDireccion');
                body.innerHTML = ''; // Limpiar contenido
                let totalGlobal = 0;

                // Header principal con información del documento
                const headerPrincipal = document.createElement('div');
                headerPrincipal.className = 'requisicion-header mb-4';
                headerPrincipal.innerHTML = `
                <div class="header-card">
                    <div class="header-gradient"></div>
                    <div class="header-content">
                        <div class="row align-items-center">
                            <div class="col-md-12">
                                <div class="document-info">
                                    <h4 class="document-title">
                                        <i class="fas fa-file-invoice me-3"></i>
                                        Requisición ${_res.returnResult.requisicion.nuevo_codigo}
                                    </h4>
                                    <div class="document-meta">
                                        <span class="meta-item">
                                            <i class="fas fa-calendar-alt me-1"></i>
                                            ${new Date().toLocaleDateString()}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Información del Proveedor Global -->
                <div class="provider-card mt-3">
                    <div class="provider-header">
                        <i class="fas fa-building me-2"></i>
                        <span class="provider-label">Proveedor Global</span>
                    </div>
                    <div class="provider-content">
                        <div class="row">
                            <div class="col-md-6">
                                <div class="provider-info">
                                    <span class="provider-name">${_res.returnResult.requisicion?.n_prov || 'Sin asignar'}</span>
                                    <span class="provider-code">Código: ${_res.returnResult.requisicion?.cve_prov || 'N/A'}</span>
                                </div>
                            </div>
                            <div class="col-md-6 text-end">
                                <div class="provider-contact">
                                    <span class="contact-item">
                                        <i class="fas fa-phone me-1"></i>
                                        ${_res.returnResult.requisicion?.tel || 'Sin teléfono'}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
                body.appendChild(headerPrincipal);

                // Procesar partidas con diseño optimizado (sin información redundante)
                Object.entries(_res.returnResult.partidas).forEach(([k, v]) => {
                    const div = document.createElement('div');
                    const tablaId = `tabla-materiales_${v.id_partidas}`;

                    let html = `
                <div class="partida-card">
                    <div class="partida-header-simple">
                        <div class="partida-badge">
                            <i class="fas fa-box me-2"></i>
                            Partida ${parseInt(k) + 1}
                        </div>
                    </div>

                    <div class="tabla-moderna-container">
                        <table class="tabla-moderna" id="${tablaId}">
                            <thead>
                                <tr>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-barcode me-2"></i>
                                            Clave
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-cube me-2"></i>
                                            Descripción
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-ruler me-2"></i>
                                            Unidad
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-dollar-sign me-2"></i>
                                            Costo Unit.
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-calculator me-2"></i>
                                            Cantidad
                                        </div>
                                    </th>
                                    <th>
                                        <div class="th-content">
                                            <i class="fas fa-receipt me-2"></i>
                                            Total
                                        </div>
                                    </th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>
                `;

                    div.innerHTML = html;
                    body.appendChild(div);

                    // Agregar filas a la tabla
                    const partidas = _res.returnResult.partidas.filter(p => p.id_partidas == v.id_partidas);
                    const tbody = document.querySelector(`#${tablaId} tbody`);

                    partidas.forEach((p, index) => {
                        const precio = parseFloat(p.pv_prod);
                        const cantidad = parseFloat(p.cant_ud) || 0;
                        const total = precio * cantidad;
                        totalGlobal += total;

                        const fila = document.createElement('tr');
                        fila.className = `tabla-row ${index % 2 === 0 ? 'row-even' : 'row-odd'}`;
                        fila.innerHTML = `
                        <td>
                            <div class="cell-content">
                                <span class="codigo-badge">${p.cve_prod}</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-content">
                                <span class="descripcion-text">${p.descr_prod || '-'}</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-content text-center">
                                <span class="unidad-badge">${p.ud || '-'}</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-content text-end">
                                <span class="precio-text">$${precio.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-content text-center">
                                <span class="cantidad-badge">${cantidad.toLocaleString('es-MX')}</span>
                            </div>
                        </td>
                        <td>
                            <div class="cell-content text-end">
                                <span class="total-text">$${total.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</span>
                            </div>
                        </td>
                    `;
                        tbody.appendChild(fila);
                    });
                });

                // Archivos adjuntos con diseño mejorado
                const archivos = _res.returnResult.archivos;
                if (archivos.length > 0) {
                    const archivosContainer = document.createElement('div');
                    archivosContainer.className = 'archivos-container';

                    archivosContainer.innerHTML = `
                    <div class="archivos-card">
                        <div class="archivos-header">
                            <i class="fas fa-paperclip me-2"></i>
                            <span class="archivos-title">Documentos Adjuntos</span>
                            <span class="archivos-count">${archivos.length} archivo${archivos.length > 1 ? 's' : ''}</span>
                        </div>
                        <div class="archivos-grid">
                            ${archivos.map(archivo => {
                        const icono = getIconFile(archivo.extencion);
                        return `
                                    <div class="archivo-item">
                                        <div class="archivo-icon">
                                            <i class="fas ${icono}"></i>
                                        </div>
                                        <div class="archivo-info">
                                            <a href="/${archivo.path}" target="_blank" class="archivo-nombre">
                                                ${archivo.nombre_original}
                                            </a>
                                            <span class="archivo-extension">${archivo.extencion.toUpperCase()}</span>
                                        </div>
                                        <div class="archivo-action">
                                            <i class="fas fa-external-link-alt"></i>
                                        </div>
                                    </div>
                                `;
                    }).join('')}
                        </div>
                    </div>
                `;

                    body.appendChild(archivosContainer);
                }

                // Resumen de totales modernizado
                const totalResumen = document.createElement('div');
                totalResumen.className = "total-resumen-container";
                totalResumen.innerHTML = `
                <div class="total-resumen-card">
                    <div class="total-header">
                        <div class="total-icon">
                            <i class="fas fa-calculator"></i>
                        </div>
                        <div class="total-info">
                            <h6 class="total-titulo">Resumen General</h6>
                            <p class="total-descripcion">Total de la requisición</p>
                        </div>
                    </div>
                    <div class="total-divider"></div>
                    <div class="total-amount-section">
                        <div class="total-label">Total General:</div>
                        <div class="total-amount">$${totalGlobal.toLocaleString('es-MX', { minimumFractionDigits: 2 })}</div>
                    </div>
                    <div class="total-footer">
                        <small class="total-note">* Montos en pesos mexicanos</small>
                    </div>
                </div>
            `;
                body.appendChild(totalResumen);

                // Agregar estilos CSS modernos optimizados
                agregarEstilosModernosOptimizados();

                $('#modalAceptarCotizacion').data('encabezado', id);
                $('#modalOpcionesLabel').html(`<i class="bi bi-check-circle-fill me-2"></i> Detalles de la requisicion No. ${_res.returnResult.requisicion.nuevo_codigo}`);
                $('#modalAceptarCotizacion').modal('show');
            } else {
                toastMixin.fire({
                    icon: 'error',
                    title: _res.error
                });
            }
        });
    }

