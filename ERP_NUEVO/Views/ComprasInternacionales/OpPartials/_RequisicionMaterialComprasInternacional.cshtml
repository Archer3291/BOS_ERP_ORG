                                            <i class="fas fa-save" style="color: var(--primary-blue);"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            `;
                mainContainer.appendChild(headerInfo);

                // Crear tabla unificada para todas las partidas
                const tableContainer = document.createElement('div');
                tableContainer.className = 'table-container-modern mb-4';

                const tableId = 'tabla-requisicion-unificada';
                tableContainer.innerHTML = `
                  <div class="card shadow-sm border-0" style="border-radius: 1rem;">
                      <div class="card-header bg-light border-0" style="border-radius: 1rem 1rem 0 0;">
                          <div class="d-flex justify-content-between align-items-center">
                              <h6 class="mb-0 fw-bold text-dark">
                                  <i class="fas fa-table me-2"></i>Detalle de Partidas
                              </h6>
                              <span class="badge bg-info">${allPartidas.length} registros</span>
                          </div>
                      </div>
                      <div class="table-responsive" style="max-height: 600px;">
                          <table class="table modern-table-enhanced mb-0" id="${tableId}">
                              <thead class="sticky-top">
                                  <tr>
                                      <th style="min-width: 120px;"><i class="fas fa-tag me-2"></i>Partida</th>
                                      <th style="min-width: 80px;"><i class="fa-solid fa-cubes me-2"></i>Unidad</th>
                                      <th style="min-width: 120px;"><i class="fas fa-dollar-sign me-2"></i>Costo Unit.</th>
                                      <th style="min-width: 100px;"><i class="fas fa-calculator me-2"></i>Cantidad</th>
                                      <th style="min-width: 120px;"><i class="fas fa-receipt me-2"></i>Total</th>
                                      <th style="min-width: 80px;"><i class="fas fa-cog me-2"></i>Acciones</th>
                                  </tr>
                              </thead>
                              <tbody></tbody>
