                                    </label>
                                    <div class="d-flex gap-2 align-items-end">
                                        <select class="form-select form-select-sm flex-grow-1" id="divisa" style="background-color: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; backdrop-filter: blur(10px);">
                                            <option value="PESOS" data-symbol="$" ${divisaGuardada === 'PESOS' ? 'selected' : ''}>MXN - Peso Mexicano</option>
                                            <option value="DLLS" data-symbol="$" ${divisaGuardada === 'DLLS' ? 'selected' : ''}>USD - Dólar Americano</option>
                                            <option value="EURO" data-symbol="€" ${divisaGuardada === 'EURO' ? 'selected' : ''}>EUR - Euro</option>
                                        </select>
                                        <button class="btn btn-sm btn-light btn-guardar-divisa" id="btnGuardarDivisa" title="Guardar divisa" style="padding: 0.375rem 0.75rem; min-width: 40px;">
                                            <i class="fas fa-save" style="color: var(--primary-blue);"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="proveedor-selector">
                                    <label for="proveedor" class="form-label mb-1 opacity-90" style="font-size: 0.85rem; font-weight: 500;">
                                        <i class="fas fa-building me-1"></i>Proveedor
                                    </label>
                                    <div class="d-flex gap-2 align-items-end">
                                        <select class="form-select form-select-sm flex-grow-1" id="proveedor" style="background-color: rgba(255,255,255,0.15); border: 1px solid rgba(255,255,255,0.3); color: white; backdrop-filter: blur(10px);">
