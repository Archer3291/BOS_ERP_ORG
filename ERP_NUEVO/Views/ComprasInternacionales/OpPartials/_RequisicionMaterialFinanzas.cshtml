@{
    ViewBag.Title = "Finanzas";
}
<link href="~/content/sidebar.css" rel="stylesheet" />
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
@section styles{
    <style>
        .card {
            border-radius: 1rem;
            background-color: var(--bg-light);
            box-shadow: var(--shadow);
            transition: 0.2s ease all;
        }

            .card:hover {
                box-shadow: var(--shadow-lg);
            }

        .table-borderless th,
        .table-borderless td {
            border: none;
            border-bottom: 1px solid var(--border-light);
        }

        thead tr {
            border-bottom: 2px solid var(--border-light);
        }

        th {
            font-weight: 600;
        }

        tbody tr:last-child td {
            border-bottom: none;
        }

        .custom-checkbox {
            position: relative;
            display: inline-block;
            width: 24px;
            height: 24px;
        }

            .custom-checkbox input[type="checkbox"] {
                /*opacity: 0;
                position: absolute;
                left: 0;
                top: 0;
                width: 100%;
                height: 100%;
                margin: 0;
                cursor: pointer;*/
            }

            .custom-checkbox label {
                /*display: block;
                width: 100%;
                height: 100%;
                background-color: var(--very-light-blue);
                border: 2px solid var(--primary-blue);
                border-radius: 6px;
                cursor: pointer;
                transition: all 0.2s ease;*/
            }

            .custom-checkbox input[type="checkbox"]:checked + label {
                background-color: var(--primary-blue);
                background-image: url("data:image/svg+xml;charset=UTF-8,%3Csvg viewBox='0 0 16 16' fill='white' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M6.173 12.927a.75.75 0 0 1-1.06 0L2.25 10.064a.75.75 0 0 1 1.06-1.06l2.5 2.5 6.44-6.44a.75.75 0 0 1 1.06 1.06l-7 7z'/%3E%3C/svg%3E");
                background-repeat: no-repeat;
                background-position: center;
                background-size: 65%;
            }
    </style>
}

<form>
    @Html.AntiForgeryToken()
</form>
