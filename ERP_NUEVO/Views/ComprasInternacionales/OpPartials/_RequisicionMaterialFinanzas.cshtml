<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        cargarTabla("#tablaPendientes", "/Requisicion/GetCotizacionesFinanzas");
        cargarTabla("#tablaCuentasPorPagar", "/Requisicion/GetOCFinanzas");
        cargarTabla("#tablaRetenidas", "/Requisicion/GetCotizacionesRetenidas");
        cargarTabla("#tablaDirectas", "/Requisicion/GetOrdenesCompraDirecta");
    });

    function cargarTabla(selector, url) {
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');

        const tabla = $(selector).DataTable({
            destroy: true,
            responsive: true,
            autoWidth: false,
            ajax: {
                url: url,
                data: { id: id }, // Si necesitas pasarlo al backend
                dataSrc: "data"
            },
            columns: [
                { data: "nuevo_codigo" },
                {
                    data: "fch",
                    render: function (data, type, row) {
                        if (data && data.startsWith("/Date(")) {
                            const timestamp = parseInt(data.match(/\d+/)[0]);
                            const date = new Date(timestamp);
                            return date.toLocaleDateString('es-MX');
                        }
                        return "";
                    }
                },
                { data: "nombre_completo" },
                { data: "imp", render: data => `$${parseFloat(data).toFixed(2)}` },
                {
                    data: null,
                    render: function (data, type, row, meta) {
                        const tablaId = meta.settings.nTable.id;

                        if (tablaId === "tablaRetenidas") {
                            return row.coment1 || '';
                        } else {
                            return row.coment_aut || '';
                        }
                    }
                },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        let botones = ``;

                        botones += `<div class="d-flex gap-1" role="group">` +
                            `   <button class="btn btn-sm sky-500" title="Ver detalles" style="color: var(--icon-color)" onclick="GetInfoGeneral(${data.id_encabezado})">` +
                            `       <i class="fa-solid fa-circle-info"></i>` +
                            `   </button>`;
                        if (meta.settings.nTable.id !== "tablaCuentasPorPagar") {
                            botones += `<button class="btn btn-sm btn-success" title="Aceptar Cotizacion" style="color: var(--icon-color)" data-encabezado="${data.id_encabezado}" data-nvocodigo="${data.nuevo_codigo}" onclick="aceptarCotizacion(this)">` +
                                `       <i class="fa-solid fa-circle-check" ></i> ` +
                                `   </button>`;
                        }
                        if (meta.settings.nTable.id === "tablaPendientes") {
                            botones += `   <button class="btn btn-sm red-500" title="Retener" style="color: var(--icon-color)" data-encabezado="${data.id_encabezado}" data-nvocodigo="${data.nuevo_codigo}"  onclick="RetenerCTZ(this)">` +
                                `        <i class="fa-solid fa-circle-xmark"></i>` +
                                `   </button>`;
                        }
                        if (meta.settings.nTable.id === "tablaDirectas") {
                            botones += '' +
                                `   <button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Descargar Formato de compra directa" onclick="GenerarPDFGeneral(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-download"></i>` +
                                `   </button>`;
                        }
                        if (meta.settings.nTable.id === "tablaCuentasPorPagar") {
                            botones += `   <button class="btn btn-sm btn-success" title="Aceptar Orden de Compra" style="color: var(--icon-color)" data-encabezado="${data.id_encabezado}" data-nvocodigo="${data.nuevo_codigo}"  onclick="aceptarOrdenCompra(this)">` +
                                `        <i class="fa-solid fa-circle-check" ></i> ` +
                                `   </button>`;
                            if (data.tipo_proceso === "gasto") {
                                botones += `` +
                                    `   <button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Descargar Formato de solicitud de gasto" onclick="GenerarPDFGeneral(${data.id_encabezado})">` +
                                    `       <i class="fa-solid fa-download"></i>` +
                                    `   </button>`;
                            } else if (data.tipo_proceso === "orden_compra") {
                                botones += `` +
                                    `   <button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Descargar Formato de orden de compra" onclick="GenerarPDFGeneral(${data.id_encabezado})">` +
                                    `       <i class="fa-solid fa-download"></i>` +
                                    `   </button>`;
                            }
                        }

                        botones += `</div>`
                        return botones
                    },

                },
                { data: "id_encabezado", visible: false, searchable: true }
            ],
        });

        if (id) {
            $(selector).on('xhr.dt', function () {
                tabla.search(id).draw();
            });
        }
    }

    function verDetalle(e) {
        const folio = $(e).data('encabezado');
        const nuevo_codigo = $(e).data('nvocodigo');

        GetData({
            path: `/Requisicion/GetRequisicionPartida?folio=${encodeURIComponent(folio)}`
        }).then((data) => {
            if (data && Array.isArray(data.data) && data.data.length > 0) {
                const primeraPartida = data.data[0];

                // Obtener y formatear la fecha del documento desde la primera partida
                let fechaFormateada = "";
                if (primeraPartida.fch && primeraPartida.fch.toString().startsWith("/Date(")) {
                    const timestamp = parseInt(primeraPartida.fch.match(/\d+/)[0]);
                    const fecha = new Date(timestamp);
                    fechaFormateada = fecha.toLocaleDateString('es-MX');
                }

                // Construir tabla HTML con todas las partidas
                let tabla = `
                                                <div style="max-height: 300px; overflow-y: auto;">
                                                <table class="table table-bordered table-sm text-start">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Producto</th>
                                                            <th>Cantidad</th>
                                                            <th>Importe</th>
                                                            <th>IVA</th>
                                                            <th>Total</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                            `;

                data.data.forEach(partida => {
                    tabla += `
                                                    <tr>
                                                        <td>${partida.cve_prod}</td>
                                                        <td>${partida.cant_ud}</td>
                                                        <td>$${parseFloat(partida.imp_part).toFixed(2)}</td>
                                                        <td>$${parseFloat(partida.iva).toFixed(2)}</td>
                                                        <td>$${parseFloat(partida.importe).toFixed(2)}</td>
                                                    </tr>
                                                `;
                });

                tabla += `
                                                    </tbody>
                                                </table>
                                                </div>
                                            `;

                Swal.fire({
                    title: `Partidas del folio ${nuevo_codigo}`,
                    html: tabla,
                    width: '800px',
                    scrollbarPadding: false,
                    confirmButtonText: 'Cerrar',
                    customClass: {
                        htmlContainer: 'text-start'
                    }
                });
            } else {
                Swal.fire({
                    icon: 'warning',
                    title: 'Sin datos',
                    text: `No se encontraron partidas para el folio ${folio}`
                });
            }
        }).catch((error) => {
            console.error('Error al obtener los datos:', error);
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: 'Ocurrió un error al consultar los datos del documento.'
            });
        });
    }
    function aceptarCotizacion(e) {
        const id = $(e).data('encabezado');
        const nuevo_codigo = $(e).data('nvocodigo');

        GetData({
            path: '/Requisicion/GetCotizacionData',
            data: { id: id }
        }).then((_res) => {
            if (_res.success) {
                const body = document.getElementById('modalBody');
                body.innerHTML = ''; // Limpiar contenido

                let totalGlobal = 0;
                
                Object.entries(_res.returnResult.partidas).forEach(([k, v]) => {
                    const div = document.createElement('div');
                    div.id = `card-partida-${v.id_partidas}`;

                    const tablaId = `tabla-materiales_${v.id_partidas}`;

                    let html = `
                                                <div class="card shadow-sm border-0 mb-4" style="background-color: var(--bg-gray); border-radius: 1rem; padding: 1.5rem;">
                                                    <div class="row mb-3">
                                                        <div class="col">
                                                            <p class="mb-1 text-muted small">Clave:</p>
                                                            <h6 class="fw-bold">${v.cve_prod}</h6>
                                                        </div>
                                                        <div class="col">
                                                            <p class="mb-1 text-muted small">Descripción:</p>
                                                            <h6 class="fw-bold">${v.descr_prod}</h6>
                                                        </div>
                                                    </div>

                                                    <div class="table-responsive">
                                                        <table class="table table-bordered table-hover align-middle text-center" id="${tablaId}">
                                                            <thead class="table-light">
                                                                <tr>
                                                                    <th>Proveedor *</th>
                                                                    <th>Producto *</th>
                                                                    <th>Descripción</th>
                                                                    <th>Unidad</th>
                                                                    <th>Costo Unitario</th>
                                                                    <th>Cantidad</th>
                                                                    <th>Total</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody></tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            `;

                    div.innerHTML = html;
                    body.appendChild(div);

                    // Agregar filas a la tabla de cada partida
                    const partidas = _res.returnResult.partidas.filter(p => p.id_partidas == v.id_partidas);
                    const tbody = document.querySelector(`#${tablaId} tbody`);

                    partidas.forEach(p => {
                        const precio = parseFloat(p.pv_prod);
                        const cantidad = parseFloat(p.cant_ud) || 0;
                        const total = precio * cantidad;
                        totalGlobal += total;

                        const fila = document.createElement('tr');
                        fila.innerHTML = `
                                                    <td><span class="badge bg-secondary">${p.cve_vdr_cpr}</span></td>
                                                    <td><span class="text-primary fw-semibold">${p.cve_prod}</span></td>
                                                    <td>${p.descr_prod || '-'}</td>
                                                    <td>${p.ud || '-'}</td>
                                                    <td>$${precio.toFixed(2)}</td>
                                                    <td>${cantidad}</td>
                                                    <td>$${total.toFixed(2)}</td>
                                                    <td class="d-none"><span class="badge bg-secondary">${p.refe}</span></td>
                                                `;
                        tbody.appendChild(fila);
                    });
                });

                // Agregar totalizador general al final
                const totalResumen = document.createElement('div');
                totalResumen.className = "mt-4 d-flex justify-content-end";
                totalResumen.innerHTML = `
                                            <div class="ticket-summary p-4 rounded-3 border-0" style="min-width: 300px;">
                                                <div class="ticket-header text-center mb-3">
                                                    <h6 class="mb-1 fw-bold ticket-title">🧾 RESUMEN DE TOTALES</h6>
                                                    <div class="ticket-line"></div>
                                                </div>
                                                <div class="ticket-body">
                                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                                        <span class="ticket-dots">• • • • • • • • • • • • • • • • • • • •</span>
                                                    </div>

                                                    <div class="d-flex justify-content-between align-items-center mb-3">
                                                        <span class="fw-semibold ticket-text">TOTAL GENERAL:</span>
                                                        <span class="fw-bold fs-5 ticket-amount">${totalGlobal.toFixed(2)}</span>
                                                    </div>

                                                    <div class="ticket-footer text-center">
                                                        <small class="ticket-separator">═══════════════════════</small>
                                                    </div>
                                                </div>
                                            </div>
                                            <style>
                                            .ticket-summary {
                                                font-family: 'Courier New', monospace;
                                                background: var(--bg-light);
                                                border: 2px dashed var(--border-light) !important;
                                                position: relative;
                                                box-shadow: var(--shadow-lg);
                                                border-left: 4px solid var(--primary-blue) !important;
                                            }
                                            .ticket-summary::before {
                                                content: '';
                                                position: absolute;
                                                top: -8px;
                                                left: 20px;
                                                right: 20px;
                                                height: 16px;
                                                background: repeating-linear-gradient(
                                                    to right,
                                                    transparent,
                                                    transparent 10px,
                                                    var(--border-light) 10px,
                                                    var(--border-light) 20px
                                                );
                                            }
                                            .ticket-summary::after {
                                                content: '';
                                                position: absolute;
                                                bottom: -8px;
                                                left: 20px;
                                                right: 20px;
                                                height: 16px;
                                                background: repeating-linear-gradient(
                                                    to right,
                                                    transparent,
                                                    transparent 10px,
                                                    var(--border-light) 10px,
                                                    var(--border-light) 20px
                                                );
                                            }

                                            .ticket-line {
                                                height: 1px;
                                                background: var(--border-light);
                                                margin: 0 auto;
                                                width: 80%;
                                            }
                                            .ticket-dots {
                                                font-size: 0.8em;
                                                color: var(--text-light);
                                                letter-spacing: 2px;
                                            }
                                            .ticket-title {
                                                color: var(--primary-blue);
                                            }
                                            .ticket-text {
                                                color: var(--text-dark);
                                            }
                                            .ticket-amount {
                                                color: var(--accent-blue);
                                            }
                                            .ticket-separator {
                                                color: var(--text-light);
                                            }
                                            </style>
                                            `;
                body.appendChild(totalResumen);

                $('#modalAgregarOpciones').data('encabezado', id);
                $('#modalOpcionesLabel').text(`Cotización No. ${_res.returnResult.requisicion.nuevo_codigo}`);
                $('#modalAgregarOpciones').modal('show');




            } else {
                toastMixin.fire({
                    icon: 'error',
                    title: _res.error
                });
            }
        });
    }
    document.getElementById('btn-actualizar').addEventListener('click', function () {
        const idEncabezado = $('#modalAgregarOpciones').data('encabezado');

        if (!idEncabezado || isNaN(idEncabezado)) {
            Swal.fire('Error', 'ID de encabezado inválido o no proporcionado.', 'error');
            return;
        }

        const formData = new FormData();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        formData.append('id_encabezado', idEncabezado);

        fetch('/Requisicion/AceptarCotizacion', {
            method: 'POST',
            body: formData
        })
