    function aceptarOrdenCompra(e) {
        const id = $(e).data('encabezado');
        const nuevo_codigo = $(e).data('nvocodigo');
        var apr5 = false;

        GetData({
            path: '/Requisicion/GetCotizacionData',
            data: { id: id }
        }).then((_res) => {
            if (_res.success) {
                const body = document.getElementById('modalBody2');
                body.innerHTML = ''; // Limpiar contenido

                let totalGlobal = 0;
                // Validar si apr5 está aprobado
                apr5 = _res.returnResult.requisicion.apr5;
                if (_res.returnResult.requisicion.apr5 === false || _res.returnResult.requisicion.apr5 === 'false') {
                    const btnAceptar = document.getElementById('btn-actualizar');
                    btnAceptar.disabled = true;
                    btnAceptar.classList.add('disabled');

                    const advertencia = document.createElement('div');
                    advertencia.className = 'alert alert-warning mt-3';
                    advertencia.innerHTML = `
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    La cotización aún no ha sido aceptada por el área correspondiente. No puedes aprobarla.
                `;
                    document.getElementById('modalBody2').appendChild(advertencia);
                } else {
                    document.getElementById('btn-actualizar').disabled = false;
                    document.getElementById('btn-actualizar').classList.remove('disabled');
                }
                Object.entries(_res.returnResult.partidas).forEach(([k, v]) => {
                    const div = document.createElement('div');
                    div.id = `card-partida-${v.id_partidas}`;

                    const tablaId = `tabla-materiales_${v.id_partidas}`;

                    let html = `
                                            <div class="card shadow-sm border-0 mb-4" style="background-color: var(--bg-gray); border-radius: 1rem; padding: 1.5rem;">
                                                <div class="row mb-3">
                                                    <div class="col">
                                                        <p class="mb-1 text-muted small">Clave:</p>
                                                        <h6 class="fw-bold">${v.cve_prod}</h6>
                                                    </div>
                                                    <div class="col">
                                                        <p class="mb-1 text-muted small">Descripción:</p>
                                                        <h6 class="fw-bold">${v.descr_prod}</h6>
                                                    </div>
                                                </div>

                                                <div class="table-responsive">
                                                    <table class="table table-bordered table-hover align-middle text-center" id="${tablaId}">
                                                        <thead class="table-light">
                                                            <tr>
                                                                <th>Proveedor *</th>
                                                                <th>Producto *</th>
                                                                <th>Descripción</th>
                                                                <th>Unidad</th>
                                                                <th>Costo Unitario</th>
                                                                <th>Cantidad</th>
                                                                <th>Total</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody></tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        `;

                    div.innerHTML = html;
                    body.appendChild(div);

                    // Agregar filas a la tabla de cada partida
                    const partidas = _res.returnResult.partidas.filter(p => p.id_partidas == v.id_partidas);
                    const tbody = document.querySelector(`#${tablaId} tbody`);

                    partidas.forEach(p => {
                        const precio = parseFloat(p.pv_prod);
                        const cantidad = parseFloat(p.cant_ud) || 0;
                        const total = precio * cantidad;
                        totalGlobal += total;

                        const fila = document.createElement('tr');
                        fila.innerHTML = `
                                                <td><span class="badge bg-secondary">${p.cve_vdr_cpr}</span></td>
                                                <td><span class="text-primary fw-semibold">${p.cve_prod}</span></td>
                                                <td>${p.descr_prod || '-'}</td>
                                                <td>${p.ud || '-'}</td>
                                                <td>$${precio.toFixed(2)}</td>
                                                <td>${cantidad}</td>
                                                <td>$${total.toFixed(2)}</td>
                                                <td class="d-none"><span class="badge bg-secondary">${p.refe}</span></td>
                                            `;
                        tbody.appendChild(fila);
                    });
                });

                // Agregar totalizador general al final
                const totalResumen = document.createElement('div');
                totalResumen.className = "mt-4 d-flex justify-content-end";
                totalResumen.innerHTML = `
                                        <div class="ticket-summary p-4 rounded-3 border-0" style="min-width: 300px;">
                                            <div class="ticket-header text-center mb-3">
                                                <h6 class="mb-1 fw-bold ticket-title">🧾 RESUMEN DE TOTALES</h6>
                                                <div class="ticket-line"></div>
                                            </div>
                                            <div class="ticket-body">
                                                <div class="d-flex justify-content-between align-items-center mb-2">
                                                    <span class="ticket-dots">• • • • • • • • • • • • • • • • • • • •</span>
                                                </div>

                                                <div class="d-flex justify-content-between align-items-center mb-3">
                                                    <span class="fw-semibold ticket-text">TOTAL GENERAL:</span>
                                                    <span class="fw-bold fs-5 ticket-amount">${totalGlobal.toFixed(2)}</span>
                                                </div>

                                                <div class="ticket-footer text-center">
                                                    <small class="ticket-separator">═══════════════════════</small>
                                                </div>
                                            </div>
                                        </div>
                                        <style>
                                        .ticket-summary {
                                            font-family: 'Courier New', monospace;
                                            background: var(--bg-light);
                                            border: 2px dashed var(--border-light) !important;
                                            position: relative;
                                            box-shadow: var(--shadow-lg);
                                            border-left: 4px solid var(--primary-blue) !important;
                                        }
                                        .ticket-summary::before {
                                            content: '';
                                            position: absolute;
                                            top: -8px;
                                            left: 20px;
                                            right: 20px;
                                            height: 16px;
                                            background: repeating-linear-gradient(
                                                to right,
                                                transparent,
                                                transparent 10px,
                                                var(--border-light) 10px,
                                                var(--border-light) 20px
                                            );
                                        }
                                        .ticket-summary::after {
                                            content: '';
                                            position: absolute;
                                            bottom: -8px;
                                            left: 20px;
                                            right: 20px;
                                            height: 16px;
                                            background: repeating-linear-gradient(
                                                to right,
                                                transparent,
                                                transparent 10px,
                                                var(--border-light) 10px,
                                                var(--border-light) 20px
                                            );
                                        }

                                        .ticket-line {
                                            height: 1px;
                                            background: var(--border-light);
                                            margin: 0 auto;
                                            width: 80%;
                                        }
                                        .ticket-dots {
                                            font-size: 0.8em;
                                            color: var(--text-light);
                                            letter-spacing: 2px;
                                        }
                                        .ticket-title {
                                            color: var(--primary-blue);
                                        }
                                        .ticket-text {
                                            color: var(--text-dark);
                                        }
                                        .ticket-amount {
                                            color: var(--accent-blue);
                                        }
                                        .ticket-separator {
                                            color: var(--text-light);
                                        }
                                        </style>
                                        `;
                body.appendChild(totalResumen);

                $('#modalAceptarOC').data('apr5', apr5);
                $('#modalAceptarOC').data('encabezado', id);
                $('#modalOpcionesLabel').text(`Cotización No. ${_res.returnResult.requisicion.nuevo_codigo}`);
                $('#modalAceptarOC').modal('show');




            } else {
                toastMixin.fire({
                    icon: 'error',
                    title: _res.error
                });
            }
        });
    }
    document.getElementById('btn-aceptaroc').addEventListener('click', function () {
        const idEncabezado = $('#modalAceptarOC').data('encabezado');
        var apr5 = $('#modalAceptarOC').data('apr5');

        if (!idEncabezado || isNaN(idEncabezado)) {
            Swal.fire('Error', 'ID de encabezado inválido o no proporcionado.', 'error');
            return;
        }

        const formData = new FormData();

        const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (token) {
            formData.append('__RequestVerificationToken', token);
        }

        formData.append('id_encabezado', idEncabezado);
        formData.append('apr5', apr5);

        fetch('/Requisicion/AceptarOrdenDeCompra', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    Swal.fire('Actualizado', 'El estatus fue actualizado correctamente.', 'success');
                    $('#modalAceptarOC').modal('hide');
                    $('#tablaPendientes').DataTable().ajax.reload();
                    $('#tablaRetenidas').DataTable().ajax.reload();
                    $('#tablaCuentasPorPagar').DataTable().ajax.reload();
                    $('#tablaDirectas').DataTable().ajax.reload();
                } else {
                    Swal.fire('Error', data.error || 'No se pudo actualizar el estatus.', 'error');
                }
            })
            .catch(err => {
                console.error(err);
                Swal.fire('Error', 'Ocurrió un error al actualizar.', 'error');
            });
    });

    function RetenerCTZ(button) {
        const id_encabezado = button.getAttribute('data-encabezado');
        const fol_doc = button.getAttribute('data-nvocodigo');

        Swal.fire({
            title: `¿Retener cotización ${fol_doc}?`,
            input: 'textarea',
            inputLabel: 'Motivo del rechazo',
            inputPlaceholder: 'Escribe el motivo...',
            inputAttributes: {
                'aria-label': 'Motivo de la retención'
            },
            showCancelButton: true,
            confirmButtonText: 'Sí, rechazar',
            cancelButtonText: 'Cancelar',
            preConfirm: (comentario) => {
                if (!comentario) {
                    Swal.showValidationMessage('Debes ingresar un motivo');
                }
                return comentario;
            }
        }).then(result => {
            if (result.isConfirmed) {
                GetData({
                    path: '/Requisicion/RetenerRequisicion',
                    data: {
                        id_encabezado: id_encabezado,
                        comentario: result.value
                    }
                }).then((data) => {
                    if (data.success) {
                        Swal.fire('Rechazada', `La cotización ${fol_doc} fue retenida correctamente.`, 'success');
                        $('#tablaPendientes').DataTable().ajax.reload();
                        $('#tablaRetenidas').DataTable().ajax.reload();
                        $('#tablaCuentasPorPagar').DataTable().ajax.reload();
                        $('#tablaDirectas').DataTable().ajax.reload();
                    } else {
                        Swal.fire('Error', data.error || 'No se pudo rechazar la remisión.', 'error');
                    }
                })
            }
        });
    }

</script>
