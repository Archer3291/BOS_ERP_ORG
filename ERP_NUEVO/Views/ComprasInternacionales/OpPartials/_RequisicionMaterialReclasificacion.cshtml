<!-- Modal para subir CSV y visualizar materiales -->
<div class="modal fade" id="modalSubirMateriales" tabindex="-1" aria-labelledby="modalSubirMaterialesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSubirMaterialesLabel">
                    <i class="fas fa-file-upload me-2"></i> Subir Materiales desde CSV
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <!-- Formulario de carga CSV -->
                <form id="form-subir-csv" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label for="archivoCsv" class="form-label">Selecciona tu archivo .csv</label>
                        <input type="file" name="archivoCsv" id="archivoCsv" class="form-control" accept=".csv" required />
                    </div>
                    <button type="submit" class="btn btn-primary w-100 mb-4">
                        <i class="fas fa-upload me-2"></i> Subir y Procesar
                    </button>
                </form>

                <!-- Información importante -->
                <div class="info-panel mb-3">
                    <div class="info-title">
                        <i class="fas fa-info-circle"></i>
                        Información Importante
                    </div>
                    <p class="info-text">
                        <i class="fas fa-asterisk me-1"></i>
                        Los campos marcados con * son obligatorios
                    </p>
                </div>

                <!-- Tabla de materiales -->
                <div class="table-responsive mb-4">
                    <table class="table align-middle table-hover" id="tabla-materiales">
                        <thead class="text-center" style="background-color: var(--very-light-blue); color: var(--text-dark);">
                            <tr>
                                <th class="text-start"><i class="bi bi-check-square"></i></th>
                                <th class="text-start">#</th>
                                <th class="text-start">Cantidad *</th>
                                <th class="text-start">Código *</th>
                                <th class="text-start">Proveedor *</th>
                                <th class="text-start">Unidad *</th>
                                <th class="text-start">Costo Unitario *</th>
                                <th class="text-start">Total</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <!-- Observaciones -->
                <div class="form-floating mb-4">
                    <textarea class="form-control" id="observaciones" rows="3"></textarea>
                    <label for="observaciones"><i class="bi bi-journal-text"></i> Observaciones</label>
                </div>

                <!-- Total -->
                <div class="row">
                    <div class="col-4">
                        <div class="form-floating mb-3">
                            <input type="text" id="total" class="form-control fw-bold" readonly />
                            <label for="total"><i class="bi bi-calculator me-1"></i>Total</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cerrar
                </button>
                <button type="button" id="btn-guardar-materiales" class="btn btn-primary">
                    <i class="bi bi-save me-1"></i> Guardar Materiales
                </button>
            </div>
        </div>
    </div>
</div>
