            contenedor.parentNode.insertBefore(infoContainer, contenedor);
        }

        const porcentajePendiente = 100 - datosEncabezado.porcentaje_pagado;
        const clasePorcentaje = datosEncabezado.porcentaje_pagado >= 100 ? 'text-success' : 'text-warning';

        infoContainer.innerHTML = `
        <div class="row">
            <div class="col-md-6">
                <strong>💰 Total del Pedido:</strong> $${parseFloat(datosEncabezado.total_encabezado).toFixed(2)}
            </div>
