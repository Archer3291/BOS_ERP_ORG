            <div class="pedimento-content">
                <span class="pedimento-label">Pedimento SAT</span>
                <span class="pedimento-number">${pedimento.pedimento_sat}</span>
            </div>
            <div class="pedimento-status">
                <i class="fas fa-check-circle"></i>
            </div>
        </div>
    `).join('');

    section.innerHTML = `
        <div class="section-header">
            <div class="section-title-group">
                <i class="fas fa-file-invoice-dollar section-icon"></i>
                <div>
                    <h5 class="section-title">Pedimentos Aduanales</h5>
