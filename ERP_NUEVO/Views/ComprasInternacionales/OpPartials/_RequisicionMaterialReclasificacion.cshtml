<script>
    // Variable global para almacenar los datos de pago
    let datosEncabezado = {
        total_encabezado: 0,
        total_pagado: 0,
        total_pendiente: 0,
        porcentaje_pagado: 0
    };

    function agregarComprobantes(btn) {
        idEncabezadoSeleccionado = btn.dataset.encabezado;

        // Primero verificar el estado de pagos
        verificarEstadoPagos(idEncabezadoSeleccionado).then(() => {

            const totalEncabezado = parseFloat(datosEncabezado.total_encabezado || 0);
            const totalPagado = parseFloat(datosEncabezado.total_pagado || 0); // lo que ya se pagó
            const tolerancia = totalEncabezado * 0.05;

            // Validar si ya se alcanzó o excedió el límite +5%
            if (totalPagado >= totalEncabezado + tolerancia) {
                toastMixin.fire({
                    icon: 'warning',
                    title: 'El pedido ya está pagado fuera del rango permitido (±5%). No se pueden agregar más comprobantes.'
                });
                return; // No mostrar el modal
            }

            // Limpiar comprobantes anteriores
            const contenedor = document.getElementById("contenedorComprobantes");
            contenedor.innerHTML = '';

            // Actualizar información en el modal
            actualizarInfoPagosModal();

            // Mostrar el modal
            const modal = new bootstrap.Modal(document.getElementById('modalComprobantes'));
            modal.show();
        });
    }


    function verificarEstadoPagos(idEncabezado) {
        return fetch(`/ProcesoComprasInternacional/VerificarPrecioReclasificacion?id_encabezado=${idEncabezado}`)
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    datosEncabezado = data.data;
                    console.log(datosEncabezado)
                    return data;
                } else {
                    throw new Error(data.message);
                }
            })
            .catch(error => {
                toastMixin.fire({
                    icon: 'error',
                    title: 'Error al obtener datos de pago: ' + error.message
                });
            });
    }

    function actualizarInfoPagosModal() {
        // Buscar o crear el contenedor de información
