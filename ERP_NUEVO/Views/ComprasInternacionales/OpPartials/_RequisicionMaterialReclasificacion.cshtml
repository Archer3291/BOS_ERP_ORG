}

function createSummarySection(totalGlobal) {
    const section = document.createElement('div');
    section.className = 'summary-section animate-fade-in-up';

    const totalFormatted = totalGlobal.toLocaleString('es-MX', {
        style: 'currency',
        currency: 'MXN',
