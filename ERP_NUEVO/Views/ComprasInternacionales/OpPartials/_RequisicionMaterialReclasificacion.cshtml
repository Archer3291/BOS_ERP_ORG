        </div>
    `;
}

function createArchivoDisplay(archivo) {
    if (!archivo) {
        return `
            <div class="archivo-display no-file">
                <div class="archivo-icon no-file-icon">
                    <i class="fas fa-file-excel"></i>
                </div>
                <div class="archivo-info">
                    <span class="archivo-status">Sin archivo adjunto</span>
                    <small class="archivo-note">No se ha cargado documentación</small>
                </div>
            </div>
        `;
    }

    const icono = getIconFile(archivo.extencion) || 'fa-file';
    return `
        <div class="archivo-display has-file">
            <div class="archivo-icon has-file-icon">
                <i class="fas ${icono}"></i>
            </div>
            <div class="archivo-info">
                <a href="/${archivo.path}" target="_blank" class="archivo-link">
                    <span class="archivo-name">${archivo.nombre_original}</span>
                    <i class="fas fa-external-link-alt ms-1"></i>
                </a>
                <small class="archivo-extension">.${archivo.extencion}</small>
            </div>
        </div>
    `;
}

function createPedimentosSection(partidasOC) {
    const section = document.createElement('div');
    section.className = 'content-section pedimentos-section';

    const pedimentosHTML = partidasOC.map((pedimento, index) => `
        <div class="pedimento-card animate-slide-in-right" style="animation-delay: ${index * 0.1}s">
            <div class="pedimento-icon-wrapper">
                <i class="fas fa-file-invoice-dollar"></i>
