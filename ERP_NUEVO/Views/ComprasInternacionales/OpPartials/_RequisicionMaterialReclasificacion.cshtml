<script src="~/lib/jquery/jquery.min.js"></script>
<script>
    let idEncabezadoSeleccionado = null;
    function setIdEncabezadoModal(btn) {
        idEncabezadoSeleccionado = btn.getAttribute("data-idencabezado");
    }
    document.addEventListener("DOMContentLoaded", function () {
        cargarTabla("#tablaRECLAS", "/ProcesoComprasInternacional/GetReclasificaciones");
    });

    function cargarTabla(selector, url) {
        const urlParams = new URLSearchParams(window.location.search);
        const id = urlParams.get('id');

        const tabla = $(selector).DataTable({
            destroy: true,
            responsive: true,
            autoWidth: false,
            ajax: {
                url: url,
                data: { id: id }, // Si necesitas pasarlo al backend
                dataSrc: "data"
            },
            columns: [
                { data: "nuevo_codigo" },
                {
                    data: "fch",
                    render: function (data, type, row) {
                        if (data && data.startsWith("/Date(")) {
                            const timestamp = parseInt(data.match(/\d+/)[0]);
                            const date = new Date(timestamp);
                            return date.toLocaleDateString('es-MX');
                        }
                        return "";
                    }
                },
                { data: "responsable" },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        if (meta.settings.nTable.id === "tablaOCDI" || meta.settings.nTable.id === "tablaRECLAS") {
                            return `$${parseFloat(data.imp_pendiente).toFixed(2)}`;
                        }
                        if (meta.settings.nTable.id === "tablaREQ") {
                            return `${(data.total_partidas)}`;
                        }
                        return "";
                    },
                },
                { data: "coment_aut" },
                {
                    data: null,
                    orderable: false,
                    render: function (data, type, row, meta) {
                        let botones = `` +
                            `<div class="d-flex gap-1" role="group">`;

                        if (meta.settings.nTable.id === "tablaRECLAS") {
                            botones += '' +
                                `   <button class="btn btn-sm green-500" style="color: var(--icon-color)" title="Adjuntar Documento" data-encabezado="${data.id_encabezado}" data-nvocodigo="${data.nuevo_codigo}" onclick="agregarComprobantes(this)">` +
                                `       <i class="fa-solid fa-plus-large"></i>` +
                                `   </button>` +
                                `   <button class="btn btn-sm sky-500" style="color: var(--icon-color)" title="Ver detalles" onclick="VerDetalleReclasificacion(${data.id_encabezado})">` +
                                `       <i class="fa-solid fa-circle-info"></i>` +
                                `   </button>`;

                            // 👇 validamos si el pendiente es <= 5% del total (a favor o en contra)
                            const pendiente = parseFloat(data.imp_pendiente || 0);
                            const total = parseFloat(data.imp || 0);
                            const margen = total * 0.05;

                            if (Math.abs(pendiente) <= margen) {
                                botones +=
                                    `   <button class="btn btn-sm amber-500" style="color: var(--icon-color)" title="Ajustar 5%" onclick="ajustarCincoPorciento(${data.id_encabezado})">` +
                                    `       <i class="fa-solid fa-scale-balanced"></i>` +
                                    `   </button>`;
                            }
                        }

                        botones += `</div>`;
                        return botones;
                    }
                },
                { data: "id_encabezado", visible: false, searchable: true }
            ],
        });

        // 👇 Espera a que la tabla esté completamente cargada y luego aplica la búsqueda
        if (id) {
            $(selector).on('xhr.dt', function () {
                tabla.search(id).draw();
            });
        }
    }

    const limpiarNumero = (str) => str.replace(/[^\d.]/g, '');
function VerDetalleReclasificacion(id) {
    GetData({
        path: '/ProcesoComprasInternacional/GetReclasificacionData',
        data: { id: id }
    }).then((_res) => {
        if (_res.success) {
            const body = document.getElementById('modalDetalles');
            body.innerHTML = ''; // Limpiar contenido previo

            const { partidas, archivos, partidasOC = [], requisicion } = _res.data;
            let totalGlobal = 0;

            // Crear estructura principal
            const mainContainer = createMainContainer();

            // Header con información general
            const headerSection = createHeaderSection(requisicion);
            mainContainer.appendChild(headerSection);

            // Renderizar partidas
            if (partidas && partidas.length > 0) {
                const partidasSection = createPartidasSection(partidas, archivos);
                totalGlobal = partidasSection.total;
                mainContainer.appendChild(partidasSection.element);
            }

            // Renderizar pedimentos si existen
            if (partidasOC.length > 0) {
                const pedimentosSection = createPedimentosSection(partidasOC);
                mainContainer.appendChild(pedimentosSection);
            }

            // Agregar resumen de totales (sin estadísticas)
            const summarySection = createSummarySection(totalGlobal);
            mainContainer.appendChild(summarySection);

            // Aplicar estilos mejorados
            addModernStyles();

            body.appendChild(mainContainer);

            // Configurar modal
            $('#modalAceptarCotizacion2').data('encabezado', id);
            $('#modalOpcionesLabel2').html(`
                <div class="modal-title-container">
                    <i class="fas fa-file-alt me-2"></i>
                    <span>Reclasificación No. ${requisicion.nuevo_codigo}</span>
                    <span class="badge bg-primary ms-2">${partidas.length} partidas</span>
                </div>
            `);
            $('#modalAceptarCotizacion2').modal('show');

        } else {
            showErrorToast(_res.message || 'Error al obtener la información.');
        }
    }).catch(error => {
        console.error('Error:', error);
        showErrorToast('Error de conexión. Por favor, intente nuevamente.');
    });
}

function createMainContainer() {
    const container = document.createElement('div');
    container.className = 'reclasificacion-wrapper';
    return container;
}

function createHeaderSection(requisicion) {
    const section = document.createElement('div');
    section.className = 'header-section animate-slide-down';

    section.innerHTML = `
        <div class="header-card">
            <div class="header-icon">
                <i class="fas fa-clipboard-check"></i>
            </div>
            <div class="header-content">
                <h4 class="header-title">Detalle de Reclasificación</h4>
                <p class="header-subtitle">Código: ${requisicion.nuevo_codigo}</p>
                <p class="header-subtitle">Proveedor: ${requisicion.n_prov}</p>
            </div>
        </div>
    `;

    return section;
}

function createPartidasSection(partidas, archivos) {
    const section = document.createElement('div');
    section.className = 'content-section partidas-section';

    let total = 0;
    const partidasHTML = partidas.map((partida, index) => {
        const importe = parseFloat(partida.imp_part) || 0;
        total += importe;

        const archivoRelacionado = archivos.find(a => a.partida_id == partida.id_partidas);
        return createPartidaHTML(partida, archivoRelacionado, index + 1, importe);
    }).join('');

    section.innerHTML = `
        <div class="section-header">
            <div class="section-title-group">
                <i class="fas fa-boxes section-icon"></i>
                <div>
                    <h5 class="section-title">Partidas del Producto</h5>
                    <p class="section-subtitle">${partidas.length} elementos registrados</p>
                </div>
            </div>
            <div class="section-actions">
                <button class="btn-toggle-view" onclick="togglePartidasView()" title="Cambiar vista">
                    <i class="fas fa-th-large"></i>
                </button>
            </div>
        </div>

        <div class="partidas-container" id="partidasContainer">
            ${partidasHTML}
        </div>
    `;

    return { element: section, total };
}

function createPartidaHTML(partida, archivo, numero, importe) {
    const archivoHTML = createArchivoDisplay(archivo);
    const importeFormatted = importe.toLocaleString('es-MX', {
        style: 'currency',
        currency: 'MXN',
        minimumFractionDigits: 2
    });

    return `
        <div class="partida-card animate-fade-in-up" style="animation-delay: ${numero * 0.1}s">
            <div class="partida-card-header">
                <div class="partida-number-badge">#${numero.toString().padStart(2, '0')}</div>
                <div class="partida-amount-display">
                    <span class="amount-label">Importe</span>
                    <span class="amount-value">${importeFormatted}</span>
                </div>
            </div>

            <div class="partida-card-body">
                <div class="partida-details-grid">
                    <div class="detail-item">
                        <div class="detail-icon">
                            <i class="fas fa-barcode"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">Código de Producto</span>
                            <span class="detail-value">${partida.cve_prod}</span>
                        </div>
                    </div>

                    <div class="detail-item full-width">
                        <div class="detail-icon">
                            <i class="fas fa-info-circle"></i>
                        </div>
                        <div class="detail-content">
                            <span class="detail-label">Descripción</span>
                            <span class="detail-value description-text">${partida.descr_prod}</span>
                        </div>
                    </div>
