                <strong class="text-success">✅ Total Pagado:</strong> $${parseFloat(datosEncabezado.total_pagado).toFixed(2)}
            </div>
        </div>
        <div class="row mt-2">
            <div class="col-md-6">
                <strong class="${clasePorcentaje}">⏳ Pendiente por Pagar:</strong> $${parseFloat(datosEncabezado.maximo_por_pagar).toFixed(2)}
            </div>
            <div class="col-md-6">
                <strong>📊 Progreso de Pago:</strong> 
                <span class="${clasePorcentaje}">${datosEncabezado.porcentaje_pagado}%</span>
