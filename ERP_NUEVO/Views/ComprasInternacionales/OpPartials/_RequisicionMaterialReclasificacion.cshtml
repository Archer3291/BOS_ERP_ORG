                <!-- Impuestos y derechos -->
                <optgroup label="Impuestos y derechos aduaneros">
                  <option value="aranceles">Aranceles (IGI)</option>
                  <option value="iva_importacion">IVA de Importación</option>
                  <option value="dta">Derecho de Trámite Aduanero (DTA)</option>
                  <option value="otros_impuestos">Otros impuestos específicos</option>
                </optgroup>

                <!-- Servicios aduanales -->
                <optgroup label="Servicios aduanales y regulatorios">
                  <option value="agente_aduanal">Honorarios del agente aduanal</option>
                  <option value="prevalidacion">Prevalidación de pedimento</option>
                  <option value="permisos">Permisos / NOM / COFEPRIS</option>
                  <option value="multas_rectificaciones">Multas o rectificaciones de pedimento</option>
                </optgroup>

                <!-- Transporte internacional -->
                <optgroup label="Transporte y logística internacional">
                  <option value="flete_internacional">Flete internacional (marítimo/aéreo/terrestre)</option>
                  <option value="seguro_internacional">Seguro de transporte internacional</option>
                  <option value="cargos_portuarios">Cargos portuarios (THC)</option>
                  <option value="maniobras_puerto">Maniobras en puerto / aeropuerto</option>
                  <option value="demoras_almacenajes">Demoras y almacenajes en puerto</option>
                </optgroup>

                <!-- Transporte nacional -->
                <optgroup label="Transporte y logística nacional">
                  <option value="flete_nacional">Flete nacional</option>
                  <option value="maniobras_aduana">Maniobras en aduana</option>
                  <option value="custodia">Custodia y seguridad</option>
                  <option value="cargas_descargas">Cargas y descargas en almacén</option>
                </optgroup>

                <!-- Almacenaje -->
                <optgroup label="Almacenaje y manejo de mercancías">
                  <option value="almacenaje">Almacenaje en recinto fiscalizado</option>
                  <option value="maniobras">Maniobras de carga y descarga</option>
                  <option value="embalajes">Tarimas / embalajes adicionales</option>
                  <option value="cross_docking">Cross-docking</option>
                </optgroup>

                <!-- Financieros -->
                <optgroup label="Servicios bancarios y financieros">
                  <option value="comisiones_bancarias">Comisiones bancarias (transferencias, SWIFT)</option>
                  <option value="cartas_credito">Cartas de crédito / cobranza documentaria</option>
                  <option value="tipo_cambio">Diferencias por tipo de cambio</option>
                </optgroup>

                <!-- Otros -->
                <optgroup label="Otros gastos">
                  <option value="inspecciones">Inspecciones (SENASICA, fitosanitarias, sanitarias)</option>
                  <option value="certificados_origen">Certificados de origen / legalización</option>
                  <option value="gestoria">Gastos de gestoría / notariales</option>
                  <option value="seguros_adicionales">Seguros adicionales (almacenaje, RC)</option>
                </optgroup>
            </select>

        </div>

        <div class="form-group">
            <label class="form-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                </svg>
                Descripción
            </label>
            <input type="text" name="titulo[]" class="form-input" placeholder="Ej. Factura, Nota, Comprobante">
        </div>

        <div class="form-group">
            <label class="form-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <line x1="12" y1="1" x2="12" y2="23"/>
                    <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/>
                </svg>
                Importe
            </label>
            <div class="input-with-prefix">
                <span class="input-prefix">$</span>
                <input type="number" 
                       name="importe[]" 
                       class="form-input importe-input lock-min lock-max" 
                       min="0"                       
                       step="0.01"
                       placeholder="0.00"
                       onblur="validarImporte(this)">
            </div>
            <small class="text-muted">Máximo disponible: $${parseFloat(datosEncabezado.maximo_por_pagar).toFixed(2)}</small>
        </div>

        <div class="form-group">
            <label class="form-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                    <line x1="16" y1="13" x2="8" y2="13"/>
                    <line x1="16" y1="17" x2="8" y2="17"/>
                </svg>
                Archivo
            </label>
            <div class="file-input-wrapper">
                <input type="file" name="archivo[]" class="file-input" accept="application/pdf" id="archivo_${Date.now()}">
                <label for="archivo_${Date.now()}" class="file-input-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7,10 12,15 17,10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Seleccionar archivo
                </label>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                </svg>
                XML (opcional)
            </label>
            <div class="file-input-wrapper">
                <input type="file" name="xml[]" class="file-input xml-input" accept=".xml" id="xml_${Date.now()}">
                <label for="xml_${Date.now()}" class="file-input-label xml-label">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7,10 12,15 17,10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                    Seleccionar XML
                </label>
            </div>
        </div>
    </div>
    `;

        wrapper.innerHTML = html;
        contenedor.appendChild(wrapper);

        setTimeout(() => {
            wrapper.classList.add('comprobante-card-visible');
        }, 10);

        configurarEventosArchivo(wrapper);

        // Actualizar atributo max de input importe para este comprobante
        const importeInput = wrapper.querySelector('input[name="importe[]"]');
        importeInput.max = maxPermitido.toFixed(2);
        importeInput.addEventListener('blur', () => validarImporte(importeInput));
    }

    function validarImporte(input) {
        const valor = parseFloat(input.value) || 0;
        const totalEncabezado = parseFloat(datosEncabezado.total_encabezado || 0);
        const totalPagado = parseFloat(datosEncabezado.total_pagado || 0);
        const tolerancia = totalEncabezado * 0.05;

        // Total acumulado si se guarda este comprobante
        const totalAcumulado = totalPagado + valor;

        if (totalAcumulado > totalEncabezado + tolerancia) {
            toastMixin.fire({
                icon: 'error',
                title: `El importe no puede exceder el 105% del total del pedido ($${(totalEncabezado + tolerancia).toFixed(2)})`
            });
            input.value = (totalEncabezado + tolerancia - totalPagado).toFixed(2);
            return;
        } else if (totalAcumulado < totalEncabezado - tolerancia) {
            toastMixin.fire({
                icon: 'warning',
                title: `El total acumulado ($${totalAcumulado.toFixed(2)}) está por debajo del 95% del total del pedido, se permitirá guardar.`
            });
        }
    }

    function configurarEventosArchivo(wrapper) {
        // Evento para archivo PDF
        const fileInput = wrapper.querySelector('.file-input:not(.xml-input)');
        const fileLabel = wrapper.querySelector('.file-input-label:not(.xml-label)');

        fileInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                if (this.files[0].type !== 'application/pdf') {
                    toastMixin.fire({
                        icon: 'error',
                        title: 'Solo se permiten archivos PDF.'
                    });
                    this.value = '';
                    fileLabel.innerHTML = 'Seleccionar archivo';
                    fileLabel.classList.remove('file-selected');
                    return;
                }

                fileLabel.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                </svg>
                ${this.files[0].name}
            `;
                fileLabel.classList.add('file-selected');
            }
        });

        // Evento para archivo XML
        const xmlInput = wrapper.querySelector('.xml-input');
        const xmlLabel = wrapper.querySelector('.xml-label');

        xmlInput.addEventListener('change', function () {
            if (this.files && this.files[0]) {
                if (!this.files[0].name.endsWith('.xml')) {
                    toastMixin.fire({
                        icon: 'error',
                        title: 'Solo se permiten archivos XML.'
                    });
                    this.value = '';
                    xmlLabel.innerHTML = 'Seleccionar XML';
                    xmlLabel.classList.remove('file-selected');
                    return;
                }

                // Mostrar nombre del archivo seleccionado
                xmlLabel.innerHTML = `
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                    <polyline points="14,2 14,8 20,8"/>
                </svg>
                ${this.files[0].name}
            `;
                xmlLabel.classList.add('file-selected');

                // Procesar el XML para extraer el total
                procesarXMLYLlenarCampos(this.files[0], wrapper);
            }
        });
    }

    function procesarXMLYLlenarCampos(xmlFile, wrapper) {
        const formData = new FormData();
        formData.append('xmlFile', xmlFile);

        // Agregar token antiforgery si existe
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            formData.append("__RequestVerificationToken", token.value);
        }

        // Mostrar indicador de carga en el campo de importe
        const importeInput = wrapper.querySelector('input[name="importe[]"]');
        const originalPlaceholder = importeInput.placeholder;
        importeInput.placeholder = "Procesando XML...";
        importeInput.disabled = true;

        fetch('/ProcesoComprasInternacional/ProcesarXML', {
            method: 'POST',
            body: formData
        })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const xmlData = data.data;
                    // Llenar el campo de importe con el total del XML
                    if (xmlData.Total) {
                        const totalXML = parseFloat(xmlData.Total);

                        // Validar que no exceda el saldo pendiente
                        if (totalXML > datosEncabezado.maximo_por_pagar) {
                            toastMixin.fire({
                                icon: 'warning',
                                title: `El total del XML (${totalXML.toFixed(2)}) excede el saldo pendiente (${datosEncabezado.maximo_por_pagar.toFixed(2)}). Se ajustará al máximo permitido.`
                            });
                            importeInput.value = datosEncabezado.maximo_por_pagar.toFixed(2);

                        } else {
                            $(importeInput).val(totalXML.toFixed(2)).trigger('input');
                        }
                    }

                    // Opcional: Llenar otros campos si es necesario
                    const tituloInput = wrapper.querySelector('input[name="titulo[]"]');
                    if (tituloInput && !tituloInput.value.trim()) {
                        let titulo = '';
                        if (xmlData.Serie && xmlData.Folio) {
                            titulo = `${xmlData.Serie}-${xmlData.Folio}`;
                        } else if (xmlData.Folio) {
                            titulo = `Factura ${xmlData.Folio}`;
                        } else {
                            titulo = `Factura ${xmlData.EmisorRFC || 'XML'}`;
                        }
                        tituloInput.value = titulo;
                    }

                    // Mostrar información adicional del XML
                    mostrarInfoXML(xmlData, wrapper);

                    //toastMixin.fire({
                    //    icon: 'success',
                    //    title: 'XML procesado correctamente. Campos actualizados.'
                    //});

                } else {
                    toastMixin.fire({
                        icon: 'error',
                        title: data.message || 'Error al procesar el XML'
                    });
                }
            })
            .catch(error => {
                console.error('Error:', error);
                toastMixin.fire({
                    icon: 'error',
                    title: 'Error de conexión al procesar el XML'
                });
            })
            .finally(() => {
                // Restaurar el campo de importe
                importeInput.placeholder = originalPlaceholder;
                importeInput.disabled = false;
            });
    }

    function mostrarInfoXML(xmlData, wrapper) {
        // Buscar o crear contenedor para mostrar información del XML
        let infoXML = wrapper.querySelector('.xml-info');
        if (!infoXML) {
            infoXML = document.createElement('div');
            infoXML.className = 'xml-info alert alert-info mt-2';

            // Insertarlo después del grupo del XML
            const xmlGroup = wrapper.querySelector('.form-group:last-child');
            xmlGroup.appendChild(infoXML);
        }

        infoXML.innerHTML = `
        <small>
            <strong>📄 Datos del XML:</strong><br>
            ${xmlData.EmisorRFC ? `<strong>RFC Emisor:</strong> ${xmlData.EmisorRFC}<br>` : ''}
            ${xmlData.EmisorNombre ? `<strong>Emisor:</strong> ${xmlData.EmisorNombre}<br>` : ''}
            ${xmlData.Fecha ? `<strong>Fecha:</strong> ${xmlData.Fecha}<br>` : ''}
            ${xmlData.Moneda ? `<strong>Moneda:</strong> ${xmlData.Moneda}` : ''}
            ${xmlData.TipoCambio && xmlData.TipoCambio !== '1' ? ` (TC: ${xmlData.TipoCambio})` : ''}
        </small>
    `;
    }


    function eliminarComprobante(button) {
        const wrapper = button.closest('.comprobante-card');
        wrapper.classList.add('comprobante-card-removing');

        setTimeout(() => {
            wrapper.remove();
        }, 300);
    }
    function enviarComprobantes() {
        const formData = new FormData();
        let valid = true;
        let totalComprobantes = 0;

        // Obtener token antiforgery
        const token = document.querySelector('input[name="__RequestVerificationToken"]');
        if (token) {
            formData.append("__RequestVerificationToken", token.value);
        }

        // Agregar encabezado
        formData.append("id_encabezado", idEncabezadoSeleccionado);

        // Obtener todos los comprobantes
        const comprobantes = document.querySelectorAll(".comprobante-card");
        if (comprobantes.length === 0) {
            toastMixin.fire({
                icon: 'error',
                title: 'Debes agregar al menos un comprobante.'
            });
            return;
        }

        // Recorrer cada comprobante y validar
        comprobantes.forEach((card, index) => {
            const tituloInput = card.querySelector('input[name="titulo[]"]');
            const gastoInput = card.querySelector('select[name="clave_pago[]"]');
            const importeInput = card.querySelector('input[name="importe[]"]');
            const archivoInput = card.querySelector('input[name="archivo[]"]');
            const xmlInput = card.querySelector('input[name="xml[]"]');

            const titulo = tituloInput?.value.trim();
            const gasto = gastoInput.options[gastoInput.selectedIndex]?.text.trim();
            const importe = parseFloat(importeInput?.value.trim());
            const archivo = archivoInput?.files[0];
            const xmlArchivo = xmlInput?.files[0];

            // Validaciones individuales
            if (!titulo) {
                toastMixin.fire({
                    icon: 'error',
                    title: `El título del comprobante ${index + 1} es obligatorio.`
                });
                valid = false;
                return;
            }

            if (!importe || isNaN(importe) || importe <= 0) {
                toastMixin.fire({
                    icon: 'error',
                    title: `El importe del comprobante ${index + 1} debe ser un número mayor a 0.`
                });
                valid = false;
                return;
            }

            if (!archivo) {
                toastMixin.fire({
                    icon: 'error',
                    title: `Debes seleccionar un archivo PDF para el comprobante ${index + 1}.`
                });
                valid = false;
                return;
            }

            if (archivo.type !== 'application/pdf') {
                toastMixin.fire({
                    icon: 'error',
                    title: `El archivo del comprobante ${index + 1} debe ser un PDF.`
                });
                valid = false;
                return;
            }

            // Sumar al total de comprobantes nuevos
            totalComprobantes += importe;

            // Agregar al FormData
            formData.append(`comprobantes[${index}]_titulo`, titulo);
            formData.append(`comprobantes[${index}]_gasto`, gasto);
            formData.append(`comprobantes[${index}]_importe`, importe);
            formData.append(`comprobantes[${index}]_archivo`, archivo);
            if (xmlArchivo) {
                formData.append(`comprobantes[${index}]_xml`, xmlArchivo);
            }
        });

        if (!valid) return;

        // Validar considerando lo ya pagado
        const totalEncabezado = parseFloat(datosEncabezado.total_encabezado || 0);
        const totalPagado = parseFloat(datosEncabezado.total_pagado || 0);
        const tolerancia = totalEncabezado * 0.05;
        const totalAcumulado = totalPagado + totalComprobantes;

        if (totalAcumulado > (totalEncabezado + tolerancia)) {
            toastMixin.fire({
                icon: 'error',
                title: `El total acumulado ($${totalAcumulado.toFixed(2)}) excede en más del 5% el total del pedido ($${totalEncabezado.toFixed(2)}).`
            });
            return;
        } else if (totalAcumulado < (totalEncabezado - tolerancia)) {
            toastMixin.fire({
                icon: 'warning',
                title: `El total acumulado ($${totalAcumulado.toFixed(2)}) es menor al total del pedido ($${totalEncabezado.toFixed(2)}), pero se guardará.`
            });
        }

        // Enviar datos
        fetch('/ProcesoComprasInternacional/GuardarComprobantes', {
            method: 'POST',
            body: formData
        })
            .then(res => res.json())
            .then(res => {
                if (res.success) {
                    toastMixin.fire({
                        icon: 'success',
                        title: 'Comprobantes guardados correctamente.'
                    });
                    bootstrap.Modal.getInstance(document.getElementById('modalComprobantes')).hide();
                    location.reload();
                } else {
                    toastMixin.fire({
                        icon: 'error',
                        title: res.message || 'Ocurrió un error al guardar.'
                    });
                }
            })
            .catch(err => {
                console.error(err);
                toastMixin.fire({
                    icon: 'error',
                    title: 'No se pudo enviar la solicitud.'
                });
            });
    }


</script>