@using BOS_ERP.Controllers

@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@{
    ViewBag.Reclasificacion = false;
}

<link href="~/content/Site.css" rel="stylesheet" />
@{

    ViewBag.PageTitle = "Gestion de solicitudes";

    var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS");
    var area = Utilities.GetAreaName(User.Identity.Name);

    if (role == "Director")
    {
        <div class="tab-pane fade show active" id="tickets" role="tabpanel">
            @Html.Partial("OpPartials/_RequisicionMaterialDirectorInternacional")
        </div>
    }

    else if (area == "Compras Nacionales" && role == "Gerente")
    {
        <div class="tab-pane fade show active" id="tickets" role="tabpanel">
            @Html.Partial("OpPartials/_RequisicionMaterialComprasInternacional")
        </div>
    }
    else if (role == "Sistemas" || role == "Super Administrador")
    {
        <p>Proceso Director</p>
        <hr />
        <div class="tab-pane fade show active" id="tickets" role="tabpanel">
            @Html.Partial("OpPartials/_RequisicionMaterialDirectorInternacional")
        </div>

        <p>Proceso Gerente</p>
        <hr />
        <div class="tab-pane fade show active" id="tickets" role="tabpanel">
            @Html.Partial("OpPartials/_RequisicionMaterialComprasInternacional")
        </div>
    }
}
