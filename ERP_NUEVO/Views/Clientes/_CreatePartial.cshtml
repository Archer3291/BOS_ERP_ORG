@model BOS_ERP.Models.Cliente

@using (Html.BeginForm(null, null, FormMethod.Post, new { id = "createClienteForm" }))
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-sm-6 mb-3">            
            <div class="form-outline" data-mdb-input-init>
                <i class="fas fa-solid fa-clipboard trailing"></i>
                @Html.EditorFor(model => model.Cedula, new { htmlAttributes = new { @class = "form-control form-icon-trailing" } })
                <label class="form-label" for="form1">Ingresar Cédula</label>
                @Html.ValidationMessageFor(model => model.Cedula, "", new { @class = "text-danger" })                
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">            
            <div class="form-outline" data-mdb-input-init>
                <i class="fas fa-solid fa-user trailing"></i>
                @Html.EditorFor(model => model.Nombre, new { htmlAttributes = new { @class = "form-control form-icon-trailing" } })
                <label class="form-label" for="form1">Ingresar Nombre</label>
                @Html.ValidationMessageFor(model => model.Nombre, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-sm-6 mb-3">           
            <div class="form-outline" data-mdb-input-init>
                <i class="fas fa-solid fa-user trailing"></i>
                @Html.EditorFor(model => model.Apellido, new { htmlAttributes = new { @class = "form-control form-icon-trailing" } })
                <label class="form-label" for="form1">Ingresar Apellido</label>
                @Html.ValidationMessageFor(model => model.Apellido, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-12 mb-3">            
            <div class="form-outline" data-mdb-input-init>
                @*<i class="fas fa-solid fa-map-location-dot"></i>*@
                @Html.TextAreaFor(model => model.Direccion, new { @class = "form-control", rows = 3 })
                <label class="form-label" for="form1">Ingresar Dirección</label>
                @Html.ValidationMessageFor(model => model.Direccion, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-sm-6 mb-3">            
            <div class="form-outline" data-mdb-input-init>
                <i class="fas fa-solid fa-phone trailing"></i>
                @Html.EditorFor(model => model.Telefono, new { htmlAttributes = new { @class = "form-control form-icon-trailing", type = "tel" } })
                <label class="form-label" for="form1">Ingresar Teléfono</label>
                @Html.ValidationMessageFor(model => model.Telefono, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-sm-6 mb-3">           
            <div class="form-outline" data-mdb-input-init>
                <i class="fas fa-solid fa-envelope trailing"></i>
                @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control form-icon-trailing", type = "email" } })
                <label class="form-label" for="form1">Ingresar Email</label>
                @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>
 }
