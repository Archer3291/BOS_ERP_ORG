@model BOS_ERP.Models.AlertaFraccionEmailModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Alerta Fracción Arancelaria</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background: #f4f6f8;
            font-family: Arial, Helvetica, sans-serif;
            color: #333;
        }

        .wrapper {
            max-width: 680px;
            margin: 30px auto;
            background: #ffffff;
            border-radius: 8px;
            overflow: hidden;
            box-shadow: 0 2px 8px rgba(0,0,0,.12);
        }
        /* ── Header ── */
        .header {
            background: #b45309;
            padding: 28px 32px;
        }

            .header h1 {
                margin: 0;
                color: #fff;
                font-size: 20px;
            }

            .header p {
                margin: 6px 0 0;
                color: #fde68a;
                font-size: 13px;
            }
        /* ── Badge de alerta ── */
        .alert-badge {
            background: #fef3c7;
            border-left: 4px solid #d97706;
            padding: 14px 20px;
            margin: 24px 32px 0;
            border-radius: 4px;
            font-size: 14px;
        }

            .alert-badge strong {
                color: #92400e;
            }
        /* ── Datos del folio ── */
        .meta {
            padding: 20px 32px 0;
            display: flex;
            gap: 24px;
            flex-wrap: wrap;
        }

        .meta-item {
            flex: 1;
            min-width: 180px;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 6px;
            padding: 12px 16px;
        }

            .meta-item .label {
                font-size: 11px;
                color: #6b7280;
                text-transform: uppercase;
                letter-spacing: .5px;
                margin-bottom: 4px;
            }

            .meta-item .value {
                font-size: 14px;
                font-weight: 600;
                color: #111;
            }
        /* ── Sección ── */
        .section {
            padding: 24px 32px 0;
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: #6b7280;
            text-transform: uppercase;
            letter-spacing: .6px;
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 8px;
            margin-bottom: 16px;
        }
        /* ── Tabla ── */
        table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

        thead th {
            background: #92400e;
            color: #fff;
            padding: 10px 14px;
            text-align: left;
            font-weight: 600;
        }

        tbody tr:nth-child(even) {
            background: #fef9f0;
        }

        tbody td {
            padding: 10px 14px;
            border-bottom: 1px solid #e5e7eb;
            vertical-align: top;
        }

        .badge-sin {
            display: inline-block;
            background: #fee2e2;
            color: #991b1b;
            font-size: 11px;
            font-weight: 700;
            padding: 2px 8px;
            border-radius: 12px;
            white-space: nowrap;
        }
        /* ── Footer ── */
        .footer {
            padding: 24px 32px;
            background: #f9fafb;
            border-top: 1px solid #e5e7eb;
            margin-top: 28px;
            font-size: 12px;
            color: #9ca3af;
            text-align: center;
        }
    </style>
</head>
<body>
    <div class="wrapper">

        <!-- Header -->
        <div class="header">
            <h1>⚠ Alerta — Fracciones Arancelarias faltantes</h1>
            <p>Este correo fue generado automáticamente por el sistema ERP</p>
        </div>

        <!-- Badge -->
        <div class="alert-badge">
            <strong>Acción requerida:</strong>
            Se detectaron <strong>@Model.ProductosSinFraccion.Count producto(s)</strong>
            sin fracción arancelaria registrada.
            Es necesario configurarlos antes de continuar con el proceso de facturación.
        </div>

        <!-- Meta: folio / cliente / usuario / fecha -->
        <div class="meta">
            <div class="meta-item">
                <div class="label">Folio</div>
                <div class="value">@Model.Folio</div>
            </div>
            <div class="meta-item">
                <div class="label">Cliente</div>
                <div class="value">@Model.Cliente</div>
            </div>
            <div class="meta-item">
                <div class="label">Validado por</div>
                <div class="value">@Model.UsuarioQueValido</div>
            </div>
            <div class="meta-item">
                <div class="label">Fecha</div>
                <div class="value">@Model.FechaValidacion</div>
            </div>
        </div>

        <!-- Tabla de productos sin fracción -->
        <div class="section">
            <div class="section-title">Productos sin fracción arancelaria</div>
            <table>
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Clave producto</th>
                        <th>Descripción</th>
                        <th>Estado</th>
                    </tr>
                </thead>
                <tbody>
                    @for (int i = 0; i < Model.ProductosSinFraccion.Count; i++)
                    {
                        var prod = Model.ProductosSinFraccion[i];
                        <tr>
                            <td>@(i + 1)</td>
                            <td><strong>@prod.ProductoId</strong></td>
                            <td>@prod.Descripcion</td>
                            <td><span class="badge-sin">Sin fracción</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- Footer -->
        <div class="footer">
            Este mensaje fue enviado el @Model.FechaValidacion por @Model.UsuarioQueValido.<br />
            Por favor no responda este correo directamente — es una notificación automática del sistema ERP.
        </div>

    </div>
</body>
</html>