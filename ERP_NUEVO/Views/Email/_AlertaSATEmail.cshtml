@model BOS_ERP.Models.AlertaSATEmailModel
@{
    Layout = null;
}


<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:Segoe UI,Arial,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0"
           style="background:#f1f5f9;padding:32px 0;">
        <tr>
            <td align="center">
                <table width="620" cellpadding="0" cellspacing="0"
                       style="background:#ffffff;border-radius:16px;overflow:hidden;
                    box-shadow:0 4px 24px rgba(0,0,0,0.08);">

                    <!-- ═══ HEADER ═══ -->
                    <tr>
                        <td style="background:linear-gradient(135deg,#1e3a5f 0%,#2563eb 100%);
                     padding:32px 36px;">
                            <div style="background:rgba(255,255,255,0.15);display:inline-block;
                        padding:6px 14px;border-radius:20px;margin-bottom:12px;">
                                <span style="color:#fbbf24;font-weight:700;font-size:12px;
                           letter-spacing:1px;">⚠ ALERTA DE VALIDACIÓN SAT</span>
                            </div>
                            <h1 style="margin:0;color:#ffffff;font-size:22px;
                       font-weight:700;line-height:1.3;">
                                Productos sin configuración SAT
                            </h1>
                            <p style="margin:8px 0 0 0;color:rgba(255,255,255,0.75);font-size:14px;">
                                Se detectaron
                                <strong style="color:#fbbf24;">@Model.ProductosInvalidos.Count</strong>
                                producto(s) con datos incompletos que impiden el timbrado
                            </p>
                        </td>
                    </tr>

                    <!-- ═══ DATOS DEL DOCUMENTO ═══ -->
                    <tr>
                        <td style="padding:24px 36px 0;">
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="background:#f8fafc;border-radius:10px;
                          border:1px solid #e2e8f0;">
                                <tr>
                                    <td style="padding:14px 18px;border-right:1px solid #e2e8f0;width:25%;">
                                        <div style="color:#64748b;font-size:11px;font-weight:600;
                              text-transform:uppercase;letter-spacing:0.5px;
                              margin-bottom:4px;">Folio</div>
                                        <div style="color:#1e293b;font-size:15px;font-weight:700;">
                                            @Model.Folio
                                        </div>
                                    </td>
                                    <td style="padding:14px 18px;border-right:1px solid #e2e8f0;width:35%;">
                                        <div style="color:#64748b;font-size:11px;font-weight:600;
                              text-transform:uppercase;letter-spacing:0.5px;
                              margin-bottom:4px;">Cliente</div>
                                        <div style="color:#1e293b;font-size:14px;font-weight:600;">
                                            @Model.Cliente
                                        </div>
                                    </td>
                                    <td style="padding:14px 18px;border-right:1px solid #e2e8f0;width:25%;">
                                        <div style="color:#64748b;font-size:11px;font-weight:600;
                              text-transform:uppercase;letter-spacing:0.5px;
                              margin-bottom:4px;">Generado por</div>
                                        <div style="color:#1e293b;font-size:14px;font-weight:600;">
                                            @Model.UsuarioQueValido
                                        </div>
                                    </td>
                                    <td style="padding:14px 18px;width:15%;">
                                        <div style="color:#64748b;font-size:11px;font-weight:600;
                              text-transform:uppercase;letter-spacing:0.5px;
                              margin-bottom:4px;">Fecha</div>
                                        <div style="color:#1e293b;font-size:14px;font-weight:600;">
                                            @Model.FechaValidacion
                                        </div>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- ═══ TABLA DE PRODUCTOS ═══ -->
                    <tr>
                        <td style="padding:24px 36px;">
                            <h2 style="margin:0 0 14px;color:#1e293b;font-size:16px;font-weight:700;">
                                Detalle de productos con errores
                            </h2>
                            <table width="100%" cellpadding="0" cellspacing="0"
                                   style="border:1px solid #e2e8f0;border-radius:10px;overflow:hidden;">
                                <thead>
                                    <tr style="background:#f8fafc;">
                                        <th style="padding:10px 14px;text-align:left;font-size:11px;
                             color:#64748b;font-weight:700;text-transform:uppercase;
                             letter-spacing:0.5px;border-bottom:2px solid #e2e8f0;
                             width:20%;">Clave</th>
                                        <th style="padding:10px 14px;text-align:left;font-size:11px;
                             color:#64748b;font-weight:700;text-transform:uppercase;
                             letter-spacing:0.5px;border-bottom:2px solid #e2e8f0;
                             width:35%;">Descripción</th>
                                        <th style="padding:10px 14px;text-align:left;font-size:11px;
                             color:#64748b;font-weight:700;text-transform:uppercase;
                             letter-spacing:0.5px;border-bottom:2px solid #e2e8f0;">
                                            Datos faltantes
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var prod in Model.ProductosInvalidos)
                                    {
                                        <tr>
                                            <td style="padding:10px 14px;font-weight:600;color:#1e293b;
                               font-size:13px;border-bottom:1px solid #f1f5f9;
                               font-family:monospace;">
                                                @prod.ProductoId
                                            </td>
                                            <td style="padding:10px 14px;color:#475569;font-size:13px;
                               border-bottom:1px solid #f1f5f9;">
                                                @prod.Descripcion
                                            </td>
                                            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;">
                                                @foreach (var campo in prod.CamposFaltantes)
                                                {
                                                    <span style="display:inline-block;background:#fef2f2;
                                     color:#dc2626;padding:2px 8px;border-radius:20px;
                                     font-size:11px;font-weight:600;margin:2px 2px 2px 0;">
                                                        ⚠ @campo
                                                    </span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </td>
                    </tr>

                    <!-- ═══ AVISO DE ACCIÓN ═══ -->
                    <tr>
                        <td style="padding:0 36px 24px;">
                            <div style="background:#fffbeb;border:1.5px solid #fde68a;
                        border-radius:10px;padding:16px 20px;">
                                <p style="margin:0 0 8px;color:#92400e;font-size:13px;
                        font-weight:700;">💡 Acción requerida</p>
                                <p style="margin:0;color:#92400e;font-size:13px;line-height:1.7;">
                                    Los productos listados <strong>no podrán ser timbrados</strong>
                                    hasta que se configure su relación SAT. Actualiza los siguientes
                                    campos en el catálogo de relaciones:
                                </p>
                                <ul style="margin:8px 0 0;padding-left:20px;
                         color:#92400e;font-size:13px;line-height:1.8;">
                                    <li><strong>prod_sat</strong> — Clave del producto/servicio SAT</li>
                                    <li><strong>ud_sat</strong> — Unidad de medida SAT</li>
                                    <li><strong>obj_impto</strong> — Objeto de impuesto</li>
                                </ul>
                            </div>
                        </td>
                    </tr>

                    <!-- ═══ FOOTER ═══ -->
                    <tr>
                        <td style="background:#f8fafc;padding:20px 36px;
                     border-top:1px solid #e2e8f0;">
                            <p style="margin:0;color:#94a3b8;font-size:12px;text-align:center;">
                                Generado automáticamente por el
                                <strong>Sistema de Facturación</strong> · @Model.FechaValidacion
                            </p>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>