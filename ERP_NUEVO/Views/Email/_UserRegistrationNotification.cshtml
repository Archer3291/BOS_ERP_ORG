@model BOS_ERP.Models.UserRegistrationEmailModel

@{
    Layout = null;
}

<table width='100%' cellpadding='0' cellspacing='0' style='font-family: Arial, sans-serif; background-color: #f4f4f4; padding: 20px;'>
    <tr>
        <td align='center'>
            <table width='600' cellpadding='0' cellspacing='0' style='background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.1);'>
                <tr style='background-color: #004080; color: #ffffff;'>
                    <td style='padding: 20px; text-align: center;'>
                        <span style='font-size: 22px;'>Nuevo registro de usuario</span>
                    </td>
                </tr>
                <tr>
                    <td style='padding: 30px;'>
                        <p style='font-size: 16px; color: #333;'>Hola,</p>
                        <p style='font-size: 16px; color: #333;'>Se ha registrado un nuevo usuario con los siguientes datos:</p>
                        <table width='100%' cellpadding='5' cellspacing='0' style='font-size: 15px; color: #555;'>
                            <tr>
                                <td style='font-weight: bold; width: 150px;'>👤 Usuario:</td>
                                <td>@Model.NombreUsuario</td>
                            </tr>
                            <tr>
                                <td style='font-weight: bold;'>📛 Nombre:</td>
                                <td>@Model.Nombre @Model.Apellido</td>
                            </tr>
                            <tr>
                                <td style='font-weight: bold;'>📧 Correo:</td>
                                <td>@Model.Email</td>
                            </tr>
                            <tr>
                                <td style='font-weight: bold;'>🏢 Empresa:</td>
                                <td>@Model.EmpresaNombre</td>
                            </tr>
                            <tr>
                                <td style='font-weight: bold;'>🔐 Rol:</td>
                                <td>@Model.RolNombre</td>
                            </tr>
                        </table>

                        <table cellpadding='0' cellspacing='0' border='0' align='center' style='margin: 30px auto 0 auto;'>
                            <tr bgcolor='#28a745'>
                                <td style='background-color: #28a745; border-radius: 5px; text-align: center;'>
                                    <a href='@Model.UrlActivacion'
                                       style='display: inline-block; padding: 12px 24px; color: #ffffff; font-size: 16px;
                                              text-decoration: none; font-weight: bold; font-family: Arial, sans-serif;'>
                                        ✅ Activar usuario
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style='margin-top: 30px; font-size: 14px; color: #888;'>Este correo es solo para fines de notificación.</p>
                    </td>
                </tr>
                <tr style='background-color: #f0f0f0;'>
                    <td style='padding: 20px; text-align: center; font-size: 12px; color: #999;'>
                        © @Model.CurrentYear Sellos y Retenes. Todos los derechos reservados.
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>