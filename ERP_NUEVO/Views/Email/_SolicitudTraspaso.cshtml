@model BOS_ERP.Models.TraspasoEmailViewModel
@{
    Layout = null;
}
<!-- ~/Views/Email/_SolicitudTraspaso.cshtml -->


<div style='font-family:Arial,sans-serif;max-width:600px;margin:0 auto;'>
    <div style='background:#1e3a5f;color:white;padding:20px;border-radius:8px 8px 0 0;'>
        <h2 style='margin:0;'>📦 Solicitud de Traspaso de Material</h2>
    </div>
    <div style='padding:20px;background:#f8fafc;border:1px solid #e2e8f0;'>
        <p>
            Se ha generado una solicitud de traspaso automática a partir de la cotización
            <strong>@Model.FolioCotizacion</strong>.
        </p>

        <table style='width:100%;border-collapse:collapse;margin:16px 0;'>
            <tr style='background:#1e3a5f;color:white;'>
                <th style='padding:10px;text-align:left;'>Artículo</th>
                <th style='padding:10px;text-align:left;'>Descripción</th>
                <th style='padding:10px;text-align:center;'>Cantidad faltante</th>
            </tr>
            @foreach (var p in Model.Productos)
            {
                <tr>
                    <td style='padding:8px;border:1px solid #e2e8f0;'>@p.ProductoId</td>
                    <td style='padding:8px;border:1px solid #e2e8f0;'>@p.Descripcion</td>
                    <td style='padding:8px;border:1px solid #e2e8f0;text-align:center;'>@p.Faltante</td>
                </tr>
            }
        </table>

        <p><strong>Folio de traspaso:</strong> @Model.FolioTraspaso</p>
        <p><strong>Sucursal destino:</strong> @Model.SucursalDestino</p>

        <p style='color:#64748b;font-size:12px;margin-top:20px;'>
            Este mensaje fue generado automáticamente. Por favor, coordine el envío del material a la brevedad.
        </p>
    </div>
</div>