@model BOS_ERP.Models.SolicitudCreditoEmailModel
@{
    Layout = null;
    string fmt(decimal v) => v.ToString("C", new System.Globalization.CultureInfo("es-MX"));
    decimal porcentajeUsado = Model.Limite > 0 ? Math.Min((Model.Usado / Model.Limite) * 100, 100) : 0;
    string barColor = porcentajeUsado >= 90 ? "#dc2626" : porcentajeUsado >= 70 ? "#f59e0b" : "#16a34a";
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de Autorización de Crédito — @Model.Folio</title>
</head>
<body style="margin:0;padding:0;background-color:#f3f4f6;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">

    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f3f4f6;padding:32px 16px;">
        <tr>
            <td align="center">
                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:620px;">

                    <!-- HEADER -->
                    <tr>
                        <td style="background-color:#ffffff;border:1px solid #e5e7eb;border-radius:12px 12px 0 0;padding:24px 28px;">
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td width="52" valign="middle">
                                        <div style="width:44px;height:44px;border-radius:10px;background-color:#fee2e2;text-align:center;line-height:44px;font-size:22px;">
                                            🚫
                                        </div>
                                    </td>
                                    <td valign="middle" style="padding-left:14px;">
                                        <p style="margin:0;font-size:17px;font-weight:600;color:#111827;">Solicitud de autorización de crédito</p>
                                        <p style="margin:4px 0 0;font-size:12px;color:#6b7280;">Requiere aprobación del administrador</p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- SEPARADOR -->
                    <tr><td style="height:2px;background-color:#f3f4f6;"></td></tr>

                    <!-- CUERPO PRINCIPAL -->
                    <tr>
                        <td style="background-color:#ffffff;border-left:1px solid #e5e7eb;border-right:1px solid #e5e7eb;padding:24px 28px;">

                            <!-- INTRO -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
                                <tr>
                                    <td style="background-color:#fef2f2;border-left:3px solid #f87171;border-radius:0 8px 8px 0;padding:12px 16px;">
                                        <p style="margin:0;font-size:13px;color:#374151;line-height:1.7;">
                                            El usuario <strong style="color:#111827;">@Model.UsuarioSolicitante</strong> solicita aprobación para procesar un pedido que requiere revisión del límite de crédito del cliente.
                                        </p>
                                    </td>
                                </tr>
                            </table>

                            <!-- ETIQUETA SECCIÓN -->
                            <p style="margin:0 0 10px;font-size:11px;font-weight:600;color:#9ca3af;letter-spacing:0.6px;text-transform:uppercase;">Información general</p>

                            <!-- GRID CLIENTE + FOLIO + FECHA -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:20px;">
                                <!-- Cliente (fila completa) -->
                                <tr>
                                    <td colspan="2" style="padding-bottom:8px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;">
                                                    <p style="margin:0 0 3px;font-size:11px;color:#6b7280;">Cliente</p>
                                                    <p style="margin:0;font-size:14px;font-weight:600;color:#111827;">@Model.Cliente</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                                <!-- Folio y Fecha -->
                                <tr>
                                    <td width="50%" style="padding-right:4px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;">
                                                    <p style="margin:0 0 3px;font-size:11px;color:#6b7280;">Folio</p>
                                                    <p style="margin:0;font-size:13px;font-weight:600;color:#111827;font-family:'Courier New',monospace;">@Model.Folio</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                    <td width="50%" style="padding-left:4px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:8px;padding:10px 14px;">
                                                    <p style="margin:0 0 3px;font-size:11px;color:#6b7280;">Fecha</p>
                                                    <p style="margin:0;font-size:13px;font-weight:600;color:#111827;">@Model.Fecha.ToString("dd/MM/yyyy HH:mm")</p>
                                                </td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- ETIQUETA SECCIÓN CRÉDITO -->
                            <p style="margin:0 0 10px;font-size:11px;font-weight:600;color:#9ca3af;letter-spacing:0.6px;text-transform:uppercase;">Situación de crédito</p>

                            <!-- TARJETA BARRA DE CRÉDITO -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;margin-bottom:10px;">
                                <tr>
                                    <td style="padding:16px 18px;">
                                        <!-- Fila superior: título y límite -->
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px;">
                                            <tr>
                                                <td><p style="margin:0;font-size:13px;font-weight:600;color:#111827;">Crédito utilizado</p></td>
                                                <td align="right"><p style="margin:0;font-size:12px;color:#6b7280;">Límite: @fmt(Model.Limite)</p></td>
                                            </tr>
                                        </table>
                                        <!-- Barra de progreso -->
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:10px;">
                                            <tr>
                                                <td style="background-color:#e5e7eb;border-radius:4px;height:8px;overflow:hidden;">
                                                    <div style="width:@(porcentajeUsado.ToString("F0"))%;height:8px;background-color:@barColor;border-radius:4px;"></div>
                                                </td>
                                            </tr>
                                        </table>
                                        <!-- Etiquetas Usado / Disponible -->
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td><p style="margin:0;font-size:11px;font-weight:600;color:#b91c1c;">Usado: @fmt(Model.Usado)</p></td>
                                                <td align="right"><p style="margin:0;font-size:11px;font-weight:600;color:#15803d;">Disponible: @fmt(Model.Disponible)</p></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- TOTAL DEL PEDIDO -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;margin-bottom:24px;">
                                <tr>
                                    <td style="padding:14px 18px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td valign="middle"><p style="margin:0;font-size:13px;color:#6b7280;">Total del pedido solicitado</p></td>
                                                <td align="right" valign="middle"><p style="margin:0;font-size:22px;font-weight:700;color:#111827;">@fmt(Model.Total)</p></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            @if (Model.Productos != null && Model.Productos.Any())
                            {
                                <!-- ETIQUETA SECCIÓN PRODUCTOS -->
                                <p style="margin:0 0 10px;font-size:11px;font-weight:600;color:#9ca3af;letter-spacing:0.6px;text-transform:uppercase;">Productos del pedido</p>

                                <!-- TABLA DE PRODUCTOS -->
                                <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f9fafb;border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
                                    <!-- Encabezados -->
                                    <thead>
                                        <tr style="border-bottom:1px solid #d1d5db;">
                                            <th align="left" style="padding:9px 14px;font-size:11px;font-weight:600;color:#6b7280;letter-spacing:0.4px;text-transform:uppercase;background-color:#f3f4f6;">Descripción</th>
                                            <th align="right" style="padding:9px 10px;font-size:11px;font-weight:600;color:#6b7280;letter-spacing:0.4px;text-transform:uppercase;background-color:#f3f4f6;white-space:nowrap;">Cant.</th>
                                            <th align="right" style="padding:9px 10px;font-size:11px;font-weight:600;color:#6b7280;letter-spacing:0.4px;text-transform:uppercase;background-color:#f3f4f6;">Precio</th>
                                            <th align="right" style="padding:9px 14px;font-size:11px;font-weight:600;color:#6b7280;letter-spacing:0.4px;text-transform:uppercase;background-color:#f3f4f6;">Importe</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Productos)
                                        {
                                            <tr style="border-bottom:1px solid #e5e7eb;">
                                                <td style="padding:10px 14px;font-size:13px;color:#111827;">@p.Descripcion</td>
                                                <td align="right" style="padding:10px 10px;font-size:13px;color:#374151;">@p.Cantidad</td>
                                                <td align="right" style="padding:10px 10px;font-size:13px;color:#374151;white-space:nowrap;">@fmt(Convert.ToDecimal(p.Precio))</td>
                                                <td align="right" style="padding:10px 14px;font-size:13px;font-weight:600;color:#111827;white-space:nowrap;">@fmt(p.Importe)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }

                        </td>
                    </tr>

                    <!-- SEPARADOR -->
                    <tr><td style="height:2px;background-color:#f3f4f6;"></td></tr>

                    <!-- FOOTER -->
                    <tr>
                        <td style="background-color:#f9fafb;border:1px solid #e5e7eb;
               border-radius:0 0 12px 12px;padding:20px 28px;">

                            <!-- Botones de acción -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0"
                                   style="margin-bottom:16px;">
                                <tr>
                                    <!-- APROBAR -->
                                    <td width="48%" align="center">
                                        <a href="@Model.UrlAutorizacion&accion=aprobar"
                                           style="display:inline-block;width:100%;padding:13px 0;
                              background-color:#16a34a;color:#ffffff;
                              font-size:14px;font-weight:600;text-align:center;
                              text-decoration:none;border-radius:8px;">
                                            ✅ Aprobar pedido
                                        </a>
                                    </td>
                                    <td width="4%"></td>
                                    <!-- RECHAZAR -->
                                    <td width="48%" align="center">
                                        <a href="@Model.UrlAutorizacion&accion=rechazar"
                                           style="display:inline-block;width:100%;padding:13px 0;
                              background-color:#dc2626;color:#ffffff;
                              font-size:14px;font-weight:600;text-align:center;
                              text-decoration:none;border-radius:8px;">
                                            ❌ Rechazar pedido
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Nota y fecha -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td valign="middle">
                                        <p style="margin:0;font-size:11px;color:#9ca3af;line-height:1.6;">
                                            Correo generado automáticamente por el sistema de facturación.<br>
                                            También puede gestionar esta solicitud desde el
                                            <a href="@(Model.UrlAutorizacion.Split('?')[0].Replace("/Autorizar",""))/Index"
                                               style="color:#6b7280;">panel interno</a>.
                                        </p>
                                    </td>
                                    <td align="right" valign="middle" style="padding-left:16px;white-space:nowrap;">
                                        <p style="margin:0;font-size:11px;color:#9ca3af;
                               font-family:'Courier New',monospace;">
                                            @Model.Fecha.ToString("dd/MM/yyyy HH:mm")
                                        </p>
                                    </td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

</body>
</html>
