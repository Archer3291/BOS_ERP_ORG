@*
    Layout propio del portal de clientes.

    Deliberadamente NO usa _Layout.cshtml: ese trae el menú completo del ERP, los
    hubs de SignalR y scripts que asumen una sesión interna. Un cliente externo no
    debe recibir nada de eso, ni siquiera oculto por CSS — el HTML del menú revelaría
    la estructura de los módulos internos.
*@
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>@ViewBag.Title — Portal de Clientes</title>

    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="~/content/fontawesome-pro-6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="~/lib/sweetalert2/sweetalert2.min.css" rel="stylesheet" />

    <style>
        :root {
            --azul: #1976d2;
            --azul-oscuro: #0d47a1;
            --gris: #f4f6f9;
            --texto: #1a1a1a;
            --texto-suave: #6b7280;
            --borde: #e5e7eb;
        }

        body {
            background: var(--gris);
            color: var(--texto);
            font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
            min-height: 100vh;
            margin: 0;
        }

        .portal-barra {
            background: linear-gradient(135deg, var(--azul) 0%, var(--azul-oscuro) 100%);
            color: #fff;
            padding: 14px 24px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 12px;
        }

            .portal-barra .marca {
                font-weight: 700;
                font-size: 1.05rem;
                letter-spacing: .3px;
            }

            .portal-barra .quien {
                font-size: .85rem;
                opacity: .92;
                text-align: right;
                line-height: 1.35;
            }

        .portal-contenido {
            max-width: 1100px;
            margin: 0 auto;
            padding: 24px 16px 48px;
        }

        .tarjeta {
            background: #fff;
            border: 1px solid var(--borde);
            border-radius: 12px;
            padding: 24px;
            box-shadow: 0 1px 3px rgba(0,0,0,.06);
        }

        .btn-portal {
            background: var(--azul);
            border-color: var(--azul);
            color: #fff;
        }

            .btn-portal:hover {
                background: var(--azul-oscuro);
                border-color: var(--azul-oscuro);
                color: #fff;
            }

        .pie-portal {
            text-align: center;
            color: var(--texto-suave);
            font-size: .8rem;
            padding: 16px;
        }
    </style>

    @RenderSection("styles", required: false)
</head>
<body>

    @if (ViewBag.MostrarBarra != false)
    {
        <div class="portal-barra">
            <div class="marca">
                <i class="fas fa-file-invoice me-2"></i>Portal de Clientes
            </div>

            @if (!string.IsNullOrEmpty(ViewBag.Cliente as string))
            {
                <div class="d-flex align-items-center gap-3">
                    <div class="quien">
                        <div><strong>@ViewBag.Cliente</strong></div>
                        <div>@ViewBag.ClaveCliente · @ViewBag.Correo</div>
                    </div>
                    <a href="@Url.Action("Salir", "PortalClientes")" class="btn btn-sm btn-light">
                        <i class="fas fa-right-from-bracket me-1"></i>Salir
                    </a>
                </div>
            }
        </div>
    }

    <div class="portal-contenido">
        @RenderBody()
    </div>

    <div class="pie-portal">
        Consulta de comprobantes fiscales · Los archivos XML son el comprobante fiscal válido.
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/sweetalert2/sweetalert2.all.min.js"></script>

    @RenderSection("scripts", required: false)
</body>
</html>
