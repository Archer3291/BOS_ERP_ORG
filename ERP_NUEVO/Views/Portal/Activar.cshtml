@{
    ViewBag.Title = "Definir contraseña";
    ViewBag.MostrarBarra = false;
    Layout = "~/Views/Portal/_LayoutPortal.cshtml";
}

@section styles {
    <style>
        .caja-acceso { max-width: 440px; margin: 48px auto; }

        .encabezado-acceso { text-align: center; margin-bottom: 28px; }

            .encabezado-acceso i { font-size: 2.4rem; color: var(--azul); margin-bottom: 10px; }

            .encabezado-acceso h1 { font-size: 1.35rem; font-weight: 700; margin: 0; }

            .encabezado-acceso p { color: var(--texto-suave); font-size: .9rem; margin-top: 6px; }

        .requisitos { font-size: .8rem; color: var(--texto-suave); margin-top: 6px; }
    </style>
}

<div class="caja-acceso">
    <div class="encabezado-acceso">
        <i class="fas fa-key"></i>
        <h1>Define tu contraseña</h1>
        <p>Con ella entrarás al portal de aquí en adelante</p>
    </div>

    <div class="tarjeta">
        @Html.AntiForgeryToken()

        <input type="hidden" id="token" value="@ViewBag.Token" />
        <input type="hidden" id="clienteId" value="@ViewBag.ClienteId" />

        <div class="mb-3">
            <label class="form-label">Nueva contraseña</label>
            <input type="password" id="password" class="form-control" autocomplete="new-password" />
            <div class="requisitos">Mínimo 8 caracteres.</div>
        </div>

        <div class="mb-3">
            <label class="form-label">Confirma la contraseña</label>
            <input type="password" id="confirmacion" class="form-control" autocomplete="new-password" />
        </div>

        <button type="button" class="btn btn-portal w-100" id="btnGuardar">
            <i class="fas fa-check me-1"></i>Guardar y continuar
        </button>
    </div>
</div>

@section scripts {
    <script>
        (function () {
            'use strict';

            document.getElementById('btnGuardar').addEventListener('click', async e => {
                const password = document.getElementById('password').value;
                const confirmacion = document.getElementById('confirmacion').value;

                // Se valida aquí lo evidente para no gastar un viaje al servidor, pero el
                // servidor vuelve a validar: esto es comodidad, no seguridad.
                if (password.length < 8) {
                    Swal.fire({ icon: 'warning', title: 'Contraseña muy corta', text: 'Usa al menos 8 caracteres.' });
                    return;
                }
                if (password !== confirmacion) {
                    Swal.fire({ icon: 'warning', title: 'No coinciden', text: 'Las dos contraseñas deben ser iguales.' });
                    return;
                }

                const boton = e.currentTarget;
                const htmlOriginal = boton.innerHTML;
                boton.disabled = true;
                boton.innerHTML = '<i class="fas fa-spinner fa-spin me-1"></i>Guardando…';

                try {
                    const fd = new FormData();
                    fd.append('token', document.getElementById('token').value);
                    fd.append('clienteId', document.getElementById('clienteId').value);
                    fd.append('password', password);
                    fd.append('confirmacion', confirmacion);

                    const t = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
                    if (t) fd.append('__RequestVerificationToken', t);

                    const r = await fetch('@Url.Action("EstablecerPassword", "PortalClientes")', {
                        method: 'POST', body: fd
                    });

                    if (!r.ok) {
                        Swal.fire({ icon: 'error', title: 'Error del servidor', text: `El servidor respondió ${r.status}.` });
                        return;
                    }

                    const data = await r.json();

                    await Swal.fire({
                        icon: data.success ? 'success' : 'error',
                        title: data.success ? 'Listo' : 'No se pudo guardar',
                        text: data.message
                    });

                    if (data.success) window.location.href = data.redirectUrl;
                } catch {
                    Swal.fire({ icon: 'error', title: 'Sin conexión', text: 'No pudimos comunicarnos con el servidor.' });
                } finally {
                    boton.disabled = false;
                    boton.innerHTML = htmlOriginal;
                }
            });
        })();
    </script>
}
