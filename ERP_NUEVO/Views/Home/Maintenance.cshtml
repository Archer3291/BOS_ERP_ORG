@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta http-equiv="x-ua-compatible" content="ie=edge" />
    <meta http-equiv="refresh" content="60" />
    <title>Mantenimiento — BOS ERP</title>
    <link rel="shortcut icon" href="~/content/img/logo.png" />
    <link href="~/content/fontawesome-pro-6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;400;500;600&display=swap" />

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bos-teal: #1D9E75;
            --bos-teal-dark: #0f6e52;
            --bos-blue: #1a2d6b;
            --bos-blue-mid: #2F6FED;
            --bos-amber: #E8A33D;
            --dark-bg: #080e1a;
            --glass-border: rgba(255, 255, 255, 0.07);
            --text-primary: #eef2ff;
            --text-muted: rgba(180, 200, 240, 0.48);
        }

        html, body {
            height: 100%;
            font-family: 'DM Sans', sans-serif;
            background: var(--dark-bg);
            overflow: hidden;
        }

        #canvas-bg {
            position: fixed;
            inset: 0;
            z-index: 0;
            pointer-events: none;
        }

        .page-wrapper {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .maint-card {
            width: 100%;
            max-width: 560px;
            border-radius: 22px;
            background: rgb(32 37 51 / 97%);
            border: 0.5px solid var(--glass-border);
            box-shadow: 0 0 0 0.5px rgba(255,255,255,0.07), 0 32px 90px rgba(0,0,0,0.65);
            padding: 56px 46px 46px;
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

            .maint-card::before {
                content: '';
                position: absolute;
                inset: 0;
                background: radial-gradient(ellipse 60% 40% at 50% 0%, rgba(232,163,61,0.10) 0%, transparent 60%), radial-gradient(ellipse 55% 45% at 50% 100%, rgba(29,158,117,0.10) 0%, transparent 65%);
                animation: pulse-bg 5s ease-in-out infinite;
                pointer-events: none;
            }

        @@keyframes pulse-bg {
            0%, 100% {
                opacity: 0.7;
                transform: scale(1);
            }

            50% {
                opacity: 1;
                transform: scale(1.05);
            }
        }

        /* ── Stage del logo (igual que login, pero con tono ámbar) ── */
        .logo-stage {
            position: relative;
            z-index: 1;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 220px;
            height: 220px;
            overflow: visible;
            margin-bottom: 18px;
        }

            .logo-stage::before {
                content: '';
                position: absolute;
                width: 150px;
                height: 150px;
                border-radius: 50%;
                background: radial-gradient( circle, rgba(255, 255, 255, 0.13) 0%, rgba(232, 200, 150, 0.07) 45%, transparent 72% );
                animation: halo-pulse 7s ease-in-out infinite;
                pointer-events: none;
                z-index: 1;
            }

        @@keyframes halo-pulse {
            0%, 100% {
                transform: translateY(0) scale(1);
                opacity: 0.9;
            }

            50% {
                transform: translateY(-6px) scale(1.07);
                opacity: 1;
            }
        }

        .ring {
            position: absolute;
            inset: 0;
            border-radius: 50%;
            border: 1px solid transparent;
            z-index: 2;
        }

        .ring-1 {
            border-color: rgba(232,163,61,0.30);
            animation: spin-cw 18s linear infinite;
        }

            .ring-1::after {
                content: '';
                position: absolute;
                top: -3px;
                left: 50%;
                transform: translateX(-50%);
                width: 6px;
                height: 6px;
                border-radius: 50%;
                background: rgba(232,163,61,0.95);
                box-shadow: 0 0 8px 3px rgba(232,163,61,0.5);
            }

        .ring-2 {
            inset: 20px;
            border-color: rgba(47,111,237,0.2);
            animation: spin-ccw 12s linear infinite;
        }

            .ring-2::after {
                content: '';
                position: absolute;
                bottom: -3px;
                left: 50%;
                transform: translateX(-50%);
                width: 5px;
                height: 5px;
                border-radius: 50%;
                background: rgba(47,111,237,0.9);
                box-shadow: 0 0 7px 3px rgba(47,111,237,0.4);
            }

        .ring-3 {
            inset: 42px;
            border-color: rgba(29,158,117,0.15);
            animation: spin-cw 30s linear infinite;
        }

        @@keyframes spin-cw {
            to {
                transform: rotate(360deg);
            }
        }

        @@keyframes spin-ccw {
            to {
                transform: rotate(-360deg);
            }
        }

        .brand-logo {
            position: relative;
            z-index: 3;
            width: 230px;
            max-width: none;
            display: block;
            animation: float 7s ease-in-out infinite;
            filter: drop-shadow(0 0 1px rgba(255, 255, 255, 0.90)) drop-shadow(0 0 8px rgba(255, 255, 255, 0.30)) drop-shadow(0 0 22px rgba(232, 163, 61, 0.35)) drop-shadow(0 4px 10px rgba(0, 0, 0, 0.50));
        }

        @@keyframes float {
            0%, 100% {
                transform: translateY(0);
            }

            50% {
                transform: translateY(-8px);
            }
        }

        /* ── Contenido ── */
        .maint-icon-badge {
            position: relative;
            z-index: 1;
            width: 46px;
            height: 46px;
            border-radius: 50%;
            background: rgba(232,163,61,0.12);
            border: 0.5px solid rgba(232,163,61,0.35);
            display: flex;
            align-items: center;
            justify-content: center;
            margin-bottom: 18px;
            font-size: 18px;
            color: var(--bos-amber);
            animation: spin-wrench 3.5s ease-in-out infinite;
        }

        @@keyframes spin-wrench {
            0%, 100% {
                transform: rotate(-12deg);
            }

            50% {
                transform: rotate(12deg);
            }
        }

        .form-eyebrow {
            position: relative;
            z-index: 1;
            font-size: 10.5px;
            font-weight: 600;
            letter-spacing: 1.6px;
            text-transform: uppercase;
            color: var(--bos-amber);
            margin-bottom: 10px;
        }

        .form-heading {
            position: relative;
            z-index: 1;
            font-size: 25px;
            font-weight: 600;
            color: var(--text-primary);
            margin-bottom: 10px;
        }

        .form-subheading {
            position: relative;
            z-index: 1;
            font-size: 14px;
            color: var(--text-muted);
            line-height: 1.6;
            max-width: 400px;
            margin-bottom: 30px;
        }

        .dots-loader {
            position: relative;
            z-index: 1;
            display: flex;
            gap: 7px;
            margin-bottom: 28px;
        }

            .dots-loader span {
                width: 8px;
                height: 8px;
                border-radius: 50%;
                background: var(--bos-amber);
                opacity: 0.3;
                animation: dot-pulse 1.4s ease-in-out infinite;
            }

                .dots-loader span:nth-child(1) {
                    animation-delay: 0s;
                }

                .dots-loader span:nth-child(2) {
                    animation-delay: 0.2s;
                }

                .dots-loader span:nth-child(3) {
                    animation-delay: 0.4s;
                }

        @@keyframes dot-pulse {
            0%, 100% {
                opacity: 0.25;
                transform: scale(0.85);
            }

            50% {
                opacity: 1;
                transform: scale(1.15);
            }
        }

        .btn-retry {
            position: relative;
            z-index: 1;
            padding: 13px 28px;
            background: linear-gradient(135deg, var(--bos-teal) 0%, #1565a8 100%);
            border: none;
            border-radius: 11px;
            color: #fff;
            font-family: 'DM Sans', sans-serif;
            font-size: 13.5px;
            font-weight: 600;
            letter-spacing: 0.3px;
            cursor: pointer;
            transition: opacity .2s, transform .15s, box-shadow .2s;
            box-shadow: 0 6px 22px rgba(29,158,117,0.38);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 9px;
            text-decoration: none;
        }

            .btn-retry:hover {
                opacity: .91;
                transform: translateY(-1px);
                box-shadow: 0 10px 28px rgba(29,158,117,0.48);
                color: #fff;
            }

        .maint-footer {
            position: relative;
            z-index: 1;
            margin-top: 26px;
            font-size: 11.5px;
            color: rgba(180,200,240,0.32);
        }

        @@media (max-width: 480px) {
            .maint-card {
                padding: 44px 26px 36px;
            }

            .logo-stage {
                width: 170px;
                height: 170px;
            }

            .brand-logo {
                width: 175px;
            }
        }
    </style>
</head>

<body>
    <canvas id="canvas-bg"></canvas>

    <div class="page-wrapper">
        <div class="maint-card">

            <div class="logo-stage">
                <div class="ring ring-1"></div>
                <div class="ring ring-2"></div>
                <div class="ring ring-3"></div>
                <img class="brand-logo"
                     src="~/content/img/intro_erp.png"
                     alt="BOS ERP — Business Operation System" />
            </div>

            <div class="maint-icon-badge">
                <i class="fa-solid fa-screwdriver-wrench"></i>
            </div>

            <div class="form-eyebrow">Servicio temporalmente no disponible</div>
            <div class="form-heading">Estamos en mantenimiento</div>
            <div class="form-subheading">
                Estamos realizando mejoras en el sistema para ofrecerte una mejor experiencia.
                Volveremos a estar disponibles en breve. Gracias por tu paciencia.
            </div>

            <div class="dots-loader">
                <span></span><span></span><span></span>
            </div>

            <a href="@(Url.Action("Index", "Home"))" class="btn-retry">
                <i class="fa-solid fa-rotate-right"></i>
                Reintentar
            </a>

            <div class="maint-footer">BOS ERP &middot;</div>
        </div>
    </div>

    <script>
        (function () {
            var canvas = document.getElementById('canvas-bg');
            var ctx = canvas.getContext('2d');
            function resize() { canvas.width = window.innerWidth; canvas.height = window.innerHeight; }
            resize();
            window.addEventListener('resize', resize);

            var pts = [];
            for (var i = 0; i < 65; i++) {
                pts.push({
                    x: Math.random() * window.innerWidth,
                    y: Math.random() * window.innerHeight,
                    vx: (Math.random() - 0.5) * 0.32,
                    vy: (Math.random() - 0.5) * 0.32,
                    r: Math.random() * 1.5 + 0.5,
                    amber: Math.random() > 0.55
                });
            }

            function draw() {
                ctx.clearRect(0, 0, canvas.width, canvas.height);
                var g = ctx.createRadialGradient(canvas.width * .5, canvas.height * .5, 0, canvas.width * .5, canvas.height * .5, canvas.width * .75);
                g.addColorStop(0, '#0d1829');
                g.addColorStop(1, '#070c17');
                ctx.fillStyle = g;
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                for (var i = 0; i < pts.length; i++) {
                    var p = pts[i];
                    p.x += p.vx; p.y += p.vy;
                    if (p.x < 0 || p.x > canvas.width) p.vx *= -1;
                    if (p.y < 0 || p.y > canvas.height) p.vy *= -1;
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                    ctx.fillStyle = p.amber ? 'rgba(232,163,61,0.6)' : 'rgba(47,111,237,0.5)';
                    ctx.fill();
                }

                for (var i = 0; i < pts.length; i++) {
                    for (var j = i + 1; j < pts.length; j++) {
                        var dx = pts[i].x - pts[j].x, dy = pts[i].y - pts[j].y;
                        var d = Math.sqrt(dx * dx + dy * dy);
                        if (d < 125) {
                            var a = 0.16 * (1 - d / 125);
                            ctx.beginPath();
                            ctx.moveTo(pts[i].x, pts[i].y);
                            ctx.lineTo(pts[j].x, pts[j].y);
                            ctx.strokeStyle = pts[i].amber ? 'rgba(232,163,61,' + a + ')' : 'rgba(47,111,237,' + a + ')';
                            ctx.lineWidth = 0.5;
                            ctx.stroke();
                        }
                    }
                }
                requestAnimationFrame(draw);
            }
            draw();
        })();
    </script>
</body>
</html>
