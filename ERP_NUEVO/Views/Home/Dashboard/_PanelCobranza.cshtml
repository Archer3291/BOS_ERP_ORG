@*
    Panel de COBRANZA del tablero del Home.
    Lo dibuja wwwroot/scripts/Home/dashboard/cobranza.js
*@

<section class="dash-panel" data-panel="cobranza" hidden>
    <div class="dash-grid">

    <article class="dash-card span-4" data-card="cobertura" style="--card-accent:var(--dv-s3)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Cobranza del día</h3>
                        <p class="dash-card-sub">Cobrado contra lo facturado hoy</p>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-gauge"><div id="chartCobertura" class="dash-chart" role="img" aria-label="Porcentaje cobrado respecto a lo facturado hoy"></div></div>
                        <div class="dash-caption" id="coberturaCaption"></div>
                    </div>
                </div>
            </article>

    <article class="dash-card span-8" data-card="aging" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Antigüedad de la cartera</h3>
                        <p class="dash-card-sub">Saldo pendiente por sucursal y días vencidos</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartAging" class="dash-chart" role="img" aria-label="Saldo pendiente por sucursal repartido en rangos de días vencidos"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-4" data-card="pagos" style="--card-accent:var(--dv-s2)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Formas de pago</h3>
                        <p class="dash-card-sub">Facturado del mes en curso</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-mid"><div id="chartPagos" class="dash-chart" role="img" aria-label="Importe facturado del mes por forma de pago"></div></div>
                        <div class="dash-legend is-compact" id="pagosLegend"></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-8" data-card="vence" style="--card-accent:var(--dv-warning)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Crédito que vence hoy</h3>
                        <p class="dash-card-sub">Saldo pendiente por factura · mayores primero</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartVence" class="dash-chart" role="img" aria-label="Saldo pendiente de las facturas de crédito que vencen hoy"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-12" data-card="riesgo" style="--card-accent:var(--dv-critical)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Clientes con saldo vencido</h3>
                        <p class="dash-card-sub">Los 10 mayores · con días de atraso</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartRiesgo" class="dash-chart" role="img" aria-label="Clientes con mayor saldo vencido"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    </div>
</section>
