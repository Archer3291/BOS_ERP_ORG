@*
    Panel de ALMACÉN del tablero del Home (cortes sobre tarima).
    Lo dibuja wwwroot/scripts/Home/dashboard/almacen.js
*@

<section class="dash-panel" data-panel="almacen" hidden>

    <p class="dash-panel-note">
        <i class="fas fa-circle-info"></i>
        <span>Los cortes no están ligados a una sucursal, así que este panel siempre muestra el total de la empresa: el filtro de arriba no le aplica.</span>
    </p>

    <div class="dash-kpis is-tres">
        <div class="dash-kpi" style="--kpi-accent:var(--dv-s1)">
            <div class="dash-kpi-top">
                <span class="dash-kpi-chip"><i class="fas fa-scissors"></i></span>
                <span class="dash-kpi-label">Cortes registrados</span>
            </div>
            <div class="dash-kpi-value" id="kpiCortes">—</div>
            <div class="dash-kpi-foot" id="kpiCortesFoot">—</div>
        </div>

        <div class="dash-kpi" style="--kpi-accent:var(--dv-s3)">
            <div class="dash-kpi-top">
                <span class="dash-kpi-chip"><i class="fas fa-ruler-horizontal"></i></span>
                <span class="dash-kpi-label">Metros cortados</span>
            </div>
            <div class="dash-kpi-value" id="kpiMetros">—</div>
            <div class="dash-kpi-foot" id="kpiMetrosFoot">—</div>
        </div>

        <div class="dash-kpi" style="--kpi-accent:var(--dv-s2)">
            <div class="dash-kpi-top">
                <span class="dash-kpi-chip"><i class="fas fa-warehouse"></i></span>
                <span class="dash-kpi-label">Ubicaciones</span>
            </div>
            <div class="dash-kpi-value" id="kpiUbicaciones">—</div>
            <div class="dash-kpi-foot" id="kpiUbicacionesFoot">—</div>
        </div>
    </div>

    <div class="dash-grid">

        <!-- Cortes por día -->
        <article class="dash-card span-8" data-card="cortesDia" style="--card-accent:var(--dv-s3)">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Cortes por día</h3>
                    <p class="dash-card-sub">Piezas cortadas según la fecha de registro</p>
                </div>
                <div class="dash-switch" data-switch="view">
                    <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                    <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                </div>
            </div>
            <div class="dash-body">
                <div class="dash-view" data-view="chart">
                    <div class="dash-plot"><div id="chartCortesDia" class="dash-chart" role="img" aria-label="Cortes registrados por día"></div></div>
                </div>
                <div class="dash-view" data-view="table" hidden></div>
            </div>
        </article>

        <!-- Cortes por ubicación -->
        <article class="dash-card span-4" data-card="cortesUbicacion" style="--card-accent:var(--dv-s2)">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Cortes por ubicación</h3>
                    <p class="dash-card-sub">Reparto entre niveles del almacén</p>
                </div>
                <div class="dash-switch" data-switch="view">
                    <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                    <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                </div>
            </div>
            <div class="dash-body">
                <div class="dash-view" data-view="chart">
                    <div class="dash-plot is-mid"><div id="chartCortesUbicacion" class="dash-chart" role="img" aria-label="Cortes por ubicación del almacén"></div></div>
                    <div class="dash-legend is-compact" id="ubicacionLegend"></div>
                </div>
                <div class="dash-view" data-view="table" hidden></div>
            </div>
        </article>

        <!-- Metros cortados por producto -->
        <article class="dash-card span-6" data-card="cortesProducto" style="--card-accent:var(--dv-s1)">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Metros cortados por producto</h3>
                    <p class="dash-card-sub">Los 10 productos con más material cortado</p>
                </div>
                <div class="dash-switch" data-switch="view">
                    <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                    <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                </div>
            </div>
            <div class="dash-body">
                <div class="dash-view" data-view="chart">
                    <div class="dash-plot is-tall"><div id="chartCortesProducto" class="dash-chart" role="img" aria-label="Metros cortados por producto"></div></div>
                </div>
                <div class="dash-view" data-view="table" hidden></div>
            </div>
        </article>

        <!-- Cortes por medida -->
        <article class="dash-card span-6" data-card="cortesMedida" style="--card-accent:var(--dv-s1)">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Cortes por medida</h3>
                    <p class="dash-card-sub">Cuántas piezas salen de cada longitud</p>
                </div>
                <div class="dash-switch" data-switch="view">
                    <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                    <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                </div>
            </div>
            <div class="dash-body">
                <div class="dash-view" data-view="chart">
                    <div class="dash-plot is-tall"><div id="chartCortesMedida" class="dash-chart" role="img" aria-label="Cortes por medida de longitud"></div></div>
                </div>
                <div class="dash-view" data-view="table" hidden></div>
            </div>
        </article>

        <!-- Detalle -->
        <article class="dash-card span-12" data-card="cortesDetalle" style="--card-accent:var(--dv-s3)">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Detalle de cortes</h3>
                    <p class="dash-card-sub">Todos los cortes con material disponible</p>
                </div>
            </div>
            <div class="dash-body">
                <div class="dash-view" data-view="table"></div>
            </div>
        </article>

    </div>
</section>
