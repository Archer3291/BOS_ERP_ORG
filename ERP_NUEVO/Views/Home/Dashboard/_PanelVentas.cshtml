@*
    Panel de VENTAS del tablero del Home.
    Lo dibuja wwwroot/scripts/Home/dashboard/ventas.js
*@

<section class="dash-panel" data-panel="ventas">
    <div class="dash-grid">

    <article class="dash-card span-12" data-card="tendencia" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Tendencia de los últimos 30 días</h3>
                        <p class="dash-card-sub">Facturado contra cobrado, día por día</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartTendencia" class="dash-chart" role="img" aria-label="Importe facturado y cobrado por día en los últimos 30 días"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-8" data-card="horas" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Ritmo de facturación</h3>
                        <p class="dash-card-sub">Importe facturado por hora del día</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartHoras" class="dash-chart" role="img" aria-label="Importe facturado por hora del día"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-4" data-card="reparto" style="--card-accent:var(--dv-s2)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Participación por sucursal</h3>
                        <p class="dash-card-sub">Reparto de lo facturado hoy entre todas las sucursales</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-mid"><div id="chartReparto" class="dash-chart" role="img" aria-label="Participación de cada sucursal en el importe facturado hoy"></div></div>
                        <div class="dash-legend is-compact" id="repartoLegend"></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-6" data-card="sucursal" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Facturado y cobrado por sucursal</h3>
                        <p class="dash-card-sub">Movimiento del día, por sucursal</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartSucursal" class="dash-chart" role="img" aria-label="Importe facturado y cobrado del día por sucursal"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-6" data-card="meses" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Mes en curso contra mes anterior</h3>
                        <p class="dash-card-sub">Importe facturado por sucursal</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot"><div id="chartMeses" class="dash-chart" role="img" aria-label="Importe facturado del mes en curso comparado con el mes anterior, por sucursal"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-6" data-card="productos" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title" id="productosTitulo">Productos por unidades vendidas</h3>
                        <p class="dash-card-sub">Top 10 · últimos 60 días</p>
                    </div>
                    <div class="dash-switches">
                        <div class="dash-switch" data-switch="metric">
                            <button type="button" class="dash-switch-btn is-active" data-metric="unidades">Unidades</button>
                            <button type="button" class="dash-switch-btn" data-metric="importe">Importe</button>
                        </div>
                        <div class="dash-switch" data-switch="rank">
                            <button type="button" class="dash-switch-btn is-active" data-rank="top">Más</button>
                            <button type="button" class="dash-switch-btn" data-rank="bottom">Menos</button>
                        </div>
                        <div class="dash-switch" data-switch="view">
                            <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                            <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                        </div>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-tall"><div id="chartProductos" class="dash-chart" role="img" aria-label="Productos ordenados por unidades vendidas en los últimos 60 días"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-6" data-card="clientes" style="--card-accent:var(--dv-s1)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Clientes por importe facturado</h3>
                        <p class="dash-card-sub">Top 10 · últimos 60 días</p>
                    </div>
                    <div class="dash-switches">
                        <div class="dash-switch" data-switch="rank">
                            <button type="button" class="dash-switch-btn is-active" data-rank="top">Más</button>
                            <button type="button" class="dash-switch-btn" data-rank="bottom">Menos</button>
                        </div>
                        <div class="dash-switch" data-switch="view">
                            <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                            <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                        </div>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-tall"><div id="chartClientes" class="dash-chart" role="img" aria-label="Clientes ordenados por importe facturado en los últimos 60 días"></div></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-4" data-card="mezcla" style="--card-accent:var(--dv-s2)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Mezcla contado / crédito</h3>
                        <p class="dash-card-sub">Reparto del importe facturado hoy</p>
                    </div>
                    <div class="dash-switch" data-switch="view">
                        <button type="button" class="dash-switch-btn is-active" data-view="chart">Gráfica</button>
                        <button type="button" class="dash-switch-btn" data-view="table">Tabla</button>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="chart">
                        <div class="dash-plot is-short"><div id="chartMezcla" class="dash-chart" role="img" aria-label="Reparto del importe facturado entre contado y crédito"></div></div>
                        <div class="dash-legend" id="mezclaLegend"></div>
                    </div>
                    <div class="dash-view" data-view="table" hidden></div>
                </div>
            </article>

    <article class="dash-card span-8" data-card="facturas" style="--card-accent:var(--dv-s3)">
                <div class="dash-card-head">
                    <div>
                        <h3 class="dash-card-title">Facturas emitidas hoy</h3>
                        <p class="dash-card-sub">Detalle del día · mayor importe primero</p>
                    </div>
                </div>
                <div class="dash-body">
                    <div class="dash-view" data-view="table"></div>
                </div>
            </article>

    </div>
</section>
