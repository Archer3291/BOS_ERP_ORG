        <div class="cd-card cd-panel" id="panel-VIREM">
            <div class="cd-card-head">
                <div class="cd-card-title"><i class="fas fa-truck"></i> Remisiones</div>
                <div class="cd-estatus-bar">
                    <span class="cd-estatus-lbl d-none d-md-inline"><i class="fas fa-filter"></i> Ver:</span>
                    <button class="cd-estatus-btn active-activos" onclick="cambiarEstatus('VIREM','activos',this)"><i class="fas fa-circle-check"></i> Activos</button>
                    <button class="cd-estatus-btn" onclick="cambiarEstatus('VIREM','cancelados',this)"><i class="fas fa-ban"></i> Cancelados</button>
                    <button class="cd-estatus-btn" onclick="cambiarEstatus('VIREM','todos',this)"><i class="fas fa-list"></i> Todos</button>
                </div>
