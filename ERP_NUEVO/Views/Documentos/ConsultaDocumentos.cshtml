            <div class="cd-card-body cd-dt-wrap">
                <div id="tblVICOT"></div>
            </div>
        </div>

        <div class="cd-card cd-panel" id="panel-VIPED">
            <div class="cd-card-head">
                <div class="cd-card-title"><i class="fas fa-cart-shopping"></i> Pedidos</div>
                <div class="cd-estatus-bar">
                    <span class="cd-estatus-lbl d-none d-md-inline"><i class="fas fa-filter"></i> Ver:</span>
                    <button class="cd-estatus-btn active-activos" onclick="cambiarEstatus('VIPED','activos',this)"><i class="fas fa-circle-check"></i> Activos</button>
                    <button class="cd-estatus-btn" onclick="cambiarEstatus('VIPED','cancelados',this)"><i class="fas fa-ban"></i> Cancelados</button>
                    <button class="cd-estatus-btn" onclick="cambiarEstatus('VIPED','todos',this)"><i class="fas fa-list"></i> Todos</button>
                </div>
