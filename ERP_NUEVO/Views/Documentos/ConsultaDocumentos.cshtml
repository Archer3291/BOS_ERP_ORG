</div>

<div class="modal fade cd-modal" id="modalDetalle"
     tabindex="-1"
     aria-labelledby="modalDetalleTitle"
     aria-modal="true"
     role="dialog">

    <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="modalDetalleTitle">
                    <i class="fas fa-file-lines"></i> Detalle del documento
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body" id="modalDetalleBody">
                <div class="cd-modal-loader">
                    <i class="fas fa-spinner fa-spin"></i>
                    <p>Cargando documento...</p>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                    <i class="fas fa-xmark me-1"></i> Cerrar
                </button>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/TableBuilder.js"></script>
    <script>

/* ── URLs ─────────────────────────────────────────────────────────── */
var urlBuscarDocumento = '@Url.Action("BuscarDocumento", "ConsultaDocumentos")';

var urlBase = {
    VICOT: '@Url.Action("GetVICOT", "ConsultaDocumentos")',
    VIPED: '@Url.Action("GetVIPED", "ConsultaDocumentos")',
    VIREM: '@Url.Action("GetVIREM", "ConsultaDocumentos")'
};

/* ── Estado ───────────────────────────────────────────────────────── */
var estatusActual = { VICOT: 'activos', VIPED: 'activos', VIREM: 'activos' };
var instancias    = {};

/* ── Bootstrap 5 modal instance ──────────────────────────────────── */
var _modalDetalle = null;
function getModal() {
    if (!_modalDetalle) {
        _modalDetalle = new bootstrap.Modal(document.getElementById('modalDetalle'), {
            backdrop: 'static',  // evita cierre accidental al cargar
            keyboard: true
        });
    }
    return _modalDetalle;
}

/* ── Formatters ───────────────────────────────────────────────────── */
function fmtMoney(v) {
    var n = parseFloat(v) || 0;
    return '$' + n.toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
}

function fmtFolio(v, row) {
    var cancelado = isCancelado(row);
    return '<span class="cd-folio' + (cancelado ? ' cancelado' : '') + '">' + (v || '—') + '</span>';
}

function fmtCliente(v, row) {
    return row.n_cli || row.cli_prov || '—';
}

function fmtImporte(v, row) {
    var color = isCancelado(row) ? '#dc2626' : 'var(--success-color)';
    return '<span style="color:' + color + ';font-weight:600;">' + fmtMoney(v) + '</span>';
}

function fmtEstatus(v, row) {
    if (isCancelado(row))
        return '<span class="estatus-cancelado"><i class="fas fa-ban"></i> Cancelado</span>';
    return '<span class="estatus-activo"><i class="fas fa-circle-check"></i> Activo</span>';
}

function isCancelado(row) {
    return row.estatus_id == 27 || row.estatus_label === 'CANCELADO';
}

/* ── Existencia badge ─────────────────────────────────────────────── */
function fmtExistencia(existencia, cantidad) {
    var exist = parseFloat(existencia) || 0;
    var cant  = parseFloat(cantidad)   || 0;
    var cls  = exist <= 0 ? 'exist-out' : exist < cant ? 'exist-low' : 'exist-ok';
    var icon = exist <= 0 ? 'fa-circle-xmark' : exist < cant ? 'fa-circle-exclamation' : 'fa-circle-check';
    return '<span class="exist-badge ' + cls + '"><i class="fas ' + icon + '"></i> ' + exist.toFixed(0) + '</span>';
}

/* ── Totales ──────────────────────────────────────────────────────── */
function calcularTotales(productos) {
    var sub = 0, iva = 0, ieps = 0;
    (productos || []).forEach(function(p) {
        sub  += parseFloat(p.importe) || 0;
        iva  += parseFloat(p.iva)     || 0;
        ieps += parseFloat(p.ieps)    || 0;
    });
    return { subtotal: sub, iva: iva, ieps: ieps, total: sub + iva + ieps };
}

/* ── Renderizar partidas ──────────────────────────────────────────── */
function renderPartidas(productos, esCancelado) {
    if (!productos || productos.length === 0) {
        return '<div class="text-center py-4" style="color:var(--text-light);">' +
               '<i class="fas fa-box-open" style="font-size:2em;opacity:.4;display:block;margin-bottom:8px;"></i>' +
               'Sin partidas registradas</div>';
    }

    var rows = '';
    productos.forEach(function(p, i) {
        var dto = parseFloat(p.descuento) || 0;
        var dtoHtml = dto > 0 ? ' <span class="cd-dto">(-' + dto.toFixed(0) + '%)</span>' : '';
        var importeColor = esCancelado ? '#b91c1c' : 'var(--success-color)';

        rows +=
            '<tr>' +
            '<td class="text-center" style="color:var(--text-light);font-size:12px;">' + (i + 1) + '</td>' +
            '<td><span class="cd-cve">' + (p.producto_id || '—') + '</span></td>' +
            '<td>' + (p.descripcion || '—') + '</td>' +
            '<td class="col-num">' + (parseFloat(p.cantidad) || 0).toFixed(2) +
                ' <small style="color:var(--text-light)">' + (p.unidad || '') + '</small></td>' +
            '<td class="col-num">' + fmtMoney(p.precio) + dtoHtml + '</td>' +
            '<td class="col-num" style="color:' + importeColor + ';font-weight:600;">' + fmtMoney(p.importe) + '</td>' +
            (!esCancelado ? '<td class="col-num">' + fmtExistencia(p.existencia, p.cantidad) + '</td>' : '') +
            '</tr>';
    });

    var totales = calcularTotales(productos);
    var totalCls = esCancelado ? '' : 'highlight';

    var thead =
        '<th style="width:36px;">#</th><th>Clave</th><th>Descripción</th>' +
        '<th class="col-num">Cantidad</th><th class="col-num">Precio</th><th class="col-num">Importe</th>' +
        (!esCancelado ? '<th class="col-num">Existencia</th>' : '');

    return '<div class="cd-partidas-table-wrap">' +
           '<table class="cd-partidas-table"><thead><tr>' + thead + '</tr></thead>' +
           '<tbody>' + rows + '</tbody></table></div>' +
           '<div class="cd-partidas-totals">' +
           '<div class="cd-total-item"><div class="cd-total-lbl">Subtotal</div><div class="cd-total-val">' + fmtMoney(totales.subtotal) + '</div></div>' +
           (totales.ieps > 0 ? '<div class="cd-total-item"><div class="cd-total-lbl">IEPS</div><div class="cd-total-val">' + fmtMoney(totales.ieps) + '</div></div>' : '') +
           '<div class="cd-total-item"><div class="cd-total-lbl">IVA</div><div class="cd-total-val">' + fmtMoney(totales.iva) + '</div></div>' +
           '<div class="cd-total-item"><div class="cd-total-lbl">Total</div><div class="cd-total-val ' + totalCls + '">' + fmtMoney(totales.total) + '</div></div>' +
           '</div>';
}

/* ── Modal detalle ────────────────────────────────────────────────── */
function mostrarDetalle(row) {
    // Resetear contenido y abrir
    document.getElementById('modalDetalleBody').innerHTML =
        '<div class="cd-modal-loader"><i class="fas fa-spinner fa-spin"></i><p>Cargando documento...</p></div>';
    document.getElementById('modalDetalleTitle').innerHTML =
        '<i class="fas fa-file-lines"></i> Detalle del documento';

    getModal().show();

    $.ajax({
        url: urlBuscarDocumento,
        type: 'GET',
        data: { id: row.id_encabezado },
        success: function(resp) {
            if (!resp || !resp.success) {
                document.getElementById('modalDetalleBody').innerHTML =
                    '<div class="text-center py-4" style="color:#dc2626;">' +
                    '<i class="fas fa-triangle-exclamation" style="font-size:2em;display:block;margin-bottom:8px;"></i>' +
                    (resp && resp.message ? resp.message : 'Error al cargar el documento.') + '</div>';
                return;
            }

            var d = resp.data;
            var nat = d.nat || '';
            var esCancelado = (d.estatus_id == 27 || d.estatus_label === 'CANCELADO');
            var cm = esCancelado ? ' cancel-mode' : '';

            document.getElementById('modalDetalleTitle').innerHTML =
                '<i class="fas fa-file-lines"></i> ' +
                '<span class="nat-badge nat-' + nat + ' ms-1">' + nat + '</span>' +
                '&nbsp;<span style="font-weight:400;font-size:13px;color:var(--text-light);">' + (d.folio || '') + '</span>' +
                (esCancelado ? '&nbsp;<span class="estatus-cancelado ms-1" style="font-size:11px;"><i class="fas fa-ban"></i> CANCELADO</span>' : '');

            var cancelAlert = esCancelado
                ? '<div class="cd-cancel-alert"><i class="fas fa-ban"></i>' +
                  '<div><div class="cd-cancel-alert-text">Este documento está cancelado y no tiene validez comercial.</div></div></div>'
                : '';

            var productos   = d.productos || [];
            var partidasCnt = productos.length;

            // Grilla de info usando row/col de Bootstrap
            var infoGrid =
                '<div class="row g-2 mb-3">' +
                mkCol(cm, 'Folio',    '<span class="cd-folio' + (esCancelado ? ' cancelado' : '') + '">' + (d.folio || '—') + '</span>') +
                mkCol(cm, 'Fecha',    dateFormatter(d.fch0) || '—') +
                mkCol(cm, 'Cliente',  d.n_cli || d.cli_prov || '—') +
                mkCol(cm, 'RFC',      d.rfc   || '—') +
                extrasToGrid(d, cm) +
                mkCol(cm, 'Capturó',  d.usr0  || '—') +
                '</div>';

            var html = cancelAlert + infoGrid +
                '<div class="cd-partidas-header">' +
                '<div class="cd-partidas-title"><i class="fas fa-list-ul"></i> Partidas del documento</div>' +
                '<span class="cd-partidas-count">' + partidasCnt + ' artículo' + (partidasCnt !== 1 ? 's' : '') + '</span>' +
                '</div>' +
                renderPartidas(productos, esCancelado);

            document.getElementById('modalDetalleBody').innerHTML = html;
        },
        error: function(xhr) {
            document.getElementById('modalDetalleBody').innerHTML =
                '<div class="text-center py-4" style="color:#dc2626;">' +
                '<i class="fas fa-triangle-exclamation" style="font-size:2em;display:block;margin-bottom:8px;"></i>' +
                'Error de conexión (' + xhr.status + '). Intente de nuevo.</div>';
        }
    });
}

/* helpers para la grilla Bootstrap del modal */
function mkCol(cm, lbl, val) {
    return '<div class="col-6 col-md-4 col-lg-3">' +
           '<div class="cd-info-item' + cm + '">' +
           '<div class="cd-info-lbl">' + lbl + '</div>' +
           '<div class="cd-info-val">' + val + '</div>' +
           '</div></div>';
}

function extrasToGrid(d, cm) {
    var out = '';
    if (d.ccy)         out += mkCol(cm, 'Moneda',          d.ccy);
    if (d.incoterm)    out += mkCol(cm, 'Incoterm',        d.incoterm);
    if (d.ordenCompra) out += mkCol(cm, 'Orden de compra', d.ordenCompra);
    if (d.coment1)     out += mkCol(cm, 'Comentario',      d.coment1);
    return out;
}

/* ── Cambiar estatus toggle ───────────────────────────────────────── */
function cambiarEstatus(nat, nuevoEstatus, btn) {
    var panel = document.getElementById('panel-' + nat);
    panel.querySelectorAll('.cd-estatus-btn').forEach(function(b) {
        b.classList.remove('active-activos', 'active-cancelados', 'active-todos');
    });
    btn.classList.add('active-' + nuevoEstatus);
    estatusActual[nat] = nuevoEstatus;

    if (instancias[nat]) {
        document.getElementById('tbl' + nat).innerHTML = '';
        instancias[nat] = null;
    }

    iniciarTabla(nat);
}

/* ── Inicializar tabla ────────────────────────────────────────────── */
function iniciarTabla(nat) {
    var tieneIncoterm = (nat !== 'VICOT');

    var columns = [
        { title: 'Folio',   data: 'folio',        formatter: fmtFolio },
        { title: 'Fecha',   data: 'fch' },
        { title: 'Cliente', data: 'n_cli',         formatter: fmtCliente },
        { title: 'Importe', data: 'imp',           formatter: fmtImporte },
        { title: 'Estatus', data: 'estatus_label', formatter: fmtEstatus }
    ];

    if (tieneIncoterm) columns.push({ title: 'Incoterm', data: 'incoterm' });
    columns.push({ title: 'Capturó', data: 'usr0' });

    instancias[nat] = createTable({
        selector: '#tbl' + nat,
        path:     urlBase[nat],
        searchPlaceholder: 'Buscar folio, cliente...',
        columns:  columns,
        data: function() { return { estatus: estatusActual[nat] }; },
        actions: [
            {
                icon:    'fa-eye',
                color:   'btn-outline-primary',
                title:   'Ver detalle',
                onClick: function(row) { mostrarDetalle(row); }
            },
            {
                icon:    'fa-file-arrow-down',
                color:   'btn-outline-secondary',
                title:   'Descargar',
                onClick: function(row) { GenerarPDFGeneral(row.id_encabezado); }
            }
        ],
        onLoad: function(data) {
            document.getElementById('stat' + nat).textContent = data.length || 0;
        }
    });
}

/* ── Cambio de pestaña NAT — lazy init ───────────────────────────── */
function cambiarTab(nat, btn) {
    document.querySelectorAll('.cd-tab-btn').forEach(function(b) { b.classList.remove('active'); });
    btn.classList.add('active');

    document.querySelectorAll('.cd-panel').forEach(function(p) { p.classList.remove('active'); });
    document.getElementById('panel-' + nat).classList.add('active');

    if (!instancias[nat]) iniciarTabla(nat);
}

/* ── Arranque ─────────────────────────────────────────────────────── */
document.addEventListener('DOMContentLoaded', function() {
    iniciarTabla('VICOT');
});

    </script>
}
