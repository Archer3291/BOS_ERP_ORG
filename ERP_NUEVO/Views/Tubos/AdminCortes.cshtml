@{
    ViewData["Title"] = "Administración de Cortes";
}

<style>
    /* ============================================================
               Estilos de "Administración de Cortes"
               Usa la paleta global del layout (--primary-blue, --success-color, etc.)
               No se declaran variables propias: hereda tema claro/oscuro automáticamente.
               ============================================================ */

    /* --- Botones vi-btn --- */
    .vi-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .55rem 1.1rem;
        border-radius: var(--row-radius, 8px);
        border: 1px solid transparent;
        font-size: .875rem;
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform .05s ease;
        white-space: nowrap;
    }

        .vi-btn:active {
            transform: translateY(1px);
        }

        .vi-btn:focus-visible {
            outline: 2px solid var(--accent-blue);
            outline-offset: 2px;
        }

        .vi-btn:disabled {
            opacity: .55;
            cursor: not-allowed;
            transform: none;
        }

    .vi-btn-primary {
        background: var(--primary-blue);
        border-color: var(--primary-blue);
        color: #fff;
    }

        .vi-btn-primary:hover:not(:disabled) {
            background: var(--primary-blue-dark);
            border-color: var(--primary-blue-dark);
        }

    .vi-btn-success {
        background: var(--success-color);
        border-color: var(--success-color);
        color: #fff;
    }

        .vi-btn-success:hover:not(:disabled) {
            filter: brightness(0.9);
        }

    .vi-btn-danger {
        background: var(--danger-color);
        border-color: var(--danger-color);
        color: #fff;
    }

        .vi-btn-danger:hover:not(:disabled) {
            filter: brightness(0.9);
        }

    .vi-btn-outline {
        background: transparent;
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

        .vi-btn-outline:hover:not(:disabled) {
            background: var(--very-light-blue);
        }

    .vi-btn-ghost {
        background: transparent;
        border-color: var(--border-light);
        color: var(--text-light);
    }

        .vi-btn-ghost:hover:not(:disabled) {
            background: var(--bg-gray);
            border-color: var(--text-light);
        }

    .vi-btn-sm {
        padding: .35rem .65rem;
        font-size: .78rem;
        border-radius: 6px;
    }

    .vi-btn-icon {
        padding: .4rem;
        width: 2.1rem;
        height: 2.1rem;
        border-radius: 50%;
    }

    /* --- Inputs vi-control / vi-label --- */
    .vi-label {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--text-light);
        margin-bottom: .35rem;
    }

        .vi-label i {
            color: var(--accent-blue);
            width: 1rem;
            text-align: center;
        }

    .vi-control {
        width: 100%;
        padding: .55rem .75rem;
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        background: var(--bg-light);
        color: var(--text-dark);
        font-size: .875rem;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
    }

        .vi-control:focus {
            outline: none;
            border-color: var(--accent-blue);
            box-shadow: 0 0 0 3px var(--very-light-blue);
        }

        .vi-control[readonly] {
            background: var(--bg-gray);
            color: var(--text-light);
        }

    .vi-sep {
        border: none;
        border-top: 1px solid var(--border-light);
        margin: 1rem 0;
    }

    /* --- Header de modal y sección --- */
    .vi-modal-header {
        background: var(--primary-blue);
        color: #fff;
        border-bottom: none;
        border-top-left-radius: calc(var(--table-radius, 16px) - 4px);
        border-top-right-radius: calc(var(--table-radius, 16px) - 4px);
    }

        .vi-modal-header .modal-title {
            font-weight: 700;
            font-size: 1rem;
        }

    .vi-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-blue);
        color: #fff;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    .ac-card {
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius, 16px);
        background: var(--bg-light);
        box-shadow: var(--shadow);
    }

    .ac-table-wrap {
        border-radius: var(--row-radius, 8px);
        border: 1px solid var(--border-light);
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        max-height: 520px;
        overflow-y: auto;
        position: relative;
    }

    .ac-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 900px;
        font-size: .85rem;
    }

        .ac-table thead {
            background: var(--primary-blue);
            color: #fff;
            position: sticky;
            top: 0;
            z-index: 2;
        }

    .ac-table-wrap.is-scrolled thead {
        box-shadow: var(--shadow-lg);
    }

    .ac-table th {
        padding: .65rem .75rem;
        font-weight: 600;
        text-align: left;
        white-space: nowrap;
    }

    .ac-table td {
        padding: .6rem .75rem;
        border-bottom: 1px solid var(--border-light);
        vertical-align: middle;
    }

    .ac-table tbody tr {
        transition: background-color var(--transition-fast);
    }

        .ac-table tbody tr:hover {
            background: var(--very-light-blue);
        }

        .ac-table tbody tr:focus-within {
            outline: 2px solid var(--accent-blue);
            outline-offset: -2px;
        }

    /* Botones de acción dentro de la tabla (editar / eliminar / etc.) */
    .ac-table td.ac-col-acciones {
        white-space: nowrap;
    }

        .ac-table td.ac-col-acciones .ac-btn-accion {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.1rem;
            height: 2.1rem;
            min-width: 2.25rem;
            min-height: 2.25rem;
            border-radius: 50%;
            border: 1px solid transparent;
            background: transparent;
            color: var(--text-light);
            font-size: .85rem;
            cursor: pointer;
            transition: background-color var(--transition-fast), color var(--transition-fast);
        }

            .ac-table td.ac-col-acciones .ac-btn-accion + .ac-btn-accion {
                margin-left: .25rem;
            }

            .ac-table td.ac-col-acciones .ac-btn-accion:hover {
                background: var(--light-blue);
            }

            .ac-table td.ac-col-acciones .ac-btn-accion.ac-btn-editar {
                color: var(--accent-blue);
            }

                .ac-table td.ac-col-acciones .ac-btn-accion.ac-btn-editar:hover {
                    background: var(--very-light-blue);
                }

            .ac-table td.ac-col-acciones .ac-btn-accion.ac-btn-eliminar {
                color: var(--danger-color);
            }

                .ac-table td.ac-col-acciones .ac-btn-accion.ac-btn-eliminar:hover {
                    background: color-mix(in srgb, var(--danger-color) 12%, transparent);
                }

            .ac-table td.ac-col-acciones .ac-btn-accion:focus-visible {
                outline: 2px solid var(--accent-blue);
                outline-offset: 1px;
            }

    .ac-badge-activo {
        background: color-mix(in srgb, var(--success-color) 15%, transparent);
        color: var(--success-color);
        font-size: .7rem;
        font-weight: 700;
        padding: .2rem .6rem;
        border-radius: var(--badge-radius, 20px);
        white-space: nowrap;
    }

    .ac-badge-inactivo {
        background: var(--light-blue);
        color: var(--text-light);
        font-size: .7rem;
        font-weight: 700;
        padding: .2rem .6rem;
        border-radius: var(--badge-radius, 20px);
        white-space: nowrap;
    }

    .ac-progress-wrap {
        width: 100%;
        height: 8px;
        background: var(--light-blue);
        border-radius: 99px;
        overflow: hidden;
        margin-top: 4px;
    }

    .ac-progress-fill {
        height: 100%;
        background: var(--accent-blue);
        transition: width var(--transition-med);
    }

    .ac-empty-state,
    .ac-error-state {
        padding: 2.5rem 1rem;
        text-align: center;
        color: var(--text-light);
    }

    .ac-error-state {
        color: var(--danger-color);
    }

    .ac-desglose-panel {
        background: var(--very-light-blue);
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        padding: 1rem;
    }

    .ac-desglose-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: .6rem;
        margin-bottom: .75rem;
    }

    .ac-desglose-stat {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: .55rem .75rem;
        display: flex;
        flex-direction: column;
        gap: .15rem;
    }

    .ac-desglose-stat-label {
        font-size: .72rem;
        font-weight: 600;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: .02em;
    }

    .ac-desglose-stat-value {
        font-size: 1.05rem;
        color: var(--text-dark);
    }

    .ac-desglose-stat-disponible .ac-desglose-stat-value {
        color: var(--success-color);
    }

    .ac-desglose-piezas-titulo {
        font-size: .8rem;
        font-weight: 700;
        color: var(--text-dark);
    }

        .ac-desglose-piezas-titulo i {
            color: var(--accent-blue);
            margin-right: .3rem;
        }

    .ac-desglose-table-wrap {
        max-height: 260px;
        overflow-y: auto;
        border: 1px solid var(--border-light);
        border-radius: 8px;
        background: var(--bg-light);
    }

    .ac-desglose-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .8rem;
    }

        .ac-desglose-table thead th {
            position: sticky;
            top: 0;
            background: var(--bg-gray);
            color: var(--text-dark);
            font-weight: 700;
            text-align: left;
            padding: .5rem .65rem;
            border-bottom: 1px solid var(--border-light);
            white-space: nowrap;
        }

        .ac-desglose-table tbody td {
            padding: .45rem .65rem;
            border-bottom: 1px solid var(--border-light);
            color: var(--text-dark);
        }

        .ac-desglose-table tbody tr:last-child td {
            border-bottom: none;
        }

        .ac-desglose-table tbody tr:hover {
            background: var(--very-light-blue);
        }

    @@media (max-width: 575.98px) {
        .ac-desglose-stats {
            grid-template-columns: 1fr;
        }
    }
    .ac-desglose-table th.text-end,
    .ac-desglose-table td.text-end {
        text-align: right;
        font-variant-numeric: tabular-nums;
    }

    .ac-desglose-badge {
        font-size: .68rem;
        font-weight: 700;
        padding: .15rem .5rem;
        border-radius: var(--badge-radius, 20px);
        white-space: nowrap;
    }

    .ac-desglose-badge-asignada {
        background: color-mix(in srgb, var(--success-color) 15%, transparent);
        color: var(--success-color);
    }

    .ac-desglose-badge-pendiente {
        background: var(--light-blue);
        color: var(--text-light);
    }

    .ac-desglose-table tbody tr.ac-fila-pendiente td {
        color: var(--text-light);
    }
    /* ============ RESPONSIVIDAD ============ */

    @@media (max-width: 575.98px) {
        .ac-page-header {
            text-align: center;
        }

            .ac-page-header .vi-section-icon {
                margin-inline: auto;
            }
    }

    @@media (max-width: 991.98px) {
        .ac-table th:nth-child(5),
        .ac-table td:nth-child(5),
        .ac-table th:nth-child(7),
        .ac-table td:nth-child(7) {
            display: none;
        }
    }

    @@media (max-width: 767.98px) {
        .ac-table th:nth-child(8),
        .ac-table td:nth-child(8),
        .ac-table th:nth-child(9),
        .ac-table td:nth-child(9) {
            display: none;
        }

        .ac-table {
            font-size: .8rem;
            min-width: 640px;
        }
    }

    @@media (max-width: 767.98px) {
        #ac-btnAgregarPieza {
            width: 100%;
        }
    }

    @@media (max-width: 575.98px) {
        .ac-table-footer {
            flex-direction: column;
            align-items: stretch !important;
        }

            .ac-table-footer .ac-footer-controls {
                justify-content: space-between;
            }
    }
    .ac-tabs .nav-link {
        color: var(--text-light);
        font-weight: 600;
        border: none;
        border-bottom: 3px solid transparent;
        padding: .65rem 1.1rem;
    }

        .ac-tabs .nav-link.active {
            color: var(--primary-blue);
            border-bottom-color: var(--primary-blue);
            background: transparent;
        }

    .ac-link-pedido {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: 0;
        border: none;
        background: transparent;
        color: var(--primary-blue);
        font-weight: 600;
        font-size: inherit;
        cursor: pointer;
        text-decoration: none;
        transition: color var(--transition-fast);
    }

        .ac-link-pedido i {
            font-size: .7rem;
            color: var(--accent-blue);
            transition: transform var(--transition-fast);
        }

        .ac-link-pedido:hover {
            color: var(--primary-blue-dark);
            text-decoration: underline;
        }

            .ac-link-pedido:hover i {
                transform: translateX(1px);
            }

        .ac-link-pedido:focus-visible {
            outline: 2px solid var(--accent-blue);
            outline-offset: 2px;
            border-radius: 4px;
        }

    /* --- Autocompletado de producto (modal Agregar pieza) --- */
    .ac-autocomplete { position: relative; }

    .ac-autocomplete-lista {
        position: absolute;
        z-index: 20;
        top: calc(100% + 2px);
        left: 0;
        right: 0;
        max-height: 260px;
        overflow-y: auto;
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        box-shadow: var(--shadow-lg, 0 8px 24px rgba(15,23,42,.16));
    }

    .ac-autocomplete-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: .6rem;
        width: 100%;
        padding: .55rem .75rem;
        border: none;
        border-bottom: 1px solid var(--border-light);
        background: transparent;
        text-align: left;
        cursor: pointer;
    }

        .ac-autocomplete-item:last-child { border-bottom: none; }
        .ac-autocomplete-item:hover, .ac-autocomplete-item.activo { background: var(--very-light-blue); }

    .ac-autocomplete-item-txt { min-width: 0; }
    .ac-autocomplete-item-cve { display: block; font-weight: 700; font-size: .84rem; color: var(--text-dark); }

    .ac-autocomplete-item-desc {
        display: block;
        font-size: .74rem;
        color: var(--vi-gray-600);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ac-autocomplete-item-existencia {
        flex: 0 0 auto;
        font-size: .74rem;
        font-weight: 600;
        color: var(--vi-gray-600);
        white-space: nowrap;
    }

    .ac-autocomplete-vacio {
        padding: .75rem;
        text-align: center;
        font-size: .8rem;
        color: var(--vi-gray-600);
    }

    /* --- Fila expandible de piezas físicas (pestaña Disponibles) --- */
    .ac-btn-expandir {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        border: none;
        background: transparent;
        padding: 0;
        font: inherit;
        color: var(--text-dark);
        cursor: pointer;
    }

        .ac-btn-expandir i {
            font-size: .7rem;
            color: var(--accent-blue);
            transition: transform var(--transition-fast);
            width: .8rem;
        }

        .ac-btn-expandir:hover { color: var(--primary-blue); }

    .ac-badge-sobrante {
        display: inline-block;
        margin-left: .5rem;
        padding: .1rem .55rem;
        border-radius: var(--badge-radius, 20px);
        background: color-mix(in srgb, var(--warning-color) 15%, transparent);
        color: var(--warning-color);
        font-size: .68rem;
        font-weight: 700;
        white-space: nowrap;
    }

    .ac-fila-detalle > td {
        background: var(--bg-gray);
        padding: .75rem 1rem !important;
    }

    .ac-piezas-detalle .ac-desglose-table { font-size: .78rem; }
    .ac-piezas-detalle .ac-vacio, .ac-piezas-detalle .ac-error-state { padding: .75rem; text-align: center; }
    .ac-piezas-detalle code {
        font-size: .78rem;
        color: var(--text-dark);
        background: var(--very-light-blue);
        padding: .1rem .4rem;
        border-radius: 4px;
    }

    /* ============================================================
       Taller de barras 3D
       ============================================================ */

    .ac-off { display: none !important; }

    .ac-taller-barra {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: .6rem;
    }

    .ac-buscador {
        position: relative;
        flex: 1 1 240px;
        min-width: 200px;
    }

        .ac-buscador i {
            position: absolute;
            left: .75rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: .8rem;
            color: var(--vi-gray-600);
            pointer-events: none;
        }

        .ac-buscador input { padding-left: 2.1rem; }

    .ac-select-corto { width: auto; min-width: 10rem; }

    .ac-segment {
        display: inline-flex;
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        overflow: hidden;
        background: var(--bg-light);
    }

    .ac-tipo-btn, .ac-cam-btn {
        border: none;
        background: transparent;
        color: var(--text-dark);
        padding: .5rem .85rem;
        font-size: .82rem;
        font-weight: 600;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        transition: background-color .15s ease, color .15s ease;
    }

        .ac-tipo-btn + .ac-tipo-btn,
        .ac-cam-btn + .ac-cam-btn { border-left: 1px solid var(--border-light); }

        .ac-tipo-btn:hover, .ac-cam-btn:hover { background: var(--very-light-blue); }

        .ac-tipo-btn.active, .ac-cam-btn.active {
            background: var(--primary-blue);
            color: #fff;
        }

    .ac-escaner {
        display: flex;
        align-items: center;
        gap: .4rem;
        flex: 1 1 260px;
        min-width: 220px;
        padding: .25rem .3rem .25rem .7rem;
        border: 1px solid var(--accent-blue);
        border-radius: 999px;
        background: var(--bg-light);
    }

        .ac-escaner i { color: var(--accent-blue); }

        .ac-escaner input {
            border: none;
            background: transparent;
            flex: 1;
            min-width: 0;
            padding: .3rem 0;
        }

            .ac-escaner input:focus { outline: none; box-shadow: none; }

        .ac-escaner .vi-btn { border-radius: 999px; padding: .35rem .9rem; }

    .ac-chips { display: flex; flex-wrap: wrap; gap: .6rem; }

    .ac-chip {
        display: inline-flex;
        align-items: baseline;
        gap: .45rem;
        padding: .4rem .85rem;
        border-radius: 999px;
        background: var(--bg-gray);
        border: 1px solid var(--border-light);
        font-size: .8rem;
        color: var(--vi-gray-600);
    }

        .ac-chip i { color: var(--accent-blue); }

    .ac-chip-num { font-size: 1.05rem; font-weight: 700; color: var(--text-dark); }
    .ac-chip-sub { opacity: .75; }

    .ac-taller-grid {
        display: grid;
        grid-template-columns: 280px minmax(0, 1fr);
        gap: 1rem;
        align-items: start;
    }

    .ac-taller-aside {
        display: flex;
        flex-direction: column;
        max-height: 640px;
        overflow: hidden;
    }

    .ac-aside-head {
        padding: .75rem 1rem;
        border-bottom: 1px solid var(--border-light);
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--vi-gray-600);
    }

    .ac-aside-buscador {
        position: relative;
        flex-shrink: 0;
        padding: .5rem .75rem;
        border-bottom: 1px solid var(--border-light);
    }

        .ac-aside-buscador i {
            position: absolute;
            left: 1.25rem;
            top: 50%;
            transform: translateY(-50%);
            font-size: .72rem;
            color: var(--vi-gray-600);
            pointer-events: none;
        }

        .ac-aside-buscador input {
            padding-left: 1.85rem;
            font-size: .8rem;
        }

    .ac-aside-body { overflow-y: auto; padding: .5rem; flex: 1; min-height: 0; }

    .ac-prod {
        display: flex;
        align-items: center;
        gap: .6rem;
        width: 100%;
        padding: .55rem .6rem;
        border: 1px solid transparent;
        border-radius: 8px;
        background: none;
        text-align: left;
        cursor: pointer;
        transition: background-color .15s ease, border-color .15s ease;
    }

        .ac-prod:hover {
            background: var(--very-light-blue);
            border-color: var(--accent-blue);
        }

    .ac-prod-tipo {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        border-radius: 8px;
        flex: 0 0 auto;
        font-size: .8rem;
    }

        .ac-prod-tipo.tubo { background: color-mix(in srgb, var(--accent-blue) 18%, transparent); color: var(--accent-blue); }
        .ac-prod-tipo.barra { background: color-mix(in srgb, var(--warning-color) 20%, transparent); color: var(--warning-color); }

    .ac-prod-txt { flex: 1; min-width: 0; }
    .ac-prod-cve { display: block; font-weight: 700; font-size: .84rem; color: var(--text-dark); }

    .ac-prod-desc {
        display: block;
        font-size: .72rem;
        color: var(--vi-gray-600);
