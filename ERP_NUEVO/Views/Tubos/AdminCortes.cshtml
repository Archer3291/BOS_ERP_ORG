@* Etiquetas: van fuera del taller para poder imprimir desde cualquier pestaña. *@
<script src="~/scripts/Ventas/Tubos/codigo-barras.js"></script>
<script src="~/scripts/Ventas/Tubos/etiquetas-barras.js"></script>
<script type="module" src="~/scripts/Ventas/Tubos/barras-3d.js"></script>
<script src="~/scripts/Ventas/Tubos/admin-cortes-taller.js"></script>

<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
<script src="~/Scripts/Ventas/Tubos/admincortes.js"></script>
<script>
    // Habilita/deshabilita los botones según si hay datos
    function actualizarBotonesExportacion(piezas) {
    const hayDatos = Array.isArray(piezas) && piezas.length > 0;
    document.getElementById('ac-btnExportarExcel').disabled = !hayDatos;
    document.getElementById('ac-btnExportarPdf').disabled = !hayDatos;
    }

    // Llama esto cada vez que renderices el desglose:
    // actualizarBotonesExportacion(piezasDesglose);

    document.getElementById('ac-btnExportarExcel').addEventListener('click', function () {
    if (!window.piezasDesglose || !window.piezasDesglose.length) return;

    const filas = window.piezasDesglose.map(p => ({
    Folio: p.folio,
    'Longitud (m)': p.longitud,
    Cantidad: p.cantidad,
    'Subtotal (m)': (p.longitud * p.cantidad).toFixed(2),
    Comentario: p.comentario || ''
    }));

    const hoja = XLSX.utils.json_to_sheet(filas);
    hoja['!cols'] = [{ wch: 14 }, { wch: 14 }, { wch: 10 }, { wch: 14 }, { wch: 30 }];

    const libro = XLSX.utils.book_new();
    XLSX.utils.book_append_sheet(libro, hoja, 'Desglose');

    const nombreProducto = document.getElementById('ac-crear-productoId').value || 'producto';
    XLSX.writeFile(libro, `desglose_${nombreProducto}_${Date.now()}.xlsx`);
    });

    document.getElementById('ac-btnExportarPdf').addEventListener('click', function () {
    if (!window.piezasDesglose || !window.piezasDesglose.length) return;

    const { jsPDF } = window.jspdf;
    const doc = new jsPDF();

    const producto = document.getElementById('ac-crear-productoId').value || '-';
    doc.setFontSize(13);
    doc.text('Desglose de piezas físicas', 14, 15);
    doc.setFontSize(9);
    doc.text(`Producto: ${producto}`, 14, 22);
    doc.text(`Generado: ${new Date().toLocaleString('es-MX')}`, 14, 27);

    doc.autoTable({
    startY: 32,
    head: [['Folio', 'Longitud (m)', 'Cantidad', 'Subtotal (m)', 'Comentario']],
    body: window.piezasDesglose.map(p => [
    p.folio,
    p.longitud,
    p.cantidad,
    (p.longitud * p.cantidad).toFixed(2),
    p.comentario || ''
    ]),
    styles: { fontSize: 8 },
    headStyles: { fillColor: [30, 58, 95] } // usa el mismo azul de --primary-blue
    });

    doc.save(`desglose_${producto}_${Date.now()}.pdf`);
    });
</script>