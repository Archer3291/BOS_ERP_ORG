                <div class="d-flex justify-content-between align-items-center mb-2">
                    <label class="vi-label mb-0"><i class="fas fa-ruler-combined"></i>Subpiezas a generar</label>
                    <button type="button" class="vi-btn vi-btn-success vi-btn-sm" id="ac-btnAgregarSubpieza">
                        <i class="fas fa-plus"></i> Agregar
                    </button>
                </div>
                <div id="ac-div-lista" class="vt-corte-lista"></div>

                <div class="vt-corte-resumen-grid mt-3">
                    <div class="vt-corte-resumen-card">
                        <span class="vt-corte-resumen-label">Solicitado</span>
                        <span class="vt-corte-resumen-valor" id="ac-div-suma">0.00</span>
