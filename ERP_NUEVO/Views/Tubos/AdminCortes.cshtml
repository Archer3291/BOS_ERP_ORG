                <nav class="mt-2"><ul class="pagination pagination-sm justify-content-center mb-0" id="ac-usa-pagination"></ul></nav>
            </div>
        </div>     
    </div>
</div>

<!-- ===== MODAL: Agregar pieza ===== -->
<div class="modal fade" id="ac-modalCrear" tabindex="-1" aria-labelledby="ac-modalCrearTitulo" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title" id="ac-modalCrearTitulo"><i class="fas fa-plus me-2" aria-hidden="true"></i>Agregar pieza física</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3 mb-3">
                    <div class="col-12 ac-autocomplete">
                        <label class="vi-label" for="ac-crear-productoId"><i class="fas fa-box" aria-hidden="true"></i>Producto</label>
                        <input type="text" id="ac-crear-productoId" class="vi-control"
                               placeholder="Escribe la clave o la descripción…" autocomplete="off">
                        <div id="ac-crear-producto-resultados" class="ac-autocomplete-lista d-none"></div>
                    </div>
                </div>
                <div class="d-grid d-sm-block mb-3">
                    <button type="button" class="vi-btn vi-btn-outline" id="ac-btnVerDesglose"
                            aria-expanded="false" aria-controls="ac-desglose-panel">
                        <i class="fas fa-eye" aria-hidden="true"></i> Ver existencia y desglose actual
                    </button>
                </div>
                <div id="ac-desglose-panel" class="d-none mb-3 ac-desglose-panel">

                    <div class="ac-desglose-stats">
                        <div class="ac-desglose-stat">
                            <span class="ac-desglose-stat-label">Existencia total</span>
                            <span class="ac-desglose-stat-value"><strong id="ac-desglose-total">0</strong> m</span>
                        </div>
                        <div class="ac-desglose-stat">
                            <span class="ac-desglose-stat-label">Ya configurado</span>
                            <span class="ac-desglose-stat-value"><strong id="ac-desglose-configurado">0</strong> m</span>
                        </div>
                        <div class="ac-desglose-stat ac-desglose-stat-disponible">
                            <span class="ac-desglose-stat-label">Disponible</span>
                            <span class="ac-desglose-stat-value"><strong id="ac-desglose-disponible">0</strong> m</span>
                        </div>
                    </div>

                    <div class="ac-progress-wrap">
                        <div class="ac-progress-fill" id="ac-desglose-barra" style="width:0%;"
                             role="progressbar" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"
                             aria-label="Porcentaje de existencia configurada"></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 mb-2">
                        <span class="ac-desglose-piezas-titulo">
                            <i class="fas fa-list-ul" aria-hidden="true"></i> Piezas configuradas (<span id="ac-desglose-count">0</span>)
                        </span>
                        <div class="d-flex gap-2">
                            <button type="button" class="vi-btn vi-btn-outline vi-btn-sm" id="ac-btnEtiquetasDesglose"
                                    title="Imprimir etiquetas de todas las barras de este producto">
                                <i class="fas fa-barcode" aria-hidden="true"></i> Etiquetas
                            </button>
                            <button type="button" class="vi-btn vi-btn-outline vi-btn-sm" id="ac-btnExportarExcel"
                                    disabled title="Exportar a Excel">
                                <i class="fas fa-file-excel" aria-hidden="true"></i> Excel
                            </button>
                            <button type="button" class="vi-btn vi-btn-outline vi-btn-sm" id="ac-btnExportarPdf"
                                    disabled title="Exportar a PDF">
                                <i class="fas fa-file-pdf" aria-hidden="true"></i> PDF
                            </button>
                        </div>
                    </div>

                    <div class="ac-desglose-table-wrap">
                        <table class="ac-desglose-table" id="ac-desglose-tabla">
                            <thead>
                                <tr>
                                    <th scope="col">Folio</th>
                                    <th scope="col" class="text-end">Longitud (m)</th>
                                    <th scope="col" class="text-end">Cantidad</th>
                                    <th scope="col" class="text-end">Subtotal (m)</th>
                                    <th scope="col">Estatus</th>
                                    <th scope="col">Comentario</th>
                                </tr>
                            </thead>
                            <tbody id="ac-desglose-piezas">
                                <tr id="ac-desglose-piezas-vacio">
                                    <td colspan="6" class="text-center text-muted py-3">
                                        Sin piezas configuradas todavía.
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <hr class="vi-sep">

                <div class="row g-3">
                    <div class="col-12 col-sm-4">
                        <label class="vi-label" for="ac-crear-longitud"><i class="fas fa-ruler" aria-hidden="true"></i>Longitud (m)</label>
                        <input type="number" id="ac-crear-longitud" class="vi-control" min="0.01" step="0.01">
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="vi-label" for="ac-crear-cantidad"><i class="fas fa-cubes" aria-hidden="true"></i>Cantidad de piezas</label>
                        <input type="number" id="ac-crear-cantidad" class="vi-control" min="1" step="1" value="1">
                    </div>
                    <div class="col-12 col-sm-4">
                        <label class="vi-label" for="ac-crear-metros-preview"><i class="fas fa-calculator" aria-hidden="true"></i>Metros a agregar</label>
                        <input type="text" id="ac-crear-metros-preview" class="vi-control" readonly value="0.00" aria-readonly="true">
                    </div>
                    <div class="col-12">
                        <label class="vi-label" for="ac-crear-comentario"><i class="fas fa-comment" aria-hidden="true"></i>Comentario</label>
                        <input type="text" id="ac-crear-comentario" class="vi-control" placeholder="Opcional" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="modal-footer flex-column flex-sm-row">
                <button type="button" class="vi-btn vi-btn-ghost w-100 w-sm-auto" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="vi-btn vi-btn-primary w-100 w-sm-auto" id="ac-btnGuardarCrear">
                    <i class="fas fa-save" aria-hidden="true"></i> Guardar pieza
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL: Editar pieza (cantidad / comentario) ===== -->
<div class="modal fade" id="ac-modalEditarPieza" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title"><i class="fas fa-pen me-2"></i>Editar pieza</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="ac-desglose-stats mb-3">
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Folio</span>
                        <span class="ac-desglose-stat-value" id="ac-edit-folio">-</span>
                    </div>
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Producto</span>
                        <span class="ac-desglose-stat-value" id="ac-edit-producto">-</span>
                    </div>
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Longitud</span>
                        <span class="ac-desglose-stat-value"><strong id="ac-edit-longitud">0</strong> m</span>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-12 col-sm-6">
                        <label class="vi-label" for="ac-edit-cantidad"><i class="fas fa-cubes" aria-hidden="true"></i>Cantidad de piezas</label>
                        <input type="number" id="ac-edit-cantidad" class="vi-control" min="0" step="1">
                    </div>
                    <div class="col-12">
                        <label class="vi-label" for="ac-edit-comentario"><i class="fas fa-comment" aria-hidden="true"></i>Comentario</label>
                        <input type="text" id="ac-edit-comentario" class="vi-control" placeholder="Opcional" autocomplete="off">
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="vi-btn vi-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="vi-btn vi-btn-primary" id="ac-btnGuardarEditar">
                    <i class="fas fa-save"></i> Guardar cambios
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL: Dividir pieza ===== -->
<div class="modal fade" id="ac-modalDividir" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title"><i class="fas fa-cut me-2"></i>Dividir pieza</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="ac-desglose-stats mb-3">
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Folio origen</span>
                        <span class="ac-desglose-stat-value" id="ac-div-folio">-</span>
                    </div>
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Producto</span>
                        <span class="ac-desglose-stat-value" id="ac-div-producto">-</span>
                    </div>
                    <div class="ac-desglose-stat">
                        <span class="ac-desglose-stat-label">Longitud base</span>
                        <span class="ac-desglose-stat-value"><strong id="ac-div-longitud">0</strong> m</span>
