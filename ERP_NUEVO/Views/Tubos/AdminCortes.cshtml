                        <span class="vt-corte-resumen-valor" id="ac-div-restante">0.00</span>
                        <span class="vt-corte-resumen-unidad">metros</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="vi-btn vi-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="vi-btn vi-btn-primary" id="ac-btnGuardarDividir">
                    <i class="fas fa-save"></i> Dividir pieza
                </button>
            </div>
        </div>
    </div>
</div>

