@{
    ViewData["Title"] = "Operación de Cortes";
}

<style>
    .co-card {
        border: 1px solid var(--border-light);
        border-radius: var(--table-radius, 16px);
        background: var(--bg-light);
        box-shadow: var(--shadow);
    }

    .co-pedido-grupo {
        margin-bottom: 2rem;
    }

    .co-pedido-header {
        border-bottom: 2px solid var(--border-light);
        padding-bottom: .6rem;
        margin-bottom: 1rem;
    }

    .co-cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 1rem;
    }

    .co-card-corte {
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        background: var(--bg-light);
        box-shadow: var(--shadow);
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: .65rem;
        transition: box-shadow var(--transition-fast), border-color var(--transition-fast);
    }

        .co-card-corte:hover {
            box-shadow: var(--shadow-lg);
        }

        .co-card-corte.confirmado {
            border-color: var(--success-color);
            background: color-mix(in srgb, var(--success-color) 8%, var(--bg-light));
        }

    .co-card-corte-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: .5rem;
    }

    .co-card-corte-producto {
        font-weight: 700;
        font-size: .9rem;
        line-height: 1.3;
        color: var(--text-dark);
    }

        .co-card-corte-producto i {
            color: var(--accent-blue);
        }

    .co-card-corte-descr {
        font-size: .78rem;
        color: var(--text-light);
        margin-top: .1rem;
    }

    .co-card-corte-body {
        display: flex;
        flex-direction: column;
        gap: .4rem;
        font-size: .8rem;
    }

    .co-card-corte-fila {
        display: flex;
        justify-content: space-between;
        gap: .5rem;
    }

        .co-card-corte-fila span:first-child {
            color: var(--text-light);
        }

        .co-card-corte-fila span:last-child {
            font-weight: 600;
            color: var(--text-dark);
            text-align: right;
        }

    /* --- Código de barras de la pieza física a tomar --- */
    .co-card-corte-pieza {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: .2rem;
        background: #fff;
        border: 1px dashed var(--border-light);
        border-radius: var(--row-radius, 8px);
        padding: .4rem .3rem .3rem;
    }

        .co-card-corte-pieza svg {
            max-width: 100%;
            height: auto;
        }

        .co-card-corte-pieza span {
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .03em;
            color: var(--text-light);
            text-transform: uppercase;
        }

    .co-card-corte-comentario {
        font-size: .75rem;
        color: var(--text-light);
        font-style: italic;
        border-top: 1px dashed var(--border-light);
        padding-top: .4rem;
    }

    .co-card-corte-footer {
        margin-top: auto;
        padding-top: .6rem;
        border-top: 1px solid var(--border-light);
        display: flex;
        flex-direction: column;
        gap: .5rem;
    }

    .co-card-corte-acciones {
        display: flex;
        gap: .4rem;
        flex-wrap: wrap;
    }

        .co-card-corte-acciones .vi-btn {
            flex: 1;
            padding: .4rem .5rem;
            font-size: .78rem;
            white-space: nowrap;
        }

    .co-card-corte-usuario {
        font-size: .75rem;
        color: var(--text-light);
        text-align: right;
    }

    /* --- Botones vi-btn (idénticos a Admin Cortes, para consistencia) --- */
    .vi-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .45rem;
        padding: .55rem 1.1rem;
        border-radius: var(--row-radius, 8px);
        border: 1px solid transparent;
        font-size: .875rem;
        font-weight: 600;
        line-height: 1.2;
        cursor: pointer;
        transition: background-color var(--transition-fast), border-color var(--transition-fast), box-shadow var(--transition-fast), transform .05s ease;
        white-space: nowrap;
    }

        .vi-btn:active {
            transform: translateY(1px);
        }

        .vi-btn:focus-visible {
            outline: 2px solid var(--accent-blue);
            outline-offset: 2px;
        }

    .vi-btn-primary {
        background: var(--primary-blue);
        border-color: var(--primary-blue);
        color: #fff;
    }

        .vi-btn-primary:hover:not(:disabled) {
            background: var(--primary-blue-dark);
            border-color: var(--primary-blue-dark);
        }

    .vi-btn-success {
        background: var(--success-color);
        border-color: var(--success-color);
        color: #fff;
    }

        .vi-btn-success:hover:not(:disabled) {
            filter: brightness(0.9);
        }

    .vi-btn-outline {
        background: transparent;
        border-color: var(--primary-blue);
        color: var(--primary-blue);
    }

        .vi-btn-outline:hover:not(:disabled) {
            background: var(--very-light-blue);
        }

    .vi-btn-ghost {
        background: transparent;
        border-color: var(--border-light);
        color: var(--text-light);
    }

        .vi-btn-ghost:hover:not(:disabled) {
            background: var(--bg-gray);
            border-color: var(--text-light);
        }

    .vi-btn-sm {
        padding: .35rem .65rem;
        font-size: .78rem;
        border-radius: 6px;
    }

    .vi-label {
        display: flex;
        align-items: center;
        gap: .4rem;
        font-size: .8rem;
        font-weight: 600;
        color: var(--text-light);
        margin-bottom: .35rem;
    }

        .vi-label i {
            color: var(--accent-blue);
            width: 1rem;
            text-align: center;
        }

    .vi-modal-header {
        background: var(--primary-blue);
        color: #fff;
        border-bottom: none;
        border-top-left-radius: calc(var(--table-radius, 16px) - 4px);
        border-top-right-radius: calc(var(--table-radius, 16px) - 4px);
    }

        .vi-modal-header .modal-title {
            font-weight: 700;
            font-size: 1rem;
        }

    .vi-section-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--primary-blue);
        color: #fff;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

    /* --- Estados / badges --- */
    .co-badge-estatus {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
        padding: .2rem .6rem;
        border-radius: var(--badge-radius, 20px);
        white-space: nowrap;
    }

    .co-badge-reservado {
        background: color-mix(in srgb, var(--warning-color) 15%, transparent);
        color: var(--warning-color);
    }

    .co-badge-confirmado {
        background: color-mix(in srgb, var(--success-color) 15%, transparent);
        color: var(--success-color);
    }

    /* --- Modal reasignar: opciones de pieza --- */
    .co-lista-piezas-alt {
        max-height: 260px;
        overflow-y: auto;
    }

    .co-pieza-opcion {
        border: 1px solid var(--border-light);
        border-radius: var(--row-radius, 8px);
        padding: .6rem .9rem;
        margin-bottom: .5rem;
        cursor: pointer;
        background: var(--bg-light);
        color: var(--text-dark);
        transition: border-color var(--transition-fast), background var(--transition-fast);
    }

        .co-pieza-opcion:hover {
            border-color: var(--accent-blue);
            background: var(--very-light-blue);
        }

    @@media (max-width: 575.98px) {
        .co-cards-grid {
            grid-template-columns: 1fr;
        }
    }

    /* --- Resaltado de la tarjeta localizada al escanear el QR --- */
    .co-card-corte--flash {
        animation: coFlash 1.4s ease;
    }

    @@keyframes coFlash {
        0%, 100% {
            box-shadow: var(--shadow);
            border-color: var(--border-light);
        }

        20%, 60% {
            box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 55%, transparent), var(--shadow-lg);
            border-color: var(--accent-blue);
        }
    }

    /* --- Aviso de escáner activo --- */
    .co-scan-hint {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-size: .75rem;
        font-weight: 600;
        color: var(--accent-blue);
        background: var(--very-light-blue);
        border: 1px dashed color-mix(in srgb, var(--accent-blue) 45%, transparent);
        border-radius: var(--badge-radius, 20px);
        padding: .3rem .8rem;
    }

        .co-scan-hint i {
            animation: coScanPulse 1.6s ease-in-out infinite;
        }

    @@keyframes coScanPulse {
        0%, 100% {
            opacity: .55;
        }

        50% {
            opacity: 1;
        }
    }
</style>
<div class="vi-page">
    <div class="container-xl">

        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-cut"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Operación de Cortes</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Confirma o reasigna las piezas físicas usadas en cada pedido</p>
            </div>
            <div class="ms-auto d-flex align-items-center gap-2">
                <span class="co-scan-hint" title="Escanea el código de barras impreso en el ticket para confirmar el corte automáticamente">
                    <i class="fas fa-barcode"></i> Escáner listo — escanea el código del ticket
                </span>
                <button type="button" class="vi-btn vi-btn-ghost vi-btn-sm" id="co-btn-simular-escaneo"
                        title="Simula el escaneo de un ticket ingresando su asignación (para pruebas)">
                    <i class="fas fa-vial"></i> Simular escaneo
                </button>
            </div>
        </div>

        <!-- Buscador de pedido -->
        <!-- Buscador por fecha -->
        <div class="co-card p-3 mb-4">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="vi-label" for="co-fechaDesde">Desde</label>
                    <input type="date" id="co-fechaDesde" class="form-control">
                </div>
                <div class="col-6 col-md-3">
                    <label class="vi-label" for="co-fechaHasta">Hasta</label>
                    <input type="date" id="co-fechaHasta" class="form-control">
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" class="vi-btn vi-btn-primary w-100" id="co-btn-buscar">
                        <i class="fas fa-search"></i> Buscar
                    </button>
                </div>
                <div class="col-12 col-md-3">
                    <button type="button" class="vi-btn vi-btn-outline w-100" id="co-btn-hoy">
                        <i class="fas fa-calendar-day"></i> Hoy
                    </button>
                </div>
            </div>
        </div>

        <div id="co-spinner" class="text-center py-5 d-none">
            <div class="spinner-border text-primary"></div>
        </div>

        <div id="co-vacio" class="co-card p-5 text-center text-muted">
            <i class="fas fa-cut fa-3x mb-3 opacity-25"></i>
            <p class="mb-0">No hay cortes registrados para el rango de fechas seleccionado.</p>
        </div>

        <div id="co-resultados" class="co-card p-4 d-none">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0">Cortes del pedido</h5>
                <span class="vi-badge vi-badge-blue" id="co-total-cortes">0 cortes</span>
            </div>
            <div id="co-lista-cortes"></div>
        </div>

    </div>
</div>

<!-- ===== MODAL: Reasignar corte ===== -->
<div class="modal fade" id="co-modalReasignar" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title"><i class="fas fa-exchange-alt me-2"></i>Reasignar pieza de corte</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3 p-3" style="background:var(--vi-blue-50);border-radius:8px;">
                    <div><strong>Producto:</strong> <span id="co-reasignar-producto">-</span></div>
                    <div><strong>Longitud requerida:</strong> <span id="co-reasignar-longitud">0</span> m</div>
                    <div><strong>Pieza actualmente reservada:</strong> <span id="co-reasignar-folio-actual">-</span></div>
                </div>

                <label class="vi-label"><i class="fas fa-boxes"></i>Elige la pieza física a usar</label>
                <div id="co-lista-piezas-alt" class="co-lista-piezas-alt"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="vi-btn vi-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

<!-- ===== MODAL: Fecha de corte (del ticket físico) ===== -->
<div class="modal fade" id="co-modalFechaCorte" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header vi-modal-header">
                <h5 class="modal-title"><i class="fas fa-calendar-check me-2"></i>Fecha de finalización del corte</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small">Ingresa la fecha que se escribió a mano en el ticket al terminar el corte.</p>
                <label class="vi-label" for="co-fechaCorte-input"><i class="fas fa-calendar"></i>Fecha</label>
                <input type="datetime-local" id="co-fechaCorte-input" class="form-control">
            </div>
            <div class="modal-footer">
                <button type="button" class="vi-btn vi-btn-ghost" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="vi-btn vi-btn-primary" id="co-btnConfirmarFechaCorte">
                    <i class="fas fa-check"></i> Confirmar corte
                </button>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.8.2/jspdf.plugin.autotable.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jsbarcode/3.11.6/JsBarcode.all.min.js"></script>
    <script src="~/Scripts/Ventas/Tubos/codigo-barras.js"></script>
    <script src="~/Scripts/Ventas/Tubos/corteoperacion.js"></script>
}