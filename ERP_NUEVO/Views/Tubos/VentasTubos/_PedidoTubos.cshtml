    /* ===== BOTÓN FLOTANTE ===== */
    .vi-floating-btn {
        position: fixed;
        bottom: 30px;
        right: 30px;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--primary-blue-dark);
        color: #fff;
        border: none;
        font-size: 1.3rem;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(30,58,95,.4);
        transition: transform .3s, box-shadow .3s;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .vi-floating-btn:hover {
            transform: translateY(-4px) scale(1.05);
            box-shadow: 0 12px 35px rgba(30,58,95,.5);
        }

    .vi-floating-tooltip {
        position: fixed;
        bottom: 38px;
        right: 96px;
        background: var(--primary-blue-dark);
        color: #fff;
        padding: .4rem .9rem;
        border-radius: 8px;
        font-size: .8rem;
        white-space: nowrap;
        opacity: 0;
        pointer-events: none;
        transition: opacity .3s;
        z-index: 999;
    }

    .vi-floating-btn:hover + .vi-floating-tooltip {
        opacity: 1;
    }

    .vt-ped-btn-delete:hover {
        background-color: #bb2d3b;
        transform: translateY(-1px);
    }

    .vt-ped-btn-delete:active {
        transform: scale(0.96);
    }

    .vt-ped-btn-delete:disabled {
        background-color: #bdbdbd;
        cursor: not-allowed;
        opacity: 0.7;
    }

    .vt-ped-btn-corte {
        border: 1.5px solid var(--vi-gray-200);
        background: var(--bg-light, #fff);
        color: var(--vi-gray-600);
        border-radius: 6px;
        padding: .3rem .5rem;
        font-size: .75rem;
        cursor: pointer;
    }

        .vt-ped-btn-corte.con-cortes {
            border-color: #3b82f6;
            color: #3b82f6;
            background: var(--vi-blue-50);
            font-weight: 700;
        }

    .vt-ped-corte-warning {
        color: var(--vi-amber-600);
        font-size: .8rem;
        margin-top: 3px;
    }

    .vt-ped-corte-badge-ok {
    background: var(--vi-green-50);
    color: var(--vi-green-700);
    padding: .2rem .55rem;
    border-radius: 6px;
    font-size: .75rem;
    white-space: nowrap;
}
.vt-ped-corte-badge-error {
    background: var(--vi-red-50);
    color: var(--vi-red-600);
    padding: .2rem .55rem;
    border-radius: 6px;
    font-size: .75rem;
    white-space: nowrap;
}
.vt-ped-pieza-chip {
    background: #fff;
    border: 1px solid var(--vi-gray-200);
    border-radius: 6px;
    padding: .2rem .6rem;
    font-size: .75rem;
    color: var(--vi-gray-700);
}
.vt-ped-pieza-chip.usada {
    border-color: #3b82f6;
    color: #1e40af;
}

/* ===== Encabezado producto ===== */
.vt-corte-header {
    display: flex;
    gap: 2rem;
    flex-wrap: wrap;
    background: var(--vi-blue-50);
    border-radius: 10px;
    padding: .9rem 1.2rem;
}
.vt-corte-header-item {
    display: flex;
    flex-direction: column;
    gap: .1rem;
}
.vt-corte-header-label {
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .5px;
    color: var(--vi-gray-600, #6b7280);
    font-weight: 600;
}
.vt-corte-header-value {
    font-size: .95rem;
    font-weight: 700;
    color: var(--vi-gray-800, #1f2937);
}

/* ===== Texto guía ===== */
.vt-corte-guia {
    background: #fffbeb;
    border: 1px solid #fde68a;
    color: #92400e;
    border-radius: 8px;
    padding: .7rem 1rem;
    font-size: .8rem;
    display: flex;
    gap: .6rem;
    align-items: flex-start;
}
.vt-corte-guia i {
    margin-top: .1rem;
}

/* ===== Panel de inventario disponible ===== */
.vt-corte-inventario {
    border: 1px solid var(--vi-gray-200);
    border-radius: 10px;
    padding: .9rem 1.1rem;
    background: #fff;
}
.vt-corte-inventario-titulo {
    font-size: .8rem;
    font-weight: 700;
    color: var(--vi-gray-700, #374151);
    margin-bottom: .6rem;
}
.vt-corte-inventario-lista {
    display: flex;
    flex-direction: column;
    gap: .5rem;
}
.vt-corte-pieza-row {
    display: flex;
    align-items: center;
    gap: .8rem;
    font-size: .82rem;
}
.vt-corte-pieza-folio {
    min-width: 130px;
    font-weight: 600;
    color: var(--vi-gray-700);
}
.vt-corte-pieza-bar-wrap {
    flex: 1;
    height: 18px;
    background: var(--vi-gray-100, #f3f4f6);
    border-radius: 99px;
    overflow: hidden;
    position: relative;
}
.vt-corte-pieza-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, #3b82f6, #60a5fa);
    transition: width .3s;
}
.vt-corte-pieza-bar-fill.agotada {
    background: linear-gradient(90deg, #ef4444, #f87171);
}
.vt-corte-pieza-cantidad {
    min-width: 90px;
    text-align: right;
    color: var(--vi-gray-600);
    font-variant-numeric: tabular-nums;
}
.vt-corte-pieza-cantidad strong {
    color: var(--vi-gray-800);
}

/* ===== Alertas ===== */
.vt-corte-alerta {
    border-radius: 8px;
    padding: .7rem 1rem;
    font-size: .82rem;
    display: flex;
    gap: .6rem;
    align-items: center;
    margin-bottom: 1rem;
}
.vt-corte-alerta-error {
    background: var(--vi-red-50, #fef2f2);
    color: var(--vi-red-600, #dc2626);
    border: 1px solid #fecaca;
}

/* ===== Lista de piezas a cortar (tarjetas en vez de tabla) ===== */
.vt-corte-lista {
    display: flex;
    flex-direction: column;
    gap: .6rem;
    max-height: 360px;
    overflow-y: auto;
    padding-right: 4px;
}
.vt-corte-card {
    border: 1.5px solid var(--vi-gray-200);
    border-radius: 10px;
    padding: .8rem 1rem;
    background: #fff;
    display: grid;
    grid-template-columns: auto 1fr 1fr 1fr auto auto;
    gap: .8rem;
    align-items: center;
}
.vt-corte-card.ok { border-color: #86efac; background: #f0fdf4; }
.vt-corte-card.error { border-color: #fca5a5; background: #fef2f2; }

.vt-corte-card-numero {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--vi-gray-200);
    color: var(--vi-gray-700);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: .75rem;
    font-weight: 700;
}

.vt-corte-card-field label {
    display: block;
    font-size: .68rem;
    text-transform: uppercase;
    color: var(--vi-gray-500, #9ca3af);
    font-weight: 600;
    margin-bottom: .15rem;
}
.vt-corte-card-field input {
    width: 100%;
    border: 1px solid var(--vi-gray-200);
    border-radius: 6px;
    padding: .35rem .55rem;
    font-size: .85rem;
}

.vt-corte-card-status {
    display: flex;
    align-items: center;
    gap: .4rem;
    font-size: .78rem;
    font-weight: 600;
    white-space: nowrap;
}
.vt-corte-card-status.ok { color: #15803d; }
.vt-corte-card-status.error { color: #dc2626; }
.vt-corte-card-status.neutro { color: var(--vi-gray-400); }
.vt-corte-card-status small {
    display: block;
    font-weight: 400;
    color: var(--vi-gray-500);
}

.vt-corte-card-comentario {
    grid-column: 1 / -1;
}
.vt-corte-card-comentario input {
    width: 100%;
    border: 1px solid var(--vi-gray-200);
    border-radius: 6px;
    padding: .3rem .55rem;
    font-size: .8rem;
}

/* ===== Resumen final ===== */
.vt-corte-resumen-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: .8rem;
}
.vt-corte-resumen-card {
    border-radius: 10px;
    padding: .8rem 1rem;
    text-align: center;
    background: var(--vi-gray-50, #f9fafb);
    border: 1px solid var(--vi-gray-200);
}
.vt-corte-resumen-label {
    display: block;
    font-size: .68rem;
    text-transform: uppercase;
    color: var(--vi-gray-500);
    font-weight: 600;
    margin-bottom: .2rem;
}
.vt-corte-resumen-valor {
    display: block;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--vi-gray-800);
}
.vt-corte-resumen-unidad {
    font-size: .7rem;
    color: var(--vi-gray-500);
}
</style>

@{
    var role = Utilities.GetUserRole(User.Identity.Name);
}

<div class="vi-page">
    <div class="container-xl">

        <!-- Encabezado de página -->
        <div class="d-flex align-items-center gap-3 mb-4">
            <div class="vi-section-icon" style="width:2.75rem;height:2.75rem;border-radius:12px;">
                <i class="fas fa-file-invoice-dollar"></i>
            </div>
            <div>
                <h1 class="h4 mb-0 fw-bold" style="color:var(--vi-gray-800)">Nuevo Pedido</h1>
                <p class="mb-0 small" style="color:var(--vi-gray-600)">Complete los datos para generar el pedido</p>
            </div>
        </div>

        <form id="vt-ped-formCotizacion" class="vt-ped-formCotizacion" method="post">

            <!-- ===== FILA PRINCIPAL ===== -->
            <div class="row g-4">

                <!-- ========== COLUMNA IZQUIERDA ========== -->
                <div class="col-12 col-xl-8">

                    <!-- TARJETA: Tipo de Pago -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-credit-card"></i></div>
                            <h2 class="vi-section-title">Tipo de Pago</h2>
                        </div>

                        <input type="hidden" name="tipoPago" id="vt-ped-tipo-pago" value="contado">
                        <div class="vi-pay-toggle" id="vt-ped-toggle-pago">
                            <button type="button" class="vi-pay-btn active" data-val="contado"
                                    onclick="selectTipoPagoPed('contado')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-money-bill-wave"></i>
                                <span>Contado</span>
                            </button>
                            <button type="button" class="vi-pay-btn" data-val="credito"
                                    onclick="selectTipoPagoPed('credito')">
                                <div class="vi-pay-pill"></div>
                                <i class="fas fa-credit-card"></i>
                                <span>Crédito</span>
                            </button>
                        </div>
                    </div>

                    <!-- TARJETA: Información General -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-info-circle"></i></div>
                            <h2 class="vi-section-title">Información General</h2>
                        </div>
                        <div class="row g-3">
                            <div class="col-12 col-sm-4">
                                <label class="vi-label"><i class="fas fa-hashtag"></i>Folio</label>
                                <input type="text" id="vt-ped-folio" value="@Model.Folio" name="folio"
                                       class="vi-control" readonly autocomplete="off">
                            </div>
                            <!-- Sucursal / Almacén (ocultos por defecto) -->
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-building"></i>Sucursal</label>
                                <select class="vi-control form-select" id="vt-ped-sucursal" name="sucursal">
                                    <option selected>CEDIS</option>
                                </select>
                            </div>
                            <div class="col-12 col-sm-4 d-none">
                                <label class="vi-label"><i class="fas fa-warehouse"></i>Almacén</label>
                                <select class="vi-control form-select" id="vt-ped-almacen" name="almacen">
                                    <option selected>ALMACÉN GENERAL</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <!-- TARJETA: Información del Cliente -->
                    <div class="vi-card p-4 mb-4">
                        <div class="vi-section-header">
                            <div class="vi-section-icon"><i class="fas fa-user"></i></div>
                            <h2 class="vi-section-title">Información del Cliente</h2>
                        </div>

                        <div class="row g-3">
                            <!-- Buscador cliente -->
                            <div class="col-12">
                                <label class="vi-label"><i class="fas fa-search"></i>Cliente</label>
                                <div class="input-group" style="flex-wrap:nowrap">
                                    <button class="vi-btn vi-btn-primary" type="button"
                                            data-bs-toggle="modal" data-bs-target="#vt-ped-modalBuscarCliente">
                                        <i class="fas fa-search"></i> Buscar
                                    </button>
                                    <input type="text" name="cliente" class="vi-control" id="vt-ped-cliente"
                                           placeholder="Seleccione un cliente…" readonly
                                           style="border-radius:0 var(--vi-radius) var(--vi-radius) 0; border-left:none;">
                                </div>
                            </div>

                            <!-- RFC -->
                            <div class="col-12 col-sm-6">
                                <label class="vi-label"><i class="fas fa-id-card"></i>RFC</label>
                                <input type="text" name="rfc" id="vt-ped-rfc" class="vi-control" autocomplete="off">
                            </div>

                            <!-- Banner crédito -->
                            <div class="col-12">
                                <div id="vt-ped-credit-banner" style="display:none;" class="vi-credit-banner">
                                    <div id="vt-ped-credit-icon" style="font-size:18px;flex-shrink:0;margin-top:2px;"></div>
                                    <div style="flex:1">
                                        <div id="vt-ped-credit-title" style="font-weight:600;font-size:.8rem;margin-bottom:2px;"></div>
                                        <div id="vt-ped-credit-sub" style="font-size:.75rem;opacity:.85;"></div>
                                        <div class="vi-banner-bar-wrap" id="vt-ped-credit-bar-wrap">
