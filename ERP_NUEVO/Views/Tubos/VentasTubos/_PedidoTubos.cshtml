                                    <span class="vi-ticket-row-val" id="vt-ped-total-subtotal2-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">IVA (16%)</span>
                                    <span class="vi-ticket-row-val" id="vt-ped-iva-display">$0.00</span>
                                </div>
                            </div>
                            <div class="vi-ticket-footer">
                                <div class="vi-ticket-total-row">
                                    <span class="vi-ticket-total-label"><i class="fas fa-coins me-1"></i>Total</span>
                                    <strong class="vi-ticket-total-val" id="vt-ped-importe-display">$0.00</strong>
                                </div>
                            </div>

                            <!-- Hidden inputs -->
                            <input type="hidden" id="vt-ped-total-subtotal1" name="total-subtotal1" value="0.00">
                            <input type="hidden" id="vt-ped-total-descuento" name="total-descuento" value="0.00">
                            <input type="hidden" id="vt-ped-total-flete" name="total-flete" value="0.00">
                            <input type="hidden" id="vt-ped-total-subtotal2" name="total-subtotal2" value="0.00">
                            <input type="hidden" id="vt-ped-iva" name="iva" value="0.00">
                            <input type="hidden" id="vt-ped-importe" name="importe" value="0.00">
                            <input type="hidden" id="vt-ped-documentid" name="documentid">
                        </div>

                        <!-- Botones de acción -->
                        <div class="d-grid gap-2">
                            <button type="button" class="vi-btn vi-btn-outline d-none"
                                    data-bs-toggle="modal" data-bs-target="#vt-ped-modalVistaPrevia"
                                    onclick="actualizarVistaPreviaPedido()"
                                    style="width:100%;justify-content:center;">
                                <i class="fas fa-eye"></i> Vista Previa
                            </button>
                            <button type="button" class="vi-btn vi-btn-success vt-ped-btn-submit"
                                    style="width:100%;justify-content:center;padding:.85rem;">
                                <i class="fas fa-paper-plane"></i> Generar Pedido
                            </button>
                            <a href="#" class="vi-btn vi-btn-ghost"
                               style="width:100%;justify-content:center;text-decoration:none;">
                                <i class="fas fa-times"></i> Cancelar
                            </a>
                        </div>

                    </div>
                </div><!-- /col derecha -->

            </div><!-- /row -->
        </form>
    </div><!-- /container -->
</div><!-- /vi-page -->
