<script>
    /* ===== TOGGLE TIPO PAGO (3 estados) ===== */
    function selectTipoPagoPed(val) {
    document.querySelectorAll('#vt-ped-toggle-pago .vi-pay-btn')
    .forEach(o => o.classList.toggle('active', o.dataset.val === val));
    document.getElementById('vt-ped-tipo-pago').value = val;

    // ★ Sincronizar select de método de pago con el toggle
    const metodoPagoEl = document.getElementById('vt-ped-metodo-pago');
    if (metodoPagoEl) {
    metodoPagoEl.value = val === 'credito' ? 'PPD' : 'PUE';
    }

    const camposCredito = document.getElementById('vt-ped-campos-credito');
    const secProductos = document.getElementById('vt-ped-seccion-productos');
    camposCredito.style.display = 'none';

    if (val === 'contado') {
    limpiarCamposPed();
    secProductos.style.display = '';
    } else if (val === 'credito') {
    camposCredito.style.display = 'block';
    secProductos.style.display = '';
    }
    }

    function limpiarCamposPed() {
    limpiarCamposCreditoP();
    }

    function limpiarCamposCreditoP() {
    document.getElementById('vt-ped-limite-credito').value = '0.00';
    document.getElementById('vt-ped-plazo').value = '';
    document.getElementById('vt-ped-fecha-pago').value = '';
    }
    /* ===== TOGGLE FLETE ===== */
    document.getElementById('vt-ped-flete').addEventListener('change', function () {
    const inp = document.getElementById('vt-ped-flete-val');
    inp.classList.toggle('d-none', !this.checked);
    if (!this.checked) inp.value = '';
    });

    /* ===== TOGGLE ORDEN DE COMPRA ===== */
    document.getElementById('vt-ped-orden-compra-check').addEventListener('change', function () {
    const inp = document.getElementById('vt-ped-orden-compra-val');
    inp.classList.toggle('d-none', !this.checked);
    if (!this.checked) inp.value = '';
    });
</script>
