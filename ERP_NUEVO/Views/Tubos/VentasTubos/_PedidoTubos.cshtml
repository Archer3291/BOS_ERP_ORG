                                    <span class="vi-ticket-row-label">Descuento</span>
                                    <span class="vi-ticket-row-val vi-negative" id="vt-ped-total-descuento-display">-$0.00</span>
                                </div>
                                <div class="vi-ticket-row">
                                    <span class="vi-ticket-row-label">Flete</span>
                                    <span class="vi-ticket-row-val" id="vt-ped-total-flete-display">$0.00</span>
                                </div>
                                <div class="vi-ticket-row" style="margin-top:.5rem;padding-top:.75rem;border-top:1px solid var(--vi-gray-200);border-bottom:none;">
