@model BOS_ERP.Models.Factura
@using System.Data
@using System.Linq
@using BOS_ERP.Models;
@using System;
@using System.Collections.Generic;
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@using System.IO;
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor

@{
    Layout = null;

    // La factura internacional imprime los precios ya netos de descuento; la nacional
    // conserva el desglose (Desc % / Descuento) tal cual estaba. Tproductos trae
    // precioUnit e importe BRUTOS y descuento como porcentaje, y el complemento de
    // Comercio Exterior se timbro tambien sobre el bruto, asi que aqui se acumula la
    // proporcion neto/bruto por producto para netear lo que se muestra.
    bool esInternacional = Model.ComercioExterior != null;

    var ceBrutoPorProducto = new Dictionary<string, double>();
    var ceNetoPorProducto = new Dictionary<string, double>();
    double ceBrutoTotal = 0.0;
    double ceNetoTotal = 0.0;

    if (Model.Tproductos != null)
    {
        bool hayColDescuento = Model.Tproductos.Columns.Contains("descuento");

        foreach (System.Data.DataRow filaDesc in Model.Tproductos.Rows)
        {
            double cantFila = Convert.ToDouble(filaDesc["cantidad"]);
            double puFila = Convert.ToDouble(filaDesc["precioUnit"]);
            double pctFila = hayColDescuento && filaDesc["descuento"] != DBNull.Value
                ? Convert.ToDouble(filaDesc["descuento"])
                : 0.0;

            double brutoFila = cantFila * puFila;
            double netoFila = brutoFila - Math.Round(brutoFila * pctFila / 100, 2);
            string claveFila = filaDesc["numero"]?.ToString() ?? "";

            ceBrutoPorProducto.TryGetValue(claveFila, out double acumBruto);
            ceBrutoPorProducto[claveFila] = acumBruto + brutoFila;

            ceNetoPorProducto.TryGetValue(claveFila, out double acumNeto);
            ceNetoPorProducto[claveFila] = acumNeto + netoFila;

            ceBrutoTotal += brutoFila;
            ceNetoTotal += netoFila;
        }
    }

    double factorDescuentoGlobal = ceBrutoTotal > 0 ? ceNetoTotal / ceBrutoTotal : 1.0;

    // Factor de descuento de un producto (por No. de identificacion). Si el producto no
    // aparece en Tproductos se cae al factor global del comprobante.
    Func<string, double> factorDescuento = clave =>
    {
        if (!string.IsNullOrEmpty(clave)
            && ceBrutoPorProducto.TryGetValue(clave, out double brutoProd)
            && brutoProd > 0)
        {
            return ceNetoPorProducto[clave] / brutoProd;
        }

        return factorDescuentoGlobal;
    };
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>Factura @Model.UUID</title>
    <style>
        @@page {
            size: A4;
            margin: 15mm;
        }

        thead {
            display: table-header-group;
            background-color: #e0e0e0;
        }

        body {
            font-family: 'Segoe UI', Calibri, Arial, sans-serif;
            font-size: 11px;
            color: #1a1a1a;
            line-height: 1.3;
            letter-spacing: 0.3px;
            margin: 0;
            padding: 0;
        }

        h1, h2 {
            color: #d32f2f;
        }

        table {
            border-collapse: collapse;
            width: 100%;
        }

        th {
            background-color: #1976d2;
            color: white;
            padding: 6px 8px;
            text-align: left;
            font-size: 10px;
            letter-spacing: 0.4px;
        }

        td {
            padding: 4px 8px;
            vertical-align: top;
        }

        .section-title {
            font-size: 13px;
            color: #d32f2f;
            margin-top: 15px;
            margin-bottom: 8px;
            border-bottom: 1px solid #ccc;
            padding-bottom: 3px;
            text-transform: uppercase;
            font-weight: bold;
            letter-spacing: 0.5px;
        }

        .productos th, .productos td {
            border: 1px solid #bbb;
            font-size: 10px;
            padding: 5px 6px;
            line-height: 1.3;
        }

        .productos tbody tr:nth-child(even) {
            background-color: #f5f5f5;
        }

        .productos td.descripcion {
            font-weight: 500;
        }

        .productos td.numero {
            text-align: center;
            width: 8%;
        }

        .productos td.cantidad,
        .productos td.precio,
        .productos td.importe {
            text-align: right;
        }

        .totales {
            margin-top: 20px;
            text-align: right;
            font-size: 12px;
        }

            .totales span {
                font-weight: bold;
                color: #1976d2;
            }

        .sello {
            word-break: break-word;
            white-space: pre-wrap;
            font-family: 'Courier New', monospace;
            font-size: 9px;
            background-color: #f9f9f9;
            border: 1px dashed #aaa;
            padding: 6px;
            margin-bottom: 8px;
        }

        .qr {
            text-align: center;
            margin-top: 20px;
        }

            .qr img {
                width: 150px;
                height: 150px;
            }

        .info-box {
            border: 1px solid #ccc;
            padding: 6px;
            margin-top: 3px;
            background-color: #fafafa;
            line-height: 1.3;
        }

            .info-box strong {
                color: #333;
            }

        .productos {
            page-break-inside: auto;
        }

            .productos thead {
                display: table-header-group;
            }

            .productos tfoot {
                display: table-footer-group;
            }

            .productos tr {
                page-break-inside: avoid;
                page-break-after: auto;
            }

        .observaciones-box {
            background-color: #fff8e1;
            border-left: 3px solid #ffc107;
            padding: 6px;
            margin: 12px 0;
            font-size: 10px;
        }

        .totales-table {
            width: 100%;
            margin-top: 20px;
        }

            .totales-table td {
                vertical-align: top;
            }

        .flete-row {
            background-color: #e8f5e9 !important;
            font-style: italic;
        }

        /* ── Comercio Exterior ── */
        .comercio-exterior-box {
            background: #fff;
            border: 3px solid #1976d2;
            border-radius: 6px;
            margin: 20px 0;
            overflow: hidden;
            page-break-inside: avoid;
        }

        .comercio-exterior-title {
            font-size: 14px;
            color: #0d47a1;
            background: linear-gradient(135deg, #e3f2fd 0%, #bbdefb 100%);
            margin: 0;
            padding: 12px 15px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.8px;
            border-bottom: 4px solid #1976d2;
        }

        .ce-datos-generales {
            padding: 15px;
            background-color: #fafafa;
            border-bottom: 2px solid #e0e0e0;
        }

            .ce-datos-generales table {
                width: 100%;
                font-size: 10px;
                border-collapse: collapse;
            }

            .ce-datos-generales td {
                padding: 5px 10px;
                border: 1px solid #e0e0e0;
            }

                .ce-datos-generales td:nth-child(odd) {
                    background-color: #e3f2fd;
                    font-weight: 700;
                    color: #0d47a1;
                }

        .ce-subsection {
            margin: 0;
            padding: 15px;
            background-color: #fafafa;
            border-top: 2px solid #e0e0e0;
        }

        .ce-subsection-title {
            font-weight: bold;
            color: #0d47a1;
            background: linear-gradient(90deg, #e3f2fd 0%, #bbdefb 100%);
            margin: -15px -15px 15px -15px;
            padding: 10px 15px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            border-left: 5px solid #1976d2;
            border-bottom: 2px solid #1976d2;
        }

        .ce-subsection table {
            width: 100%;
            font-size: 10px;
            border-collapse: collapse;
            background-color: #fff;
        }

        .ce-subsection td {
            padding: 5px 10px;
            border: 1px solid #e0e0e0;
        }

            .ce-subsection td:nth-child(odd) {
                background-color: #e3f2fd;
                font-weight: 700;
                color: #0d47a1;
            }

        .ce-valor-destacado {
            color: #0d47a1;
            font-weight: bold;
            background-color: #e3f2fd;
            padding: 2px 6px;
            border-radius: 3px;
            border-left: 3px solid #1976d2;
            display: inline-block;
        }

        .ce-badge-moneda {
            display: inline-block;
            background: linear-gradient(135deg, #43a047 0%, #66bb6a 100%);
            color: #fff;
            padding: 2px 7px;
            border-radius: 3px;
            font-size: 8px;
            font-weight: bold;
            text-transform: uppercase;
            margin-left: 4px;
        }

        .ce-info-box {
            background-color: #fff8e1;
            border-left: 5px solid #ffa726;
            padding: 10px;
            margin: 10px 0;
            border-radius: 3px;
            font-size: 10px;
        }

            .ce-info-box strong {
                color: #e65100;
            }
    </style>
</head>
<body>
    <!-- DATOS COMPROBANTE -->
    <div class="section-title">Datos del Comprobante</div>
    <table>
        <tr>
            <td style="width: 18%;"><strong>Fecha de Emisión:</strong></td>
            <td style="width: 32%;">@Model.Fecha.ToString("dd/MM/yyyy HH:mm:ss")</td>
            <td style="width: 18%;"><strong>Tipo de Comprobante:</strong></td>
            <td style="width: 32%;">@Model.TipoDeComprobante</td>
        </tr>
        <tr>
            <td><strong>Forma de Pago:</strong></td>
            <td>@Model.IdTipoPago @(string.IsNullOrEmpty(Model.formaPagoTexto) ? "" : "-- " + Model.formaPagoTexto)</td>
            <td><strong>Método de Pago:</strong></td>
            <td>@Model.metodoPagoTexto @(string.IsNullOrEmpty(Model.MdpFactura) ? "" : "-- " + Model.MdpFactura)</td>
        </tr>
        <tr>
            <td><strong>Moneda:</strong></td>
            <td>@Model.Moneda</td>
            <td><strong>Tipo de Cambio:</strong></td>
            <td>@Model.TipoCambio</td>
        </tr>
    </table>

    <!-- CFDIs RELACIONADOS (si aplica: sustitución, notas, anticipos, etc.) -->
    @if (!string.IsNullOrWhiteSpace(Model.UUIDsRelacionados))
    {
        var descRel = Model.TipoRelacion switch
        {
            "01" => "Nota de crédito de los documentos relacionados",
            "02" => "Nota de débito de los documentos relacionados",
            "03" => "Devolución de mercancía sobre facturas o traslados previos",
            "04" => "Sustitución de los CFDI previos",
            "05" => "Traslados de mercancías facturados previamente",
            "06" => "Factura generada por los traslados previos",
            "07" => "CFDI por aplicación de anticipo",
            _ => ""
        };
        <div class="section-title">CFDI(s) Relacionado(s)</div>
        <div class="info-box">
            <table style="width: 100%;">
                <tr>
                    <td style="width: 18%;"><strong>Tipo de relación:</strong></td>
                    <td colspan="3">@Model.TipoRelacion@(string.IsNullOrEmpty(descRel) ? "" : " - " + descRel)</td>
                </tr>
                @foreach (var uuidRel in Model.UUIDsRelacionados.Split(',', StringSplitOptions.RemoveEmptyEntries))
                {
                    <tr>
                        <td><strong>UUID relacionado:</strong></td>
                        <td colspan="3" style="font-family: 'Consolas', monospace; font-size: 9px;">@uuidRel.Trim()</td>
                    </tr>
                }
            </table>
        </div>
    }

    <!-- RECEPTOR -->
    <div class="section-title">Receptor</div>
    <div class="info-box">
        <table style="width: 100%;">
            <tr>
                <td style="width: 18%;"><strong>RFC:</strong></td>
                <td style="width: 32%;">@Model.RfcCliente</td>
                <td style="width: 18%;"><strong>Régimen Fiscal:</strong></td>
                <td style="width: 32%;">@Model.Regc</td>
            </tr>
            <tr>
                <td><strong>Razón Social:</strong></td>
                <td colspan="3">@Model.RsoCliente</td>
            </tr>
            <tr>
                <td><strong>Uso CFDI:</strong></td>
                <td>@Model.IdUsoCFDI @(string.IsNullOrEmpty(Model.CFDIText) ? "" : "-- " + Model.CFDIText)</td>
                <td><strong>Domicilio Fiscal (C.P.):</strong></td>
                <td>@Model.CpR</td>
            </tr>
            <tr>
                <td style="vertical-align:top;"><strong>Dirección:</strong></td>
                <td colspan="3" style="white-space: pre-line;">@Model.DireccionReceptor</td>
            </tr>
        </table>
    </div>

    <!-- CONCEPTOS -->
    <div class="section-title">Conceptos</div>
    <table class="productos">
        <thead class="table-light">
            <tr>
                <th style="width: 8%;">No. Identificación</th>
                <th style="@(esInternacional ? "width: 54%;" : "width: 34%;")">Descripción</th>
                <th style="width: 8%;">Cantidad</th>
                <th style="width: 8%;">Unidad</th>
                <th style="width: 12%;">Precio Unitario</th>
                @if (!esInternacional)
                {
                    <th style="width: 8%;">Desc %</th>
                    <th style="width: 12%;">Descuento</th>
                }
                <th style="width: 10%;">Importe</th>
            </tr>
        </thead>
        <tbody>
            @foreach (System.Data.DataRow row in Model.Tproductos.Rows)
            {
                <tr>
                    <td class="numero">@row["numero"]</td>
                    <td class="descripcion">
                        <strong>@row["descripcion"]</strong>
                        <br><small style="color: #888;">Clave Prod/Serv: @row["claveProdServ"] | Clave Unidad: @row["claveUnidad"] | Objeto Imp: @row["objetoImp"]</small>

                        @if (row.Table.Columns.Contains("comentario") && !string.IsNullOrWhiteSpace(row["comentario"]?.ToString()))
                        {
                            <br><small style="color: #555; font-style: italic; background-color: #fffacd; padding: 2px 4px; border-left: 2px solid #ffc107;">
                                @row["comentario"]
                            </small>
                        }
                    </td>
                    @{
                        double descPct = row.Table.Columns.Contains("descuento")
                            ? Convert.ToDouble(row["descuento"])
                            : 0;
                        double cantRow = Convert.ToDouble(row["cantidad"]);
                        double precioRow = Convert.ToDouble(row["precioUnit"]);
                        double montoDesc = Math.Round(cantRow * precioRow * (descPct / 100.0), 2);
                        // El CFDI guarda ValorUnitario e Importe en bruto. En la internacional
                        // se imprimen ya netos; en la nacional se respeta el desglose de siempre.
                        double precioUnitFila = esInternacional
                            ? precioRow * (1 - descPct / 100.0)
                            : precioRow;
                        double importeFila = esInternacional
                            ? Convert.ToDouble(row["importe"]) - montoDesc
                            : Convert.ToDouble(row["importe"]);
                    }

                    <td class="cantidad">@string.Format("{0:N2}", row["cantidad"])</td>
                    <td class="numero">@row["unidad"]</td>
                    <td class="precio">@string.Format("{0:C2}", precioUnitFila)</td>
                    @if (!esInternacional)
                    {
                        <td class="numero">@(descPct > 0 ? descPct.ToString("0.##") + "%" : "-")</td>
                        <td class="precio" style="color: #c62828;">
                            @(descPct > 0 ? string.Format("{0:C2}", montoDesc) : "-")
                        </td>
                    }
                    <td class="importe">@string.Format("{0:C2}", importeFila)</td>
                </tr>
            }

            @* Flete si existe *@
            @if (Model.Flete > 0)
            {
                <tr class="flete-row">
                    <td class="numero">FLETE</td>
                    <td class="descripcion">
                        <strong>Servicio de flete</strong>
                        <br><small style="color: #888;">Clave Prod/Serv: 78101800 | Clave Unidad: E48 | Objeto Imp: 02</small>
                    </td>
                    <td class="cantidad">1.00</td>
                    <td class="numero">Servicio</td>
                    <td class="precio">@string.Format("{0:C2}", Model.Flete)</td>
                    @if (!esInternacional)
                    {
                        <td class="numero">-</td>
                        <td class="numero">-</td>
                    }
                    <td class="importe">@string.Format("{0:C2}", Model.Flete)</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- COMERCIO EXTERIOR (solo si el CFDI trae el complemento) -->
    @if (Model.ComercioExterior != null)
    {
        var ce = Model.ComercioExterior;
        <div class="comercio-exterior-box">
            <div class="comercio-exterior-title">Complemento de Comercio Exterior v@(string.IsNullOrEmpty(ce.Version) ? "2.0" : ce.Version)</div>

            <div class="ce-datos-generales">
                <table>
                    @{
                        var camposGenerales = new List<(string Label, string Valor)>();
                        if (!string.IsNullOrEmpty(ce.MotivoTraslado)) { camposGenerales.Add(("Motivo Traslado", ce.MotivoTraslado)); }
                        if (!string.IsNullOrEmpty(ce.ClaveDePedimento)) { camposGenerales.Add(("Clave Pedimento", ce.ClaveDePedimento)); }
                        if (!string.IsNullOrEmpty(ce.Incoterm)) { camposGenerales.Add(("Incoterm", ce.Incoterm)); }
                        if (!string.IsNullOrEmpty(ce.CertificadoOrigen)) { camposGenerales.Add(("Certificado Origen", ce.CertificadoOrigen + (!string.IsNullOrEmpty(ce.NumCertificadoOrigen) ? $" - {ce.NumCertificadoOrigen}" : ""))); }
                        if (!string.IsNullOrEmpty(ce.NumeroExportadorConfiable)) { camposGenerales.Add(("Exportador Confiable", ce.NumeroExportadorConfiable)); }
                        if (ce.TipoCambioUSD > 0) { camposGenerales.Add(("Tipo Cambio USD", ce.TipoCambioUSD.ToString("N4"))); }

                        for (int i = 0; i < camposGenerales.Count; i += 2)
                        {
                            <tr>
                                <td style="width: 25%;"><strong>@camposGenerales[i].Label</strong></td>
                                <td style="width: 25%;">@camposGenerales[i].Valor</td>
                                @if (i + 1 < camposGenerales.Count)
                                {
                                    <td style="width: 25%;"><strong>@camposGenerales[i + 1].Label</strong></td>
                                    <td style="width: 25%;">@camposGenerales[i + 1].Valor</td>
                                }
                                else
                                {
                                    <td colspan="2" style="border: none; background: transparent;"></td>
                                }
                            </tr>
                        }

                        // Fila especial de totales USD. El complemento se timbro sobre el
                        // importe BRUTO, asi que se muestran los dos: el total del complemento
                        // y ese mismo total ya con el descuento aplicado.
                        if (ce.TipoCambioUSD > 0)
                        {
                            // Se suman las partidas ya neteadas para que este total coincida
                            // exactamente con la columna Valor USD del detalle de mercancias.
                            decimal totalUsdConDescuento = ce.Mercancias != null && ce.Mercancias.Any()
                                ? ce.Mercancias.Sum(m => Math.Round(
                                    m.ValorDolares * (decimal)factorDescuento(m.NoIdentificacion),
                                    2, MidpointRounding.AwayFromZero))
                                : Math.Round(ce.TotalUSD * (decimal)factorDescuentoGlobal,
                                    2, MidpointRounding.AwayFromZero);

                            <tr style="background: linear-gradient(to right, #e8f5e9 0%, #c8e6c9 100%) !important;">
                                <td><strong>Total USD</strong></td>
                                <td>
                                    <span class="ce-valor-destacado">$@ce.TotalUSD.ToString("N2")</span>
                                    <span class="ce-badge-moneda">USD</span>
                                </td>
                                <td><strong>Total USD con Descuento</strong></td>
                                <td>
                                    <span class="ce-valor-destacado">$@totalUsdConDescuento.ToString("N2")</span>
                                    <span class="ce-badge-moneda">USD</span>
                                </td>
                            </tr>
                        }
                    }
                </table>
            </div>

            <!-- DOMICILIO EMISOR -->
            @if (ce.DomicilioEmisor != null)
            {
                var d = ce.DomicilioEmisor;
                var campos = new List<(string Label, string Valor)>();
                if (!string.IsNullOrEmpty(d.Calle)) { campos.Add(("Calle", d.Calle)); }
                if (!string.IsNullOrEmpty(d.NumeroExterior)) { campos.Add(("Número", d.NumeroExterior)); }
                if (!string.IsNullOrEmpty(d.Colonia)) { campos.Add(("Colonia", d.Colonia)); }
                if (!string.IsNullOrEmpty(d.CodigoPostal)) { campos.Add(("C.P.", d.CodigoPostal)); }
                if (!string.IsNullOrEmpty(d.Localidad)) { campos.Add(("Localidad", d.Localidad)); }
                if (!string.IsNullOrEmpty(d.Municipio)) { campos.Add(("Municipio", d.Municipio)); }
                if (!string.IsNullOrEmpty(d.Estado)) { campos.Add(("Estado", d.Estado)); }
                if (!string.IsNullOrEmpty(d.Pais)) { campos.Add(("País", d.Pais)); }

                if (campos.Any())
                {
                    <div class="ce-subsection">
                        <div class="ce-subsection-title">Domicilio Emisor</div>
                        <table>
                            @for (int i = 0; i < campos.Count; i += 2)
                            {
                                <tr>
                                    <td style="width: 20%;"><strong>@campos[i].Label</strong></td>
                                    <td style="width: 30%;">@campos[i].Valor</td>
                                    @if (i + 1 < campos.Count)
                                    {
                                        <td style="width: 20%;"><strong>@campos[i + 1].Label</strong></td>
                                        <td style="width: 30%;">@campos[i + 1].Valor</td>
                                    }
                                    else
                                    {
                                        <td colspan="2" style="border: none; background: transparent;"></td>
                                    }
                                </tr>
                            }
                        </table>
                    </div>
                }
            }

            <!-- DESTINATARIO / RECEPTOR EXTRANJERO -->
            @if (!string.IsNullOrEmpty(ce.NumRegIdTrib) || ce.DomicilioDestinatario != null)
            {
                var d = ce.DomicilioDestinatario;
                var campos = new List<(string Label, string Valor)>();
                if (d != null)
                {
                    if (!string.IsNullOrEmpty(d.Calle)) { campos.Add(("Calle", d.Calle)); }
                    if (!string.IsNullOrEmpty(d.NumeroExterior)) { campos.Add(("Número", d.NumeroExterior)); }
                    if (!string.IsNullOrEmpty(d.Colonia)) { campos.Add(("Colonia", d.Colonia)); }
                    if (!string.IsNullOrEmpty(d.CodigoPostal)) { campos.Add(("C.P.", d.CodigoPostal)); }
                    if (!string.IsNullOrEmpty(d.Localidad)) { campos.Add(("Localidad", d.Localidad)); }
                    if (!string.IsNullOrEmpty(d.Municipio)) { campos.Add(("Municipio", d.Municipio)); }
                    if (!string.IsNullOrEmpty(d.Estado)) { campos.Add(("Estado", d.Estado)); }
                    if (!string.IsNullOrEmpty(d.Pais)) { campos.Add(("País", d.Pais)); }
                }

                if (!string.IsNullOrEmpty(ce.NumRegIdTrib) || campos.Any())
                {
                    <div class="ce-subsection">
                        <div class="ce-subsection-title">Destinatario / Receptor</div>
                        @if (!string.IsNullOrEmpty(ce.NumRegIdTrib))
                        {
                            <div class="ce-info-box"><strong>Registro ID Tributario:</strong> @ce.NumRegIdTrib</div>
                        }
                        @if (campos.Any())
                        {
                            <table>
                                @for (int i = 0; i < campos.Count; i += 2)
                                {
                                    <tr>
                                        <td style="width: 20%;"><strong>@campos[i].Label</strong></td>
                                        <td style="width: 30%;">@campos[i].Valor</td>
                                        @if (i + 1 < campos.Count)
                                        {
                                            <td style="width: 20%;"><strong>@campos[i + 1].Label</strong></td>
                                            <td style="width: 30%;">@campos[i + 1].Valor</td>
                                        }
                                        else
                                        {
                                            <td colspan="2" style="border: none; background: transparent;"></td>
                                        }
                                    </tr>
                                }
                            </table>
                        }
                    </div>
                }
            }

            <!-- MERCANCÍAS -->
            @if (ce.Mercancias != null && ce.Mercancias.Any())
            {
                <div class="ce-subsection">
                    <div class="ce-subsection-title">Detalle de Mercancías</div>
                    <table class="productos">
                        <thead>
                            <tr>
                                <th style="width: 20%;">No. Ident.</th>
                                <th style="width: 20%;">Fracción Arancelaria</th>
                                <th style="width: 14%;">Cantidad</th>
                                <th style="width: 12%;">Unidad</th>
                                <th style="width: 16%;">Valor Unit.</th>
                                <th style="width: 18%;">Valor USD</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var merc in ce.Mercancias)
                            {
                                // Estos valores vienen del XML timbrado, o sea en BRUTO. Se netean
                                // para que el detalle coincida con el PDF emitido al timbrar; el
                                // total fiscal sigue arriba, en la fila de totales USD.
                                decimal factorMerc = (decimal)factorDescuento(merc.NoIdentificacion);
                                decimal valorUnitConDesc = Math.Round(
                                    merc.ValorUnitarioAduana * factorMerc, 2, MidpointRounding.AwayFromZero);
                                decimal valorDolaresConDesc = Math.Round(
                                    merc.ValorDolares * factorMerc, 2, MidpointRounding.AwayFromZero);

                                <tr>
                                    <td class="numero">@merc.NoIdentificacion</td>
                                    <td class="numero">@merc.FraccionArancelaria</td>
                                    <td class="cantidad">@merc.CantidadAduana.ToString("N2")</td>
                                    <td class="numero">@merc.UnidadAduana</td>
                                    <td class="precio">$@valorUnitConDesc.ToString("N2")</td>
                                    <td class="importe">
                                        <span class="ce-valor-destacado">$@valorDolaresConDesc.ToString("N2")</span>
                                        <span class="ce-badge-moneda">USD</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- ANTICIPOS RELACIONADOS -->
    @if (Model.TAnticipos != null && Model.TAnticipos.Rows.Count > 0)
    {
        <div class="section-title">CFDIs Relacionados (Anticipos Aplicados)</div>
        <table class="productos">
            <thead>
                <tr>
                    <th>UUID del CFDI</th>
                    <th>Fecha de Aplicación</th>
                    <th>Saldo Antes</th>
                    <th>Monto Aplicado</th>
                    <th>Saldo Después</th>
                </tr>
            </thead>
            <tbody>
                @foreach (System.Data.DataRow row in Model.TAnticipos.Rows)
                {
                    <tr style="background-color:#f0f8ff;">
                        <td>@row["uuid"]</td>
                        <td>@Convert.ToDateTime(row["fecha"]).ToString("dd/MM/yyyy HH:mm")</td>
                        <td style="text-align:right;">@string.Format("{0:C2}", row["saldo_antes"])</td>
                        <td style="text-align:right; color:#2e7d32; font-weight:bold;">@string.Format("{0:C2}", row["monto_aplicado"])</td>
                        <td style="text-align:right;">@string.Format("{0:C2}", row["saldo_despues"])</td>
                    </tr>
                }
                <tr style="background-color:#e3f2fd; font-weight:bold;">
                    <td colspan="3" style="text-align:right;">TOTAL ANTICIPOS APLICADOS:</td>
                    <td colspan="2" style="text-align:right; color:#d32f2f;">
                        @string.Format("{0:C2}", Model.TAnticipos.AsEnumerable().Sum(r => Convert.ToDecimal(r["monto_aplicado"])))
                    </td>
                </tr>
            </tbody>
        </table>
    }

    <!-- OBSERVACIONES -->
    @if (!string.IsNullOrEmpty(Model.Observaciones))
    {
        <div class="observaciones-box">
            <strong>Observaciones:</strong> @Model.Observaciones
        </div>
    }

    <!-- TOTALES -->
    @{
        decimal totalAnticiposPDF = 0;
        if (Model.TAnticipos != null && Model.TAnticipos.Rows.Count > 0)
        {
            totalAnticiposPDF = Model.TAnticipos.AsEnumerable()
                .Sum(r => Convert.ToDecimal(r["monto_aplicado"]));
        }

        decimal totalDescuentoPDF = 0;
        if (Model.Tproductos != null && Model.Tproductos.Columns.Contains("descuento"))
        {
            foreach (DataRow dr in Model.Tproductos.Rows)
            {
                double c = Convert.ToDouble(dr["cantidad"]);
                double p = Convert.ToDouble(dr["precioUnit"]);
                double d = Convert.ToDouble(dr["descuento"]);
                totalDescuentoPDF += (decimal)Math.Round(c * p * (d / 100.0), 2);
            }
        }
    }

    <table class="totales-table" style="width:100%; margin-top:20px; border-collapse:collapse;">
        <tr>
            <td style="width:60%; vertical-align:top; padding-right:20px;">
                <strong>Total con Letra:</strong><br>
                @Model.TotalTexto @Model.Moneda
            </td>
            <td style="width:40%; vertical-align:top;">
                <table style="width:100%; border-collapse:collapse;">

                <tr>
                    <td style="text-align:right;"><strong>Subtotal:</strong></td>
                    <td style="text-align:right;">
                        @string.Format("{0:C2}", Model.Subtotal)
                    </td>
                </tr>

                    @if (totalDescuentoPDF > 0)
                    {
@*                         <tr>
                            <td style="text-align:right; width:60%;"><strong>Subtotal bruto:</strong></td>
                            <td style="text-align:right; width:40%;">
                                @string.Format("{0:C2}", Model.Subtotal + totalDescuentoPDF)
                            </td>
                        </tr> *@
                        <tr>
                            <td style="text-align:right; color:#c62828;"><strong>Descuento:</strong></td>
                            <td style="text-align:right; color:#c62828;">
                                -@string.Format("{0:C2}", totalDescuentoPDF)
                            </td>
                        </tr>
                    }                
                    @if (Model.Flete > 0)
                    {
                        <tr>
                            <td style="text-align:right;"><strong>Flete:</strong></td>
                            <td style="text-align:right;">@string.Format("{0:C2}", Model.Flete)</td>
                        </tr>
                    }

                    <tr>
                        <td style="text-align:right;"><strong>IVA (@(Model.IVA > 0 ? "16" : "0")%):</strong></td>
                        <td style="text-align:right;">@string.Format("{0:C2}", Model.IVA)</td>
                    </tr>

                    @if (totalAnticiposPDF > 0)
                    {
                        <tr>
                            <td style="text-align:right; color:#2e7d32;"><strong>Anticipos aplicados:</strong></td>
                            <td style="text-align:right; color:#2e7d32;">
                                -@string.Format("{0:C2}", totalAnticiposPDF)
                            </td>
                        </tr>
                    }

                    <tr style="border-top:2px solid #1976d2; background:#e3f2fd;">
                        <td style="text-align:right; font-size:1.1em; padding:6px 10px;">
                            <strong>TOTAL:</strong>
                        </td>
                        <td style="text-align:right; font-size:1.1em; color:#d32f2f; padding:6px 10px;">
                            <strong>@string.Format("{0:C2}", Model.Total)</strong>
                        </td>
                    </tr>

                </table>
            </td>
        </tr>
    </table>

    <!-- PAGARÉ (no aplica en exportaciones con Comercio Exterior) -->
    @if (Model.ComercioExterior == null)
    {
        string perfil = HttpContextAccessor.HttpContext.Session.GetString("EmpresaFactura");
        string razonSocialEmisor = Configuration[$"Emisores:{perfil}:RazonSocial"] ?? Model.RsoEmisor ?? "";

        <div style="margin-top: 20px;">
            <p style="font-size: 9px; color: #666; font-style: italic; margin-bottom: 10px;">
                Las diferencias de centavos que se puedan presentar, son producto del redondeo en los importes.
            </p>

            <div style="border: 2px solid #333; padding: 15px; background-color: #fafafa; margin-top: 10px;">
                <p style="font-size: 10px; line-height: 1.6; text-align: justify; margin: 0;">
                    Debo(emos) y pagaremos en forma incondicional a la orden de <strong>@razonSocialEmisor</strong>
                    en la ciudad de San Luis Potosí, San Luis Potosí, el importe que ampara el total de esta factura recibida a nuestra
                    satisfacción el día _______ de _________ de _______. En caso de demora en el pago, causara un interés del
                    _____%, este pagare es mercantil y esta regido por la Ley General de Títulos y operaciones en su articulo 170.
                </p>

                <div style="margin-top: 30px; text-align: center;">
                    <div style="border-top: 1px solid #333; width: 200px; margin: 0 auto;"></div>
                    <p style="margin: 5px 0 0 0; font-size: 10px;"><strong>ACEPTO</strong></p>
                </div>
            </div>
        </div>
    }

    <!-- SELLOS Y QR -->
    <div class="section-title" style="margin-top: 25px;">Sellos y Cadena Original</div>
    <table>
        <tr>
            <td style="width: 75%; vertical-align: top;">
                <p style="margin: 5px 0 3px 0;"><strong>No. de Serie del Certificado del SAT:</strong></p>
                <div class="sello">@Model.NoCertificadoSAT</div>

                <p style="margin: 8px 0 3px 0;"><strong>No de Serie del CSD del Emisor:</strong></p>
                <div class="sello">@Model.NoCertificado</div>

                <p style="margin: 8px 0 3px 0;"><strong>Sello CFDI:</strong></p>
                <div class="sello">@Model.SelloCFDI</div>

                <p style="margin: 8px 0 3px 0;"><strong>Sello SAT:</strong></p>
                <div class="sello">@Model.SelloSAT</div>

                <p style="margin: 8px 0 3px 0;"><strong>Cadena Original:</strong></p>
                <div class="sello">@Model.CadenaOriginal</div>
            </td>

            @if (!string.IsNullOrEmpty(Model.RutaQr))
            {
                <td style="width: 25%; text-align: center; vertical-align: top; padding-left: 10px;">
                    <strong style="display: block; margin-bottom: 8px;">Código QR</strong>
                    <img src="@Url.Content(Model.RutaQr)" alt="QR CFDI" style="width: 150px; height: 150px; border: 1px solid #ccc; padding: 5px; background: white;" />
                    <br><small style="color: #666;">Verificación SAT</small>
                </td>
            }
        </tr>
    </table>

    <!-- Footer -->
    <div style="text-align: center; margin-top: 25px; padding-top: 10px; border-top: 1px solid #ccc; font-size: 10px; color: #666;">
        <strong>Este documento es una representación impresa de un CFDI</strong><br>
        Generado el @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
    </div>

</body>
</html>
