@section scripts {
    <script src="~/lib/fullcalendar/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/locales-all.global.min.js"></script>
    <script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
    <script>
        const URLS = {
            catalogos: '@Url.Action("GetCatalogosSalas", "RecursosHumanos")',
            reservaciones: '@Url.Action("GetReservaciones", "RecursosHumanos")',
            reservar: '@Url.Action("ReservarSala", "RecursosHumanos")',
            editar: '@Url.Action("EditarReservacion", "RecursosHumanos")',
            cancelar: '@Url.Action("CancelarReservacion", "RecursosHumanos")',
            guardarSala: '@Url.Action("GuardarSala", "RecursosHumanos")',
            agenda: '@Url.Action("GetAgendaDia", "RecursosHumanos")',
            confirmar: '@Url.Action("ConfirmarAsistencia", "RecursosHumanos")'
        };

        const ESTADO_RESERVA = {
            reservada:  { texto: 'Reservada',  icono: 'fa-circle-check',   clase: 'is-activa' },
            confirmada: { texto: 'Confirmada', icono: 'fa-circle-check',   clase: 'is-activa' },
            en_curso:   { texto: 'En curso',   icono: 'fa-play',           clase: 'is-curso' },
            finalizada: { texto: 'Finalizada', icono: 'fa-flag-checkered', clase: 'is-finalizada' },
            cancelada:  { texto: 'Cancelada',  icono: 'fa-ban',            clase: 'is-cancelada' }
        };

        const COLOR_ESTADO = {
            en_curso: '#059669',
            finalizada: '#94a3b8',
            cancelada: '#dc2626'
        };

        const ASISTENCIA = {
            asistira: { texto: 'Asistirá', icono: 'fa-circle-check' },
            no_asistira: { texto: 'No asistirá', icono: 'fa-circle-xmark' },
            pendiente: { texto: 'Pendiente', icono: 'fa-clock' },
            cancelada: { texto: 'Cancelada', icono: 'fa-ban' }
        };

        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
            <style>
                .flip {
                    animation: spinY 2s linear infinite;
                    transform-origin: center;
                }
                @@keyframes spinY {
                    0%   { transform: rotateY(0deg); }
                    100% { transform: rotateY(360deg); }
                }
            </style>
            <g class="flip">
                <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                <circle cx="32" cy="48" r="3" fill="#000"/>
            </g>
        </svg>`;

        const PALETA = [
            '#3266ad', '#2a9d7a', '#c96a1a', '#9b59b6', '#e24b4a',
            '#1d9e75', '#0891b2', '#7c3aed', '#d97706', '#0f766e'
        ];

        const HORARIO = { 1: [9, 18], 2: [9, 18], 3: [9, 18], 4: [9, 18], 5: [9, 18], 6: [9, 14], 0: null };
        const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
        const PASO = 30;

        const Estado = {
            salas: [],
            usuarios: [],
            usuarioId: 0,
            esAdmin: false,
            eventos: [],
            volverAlDetalle: false,
            detalle: null
        };

        let calendario = null;
        let tsParticipantes = null;

        const escapeHtml = v => String(v ?? '').replace(/[&<>"']/g, ch => ({
            '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
        }[ch]));

        const dosDigitos = n => String(n).padStart(2, '0');
        const isoLocal = d => `${d.getFullYear()}-${dosDigitos(d.getMonth() + 1)}-${dosDigitos(d.getDate())}T${dosDigitos(d.getHours())}:${dosDigitos(d.getMinutes())}:00`;
        const isoFecha = d => `${d.getFullYear()}-${dosDigitos(d.getMonth() + 1)}-${dosDigitos(d.getDate())}`;
        const isoHora = d => `${dosDigitos(d.getHours())}:${dosDigitos(d.getMinutes())}`;
        const folio = id => 'SALA-' + String(id).padStart(6, '0');

        const modal = id => bootstrap.Modal.getOrCreateInstance(document.getElementById(id));

        function filaResumen(etiqueta, valor) {
            return `<tr>
                        <td style="padding:.28rem .6rem .28rem 0;text-align:right;white-space:nowrap;opacity:.7">${etiqueta}</td>
                        <td style="padding:.28rem 0;text-align:left;font-weight:600">${valor}</td>
                    </tr>`;
        }

        function tablaResumen(filas) {
            return `<table style="margin:.6rem auto 0;font-size:.9rem;text-align:left">${filas.join('')}</table>`;
        }

        function confirmar(opciones) {
            return _Swal.fire({
                iconHtml: warningIcon,
                customClass: { icon: 'p-0 bg-transparent border-0 shadow-none' },
                title: opciones.titulo,
                html: opciones.html,
                footer: opciones.footer ?? '',
                confirmButtonText: opciones.confirmar ?? 'Sí, continuar',
                cancelButtonText: 'Volver',
                confirmButtonColor: opciones.color ?? '#3085d6',
                reverseButtons: true,
                focusCancel: true
            }).then(r => r.isConfirmed);
        }

        async function enviar(path, data, mensaje) {
            Swal.fire({
                title: mensaje ?? 'Configurando reservacion, espere un momento...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            const res = await GetData({ path, data });
            if (!res) return null;

            toastMixin.fire(res);

            return res;
        }

        const colorSala = salaId => {
            const i = Estado.salas.findIndex(s => Number(s.id_sala) === Number(salaId));
            return PALETA[(i < 0 ? 0 : i) % PALETA.length];
        };

        const nombreSala = salaId => Estado.salas.find(s => Number(s.id_sala) === Number(salaId))?.nombre ?? 'Sala';

        // El estado manda sobre el color de la sala: saber de un vistazo qué sigue
        // vivo importa más que de qué sala es.
        const colorEvento = r => COLOR_ESTADO[r.estado] ?? colorSala(r.salaId);

        const infoEstado = estado => ESTADO_RESERVA[estado] ?? ESTADO_RESERVA.reservada;

        function rangoDia(fechaStr) {
            if (!fechaStr) return null;
            const [a, m, d] = fechaStr.split('-').map(Number);
            return HORARIO[new Date(a, m - 1, d).getDay()];
        }

        function minutosDe(hhmm) {
            const [h, m] = hhmm.split(':').map(Number);
            return h * 60 + m;
        }

        function llenarHoras(selectId, rango, desdeMin, hastaMin, seleccion) {
            const sel = document.getElementById(selectId);
            sel.innerHTML = '';

            if (!rango) {
                sel.innerHTML = '<option value="">No laborable</option>';
                sel.disabled = true;
                return;
            }

            sel.disabled = false;

            const inicio = desdeMin ?? rango[0] * 60;
            const fin = hastaMin ?? rango[1] * 60;

            for (let m = inicio; m <= fin; m += PASO) {
                const opt = document.createElement('option');
                opt.value = `${dosDigitos(Math.floor(m / 60))}:${dosDigitos(m % 60)}`;
                opt.textContent = opt.value;
                sel.appendChild(opt);
            }

            if (seleccion && [...sel.options].some(o => o.value === seleccion)) sel.value = seleccion;
        }

        function onFechaChange(horaInicio, horaFin) {
            const fecha = document.getElementById('r-fecha').value;
            const rango = rangoDia(fecha);
            const hint = document.getElementById('r-hint-dia');

            if (!fecha) {
                hint.innerHTML = '';
            } else if (!rango) {
                hint.innerHTML = '<i class="fa-solid fa-triangle-exclamation" style="color:var(--warning-color)"></i> Los domingos no son días laborales';
            } else {
                const [a, m, d] = fecha.split('-').map(Number);
                hint.innerHTML = `<i class="fa-solid fa-circle-info"></i> ${DIAS[new Date(a, m - 1, d).getDay()]}: ${dosDigitos(rango[0])}:00 a ${dosDigitos(rango[1])}:00`;
            }

            llenarHoras('r-inicio', rango, null, rango ? rango[1] * 60 - PASO : null, horaInicio);
            onInicioChange(horaFin);
        }

        function onInicioChange(horaFin) {
            const rango = rangoDia(document.getElementById('r-fecha').value);
            const inicio = document.getElementById('r-inicio').value;
            if (!rango || !inicio) { llenarHoras('r-fin', rango); return; }

            llenarHoras('r-fin', rango, minutosDe(inicio) + PASO, rango[1] * 60, horaFin);

            if (!horaFin) {
                const sel = document.getElementById('r-fin');
                const sugerida = `${dosDigitos(Math.floor((minutosDe(inicio) + 60) / 60))}:${dosDigitos((minutosDe(inicio) + 60) % 60)}`;
                if ([...sel.options].some(o => o.value === sugerida)) sel.value = sugerida;
            }
        }

        // ── Catálogos ──────────────────────────────────────────────────────
        async function cargarCatalogos() {
            const res = await GetData({ path: URLS.catalogos });
            if (!res) return;

            Estado.salas = res.salas ?? [];
            Estado.usuarios = res.usuarios ?? [];
            Estado.usuarioId = Number(res.usuarioId ?? 0);
            Estado.esAdmin = !!res.esAdmin;

            document.getElementById('btn-nueva-sala').style.display = Estado.esAdmin ? '' : 'none';

            const filtro = document.getElementById('f-sala');
            const form = document.getElementById('r-sala');
            filtro.innerHTML = '<option value="">Todas las salas</option>';
            form.innerHTML = '';

            Estado.salas.forEach(s => {
                filtro.insertAdjacentHTML('beforeend', `<option value="${s.id_sala}">${escapeHtml(s.nombre)}</option>`);
                form.insertAdjacentHTML('beforeend', `<option value="${s.id_sala}">${escapeHtml(s.nombre)}</option>`);
            });

            const leyendaSalas = Estado.salas.length
                ? Estado.salas.map(s => `<span class="sal-legend-item"><span class="sal-dot" style="background:${colorSala(s.id_sala)}"></span>${escapeHtml(s.nombre)}</span>`).join('')
                : '<span class="sal-legend-item"><i class="fa-solid fa-triangle-exclamation"></i> Aún no hay salas registradas</span>';

            const leyendaEstados = [
                ['En curso', COLOR_ESTADO.en_curso],
                ['Finalizada', COLOR_ESTADO.finalizada],
                ['Cancelada', COLOR_ESTADO.cancelada]
            ].map(([texto, color]) =>
                `<span class="sal-legend-item"><span class="sal-dot" style="background:${color}"></span>${texto}</span>`).join('');

            document.getElementById('sal-leyenda').innerHTML = leyendaSalas + leyendaEstados;
        }

        function montarParticipantes(seleccionados) {
            if (tsParticipantes) tsParticipantes.destroy();

            tsParticipantes = new TomSelect('#r-participantes', {
                plugins: ['remove_button'],
                maxItems: null,
                create: true,
                valueField: 'usuarioid',
                labelField: 'nombre',
                searchField: ['nombre', 'email'],
                options: Estado.usuarios.filter(u => Number(u.usuarioid) !== Estado.usuarioId),
                items: (seleccionados ?? []).map(String),
                render: {
                    option: (d, escape) => `<div><div>${escape(d.nombre)}</div><div style="font-size:.72rem;opacity:.7">${escape(d.email ?? '')}</div></div>`,
                    item: (d, escape) => `<div>${escape(d.nombre)}</div>`
                }
            });
        }

        // ── Calendario ─────────────────────────────────────────────────────
        function filtrarEventos(data) {
            const modo = document.getElementById('f-participacion').value;
            const verCanceladas = document.getElementById('f-canceladas').checked;

            return data.filter(r => {
                if (r.estado === 'cancelada' && !verCanceladas) return false;
                if (modo === 'mias' && !r.esParticipante) return false;
                if (modo === 'organizo' && !r.esOrganizador) return false;
                return true;
            });
        }

        async function traerEventos(info, exito, fallo) {
            try {
                const data = await GetData({
                    path: URLS.reservaciones,
                    data: {
                        desde: isoLocal(info.start),
                        hasta: isoLocal(info.end),
                        sala_id: document.getElementById('f-sala').value || 0
                    }
                });

                const filtradas = filtrarEventos(Array.isArray(data) ? data : []);
                Estado.eventos = filtradas;

                document.getElementById('sal-badge-eventos').textContent = filtradas.length
                    ? `${filtradas.length} ${filtradas.length === 1 ? 'reservación' : 'reservaciones'}`
                    : 'Sin reservaciones';

                document.getElementById('sal-resumen').innerHTML =
                    '<i class="fa-solid fa-clock"></i> Actualizado ' +
                    new Date().toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });

                exito(filtradas.map(r => ({
                    id: String(r.id),
                    title: r.verDetalle ? r.asunto : 'Reservado',
                    start: r.inicio,
                    end: r.fin,
                    backgroundColor: colorEvento(r),
                    borderColor: colorEvento(r),
                    extendedProps: r
                })));
            } catch (e) {
                fallo(e);
            }
        }

        function initCalendario() {
            calendario = new FullCalendar.Calendar(document.getElementById('calendarioSalas'), {
                locale: 'es',
                timeZone: 'local',
                initialView: 'timeGridWeek',
                height: 'auto',
                nowIndicator: true,
                allDaySlot: false,
                hiddenDays: [0],
                slotDuration: '00:30:00',
                slotLabelInterval: '01:00',
                slotMinTime: '09:00:00',
                slotMaxTime: '18:00:00',
                expandRows: true,
                firstDay: 1,
                selectable: true,
                selectMirror: true,
                selectConstraint: 'businessHours',
                eventOverlap: true,
                navLinks: true,
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay'
                },
                buttonText: { today: 'Hoy', month: 'Mes', week: 'Semana', day: 'Día' },
                views: {
                    dayGridMonth: {
                        eventDisplay: 'block',
                        dayMaxEventRows: 4,
                        moreLinkText: n => `+${n} más`,
                        eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false }
                    }
                },
                slotLabelFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                eventTimeFormat: { hour: '2-digit', minute: '2-digit', hour12: false },
                businessHours: [
                    { daysOfWeek: [1, 2, 3, 4, 5], startTime: '09:00', endTime: '18:00' },
                    { daysOfWeek: [6], startTime: '09:00', endTime: '14:00' }
                ],
                events: traerEventos,
                select: info => {
                    if (!Estado.salas.length) {
                        toastMixin.fire({ icon: 'warning', title: 'Primero registra una sala' });
                        calendario.unselect();
                        return;
                    }
                    abrirModalReservacion(null, info.start, info.end);
                    calendario.unselect();
                },
                dateClick: info => {
                    if (info.view.type === 'dayGridMonth') calendario.changeView('timeGridDay', info.date);
                },
                eventClick: info => abrirDetalle(info.event.extendedProps),
                eventContent: arg => {
                    const p = arg.event.extendedProps;
                    const titulo = p.verDetalle ? p.asunto : 'Reservado';

                    if (arg.view.type === 'dayGridMonth') {
                        return {
                            html: `<div class="sal-ev is-compact">
                                     <span class="sal-ev-time">${arg.timeText}</span>
                                     <span class="sal-ev-title">${escapeHtml(titulo)}</span>
                                   </div>`
                        };
                    }

                    return {
                        html: `<div class="sal-ev">
                                 <span class="sal-ev-time">${arg.timeText}</span>
                                 <span class="sal-ev-title">${escapeHtml(titulo)}</span>
                                 <span class="sal-ev-meta">${escapeHtml(nombreSala(p.salaId))} · ${escapeHtml(p.anfitrion)}</span>
                               </div>`
                    };
                },
                eventDidMount: info => {
                    const p = info.event.extendedProps;
                    if (p.estado === 'cancelada') info.el.classList.add('is-cancelada');
                    if (p.estado === 'finalizada') info.el.classList.add('is-finalizada');
                    if (p.estado === 'en_curso') info.el.classList.add('is-en-curso');
                    if (p.esParticipante) info.el.classList.add('is-mia');
                    info.el.title = p.verDetalle
                        ? `${p.asunto} · ${nombreSala(p.salaId)} · ${p.anfitrion}`
                        : `Reservado por ${p.anfitrion} · ${nombreSala(p.salaId)}`;
                }
            });

            calendario.render();
        }

        function refrescarCalendario() {
            const btn = document.getElementById('btn-refrescar');
            btn.classList.add('is-spinning');
            refrescarTodo();
            setTimeout(() => btn.classList.remove('is-spinning'), 700);
        }

        function refrescarTodo() {
            calendario?.refetchEvents();
            if (typeof AgendaSalas !== 'undefined') AgendaSalas.cargar();
        }

        // La burbuja del layout delega aquí cuando ya estás en el calendario, para
        // abrir el detalle en vez de recargar la página.
        window.abrirDesdeAgenda = function (id, junta) {
            const encontrada = Estado.eventos.find(e => e.id === id) ?? junta;
            if (!encontrada) return;

            calendario?.gotoDate(encontrada.inicio);
            abrirDetalle(encontrada);
        };

        // Un aviso del hub sobre salas significa que alguien reservó, editó, canceló
        // o confirmó: se repinta el calendario sin que el usuario recargue.
        document.addEventListener('erp:salas-actualizadas', refrescarTodo);

        // El paso a en_curso / finalizada lo hace el servidor en segundo plano.
        setInterval(() => calendario?.refetchEvents(), 60000);

        // ── Detalle ────────────────────────────────────────────────────────
        function abrirDetalle(r) {
            Estado.detalle = r;

            const tono = colorSala(r.salaId);
            const inicio = new Date(r.inicio);
            const fin = new Date(r.fin);
            const fecha = inicio.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
            const duracion = Math.round((fin - inicio) / 60000);

            document.getElementById('detalle-folio').textContent = folio(r.id);

            let html = `
                <div class="sal-detail-head">
                    <span class="sal-detail-tone" style="background:${tono}"></span>
                    <div style="min-width:0">
                        <h3 class="sal-detail-title">${escapeHtml(r.verDetalle ? r.asunto : 'Sala reservada')}</h3>
                        <div style="margin-top:.35rem">
                            <span class="sal-state ${infoEstado(r.estado).clase}">
                                <i class="fa-solid ${infoEstado(r.estado).icono}"></i>
                                ${infoEstado(r.estado).texto}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="sal-detail-rows">
                    <div class="sal-detail-row">
                        <i class="fa-solid fa-door-open"></i>
                        <div><span class="sal-detail-label">Sala</span>${escapeHtml(nombreSala(r.salaId))}</div>
                    </div>
                    <div class="sal-detail-row">
                        <i class="fa-solid fa-calendar-day"></i>
                        <div><span class="sal-detail-label">Fecha</span><span style="text-transform:capitalize">${escapeHtml(fecha)}</span></div>
                    </div>
                    <div class="sal-detail-row">
                        <i class="fa-solid fa-clock"></i>
                        <div><span class="sal-detail-label">Horario</span>${isoHora(inicio)} a ${isoHora(fin)} hrs <span style="opacity:.65">(${duracion} min)</span></div>
                    </div>
                    <div class="sal-detail-row">
                        <i class="fa-solid fa-user-tie"></i>
                        <div>
                            <span class="sal-detail-label">Reservó</span>
                            ${escapeHtml(r.anfitrion)}
                            ${r.anfitrionEmail ? `<div style="font-size:.76rem;color:var(--text-light)">${escapeHtml(r.anfitrionEmail)}</div>` : ''}
                        </div>
                    </div>`;

            if (r.verDetalle) {
                html += `
                    <div class="sal-detail-row">
                        <i class="fa-solid fa-users"></i>
                        <div style="min-width:0">
                            <span class="sal-detail-label">Participantes (${r.totalParticipantes})</span>
                            <div class="sal-people">
                                ${(r.participantes ?? []).map(p => chipParticipante(p, r)).join('') || '<span style="color:var(--text-light)">Sin participantes</span>'}
                            </div>
                            <div class="sal-tally">
                                <span class="sal-tally-item is-si"><i class="fa-solid fa-circle-check"></i> ${r.confirmados} confirmados</span>
                                <span class="sal-tally-item is-no"><i class="fa-solid fa-circle-xmark"></i> ${r.rechazados} no asistirán</span>
                                <span class="sal-tally-item"><i class="fa-solid fa-clock"></i> ${r.pendientes} sin responder</span>
                            </div>
                        </div>
                    </div>`;

                if (r.comentarios) {
                    html += `
                        <div class="sal-detail-row">
                            <i class="fa-solid fa-align-left"></i>
                            <div style="min-width:0"><span class="sal-detail-label">Descripción</span>${escapeHtml(r.comentarios)}</div>
                        </div>`;
                }
            }

            html += '</div>';

            if (!r.verDetalle) {
                html += `<div class="sal-private">
                            <i class="fa-solid fa-lock"></i>
                            No participas en esta reunión, por eso solo se muestra quién reservó la sala y el horario apartado.
                            Son ${r.totalParticipantes} ${r.totalParticipantes === 1 ? 'participante' : 'participantes'}.
                         </div>`;
            }

            if (r.estado === 'cancelada' && r.motivo) {
                html += `<div class="sal-note"><strong>Motivo de cancelación:</strong> ${escapeHtml(r.motivo)}</div>`;
            }

            if (r.puedeConfirmar) {
                const estado = ASISTENCIA[r.miEstado] ?? ASISTENCIA.pendiente;

                html += `<div class="sal-mi-estado">
                            <i class="fa-solid ${estado.icono}"></i>
                            <span style="min-width:0">
                                ${r.miEstado === 'pendiente'
                                    ? 'Te invitaron a esta reunión y aún no respondes. Confirma abajo si podrás asistir.'
                                    : `Tu respuesta actual es <strong>${estado.texto.toLowerCase()}</strong>. Puedes cambiarla mientras la reunión no empiece.`}
                            </span>
                         </div>`;
            }

            document.getElementById('detalle-body').innerHTML = html;
            document.getElementById('btn-editar-reservacion').style.display = r.puedeEditar ? '' : 'none';
            document.getElementById('btn-cancelar-reservacion').style.display = r.puedeCancelar ? '' : 'none';
            document.getElementById('btn-asistire').style.display = r.puedeConfirmar && r.miEstado !== 'asistira' ? '' : 'none';
            document.getElementById('btn-no-asistire').style.display = r.puedeConfirmar && r.miEstado !== 'no_asistira' ? '' : 'none';

            modal('modalDetalle').show();
        }

        function chipParticipante(p, r) {
            const esAnfitrion = p.id === r.apartadoPor;
            const estado = ASISTENCIA[p.estado] ?? ASISTENCIA.pendiente;
            const clase = esAnfitrion ? 'is-host' : `is-${p.estado}`;
            const titulo = esAnfitrion ? 'Organiza la reunión' : estado.texto;
            const icono = esAnfitrion ? 'fa-user-tie' : estado.icono;

            return `<span class="sal-person ${clase}" title="${titulo}">
                        <i class="fa-solid ${icono}"></i>${escapeHtml(p.nombre)}
                    </span>`;
        }

        // ── Alta y edición ─────────────────────────────────────────────────
        function abrirModalReservacion(reservacion, inicio, fin) {
            if (!Estado.salas.length) {
                toastMixin.fire({ icon: 'warning', title: 'Primero registra una sala' });
                return;
            }

            const esEdicion = !!reservacion;
            const arranque = inicio ?? (reservacion ? new Date(reservacion.inicio) : null);
            const cierre = fin ?? (reservacion ? new Date(reservacion.fin) : null);

            document.getElementById('titulo-reservacion').textContent = esEdicion ? 'Editar reservación' : 'Nueva reservación';
            document.getElementById('subtitulo-reservacion').textContent = esEdicion
                ? folio(reservacion.id) + ' · se notificará a los participantes de los cambios'
                : 'Los campos marcados con * son obligatorios.';
            document.getElementById('icono-reservacion').className = esEdicion ? 'fa-solid fa-pen' : 'fa-solid fa-calendar-plus';

            document.getElementById('r-id').value = esEdicion ? reservacion.id : 0;
            document.getElementById('r-asunto').value = esEdicion ? (reservacion.asunto ?? '') : '';
            document.getElementById('r-comentarios').value = esEdicion ? (reservacion.comentarios ?? '') : '';
            document.getElementById('r-sala').value = esEdicion ? reservacion.salaId : Estado.salas[0].id_sala;
            document.getElementById('r-fecha').value = arranque ? isoFecha(arranque) : isoFecha(new Date());
            document.getElementById('r-fecha').min = esEdicion ? '' : isoFecha(new Date());

            onFechaChange(arranque ? isoHora(arranque) : '09:00', cierre ? isoHora(cierre) : null);

            const modalEl = document.getElementById('modalReservacion');

            modalEl.addEventListener('shown.bs.modal', () => {
                montarParticipantes(esEdicion ? (reservacion.participantes ?? []).map(p => p.id) : []);
            }, { once: true });

            modal('modalReservacion').show();
        }

        function editarReservacion() {
            const detalle = Estado.detalle;
            const modalEl = document.getElementById('modalDetalle');

            modalEl.addEventListener('hidden.bs.modal', () => abrirModalReservacion(detalle), { once: true });
            modal('modalDetalle').hide();
        }

        async function guardarReservacion() {
            const id = Number(document.getElementById('r-id').value);
            const asunto = document.getElementById('r-asunto').value.trim();
            const salaId = document.getElementById('r-sala').value;
            const fecha = document.getElementById('r-fecha').value;
            const inicio = document.getElementById('r-inicio').value;
            const fin = document.getElementById('r-fin').value;

            if (!asunto) return toastMixin.fire({ icon: 'warning', title: 'Escribe el asunto de la reunión' });
            if (!salaId) return toastMixin.fire({ icon: 'warning', title: 'Selecciona una sala' });
            if (!fecha || !inicio || !fin) return toastMixin.fire({ icon: 'warning', title: 'Selecciona fecha y horario' });
            if (minutosDe(fin) <= minutosDe(inicio)) return toastMixin.fire({ icon: 'warning', title: 'La hora de fin debe ser posterior' });

            const invitados = tsParticipantes ? tsParticipantes.getValue() : [];
            const [a, m, d] = fecha.split('-').map(Number);
            const legible = new Date(a, m - 1, d).toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' });

            const ok = await confirmar({
                titulo: id > 0 ? 'Confirmar cambios' : 'Confirmar reservación',
                html: `<p style="margin-bottom:.2rem">${id > 0
                            ? '¿Guardar los cambios de esta reservación?'
                            : '¿Reservar la sala con estos datos?'}</p>`
                      + tablaResumen([
                          filaResumen('Asunto', escapeHtml(asunto)),
                          filaResumen('Sala', escapeHtml(nombreSala(salaId))),
                          filaResumen('Fecha', escapeHtml(legible)),
                          filaResumen('Horario', `${inicio} a ${fin} hrs`),
                          filaResumen('Participantes', `${invitados.length + 1} (te incluye)`)
                      ]),
                footer: id > 0
                    ? '<b style="color:#d97706">Se notificará a los participantes y deberán confirmar de nuevo si cambia sala u horario</b>'
                    : '<b style="color:#d97706">Se enviará la invitación por correo a los participantes</b>',
                confirmar: id > 0 ? 'Sí, guardar cambios' : 'Sí, reservar'
            });

            if (!ok) return;

            const btn = document.getElementById('btn-guardar-reservacion');
            btn.disabled = true;

            const data = {
                sala_id: salaId,
                asunto,
                comentarios: document.getElementById('r-comentarios').value.trim(),
                inicio_apartado: `${fecha}T${inicio}:00`,
                fin_apartado: `${fecha}T${fin}:00`,
                participantes: invitados
            };

            if (id > 0) data.sala_reservada_id = id;

            const res = await enviar(id > 0 ? URLS.editar : URLS.reservar, data);
            btn.disabled = false;

            if (res?.icon === 'success') {
                modal('modalReservacion').hide();
                refrescarTodo();
            }
        }

        async function responderInvitacion(respuesta) {
            const r = Estado.detalle;
            if (!r) return;

            const asiste = respuesta === 'asistira';
            const inicio = new Date(r.inicio);

            const ok = await confirmar({
                titulo: asiste ? 'Confirmar asistencia' : 'Rechazar invitación',
                html: `<p style="margin-bottom:.2rem">${asiste
                            ? '¿Confirmas que asistirás a esta reunión?'
                            : '¿Confirmas que no podrás asistir?'}</p>`
                      + tablaResumen([
                          filaResumen('Asunto', escapeHtml(r.asunto ?? '')),
                          filaResumen('Sala', escapeHtml(nombreSala(r.salaId))),
                          filaResumen('Fecha', escapeHtml(inicio.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' }))),
                          filaResumen('Horario', `${isoHora(inicio)} a ${isoHora(new Date(r.fin))} hrs`)
                      ]),
                footer: '<b style="color:#d97706">Se avisará al organizador de tu respuesta</b>',
                confirmar: asiste ? 'Sí, asistiré' : 'No podré asistir',
                color: asiste ? '#059669' : '#dc2626'
            });

            if (!ok) return;

            const res = await enviar(URLS.confirmar, { sala_reservada_id: r.id, respuesta }, 'Registrando tu respuesta...');

            if (res?.icon === 'success') {
                modal('modalDetalle').hide();
                refrescarTodo();
            }
        }

        function cancelarReservacion() {
            const r = Estado.detalle;
            if (!r) return;

            const inicio = new Date(r.inicio);
            const fin = new Date(r.fin);

            document.getElementById('c-folio').textContent = folio(r.id);
            document.getElementById('c-motivo').value = '';
            document.getElementById('c-resumen').innerHTML = `
                <strong>${escapeHtml(r.verDetalle ? r.asunto : 'Sala reservada')}</strong><br>
                Se liberará <strong>${escapeHtml(nombreSala(r.salaId))}</strong> el
                ${escapeHtml(inicio.toLocaleDateString('es-MX', { day: 'numeric', month: 'long' }))}
                de ${isoHora(inicio)} a ${isoHora(fin)} hrs.
                ${r.totalParticipantes ? `Se notificará a ${r.totalParticipantes} ${r.totalParticipantes === 1 ? 'participante' : 'participantes'}.` : ''}`;

            Estado.volverAlDetalle = true;

            document.getElementById('modalCancelar').addEventListener('hidden.bs.modal', () => {
                if (Estado.volverAlDetalle) abrirDetalle(r);
            }, { once: true });

            document.getElementById('modalDetalle').addEventListener('hidden.bs.modal', () => {
                modal('modalCancelar').show();
            }, { once: true });

            modal('modalDetalle').hide();
        }

        async function confirmarCancelacion() {
            const r = Estado.detalle;
            const motivo = document.getElementById('c-motivo').value.trim();

            if (!motivo) {
                toastMixin.fire({ icon: 'warning', title: 'Indica el motivo de la cancelación' });
                document.getElementById('c-motivo').focus();
                return;
            }

            const inicio = new Date(r.inicio);

            const ok = await confirmar({
                titulo: 'Confirmar cancelación',
                html: '<p style="margin-bottom:.2rem">¿Seguro que deseas cancelar esta reservación?</p>'
                      + tablaResumen([
                          filaResumen('Folio', folio(r.id)),
                          filaResumen('Asunto', escapeHtml(r.verDetalle ? r.asunto : 'Sala reservada')),
                          filaResumen('Sala', escapeHtml(nombreSala(r.salaId))),
                          filaResumen('Fecha', escapeHtml(inicio.toLocaleDateString('es-MX', { weekday: 'long', day: 'numeric', month: 'long' }))),
                          filaResumen('Horario', `${isoHora(inicio)} a ${isoHora(new Date(r.fin))} hrs`),
                          filaResumen('Motivo', escapeHtml(motivo))
                      ]),
                footer: "<b style='color: red;'>ADVERTENCIA - Este cambio no se puede revertir</b>",
                confirmar: 'Sí, cancelar reservación',
                color: '#dc2626'
            });

            if (!ok) return;

            const btn = document.getElementById('btn-confirmar-cancelacion');
            btn.disabled = true;

            const res = await enviar(URLS.cancelar, { sala_reservada_id: r.id, motivo }, 'Cancelando la reservacion...');
            btn.disabled = false;

            if (res?.icon === 'success') {
                Estado.volverAlDetalle = false;
                modal('modalCancelar').hide();
                refrescarTodo();
            }
        }

        // ── Salas ──────────────────────────────────────────────────────────
        function abrirModalSala() {
            document.getElementById('s-id').value = 0;
            document.getElementById('s-nombre').value = '';
            document.getElementById('s-descripcion').value = '';
            modal('modalSala').show();
        }

        async function guardarSala() {
            const nombre = document.getElementById('s-nombre').value.trim();
            if (!nombre) return toastMixin.fire({ icon: 'warning', title: 'Escribe el nombre de la sala' });

            const res = await enviar(URLS.guardarSala, {
                id_sala: document.getElementById('s-id').value,
                nombre,
                descripcion: document.getElementById('s-descripcion').value.trim()
            });

            if (res?.icon === 'success') {
                modal('modalSala').hide();
                await cargarCatalogos();
                calendario.refetchEvents();
            }
        }

        // ── Arranque ───────────────────────────────────────────────────────
        (async () => {
            await cargarCatalogos();
            initCalendario();

            const solicitada = Number(new URLSearchParams(location.search).get('reservacion') ?? 0);
            if (!solicitada) return;

            const data = await GetData({
                path: URLS.reservaciones,
                data: { desde: '2000-01-01T00:00:00', hasta: '2100-01-01T00:00:00', sala_id: 0 }
            });

            const r = (Array.isArray(data) ? data : []).find(x => Number(x.id) === solicitada);
            if (!r) return;

            calendario.gotoDate(r.inicio);
            abrirDetalle(r);
        })();
    </script>
}
