            </div>
        </div>

        <div class="sal-filters-actions">
            <div class="sal-legend" id="sal-leyenda"></div>
            <button type="button" class="btn-sal btn-sal-ghost" id="btn-nueva-sala" style="display:none" onclick="abrirModalSala()">
                <i class="fa-solid fa-door-open"></i> Nueva sala
            </button>
            <button type="button" class="btn-sal btn-sal-primary" onclick="abrirModalReservacion()">
                <i class="fa-solid fa-calendar-plus"></i> Nueva reservación
            </button>
        </div>
    </section>

    <section class="sal-card">
        <div class="sal-card-head">
            <div class="sal-card-icon"><i class="fa-solid fa-calendar-days"></i></div>
            <div>
                <h2 class="sal-card-title">Calendario de salas</h2>
                <p class="sal-card-sub">Haz clic en un espacio libre para reservar o en una reservación para ver el detalle.</p>
            </div>
            <div class="sal-card-tools">
                <span class="sal-badge" id="sal-badge-eventos">Cargando…</span>
            </div>
        </div>
        <div class="sal-card-body">
            <div id="calendarioSalas"></div>
        </div>
    </section>
</div>

<!-- Reservación -->
<div class="modal fade sal-modal" id="modalReservacion" tabindex="-1" data-bs-backdrop="static" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <div class="sal-hero-icon" style="width:38px;height:38px;border-radius:11px">
                    <i class="fa-solid fa-calendar-plus" id="icono-reservacion"></i>
                </div>
                <div>
                    <h5 class="modal-title" id="titulo-reservacion">Nueva reservación</h5>
                    <span class="sal-modal-sub" id="subtitulo-reservacion">Los campos marcados con * son obligatorios.</span>
                </div>
