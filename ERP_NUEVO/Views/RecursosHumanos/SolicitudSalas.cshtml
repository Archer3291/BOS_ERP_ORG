@{
    ViewBag.Title = "Solicitud de salas";
    ViewBag.PageTitle = "Solicitud de salas";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<link href="~/content/tom-select-theme.css" rel="stylesheet" />

<style>
    .sal-page {
        --sal-radius: 14px;
        --sal-radius-sm: 10px;
        --sal-border: 1px solid var(--border-light);
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    .sal-hero {
        position: relative;
        display: flex;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.1rem 1.35rem;
        overflow: hidden;
        background: var(--bg-light);
        border: var(--sal-border);
        border-radius: var(--sal-radius);
        box-shadow: var(--shadow);
    }

        .sal-hero::before {
            content: '';
            position: absolute;
            top: 0;
            bottom: 0;
            left: 0;
            width: 4px;
            background: linear-gradient(180deg, var(--accent-blue), color-mix(in srgb, var(--accent-blue) 20%, transparent));
        }

    .sal-hero-icon {
        flex: 0 0 auto;
        width: 46px;
        height: 46px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        font-size: 1.05rem;
        color: var(--accent-blue);
        background: color-mix(in srgb, var(--accent-blue) 12%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent-blue) 22%, transparent);
    }

    .sal-eyebrow {
        margin: 0;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .09em;
        text-transform: uppercase;
        color: var(--text-light);
    }

    .sal-title {
        margin: .12rem 0 0;
        font-size: 1.15rem;
        font-weight: 700;
        line-height: 1.25;
        color: var(--text-dark);
    }

    .sal-subtitle {
        margin: .2rem 0 0;
        font-size: .82rem;
        color: var(--text-light);
    }

    .sal-hero-meta {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .sal-chip {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .3rem .7rem;
        border-radius: 999px;
        border: var(--sal-border);
        background: var(--bg-gray);
        color: var(--text-light);
        font-size: .74rem;
        font-weight: 500;
        white-space: nowrap;
    }

    .sal-icon-btn {
        width: 36px;
        height: 36px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        border: var(--sal-border);
        background: var(--bg-light);
        color: var(--text-light);
        cursor: pointer;
        transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast);
    }

        .sal-icon-btn:hover {
            color: var(--accent-blue);
            border-color: var(--accent-blue);
            background: color-mix(in srgb, var(--accent-blue) 8%, transparent);
        }

        .sal-icon-btn.is-spinning i {
            animation: salSpin .7s linear infinite;
        }

    @@keyframes salSpin {
        to {
            transform: rotate(360deg);
        }
    }

    .btn-sal {
        height: 38px;
        padding: 0 1.05rem;
        border-radius: var(--sal-radius-sm);
        font-size: .84rem;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        white-space: nowrap;
        cursor: pointer;
        transition: opacity var(--transition-fast), background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
    }

    .btn-sal-primary {
        border: 1px solid var(--accent-blue);
        background: var(--accent-blue);
        color: #fff;
        box-shadow: 0 2px 10px color-mix(in srgb, var(--accent-blue) 28%, transparent);
    }

        .btn-sal-primary:hover {
            opacity: .9;
        }

    .btn-sal-ghost {
        border: var(--sal-border);
        background: transparent;
        color: var(--text-light);
    }

        .btn-sal-ghost:hover {
            background: var(--bg-gray);
            color: var(--text-dark);
        }

    .btn-sal-danger {
        border: 1px solid var(--danger-color);
        background: var(--danger-color);
        color: #fff;
    }

        .btn-sal-danger:hover {
            opacity: .9;
        }

    .btn-sal-success {
        border: 1px solid var(--success-color);
        background: var(--success-color);
        color: #fff;
    }

        .btn-sal-success:hover {
            opacity: .9;
        }

    .sal-filters {
        padding: 1rem 1.15rem 1.1rem;
        background: var(--bg-light);
        border: var(--sal-border);
        border-radius: var(--sal-radius);
        box-shadow: var(--shadow);
    }

    .sal-filters-head {
        display: flex;
        align-items: center;
        gap: .45rem;
        margin-bottom: .85rem;
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: var(--text-light);
    }

        .sal-filters-head i {
            color: var(--accent-blue);
            font-size: .8rem;
        }

    .sal-filters-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
        gap: .8rem;
    }

    .sal-field {
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .sal-label {
        font-size: .74rem;
        font-weight: 600;
        color: var(--text-dark);
    }

        .sal-label span {
            color: var(--danger-color);
        }

    .sal-control {
        width: 100%;
        height: 38px;
        padding: 0 .75rem;
        border: var(--sal-border);
        border-radius: var(--sal-radius-sm);
        background: var(--bg-gray);
        color: var(--text-dark);
        font-size: .85rem;
        transition: border-color var(--transition-fast), box-shadow var(--transition-fast), background var(--transition-fast);
    }

    textarea.sal-control {
        height: auto;
        padding: .6rem .75rem;
        resize: vertical;
    }

    .sal-control:focus {
        outline: none;
        background: var(--bg-light);
        border-color: var(--accent-blue);
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 14%, transparent);
    }

    select.sal-control {
        cursor: pointer;
    }

    .sal-control:disabled {
        opacity: .6;
        cursor: not-allowed;
    }

    .sal-switch {
        display: inline-flex;
        align-items: center;
        gap: .45rem;
        font-size: .8rem;
        color: var(--text-light);
        cursor: pointer;
        user-select: none;
    }

        .sal-switch input {
            width: 15px;
            height: 15px;
            accent-color: var(--accent-blue);
            cursor: pointer;
        }

    .sal-filters-actions {
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
        margin-top: .9rem;
        padding-top: .9rem;
        border-top: var(--sal-border);
    }

    .sal-legend {
        margin-right: auto;
        display: flex;
        align-items: center;
        gap: .45rem;
        flex-wrap: wrap;
        min-width: 0;
    }

    .sal-legend-item {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        padding: .22rem .65rem;
        border-radius: 999px;
        border: var(--sal-border);
        background: var(--bg-gray);
        font-size: .73rem;
        font-weight: 600;
        color: var(--text-light);
    }

    .sal-dot {
        width: 9px;
        height: 9px;
        border-radius: 50%;
        flex: 0 0 auto;
    }

    .sal-card {
        background: var(--bg-light);
        border: var(--sal-border);
        border-radius: var(--sal-radius);
        box-shadow: var(--shadow);
        overflow: hidden;
    }

    .sal-card-head {
        display: flex;
        align-items: center;
        gap: .75rem;
        flex-wrap: wrap;
        padding: .9rem 1.15rem;
        border-bottom: var(--sal-border);
        background: linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 7%, transparent), transparent 65%);
    }

    .sal-card-icon {
        flex: 0 0 auto;
        width: 34px;
        height: 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-size: .85rem;
        color: var(--accent-blue);
        background: color-mix(in srgb, var(--accent-blue) 12%, transparent);
    }

    .sal-card-title {
        margin: 0;
        font-size: .9rem;
        font-weight: 700;
        color: var(--text-dark);
    }

    .sal-card-sub {
        margin: .12rem 0 0;
        font-size: .76rem;
        color: var(--text-light);
    }

    .sal-card-tools {
        margin-left: auto;
        display: flex;
        align-items: center;
        gap: .5rem;
        flex-wrap: wrap;
    }

    .sal-badge {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .2rem .65rem;
        border-radius: 999px;
        border: var(--sal-border);
        background: var(--bg-gray);
        color: var(--text-light);
        font-size: .72rem;
        font-weight: 600;
        white-space: nowrap;
    }

    .sal-card-body {
        padding: 1rem 1.15rem 1.15rem;
    }

    /* ─── FullCalendar sobre el tema del ERP ─────────────────────────── */
    #calendarioSalas {
        --fc-border-color: var(--border-light);
        --fc-page-bg-color: transparent;
        --fc-neutral-bg-color: var(--bg-gray);
        --fc-today-bg-color: color-mix(in srgb, var(--accent-blue) 7%, transparent);
        --fc-now-indicator-color: var(--danger-color);
        --fc-non-business-color: color-mix(in srgb, var(--border-light) 45%, transparent);
        font-size: .82rem;
        color: var(--text-dark);
    }

        #calendarioSalas .fc .fc-toolbar-title {
            font-size: 1.02rem;
            font-weight: 700;
            color: var(--text-dark);
            text-transform: capitalize;
        }

        #calendarioSalas .fc .fc-button {
            border-radius: var(--sal-radius-sm);
            border: var(--sal-border);
            background: var(--bg-gray);
            color: var(--text-light);
            font-size: .78rem;
            font-weight: 600;
            text-transform: capitalize;
            box-shadow: none;
            padding: .38rem .8rem;
        }

            #calendarioSalas .fc .fc-button:hover {
                background: color-mix(in srgb, var(--accent-blue) 10%, transparent);
                color: var(--accent-blue);
                border-color: var(--accent-blue);
            }

            #calendarioSalas .fc .fc-button:focus {
                box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent-blue) 14%, transparent);
            }

            #calendarioSalas .fc .fc-button-primary:not(:disabled).fc-button-active,
            #calendarioSalas .fc .fc-button-primary:not(:disabled):active {
                background: var(--accent-blue);
                border-color: var(--accent-blue);
                color: #fff;
            }

            #calendarioSalas .fc .fc-button:disabled {
                opacity: .45;
            }

        #calendarioSalas .fc .fc-col-header-cell-cushion,
        #calendarioSalas .fc .fc-timegrid-axis-cushion,
        #calendarioSalas .fc .fc-timegrid-slot-label-cushion {
            color: var(--text-light);
            font-weight: 600;
            text-decoration: none;
            text-transform: capitalize;
        }

        #calendarioSalas .fc .fc-timegrid-slot {
            height: 2.3rem;
        }

        #calendarioSalas .fc-theme-standard td,
        #calendarioSalas .fc-theme-standard th,
        #calendarioSalas .fc-theme-standard .fc-scrollgrid {
            border-color: var(--border-light);
        }

        #calendarioSalas .fc-event {
            border: none;
            border-left: 3px solid rgba(0,0,0,.22);
            border-radius: 7px;
            padding: 0;
            overflow: hidden;
            cursor: pointer;
        }

        #calendarioSalas .fc-event.is-cancelada {
            opacity: .55;
        }

        #calendarioSalas .fc-event.is-finalizada {
            opacity: .7;
        }

        #calendarioSalas .fc-event.is-en-curso {
            box-shadow: 0 0 0 2px color-mix(in srgb, #059669 45%, transparent);
        }

            #calendarioSalas .fc-event.is-cancelada .sal-ev-title {
                text-decoration: line-through;
            }

        #calendarioSalas .fc-event.is-mia {
            box-shadow: inset 0 0 0 2px rgba(255,255,255,.55);
        }

    .sal-ev {
        display: flex;
        flex-direction: column;
        gap: 1px;
        padding: 3px 6px;
        line-height: 1.25;
        color: #fff;
        overflow: hidden;
    }

    .sal-ev-time {
        font-size: .68rem;
        font-weight: 600;
        opacity: .85;
    }

    .sal-ev-title {
        font-size: .76rem;
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sal-ev-meta {
        font-size: .67rem;
        opacity: .85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .sal-ev.is-compact {
        flex-direction: row;
        align-items: baseline;
        gap: .35rem;
        padding: 2px 6px;
    }

        .sal-ev.is-compact .sal-ev-time {
            flex: 0 0 auto;
        }

    #calendarioSalas .fc-daygrid-event {
        border-radius: 6px;
        margin-top: 2px;
    }

    #calendarioSalas .fc .fc-daygrid-day-number,
    #calendarioSalas .fc .fc-daygrid-more-link {
        color: var(--text-light);
        font-size: .75rem;
        font-weight: 600;
        text-decoration: none;
    }

    #calendarioSalas .fc .fc-daygrid-more-link:hover {
        color: var(--accent-blue);
    }

    #calendarioSalas .fc .fc-day-today .fc-daygrid-day-number {
        color: var(--accent-blue);
        font-weight: 700;
    }

    #calendarioSalas .fc .fc-popover {
        border: var(--sal-border);
        border-radius: var(--sal-radius-sm);
        background: var(--bg-light);
        box-shadow: var(--shadow-lg);
        z-index: 1050;
    }

    #calendarioSalas .fc .fc-popover-header {
        background: var(--bg-gray);
        color: var(--text-dark);
        font-size: .78rem;
        font-weight: 700;
    }

    .sal-icon-danger {
        color: var(--danger-color) !important;
        background: color-mix(in srgb, var(--danger-color) 12%, transparent) !important;
        border-color: color-mix(in srgb, var(--danger-color) 22%, transparent) !important;
    }

    .sal-empty {
        padding: 2.2rem 1rem;
        text-align: center;
        color: var(--text-light);
        font-size: .85rem;
    }

    /* ─── Modales ────────────────────────────────────────────────────── */
    .sal-modal .modal-content {
        border: var(--sal-border);
        border-radius: var(--sal-radius);
        background: var(--bg-light);
        color: var(--text-dark);
        overflow: hidden;
    }

    .sal-modal .modal-header {
        display: flex;
        align-items: center;
        gap: .8rem;
        padding: 1rem 1.25rem;
        border-bottom: var(--sal-border);
        background: linear-gradient(135deg, color-mix(in srgb, var(--accent-blue) 8%, transparent), transparent 65%);
    }

    .sal-modal .modal-title {
        margin: 0;
        font-size: .95rem;
        font-weight: 700;
        color: var(--text-dark);
    }

    .sal-modal-sub {
        display: block;
        margin-top: .1rem;
        font-size: .76rem;
        color: var(--text-light);
    }

    .sal-modal .modal-body {
        padding: 1.15rem 1.25rem;
    }

    .sal-modal .modal-footer {
        gap: .5rem;
        padding: .9rem 1.25rem;
        border-top: var(--sal-border);
        background: var(--bg-gray);
    }

    .sal-modal .btn-close {
        margin-left: auto;
        filter: var(--sal-close-filter, none);
    }

    [data-theme="dark"] .sal-modal .btn-close {
        filter: invert(1) grayscale(1) brightness(1.6);
    }

    .sal-form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: .85rem;
    }

    .sal-col-full {
        grid-column: 1 / -1;
    }

    .sal-hint {
        display: inline-flex;
        align-items: center;
        gap: .4rem;
        margin-top: .1rem;
        font-size: .72rem;
        color: var(--text-light);
    }

    /* ─── Detalle ────────────────────────────────────────────────────── */
    .sal-detail-head {
        display: flex;
        align-items: flex-start;
        gap: .75rem;
        padding-bottom: .9rem;
        margin-bottom: .9rem;
        border-bottom: var(--sal-border);
    }

    .sal-detail-tone {
        width: 6px;
        align-self: stretch;
        border-radius: 999px;
        flex: 0 0 auto;
    }

    .sal-detail-title {
        margin: 0;
        font-size: 1.02rem;
        font-weight: 700;
        color: var(--text-dark);
        word-break: break-word;
    }

    .sal-detail-rows {
        display: grid;
        gap: .7rem;
    }

    .sal-detail-row {
        display: flex;
        align-items: flex-start;
        gap: .7rem;
        font-size: .84rem;
        color: var(--text-dark);
    }

        .sal-detail-row > i {
            width: 18px;
            flex: 0 0 auto;
            margin-top: .15rem;
            text-align: center;
            color: var(--accent-blue);
            font-size: .82rem;
        }

    .sal-detail-label {
        display: block;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .07em;
        text-transform: uppercase;
        color: var(--text-light);
        margin-bottom: .12rem;
    }

    .sal-people {
        display: flex;
        flex-wrap: wrap;
        gap: .35rem;
        margin-top: .15rem;
    }

    .sal-person {
        display: inline-flex;
        align-items: center;
        gap: .35rem;
        padding: .18rem .6rem;
        border-radius: 999px;
        border: var(--sal-border);
        background: var(--bg-gray);
        font-size: .75rem;
        color: var(--text-dark);
    }

        .sal-person.is-host {
            border-color: color-mix(in srgb, var(--accent-blue) 40%, transparent);
            background: color-mix(in srgb, var(--accent-blue) 12%, transparent);
            color: var(--accent-blue);
            font-weight: 600;
        }

        .sal-person.is-asistira {
            border-color: color-mix(in srgb, var(--success-color) 40%, transparent);
            background: color-mix(in srgb, var(--success-color) 12%, transparent);
            color: var(--success-color);
        }

        .sal-person.is-no_asistira {
            border-color: color-mix(in srgb, var(--danger-color) 35%, transparent);
            background: color-mix(in srgb, var(--danger-color) 10%, transparent);
            color: var(--danger-color);
            text-decoration: line-through;
        }

        .sal-person.is-pendiente {
            color: var(--text-light);
            border-style: dashed;
        }

    .sal-tally {
        display: flex;
        flex-wrap: wrap;
        gap: .4rem;
        margin-top: .5rem;
    }

    .sal-tally-item {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        font-size: .72rem;
        font-weight: 600;
        color: var(--text-light);
    }

        .sal-tally-item i {
            font-size: .7rem;
        }

        .sal-tally-item.is-si i {
            color: var(--success-color);
        }

        .sal-tally-item.is-no i {
            color: var(--danger-color);
        }

    .sal-mi-estado {
        display: flex;
        align-items: center;
        gap: .6rem;
        flex-wrap: wrap;
        margin-top: .9rem;
        padding: .75rem .9rem;
        border-radius: var(--sal-radius-sm);
        border: 1px dashed color-mix(in srgb, var(--accent-blue) 35%, transparent);
        background: color-mix(in srgb, var(--accent-blue) 6%, transparent);
        font-size: .82rem;
        color: var(--text-dark);
    }

        .sal-mi-estado i {
            color: var(--accent-blue);
        }

    .sal-state {
        display: inline-flex;
        align-items: center;
        gap: .3rem;
        padding: .18rem .6rem;
        border-radius: 999px;
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
    }

        .sal-state.is-activa {
            color: var(--success-color);
            background: color-mix(in srgb, var(--success-color) 14%, transparent);
        }

        .sal-state.is-cancelada {
            color: var(--danger-color);
            background: color-mix(in srgb, var(--danger-color) 14%, transparent);
        }

        .sal-state.is-curso {
            color: var(--success-color);
            background: color-mix(in srgb, var(--success-color) 16%, transparent);
        }

        .sal-state.is-finalizada {
            color: var(--text-light);
            background: color-mix(in srgb, var(--text-light) 16%, transparent);
        }

    .sal-note {
        margin-top: .9rem;
        padding: .7rem .85rem;
        border-radius: var(--sal-radius-sm);
        border-left: 3px solid var(--danger-color);
        background: color-mix(in srgb, var(--danger-color) 9%, transparent);
        font-size: .8rem;
        color: var(--text-dark);
    }

    .sal-private {
        margin-top: .9rem;
        padding: .7rem .85rem;
        border-radius: var(--sal-radius-sm);
        border: 1px dashed var(--border-light);
        background: var(--bg-gray);
        font-size: .78rem;
        color: var(--text-light);
    }

    .sal-ts-wrap .ts-control {
        min-height: 38px;
        border-radius: var(--sal-radius-sm);
        border: var(--sal-border);
        background: var(--bg-gray);
        font-size: .85rem;
    }

    @@media (max-width: 767.98px) {
        .sal-hero-meta,
        .sal-card-tools {
            margin-left: 0;
            width: 100%;
        }

        .sal-filters-actions .btn-sal {
            flex: 1;
            justify-content: center;
        }

        #calendarioSalas .fc .fc-toolbar {
            flex-direction: column;
            gap: .6rem;
        }
    }
</style>

<form id="formSalasToken">
    @Html.AntiForgeryToken()
</form>
<script>window.document.title = 'Solicitud de salas'</script>

<div class="container-fluid px-3 px-md-4 py-4 sal-page">

    <header class="sal-hero">
        <div class="sal-hero-icon">
            <i class="fa-solid fa-handshake"></i>
        </div>
        <div>
            <p class="sal-eyebrow">Recursos Humanos</p>
            <h1 class="sal-title">Solicitud de salas</h1>
            <p class="sal-subtitle">Disponibilidad y reservación de las salas de juntas. Lunes a viernes de 9:00 a 18:00 y sábados de 9:00 a 14:00.</p>
        </div>
        <div class="sal-hero-meta">
            <span class="sal-chip" id="sal-resumen"><i class="fa-solid fa-clock"></i> Cargando…</span>
            <button type="button" class="sal-icon-btn" id="btn-refrescar" title="Volver a consultar" onclick="refrescarCalendario()">
                <i class="fa-solid fa-rotate"></i>
            </button>
        </div>
    </header>

    <section class="sal-filters">
        <div class="sal-filters-head">
            <i class="fa-solid fa-sliders"></i> Filtros
        </div>

        <div class="sal-filters-grid">
            <div class="sal-field">
                <label class="sal-label" for="f-sala">Sala</label>
                <select class="sal-control" id="f-sala" onchange="refrescarCalendario()">
                    <option value="">Todas las salas</option>
                </select>
            </div>

            <div class="sal-field">
                <label class="sal-label" for="f-participacion">Mostrar</label>
                <select class="sal-control" id="f-participacion" onchange="refrescarCalendario()">
                    <option value="todas">Todas las reservaciones</option>
                    <option value="mias">Solo donde participo</option>
                    <option value="organizo">Solo las que yo organicé</option>
                </select>
            </div>

            <div class="sal-field">
                <label class="sal-label">Canceladas</label>
                <label class="sal-switch">
                    <input type="checkbox" id="f-canceladas" onchange="refrescarCalendario()" />
                    Mostrar reservaciones canceladas
