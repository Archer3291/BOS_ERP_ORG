@{
    ViewBag.Title = "Bancos SAT";
    ViewData["PageTitle"] = "Bancos SAT";
}

<script>window.document.title = 'Bancos SAT'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn blue-500 mb-3" id="btnAdd">
                    <i class="fa-duotone fa-solid fa-plus"></i> Nuevo Banco SAT
                </button>
            </div>
        </div>

        <div class="table-responsive-sm">
            <table id="banksTable" class="table modern-table" style="width:100%">
                <thead class="bg-secondary">
                    <tr>
                        <th>Clave</th>
                        <th>Nombre</th>
                        <th>Razón Social</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bankModalLabel">Registrar Nuevo Banco SAT</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="bankForm">
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="form-outline mb-4">
                        <label class="form-label" for="clave">Ingresar clave</label>                        
                        <input type="number" id="clave" class="form-control form-icon-trailing" name="Clave" onkeypress="return (event.charCode >= 48 && event.charCode <= 57)" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="nombre">Ingresar nombre</label>                        
                        <input type="text" id="nombre" class="form-control form-icon-trailing" name="Nombre" />
                    </div>
                    <div class="form-outline mb-4">
                        <label class="form-label" for="razonsocial">Ingresar Razón Social</label>                        
                        <input type="text" id="razonsocial" class="form-control form-icon-trailing" name="RazonSocial" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Tesoreria/banksSAT.js"></script>
}