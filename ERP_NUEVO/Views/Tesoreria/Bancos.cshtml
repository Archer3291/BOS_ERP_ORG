@{
    ViewBag.Title = "Bancos";
    ViewData["PageTitle"] = "Bancos";
}

<script>window.document.title = 'Bancos'</script>
<link href="~/content/compras-nacionales.css" rel="stylesheet" />

<div class="contenedor-tabla">
    <div class="card-body">
        <div class="row">
            <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                <button type="button" class="btn blue-500 mb-3" id="btnAdd">
                    <i class="fa-duotone fa-solid fa-plus"></i> Nuevo Banco
                </button>
            </div>
        </div>

        <div class="table-responsive-sm">
            <table id="banksTable" class="table modern-table" style="width:100%">
                <thead class="bg-secondary">
                    <tr>
                        <th>Clave</th>
                        <th>Nombre</th>
                        <th>Cuenta Bancaria</th>
                        <th>Moneda</th>
                        <th>Número de Cuenta</th>
                        <th>Saldo</th>
                        <th>RFC</th>
                        <th>Acciones</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal para agregar/editar -->
<div class="modal fade" id="bankModal" tabindex="-1" aria-labelledby="bankModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="bankModalLabel">Registrar Nuevo Banco</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close" title="Cerrar"></button>
            </div>
            <form id="bankForm">
                <div class="modal-body">
                    <input type="hidden" id="action" value="create">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="clave">Ingresar clave</label>
                                <input type="text" id="clave" class="form-control form-icon-trailing" name="Clave" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="nombre">Ingresar nombre</label>
                                <input type="text" id="nombre" class="form-control form-icon-trailing" name="Nombre" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="cuentaBancaria">Ingresar cuenta bancaria</label>
                                <input type="number" id="cuentaBancaria" class="form-control form-icon-trailing" name="CuentaBancaria" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <!-- En el modal, agregar el select después de la descripción -->
                            <div class="form-outline mb-3">
                                <select id="moneda" name="Moneda" class="form-select">
                                    <option value="">-- Seleccione una moneda --</option>
                                    @foreach (var moneda in Model.Monedas)
                                    {
                                        <option value="@moneda.Value">@moneda.Text</option>
                                    }
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="numeroCuenta">Ingresar número de cuenta</label>
                                <input type="text" id="numeroCuenta" class="form-control form-icon-trailing" name="NumeroCuenta" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="rfc">Ingresar RFC</label>
                                <input type="text" id="rfc" class="form-control form-icon-trailing" name="RFC" />
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <div class="form-outline mb-3">
                                <label class="form-label" for="saldo">Ingresar saldo inicial</label>
                                <input type="number" id="saldo" class="form-control form-icon-trailing" name="Saldo" />
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-danger" data-bs-dismiss="modal">
                        <i class="fa-duotone fa-solid fa-xmark"></i> Cancelar
                    </button>
                    <button type="submit" class="btn btn-outline-success">
                        <i class="fa-duotone fa-solid fa-floppy-disk"></i> Guardar
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/Scripts/Tesoreria/banks.js"></script>
}