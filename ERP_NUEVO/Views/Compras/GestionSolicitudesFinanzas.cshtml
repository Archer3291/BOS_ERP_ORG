@using BOS_ERP.Controllers

@{
    ViewBag.Title = "Presupuesto";
    ViewBag.PageTitle = "Gestion de solicitudes - Presupuesto";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var role = Utilities.GetUserRole(User.Identity.Name, "ERP_SRS");
    var area = Utilities.GetAreaName(User.Identity.Name);

    var esFinanzas = area == "Administración y Finanzas";
    var esAdmin = role == "Super Administrador" || area == "Sistemas";
}

<link href="~/content/Site.css" rel="stylesheet" />

@if (esFinanzas || esAdmin)
{
    @await Html.PartialAsync("OpPartials/_RequisicionMaterialPresupuesto")
}
else
{
    ViewBag.PageTitle = "Acceso denegado";
    <div class="d-flex flex-column align-items-center justify-content-center gap-3">
        <img src="https://http.cat/403" alt="Acceso denegado" />
        <p class="text-muted">Esta pantalla es para el area de Administracion y Finanzas.</p>
    </div>
}
