                    '<div class="border-1">' +
                    '    <p>Firma del usuario</p>' +
                    '    <canvas id="signature" width="400" height="200" style="border:1px solid #ccc;"></canvas>' +
                    '    <button type="button" class="btn green-500 mt-2" id="limpiar_firma">Limpiar</button>' +
                    '</div>',
                allowOutsideClick: () => !Swal.isLoading(),
                allowEscapeKey: false,
                showLoaderOnConfirm: true,
                didOpen: () => {
                    const canvas = document.getElementById("signature");
                    const signaturePad = new SignaturePad(canvas, {
                        penColor: "rgb(0, 0, 0)",
                        minWidth: 0.5,
                        maxWidth: 1.0,
                        throttle: 16,
                        minDistance: 3
                    });

                    // ⚠️ Asegúrate que esto está dentro de Razor View o es interpolado por el backend
                    const firmaBase64 = '@Context.Session.GetString("Firma")';

                    if (firmaBase64 && firmaBase64 !== 'null' && firmaBase64.trim() !== '') {
                        // Pre-cargar firma anterior si existe
                        signaturePad.fromDataURL(firmaBase64);
                    }

                    document.getElementById('limpiar_firma').addEventListener('click', () => {
                        signaturePad.clear();
                    });

                    // Guarda la instancia para usarla en preConfirm
                    Swal.__signaturePad = signaturePad;
                    Swal.__canvas = canvas;
                },
                preConfirm: async () => {
                    const signaturePad = Swal.__signaturePad;
                    const canvas = Swal.__canvas;

                    if (!signaturePad || signaturePad.isEmpty()) {
                        Swal.showValidationMessage('Debes firmar antes de continuar.');
                        return false;
                    }

                    const dataUrl = signaturePad.toDataURL("image/png", 0.5);
                    formData.append('firma', dataUrl);

                    enviandoCotizacion = true;
                    document.getElementById('btn-aceptarcot').disabled = true;

                    try {
                        const response = await fetch("/Requisicion/AceptarCotizacionCompras", {
                            method: "POST",
                            body: formData
                        });

                        const result = await response.json();

                        if (result.icon === 'success') {
                            _SwalReload(result);
                            return;
                        }

                        // El documento ya se habia procesado: no tiene caso reintentar
                        if (result.yaProcesado) {
                            _Swal.fire({ ...result, showCancelButton: false });
                            bootstrap.Modal.getInstance(document.getElementById('modalAceptarCotizacion'))?.hide();
                            recargarTablasCompras?.();
                            return;
                        }

                        _Swal.fire(result);
                    } finally {
                        enviandoCotizacion = false;
                        document.getElementById('btn-aceptarcot').disabled = false;
                    }
                }
            })
        } catch (err) {
            enviandoCotizacion = false;
            document.getElementById('btn-aceptarcot').disabled = false;
            Swal.fire({
                icon: 'error',
                title: 'Error al enviar',
                text: err.message || 'Ocurrió un error inesperado'
            });
        }
    }

    function obtenerPartidasDeProveedor(tablaId) {
        const tabla = document.getElementById(tablaId);
        const filas = tabla.querySelectorAll('tbody tr');
        const partidas = [];

        filas.forEach(fila => {
            partidas.push({
                id_partidas: parseInt(fila.dataset.id_partidas),
                clave: fila.dataset.clave,
                descripcion: fila.dataset.descripcion,
                precio_unitario: parseFloat(fila.dataset.precio_unitario),
                cantidad: parseFloat(fila.dataset.cantidad),
                descuento: porcentajeDescuento(fila.dataset.descuento),
                total: parseFloat(fila.dataset.total),
                refe: parseInt(fila.dataset.refe)
            });
        });

        return partidas;
    }

    function checkValidacionGlobal() {
        const claves = document.querySelectorAll('.clave-input');
        const descripciones = document.querySelectorAll('.descripcion-input');

        let todoValido = true;

        claves.forEach(input => {
            if (input.dataset.valid !== "true") {
                todoValido = false;
            }
        });

        descripciones.forEach(input => {
            if (input.dataset.valid !== "true") {
                todoValido = false;
            }
        });

        document.getElementById('btn-aceptarcot').disabled = !todoValido;
    }</script>
