<style>
    .ticket-summary {
        font-family: 'Courier New', monospace;
        background: var(--bg-light);
        border: 2px dashed var(--border-light) !important;
        position: relative;
        box-shadow: var(--shadow-lg);
        border-left: 4px solid var(--primary-blue) !important;
    }

        .ticket-summary::before {
            content: '';
            position: absolute;
            top: -8px;
            left: 20px;
            right: 20px;
            height: 16px;
            background: repeating-linear-gradient( to right, transparent, transparent 10px, var(--border-light) 10px, var(--border-light) 20px );
        }

        .ticket-summary::after {
            content: '';
            position: absolute;
            bottom: -8px;
            left: 20px;
            right: 20px;
            height: 16px;
            background: repeating-linear-gradient( to right, transparent, transparent 10px, var(--border-light) 10px, var(--border-light) 20px );
        }

    .ticket-line {
        height: 1px;
        background: var(--border-light);
        margin: 0 auto;
        width: 80%;
    }

    .ticket-dots {
        font-size: 0.8em;
        color: var(--text-light);
        letter-spacing: 2px;
    }

    .ticket-title {
        color: var(--primary-blue);
    }

    .ticket-text {
        color: var(--text-dark);
    }

    .ticket-amount {
        color: var(--accent-blue);
    }

    .ticket-separator {
        color: var(--text-light);
    }

    .provider-card {
        border-radius: 1rem !important;
        transition: all 0.3s ease;
        background: var(--bg-light);
        border: 1px solid var(--border-light) !important;
    }

        .provider-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg) !important;
        }

    .bg-gradient-primary {
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%) !important;
    }

    .icon-circle {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .section-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 1rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid var(--border-light);
    }

    .section-divider {
        border: none;
        height: 2px;
        background: linear-gradient(90deg, transparent, var(--border-light), transparent);
        margin: 2rem 0;
    }

    .documents-section {
        background: var(--bg-gray);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-light);
    }

    .validation-section {
        background: var(--bg-gray);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-light);
    }

    .validation-card {
        background: var(--bg-light);
        transition: all 0.3s ease;
        border-color: var(--border-light) !important;
    }

        .validation-card:hover {
            box-shadow: var(--shadow);
        }

    .file-upload-card {
        background: var(--bg-light);
        border: 2px dashed var(--border-light);
        border-radius: 0.5rem;
        padding: 1rem;
        text-align: center;
        transition: all 0.3s ease;
        height: 100%;
    }

        .file-upload-card:hover {
            border-color: var(--primary-blue);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.15);
        }

    [data-theme="dark"] .file-upload-card:hover {
        box-shadow: 0 4px 12px rgba(59, 130, 246, 0.25);
    }

    .file-upload-header {
        display: flex;
        align-items: center;
        margin-bottom: 0.75rem;
        text-align: left;
    }

    .file-icon {
        width: 40px;
        height: 40px;
        border-radius: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 0.75rem;
        font-size: 1.2rem;
    }

        .file-icon.pdf {
            background: #dc3545;
            color: white;
        }

        .file-icon.xml {
            background: #28a745;
            color: white;
        }

        .file-icon.doc {
            background: #17a2b8;
            color: white;
        }

    .file-info h6 {
        margin-bottom: 0.25rem;
        font-weight: 600;
        color: var(--text-dark);
    }

    .file-input {
        border: 1px solid var(--border-light);
        border-radius: 0.375rem;
        padding: 0.5rem;
        font-size: 0.9rem;
        transition: all 0.3s ease;
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .file-input:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.25);
        }

    [data-theme="dark"] .file-input:focus {
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
    }

    .file-status {
        margin-top: 0.5rem;
        padding: 0.25rem 0.5rem;
        background: var(--bg-gray);
        border-radius: 0.25rem;
    }

    .configuration-section {
        background: var(--bg-light);
    }

    .config-card {
        background: var(--bg-gray);
        padding: 1.5rem;
        border-radius: 0.75rem;
        border: 1px solid var(--border-light);
        height: 100%;
    }

    .config-label {
        font-weight: 600;
        color: var(--text-dark);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
    }

    .required-asterisk {
        color: #dc3545;
        margin-left: 0.25rem;
    }

    .modern-select {
        border: 2px solid var(--border-light);
        border-radius: 0.5rem;
        padding: 0.75rem;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .modern-select:focus {
            border-color: var(--primary-blue);
            box-shadow: 0 0 0 0.2rem rgba(37, 99, 235, 0.25);
            background: var(--bg-light);
            color: var(--text-dark);
        }

    [data-theme="dark"] .modern-select:focus {
        box-shadow: 0 0 0 0.2rem rgba(59, 130, 246, 0.25);
    }

    .add-tax-btn {
        border: 2px dashed #28a745;
        font-weight: 600;
        transition: all 0.3s ease;
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .add-tax-btn:hover {
            background: #28a745;
            border-color: #28a745;
            color: white;
            transform: translateY(-1px);
        }

    .tax-container {
        max-height: 300px;
        overflow-y: auto;
    }

    .products-section .table-container {
        background: var(--bg-light);
        border-radius: 0.75rem;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-light);
    }

    .modern-table {
        margin: 0;
        background: var(--bg-light);
        color: var(--text-dark);
    }

        .modern-table thead {
            background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
            color: white;
        }

            .modern-table thead th {
                border: none;
                padding: 1rem;
                font-weight: 600;
                font-size: 0.9rem;
            }

        .modern-table tbody tr {
            transition: all 0.3s ease;
            background: var(--bg-light);
        }

            .modern-table tbody tr:hover {
                background: var(--bg-gray);
                transform: scale(1.01);
            }

        .modern-table tbody td {
            padding: 0.75rem;
            border-bottom: 1px solid var(--border-light);
            color: var(--text-dark);
        }

    /* Estilos para inputs de validación */
    .clave-input, .descripcion-input {
        background: var(--bg-light);
        color: var(--text-dark);
        border: 1px solid var(--border-light);
    }

        .clave-input:disabled, .descripcion-input:disabled {
            background: var(--bg-gray);
            color: var(--text-light);
        }

    .btn-outline-secondary {
        color: var(--text-dark);
        border-color: var(--border-light);
        background: var(--bg-light);
    }

        .btn-outline-secondary:hover {
            background: var(--bg-gray);
            border-color: var(--primary-blue);
            color: var(--primary-blue);
        }

    /* Text utilities adaptadas al tema */
    .text-muted {
        color: var(--text-light) !important;
    }

    /* Badges y elementos de color */
    .badge.bg-primary {
        background-color: var(--primary-blue) !important;
    }

    .badge.bg-info {
        background-color: var(--accent-blue) !important;
    }

    .text-success {
        color: #28a745 !important;
    }

    .text-primary {
        color: var(--primary-blue) !important;
    }

    .text-info {
        color: var(--accent-blue) !important;
    }

    .fw-bold {
        color: var(--text-dark) !important;
    }
</style>

<!-- Modal para aceptar cotización -->
<div class="modal fade" id="modalAceptarCotizacion" tabindex="-1" aria-labelledby="modalAceptadasLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalAceptadasLabel">
                    <i class="bi bi-check-circle-fill me-2"></i> Aceptar Cotización
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBody2">
                <!-- Aquí se cargan las partidas con sus opciones -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i> Cancelar
                </button>
                <button type="button" id="btn-aceptarcot" class="btn btn-success">
                    <i class="bi bi-check-lg me-1"></i> Aceptar Cotización
                </button>
            </div>
        </div>
    </div>
</div>
<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
<script src="~/lib/signature_pad/signature_pad.umd.min.js"></script>
<script src="~/scripts/compras-nacionales.js?v=@DateTime.Now.Ticks"></script>
<script>
    // Contador de impuestos por tabla de proveedor
    window.contadorImpuestos = window.contadorImpuestos || {};

    function aceptarCotizacion(row) {
        const id = row.id_encabezado;

        GetData({
            path: '/Requisicion/GetCotizacionPendienteData',
            data: { id: id }
        }).then((_res) => {
            if (_res.success) {
                const body = document.getElementById('modalBody2');
                body.innerHTML = ''; // Limpiar contenido

                // Card de Usuario Director
                const cardUsuario = document.createElement('div');
                cardUsuario.className = 'card shadow-sm border-0 mb-4';
                cardUsuario.style.backgroundColor = 'var(--bg-gray)';
                cardUsuario.style.borderRadius = '1rem';
                cardUsuario.style.padding = '1.5rem';

                cardUsuario.innerHTML = `
            <div class="row align-items-center">
                <div class="col-auto">
                    <div class="icon-circle bg-primary text-white">
                        <i class="fas fa-user-tie"></i>
                    </div>
                </div>
                <div class="col">
                    <label for="usuarioDirector" class="form-label fw-semibold mb-2">Director Responsable</label>
                    <select class="form-select form-select-lg" id="usuarioDirector">
                        <option selected disabled value="">Seleccione un director</option>
                    </select>
                </div>
            </div>
        `;

                body.appendChild(cardUsuario);
                let totalGlobal = 0;
                const selectDirector = document.getElementById('usuarioDirector');
                _res.returnResult.director.forEach(u => {
                    const opt = document.createElement('option');
                    opt.value = u.usuarioid;
                    opt.textContent = u.nombre_completo;
                    selectDirector.appendChild(opt);
                });

                const partidasPorProveedor = {};
                _res.returnResult.partidas.forEach(p => {
                    if (!partidasPorProveedor[p.cve_vdr_cpr]) {
                        partidasPorProveedor[p.cve_vdr_cpr] = [];
                    }
                    partidasPorProveedor[p.cve_vdr_cpr].push(p);
                });

                Object.entries(partidasPorProveedor).forEach(([proveedor, partidas]) => {
                    const tablaId = `tabla-materiales_${proveedor.replace(/[^a-zA-Z0-9]/g, '_')}`;

                    let totalProveedor = 0;

                    const div = document.createElement('div');
                    div.id = `card-proveedor-${proveedor}`;

                    let html = `
                <div class="card shadow-sm border-0 mb-4 provider-card">
                    <!-- Header del Proveedor -->
                    <div class="card-header bg-gradient-primary text-white">
                        <div class="d-flex align-items-center">
                            <div class="icon-circle bg-white text-primary me-3">
                                <i class="fas fa-building"></i>
                            </div>
                            <div>
                                <h5 class="mb-0 fw-bold">${proveedor}</h5>
                                <small class="opacity-75">Documentos y configuración</small>
                            </div>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Sección de Documentos -->
                        <div class="documents-section mb-4">
                            <h6 class="section-title mb-3">
                                <i class="fas fa-folder-open text-primary me-2"></i>
                                Documentos Requeridos
                            </h6>

                            <div class="row g-3">
                                <div class="col-lg-4 col-md-6">
                                    <div class="file-upload-card">
                                        <div class="file-upload-header">
                                            <div class="file-icon pdf">
                                                <i class="fas fa-file-pdf"></i>
                                            </div>
                                            <div class="file-info">
                                                <h6 class="mb-1">Factura</h6>
                                                <small class="text-muted">Archivo PDF requerido</small>
                                            </div>
                                        </div>
                                        <input type="file" class="form-control file-input" id="factura_${proveedor}" accept="application/pdf">
                                        <div class="file-status" id="status_factura_${proveedor}">
                                            <small class="text-muted">No se ha seleccionado archivo</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="file-upload-card">
                                        <div class="file-upload-header">
                                            <div class="file-icon xml">
                                                <i class="fas fa-code"></i>
                                            </div>
                                            <div class="file-info">
                                                <h6 class="mb-1">XML</h6>
                                                <small class="text-muted">Comprobante fiscal</small>
                                            </div>
                                        </div>
                                        <input type="file" class="form-control file-input" id="xml_${proveedor}" accept=".xml">
                                        <div class="file-status" id="status_xml_${proveedor}">
                                            <small class="text-muted">No se ha seleccionado archivo</small>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-lg-4 col-md-6">
                                    <div class="file-upload-card">
                                        <div class="file-upload-header">
                                            <div class="file-icon doc">
                                                <i class="fas fa-file-alt"></i>
                                            </div>
                                            <div class="file-info">
                                                <h6 class="mb-1">Cotización</h6>
                                                <small class="text-muted">Documento de cotización</small>
                                            </div>
                                        </div>
                                        <input type="file" class="form-control file-input" id="cotizacion_${proveedor}">
                                        <div class="file-status" id="status_cotizacion_${proveedor}">
                                            <small class="text-muted">No se ha seleccionado archivo</small>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- SECCIÓN DE VALIDACIÓN DE PRODUCTOS AGREGADA -->
                        <div class="validation-section mb-4">
                            <h6 class="section-title mb-3">
                                <i class="fas fa-check-double text-warning me-2"></i>
                                Validación de Productos
                            </h6>
                            <div class="row g-3">`;

                    // Agregar inputs de validación para cada producto único
                    const productosUnicos = [...new Map(partidas.map(p => [p.cve_prod, p])).values()];
                    productosUnicos.forEach((producto, index) => {
                        html += `
                                <div class="col-md-6 mb-3">
                                    <div class="validation-card p-3 border rounded">
                                        <div class="row align-items-center">
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Clave:</label>
                                                <div class="input-group">
                                                    <input type="text" class="form-control clave-input"
                                                           value="${producto.cve_prod}" disabled
                                                           data-id="${producto.cve_prod}_${index}">
                                                    <button type="button" class="btn btn-outline-secondary editar-clave-btn"
                                                            data-id="${producto.cve_prod}_${index}" title="Editar">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label fw-bold">Descripción:</label>
                                                <div class="input-group">
                                                    <input type="text" class="form-control descripcion-input"
                                                           value="${producto.descr_prod}" disabled
                                                           data-id="${producto.cve_prod}_${index}">
                                                    <button type="button" class="btn btn-outline-secondary editar-descripcion-btn"
                                                            data-id="${producto.cve_prod}_${index}" title="Editar descripción">
                                                        <i class="fas fa-edit"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>`;
                    });

                    html += `
                            </div>
                        </div>

                        <hr class="section-divider">

                        <!-- Sección de Configuración -->
                        <div class="configuration-section">
                            <h6 class="section-title mb-3">
                                <i class="fas fa-cogs text-success me-2"></i>
                                Configuración de Pago
                            </h6>

                            <div class="row g-4">
                                <!-- Forma de Pago -->
                                <div class="col-lg-6">
                                    <div class="config-card">
                                        <label for="formaPago_${tablaId}" class="form-label config-label">
                                            <i class="fas fa-credit-card text-success me-2"></i>
                                            Forma de Pago
                                            <span class="required-asterisk">*</span>
                                        </label>
                                        <select class="form-select form-select-lg modern-select" id="formaPago_${tablaId}" required>
                                            <option value="">Seleccionar forma de pago...</option>
                                            ${_res.returnResult.formasPago.map(fp => `
                                                <option style="color:var(--text-light);" value="${fp.id_f_pago}">${fp.descripcion}</option>
                                            `).join('')}
                                        </select>
                                    </div>
                                </div>

                                <!-- Impuestos -->
                                <div class="col-lg-6">
                                    <div class="config-card">
                                        <label class="form-label config-label">
                                            <i class="fas fa-percentage text-warning me-2"></i>
                                            Gestión de Impuestos
                                        </label>
                                        <button type="button" class="btn btn-outline-success btn-lg w-100 add-tax-btn" onclick="agregarImpuesto('${tablaId}')">
                                            <i class="fas fa-plus me-2"></i>
                                            Agregar Nuevo Impuesto
                                        </button>
                                        <div id="contenedor-impuestos-${tablaId}" class="tax-container mt-3"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr class="section-divider">

                        <!-- Tabla de Productos -->
                        <div class="products-section">
                            <h6 class="section-title mb-3">
                                <i class="fas fa-box text-info me-2"></i>
                                Productos y Servicios
                            </h6>

                            <div class="table-container">
                                <div class="table-responsive">
                                    <table class="table modern-table align-middle" id="${tablaId}">
                                        <thead>
                                            <tr>
                                                <th><i class="fas fa-barcode me-2"></i>Código</th>
                                                <th><i class="fas fa-file-text me-2"></i>Descripción</th>
                                                <th><i class="fas fa-dollar-sign me-2"></i>Precio Unit.</th>
                                                <th><i class="fas fa-calculator me-2"></i>Cantidad</th>
                                                <th><i class="fas fa-receipt me-2"></i>Subtotal</th>
                                                <th><i class="fas fa-percentage me-2"></i>Descuento %</th>
                                                <th><i class="fas fa-tag me-2"></i>Importe descuento</th>
                                                <th><i class="fas fa-receipt me-2"></i>Total</th>
                                            </tr>
                                        </thead>
                                        <tbody></tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

