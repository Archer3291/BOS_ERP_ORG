    function obtenerImpuestosDeTabla(tablaId) {
        const contenedor = document.getElementById(`contenedor-impuestos-${tablaId}`);
        const impuestos = [];

        if (!contenedor) return impuestos;

        contenedor.querySelectorAll('div[id^="impuesto-"]').forEach(div => {
            const tipo = div.querySelector('select').value;
            const tasa = parseFloat(div.querySelector('input').value);
            if (tipo && !isNaN(tasa)) {
                impuestos.push({ tipo, tasa });
            }
        });

        return impuestos;
    }

