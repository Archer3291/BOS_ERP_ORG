@{
    ViewBag.Title = "Requisision de Material";
}

<link href="~/content/sidebar.css" rel="stylesheet" />
<link href="/lib/tom-select/css/tom-select.css" rel="stylesheet" />
<link href="/content/TableBuilder.css" rel="stylesheet" />
<style>
    .modal-xl-custom-director {
        max-width: 95%;
    }

    .modal-content-director {
        background: var(--bg-light);
        color: var(--text-dark);
        border: 1px solid var(--border-light);
    }

    .modal-header-director, .modal-footer-director {
        background: var(--bg-gray);
        border-color: var(--border-light);
    }

    .provider-card-director {
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--primary-blue-dark) 100%);
        color: white;
        border-radius: 15px;
        box-shadow: var(--shadow-lg);
    }

    .product-table-director {
        background: var(--bg-light);
        border-radius: 10px;
        overflow: auto;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-light);
    }

    #partidas-proveedor-director th {
        background: var(--very-light-blue);
        color: var(--text-dark);
        font-weight: 600;
        border: none;
        padding: 15px 10px;
    }

    #partidas-proveedor-director td {
        background: var(--bg-light);
        color: var(--text-dark);
        border: none;
        padding: 12px 10px;
        border-bottom: 1px solid var(--border-light);
    }

    .file-attachment-director {
        background: var(--bg-gray);
        border: 2px dashed var(--border-light);
        border-radius: 10px;
        transition: all 0.3s ease;
    }

        .file-attachment-director:hover {
            border-color: var(--primary-blue);
            background: var(--light-blue);
        }

    .cost-summary-director {
        background: linear-gradient(135deg, var(--primary-blue) 0%, var(--accent-blue) 100%);
        color: white;
        border-radius: 15px;
        box-shadow: var(--shadow-lg);
    }

    .comment-section-director {
        background: var(--very-light-blue);
        border-left: 4px solid var(--accent-blue);
        border-radius: 8px;
    }

        .comment-section-director textarea {
            background: var(--bg-light);
            border: 1px solid var(--border-light);
            color: var(--text-dark);
        }

    .btn-provider-director {
        background: linear-gradient(45deg, var(--primary-blue), var(--primary-blue-dark));
        border: none;
        border-radius: 25px;
        padding: 12px 30px;
        color: white;
        transition: all 0.3s ease;
    }

        .btn-provider-director:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
            color: white;
            background: linear-gradient(45deg, var(--secondary-blue), var(--primary-blue));
        }

    .provider-info-director {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .provider-avatar-director {
        width: 60px;
        height: 60px;
        background: rgba(255,255,255,0.2);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .status-badge-director {
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }

    .status-active-director {
        background: var(--light-blue);
        color: var(--dark-blue);
    }

    .status-pending-director {
        background: #fef3c7;
        color: #92400e;
    }

    .status-inactive-director {
        background: #fecaca;
        color: #b91c1c;
    }

    .file-item-director {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 10px;
        margin: 5px 0;
        transition: all 0.3s ease;
        color: var(--text-dark);
    }

        .file-item-director:hover {
            border-color: var(--primary-blue);
            transform: translateX(5px);
            box-shadow: var(--shadow);
        }

    /* Estilos para el contenedor de tablas */
    .contenedor-tabla-director {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        box-shadow: var(--shadow-lg);
        padding: 1.5rem;
        margin-bottom: 2rem;
        position: relative;
        overflow: hidden;
        transition: all 0.3s ease;
    }

        .contenedor-tabla-director:hover {
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            transform: translateY(-2px);
        }

        /* Efecto de gradiente sutil en la parte superior */
        .contenedor-tabla-director::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
            background: linear-gradient(90deg, var(--primary-blue), var(--accent-blue), var(--secondary-blue));
            border-radius: 8px 8px 0 0;
        }

        /* Mejora para el table-responsive dentro del contenedor */
        .contenedor-tabla-director .table-responsive {
            border-radius: 5px;
            box-shadow: var(--shadow);
            background: var(--bg-light);
            border: 1px solid var(--border-light);
        }

        /* Estilo adicional para cuando la tabla está vacía o cargando */
        .contenedor-tabla-director.loading {
            background: linear-gradient(45deg, var(--very-light-blue), var(--light-blue));
            animation: pulse 2s ease-in-out infinite;
        }

        .contenedor-tabla-director.empty {
            text-align: center;
            padding: 3rem 1.5rem;
            color: var(--text-light);
        }

            .contenedor-tabla-director.empty::after {
                content: '📊 No hay datos disponibles';
                font-size: 1.1rem;
                display: block;
                margin-top: 1rem;
            }
</style>
<form>
    @Html.AntiForgeryToken()
</form>

<div class="mb-4 w-50">
    <label for="selectorTablaDirector" class="form-label">
        <i class="fa-solid fa-table"></i> Mostrar tabla
    </label>
    <select id="selectorTablaDirector" class="form-select">
        <option value="tablaPendientesDirector">Documentos pendientes</option>
        <option value="tablaEditadasDirector">Ordenes de compra editadas</option>
        <option value="tablaRechazadosDirector">Documentos rechazados</option>
    </select>
</div>

<div>
    <div class="contenedor-tabla-director" id="contenedor-tablaPendientesDirector"><div id="tablaPendientesDirector"></div></div>
    <div class="contenedor-tabla-director" id="contenedor-tablaEditadasDirector"><div id="tablaEditadasDirector"></div></div>
    <div class="contenedor-tabla-director" id="contenedor-tablaRechazadosDirector"><div id="tablaRechazadosDirector"></div></div>
</div>

<!-- Modal para agregar las opciones -->
<div class="modal fade" id="modalAceptarCotizacionDirector" tabindex="-1" aria-labelledby="modalOpcionesLabelDirector" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalOpcionesLabelDirector"><i class="bi bi-pencil-square"></i> Editar Requisición</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body" id="modalBodyDirector">
                <div id="modalDireccionDirector"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" id="btn-actualizar-director" class="btn btn-success"><i class="bi bi-save-fill"></i> Guardar cambios</button>
            </div>
        </div>
    </div>
</div>

<script src="~/lib/tom-select/js/tom-select.complete.min.js"></script>
<script src="~/lib/signature_pad/signature_pad.umd.min.js"></script>
<script src="~/scripts/TableBuilder.js"></script>
<script src="~/scripts/compras-nacionales.js?v=@DateTime.Now.Ticks"></script>

<script>
    const TABLAS_DIRECTOR = {
        tablaPendientesDirector: {
            url: '/Requisicion/GetCotizacionDirector',
            acciones: [
                { icon: 'fa-circle-info', color: 'sky-500', title: 'Ver detalles', onClick: row => GetInfoGeneral(row.id_encabezado) },
                { icon: 'fa-circle-check', color: 'btn-success', title: 'Aceptar cotización', onClick: row => aceptarCotizacionDirector(row) },
                {
                    icon: 'fa-file-invoice', color: 'green-500', title: 'Descargar cotización',
                    onClick: row => row.variacion > 0
                        ? generarPDFOpciones(row.id_encabezado)
                        : GenerarPDFGeneral(row.encabezados_padre)
                },
                { icon: 'fa-download', color: 'green-500', title: 'Descargar requisición de material', onClick: row => GenerarPDFGeneral(row.id_encabezado) },
                { icon: 'fa-trash', color: 'red-500', title: 'Rechazar', onClick: row => rechazarRequisicionDirector(row.id_encabezado) },
            ]
        },
        // Ordenes de compra que Compras o el gerente editaron: vuelven a aprobarse aqui
        tablaEditadasDirector: {
            url: '/Requisicion/GetCotizacionEditadaDirector',
            acciones: [
                { icon: 'fa-circle-info', color: 'sky-500', title: 'Ver detalles', onClick: row => GetInfoGeneral(row.id_encabezado) },
                { icon: 'fa-circle-check', color: 'btn-success', title: 'Aprobar la edición', onClick: row => aceptarEdicionDirector(row.id_encabezado) },
                { icon: 'fa-trash', color: 'red-500', title: 'Rechazar la edición', onClick: row => rechazarRequisicionDirector(row.id_encabezado) },
                { icon: 'fa-download', color: 'green-500', title: 'Descargar orden de compra', onClick: row => GenerarPDFGeneral(row.id_encabezado) },
            ]
        },
        tablaRechazadosDirector: {
            url: '/Requisicion/GetRechazadasDirector',
            acciones: [
                { icon: 'fa-circle-info', color: 'sky-500', title: 'Ver detalles', onClick: row => GetInfoGeneral(row.id_encabezado) },
                { icon: 'fa-rotate-left', color: 'btn-success', title: 'Volver a abrir', onClick: row => reAbrirRequisicionDirector(row.id_encabezado) },
            ]
        }
    };

    const tablasDirector = {};

    document.addEventListener("DOMContentLoaded", function () {
        const selectorDirector = document.getElementById("selectorTablaDirector");

        mostrarSoloTablaDirector(selectorDirector.value);
        selectorDirector.addEventListener("change", () => mostrarSoloTablaDirector(selectorDirector.value));

        const folio = folioDeLaUrl();

        Object.entries(TABLAS_DIRECTOR).forEach(([id, config]) => {
            tablasDirector[id] = createTable({
                selector: `#${id}`,
                path: config.url,
                rowKey: 'id_encabezado',
                searchPlaceholder: 'Buscar por folio, responsable u observaciones...',
                sortDir: 'desc',
                data: () => ({ folio }),
                columns: columnasDocumento(),
                actions: config.acciones,
                exports: ['excel'],
            });
        });
    });

    function mostrarSoloTablaDirector(tablaId) {
        document.querySelectorAll(".contenedor-tabla-director").forEach(contenedor => {
            contenedor.style.display = contenedor.id === `contenedor-${tablaId}` ? "block" : "none";
        });
    }

    function actualizarTablaDirector() {
        Object.values(tablasDirector).forEach(t => t.refreshPage());
    }

    document.getElementById('modalAceptarCotizacionDirector').addEventListener('hidden.bs.modal', () => {
        document.getElementById("ComentarioCompraDirector").value = "";
    })

    function aceptarEdicionDirector(id_encabezado) {
        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
                <style>
                    .flip {
                        animation: spinY 2s linear infinite;
                        transform-origin: center;
                    }
                    @@keyframes spinY {
                        0%   { transform: rotateY(0deg); }
                        100% { transform: rotateY(360deg); }
                    }
                </style>
                <g class="flip">
                    <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                    <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                    <circle cx="32" cy="48" r="3" fill="#000"/>
                </g>
            </svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: 'Seguro?',
            text: '¿Está seguro que desea re abrir la requisicion?',
            footer: '<b style="color: red;">ADVERTENCIA - Este cambio no se puede revertir</b>',
            customClass: {
                icon: 'p-0 bg-transparent border-0 shadow-none'
            },
            preConfirm: () => {
                GetData({
                    path: '/Requisicion/aceptarEdicion',
                    data: { id_encabezado: id_encabezado }
                }).then((_res) => {
                    if (_res.success) {
                        toastMixin.fire({
                            icon: 'success',
                            title: 'Requisicion reabierta'
                        });
                        actualizarTablaDirector();
                    } else {
                        toastMixin.fire({
                            icon: 'error',
                            title: _res.message,
                        })
                    }
                })
            }
        })
    }

    function reAbrirRequisicionDirector(id_encabezado) {
        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display: block; margin: auto;">
                <style>
                    .flip {
                        animation: spinY 2s linear infinite;
                        transform-origin: center;
                    }
                    @@keyframes spinY {
                        0%   { transform: rotateY(0deg); }
                        100% { transform: rotateY(360deg); }
                    }
                </style>
                <g class="flip">
                    <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                    <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                    <circle cx="32" cy="48" r="3" fill="#000"/>
                </g>
            </svg>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: 'Seguro?',
            text: '¿Está seguro que desea re abrir la requisicion?',
            footer: '<b style="color: red;">ADVERTENCIA - Este cambio no se puede revertir</b>',
            customClass: {
                icon: 'p-0 bg-transparent border-0 shadow-none'
            },
            preConfirm: () => {
                GetData({
                    path: '/Requisicion/ReAbrirRequisicion',
                    data: { id_encabezado: id_encabezado }
                }).then((_res) => {
                    if (_res.success) {
                        toastMixin.fire({
                            icon: 'success',
                            title: 'Requisicion reabierta'
                        });
                        actualizarTablaDirector();
                    } else {
                        toastMixin.fire({
                            icon: 'error',
                            title: _res.message,
                        })
                    }
                })
            }
        })
    }

    function aceptarCotizacionDirector(row) {
        const idDirector = row.id_encabezado;

        GetData({
            path: '/Requisicion/GetCotizacionPendienteDataDirector',
            data: { id: idDirector }
        }).then((_res) => {
            if (_res.success) {
                const bodyDirector = document.getElementById('modalDireccionDirector');
                const partidasDirector = _res.returnResult.partidas;
                const documentoDirector = _res.returnResult.requisicion;
                const archivosDirector = _res.returnResult.archivos;
                const impuestosDirector = _res.returnResult.impuestos;

                const proveedoresDirector = {};

                partidasDirector.forEach(partida => {
                    let claveDirector = partida.refe || partida.cve_vdr_cpr?.trim().toLowerCase() || 'proveedor_sin_nombre';

                    if (!proveedoresDirector[claveDirector]) {
                        proveedoresDirector[claveDirector] = {
                            idProveedor: partida.refe || null,
                            nombreProveedor: partida.cve_vdr_cpr || 'Proveedor sin nombre',
                            partidas: [],
                            archivos: [],
                            impuestos: []
                        };
                    }

                    proveedoresDirector[claveDirector].partidas.push(partida);

                    const nombreNormalizadoDirector = partida.cve_vdr_cpr?.trim().toLowerCase() || '';

                    const archivosRelacionadosDirector = archivosDirector.filter(a =>
                        a.proveedor_nombre?.trim().toLowerCase() === nombreNormalizadoDirector
                    );
                    archivosRelacionadosDirector.forEach(archivo => {
                        if (!proveedoresDirector[claveDirector].archivos.includes(archivo)) {
                            proveedoresDirector[claveDirector].archivos.push(archivo);
                        }
                    });

                    const impuestosRelacionadosDirector = impuestosDirector.filter(i =>
                        i.prov_nom?.trim().toLowerCase() === nombreNormalizadoDirector
                    );
                    impuestosRelacionadosDirector.forEach(impuesto => {
                        if (!proveedoresDirector[claveDirector].impuestos.includes(impuesto)) {
                            proveedoresDirector[claveDirector].impuestos.push(impuesto);
                        }
                    });
                });

                const gruposDirector = Object.values(proveedoresDirector);

                bodyDirector.innerHTML = '';
                let htmlDirector = `` +
                    `<div class="comment-section-director p-3 mb-4">` +
                    `    <h6 class="mb-3"><i class="fas fa-comment-alt me-2"></i>Comentarios del Pedido</h6>` +
                    `    <textarea class="form-control" rows="3" id="ComentarioCompraDirector" placeholder="Agregar comentarios sobre el pedido, especificaciones especiales, fechas de entrega, etc."></textarea>` +
                    `    <textarea id="partidasDirector" class="d-none">${JSON.stringify(partidasDirector)}</textarea>` +
                    `</div>` +
                    `` +
                    `<div class="row">`;

                gruposDirector.forEach((proveedorDirector) => {
                    htmlDirector += `` +
                        `    <div class="col-12 mb-4">` +
                        `        <div class="provider-card-director p-4">` +
                        `            <div class="provider-info-director mb-3">` +
                        `                <div class="provider-avatar-director">` +
                        `                    <i class="fas fa-industry"></i>` +
                        `                </div>` +
                        `                <div>` +
                        `                    <h5 class="mb-1">${proveedorDirector.nombreProveedor}</h5>` +
                        `                </div>` +
                        `            </div>` +
                        `            ` +
                        `            <div class="table-responsive product-table-director">` +
                        `                <table class="table table-hover mb-0" id="partidas-proveedor-director">` +
                        `                    <thead>` +
                        `                        <tr>` +
                        `                            <th>Código</th>` +
                        `                            <th>Producto</th>` +
                        `                            <th>Unidad</th>` +
                        `                            <th>Cantidad</th>` +
                        `                            <th>Precio Unit.</th>` +
                        `                            <th>Subtotal</th>` +
                        `                            <th>Descuento %</th>` +
                        `                            <th>Importe descuento</th>` +
                        `                            <th>Total</th>` +
                        `                        </tr>` +
                        `                    </thead>` +
                        `                    <tbody>`;
                    proveedorDirector.partidas.forEach((partidaDirector) => {
                        const cantidad = parseFloat(partidaDirector.cant_ud) || 0;
                        const precio = parseFloat(partidaDirector.pv_prod) || 0;
                        const dto1 = porcentajeDescuento(partidaDirector.descuento);

                        htmlDirector += `` +
                            `                        <tr>` +
                            `                            <td><strong>${partidaDirector.cve_prod}</strong></td>` +
                            `                            <td><strong>${partidaDirector.descr_prod}</strong></td>` +
                            `                            <td><strong>${partidaDirector.ud}</strong></td>` +
                            `                            <td><strong>${cantidad}</strong></td>` +
                            `                            <td><strong class="text-success">${Currency.format(precio)}</strong></td>` +
                            `                            <td><strong>${Currency.format(brutoPartida(cantidad, precio))}</strong></td>` +
                            `                            <td><span class="badge bg-warning text-dark">${formatoPorcentaje(dto1)}</span></td>` +
                            `                            <td><strong class="text-danger">- ${Currency.format(descuentoPartida(cantidad, precio, dto1))}</strong></td>` +
                            `                            <td><strong>${Currency.format(netoPartida(cantidad, precio, dto1))}</strong></td>` +
                            `                        </tr>`;
                    })
                    htmlDirector += `` +
                        `                    </tbody>` +
                        `                </table>` +
                        `            </div>`;

                htmlDirector += `` +
                    `` +
                    `<div class="row mt-2">` +
                    `    <div class="col-md-6">` +
                    `        <div class="file-attachment-director p-4 h-100">` +
                    `            <h6 class="mb-3"><i class="fas fa-paperclip me-2"></i>Archivos Adjuntos</h6>` +
                    ``;
                proveedorDirector.archivos.forEach((archivoDirector) => {
                htmlDirector += `` +
                    `            <div class="file-item-director">` +
                    `                <div class="d-flex justify-content-between align-items-center">` +
                    `                    <div class="d-flex align-items-center">` +
                    `                        <i class="fas ${getIconFile(archivoDirector.extencion)} text-danger me-2"></i>` +
                    `                        <div>` +
                    `                            <strong>${archivoDirector.nombre_original}</strong>` +
                    `                            <small class="text-muted d-block">${dateFormatter(documentoDirector.fch)}</small>` +
                    `                        </div>` +
                    `                    </div>` +
                    `                    <div>` +
                    `                        <a href="/${archivoDirector.path}" download="${archivoDirector.nombre_original}" class="btn btn-sm btn-outline-primary me-1" title="Descargar">` +
                    `                            <i class="fas fa-download"></i>` +
                    `                        </a>` +
                    `                    </div>` +
                    `                </div>` +
                    `            </div>`;
                })
                    const totalesProveedor = totalizarPartidas(proveedorDirector.partidas, item => ({
                        cantidad: item.cant_ud, precio: item.pv_prod, dto1: item.descuento
                    }));
                    const subtotalDescuento = totalesProveedor.base;
                    htmlDirector +=
                        `        </div>` +
                        `    </div>` +
                        `` +
                        `    <div class="col-md-6">` +
                        `        <div class="cost-summary-director p-4">` +
                        `            <h6 class="mb-3"><i class="fas fa-calculator me-2"></i>Resumen de Costos</h6>` +
                        ``;
                    htmlDirector += `` +
                        `            <div class="row mb-2">` +
                        `                <div class="col-8"><strong>Subtotal:</strong></div>` +
                        `                <div class="col-4 text-end"><strong>${Currency.format(totalesProveedor.subtotal)}</strong></div>` +
                        `            </div>` +
                        `            <div class="row mb-3">` +
                        `                <div class="col-8"><strong>Descuento:</strong></div>` +
                        `                <div class="col-4 text-end"><strong>- ${Currency.format(totalesProveedor.descuento)}</strong></div>` +
                        `            </div>` +
                        `            <div class="row mb-3">` +
                        `                <div class="col-8"><strong>Base gravable:</strong></div>` +
                        `                <div class="col-4 text-end"><strong>${Currency.format(subtotalDescuento)}</strong></div>` +
                        `            </div>`;
                    let totalImpuestoDirector = 0;
                    proveedorDirector.impuestos.forEach((impuestoDirector) => {
                        totalImpuestoDirector += impuestoDirector.es_retencion ? -impuestoDirector.importe : impuestoDirector.importe;
                        htmlDirector += `` +
                            `            <div class="row mb-3">` +
                            `                <div class="col-8">` +
                            `                    ${impuestoDirector.cve_impuesto} (${impuestoDirector.es_retencion ? '-' + impuestoDirector.imp_variable : impuestoDirector.imp_variable}%)` +
                            `                </div>` +
                            `                <div class="col-4 text-end">` +
                            `                    <strong>${impuestoDirector.es_retencion ? '-' + Currency.format(impuestoDirector.importe) : Currency.format(impuestoDirector.importe) }</strong>` +
                            `                </div>` +
                            `            </div>`;
                    })
                    htmlDirector += `` +
                        `` +
                        `            <hr class="my-3" style="border-color: rgba(255,255,255,0.3);">` +
                        `` +
                        `                <div class="row">` +
                        `                    <div class="col-8">` +
                        `                        <h5><strong>Total a Pagar:</strong></h5>` +
                        `                    </div>` +
                        `                    <div class="col-4 text-end">` +
                        `                        <h4><strong>${Currency.format(subtotalDescuento + totalImpuestoDirector)}</strong></h4>` +
                        `                        <input type="hidden" id="totalDirector" value="${parseFloat(subtotalDescuento + totalImpuestoDirector).toFixed(2)}">` +
                        `                    </div>` +
                        `                </div>` +
                        `` +
                        `                <div class="mt-3 p-2" style="background: rgba(255,255,255,0.1); border-radius: 8px;">` +
                        `                    <small><i class="fas fa-info-circle me-1"></i>Precios en MXN.</small>` +
                        `                </div>` +
                        `        </div>` +
                        `    </div>` +
                        `    </div>` +
                        `    </div>` +
                        `    </div>`;
                })
                htmlDirector +=`</div>`;
                bodyDirector.innerHTML = htmlDirector;

                $('#modalAceptarCotizacionDirector').data('encabezado', idDirector);
                $('#modalOpcionesLabelDirector').html(`<i class="bi bi-check-circle-fill me-2"></i> Aceptar Cotización No. ${_res.returnResult.requisicion.nuevo_codigo} <small style="font-size:12px">(Variacion: ${_res.returnResult.requisicion.variacion})</small>`);
                $('#modalAceptarCotizacionDirector').modal('show');
            } else {
                toastMixin.fire({
                    icon: 'error',
                    title: _res.error
                });
            }
        });
    }

    document.getElementById('btn-actualizar-director').addEventListener('click', function () {
        const idEncabezadoDirector = $('#modalAceptarCotizacionDirector').data('encabezado');
        const formDataDirector = new FormData();

        const tokenDirector = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
        if (tokenDirector) {
            formDataDirector.append('__RequestVerificationToken', tokenDirector);
        }

        formDataDirector.append('id_encabezado', idEncabezadoDirector);
        formDataDirector.append('comentario', $('#ComentarioCompraDirector').val());
        formDataDirector.append('partidas', $('#partidasDirector').val());
        formDataDirector.append('total', $('#totalDirector').val());

        let signaturePadDirector;
        let canvasDirector;

        _Swal.fire({
            title: 'Firma el documento antes de continuar',
            html: '' +
                '<div class="border-1">' +
                '    <p>Firma del usuario</p>' +
                '    <canvas id="signatureDirector" width="400" height="200" style="border:1px solid #ccc;"></canvas>' +
                '    <button type="button" class="btn green-500 mt-2" id="limpiar_firma_director">Limpiar</button>' +
                '</div>',
            allowOutsideClick: false,
            allowEscapeKey: false,
            didOpen: () => {
                const canvasDirector = document.getElementById("signatureDirector");
                const signaturePadDirector = new SignaturePad(canvasDirector, {
                    penColor: "rgb(0, 0, 0)",
                    minWidth: 0.5,
                    maxWidth: 1.0,
                    throttle: 16,
                    minDistance: 3
                });

                const firmaBase64Director = '@Context.Session.GetString("Firma")';

                if (firmaBase64Director && firmaBase64Director !== 'null' && firmaBase64Director.trim() !== '') {
                    signaturePadDirector.fromDataURL(firmaBase64Director);
                }

                document.getElementById('limpiar_firma_director').addEventListener('click', () => {
                    signaturePadDirector.clear();
                });

                Swal.__signaturePadDirector = signaturePadDirector;
                Swal.__canvasDirector = canvasDirector;
            },
            preConfirm: () => {
                const signaturePadDirector = Swal.__signaturePadDirector;
                const canvasDirector = Swal.__canvasDirector;

                if (!signaturePadDirector || signaturePadDirector.isEmpty()) {
                    Swal.showValidationMessage('Debes firmar antes de continuar.');
                    return false;
                }

                const dataUrlDirector = signaturePadDirector.toDataURL("image/png", 0.5);
                formDataDirector.append('firma6', dataUrlDirector);

                Swal.fire({
                    title: 'Generando Orden de Compra...',
                    allowOutsideClick: false,
                    allowEscapeKey: false,
                    showConfirmButton: false,
                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                return fetch('/Requisicion/GenerarOC', {
                    method: 'POST',
                    body: formDataDirector
                })
                    .then(res => res.json())
                    .then(data => {
                        if (!data.success) {
                            throw new Error(data.message || 'No se pudo guardar.');
                        }
                        return data;
                    })
                    .catch(err => {
                        Swal.showValidationMessage(`Error: ${err.message}`);
                    });
            }
        }).then(resultDirector => {
            if (resultDirector.isConfirmed && resultDirector.value) {
                let mensajeFoliosDirector = '';
                if (Array.isArray(resultDirector.value.folios_generados)) {
                    mensajeFoliosDirector = resultDirector.value.folios_generados.map(f => `• ${f}`).join('<br>');
                } else {
                    mensajeFoliosDirector = `• ${resultDirector.value.folios_generados}`;
                }

                Swal.fire(
                    'Guardado',
                    `La selección fue actualizada correctamente.<br><strong>Folios generados:</strong><br>${mensajeFoliosDirector}`,
                    'success'
                );

                $('#modalAceptarCotizacionDirector').modal('hide');
                actualizarTablaDirector();
            }
        });
    });

    function rechazarRequisicionDirector(id_encabezado) {
        GetData({
            path: '/Requisicion/getCatalogoRechazos',
        }).then((_res) => {
            const opcionesDirector = {};
            _res.rechazos.forEach((rechazoDirector) => {
                opcionesDirector[rechazoDirector.id] = rechazoDirector.nombre;
            });

            _Swal.fire({
                title: "Selecciona un motivo de rechazo",
                input: "select",
                inputOptions: opcionesDirector,
                inputPlaceholder: "Motivos de rechazo",
                customClass: {
                    input: 'form-control'
                },
                inputValidator: (motivo_rechazo_director) => {
                    return new Promise((resolve) => {
                        if (Number.isInteger(parseInt(motivo_rechazo_director)) && parseInt(motivo_rechazo_director) > 0) {
                            resolve();
                        } else {
                            resolve("Debes seleccionar un motivo válido.");
                        }
                    });
                },
                didOpen: () => {
                    const inputDirector = Swal.getInput();
                    inputDirector.style.width = 'auto';
                    inputDirector.style.minWidth = 'unset';
                    inputDirector.style.maxWidth = 'unset';
                },
                showCancelButton: true,
                preConfirm: (motivo_rechazo_director) => {
                    GetData({
                        path: '/Requisicion/rechazarRequisicionDirector',
                        data: {
                            motivo_rechazo: motivo_rechazo_director,
                            id_encabezado: id_encabezado
                        }
                    }).then((_resultDirector) => {
                        if (_resultDirector.success) {
                            toastMixin.fire({
                                icon: 'success',
                                title: 'Requisicion rechazada, se a notificado a los usuarios el motivo del rechazo.'
                            });
                            actualizarTablaDirector();
                        } else {
                            toastMixin.fire({
                                icon: 'error',
                                title: _resultDirector.message
                            })
                        }
                    })
                }
            });
        })
    }
</script>