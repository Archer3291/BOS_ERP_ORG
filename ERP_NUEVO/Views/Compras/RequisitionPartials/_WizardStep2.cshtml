        color: white;
    }

        .btn-modern-success:hover {
            background: linear-gradient(135deg, var(--success-color) 0%, #047857 100%);
        }

    .btn-modern-danger {
        background: linear-gradient(135deg, #ef4444 0%, var(--danger-color) 100%);
        color: white;
    }

        .btn-modern-danger:hover {
