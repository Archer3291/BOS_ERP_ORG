    async function agregarImpuesto(cardId) {
        if (!impuestosPorProveedor[cardId]) {
            impuestosPorProveedor[cardId] = [];
        }

        if (impuestosPorProveedor[cardId].length >= 4) {
            toastMixin.fire({
                icon: 'warning',
                title: 'Máximo 4 impuestos permitidos por proveedor.'
            });
            return;
        }

        const impuestoId = `impuesto-${cardId}-${Date.now()}`;
        const listaImpuestos = document.getElementById(`lista-impuestos-${cardId}`);

        const impuestoHTML = `
        <div class="impuesto-item mb-3" id="${impuestoId}" data-impuesto-id="${impuestoId}">
            <div class="row g-2 align-items-center">
                <div class="col-10">
                    <select class="form-select-modern select-impuesto-dinamico select-impuesto-${cardId}"
                            id="select-${impuestoId}"
                            onchange="calcularTotalProveedor('${cardId}')">
                        <option value="">Seleccionar impuesto...</option>
                    </select>
                </div>
                <div class="col-2">
                    <button type="button" class="btn-icon btn-modern-danger w-100"
                            onclick="eliminarImpuesto('${cardId}', '${impuestoId}')"
                            title="Eliminar impuesto">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>
        </div>
    `;

        listaImpuestos.insertAdjacentHTML('beforeend', impuestoHTML);
        await cargarOpcionesImpuesto(impuestoId);

        impuestosPorProveedor[cardId].push(impuestoId);
        actualizarBotonAgregarImpuesto(cardId);
    }

    async function cargarOpcionesImpuesto(impuestoId) {
        try {
            const listaIva = await GetData({ path: '/Requisicion/GetListaIva' });
            const select = document.querySelector(`#${impuestoId} select`);

            listaIva.forEach(imp => {
                const option = document.createElement('option');
                option.value = imp.id_impuesto;
                option.textContent = `${imp.cve_impuesto} - ${imp.desc} (${imp.tasa_imp}%)`;
                option.dataset.tasa = imp.tasa_imp;
                option.dataset.tipo = imp.tipo_imp;
                option.dataset.retencion = imp.es_retencion;
                select.appendChild(option);
            });
        } catch (error) {
            console.error('Error al cargar impuestos:', error);
        }
    }

    function eliminarImpuesto(cardId, impuestoId) {
        const elemento = document.getElementById(impuestoId);
        if (elemento) {
            elemento.remove();
        }

        if (impuestosPorProveedor[cardId]) {
            impuestosPorProveedor[cardId] = impuestosPorProveedor[cardId].filter(id => id !== impuestoId);
        }

        actualizarBotonAgregarImpuesto(cardId);
        calcularTotalProveedor(cardId);

        toastMixin.fire({
            icon: 'success',
            title: 'Impuesto eliminado correctamente.'
        });
    }

    function eliminarProveedor(cardId, proveedorId) {
        _Swal.fire({
            title: '¿Estás seguro?',
            text: 'Se eliminará el proveedor y todos sus productos',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonText: 'Sí, eliminar',
            cancelButtonText: 'Cancelar'
        }).then((result) => {
            if (result.isConfirmed) {
                document.getElementById(cardId).remove();
                delete proveedoresActivos[proveedorId];
                delete impuestosPorProveedor[cardId];
                calcularTotalGeneral();

                toastMixin.fire({
                    icon: 'success',
                    title: 'Proveedor eliminado correctamente.'
                });
            }
        });
    }

    function actualizarBotonAgregarImpuesto(cardId) {
        const boton = document.getElementById(`btn-agregar-impuesto-${cardId}`);
        if (!boton) return;

        const cantidadImpuestos = impuestosPorProveedor[cardId]?.length || 0;

        if (cantidadImpuestos >= 4) {
            boton.disabled = true;
            boton.style.opacity = '0.5';
            boton.style.cursor = 'not-allowed';
        } else {
            boton.disabled = false;
            boton.style.opacity = '1';
            boton.style.cursor = 'pointer';
        }
    }

    function calcularTotalProveedor(cardId) {
        const filas = [...document.querySelectorAll(`#tabla-${cardId} tbody tr`)];
        let subtotalProveedor = 0;

        filas.forEach((row, i) => {
            row.cells[1].innerText = i + 1;

            const { cantidad, precio, dto1 } = leerFila(row);

            row.querySelector(".subtotal-fila").innerText = Currency.format(brutoPartida(cantidad, precio));
            row.querySelector(".total-fila").innerText = Currency.format(netoPartida(cantidad, precio, dto1));
        });

        const totalesProveedor = totalizarPartidas(filas, leerFila);
        subtotalProveedor = totalesProveedor.base;

        document.getElementById(`bruto-${cardId}`).innerText = Currency.format(totalesProveedor.subtotal);
        document.getElementById(`dto-${cardId}`).innerText = totalesProveedor.descuento > 0
            ? `-${Currency.format(totalesProveedor.descuento)}`
            : Currency.format(0);
        document.getElementById(`subtotal-${cardId}`).innerText = Currency.format(subtotalProveedor);

        let totalImpuestos = 0;
        const detalleImpuestosContainer = document.getElementById(`detalle-impuestos-${cardId}`);
        detalleImpuestosContainer.innerHTML = '';

        if (impuestosPorProveedor[cardId]) {
            impuestosPorProveedor[cardId].forEach(impuestoId => {
                const select = document.querySelector(`#${impuestoId} select`);

                if (select && select.selectedIndex > 0) {
                    const option = select.selectedOptions[0];
                    const tasa = parseFloat(option.dataset.tasa) || 0;
                    const esRetencion = JSON.parse(option.dataset.retencion);
                    const nombreImpuesto = option.textContent;

                    let montoImpuesto = subtotalProveedor * (tasa / 100);

                    if (esRetencion) {
                        montoImpuesto *= -1;
                    }

                    totalImpuestos += montoImpuesto;

                    const detalleHTML = `
                    <div class="ticket-row ticket-impuesto ${esRetencion ? 'retencion' : ''}">
                        <span class="ticket-label">${nombreImpuesto}:</span>
                        <span class="ticket-value">${montoImpuesto >= 0 ? '+' : ''} ${Currency.format(montoImpuesto)}</span>
                    </div>
                `;
                    detalleImpuestosContainer.insertAdjacentHTML('beforeend', detalleHTML);
                }
            });
        }

        const totalFinal = subtotalProveedor + totalImpuestos;
        document.getElementById(`total-${cardId}`).innerText = Currency.format(totalFinal);

        const proveedorId = document.getElementById(cardId).dataset.proveedorId;
        if (proveedoresActivos[proveedorId]) {
            proveedoresActivos[proveedorId].total = totalFinal;
        }

        calcularTotalGeneral();
    }

    let proveedorActualModal = null;

    function buscarProductoProveedor(cardId) {
        proveedorActualModal = cardId;
    }

    async function agregarFilaProveedor(cardId, datosProducto = null) {
        const tabla = document.querySelector(`#tabla-${cardId} tbody`);
        const fila = document.createElement("tr");
        const esVenta = document.getElementById("venta")?.checked === true;

        const c1 = datosProducto?.id || '';
        const c2 = datosProducto?.descripcion || '';
        const c11 = datosProducto?.udm || '';

        let html =
            `<td class="text-center"><input type="checkbox" class="seleccionar-fila"></td>` +
            `<td></td>` +
            `<td contenteditable="true" class="input-cantidad"></td>` +
            `<td contenteditable="true" class="input-codigo">${c1}</td>` +
            `<td contenteditable="true" class="input-descripcion">${c2}</td>` +
            `<td contenteditable="true" class="input-unidad">${c11}</td>` +
            `<td contenteditable="true" class="input-costo precio-unitario">$ 0.00</td>`;

        if (esVenta) {
            html += `<td contenteditable="true" class="input-venta precio-venta">$ 0.00</td>`;
        }

        html += `<td contenteditable="true" class="input-descuento descuento">${formatoPorcentaje(0)}</td>`;
        html += `<td class="subtotal-fila">${Currency.format(0)}</td>`;
        html += `<td class="total-fila">${Currency.format(0)}</td>`;

        fila.innerHTML = html;

        fila.querySelectorAll("td[contenteditable='true']").forEach(cell => {
            cell.addEventListener("input", () => calcularTotalProveedor(cardId));
            cell.addEventListener("blur", formatearCampoNumerico);
            cell.addEventListener("focusin", limpiarCampoNumerico);
        });

        tabla.appendChild(fila);
        recalcularNumeracion(cardId);
    }

    function eliminarFilasProveedor(cardId) {
        const tabla = document.querySelector(`#tabla-${cardId} tbody`);
        const checkboxes = tabla.querySelectorAll(".seleccionar-fila:checked");

        if (checkboxes.length === 0) {
            toastMixin.fire({
                icon: 'warning',
                title: 'No has seleccionado ninguna fila.'
            });
            return;
        }

        checkboxes.forEach(chk => {
            chk.closest("tr").remove();
        });

        recalcularNumeracion(cardId);
        calcularTotalProveedor(cardId);
    }

    function recalcularNumeracion(cardId) {
        const filas = document.querySelectorAll(`#tabla-${cardId} tbody tr`);
        filas.forEach((row, i) => {
            row.cells[1].innerText = i + 1;
        });
    }

    function formatearCampoNumerico(e) {
        if (!e.target.matches("td.precio-unitario, td.precio-venta, td.descuento")) return;

        const valor = limpiarNumero(e.target.innerText);
        e.target.innerText = e.target.matches("td.descuento")
            ? formatoPorcentaje(valor)
            : Currency.format(valor);
    }

    function limpiarCampoNumerico(e) {
        if (!e.target.matches("td.precio-unitario, td.precio-venta, td.descuento")) return;
        const valor = limpiarNumero(e.target.innerText);
        e.target.innerText = valor || '';
    }

    function calcularTotalGeneral() {
        totalGeneralCompra = 0;

        Object.values(proveedoresActivos).forEach(proveedor => {
            totalGeneralCompra += proveedor.total;
        });

        document.getElementById('total-general-display').innerText = Currency.format(totalGeneralCompra);
    }

    function limpiarProveedores() {
        const contenedorProveedores = document.getElementById('contenedor-proveedores');
        contenedorProveedores.innerHTML = '';
        proveedoresActivos = {};
        impuestosPorProveedor = {};
        contadorProveedores = 0;
        totalGeneralCompra = 0;
    }

    document.addEventListener('DOMContentLoaded', function () {
        const modal = document.getElementById('modalBuscarProducto');

        if (modal) {
            modal.addEventListener('hidden.bs.modal', function () {
                proveedorActualModal = null;
            });
        }
    });

    // Llamada desde el modal de búsqueda (_ModalBuscarProducto) al elegir un producto
    function agregarProductoDesdeModal(detalle) {
        const esCompraDirecta = document.getElementById('modoCompraDirecta')?.checked === true;

        if (esCompraDirecta && proveedorActualModal) {
            agregarFilaProveedor(proveedorActualModal, detalle);
            calcularTotalProveedor(proveedorActualModal);
        } else {
            agregarFila(detalle);
        }
    }

    function validarProveedorObligatorio() {
        if (esEmpresaAHN) {
            const esCompraDirecta = document.getElementById('modoCompraDirecta')?.checked === true;
            if (esCompraDirecta && Object.keys(proveedoresActivos).length === 0) {
                toastMixin.fire({
                    icon: 'error',
                    title: 'Debes agregar al menos un proveedor'
                });
                return false;
            }
        }
        return true;
    }
</script>
