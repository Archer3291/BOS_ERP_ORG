    /* ========================================
            NUEVOS ESTILOS PARA IMPUESTOS Y TICKET
            ======================================== */

    .lista-impuestos-scroll {
        max-height: 280px;
        overflow-y: auto;
        padding-right: 0.5rem;
    }

        .lista-impuestos-scroll::-webkit-scrollbar {
