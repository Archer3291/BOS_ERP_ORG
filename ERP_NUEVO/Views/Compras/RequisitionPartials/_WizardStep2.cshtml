        }

        .lista-impuestos-scroll::-webkit-scrollbar-thumb {
            background: var(--border-light);
            border-radius: 10px;
        }

            .lista-impuestos-scroll::-webkit-scrollbar-thumb:hover {
                background: var(--accent-blue);
            }

    .impuesto-item {
        background: var(--bg-light);
        border: 1.5px solid var(--border-light);
        border-radius: 8px;
        padding: 0.75rem;
