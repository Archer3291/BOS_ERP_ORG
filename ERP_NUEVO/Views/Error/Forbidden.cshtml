@model BOS_ERP.Models.ErrorViewModel
@{
    ViewBag.Title = "Acceso denegado";
    ViewData["PageTitle"] = "403 - Acceso denegado";
}
<style>
    .error-card {
        background-color: var(--bg-light);
        border-radius: 1rem;
        box-shadow: var(--shadow-lg);
        max-width: 520px;
        width: 100%;
    }

    .error-code {
        font-size: 6rem;
        font-weight: 800;
        color: var(--accent-blue);
        line-height: 1;
    }

    .error-text {
        color: var(--text-light);
        font-size: 1rem;
    }
</style>
<div class="container min-vh-100 d-flex align-items-center justify-content-center">
    <div class="text-center error-card p-5">
        <div class="error-code mb-3">403</div>

        <h1 class="mb-3">Acceso denegado</h1>

        <p class="error-text mb-4">
            No tienes permisos para acceder a este recurso.
            <br />
            Si crees que esto es un error, contacta al administrador.
        </p>

        <div class="d-flex justify-content-center gap-3">
            <a href="/" class="btn btn-primary">
                Volver al inicio
            </a>

            <button onclick="history.back()" class="btn btn-outline-secondary">
                Regresar
            </button>
        </div>
    </div>
</div>
