
@{
    ViewBag.Title = "ConsultaPolizasDiscrepancia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Consultar polizas con discrepancia";
}

<style>
</style>

<link href="~/content/TableBuilder.css" rel="stylesheet" />
<link href="~/content/compras-nacionales.css" rel="stylesheet" />
<link href="~/content/polizasDiscrepancia/style.css" rel="stylesheet" />

<div class="main-container">
    <!-- Filters -->
    <div class="filters-card">
        <div class="filters-title">
            <i class="fa fa-sliders"></i> Filtros de Búsqueda
        </div>
        <div class="row g-3">
            <div class="col-md-3">
                <label class="form-label">
                    <i class="far fa-calendar"></i>
                    Fecha Desde
                </label>
                <input type="date" id="fecha_inicio" class="form-control">
            </div>
            <div class="col-md-3">
                <label class="form-label">
                    <i class="far fa-calendar"></i>
                    Fecha Hasta
                </label>
                <input type="date" id="fecha_fin" class="form-control">
            </div>

            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-custom btn-primary-custom w-100" id="btnBuscar">
                    <i class="fa fa-search"></i> Buscar
                </button>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button class="btn btn-custom btn-outline-custom w-100" id="btnLimpiar">
                    <i class="fa fa-arrow-rotate-left"></i> Limpiar
                </button>
            </div>
        </div>
    </div>

    <!-- Table -->
    <div id="tablaPolizas"></div>
</div>

<!-- Modal de Consulta -->
<div class="modal fade" id="modalConsultaPoliza" tabindex="-1" aria-labelledby="modalConsultaPolizaLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header" style="background-color: var(--primary-blue); color: white;">
                <h5 class="modal-title" id="modalConsultaPolizaLabel">
                    <i class="fa fa-file-invoice"></i> Detalle de Póliza
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" style="background-color: var(--bg-gray);">

                <!-- Información General de la Póliza -->
                <div class="card mb-3" style="border-color: var(--border-light); background-color: var(--bg-light);">
                    <div class="card-header d-flex justify-content-between align-items-center" style="background-color: var(--light-blue); color: var(--text-dark);">
                        <strong><i class="fa fa-info-circle"></i> Información General de la poliza</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label text-muted small">UUID de la poliza:</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" id="polizaUuid" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                                    <button class="btn btn-outline-secondary" type="button" onclick="copiarTexto('polizaUuid')" title="Copiar UUID">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Folio de la referencia</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" id="polizaFolio" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                                    <button class="btn btn-outline-secondary" type="button" onclick="copiarTexto('polizaFolio')" title="Copiar Folio">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Folio de la discrepancia</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" id="polizaFolioDisc" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                                    <button class="btn btn-outline-secondary" type="button" onclick="copiarTexto('polizaFolioDisc')" title="Copiar Folio Discrepancia">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Tipo</label>
                                <div id="polizaTipo"></div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Estado</label>
                                <div id="polizaEstado"></div>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Fecha</label>
                                <input type="text" class="form-control form-control-sm" id="polizaFecha" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-3">
                                <label class="form-label text-muted small">Responsable</label>
                                <input type="text" class="form-control form-control-sm" id="polizaResponsable" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-12">
                                <label class="form-label text-muted small">Descripción</label>
                                <textarea class="form-control form-control-sm" id="polizaDescripcion" rows="2" readonly style="background-color: var(--disabled-color); color: var(--text-dark);"></textarea>
                            </div>
                            <div class="col-md-12">
                                <label class="form-label text-muted small">Acciones tomadas</label>
                                <textarea class="form-control form-control-sm" id="polizaAcciones" rows="2" readonly style="background-color: var(--disabled-color); color: var(--text-dark);"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalles de la Póliza -->
                <div class="card mb-3" style="border-color: var(--border-light); background-color: var(--bg-light);">
                    <div class="card-header" style="background-color: var(--light-blue); color: var(--text-dark);">
                        <strong><i class="fa fa-list"></i> Detalles Contables</strong>
                    </div>
                    <div class="card-body">
                        <div class="table-responsive">
                            <table class="table modern-table" style="color: var(--text-dark);">
                                <thead style="background-color: var(--very-light-blue);">
                                    <tr>
                                        <th>Código</th>
                                        <th>Proveedor</th>
                                        <th>Centro de Costos</th>
                                        <th class="text-end">Debe</th>
                                        <th class="text-end">Haber</th>
                                        <th>Descripción</th>
                                    </tr>
                                </thead>
                                <tbody id="detallesPolizaBody">
                                </tbody>
                                <tfoot style="background-color: var(--very-light-blue); font-weight: bold;">
                                    <tr>
                                        <td colspan="3" class="text-end">TOTALES:</td>
                                        <td class="text-end" id="totalDebe"></td>
                                        <td class="text-end" id="totalHaber"></td>
                                        <td></td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Referencia Original -->
                <div class="card mb-3" style="border-color: var(--border-light); background-color: var(--bg-light);">
                    <div class="card-header" style="background-color: var(--light-blue); color: var(--text-dark);">
                        <strong><i class="fa fa-file-alt"></i> Referencia Original</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Folio referencia</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" id="referenciaUuid" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                                    <button class="btn btn-outline-secondary" type="button" onclick="copiarTexto('referenciaUuid')" title="Copiar UUID">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Proveedor</label>
                                <input type="text" class="form-control form-control-sm" id="referenciaProveedor" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted small">Importe</label>
                                <input type="text" class="form-control form-control-sm text-end" id="referenciaImporte" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted small">Fecha</label>
                                <input type="text" class="form-control form-control-sm" id="referenciaFecha" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table modern-table" style="color: var(--text-dark);">
                                <thead style="background-color: var(--very-light-blue);">
                                    <tr>
                                        <th>Código Producto</th>
                                        <th>Descripción</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Precio</th>
                                        <th class="text-end">Descuento</th>
                                        <th>Unidad</th>
                                        <th class="text-end">Importe</th>
                                    </tr>
                                </thead>
                                <tbody id="partidasReferenciaBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Referencia Discrepancia -->
                <div class="card mb-3" style="border-color: var(--border-light); background-color: var(--bg-light);">
                    <div class="card-header" style="background-color: var(--warning-color); color: white;">
                        <strong><i class="fa fa-exclamation-triangle"></i> Referencia con Discrepancia</strong>
                    </div>
                    <div class="card-body">
                        <div class="row g-3 mb-3">
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Folio discrepancia</label>
                                <div class="input-group input-group-sm">
                                    <input type="text" class="form-control" id="referenciaDiscUuid" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                                    <button class="btn btn-outline-secondary" type="button" onclick="copiarTexto('referenciaDiscUuid')" title="Copiar UUID">
                                        <i class="fa fa-copy"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label text-muted small">Proveedor</label>
                                <input type="text" class="form-control form-control-sm" id="referenciaDiscProveedor" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted small">Importe</label>
                                <input type="text" class="form-control form-control-sm text-end" id="referenciaDiscImporte" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                            <div class="col-md-2">
                                <label class="form-label text-muted small">Fecha</label>
                                <input type="text" class="form-control form-control-sm" id="referenciaDiscFecha" readonly style="background-color: var(--disabled-color); color: var(--text-dark);">
                            </div>
                        </div>
                        <div class="table-responsive">
                            <table class="table modern-table" style="color: var(--text-dark);">
                                <thead style="background-color: var(--very-light-blue);">
                                    <tr>
                                        <th>Código Producto</th>
                                        <th>Descripción</th>
                                        <th class="text-center">Cantidad</th>
                                        <th class="text-end">Precio</th>
                                        <th class="text-end">Descuento</th>
                                        <th>Unidad</th>
                                        <th class="text-end">Importe</th>
                                        <th class="text-center">Estado</th>
                                    </tr>
                                </thead>
                                <tbody id="partidasDiscrepanciaBody">
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

                <!-- Archivos Adjuntos -->
                <div class="card mb-3" style="border-color: var(--border-light); background-color: var(--bg-light);">
                    <div class="card-header" style="background-color: var(--light-blue); color: var(--text-dark);">
                        <strong><i class="fa fa-paperclip"></i> Archivos Adjuntos</strong>
                    </div>
                    <div class="card-body">
                        <div id="archivosContainer" class="list-group">
                        </div>
                    </div>
                </div>

            </div>
            <div class="modal-footer" style="background-color: var(--bg-light);">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fa fa-times"></i> Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

<script src="~/Scripts/TableBuilder.js"></script>
<script>
    // Función para copiar texto al portapapeles
    function copiarTexto(inputId) {
        const input = document.getElementById(inputId);
        input.select();
        document.execCommand('copy');

        // Feedback visual
        const button = event.target.closest('button');
        const icon = button.querySelector('i');
        icon.classList.remove('fa-copy');
        icon.classList.add('fa-check');
        button.classList.add('btn-success');
        button.classList.remove('btn-outline-secondary');

        setTimeout(() => {
            icon.classList.remove('fa-check');
            icon.classList.add('fa-copy');
            button.classList.remove('btn-success');
            button.classList.add('btn-outline-secondary');
        }, 1500);
    }

    // Función para formatear fecha
    function formatearFecha(fecha) {
        if (!fecha) return '';
        const match = fecha.match(/\d+/);
        if (match) {
            const date = new Date(parseInt(match[0]));
            return date.toLocaleDateString('es-MX');
        }
        return '';
    }

    // Función para cargar datos en el modal
    function cargarDatosModal(data) {
        console.log(data)
        // Información General
        document.getElementById('polizaUuid').value = data.poliza.uuid || '';
        document.getElementById('polizaFolio').value = data.poliza.folio || '';
        document.getElementById('polizaFolioDisc').value = data.poliza.folio_disc || '';
        document.getElementById('polizaFecha').value = formatearFecha(data.poliza.fecha);
        document.getElementById('polizaResponsable').value = data.poliza.nombre || '';
        document.getElementById('polizaDescripcion').value = data.poliza.descripcion || '';
        document.getElementById('polizaAcciones').value = data.poliza.comentario_discrepancia || '';

        // Tipo y Estado con badges
        const tipoCapitalized = data.poliza.tipo.charAt(0).toUpperCase() + data.poliza.tipo.slice(1);
        document.getElementById('polizaTipo').innerHTML = `<span class="badge badge-${data.poliza.tipo}">${tipoCapitalized}</span>`;

        const estadoCapitalized = data.poliza.estado.charAt(0).toUpperCase() + data.poliza.estado.slice(1);
        document.getElementById('polizaEstado').innerHTML = `<span class="badge badge-${data.poliza.estado}">${estadoCapitalized}</span>`;

        // Detalles de la Póliza
        const detallesBody = document.getElementById('detallesPolizaBody');
        detallesBody.innerHTML = '';
        let totalDebe = 0;
        let totalHaber = 0;

        data.detallesPoliza.forEach(detalle => {
            totalDebe += detalle.debe;
            totalHaber += detalle.haber;

            const row = `
            <tr>
                <td>${detalle.codigo}</td>
                <td>${detalle.n_prov}</td>
                <td>${detalle.centro_costos}</td>
                <td class="text-end">${detalle.debe === 0 ? '' : Currency.format(detalle.debe)}</td>
                <td class="text-end">${detalle.haber === 0 ? '' : Currency.format(detalle.haber)}</td>
                <td>${detalle.descripcion}</td>
            </tr>
        `;
            detallesBody.innerHTML += row;
        });

        document.getElementById('totalDebe').textContent = Currency.format(totalDebe);
        document.getElementById('totalHaber').textContent = Currency.format(totalHaber);

        // Referencia Original
        if (data.referencia) {
            document.getElementById('referenciaUuid').value = data.referencia.folio || '';
            document.getElementById('referenciaProveedor').value = data.referencia.cli_prov || '';
            document.getElementById('referenciaImporte').value = Currency.format(data.referencia.imp || 0);
            document.getElementById('referenciaFecha').value = formatearFecha(data.referencia.fch);

            const partidasBody = document.getElementById('partidasReferenciaBody');
            partidasBody.innerHTML = '';

            data.partidasReferencia.forEach(partida => {
                const row = `
                <tr>
                    <td>${partida.codigo_producto || ''}</td>
                    <td>${partida.descripcion || ''}</td>
                    <td class="text-center">${partida.cantidad}</td>
                    <td class="text-end">${Currency.format(partida.precio)}</td>
                    <td class="text-end">${Currency.format(partida.descuento)}</td>
                    <td>${partida.unidad}</td>
                    <td class="text-end">${Currency.format(partida.importe)}</td>
                </tr>
            `;
                partidasBody.innerHTML += row;
            });
        }

        // Referencia Discrepancia
        if (data.referenciaDiscrepancia) {
            document.getElementById('referenciaDiscUuid').value = data.referenciaDiscrepancia.folio || '';
            document.getElementById('referenciaDiscProveedor').value = data.referenciaDiscrepancia.cli_prov || '';
            document.getElementById('referenciaDiscImporte').value = Currency.format(data.referenciaDiscrepancia.imp || 0);
            document.getElementById('referenciaDiscFecha').value = formatearFecha(data.referenciaDiscrepancia.fch);

            const partidasDiscBody = document.getElementById('partidasDiscrepanciaBody');
            partidasDiscBody.innerHTML = '';

            data.partidasReferenciaDiscrepancia.forEach(partida => {
                const estadoBadge = partida.estado ? `<span class="badge badge-${partida.estado === 'daño' ? 'dano' : partida.estado}">${partida.estado}</span>` : '';
                const row = `
                <tr>
                    <td>${partida.codigo_producto || ''}</td>
                    <td>${partida.descripcion || ''}</td>
                    <td class="text-center">${partida.cantidad}</td>
                    <td class="text-end">${Currency.format(partida.precio)}</td>
                    <td class="text-end">${Currency.format(partida.descuento)}</td>
                    <td>${partida.unidad}</td>
                    <td class="text-end">${Currency.format(partida.importe)}</td>
                    <td class="text-center">${estadoBadge}</td>
                </tr>
            `;
                partidasDiscBody.innerHTML += row;
            });
        }

        // Archivos
        const archivosContainer = document.getElementById('archivosContainer');
        archivosContainer.innerHTML = '';

        if (data.archivos && data.archivos.length > 0) {
            data.archivos.forEach(archivo => {
                const iconClass = archivo.extencion === '.pdf' ? 'fa-file-pdf text-danger' :
                    archivo.extencion === '.xlsx' ? 'fa-file-excel text-success' :
                        'fa-file';

                const item = `
                <a href="/${archivo.path}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" download="${archivo.nombre_original}">
                    <span>
                        <i class="fa ${iconClass} me-2"></i>
                        ${archivo.nombre_original}
                    </span>
                    <span>
                        <i class="fa fa-download"></i>
                    </span>
                </a>
            `;
                archivosContainer.innerHTML += item;
            });
        } else {
            archivosContainer.innerHTML = '<p class="text-muted small mb-0" style="color: var(--text-light);">No hay archivos adjuntos</p>';
        }

        // Mostrar el modal
        const modal = new bootstrap.Modal(document.getElementById('modalConsultaPoliza'));
        modal.show();
    }

    // Modificar la función verDetalle original
    function verDetalle(row) {
        GetData({
            path: '/PolizasDiscrepancia/GetDetallesPolizaDiscrepanciaConsulta',
            data: {
                id_poliza: row.id_poliza,
                referencia: row.referencia,
                referencia_discrepancia: row.id_documento_disc
            }
        }).then((data) => {
            cargarDatosModal(data);
        }).catch(error => {
            console.error('Error al cargar los datos:', error);
            alert('Error al cargar los detalles de la póliza');
        });
    }

    document.addEventListener('DOMContentLoaded', () => {
        const tablaPolizas = createTable({
            selector: '#tablaPolizas',
            path: '/PolizasDiscrepancia/GetPolizasDiscrepanciaConsulta',
            searchPlaceholder: 'Buscar poliza...',
            columns: [
                {
                    title: 'Tipo',
                    data: 'tipo',
                    formatter: (v) => {
                        if (!v) return '';
                        const capitalized = v.charAt(0).toUpperCase() + v.slice(1).toLowerCase();
                        return `<span class="badge badge-${v.toLowerCase()}">${capitalized}</span>`;
                    }
                },
                { title: 'Fecha', data: 'fecha', formatter: (v) => dateFormatter(v) },
                { title: 'Usuario', data: 'usuario' },
                {
                    title: 'Estado',
                    data: null,
                    formatter: (row) => {
                        if (!row) return '';
                        const capitalized = row.estado.charAt(0).toUpperCase() + row.estado.slice(1).toLowerCase();
                        const htmlContent = `` +
                            `<span class="badge badge-${row.estado.toLowerCase()}">${capitalized}</span>` +
                            `<span class="desc-tooltip">${row.coment1}</span>`;
                        return htmlContent;
                    }
                },
            ],
            actions: [
                { icon: 'fa-circle-info', color: 'cyan-500', title: 'Ver Detalle', onClick: row => verDetalle(row) },
                { icon: 'fa-file-pdf', color: 'red-500', title: 'Generar pdf', onClick: row => generarPDFPoliza(row.uuid) }
            ],
            RowsEvents: {
                onRowDblClick: row => verDetalle(row),
                onKeyPress: (event, row) => {
                    if (event.key === 'F4') verDetalle(row);
                }
            },
            data: () => ({
                fechaInicio: document.getElementById('fecha_inicio').value,
                fechaFin: document.getElementById('fecha_fin').value
            }),
        });

        window.tablaPolizas = tablaPolizas;

        document.getElementById('btnBuscar').addEventListener('click', () => {
            tablaPolizas.reload();
        });

        document.getElementById('btnLimpiar').addEventListener('click', () => {
            document.getElementById('fecha_inicio').value = '';
            document.getElementById('fecha_fin').value = '';
            tablaPolizas.reload();
        });
    })
</script>