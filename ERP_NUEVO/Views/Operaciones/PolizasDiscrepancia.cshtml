                            <td class="text-end"><strong>${Currency.format(totalRecibido)}</strong></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </tbody>
                </table>
            </div>`;

    @{
        if(Utilities.DoesUserHasRole(User.Identity.Name, "Contador")) {
        <text>
        html += `<div class="section-title">
                <i class="fas fa-calculator"></i>
                Movimientos Contables de la Póliza
            </div>
            <a class="btn green-500 mb-3" target="_blank" href="/Contabilidad/ConsultarPolizas?q=${data.detallesPoliza[0].poliza_uuid}">
                <i class="fa-solid fa-pen-to-square"></i>
                Editar poliza
            </a>
            <div class="table-responsive">
                <table class="table modern-table">
                    <thead>
                        <tr>
                            <th>Código de Cuenta</th>
                            <th>Descripción</th>
                            <th class="text-end">Debe</th>
                            <th class="text-end">Haber</th>
                        </tr>
                    </thead>
                    <tbody>
            `;

        let totalDebe = 0;
        let totalHaber = 0;

        data.detallesPoliza.forEach(detalle => {
            totalDebe += detalle.debe;
            totalHaber += detalle.haber;

            html += `
                    <tr>
                        <td><strong>${detalle.codigo}</strong></td>
                        <td>${detalle.descripcion}</td>
                        <td class="text-end">${detalle.debe > 0 ? Currency.format(detalle.debe) : '-'}</td>
                        <td class="text-end">${detalle.haber > 0 ? Currency.format(detalle.haber) : '-'}</td>
                    </tr>
                `;
        });

        html += `
                        <tr class="total-row">
                            <td colspan="2" class="text-end"><strong>TOTALES:</strong></td>
                            <td class="text-end"><strong>${Currency.format(totalDebe)}</strong></td>
                            <td class="text-end"><strong>${Currency.format(totalHaber)}</strong></td>
                        </tr>
                    </tbody>
                </table>
            </div>
            `;
            </text>
    }
    }

        return html;
    }

    async function verDetalle(poliza) {
        // Limpiar campos al abrir modal
        document.getElementById('descripcionDiscrepancia').value = '';
        document.getElementById('archivoSoporte').value = '';
        document.getElementById('accionDiscrepancia').value = '';
        document.getElementById('filesList').innerHTML = `
            <div class="files-list" id="filesList">
                <div class="empty-state" id="emptyState">
                    <i class="fas fa-inbox"></i>
                    <p>No hay archivos seleccionados</p>
                </div>
            </div>`;

        GetData({
            path: '/PolizasDiscrepancia/GetDetallesPolizaDiscrepancia',
            data: {
                id_poliza: poliza.id_poliza,
                referencia: poliza.referencia,
                referencia_discrepancia: poliza.id_documento_disc
            }
        }).then((_res) => {
            const contenido = generarContenidoModal(_res);
            document.getElementById('contenidoModal').innerHTML = contenido;
            const modal = new bootstrap.Modal(document.getElementById('modalDiscrepancia'));
            modal.show();
            document.getElementById('btnGuardarDiscrepancia').setAttribute('data-id', poliza.id_poliza)
        })
    }

    document.addEventListener('DOMContentLoaded', () => {
        const tablaPolizas = createTable({
            selector: '#tablaPolizas',
            path: '/PolizasDiscrepancia/GetPolziasDiscrepancia',
            searchPlaceholder: 'Buscar poliza...',
            columns: [
                {
                    title: 'Tipo',
                    data: 'tipo',
                    formatter: (v) => {
                        if (!v) return '';
                        const capitalized = v.charAt(0).toUpperCase() + v.slice(1).toLowerCase();
                        return `<span class="badge badge-${v.toLowerCase()}">${capitalized}</span>`;
                    }
                },
                { title: 'Fecha', data: 'fecha', formatter: (v) => dateFormatter(v) },
                { title: 'Usuario', data: 'usuario' },
                {
                    title: 'Estado',
                    data: null,
                    formatter: (row) => {
                        if (!row) return '';
                        const capitalized = row.estado.charAt(0).toUpperCase() + row.estado.slice(1).toLowerCase();
                        const htmlContent = `` +
                            `<span class="badge badge-${row.estado.toLowerCase()}">${capitalized}</span>` +
                            `<span class="desc-tooltip">${row.coment1}</span>`;
                        return htmlContent;
                    }
                },
            ],
            actions: [
                { icon: 'fa-circle-info', color: 'cyan-500', title: 'Ver Detalle', onClick: row => verDetalle(row) },
                { icon: 'fa-file-pdf', color: 'red-500', title: 'Generar pdf', onClick: row => generarPDFPoliza(row.uuid) }
            ],
            RowsEvents: {
                onRowDblClick: row => verDetalle(row),
                onKeyPress: (event, row) => {
                    if (event.key === 'F4') verDetalle(row);
                }
            },
            data: () => ({
                fechaInicio: document.getElementById('fecha_inicio').value,
                fechaFin: document.getElementById('fecha_fin').value
            }),
        });

        window.tablaPolizas = tablaPolizas;

        document.getElementById('btnBuscar').addEventListener('click', () => {
            tablaPolizas.reload();
        });

        document.getElementById('btnLimpiar').addEventListener('click', () => {
            document.getElementById('fecha_inicio').value = '';
            document.getElementById('fecha_fin').value = '';
            tablaPolizas.reload();
        });
    })
</script>