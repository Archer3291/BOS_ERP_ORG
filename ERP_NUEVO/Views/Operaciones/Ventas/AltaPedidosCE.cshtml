                                    </div>
                                    <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="total-descuento" value="0.00" readonly placeholder="Descuento" />
                                        <label for="total-descuento"><i class="fas fa-percent fa-lg"></i> Descuento</label>
                                    </div>
