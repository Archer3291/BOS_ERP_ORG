@model BOS_ERP.Models.LoginViewModel
@{
    ViewBag.Title = "Pedidos ";

}
@section styles {
    <style>
        #loader-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0,0,0,0.6); /* Fondo semitransparente oscuro */
            z-index: 1050; /* Por encima de todo */
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .loader-content {
            text-align: center;
        }

        .section-title {
            font-weight: bold;
            background-color: #003366;
            color: white;
            padding: 0.5rem;
            border-radius: 0.25rem;
            margin-bottom: 1rem;
        }

        .form-label {
            font-weight: 500;
        }

        .table input {
            min-width: 80px;
        }

        .form-floating {
            position: relative;
        }

        .input-group {
            height: 100%; /* Asegura que el contenedor ocupe toda la altura del div */
        }

        .custom-input, .custom-btn {
            height: 100%; /* Hace que el input y el botón llenen completamente el contenedor */
        }

        .custom-btn {
            padding: 0 15px; /* Asegura que el padding no afecte la altura */
            display: flex;
            align-items: center; /* Centra el texto del botón verticalmente */
        }

        .input-group > .form-control {
            height: auto;
        }

        .ticket-style {
            border-radius: 12px;
            box-shadow: 0 6px 15px rgba(0, 0, 0, 0.15);
            font-family: 'Courier New', Courier, monospace;
            border: 2px solid #dcdcdc;
            padding: 20px;
        }

        .no-border {
            border: none;
            /*background: #f9f9f9;*/
            box-shadow: none;
            transition: background 0.3s ease, border 0.3s ease;
        }

            .no-border:hover {
                /*background: #e9e9e9;*/
            }

        .ticket-style .form-floating input {
            font-size: 1rem;
            padding-left: 2.5rem; /* Space for the icon */
        }

        .ticket-style label {
            color: #333;
            font-weight: bold;
            font-size: 0.9rem;
        }

        .ticket-style input[type="number"] {
            font-weight: bold;
            text-align: right;
            font-size: 1.2rem;
            color: #444;
        }

            .ticket-style input[type="number"]:read-only {
                color: #777;
            }

        .ticket-style .form-floating {
            margin-bottom: 1rem;
            padding: 1.2rem;
            border-radius: 8px;
        }

        .ticket-style .fw-bold {
            color: #e74c3c;
            font-size: 1.3rem;
        }

        .ticket-style .form-floating textarea {
            background: #f9f9f9;
            height: auto;
            min-height: 100px;
        }

        .form-floating label i {
            position: absolute;
            left: 25px;
            top: 50%;
            transform: translateY(-50%);
            color: #777;
            font-size: 1rem;
        }
    </style>
}
<form asp-action="" method="post">
    @Html.AntiForgeryToken()
</form>
<div class="container my-4">
    <!-- Encabezado fijo con botones -->
    <div class="container-fluid border-bottom py-2 shadow-sm" style="position: sticky; top: 60px; z-index: 1020; background-color: var(--bs-body-bg);">
        <div class="d-flex justify-content-between align-items-center px-3">
            <!-- Ícono y título -->
            <div class="d-flex align-items-center">
                <i class="fas fa-file-invoice-dollar me-2 text-primary" style="font-size: 26px;"></i>
                <h2 class="mb-0">Pedido</h2>
            </div>

            <!-- Botones de acción -->
            <div>
                <button class="btn btn-outline-secondary me-2">
                    <i class="fas fa-times me-1"></i> Cancelar
                </button>
                <button class="btn btn-success" id="guardar-btn">
