        function actualizarTotal() {
            let subtotal = 0;
            let totalIva = 0;
            let subtable1 = 0;

            const monedaSeleccionada = document.querySelector('#moneda').value;
            let tasaCambio = 1;

            let paridad = parseFloat(document.querySelector('#paridad').value) || 1;
            //|| monedaSeleccionada === 'EUR')
            if (monedaSeleccionada === 'USD' || monedaSeleccionada === 'EUR')  {
                tasaCambio = 1 / paridad;
            }

            const rows = table.rows().nodes().toArray();

            rows.forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad')?.value || 0);
                const descuento = parseFloat(tr.querySelector('.descuento')?.value || 0);
                const precioInput = tr.querySelector('.precio');
                const iva = parseFloat(tr.dataset.iva || 0);

                // Obtener el precio original desde el atributo, o establecerlo la primera vez
                if (!precioInput.dataset.original) {
                    precioInput.dataset.original = precioInput.value;
                }

                const precioOriginal = parseFloat(precioInput.dataset.original || 0);
                const precioAjustado = precioOriginal * tasaCambio;

                precioInput.value = precioAjustado.toFixed(4);

                const importe = cantidad * precioAjustado * (1 - descuento / 100);
                const ivaImporte = importe * (iva / 100);

                subtotal += importe;
                totalIva += ivaImporte;
                subtable1 += cantidad * precioAjustado;

                const spanImporte = tr.querySelector('.importe');
                if (spanImporte) {
                    spanImporte.textContent = importe.toFixed(2);
                }
            });

            const totalConIva = subtotal + totalIva;

            document.getElementById('total-subtotal2').value = subtotal.toFixed(2);
            document.getElementById('iva').value = totalIva.toFixed(2);
            document.getElementById('importe').value = totalConIva.toFixed(2);
            document.getElementById('total-subtotal1').value = subtable1.toFixed(2);
        }



        fetch('/Operaciones/DatosSelect')
            .then(response => response.json())
            .then(data => {
                llenarSelect('moneda', data.monedas, 'c3', 'c2');
                llenarSelect('vendedor', data.vendedores, 'c2', 'c3');
                llenarSelect('forma-pago', data.formaspago, 'c1', 'c2');
                llenarSelect('metodo-pago', data.metodopago, 'c1', 'c2');
                llenarSelect('uso-cfdi', data.usocfdi, 'c1', 'c2');

            })
            .catch(error => {
                console.error('Error al obtener los datos:', error);
            });

        function llenarSelect(selectId, datos, valueKey, textKey) {
            const select = document.getElementById(selectId);
            select.innerHTML = '<option value="">Selecciona una opcion</option>'; // limpia y agrega opción inicial

            datos.forEach(item => {
                const option = document.createElement('option');
                option.value = item[valueKey];
                option.textContent = item[textKey];
                select.appendChild(option);
            });
        }

document.getElementById("guardar-btn").addEventListener("click", async function () {
    const guardarBtn = document.getElementById("guardar-btn");
    const loaderOverlay = document.getElementById("loader-overlay");
    loaderOverlay.style.display = "flex";
    guardarBtn.disabled = true;

    try {
        const formData = new FormData();

        // Agregar datos del formulario principal
        formData.append("cliente", document.getElementById("cliente").value);
        formData.append("rfc", document.getElementById("rfc").value);
        formData.append("doctoPrevio", document.getElementById("docto-previo").value);
        formData.append("partidasPrevias", document.getElementById("partidas-previas").value);
        formData.append("direccion", document.getElementById("direccion").value);
        formData.append("descuento1", document.getElementById("descuento1").value);
        formData.append("descuento2", document.getElementById("descuento2").value);
        formData.append("descuento3", document.getElementById("descuento3").value);
        formData.append("vendedor", document.getElementById("vendedor").value);
        formData.append("moneda", document.getElementById("moneda").value);
        formData.append("paridad", document.getElementById("paridad").value);
        formData.append("factura", document.getElementById("factura").value);
        formData.append("contacto", document.getElementById("contacto").value);
        formData.append("formatoIngles", document.getElementById("formato-ingles").checked);
        formData.append("concepto", document.getElementById("concepto").value);
        formData.append("incoterm", document.getElementById("incoterm").value);
        formData.append("formapago", document.getElementById("forma-pago").value);
        formData.append("metodopago", document.getElementById("metodo-pago").value);
        formData.append("usocfdi", document.getElementById("uso-cfdi").value);

        // Token CSRF desde input oculto generado por @Html.AntiForgeryToken()
        const csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
        formData.append("__RequestVerificationToken", csrfToken);

        // Procesar artículos
        const rows = document.querySelectorAll("#clientesTable tbody tr");
        rows.forEach((row, i) => {
            formData.append(`articulos[${i}].articulo`, row.dataset.clavesat || "");
            formData.append(`articulos[${i}].cantidad`, row.cells[1].querySelector('input')?.value || 0);
            formData.append(`articulos[${i}].ClaveUnidad`, row.dataset.udmsat || "");
            formData.append(`articulos[${i}].Unidad`, row.cells[4].innerText || 0);
            formData.append(`articulos[${i}].precio`, row.cells[5].querySelector('input')?.value || 0);
            formData.append(`articulos[${i}].descuento`, row.cells[6].querySelector('input')?.value || 0);
            formData.append(`articulos[${i}].importe`, row.cells[7].innerText || 0);
            formData.append(`articulos[${i}].descripcion`, row.cells[8].innerText || "");
            formData.append(`articulos[${i}].iva`, row.dataset.iva || "");
            formData.append(`articulos[${i}].preciouni`, row.dataset.preciouni || "");
            formData.append(`articulos[${i}].objeto`, row.dataset.objeto || "");
            formData.append(`articulos[${i}].claveprod`, row.cells[0].innerText || "");
        });

        // Realizar la solicitud
        const response = await fetch('/PedidoCe/GuardarFacturaCE', {
            method: 'POST',
            body: formData // No necesitas headers, FormData los gestiona automáticamente
        });

        const data = await response.json();

        if (data.resultado) {
            toastr.success("Factura guardada correctamente", "Éxito");
        } else {
            toastr.error("Hubo un error al guardar la factura: " + data.mensaje, "Error");
        }
    } catch (error) {
        console.error("Error al guardar la factura:", error);
        toastr.error("Ocurrió un error inesperado al procesar la factura", "Error");
    } finally {
        loaderOverlay.style.display = "none";
        guardarBtn.disabled = false;
    }
});





        $(document).ready(function () {
            // Obtener las tasas desde el servidor
            $.get("/Sistemas/Paridad/ObtenerTasasJson", function (response) {
                if (response.data) {
                    // Guardar las tasas de cambio (deberías tenerlas disponibles en JavaScript)
                    const tasas = response.data;

                    // Establecer la paridad inicial (en este caso, peso)
                    $('#paridad').val(tasas[0].Peso.toFixed(4));

                    // Cambiar la paridad cuando el usuario cambia la moneda seleccionada
                    $('#moneda').on('change', function () {
                        const selectedMoneda = $(this).val();
                        let paridad = 1;

                        switch (selectedMoneda) {
                            case 'USD':
                                paridad = tasas[0].Dolar;
                                break;
                            case 'EUR':
                                paridad = tasas[0].Euro;
                                break;
                            case 'MXN':
                            default:
                                paridad = tasas[0].Peso;
                                break;
                        }

                        $('#paridad').val(paridad.toFixed(4));
                        actualizarTotal();
                    });
                }
            });
        });


