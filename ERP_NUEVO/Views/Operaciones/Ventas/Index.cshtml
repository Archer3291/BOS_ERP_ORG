        </li>
        <li class="nav-item">
            <button class="nav-link" id="condiciones-tab" data-bs-toggle="tab" data-bs-target="#condiciones" type="button" role="tab" aria-controls="condiciones" aria-selected="false" style="font-size: 1.1rem;">
                <i class="fas fa-file-invoice-dollar me-2" style="font-size: 1.1rem;"></i> Condiciones de Pago
