                                <option value="agente_2">Agente 2</option>
                                <option value="agente_3">Agente 3</option>
                                <!-- Agrega más agentes si lo deseas -->
                            </select>
                            <label for="agente">
                                Agente
                            </label>
                        </div>

                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <select class="form-select" id="moneda" required>
                                <option selected>PESOS</option>
                            </select>
