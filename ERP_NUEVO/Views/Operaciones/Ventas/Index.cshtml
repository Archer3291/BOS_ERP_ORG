        function actualizarTotal() {
            let subtotal = 0;
            let totalIva = 0;
            let subtable1 = 0;

            const rows = table.rows().nodes().toArray(); // Obtener todas las filas como array normal

            rows.forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad')?.value || 0);
                const descuento = parseFloat(tr.querySelector('.descuento')?.value || 0);
                const precio = parseFloat(tr.querySelector('.precio')?.value || 0);
                const iva = parseFloat(tr.dataset.iva || 0);

                const importe = cantidad * precio * (1 - descuento / 100);
                const ivaImporte = importe * (iva / 100);

                subtotal += importe;
                totalIva += ivaImporte;
                subtable1 += cantidad * precio;

                const spanImporte = tr.querySelector('.importe');
                if (spanImporte) {
                    spanImporte.textContent = importe.toFixed(2);
                }
            });

            const totalConIva = subtotal + totalIva;

            document.getElementById('total-subtotal2').value = subtotal.toFixed(2);
            document.getElementById('iva').value = totalIva.toFixed(2);
            document.getElementById('importe').value = totalConIva.toFixed(2);
            document.getElementById('total-subtotal1').value = subtable1.toFixed(2);
        }



        document.addEventListener('DOMContentLoaded', function () {
            fetch('/Operaciones/DatosSelect')
                .then(res => res.json())
                .then(data => {
                    const select = document.getElementById('moneda');
                    select.innerHTML = '';

                    const monedas = data.monedas;

                    monedas.forEach(item => {
                        const option = document.createElement('option');
                        option.value = item.c1;
                        option.textContent = item.c2;
                        select.appendChild(option);
                    });
                })
                .catch(err => {
                    console.error('Error al cargar monedas:', err);
                });
        });
