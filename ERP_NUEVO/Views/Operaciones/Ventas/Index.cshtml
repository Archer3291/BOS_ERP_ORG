                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="decimales" id="decimales4" />
                                <label class="form-check-label" for="decimales4">4</label>
                            </div>
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="radio" name="decimales" id="decimales6" />
                                <label class="form-check-label" for="decimales6">6</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Tabla de artículos -->
        <div class="tab-pane fade" id="articulos" role="tabpanel" aria-labelledby="detalle-tab">
