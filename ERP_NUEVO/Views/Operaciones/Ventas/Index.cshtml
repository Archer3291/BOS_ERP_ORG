                                    <input type="number" class="form-control" id="descuento2" placeholder="Descuento 2" required />
                                    <label for="descuento2">Descuento 2</label>
                                </div>
                                <div class="col-md-6 form-floating shadow-sm rounded">
                                    <input type="number" class="form-control" id="descuento3" placeholder="Descuento 3" required />
                                    <label for="descuento3">Descuento 3</label>
                                </div>
                            </div>
                        </div>

                        <!-- Otros campos (sin cambios) -->
