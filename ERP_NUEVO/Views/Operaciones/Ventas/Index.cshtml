                            <select class="form-select" id="departamento">
                                <option selected>Selecciona Departamento</option>
                                <option value="1">Departamento 1</option>
                                <option value="2">Departamento 2</option>
                                <option value="3">Departamento 3</option>
                            </select>
                            <label for="departamento">Departamento</label>
                        </div>

                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <select class="form-select" id="concepto">
                                <option selected>Selecciona Concepto</option>
                                <option value="1">Concepto 1</option>
                                <option value="2">Concepto 2</option>
                                <option value="3">Concepto 3</option>
                            </select>
                            <label for="concepto">Concepto</label>
                        </div>

                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <select class="form-select" id="agente" required aria-label="Agente">
                                <option selected disabled>Selecciona un agente</option>
