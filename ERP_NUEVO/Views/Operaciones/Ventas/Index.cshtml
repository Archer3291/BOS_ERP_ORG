        <div class="tab-pane fade" id="condiciones" role="tabpanel" aria-labelledby="detalle-tab">
            <div class="container p-4 rounded-4 shadow-lg">
                <div class="container my-4 p-4 rounded-4 shadow-sm" style="border-left: 5px solid #0d6efd;">
                    <h5 class="fw-bold text-primary mb-3">Condiciones de Pago y Crédito</h5>
                    <div class="row g-3 mb-4">
                        <!-- Columna combinada: Crédito + Condiciones de pago -->
                        <div class="col-md-6">
                            <div class="row">
                                <!-- Crédito -->
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="number" class="form-control no-border" id="limite-credito" value="0.00" readonly placeholder="Límite de crédito" />
                                    <label for="limite-credito"><i class="fas fa-credit-card fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Límite de crédito</label>
                                </div>
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="number" class="form-control no-border" id="saldo-proveedor" value="0.00" readonly placeholder="Saldo del proveedor" />
                                    <label for="saldo-proveedor"><i class="fas fa-wallet fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Saldo del proveedor</label>
                                </div>
                                <div class="form-floating mb-3 shadow-sm rounded">
                                    <input type="number" class="form-control no-border" id="credito-disponible" value="0.00" readonly placeholder="Crédito disponible" />
                                    <label for="credito-disponible"><i class="fas fa-credit-card fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Crédito disponible</label>
                                </div>

                                <!-- Condiciones de pago -->
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="number" class="form-control" id="plazo" placeholder="Plazo" />
                                    <label for="plazo"><i class="fas fa-calendar-day fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Plazo</label>
                                </div>
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="date" class="form-control" id="fecha-pago" value="2025-04-21" placeholder="Fecha de Pago" />
                                    <label for="fecha-pago"><i class="fas fa-calendar-alt fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Fecha de Pago</label>
                                </div>
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="time" class="form-control" id="hora-entrega" value="12:00" placeholder="Hora de Entrega" />
                                    <label for="hora-entrega"><i class="fas fa-clock fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Hora de Entrega</label>
                                </div>
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <input type="text" class="form-control" id="condiciones" value="Pago de contado" placeholder="Condiciones" />
                                    <label for="condiciones"><i class="fas fa-cogs fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Condiciones</label>
                                </div>
                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <select class="form-select" id="forma-pago" aria-label="Forma de Pago">
                                        <option selected>Efectivo</option>
                                        <option value="01">01 - Efectivo</option>
                                        <option value="02">02 - Cheque nominativo</option>
                                        <option value="03">03 - Transferencia electrónica</option>
                                        <option value="04">04 - Tarjeta de crédito</option>
                                        <option value="28">28 - Tarjeta de débito</option>
                                    </select>
                                    <label for="forma-pago">
                                        <i class="fas fa-money-bill-wave fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Forma de Pago
                                    </label>
                                </div>

                                <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                    <select class="form-select" id="metodo-pago" aria-label="Método de Pago">
                                        <option selected>Pago en parcialidades o diferido</option>
                                        <option value="PUE">PUE - Pago en una sola exhibición</option>
                                        <option value="PPD">PPD - Pago en parcialidades o diferido</option>
                                    </select>
                                    <label for="metodo-pago">
                                        <i class="fas fa-credit-card fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Método de Pago
                                    </label>
                                </div>

                                <div class="col-md-12 form-floating mb-3 shadow-sm rounded">
                                    <select class="form-select" id="uso-cfdi" aria-label="Uso CFDI">
                                        <option selected>G03 - Gastos en general</option>
                                        <option value="D01">D01 - Honorarios médicos</option>
                                        <option value="D02">D02 - Gastos médicos por incapacidad</option>
                                        <option value="P01">P01 - Por definir</option>
                                        <option value="NOMINA">Nómina</option>
                                    </select>
                                    <label for="uso-cfdi">
                                        <i class="fas fa-file-invoice fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Uso CFDI
                                    </label>
                                </div>

