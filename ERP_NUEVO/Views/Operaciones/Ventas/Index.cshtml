        </li>
        <li class="nav-item">
            <button class="nav-link" id="articulos-tab" data-bs-toggle="tab" data-bs-target="#articulos" type="button" role="tab" aria-controls="articulos" aria-selected="false" style="font-size: 1.1rem;">
                <i class="fas fa-box-open me-2" style="font-size: 1.1rem;"></i> Artículos
