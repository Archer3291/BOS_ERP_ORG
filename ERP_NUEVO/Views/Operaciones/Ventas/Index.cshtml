                            <label for="paridad">Paridad</label>
                        </div>
                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <input type="text" class="form-control" id="factura" required placeholder="Factura" />
                            <label for="factura">Factura</label>
                        </div>
                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <select class="form-select" id="contacto" required aria-label="Contacto">
                                <option selected disabled>Selecciona un contacto</option>
                                <option value="juan_perez">Juan Pérez</option>
                                <option value="ana_garcia">Ana García</option>
                                <option value="luis_fernandez">Luis Fernández</option>
                                <!-- Agrega más contactos aquí si lo deseas -->
                            </select>
                            <label for="contacto">Contacto</label>
                        </div>


                        <!-- Formato en inglés -->
                        <div class="col-md-2 d-flex align-items-center">
                            <input class="form-check-input me-2" type="checkbox" id="formato-ingles" />
                            <label class="form-check-label" for="formato-ingles">Formato en Inglés</label>
                        </div>

                        <!-- Concepto e Incoterm -->
                        <div class="col-md-3 form-floating shadow-sm rounded">
                            <input type="text" class="form-control" id="concepto" required placeholder="Concepto" />
                            <label for="concepto">Concepto</label>
                        </div>
                        <div class="col-md-3 form-floating shadow-sm rounded">
