        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
        <p class="mt-3 text-white">Procesando factura, por favor espere...</p>
    </div>
</div>


@section Scripts {
    @*<script src="https://cdnjs.cloudflare.com/ajax/libs/mdb-ui-kit/7.0.0/mdb.min.js"></script>

        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>*@
    <script src="~/Scripts/formularios.js"></script>
    <script src="~/Scripts/Operaciones/Pedido/buscadores.js"></script>
    <script>
        function limpiarModal() {
            document.body.classList.remove('modal-open');
            document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            document.body.style.overflow = 'auto';
            setTimeout(() => {
                document.querySelectorAll('.modal-backdrop').forEach(el => el.remove());
            }, 300);
        }

        let table;           // Instancia global de DataTable
        const pageSize = 50; // Tamaño de página para la búsqueda

        $(document).ready(function () {
            // 1) Inicializa DataTable y guárdala en la variable
            const currentTheme = localStorage.getItem('theme') || 'light';
            table = $('#clientesTable').DataTable({
                responsive: true,
                select: true,
                layout: {
                    topStart: {
                        buttons: [
                            {
                                extend: 'copyHtml5',
                                text: '<i class="fa-solid fa-copy"></i>',
                                titleAttr: 'Copiar'
                            },
                            {
                                extend: 'excelHtml5',
                                text: '<i class="fa-solid fa-file-excel"></i>',
                                titleAttr: 'Exportar a Excel'
                            },
                            //{
                            //    extend: 'csvHtml5',
                            //    text: '<i class="fa-solid fa-file-csv"></i>',
                            //    titleAttr: 'Exportar a CSV'
                            //},
                            {
                                extend: 'pdfHtml5',
                                text: '<i class="fa-solid fa-file-pdf"></i>',
                                titleAttr: 'Exportar a PDF'
                            },
                            'colvis',
                            {
                                text: '<i class="fa fa-trash"></i>',
                                titleAttr: 'Eliminar fila(s) seleccionada(s)',
                                className: 'btn btn-outline-danger',
                                action: function (e, dt, node, config) {
                                    var filas = dt.rows({ selected: true });
                                    if (!filas.count()) {
                                        toastr.warning('Selecciona al menos una fila para eliminar.');
                                        return;
                                    }

                                    Swal.fire({
                                        title: `¿Eliminar ${filas.count()} fila(s)?`,
                                        icon: 'warning',
                                        showCancelButton: true,
                                        confirmButtonText: 'Sí, eliminar',
                                        cancelButtonText: 'Cancelar',
                                        theme: currentTheme
                                    }).then((result) => {
                                        if (result.isConfirmed) {
                                            filas.remove().draw(false);
                                            toastr.success(`${filas.count()} fila(s) eliminada(s).`);
                                            actualizarTotal();
                                        }
                                    });
                                }

                            }
                        ],
                        pageLength: {
                            menu: [5, 10, 25, 50]
                        }
                    }
                },
                lengthMenu: [[5, 10, 25, 50], [5, 10, 25, 50]],
                pageLength: 10,
                language: {
                    select: { rows: '%d fila(s) seleccionada(s)' },
                    buttons: {
                        copyTitle: 'Copiado al portapapeles',
                        copySuccess: { _: '%d filas copiadas', 1: '1 fila copiada' }
                    }
                },
                columnDefs: [{ className: 'dt-center', targets: '_all' },
                { responsivePriority: 1, targets: 7 }
                ]
            });

        });

        function actualizarTotal() {
            let subtotal = 0;
            let totalIva = 0;
            let subtable1 = 0;

            const rows = table.rows().nodes().toArray(); // Obtener todas las filas como array normal

            rows.forEach(tr => {
                const cantidad = parseFloat(tr.querySelector('.cantidad')?.value || 0);
                const descuento = parseFloat(tr.querySelector('.descuento')?.value || 0);
                const precio = parseFloat(tr.querySelector('.precio')?.value || 0);
                const iva = parseFloat(tr.dataset.iva || 0);

                const importe = cantidad * precio * (1 - descuento / 100);
                const ivaImporte = importe * (iva / 100);

                subtotal += importe;
                totalIva += ivaImporte;
                subtable1 += cantidad * precio;

                const spanImporte = tr.querySelector('.importe');
                if (spanImporte) {
                    spanImporte.textContent = importe.toFixed(2);
                }
            });

            const totalConIva = subtotal + totalIva;

            document.getElementById('total-subtotal2').value = subtotal.toFixed(2);
            document.getElementById('iva').value = totalIva.toFixed(2);
            document.getElementById('importe').value = totalConIva.toFixed(2);
            document.getElementById('total-subtotal1').value = subtable1.toFixed(2);
        }

        fetch('/Operaciones/DatosSelect')
            .then(response => response.json())
            .then(data => {
                llenarSelect('moneda', data.monedas, 'c3', 'c2');
                llenarSelect('vendedor', data.vendedores, 'c2', 'c3');
                llenarSelect('forma-pago', data.formaspago, 'c1', 'c2');
                llenarSelect('metodo-pago', data.metodopago, 'c1', 'c2');
                llenarSelect('uso-cfdi', data.usocfdi, 'c1', 'c2');

            })
            .catch(error => {
                console.error('Error al obtener los datos:', error);
            });

        function llenarSelect(selectId, datos, valueKey, textKey) {
            const select = document.getElementById(selectId);
            select.innerHTML = '<option value="">Selecciona una opcion</option>'; // limpia y agrega opción inicial

            datos.forEach(item => {
                const option = document.createElement('option');
                option.value = item[valueKey];
                option.textContent = item[textKey];
                select.appendChild(option);
            });
        }

        document.getElementById("guardar-btn").addEventListener("click", async function () {
            const guardarBtn = document.getElementById("guardar-btn");
            const loaderOverlay = document.getElementById("loader-overlay");
            loaderOverlay.style.display = "flex"; // Mostrar loader
            guardarBtn.disabled = true; // Deshabilitar botón

            try {
                const cliente = document.getElementById("cliente").value;
                const rfc = document.getElementById("rfc").value;
                const doctoPrevio = document.getElementById("docto-previo").value;
                const partidasPrevias = document.getElementById("partidas-previas").value;
                const direccion = document.getElementById("direccion").value;
                const descuento1 = document.getElementById("descuento1").value;
                const descuento2 = document.getElementById("descuento2").value;
                const descuento3 = document.getElementById("descuento3").value;
                const vendedor = document.getElementById("vendedor").value;
                const moneda = document.getElementById("moneda").value;
                const paridad = document.getElementById("paridad").value;
                const factura = document.getElementById("factura").value;
                const contacto = document.getElementById("contacto").value;
                const formatoIngles = document.getElementById("formato-ingles").checked;
                const concepto = document.getElementById("concepto").value;
                const incoterm = document.getElementById("incoterm").value;
                const formapago = document.getElementById("forma-pago").value;
                const metodopago = document.getElementById("metodo-pago").value;
                const selectFormaPago = document.getElementById("forma-pago");
                const selectMetodoPago = document.getElementById("metodo-pago");
                const formaPagoTexto = selectFormaPago.options[selectFormaPago.selectedIndex].text;
                const metodoPagoTexto = selectMetodoPago.options[selectMetodoPago.selectedIndex].text;
                const usocfdi = document.getElementById("uso-cfdi").value;

                const articulos = [];
                const rows = document.querySelectorAll("#clientesTable tbody tr");
                rows.forEach((row) => {
                    const articulo = row.dataset.clavesat;
                    const cantidad = row.cells[1].querySelector('input')?.value || 0;
                    const ClaveUnidad = row.dataset.udmsat;
                    const Unidad = row.cells[4].innerText || 0;
                    const precio = row.cells[5].querySelector('input')?.value || 0;
                    const descuento = row.cells[6].querySelector('input')?.value || 0;
                    const importe = row.cells[7].innerText;
                    const descripcion = row.cells[8].innerText;
                    const iva = row.dataset.iva;
                    const objeto = row.dataset.objeto;
                    const claveprod = row.cells[0].innerText;

                    articulos.push({
                        articulo,
                        cantidad,
                        ClaveUnidad,
                        Unidad,
                        precio,
                        descuento,
                        importe,
                        descripcion,
                        iva,
                        objeto,
                        claveprod
                    });
                });

                const formData = {
                    cliente,
                    rfc,
                    doctoPrevio,
                    partidasPrevias,
                    direccion,
                    descuento1,
                    descuento2,
                    descuento3,
                    vendedor,
                    moneda,
                    paridad,
                    factura,
                    contacto,
                    formatoIngles,
                    concepto,
                    incoterm,
                    formapago,
                    metodopago,
                    formaPagoTexto,
                    metodoPagoTexto,
                    usocfdi,
                    articulos
                };

                const response = await fetch('/Cotizacion/GuardarFactura', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(formData)
                });

                if (!response.ok) {
                    throw new Error(`Error del servidor: ${response.status}`);
                }

                const data = await response.json();

                if (data.resultado) {
                    toastr.success("Factura guardada correctamente", "Éxito");
                } else {
                    toastr.error("Hubo un error al guardar la factura: " + data.mensaje, "Error");
                }

            } catch (error) {
                console.error("Error al guardar la factura:", error);
                toastr.error("Ocurrió un error inesperado al procesar la factura", "Error");
            } finally {
                loaderOverlay.style.display = "none"; // Siempre ocultar loader
                guardarBtn.disabled = false; // Rehabilitar botón
            }
        });



    </script>
}
