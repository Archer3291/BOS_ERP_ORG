                                    </select>
                                    <label for="uso-cfdi">
                                        <i class="fas fa-file-invoice fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Uso CFDI
                                    </label>
                                </div>

                                <div class="form-floating mb-3 shadow-sm rounded">
                                    <textarea class="form-control" id="direccion-entrega" rows="2" placeholder="Dirección de entrega"></textarea>
                                    <label for="direccion-entrega"><i class="fas fa-map-marker-alt fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Dirección de entrega</label>
                                </div>
                                <div class="form-floating mb-3 shadow-sm rounded">
                                    <textarea class="form-control" id="comentarios" rows="4" placeholder="Comentarios"></textarea>
                                    <label for="comentarios"><i class="fas fa-file-alt fa-lg"></i>&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; Comentarios</label>
                                </div>
                            </div>
                        </div>

                        <!-- Columna derecha: Totales -->
                        <div class="col-md-6">
                            <div class="ticket-style p-4 rounded">
                                <div class="row">
