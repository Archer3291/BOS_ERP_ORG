                                        <input type="number" class="form-control no-border" id="total-subtotal1" value="0.00" readonly placeholder="Subtotal" />
                                        <label for="total-subtotal1"><i class="fas fa-money-bill-wave fa-lg"></i> Subtotal</label>
                                    </div>
                                    <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="total-descuento" value="0.00" readonly placeholder="Descuento" />
                                        <label for="total-descuento"><i class="fas fa-percent fa-lg"></i> Descuento</label>
                                    </div>
                                    <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="total-flete" value="0.00" placeholder="Flete" />
                                        <label for="total-flete"><i class="fas fa-truck fa-lg"></i> Flete</label>
                                    </div>
                                    <div class="col-md-12 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="total-subtotal2" value="0.00" readonly placeholder="Subtotal" />
                                        <label for="total-subtotal2"><i class="fas fa-money-bill-wave fa-lg"></i> Subtotal</label>
                                    </div>
                                    <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="ret-isr" value="0.00" readonly placeholder="Ret ISR" />
                                        <label for="ret-isr"><i class="fas fa-file-invoice-dollar fa-lg"></i> Ret ISR</label>
                                    </div>
                                    <div class="col-md-6 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control no-border" id="iva" value="0.00" readonly placeholder="IVA" />
                                        <label for="iva"><i class="fas fa-percentage fa-lg"></i> IVA</label>
                                    </div>
                                    <div class="col-md-12 form-floating mb-3 shadow-sm rounded">
                                        <input type="number" class="form-control fw-bold text-danger no-border" id="importe" value="0.00" readonly placeholder="IMPORTE" />
                                        <label for="importe"><i class="fas fa-credit-card fa-lg"></i> <strong>IMPORTE</strong></label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal: Buscar Cliente -->
