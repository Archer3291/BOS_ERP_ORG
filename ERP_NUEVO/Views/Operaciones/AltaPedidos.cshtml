            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <input type="text" id="inputBuscarNombreCliente" class="form-control" placeholder="Escribe el nombre o clave">
                </div>
                <div id="listaResultadosCliente" style="max-height:400px; overflow:auto;"></div>
