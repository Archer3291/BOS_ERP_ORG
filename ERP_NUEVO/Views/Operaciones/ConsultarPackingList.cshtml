        // 5. Funciones para imprimir desde el modal
        function imprimirEtiquetaBultoModal(indexTarima, indexBulto) {
            if (!currentPackingListData) {
                alert('⚠️ No hay datos cargados');
                return;
            }

            const tarimas = currentPackingListData.tarimas || [];
            const tarima = tarimas[indexTarima];

            if (!tarima) {
                alert('⚠️ Tarima no encontrada');
                return;
            }

            const bulto = tarima.bultos[indexBulto];

            if (!bulto) {
                alert('⚠️ Bulto no encontrado');
                return;
            }

            const zpl = generarEtiquetaBultoDesdeModal(bulto, tarima, currentPackingListData);
            imprimirZebra(zpl);
        }

        function imprimirEtiquetaTarimaModal(indexTarima) {
            if (!currentPackingListData) {
                alert('⚠️ No hay datos cargados');
                return;
            }

            const tarimas = currentPackingListData.tarimas || [];
            const tarima = tarimas[indexTarima];

            if (!tarima) {
                alert('⚠️ Tarima no encontrada');
                return;
            }

            const zpl = generarEtiquetaTarimaDesdeModal(tarima, currentPackingListData);
            imprimirZebra(zpl);
        }


        function imprimirTodasEtiquetasTarimaModal(indexTarima) {
            if (!currentPackingListData) {
                alert('⚠️ No hay datos cargados');
                return;
            }

            const tarimas = currentPackingListData.tarimas || [];
            const tarima = tarimas[indexTarima];

            if (!tarima) {
                alert('⚠️ Tarima no encontrada');
                return;
            }

            const bultos = tarima.bultos || [];
            const totalEtiquetas = bultos.length + 1;

            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    icon: 'question',
                    title: '¿Imprimir todas las etiquetas?',
                    html: `
                <p>Se imprimirán <strong>${totalEtiquetas}</strong> etiquetas:</p>
                <ul style="text-align: left; margin: 10px auto; max-width: 300px;">
                    <li>1 etiqueta de tarima</li>
                    <li>${bultos.length} etiqueta${bultos.length !== 1 ? 's' : ''} de bultos</li>
                </ul>
            `,
                    showCancelButton: true,
                    confirmButtonText: '🖨️ Imprimir',
                    confirmButtonColor: '#059669',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // Imprimir etiqueta de tarima
                        imprimirEtiquetaTarimaModal(indexTarima);
                        // Imprimir etiquetas de bultos con delay
                        let delay = 2000;
                        bultos.forEach((bulto, indexBulto) => {
                            setTimeout(() => {
                                imprimirEtiquetaBultoModal(indexTarima, indexBulto);
                            }, delay + (indexBulto * 2000));
                        });

                        Swal.fire({
                            icon: 'info',
                            title: 'Imprimiendo...',
                            text: `Enviando ${totalEtiquetas} etiquetas a la impresora`,
                            timer: 3000,
                            showConfirmButton: false
                        });
                    }
                });
            } else {
                const confirmar = confirm(`¿Imprimir ${totalEtiquetas} etiquetas?\n\n1 de tarima + ${bultos.length} de bultos`);
                if (confirmar) {
                    imprimirEtiquetaTarimaModal(indexTarima);
                    let delay = 2000;
                    bultos.forEach((bulto, indexBulto) => {
                        setTimeout(() => {
                            imprimirEtiquetaBultoModal(indexTarima, indexBulto);
                        }, delay + (indexBulto * 2000));
                    });
                }
            }
        }


    </script>
