
@{
    ViewBag.Title = "PolizasDiscrepancia";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.PageTitle = "Consultar Packing List";
}
@section styles {
    <head>
        <link href="~/content/compras-nacionales.css" rel="stylesheet" />
        <style>
            .btn-add {
                background: var(--primary-blue);
                color: white;
                padding: 12px 28px;
                border: none;
                border-radius: 8px;
                font-size: 0.95em;
                font-weight: 600;
                cursor: pointer;
                transition: all 0.3s ease;
                box-shadow: var(--shadow);
                display: inline-flex;
                align-items: center;
                gap: 8px;
            }

                .btn-add:hover {
                    background: var(--primary-blue-dark);
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-lg);
                }

            .stats-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
                gap: 20px;
                margin-bottom: 24px;
            }

            .stat-card {
                background: var(--bg-light);
                padding: 24px;
                border-radius: 12px;
                box-shadow: var(--shadow);
                transition: all 0.3s ease;
                border-left: 4px solid var(--primary-blue);
                position: relative;
                overflow: hidden;
            }

                .stat-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    right: 0;
                    width: 100px;
                    height: 100px;
                    background: var(--light-blue);
                    border-radius: 50%;
                    transform: translate(40%, -40%);
                    opacity: 0.3;
                }

                .stat-card:hover {
                    transform: translateY(-4px);
                    box-shadow: var(--shadow-lg);
                }

                .stat-card:nth-child(2) {
                    border-left-color: var(--accent-blue);
                }

                .stat-card:nth-child(3) {
                    border-left-color: var(--success-color);
                }

                .stat-card:nth-child(4) {
                    border-left-color: var(--warning-color);
                }

            .stat-label {
                font-size: 0.9em;
                color: var(--text-light);
                margin-bottom: 12px;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .stat-value {
                font-size: 2.5em;
                font-weight: 700;
                color: var(--primary-blue-dark);
                position: relative;
            }

            .table-wrapper {
                background: var(--bg-light);
                border-radius: 12px;
                padding: 24px;
                box-shadow: var(--shadow);
            }

            .status-badge {
                padding: 6px 16px;
                border-radius: 6px;
                font-size: 0.85em;
                font-weight: 600;
                display: inline-block;
            }

            .status-pending {
                background: #fef3c7;
                color: var(--warning-color);
            }

            .status-transit {
                background: #dbeafe;
                color: var(--accent-blue);
            }

            .status-delivered {
                background: #d1fae5;
                color: var(--success-color);
            }

            .btn-view {
                background: var(--primary-blue);
                color: white;
                padding: 8px 20px;
                border: none;
                border-radius: 6px;
                cursor: pointer;
                transition: all 0.3s ease;
                font-size: 0.9em;
                font-weight: 600;
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

                .btn-view:hover {
                    background: var(--primary-blue-dark);
                    transform: translateY(-2px);
                    box-shadow: var(--shadow);
                }

            .detail-modal {
                display: none;
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(15, 23, 41, 0.7);
                backdrop-filter: blur(4px);
                z-index: 1000;
                padding: 20px;
                overflow-y: auto;
            }

                .detail-modal.active {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

            .detail-content {
                background: var(--bg-light);
                border-radius: 16px;
                max-width: 1200px;
                width: 100%;
                max-height: 90vh;
                overflow-y: auto;
                box-shadow: var(--shadow-lg);
                animation: slideUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            }

            @@keyframes slideUp {
                from {
                    transform: translateY(50px) scale(0.95);
                    opacity: 0;
                }

                to {
                    transform: translateY(0) scale(1);
                    opacity: 1;
                }
            }

            .detail-header {
                background: var(--primary-blue);
                color: white;
                padding: 32px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-radius: 16px 16px 0 0;
            }

                .detail-header h2 {
                    font-size: 1.8em;
                    font-weight: 700;
                    margin-bottom: 4px;
                }

                .detail-header p {
                    opacity: 0.9;
                    font-size: 0.95em;
                }

            .close-btn {
                background: rgba(255, 255, 255, 0.15);
                border: 2px solid rgba(255, 255, 255, 0.3);
                color: white;
                width: 44px;
                height: 44px;
                border-radius: 50%;
                font-size: 1.4em;
                cursor: pointer;
                transition: all 0.3s ease;
                display: flex;
                align-items: center;
                justify-content: center;
            }

                .close-btn:hover {
                    background: white;
                    color: var(--primary-blue);
                    transform: rotate(90deg);
                }

            .detail-body {
                padding: 32px;
            }

            .info-section {
                background: var(--very-light-blue);
                padding: 24px;
                border-radius: 12px;
                margin-bottom: 28px;
                border-left: 4px solid var(--primary-blue);
            }

                .info-section h3 {
                    color: var(--primary-blue-dark);
                    margin-bottom: 20px;
                    font-size: 1.2em;
                    font-weight: 600;
                }

            .info-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 16px;
            }

            .info-item {
                background: var(--bg-light);
                padding: 16px;
                border-radius: 8px;
                box-shadow: var(--shadow);
                transition: all 0.3s ease;
            }

                .info-item:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-lg);
                }

            .info-label {
                font-weight: 600;
                color: var(--text-light);
                font-size: 0.85em;
                text-transform: uppercase;
                margin-bottom: 6px;
                letter-spacing: 0.5px;
            }

            .info-value {
                color: var(--text-dark);
                font-size: 1.1em;
                font-weight: 500;
            }

            .table-container {
                overflow-x: auto;
                margin-top: 20px;
                border-radius: 12px;
                box-shadow: var(--shadow);
            }

            .detail-table {
                width: 100%;
                border-collapse: collapse;
                background: var(--bg-light);
            }

                .detail-table thead {
                    background: var(--primary-blue);
                    color: white;
                }

                .detail-table th {
                    padding: 16px;
                    text-align: left;
                    font-weight: 600;
                    text-transform: uppercase;
                    font-size: 0.85em;
                    letter-spacing: 0.5px;
                }

                .detail-table td {
                    padding: 16px;
                    border-bottom: 1px solid var(--border-light);
                    color: var(--text-dark);
                }

                .detail-table tbody tr {
                    transition: all 0.2s ease;
                }

                    .detail-table tbody tr:hover {
                        background: var(--very-light-blue);
                    }

            .totals {
                background: var(--very-light-blue);
                padding: 24px;
                border-radius: 12px;
                margin-top: 28px;
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 16px;
            }

            .total-item {
                background: var(--bg-light);
                padding: 20px;
                border-radius: 8px;
                border-left: 4px solid var(--primary-blue);
                box-shadow: var(--shadow);
                transition: all 0.3s ease;
            }

                .total-item:hover {
                    transform: translateY(-2px);
                    box-shadow: var(--shadow-lg);
                }

                .total-item:nth-child(2) {
                    border-left-color: var(--accent-blue);
                }

                .total-item:nth-child(3) {
                    border-left-color: var(--success-color);
                }

            .total-label {
                font-size: 0.9em;
                color: var(--text-light);
                margin-bottom: 8px;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

            .total-value {
                font-size: 1.8em;
                font-weight: 700;
                color: var(--primary-blue-dark);
            }

            .actions {
                margin-top: 32px;
                display: flex;
                gap: 12px;
                justify-content: center;
                flex-wrap: wrap;
            }



            .btn:hover {
                background: var(--primary-blue-dark);
                transform: translateY(-2px);
                box-shadow: var(--shadow-lg);
            }

            .btn-secondary {
                background: var(--secondary-blue);
            }

                .btn-secondary:hover {
                    background: var(--text-light);
                }

            .dt-buttons {
                margin-bottom: 16px;
            }

                .dt-buttons button {
                    background: var(--light-blue) !important;
                    color: var(--primary-blue-dark) !important;
                    border: 1px solid var(--border-light) !important;
                    border-radius: 6px !important;
                    padding: 8px 16px !important;
                    margin-right: 8px !important;
                    font-weight: 600 !important;
                    transition: all 0.3s ease !important;
                }

                    .dt-buttons button:hover {
                        background: var(--primary-blue) !important;
                        color: white !important;
                        transform: translateY(-2px);
                        box-shadow: var(--shadow) !important;
                    }

            @@media (max-width: 768px) {
                .header {
                    padding: 20px;
                }

                .header-left h1 {
                    font-size: 1.5em;
                }

                .stats-grid {
                    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
                }

                .stat-value {
                    font-size: 2em;
                }

                .detail-body {
                    padding: 20px;
                }
            }

            @@media print {
                body {
                    background: white;
                    padding: 0;
                }

                .container {
                    box-shadow: none;
                }

                .detail-modal {
                    position: static;
                    background: white;
                    padding: 0;
                }

                .detail-content {
                    box-shadow: none;
                    max-height: none;
                }

                .actions, .close-btn, .btn-add {
                    display: none !important;
                }
            }

            @@keyframes slideInRight {
                from {
                    transform: translateX(400px);
                    opacity: 0;
                }

                to {
                    transform: translateX(0);
                    opacity: 1;
                }
            }

            @@keyframes slideOutRight {
                from {
                    transform: translateX(0);
                    opacity: 1;
                }

                to {
                    transform: translateX(400px);
                    opacity: 0;
                }
            }
        </style>
    </head>
}

<div class="d-none">
    <button class="btn-add" onclick="addNewList()">
        <span>➕</span>
        <span>Nuevo Packing List</span>
    </button>


    <div class="stats-grid">
        <div class="stat-card">
            <div class="stat-label">Total de Listas</div>
            <div class="stat-value" id="totalLists">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">En Tránsito</div>
            <div class="stat-value" id="transitLists">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Entregadas</div>
            <div class="stat-value" id="deliveredLists">0</div>
        </div>
        <div class="stat-card">
            <div class="stat-label">Pendientes</div>
            <div class="stat-value" id="pendingLists">0</div>
        </div>
    </div>
</div>
<div class="table-wrapper">
    <div class="table-responsive">
        <div id="packingListsTable">

        </div>
    </div>
</div>


<div class="detail-modal" id="detailModal">
    <div class="detail-content">
        <div class="detail-header">
            <div>
                <h2 id="modalTitle">Packing List</h2>
                <p id="modalSubtitle"></p>
            </div>
            <button class="close-btn" onclick="closeDetail()">✕</button>
        </div>
        <div class="detail-body">
            <div class="info-section">
                <h3>📋 Información General</h3>
                <div class="info-grid" id="modalInfoGrid"></div>
            </div>

            <h3 style="margin-bottom: 15px; color: var(--primary-blue-dark); font-weight: 600;">📊 Detalle de Items</h3>
            <div class="table-container">
                <table class="detail-table">
                    <tbody id="modalTableBody"></tbody>
                </table>
            </div>

            <div class="totals" id="modalTotals"></div>

            <div class="actions">
                @*<button class="btn" onclick="printDetail()">
                        <span>🖨️</span>
                        <span>Imprimir</span>
                    </button>*@
                <button class="btn" onclick="generarPDFDesdeModal()">
                    <span>📥</span>
                    <span>Descargar PDF</span>
                </button>
                <button class="btn btn-secondary" onclick="closeDetail()">Cerrar</button>
            </div>
        </div>
    </div>
</div>
@section scripts {
    <script src="~/content/BrowserPrint.js-3.1.250/BrowserPrint-3.1.250.min.js"></script>
    <script src="~/Scripts/TableBuilder.js"></script>
    <script>
        let currentPackingListData = null;
        function getStatusBadge(status) {
            const statusTexts = {
                'pending': 'Pendiente',
                'transit': 'En Tránsito',
                'delivered': 'Entregada'
            };
            return `<span class="status-badge status-${status}">${statusTexts[status]}</span>`;
        }

        async function showDetail(id) {
            try {
                // Consultar el detalle al servidor
                const response = await fetch(`/PackingList/DocumentoDetailPacking?id=${id}`);
                if (!response.ok) throw new Error(`Error al obtener detalle: ${response.statusText}`);

                const data = await response.json();
                console.log("📦 Respuesta del servidor:", data);

                // Normalizar respuesta: puede ser array o objeto directo
                const row = Array.isArray(data) ? data[0] : data;

                // El servidor puede devolver packinglist_json como string o como objeto ya parseado
                let list = row?.packinglist_json ?? row;

                // Si viene como string JSON, parsearlo
                if (typeof list === 'string') {
                    try {
                        list = JSON.parse(list);
                    } catch (e) {
                        console.error('Error al parsear JSON:', e);
                        throw new Error('El servidor devolvió JSON inválido en packinglist_json.');
                    }
                }

                if (!list) throw new Error("No se encontró el detalle del Packing List.");

                // Guardar en variable global para el PDF
                currentPackingListData = list;
                console.log("📦 Detalle del Packing List (normalizado):", list);

                // Rellenar encabezado del modal
                document.getElementById('modalTitle').textContent = list.facturaReferenciaTexto || list.facturaReferencia || `PackingList #${id}`;

                // Formatear fecha
                const fechaDoc = list.fechaEmbarque ? new Date(list.fechaEmbarque).toLocaleDateString('es-MX') : '';
                document.getElementById('modalSubtitle').textContent = `${list.consignatario?.nombre || ''} - ${fechaDoc}`;

                // Info general con datos del consignatario
                const consig = list.consignatario || {};
                const infoGrid = document.getElementById('modalInfoGrid');
                infoGrid.innerHTML = `
                <div class="info-item">
                    <div class="info-label">Factura Ref.</div>
                    <div class="info-value">${list.facturaReferenciaTexto || list.facturaReferencia || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Fecha Embarque</div>
                    <div class="info-value">${list.fechaEmbarque || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Medio Transporte</div>
                    <div class="info-value">${list.medioTransporte || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Puerto Salida</div>
                    <div class="info-value">${list.puertoSalida || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Puerto Destino</div>
                    <div class="info-value">${list.puertoDestino || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Incoterm</div>
                    <div class="info-value">${list.incoterm || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Número de Contenedor</div>
                    <div class="info-value">${list.numeroContenedor || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Orden de Compra</div>
                    <div class="info-value">${list.ODCComprador || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Consignatario</div>
                    <div class="info-value">${consig.nombre || 'N/A'}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Destino</div>
                    <div class="info-value">${consig.estado || 'N/A'}, ${consig.pais || ''}</div>
                </div>
            `;

                // ============================================
                // RENDERIZAR TARIMAS → BULTOS → ITEMS
                // ============================================
                const tbody = document.getElementById('modalTableBody');
                tbody.innerHTML = '';

                const tarimas = Array.isArray(list.tarimas) ? list.tarimas : [];

                let totalBultosGeneral = 0;
                let totalItemsGeneral = 0;
                let totalPesoNetoGeneral = 0;
                let totalPesoBrutoGeneral = 0;
                let totalVolumenGeneral = 0;

                // Iterar sobre cada TARIMA
                tarimas.forEach((tarima, tarimaIndex) => {
                    const bultos = Array.isArray(tarima.bultos) ? tarima.bultos : [];

                    // Calcular totales de la tarima
                    let totalBultosTarima = bultos.length;
                    let totalItemsTarima = 0;
                    let totalPesoNetoTarima = 0;
                    let totalPesoBrutoTarima = 0;
                    let totalVolumenTarima = 0;

                    bultos.forEach(bulto => {
                        const items = Array.isArray(bulto.items) ? bulto.items : [];
                        totalItemsTarima += items.reduce((sum, item) => sum + (Number(item.cantidad) || 0), 0);
                        totalPesoNetoTarima += Number(bulto.peso_neto) || 0;
                        totalPesoBrutoTarima += Number(bulto.pesoBruto) || 0;

                        const volumen = (bulto.dimensiones?.volumen) ||
                            ((bulto.dimensiones?.largo || 0) * (bulto.dimensiones?.ancho || 0) * (bulto.dimensiones?.alto || 0));
                        totalVolumenTarima += volumen;
                    });

                    // Sumar a totales generales
                    totalBultosGeneral += totalBultosTarima;
                    totalItemsGeneral += totalItemsTarima;
                    totalPesoNetoGeneral += totalPesoNetoTarima;
                    totalPesoBrutoGeneral += totalPesoBrutoTarima;
                    totalVolumenGeneral += totalVolumenTarima;

                    // TARJETA DE TARIMA
                    const tarimaCard = `
                    <tr>
                        <td colspan="5" style="padding: 0; border: none;">
                            <div style="
                                background: linear-gradient(135deg, var(--accent-blue) 0%, var(--primary-blue) 100%);
                                border-radius: 12px;
                                padding: 20px;
                                margin: 20px 0;
                                box-shadow: var(--shadow-lg);
                                position: relative;
                                overflow: hidden;
                            ">
                                <!-- Decoración de fondo -->
                                <div style="
                                    position: absolute;
                                    top: -60px;
                                    right: -60px;
                                    width: 180px;
                                    height: 180px;
                                    background: rgba(255,255,255,0.1);
                                    border-radius: 50%;
                                "></div>

                                <!-- Header de la tarima -->
                                <div style="
                                    display: flex;
                                    align-items: center;
                                    justify-content: space-between;
                                    margin-bottom: 15px;
                                    position: relative;
                                    z-index: 1;
                                ">
                                    <div style="display: flex; align-items: center; gap: 15px;">
                                        <div style="
                                            background: rgba(255,255,255,0.25);
                                            backdrop-filter: blur(10px);
                                            border-radius: 15px;
                                            width: 60px;
                                            height: 60px;
                                            display: flex;
                                            align-items: center;
                                            justify-content: center;
                                            font-size: 32px;
                                            border: 2px solid rgba(255,255,255,0.3);
                                        ">🎯</div>
                                        <div>
                                            <div style="
                                                color: white;
                                                font-size: 24px;
                                                font-weight: 700;
                                                margin-bottom: 4px;
                                            ">${`EMPAQUE #${tarima.numero}`}</div>
                                            <div style="
                                                color: rgba(255,255,255,0.9);
                                                font-size: 14px;
                                                display: flex;
                                                align-items: center;
                                                gap: 10px;
                                            ">
                                                <span style="
                                                    background: rgba(255,255,255,0.2);
                                                    padding: 3px 12px;
                                                    border-radius: 12px;
                                                    font-weight: 600;
                                                ">${totalBultosTarima} bultos</span>
                                                <span>•</span>
                                                <span>${totalItemsTarima} items</span>
                                            </div>
                                        </div>
                                    </div>
                                                        <!-- BOTONES DE IMPRESIÓN -->
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <button onclick="imprimirEtiquetaTarimaModal(${tarimaIndex})" 
                                style="background: #0891b2; color: white; border: none; padding: 8px 16px; 
                                       border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600;
                                       transition: all 0.3s; display: flex; align-items: center; gap: 6px;"
                                onmouseover="this.style.background='#0e7490'"
                                onmouseout="this.style.background='#0891b2'"
                                title="Imprimir etiqueta de tarima">
                            🖨️ Tarima
                        </button>
                        <button onclick="imprimirTodasEtiquetasTarimaModal(${tarimaIndex})" 
                                style="background: #8b5cf6; color: white; border: none; padding: 8px 16px; 
                                       border-radius: 6px; cursor: pointer; font-size: 13px; font-weight: 600;
                                       transition: all 0.3s; display: flex; align-items: center; gap: 6px;"
                                onmouseover="this.style.background='#7c3aed'"
                                onmouseout="this.style.background='#8b5cf6'"
                                title="Imprimir todas las etiquetas (tarima + bultos)">
                            🖨️ Todas
                        </button>
                    </div>
                </div>
                                </div>

                                <!-- Métricas de la tarima -->
                                <div style="
                                    display: grid;
                                    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
                                    gap: 12px;
                                    position: relative;
                                    z-index: 1;
                                ">
                                    <div style="
                                        background: rgba(255,255,255,0.15);
                                        backdrop-filter: blur(10px);
                                        padding: 12px;
                                        border-radius: 10px;
                                        border: 1px solid rgba(255,255,255,0.25);
                                    ">
                                        <div style="color: rgba(255,255,255,0.85); font-size: 11px; margin-bottom: 4px;">⚖️ PESO NETO TOTAL</div>
                                        <div style="color: white; font-size: 18px; font-weight: 700;">${totalPesoNetoTarima.toFixed(2)} <span style="font-size: 13px; font-weight: 400;">gr</span></div>
                                    </div>
                                    <div style="
                                        background: rgba(255,255,255,0.15);
                                        backdrop-filter: blur(10px);
                                        padding: 12px;
                                        border-radius: 10px;
