        // 4. Función para generar ZPL de etiqueta de TARIMA desde modal
        function generarEtiquetaTarimaDesdeModal(tarima, packingData) {
            const fecha = new Date().toLocaleDateString('es-MX', { day: '2-digit', month: '2-digit', year: '2-digit' });

            const bultos = tarima.bultos || [];

            // Calcular totales de la tarima
            let totalBultos = bultos.length;
            let totalPesoNeto = 0;
            let totalPesoBruto = 0;
            let totalVolumen = 0;

            bultos.forEach(bulto => {
                totalPesoNeto += Number(bulto.peso_neto) || 0;
                totalPesoBruto += Number(bulto.pesoBruto) || 0;
                const dims = bulto.dimensiones || {};
                const vol = Number(dims.volumen) || ((Number(dims.largo) || 0) * (Number(dims.ancho) || 0) * (Number(dims.alto) || 0));
                totalVolumen += vol;
            });

            // Configuración de columnas para lista de cajas
            const maxCajasVisibles = 16;
            const cajasAMostrar = Math.min(totalBultos, maxCajasVisibles);
            const cajasPorColumna = Math.ceil(cajasAMostrar / 2);
            const alturaPorCaja = 25;
            const alturaEncabezado = 30;
            const alturaExtra = (totalBultos > maxCajasVisibles) ? 20 : 0;
            const alturaContenedor = alturaEncabezado + (cajasPorColumna * alturaPorCaja) + alturaExtra;

            const columna1X = 70;
            const columna2X = 400;

            // Generar lista de cajas en 2 columnas
            let listaCajasZPL = '';
            bultos.slice(0, maxCajasVisibles).forEach((bulto, index) => {
                const columna = index % 2;
                const filaEnColumna = Math.floor(index / 2);
                const yPos = 325 + (filaEnColumna * alturaPorCaja);
                const xPos = columna === 0 ? columna1X : columna2X;

                const dims = bulto.dimensiones || {};
                const volumenBulto = Number(dims.volumen) || ((Number(dims.largo) || 0) * (Number(dims.ancho) || 0) * (Number(dims.alto) || 0));

                listaCajasZPL += `^CF0,14\n`;
                listaCajasZPL += `^FO${xPos},${yPos}^FDCaja #${bulto.numero}^FS\n`;
                listaCajasZPL += `^FO${xPos + 100},${yPos}^FD${volumenBulto.toFixed(3)} m3^FS\n`;
