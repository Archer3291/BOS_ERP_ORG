        // ============================================
        // GENERADOR DE PDF - VERSIÓN CORREGIDA
        // ============================================
        async function generarPDFDesdeModal() {
            try {
                console.log('📄 Generando PDF con datos:', currentPackingListData);

                if (!currentPackingListData) {
                    alert('⚠️ No hay datos para generar el PDF');
                    return;
                }

                const data = currentPackingListData;
                const tarimas = Array.isArray(data.tarimas) ? data.tarimas : [];

                if (tarimas.length === 0) {
                    alert('⚠️ No hay tarimas para generar el PDF');
                    return;
                }

                const { jsPDF } = window.jspdf;
                const doc = new jsPDF('p', 'mm', 'a4');

                const pageWidth = doc.internal.pageSize.getWidth();
                const pageHeight = doc.internal.pageSize.getHeight();
                const margin = 20;
                let yPos = margin;

                // Colores del tema
                const primaryColor = [21, 63, 112];
                const accentColor = [21, 63, 112];
                const lightGray = [245, 245, 245];
                const mediumGray = [189, 189, 189];
                const darkGray = [97, 97, 97];

                // ============================================
                // ENCABEZADO CON LOGO
                // ============================================
                doc.setFillColor(21, 63, 112);
                doc.rect(0, 0, pageWidth, 40, 'F');

                doc.setDrawColor(...accentColor);
                doc.setLineWidth(2);
                doc.line(0, 0, pageWidth, 0);

                try {
                    const logoBase64 = await convertToBase64(`/Content/img/${empresa}/logo-light.png`);
                    doc.addImage(logoBase64, 'PNG', margin, 10, 30, 20);
                } catch (err) {
                    console.warn('⚠️ No se pudo cargar el logo');
                }

                doc.setFontSize(10);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text('SISTEMA DE REQUISICIÓN Y SUMINISTRO', margin + 35, 15);

                doc.setFontSize(8);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(240, 240, 240);
                doc.text('Packing & Logistics Department', margin + 35, 20);

                doc.setFontSize(22);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text('PACKING LIST', pageWidth - margin, 18, { align: 'right' });

                doc.setFontSize(9);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(240, 240, 240);
                doc.text('Lista de Empaque Internacional', pageWidth - margin, 24, { align: 'right' });

                doc.setFillColor(...accentColor);
                doc.roundedRect(pageWidth - margin - 50, 27, 50, 8, 2, 2, 'F');
                doc.setFontSize(9);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(255, 255, 255);
                doc.text(`#${data.facturaReferenciaTexto || data.facturaReferencia || 'N/A'}`, pageWidth - margin - 25, 33, { align: 'center' });

                doc.setDrawColor(...mediumGray);
                doc.setLineWidth(0.3);
                doc.line(margin, 40, pageWidth - margin, 40);

                yPos = 45;
                doc.setDrawColor(...mediumGray);
                doc.setLineWidth(0.5);
                doc.line(margin, yPos, pageWidth - margin, yPos);
                yPos += 10;

                // ============================================
                // INFORMACIÓN DE EMBARQUE
                // ============================================
                doc.setFontSize(11);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text('INFORMACIÓN DE EMBARQUE', margin, yPos);
                yPos += 8;

                const colWidth = (pageWidth - 2 * margin - 10) / 2;

                let leftY = yPos;
                const leftInfo = [
                    ['Fecha', data.fechaEmbarque || data.fecha_embarque || 'N/A'],
                    ['Transporte', data.medioTransporte || data.medio_transporte || 'N/A'],
                    ['Origen', data.puertoSalida || data.puerto_salida || 'N/A'],
                    ['Destino', data.puertoDestino || data.puerto_destino || 'N/A']
                ];

                leftInfo.forEach(([label, value]) => {
                    doc.setFontSize(8);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...darkGray);
                    doc.text(label.toUpperCase(), margin, leftY);

                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(0, 0, 0);
                    doc.setFontSize(9);
                    const wrappedText = doc.splitTextToSize(value, colWidth - 5);
                    doc.text(wrappedText, margin, leftY + 4);
                    leftY += 12;
                });

                let rightY = yPos;
                const rightX = margin + colWidth + 10;
                const rightInfo = [
                    ['Incoterm', data.incoterm || 'N/A'],
                    ['Contenedor', data.numeroContenedor || data.numero_guia || 'N/A'],
                    ['Orden Cliente', data.ODCComprador || data.orden_compra_comprador || 'N/A']
                ];

                rightInfo.forEach(([label, value]) => {
                    doc.setFontSize(8);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...darkGray);
                    doc.text(label.toUpperCase(), rightX, rightY);

                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(0, 0, 0);
                    doc.setFontSize(9);
                    const wrappedText = doc.splitTextToSize(value, colWidth - 5);
                    doc.text(wrappedText, rightX, rightY + 4);
                    rightY += 12;
                });

                yPos = Math.max(leftY, rightY) + 5;

                // ============================================
                // CONSIGNATARIO
                // ============================================
                doc.setFillColor(...lightGray);
                doc.roundedRect(margin, yPos, pageWidth - 2 * margin, 28, 2, 2, 'F');

                doc.setFontSize(9);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text('DESTINATARIO', margin + 5, yPos + 6);

                const consig = data.consignatario || {};
                doc.setFontSize(8);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(0, 0, 0);

                const direccion = [
                    consig.nombre,
                    `${consig.calle || ''} ${consig.nexterior || ''} ${consig.ninterior || ''}`.trim(),
                    `${consig.colonia || ''}, C.P. ${consig.cp || ''}`,
                    `${consig.estado || ''}, ${consig.pais || ''}`
                ].filter(line => line && line.trim() !== '' && line !== ', C.P. ');

                let dirY = yPos + 12;
                direccion.forEach(line => {
                    doc.text(line, margin + 5, dirY);
                    dirY += 4;
                });

                yPos += 35;

                // ============================================
                // DETALLE DE TARIMAS Y BULTOS
                // ============================================
                doc.setFontSize(11);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text('DETALLE DE TARIMAS Y BULTOS', margin, yPos);
                yPos += 8;

                // Iterar sobre las TARIMAS
                tarimas.forEach((tarima, tarimaIndex) => {
                    const bultos = Array.isArray(tarima.bultos) ? tarima.bultos : [];

                    if (bultos.length === 0) {
                        console.warn(`⚠️ Tarima ${tarimaIndex + 1} no tiene bultos`);
                        return;
                    }

                    // Título de la tarima
                    if (yPos > pageHeight - 80) {
                        doc.addPage();
                        yPos = margin + 10;
                    }

                    doc.setFillColor(...accentColor);
                    doc.roundedRect(margin, yPos, pageWidth - 2 * margin, 10, 2, 2, 'F');

                    doc.setFontSize(10);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(255, 255, 255);
                    doc.text(`${`EMPAQUE ${tarima.numero || (tarimaIndex + 1)}`}`, margin + 5, yPos + 6);

                    // Estadísticas de la tarima
                    let totalBultosTarima = bultos.length;
                    let totalPesoNetoTarima = 0;
                    let totalPesoBrutoTarima = 0;
                    let totalVolumenTarima = 0;

                    bultos.forEach(bulto => {
                        totalPesoNetoTarima += parseFloat(bulto.pesoNeto || bulto.peso_neto) || 0;
                        totalPesoBrutoTarima += parseFloat(bulto.pesoBruto || bulto.peso_bruto) || 0;
                        const dims = bulto.dimensiones || bulto;
                        const vol = Number(dims.volumen) || ((Number(dims.largo) || 0) * (Number(dims.ancho) || 0) * (Number(dims.alto) || 0));
                        totalVolumenTarima += vol;
                    });

                    doc.setFontSize(7);
                    doc.setTextColor(255, 255, 255);
                    const statsText = `Bultos: ${totalBultosTarima} | Peso Neto: ${totalPesoNetoTarima.toFixed(2)} gr | Peso Bruto: ${totalPesoBrutoTarima.toFixed(2)} gr | Vol: ${totalVolumenTarima.toFixed(3)} m³`;
                    doc.text(statsText, pageWidth - margin - 5, yPos + 6, { align: 'right' });

                    yPos += 15;

                    // Iterar sobre los BULTOS de esta tarima
                    bultos.forEach((bulto, bultoIndex) => {
                        if (yPos > pageHeight - 70) {
                            doc.addPage();
                            yPos = margin + 10;
                        }

                        // Tarjeta del bulto
                        doc.setDrawColor(...accentColor);
                        doc.setLineWidth(1);
                        doc.line(margin + 5, yPos, margin + 5, yPos + 18);

                        doc.setFillColor(255, 255, 255);
                        doc.setDrawColor(...mediumGray);
                        doc.setLineWidth(0.3);
                        doc.roundedRect(margin + 8, yPos, pageWidth - 2 * margin - 8, 18, 2, 2, 'FD');

                        // Número de bulto
                        doc.setFillColor(...primaryColor);
                        doc.circle(margin + 17, yPos + 9, 6, 'F');
                        doc.setFontSize(10);
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(255, 255, 255);
                        doc.text(bulto.numero.toString(), margin + 17, yPos + 11, { align: 'center' });

                        // Info del bulto
                        doc.setFontSize(8);
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(...darkGray);

                        const infoX = margin + 27;
                        doc.text('TIPO:', infoX, yPos + 5);
                        doc.text('MARCA:', infoX, yPos + 10);
                        doc.text('DIMENSIONES:', infoX, yPos + 15);

                        doc.setFont('helvetica', 'normal');
                        doc.setTextColor(0, 0, 0);
                        doc.text(bulto.tipoEmbalaje || bulto.tipo_embalaje || 'N/A', infoX + 15, yPos + 5);
                        doc.text(bulto.marca || 'N/A', infoX + 15, yPos + 10);

                        const dims = bulto.dimensiones || bulto;
                        doc.text(`${dims.largo || 0} × ${dims.ancho || 0} × ${dims.alto || 0} m`, infoX + 30, yPos + 15);

                        // Pesos
                        const pesoX = pageWidth - margin - 55;
                        doc.setFillColor(...lightGray);
                        doc.roundedRect(pesoX, yPos + 3, 50, 5, 1, 1, 'F');
                        doc.roundedRect(pesoX, yPos + 10, 50, 5, 1, 1, 'F');

                        doc.setFontSize(7);
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(...darkGray);
                        doc.text('PESO NETO:', pesoX + 2, yPos + 6);
                        doc.text('PESO BRUTO:', pesoX + 2, yPos + 13);

                        doc.setFontSize(9);
                        doc.setFont('helvetica', 'bold');
                        doc.setTextColor(...accentColor);
                        doc.text(`${(bulto.pesoNeto || bulto.peso_neto || 0).toFixed(2)} gr`, pesoX + 48, yPos + 6, { align: 'right' });
                        doc.text(`${(bulto.pesoBruto || bulto.peso_bruto || 0).toFixed(2)} gr`, pesoX + 48, yPos + 13, { align: 'right' });

                        yPos += 23;

                        // Tabla de items
                        const items = Array.isArray(bulto.items) ? bulto.items : [];
                        if (items.length > 0) {
                            const itemsData = items.map(item => [
                                item.sku || 'N/A',
                                item.descripcion || 'N/A',
                                (item.cantidad || 0).toString(),
                                item.unidad || 'PZA',
                                item.fraccion || 'N/A'
                            ]);

                            doc.autoTable({
                                startY: yPos,
                                head: [['SKU', 'DESCRIPCIÓN', 'CANT.', 'UNIDAD', 'FRACCIÓN']],
                                body: itemsData,
                                theme: 'plain',
                                styles: {
                                    fontSize: 7,
                                    cellPadding: 3,
                                    lineColor: mediumGray,
                                    lineWidth: 0.1
                                },
                                headStyles: {
                                    fillColor: primaryColor,
                                    textColor: 255,
                                    fontStyle: 'bold',
                                    fontSize: 7,
                                    halign: 'left'
                                },
                                alternateRowStyles: {
                                    fillColor: [250, 250, 250]
                                },
                                columnStyles: {
                                    0: { cellWidth: 25, fontStyle: 'bold' },
                                    1: { cellWidth: 70 },
                                    2: { cellWidth: 18, halign: 'center' },
                                    3: { cellWidth: 18, halign: 'center' },
                                    4: { cellWidth: 30, halign: 'center', fontSize: 6 }
                                },
                                margin: { left: margin + 11, right: margin }
                            });

                            yPos = doc.lastAutoTable.finalY + 10;
                        }
                    });

                    yPos += 5; // Espacio entre tarimas
                });

                // ============================================
                // RESUMEN DE TOTALES
                // ============================================
                if (yPos > pageHeight - 50) {
                    doc.addPage();
                    yPos = margin + 10;
                }

                // Calcular totales generales
                let totalBultosGeneral = 0;
                let totalPesoNetoGeneral = 0;
                let totalPesoBrutoGeneral = 0;
                let totalVolumenGeneral = 0;

                tarimas.forEach(tarima => {
                    const bultos = Array.isArray(tarima.bultos) ? tarima.bultos : [];
                    bultos.forEach(bulto => {
                        totalBultosGeneral++;
                        totalPesoNetoGeneral += parseFloat(bulto.pesoNeto || bulto.peso_neto) || 0;
                        totalPesoBrutoGeneral += parseFloat(bulto.pesoBruto || bulto.peso_bruto) || 0;
                        const dims = bulto.dimensiones || bulto;
                        const vol = Number(dims.volumen) || ((Number(dims.largo) || 0) * (Number(dims.ancho) || 0) * (Number(dims.alto) || 0));
                        totalVolumenGeneral += vol;
                    });
                });

                // Tarjetas de totales
                const cardWidth = (pageWidth - 2 * margin - 20) / 4;
                const totales = [
                    { label: 'TARIMAS', value: tarimas.length, unit: '' },
                    { label: 'BULTOS', value: totalBultosGeneral, unit: '' },
                    { label: 'PESO NETO', value: totalPesoNetoGeneral.toFixed(2), unit: 'gr' },
                    { label: 'PESO BRUTO', value: totalPesoBrutoGeneral.toFixed(2), unit: 'gr' }
                ];

                totales.forEach((total, i) => {
                    const cardX = margin + (cardWidth + 5) * i;

                    doc.setFillColor(...lightGray);
                    doc.roundedRect(cardX, yPos, cardWidth, 18, 2, 2, 'F');

                    doc.setFontSize(7);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...darkGray);
                    doc.text(total.label, cardX + cardWidth / 2, yPos + 5, { align: 'center' });

                    doc.setFontSize(14);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...primaryColor);
                    doc.text(total.value.toString(), cardX + cardWidth / 2, yPos + 12, { align: 'center' });

                    doc.setFontSize(7);
                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(...darkGray);
                    doc.text(total.unit, cardX + cardWidth / 2, yPos + 16, { align: 'center' });
                });

                yPos += 25;

                // Segunda fila: Volumen
                const totalVolumenCard = {
                    label: 'VOLUMEN TOTAL',
                    value: totalVolumenGeneral.toFixed(3),
                    unit: 'm³'
                };

                doc.setFillColor(...lightGray);
                doc.roundedRect(margin, yPos, cardWidth, 18, 2, 2, 'F');

                doc.setFontSize(7);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...darkGray);
                doc.text(totalVolumenCard.label, margin + cardWidth / 2, yPos + 5, { align: 'center' });

                doc.setFontSize(14);
                doc.setFont('helvetica', 'bold');
                doc.setTextColor(...primaryColor);
                doc.text(totalVolumenCard.value, margin + cardWidth / 2, yPos + 12, { align: 'center' });

                doc.setFontSize(7);
                doc.setFont('helvetica', 'normal');
                doc.setTextColor(...darkGray);
                doc.text(totalVolumenCard.unit, margin + cardWidth / 2, yPos + 16, { align: 'center' });

                yPos += 25;

                // ============================================
                // OBSERVACIONES
                // ============================================
                if (data.observaciones && data.observaciones.trim() !== '') {
                    if (yPos > pageHeight - 30) {
                        doc.addPage();
                        yPos = margin + 10;
                    }

                    doc.setFontSize(9);
                    doc.setFont('helvetica', 'bold');
                    doc.setTextColor(...primaryColor);
                    doc.text('OBSERVACIONES', margin, yPos);
                    yPos += 5;

                    doc.setFontSize(8);
                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(0, 0, 0);
                    const obs = doc.splitTextToSize(data.observaciones, pageWidth - 2 * margin);
                    doc.text(obs, margin, yPos);
                }

                // ============================================
                // PIE DE PÁGINA
                // ============================================
                const totalPages = doc.internal.getNumberOfPages();
                for (let i = 1; i <= totalPages; i++) {
                    doc.setPage(i);

                    doc.setDrawColor(...mediumGray);
                    doc.setLineWidth(0.3);
                    doc.line(margin, pageHeight - 15, pageWidth - margin, pageHeight - 15);

                    doc.setFontSize(7);
                    doc.setFont('helvetica', 'normal');
                    doc.setTextColor(...darkGray);
                    doc.text(`Página ${i} de ${totalPages}`, pageWidth / 2, pageHeight - 10, { align: 'center' });
                    doc.text(`Generado: ${new Date().toLocaleString('es-MX')}`, pageWidth - margin, pageHeight - 10, { align: 'right' });
                }

                // ============================================
                // GUARDAR PDF
                // ============================================
                const nombreArchivo = `PackingList_${data.facturaReferenciaTexto || data.facturaReferencia || 'documento'}_${new Date().toISOString().split('T')[0]}.pdf`;
                doc.save(nombreArchivo);

                console.log('✅ PDF generado exitosamente:', nombreArchivo);

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'success',
                        title: 'PDF Generado',
                        text: `El archivo ${nombreArchivo} se ha descargado correctamente`,
                        timer: 3000,
                        showConfirmButton: false
                    });
                }

            } catch (error) {
                console.error('❌ Error al generar PDF:', error);

                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error al generar PDF',
                        text: error.message || 'Ocurrió un error inesperado',
                        confirmButtonText: 'Aceptar'
                    });
                } else {
                    alert(`❌ Error al generar PDF:\n\n${error.message}`);
                }
            }
        }

        // ============================================
        // FUNCIÓN AUXILIAR PARA CONVERTIR IMAGEN A BASE64
        // ============================================
        async function convertToBase64(url) {
            try {
                const response = await fetch(url);
                const blob = await response.blob();
                return new Promise((resolve, reject) => {
                    const reader = new FileReader();
                    reader.onloadend = () => resolve(reader.result);
                    reader.onerror = reject;
                    reader.readAsDataURL(blob);
                });
            } catch (error) {
                console.error('Error al convertir imagen:', error);
                throw error;
            }
        }

