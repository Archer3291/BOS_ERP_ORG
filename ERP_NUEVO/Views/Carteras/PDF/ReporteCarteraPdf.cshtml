
@model BOS_ERP.Models.ReportePdfViewModel
@using BOS_ERP.Controllers
@using System.Globalization

@{
    Layout = null;
    var ci = new CultureInfo("es-MX");
    Func<decimal, string> fmt = v => v.ToString("C2", ci);
    Func<object, string> fmtDate = v =>
    {
        if (v is DateTime dt) return dt.ToString("dd/MM/yyyy");
        if (DateTime.TryParse(v?.ToString(), out DateTime parsed)) return parsed.ToString("dd/MM/yyyy");
        return v?.ToString() ?? "—";
    };
    Func<object, string> fmtDecimal = v =>
    {
        if (v == null) return "—";
        if (decimal.TryParse(v.ToString(), out decimal d)) return d.ToString("C2", ci);
        return v.ToString();
    };
    Func<object, string> fmtInt = v =>
    {
        if (v == null) return "0";
        if (int.TryParse(v.ToString(), out int i)) return i.ToString("N0", ci);
        return v.ToString();
    };
    Func<Dictionary<string, object>, string, object> getVal = (row, key) =>
    {
        object val;
        return row.TryGetValue(key, out val) ? val : null;
    };
    Func<Dictionary<string, object>, string, decimal> getDec = (row, key) =>
    {
        object val;
        if (!row.TryGetValue(key, out val) || val == null) return 0m;
        try { return Convert.ToDecimal(val); } catch { return 0m; }
    };
    Func<int, string> ageingClass = dias =>
    {
        if (dias <= 0) return "ageing-0";
        if (dias <= 30) return "ageing-30";
        if (dias <= 60) return "ageing-60";
        return "ageing-90";
    };
    Func<string, string> estadoClass = estado =>
    {
        if (string.IsNullOrEmpty(estado)) return "";
        switch (estado.ToLower())
        {
            case "cobrado": return "badge-cobrado";
            case "pendiente": return "badge-pendiente";
            case "parcial": return "badge-parcial";
            case "vencido": return "badge-vencido";
            default: return "";
        }
    };
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8" />
    <title>@Model.Titulo</title>
    <style>
        /* ══════════════════════════════════════════════
           DESIGN TOKENS — igual que PDF_THEME en jsPDF
        ══════════════════════════════════════════════ */
        :root {
            --primary: #0f3460;
            --accent: #0078d7;
            --text-dark: #1e1e1e;
            --text-mid: #5a5a5a;
            --text-light: #a0a0a0;
            --white: #ffffff;
            --row-alt: #f8fafd;
            --bg-light: #f5f7fa;
            --border-light: #dce1e8;
            --success: #27ae60;
            --danger: #c0392b;
            --warning: #d97706;
            --accent-light: rgba(0,120,215,0.08);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: Arial, sans-serif;
            font-size: 8pt;
            color: var(--text-dark);
            background: var(--white);
        }

        /* ── Encabezado corporativo ──────────────────── */
        .page-header {
            display: flex;
            align-items: stretch;
            border-bottom: 2px solid var(--border-light);
            padding-bottom: 10px;
            margin-bottom: 10px;
            position: relative;
            min-height: 52px;
        }

        .header-accent-bar {
            width: 4px;
            background: var(--primary);
            border-radius: 2px;
            margin-right: 10px;
            flex-shrink: 0;
        }

        .header-logo {
            height: 36px;
            width: auto;
            margin-right: 12px;
            object-fit: contain;
            flex-shrink: 0;
        }

        .header-info {
            flex: 1;
        }

        .header-razon {
            font-size: 10pt;
            font-weight: bold;
            color: var(--primary);
            margin-bottom: 2px;
        }

        .header-datos {
            font-size: 7pt;
            color: var(--text-mid);
            line-height: 1.5;
        }

        .header-right {
            text-align: right;
            flex-shrink: 0;
            min-width: 120px;
        }

        .header-doc-title {
            font-size: 9pt;
            font-weight: bold;
            color: var(--primary);
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .header-fecha-label {
            font-size: 6.5pt;
            color: var(--text-mid);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 4px;
        }

        .header-fecha-val {
            font-size: 8.5pt;
            color: var(--text-dark);
        }

        /* ── Banda filtros ───────────────────────────── */
        .filters-band {
            background: var(--bg-light);
            border-left: 3px solid var(--accent);
            border-radius: 2px;
            padding: 5px 10px;
            margin-bottom: 10px;
            font-size: 7pt;
            color: var(--text-mid);
        }

            .filters-band strong {
                color: var(--text-dark);
                font-size: 6.5pt;
                text-transform: uppercase;
                letter-spacing: 0.05em;
                display: block;
                margin-bottom: 2px;
            }

        /* ── KPI Cards ───────────────────────────────── */
        .kpi-strip {
            display: flex;
            gap: 6px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .kpi-card {
            flex: 1;
            min-width: 100px;
            background: var(--white);
            border: 1px solid var(--border-light);
            border-radius: 4px;
            padding: 7px 8px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .kpi-icon {
            width: 26px;
            height: 26px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11pt;
            flex-shrink: 0;
            font-weight: bold;
        }

            .kpi-icon.blue {
                background: rgba(0,120,215,0.1);
                color: var(--accent);
            }

            .kpi-icon.green {
                background: rgba(39,174,96,0.1);
                color: var(--success);
            }

            .kpi-icon.orange {
                background: rgba(217,119,6,0.12);
                color: var(--warning);
            }

            .kpi-icon.red {
                background: rgba(192,57,43,0.1);
                color: var(--danger);
            }

            .kpi-icon.cyan {
                background: rgba(6,182,212,0.1);
                color: #0891b2;
            }

            .kpi-icon.purple {
                background: rgba(147,51,234,0.1);
                color: #9333ea;
            }

        .kpi-label {
            font-size: 6pt;
            color: var(--text-light);
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-bottom: 1px;
        }

        .kpi-value {
            font-size: 9.5pt;
            font-weight: bold;
            color: var(--text-dark);
            line-height: 1.1;
        }

        .kpi-sub {
            font-size: 6pt;
            color: var(--text-light);
            margin-top: 1px;
        }

        /* ── Sección (por cliente / agrupación) ──────── */
        .seccion {
            margin-bottom: 16px;
            page-break-inside: avoid;
        }

        .seccion-header {
            background: var(--primary);
            color: var(--white);
            padding: 5px 10px;
            border-radius: 3px 3px 0 0;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 0;
        }

        .seccion-titulo {
            font-size: 8pt;
            font-weight: bold;
            letter-spacing: 0.02em;
        }

        .seccion-kpis {
            font-size: 6.5pt;
            opacity: 0.85;
            display: flex;
            gap: 12px;
        }

            .seccion-kpis span {
                white-space: nowrap;
            }

        /* ── Tabla principal ─────────────────────────── */
        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 7pt;
        }

            .data-table thead th {
                background: var(--primary);
                color: var(--white);
                font-weight: bold;
                font-size: 6.5pt;
                text-align: center;
                padding: 5px 4px;
                border: 0.15px solid rgba(220,225,232,0.3);
                white-space: nowrap;
            }

            .data-table tbody tr:nth-child(even) {
                background: var(--row-alt);
            }

            .data-table tbody tr:nth-child(odd) {
                background: var(--white);
            }

            .data-table tbody td {
                padding: 4px 4px;
                border: 0.15px solid var(--border-light);
                vertical-align: middle;
            }

            .data-table tbody tr:hover {
                background: var(--accent-light);
            }

            /* Totales al pie de tabla */
            .data-table tfoot td {
                background: #fef3c7;
                font-weight: bold;
                font-size: 7pt;
                padding: 5px 4px;
                border: 1px solid #d97706;
            }

        /* Alineaciones */
        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        .text-left {
            text-align: left;
        }

        /* ── Badges de estado ────────────────────────── */
        .badge-estado {
            display: inline-block;
            padding: 1px 6px;
            border-radius: 8px;
            font-size: 6pt;
            font-weight: bold;
            white-space: nowrap;
        }

        .badge-cobrado {
            background: rgba(39,174,96,0.12);
            color: #27ae60;
        }

        .badge-pendiente {
            background: rgba(217,119,6,0.12);
            color: #d97706;
        }

        .badge-parcial {
            background: rgba(0,120,215,0.12);
            color: #0078d7;
        }

        .badge-vencido {
            background: rgba(192,57,43,0.12);
            color: #c0392b;
        }

        /* ── Ageing chips ────────────────────────────── */
        .ageing-chip {
            display: inline-block;
            padding: 1px 5px;
            border-radius: 3px;
            font-size: 6pt;
            font-weight: bold;
        }

        .ageing-0 {
            background: rgba(39,174,96,0.1);
            color: #27ae60;
        }

        .ageing-30 {
            background: rgba(0,120,215,0.1);
            color: #0078d7;
        }

        .ageing-60 {
            background: rgba(217,119,6,0.1);
            color: #d97706;
        }

        .ageing-90 {
            background: rgba(192,57,43,0.1);
            color: #c0392b;
        }

        /* ── Barra de progreso ───────────────────────── */
        .pct-wrap {
            display: flex;
            align-items: center;
            gap: 4px;
        }

        .pct-bar-bg {
            width: 50px;
            height: 4px;
            background: var(--border-light);
            border-radius: 2px;
            overflow: hidden;
            display: inline-block;
        }

        .pct-bar-fill {
            height: 100%;
            border-radius: 2px;
        }

        .pct-label {
            font-size: 6pt;
            color: var(--text-mid);
            white-space: nowrap;
        }

        /* ── UUID monospace ──────────────────────────── */
        .uuid-cell {
            font-family: 'Courier New', monospace;
            font-size: 6pt;
            color: var(--text-light);
        }

        /* ── Separador entre secciones (modo clientes) ─ */
        .page-break-after {
            page-break-after: always;
        }

        /* ── Pie de página (Rotativa lo renderiza vía --footer-*) ── */
        /* El footer se configura en CustomSwitches del controlador   */

        /* ── Tipo doc badge ──────────────────────────── */
        .tipo-doc {
            font-size: 6pt;
            font-weight: bold;
            color: var(--accent);
        }
    </style>
</head>
<body>

    @* ══════════════════════════════════════════════════
           ENCABEZADO CORPORATIVO
        ══════════════════════════════════════════════════ *@
    <div class="page-header">
        <div class="header-accent-bar"></div>

        @* Logo — ajusta la ruta a donde tienes el logo *@
        <img class="header-logo"
             src="@Url.Content("~/content/img/logo.png")"
             alt="Logo" />

        <div class="header-info">
            <div class="header-razon">@Model.Titulo</div>
            <div class="header-datos">
                Generado: @Model.FechaGen.ToString("dd/MM/yyyy HH:mm")
                &nbsp;·&nbsp;
                @(Model.Modo == "clientes" ? "Por cliente" : "Detalle de facturas")
            </div>
        </div>

        <div class="header-right">
            <div class="header-doc-title">Reporte de Cartera</div>
            <div class="header-fecha-label">Fecha</div>
            <div class="header-fecha-val">@Model.FechaGen.ToString("dd/MM/yyyy")</div>
        </div>
    </div>

    @* ── Filtros aplicados ── *@
    @if (!string.IsNullOrWhiteSpace(Model.FiltrosAplicados) && Model.FiltrosAplicados != "Sin filtros aplicados")
    {
        <div class="filters-band">
            <strong>Filtros aplicados</strong>
            @Model.FiltrosAplicados
        </div>
    }

    @* ══════════════════════════════════════════════════
           KPIs GLOBALES
        ══════════════════════════════════════════════════ *@
    <div class="kpi-strip">
        <div class="kpi-card">
            <div class="kpi-icon blue">&#9635;</div>
            <div>
                <div class="kpi-label">Total facturas</div>
                <div class="kpi-value">@Model.KpisGlobal.TotalFacturas.ToString("N0", ci)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon orange">&#9711;</div>
            <div>
                <div class="kpi-label">Saldo pendiente</div>
                <div class="kpi-value">@fmt(Model.KpisGlobal.TotalPendiente)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon green">&#9650;</div>
            <div>
                <div class="kpi-label">Total cobrado</div>
                <div class="kpi-value">@fmt(Model.KpisGlobal.TotalCobrado)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon cyan">%</div>
            <div>
                <div class="kpi-label">% Cobrado</div>
                <div class="kpi-value">@Model.KpisGlobal.PctCobro%</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon red">!</div>
            <div>
                <div class="kpi-label">Fact. vencidas</div>
                <div class="kpi-value">@Model.KpisGlobal.FacturasVencidas.ToString("N0", ci)</div>
                <div class="kpi-sub">@fmt(Model.KpisGlobal.MontoVencido)</div>
            </div>
        </div>
        <div class="kpi-card">
            <div class="kpi-icon purple">&#9670;</div>
            <div>
                <div class="kpi-label">Monto total</div>
                <div class="kpi-value">@fmt(Model.KpisGlobal.TotalMonto)</div>
            </div>
        </div>
    </div>

    @* ══════════════════════════════════════════════════
           SECCIONES DE DATOS
        ══════════════════════════════════════════════════ *@
    @{
        bool esModoPorCliente = Model.Modo == "clientes";
        int seccionIdx = 0;
    }

    @foreach (var seccion in Model.Secciones)
    {
        bool esUltima = seccionIdx == Model.Secciones.Count - 1;

        <div class="seccion @(!esUltima && esModoPorCliente ? "page-break-after" : "")">

            @* Encabezado de sección *@
            <div class="seccion-header">
                <span class="seccion-titulo">@seccion.Titulo</span>
                <span class="seccion-kpis">
                    <span>@seccion.Kpis.TotalFacturas facturas</span>
                    <span>Total: @fmt(seccion.Kpis.TotalMonto)</span>
                    <span>Cobrado: @fmt(seccion.Kpis.TotalCobrado)</span>
                    <span>Pendiente: @fmt(seccion.Kpis.TotalPendiente)</span>
                </span>
            </div>

            @* Tabla *@
            <table class="data-table">
                <thead>
                    <tr>
                        @foreach (var col in Model.ColDefs)
                        {
                            <th>@col.Title</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in seccion.Rows)
                    {
                        <tr>
                            @foreach (var col in Model.ColDefs)
                            {
                                var rawVal = col.DataField != null ? getVal(row, col.DataField) : null;

                                switch (col.DataType)
                                {
                                    case "currency":
                                        <td class="text-right" style="font-weight:600;">
                                            @fmtDecimal(rawVal)
                                        </td>
                                        break;

                                    case "date":
                                        <td class="text-center">@fmtDate(rawVal)</td>
                                        break;

                                    case "int":
                                        if (col.DataField == "dias_vencido")
                                        {
                                            int dias = rawVal != null ? Convert.ToInt32(rawVal) : 0;
                                            <td class="text-center">
                                                <span class="ageing-chip @ageingClass(dias)">
                                                    @(dias <= 0 ? "Al día" : dias + " días")
                                                </span>
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="text-center">@fmtInt(rawVal)</td>
                                        }
                                        break;

                                    case "pct":
                                            decimal tot = getDec(row, "monto_total");
                                            decimal cob = getDec(row, "cobrado");
                                            decimal pct = tot > 0 ? Math.Min(100m, Math.Round(cob / tot * 100, 1)) : 100m;
                                            string pctColor = pct >= 80 ? "#27ae60" : pct >= 40 ? "#0078d7" : "#d97706";
                                        <td class="text-center">
                                            <div class="pct-wrap">
                                                <div class="pct-bar-bg">
                                                    <div class="pct-bar-fill"
                                                         style="width:@pct.ToString("0", ci)%;background:@pctColor;"></div>
                                                </div>
                                                <span class="pct-label">@pct.ToString("0.0", ci)%</span>
                                            </div>
                                        </td>
                                        break;

                                    default:
                                        @* Casos especiales por DataField *@
                                        if (col.DataField == "estado")
                                        {
                                            string est = rawVal?.ToString() ?? "";
                                            <td class="text-center">
                                                <span class="badge-estado @estadoClass(est)">
                                                    @est.ToUpper()
                                                </span>
                                            </td>
                                        }
                                        else if (col.DataField == "nat")
                                        {
                                            <td class="text-center">
                                                <span class="tipo-doc">@(rawVal?.ToString() ?? "—")</span>
                                            </td>
                                        }
                                        else if (col.DataField == "factura_uuid")
                                        {
                                            string uuid = rawVal?.ToString() ?? "";
                                            <td>
                                                <span class="uuid-cell" title="@uuid">
                                                    @(uuid.Length > 18 ? uuid.Substring(0, 18) + "…" : uuid)
                                                </span>
                                            </td>
                                        }
                                        else
                                        {
                                            <td>@(rawVal?.ToString() ?? "—")</td>
                                        }
                                        break;
                                }
                            }
                        </tr>
                    }
                </tbody>

                @* Fila de totales al pie de cada sección *@
                <tfoot>
                    <tr>
                        @{
                            bool primeraTotalCol = true;
                            foreach (var col in Model.ColDefs)
                            {
                                if (primeraTotalCol)
                                {
                                    <td><strong>TOTALES</strong></td>
                                    primeraTotalCol = false;
                                }
                                else if (col.DataType == "currency" && col.DataField != null)
                                {
                                    decimal total = seccion.Rows.Sum(r => getDec(r, col.DataField));
                                    <td class="text-right">@fmt(total)</td>
                                }
                                else
                                {
                                    <td></td>
                                }
                            }
                        }
                    </tr>
                </tfoot>
            </table>
        </div>

        seccionIdx++;
    }

</body>
</html>
