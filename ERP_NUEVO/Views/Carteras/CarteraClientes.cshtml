<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.js"></script>

<script>
    let currentClienteId = null;
    let currentFacturaId = null;
    let donutChartInstance = null;
    let barTopChartInstance = null;
    let factBarChartInstance = null;

    /* ── helpers de color ── */
    function isDarkMode() {
        return document.documentElement.getAttribute('data-theme') === 'dark'
            || window.matchMedia('(prefers-color-scheme: dark)').matches;
    }

    function chartTextColor() { return isDarkMode() ? '#cbd5e1' : '#64748b'; }
    function chartGridColor() { return isDarkMode() ? 'rgba(71,85,105,0.5)' : 'rgba(226,232,240,0.8)'; }

    /* ── Gráfico de dona (distribución estados) ── */
    function buildDonutChart(pendiente, pagado, aFavor) {
        const ctx = document.getElementById('donutChart');
        if (!ctx) return;

        if (donutChartInstance) donutChartInstance.destroy();

        donutChartInstance = new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: ['Pendiente', 'Pagado', 'A favor'],
                datasets: [{
                    data: [pendiente, pagado, aFavor],
                    backgroundColor: ['#d97706', '#059669', '#3b82f6'],
                    borderWidth: 0,
                    hoverOffset: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                cutout: '68%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: ctx => ` ${ctx.label}: ${Currency.format(ctx.parsed)}`
                        }
                    }
                }
            }
        });

        const total = pendiente + pagado + aFavor || 1;
        const items = [
            { label: 'Pendiente', color: '#d97706', val: pendiente },
            { label: 'Pagado', color: '#059669', val: pagado },
            { label: 'A favor', color: '#3b82f6', val: aFavor },
        ];
        const legend = document.getElementById('donutLegend');
        if (legend) {
            legend.innerHTML = items.map(i =>
                `<span class="legend-item">
                    <span class="legend-dot" style="background:${i.color};"></span>
                    ${i.label} (${Math.round(i.val / total * 100)}%)
                </span>`
            ).join('');
        }
    }

    /* ── Gráfico de barras top clientes ── */
    function buildBarTopChart(clientes) {
        const ctx = document.getElementById('barTopChart');
        if (!ctx) return;
        if (barTopChartInstance) barTopChartInstance.destroy();

        const top5 = [...clientes]
            .filter(c => c.saldo > 0)
            .sort((a, b) => b.saldo - a.saldo)
            .slice(0, 5);

        const labels = top5.map(c => {
            const name = c.n_cli || '';
            return name.length > 20 ? name.substring(0, 18) + '…' : name;
        });

        const maxVal = Math.max(...top5.map(c => c.saldo), 1);
        const barColors = top5.map(c => {
            const r = c.saldo / maxVal;
            return r > 0.7 ? '#d97706' : r > 0.4 ? '#f59e0b' : '#fbbf24';
        });

        barTopChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [{
                    data: top5.map(c => c.saldo),
                    backgroundColor: barColors,
                    borderRadius: 4,
                    borderSkipped: false,
                }]
            },
            options: {
                indexAxis: 'y',
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ' ' + Currency.format(ctx.parsed.x) } }
                },
                scales: {
                    x: {
                        grid: { color: chartGridColor() },
                        ticks: {
                            color: chartTextColor(),
                            font: { size: 9 },
                            callback: v => '$' + (v >= 1000 ? Math.round(v / 1000) + 'k' : v)
                        }
                    },
                    y: {
                        grid: { display: false },
                        ticks: { color: chartTextColor(), font: { size: 9 } }
                    }
                }
            }
        });
    }

    /* ── Gráfico de progreso por factura (modal) ── */
    function buildFactBarChart(rows) {
        const ctx = document.getElementById('factBarChart');
        if (!ctx) return;
        if (factBarChartInstance) factBarChartInstance.destroy();

        const pending = rows.filter(r => r.saldo_pendiente > 0).slice(0, 8);
        if (!pending.length) return;

        const labels = pending.map(r => {
            const f = r.folio || '';
            return f.length > 14 ? f.substring(0, 12) + '…' : f;
        });

        const cobrado = pending.map(r => r.monto_total - r.saldo_pendiente);
        const pendientes = pending.map(r => r.saldo_pendiente);

        const barColors = pending.map(r => {
            const pct = r.monto_total > 0 ? (r.monto_total - r.saldo_pendiente) / r.monto_total : 0;
            return pct > 0.6 ? '#3b82f6' : pct > 0 ? '#d97706' : '#dc2626';
        });

        factBarChartInstance = new Chart(ctx, {
            type: 'bar',
            data: {
                labels,
                datasets: [
                    {
                        label: 'Cobrado',
                        data: cobrado,
                        backgroundColor: barColors,
                        borderRadius: 3,
                        borderSkipped: false,
                    },
                    {
                        label: 'Pendiente',
                        data: pendientes,
                        backgroundColor: isDarkMode() ? 'rgba(100,116,139,0.25)' : 'rgba(226,232,240,0.7)',
                        borderRadius: 3,
                        borderSkipped: false,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: { callbacks: { label: ctx => ' ' + Currency.format(ctx.parsed.y) } }
                },
                scales: {
                    x: {
                        stacked: true,
                        grid: { display: false },
                        ticks: { color: chartTextColor(), font: { size: 9 } }
                    },
                    y: {
                        stacked: true,
                        grid: { color: chartGridColor() },
                        ticks: {
                            color: chartTextColor(),
                            font: { size: 9 },
                            callback: v => '$' + (v >= 1000 ? Math.round(v / 1000) + 'k' : v)
                        }
                    }
                }
            }
        });
    }

    /* ── Formatter progreso para tabla principal ── */
    function progressFormatter(row) {
        const total = (row.saldo || 0) + (row.total_pagado || 0);
        const pct = total > 0 ? Math.round(((row.total_pagado || 0) / total) * 100) : 100;
        const barColor = row.saldo === 0 ? '#059669' : pct > 60 ? '#3b82f6' : '#d97706';
        const badgeClass = row.saldo === 0 ? 'badge-pagado' : row.saldo_favor > 0 ? 'badge-estado' : 'badge-pendiente';
        const badgeStyle = row.saldo === 0 ? '' : row.saldo_favor > 0 ? 'background:rgba(59,130,246,0.1);color:var(--accent-blue);' : '';
        const badgeText = row.saldo === 0 ? 'AL DÍA' : row.saldo_favor > 0 ? 'A FAVOR' : 'PENDIENTE';
        return `<div style="display:flex;align-items:center;gap:6px;margin-bottom:3px;">
                    <div class="progress-bar-wrap">
                        <div class="progress-bar-fill" style="width:${pct}%;background:${barColor};"></div>
                    </div>
                    <span style="font-size:10px;color:var(--text-light);">${pct}%</span>
                </div>
                <span class="badge-estado ${badgeClass}" style="${badgeStyle}">${badgeText}</span>`;
    }

    /* ── Detalle de pagos ── */
    async function detallesPago(facturaId) {
        currentFacturaId = facturaId;

        Swal.fire({
            title: 'Detalles de Pago',
            html: `<p style="color:#6c757d;font-size:0.875rem;margin-bottom:1rem;">Factura #${facturaId}</p>
                <div id="tablaDetallesPagoSwal" style="width:100%;"></div>`,
            width: '90%',
            showCloseButton: true,
            showCancelButton: true,
            cancelButtonText: 'Cerrar',
            showConfirmButton: false,
            customClass: { popup: 'swal-wide', htmlContainer: 'swal-no-padding' },
            didOpen: () => {
                createTable({
                    selector: '#tablaDetallesPagoSwal',
                    path: '/Carteras/GetDetallesCompra',
                    searchPlaceholder: 'Buscar en detalles...',
                    columns: [
                        { title: 'Tipo Proceso', data: 'tipo_proceso', formatter: v => v ? `<span class="tipo-proceso-badge">${v.replace('_', ' ').toUpperCase()}</span>` : '-' },
                        { title: 'Folio', data: 'folio' },
                        { title: 'Monto Pagado', data: 'monto_pago', formatter: v => Currency.format(v), className: 'text-end' },
                        { title: 'Fecha Cobro', data: 'fecha_cobro', formatter: v => dateFormatter(v), className: 'text-end' },
                        {
                            title: 'Estado', data: 'estado', className: 'text-center',
                            formatter: v => `<span class="badge-estado badge-${v}">${v.toUpperCase()}</span>`
                        }
                    ],
                    actions: [
                        { icon: 'fa-up-right-from-square', color: 'green-500', title: 'Ver Detalle', onClick: row => window.open(`/Contabilidad/ConsultarPolizas?q=${row.folio}`, '_blank') },
                    ],
                    data: () => ({ id_factura_padre: currentFacturaId }),
                });
            },
            willClose: () => { currentFacturaId = null; }
        });
    }

    /* ── Ver detalle del cliente ── */
    async function verDetalle(cliente) {
        document.getElementById('clienteNombre').textContent = cliente.n_cli || 'Cliente';
        currentClienteId = cliente.id_cliente;

        ['saldoFavor', 'montoTotal', 'saldoPendiente', 'montoPagado'].forEach(id => {
            document.getElementById(id).textContent = '-';
        });

        if (factBarChartInstance) { factBarChartInstance.destroy(); factBarChartInstance = null; }

        const tablaCarteras = createTable({
            selector: '#tablaDetalleCartera',
            path: '/Carteras/GetCarteraCliente',
            searchPlaceholder: 'Buscar en cartera...',
            columns: [
                { title: 'Tipo Proceso', data: 'tipo_proceso', formatter: v => v ? `<span class="tipo-proceso-badge">${v.replace('_', ' ').toUpperCase()}</span>` : '-' },
                { title: 'Folio Referencia', data: 'folio' },
                { title: 'Factura UUID', data: 'factura_folio', formatter: v => v ? `<div class="copy" data-copy="${v}" title="${v}">${v}</div>` : '-' },
                { title: 'Monto Total', data: 'monto_total', formatter: v => Currency.format(v), className: 'text-end' },
                {
                    title: 'Saldo Pendiente', data: 'saldo_pendiente', className: 'text-end',
                    formatter: v => `<span style="color:${v > 0 ? 'var(--warning-color)' : 'var(--success-color)'};font-weight:600;">${Currency.format(v)}</span>`
                },
                {
                    title: 'Estado', data: 'saldo_pendiente', className: 'text-center',
                    formatter: v => v === 0
                        ? '<span class="badge-estado badge-pagado">PAGADO</span>'
                        : '<span class="badge-estado badge-pendiente">PENDIENTE</span>'
                },
                { title: 'Fecha Emision', data: 'fecha_emision', formatter: v => dateFormatter(v) }
            ],
            actions: [
                { icon: 'fa-circle-info', color: 'cyan-500', title: 'Ver Detalle', onClick: row => detallesPago(row.factura_original) },
                { icon: 'fa-up-right-from-square', color: 'green-500', title: 'Ver Poliza', onClick: row => window.open(`/Contabilidad/ConsultarPolizas?q=${row.folio}`, '_blank') },
            ],
            RowsEvents: {
                onRowDblClick: row => detallesPago(row.factura_original),
                onKeyPress: (event, row) => { if (event.key === 'F4') detallesPago(row.factura_original); }
            },
            data: () => ({ clienteId: currentClienteId }),
            GlobalEvents: {
                onDataLoaded: (response) => {
                    document.getElementById('saldoFavor').textContent = Currency.format(response.totales.saldoFavor) || 0;
                    document.getElementById('montoTotal').textContent = Currency.format(response.totales.totalVendido);
                    document.getElementById('saldoPendiente').textContent = Currency.format(response.totales.totalPendiente);
                    document.getElementById('montoPagado').textContent = Currency.format(response.totales.totalVendido - response.totales.totalPendiente);

                    tablaCarteras.meta = { saldoFavor: response.totales.saldoFavor };

                    // Construir gráfico de barras por factura
                    if (response.data && response.data.length) {
                        buildFactBarChart(response.data);
                    }

                    document.querySelectorAll('.copy').forEach(div => {
                        const button = document.createElement('button');
                        button.className = 'copy-btn';
                        button.innerHTML = '<i class="fa-light fa-copy"></i>';

                        button.addEventListener('click', async () => {
                            const text = div.dataset.copy;

                            try {
                                await navigator.clipboard.writeText(text);
                                button.innerHTML = '<i class="fa-solid fa-check-double"></i>';

                                setTimeout(() => {
                                    button.innerHTML = '<i class="fa-light fa-copy"></i>';
                                }, 1500);

                            } catch (err) {
                                console.error('No se pudo copiar:', err);
                            }
                        });

                        div.appendChild(button);
                    });
                },
                onLoading: isLoading => {
                    document.querySelector('#tablaDetalleCartera').classList.toggle('opacity-50', isLoading);
                },
            },
            // rowKey: 'factura_original',
            // selectable: {
            //     enabled: true,
            //     rowKey: 'factura_original',
            //     condition: row => row.saldo_pendiente > 0,
            //     map: row => ({ CarteraIds: row.factura_original, saldo: row.saldo_pendiente }),
            //     onChange: rows => {
            //         const saldoFavor = tablaCarteras.meta?.saldoFavor ?? 0;
            //         let total = 0;
            //         rows.map(x => total += x.saldo_pendiente);
            //         document.getElementById('tablaDetalleCartera-selected').innerText = `Saldo total a saldar: ${Currency.format(total)}`;
            //         document.getElementById('saldoFavorContent').classList.remove('fa-bounce');
            //         document.getElementById('infoSaldo').classList.add('d-none');

            //         if (total > saldoFavor) {
            //             document.getElementById('saldoFavorContent').classList.add('fa-bounce');
            //             document.getElementById('infoSaldo').classList.remove('d-none');
            //             document.getElementById('saldoFavorInfo').innerText = Currency.format(saldoFavor);
            //         }
            //     }
            // }
        });

        window.tablaCarteras = tablaCarteras;
        const modal = new bootstrap.Modal(document.getElementById('modalDetalleCartera'));
        modal.show();
    }

    /* ── Saldar carteras ── */
    function saldarCarteras() {
        const factSeleccion = tablaCarteras.getSelectedRows();
        const total = factSeleccion.reduce((acc, f) => acc + f.saldo, 0);
        const saldoFavor = tablaCarteras.meta?.saldoFavor ?? 0;
        const ids = factSeleccion.map(x => x.CarteraIds);

        if (factSeleccion.length === 0) {
            _Swal.fire({ icon: 'warning', title: 'No hay facturas seleccionadas', text: 'Selecciona al menos una factura para poder saldar.', showCancelButton: false });
            return;
        }

        if (saldoFavor <= 0) {
            _Swal.fire({ icon: 'warning', title: 'No hay saldo a favor', text: 'Para saldar facturas es necesario que el cliente tenga saldo a favor.', showCancelButton: false });
            return;
        }

        const warningIcon = `<svg width="64" height="64" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" style="display:block;margin:auto;">
            <style>.flip{animation:spinY 2s linear infinite;transform-origin:center;}@@keyframes spinY{0%{transform:rotateY(0deg);}100%{transform:rotateY(360deg);}}</style>
            <g class="flip">
                <polygon points="32,4 4,60 60,60" fill="#ffc107" stroke="#ff9800" stroke-width="2"/>
                <line x1="32" y1="20" x2="32" y2="38" stroke="#000" stroke-width="4" stroke-linecap="round"/>
                <circle cx="32" cy="48" r="3" fill="#000"/>
            </g></svg>`;

        let html = `<p>¿Está seguro que desea <b>saldar las facturas seleccionadas</b> de este cliente?<br>Esta acción reducirá el saldo pendiente.</p>`;
        html += total > saldoFavor
            ? `<p>El saldo a favor es de <b>${Currency.format(saldoFavor)}</b>.<br>Solo se saldarán las facturas más antiguas hasta cubrir ese monto.</p>`
            : `<p>Se van a saldar <b>${factSeleccion.length}</b> facturas por un total de <b>${Currency.format(total)}</b>.</p>`;

        _Swal.fire({
            iconHtml: warningIcon,
            title: "Saldar Facturas",
            html,
            footer: "<b style='color:red;'>ADVERTENCIA - Este cambio no se puede revertir</b>",
            customClass: { icon: "p-0 bg-transparent border-0 shadow-none" },
            preConfirm: () => {
                Swal.fire({
                    title: 'Actualizando cartera por favor espere...',
                    allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false,
                    didOpen: () => { Swal.showLoading(); }
                });
                GetData({
                    path: "/Carteras/SaldarFacturas",
                    data: { CarteraIds: ids, ClienteId: currentClienteId },
                    swalType: 'modal', swalResponse: true, swalPath: "/Carteras/CarteraClientes"
                });
            }
        });
    }

    /* ── Limpiar modal al cerrar ── */
    document.getElementById('modalDetalleCartera').addEventListener('hidden.bs.modal', function () {
        currentClienteId = null;
        document.getElementById('saldoFavorContent').classList.remove('fa-bounce');
        document.getElementById('infoSaldo').classList.add('d-none');
        if (factBarChartInstance) { factBarChartInstance.destroy(); factBarChartInstance = null; }
    });

    /* ── Agregar abono ── */
    async function agregarAbono(e) {
        const bancos = await GetData({ path: '/Carteras/GetCuentasBancos' });
        const opcionesBancos = bancos.map(b => `<option value="${b.id}">${b.nombre}</option>`).join('');

        _Swal.fire({
            title: 'Nuevo abono',
            html: `<div style="display:flex;flex-direction:column;gap:10px;text-align:left;">
                <label>Banco</label>
                <select id="banco" class="form-control"><option value="">Seleccione un banco...</option>${opcionesBancos}</select>
                <label>Monto</label>
                <input id="monto" type="number" step="0.01" class="form-control" placeholder="Monto">
                <label>Referencia</label>
                <input id="referencia" class="form-control" placeholder="Referencia">
                <label>Comprobante de pago <span style="color:red;">*</span></label>
                <input id="comprobante" type="file" class="form-control" accept="image/*,application/pdf">
                <small style="color:#666;">Formatos aceptados: JPG, PNG, PDF (máx. 5MB)</small>
                <label>Observaciones</label>
                <textarea id="observaciones" class="form-control" placeholder="Observaciones"></textarea>
            </div>`,
            willOpen: () => { Swal.getPopup().removeAttribute('aria-hidden'); },
            focusConfirm: false, showCancelButton: true, confirmButtonText: 'Guardar',
            allowEscapeKey: false, allowOutsideClick: false,
            preConfirm: () => {
                const banco = document.getElementById('banco').value;
                const monto = document.getElementById('monto').value;
                const referencia = document.getElementById('referencia').value;
                const observaciones = document.getElementById('observaciones').value;
                const archivo = document.getElementById('comprobante').files[0];

                if (!banco) { Swal.showValidationMessage('Selecciona un banco, no seas salvaje'); return false; }
                if (!monto || monto <= 0) { Swal.showValidationMessage('Ese monto está bien sospechoso'); return false; }
                if (!archivo) { Swal.showValidationMessage('¡Órale! El comprobante es obligatorio'); return false; }
                if (archivo.size > 5 * 1024 * 1024) { Swal.showValidationMessage('El archivo pesa más que un elefante. Máximo 5MB'); return false; }

                Swal.fire({
                    title: 'Actualizando cartera por favor espere...',
                    allowOutsideClick: false, allowEscapeKey: false, showConfirmButton: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                GetData({
                    path: '/Carteras/GenerarAbono',
                    data: { banco, monto, referencia, observaciones, cliente: e.id_cliente, clave: e.cve_cli, comprobante: archivo },
                    swalResponse: true, swalPath: '/Carteras/CarteraClientes', swalType: 'modal'
                });
            }
        });
    }

    /* ── Init tabla principal ── */
    document.addEventListener("DOMContentLoaded", async () => {
        let allClientesData = [];

        const tablaClientes = createTable({
            selector: '#tablaClientes',
            path: '/Carteras/GetClientes',
            searchPlaceholder: 'Buscar cliente...',
            columns: [
                { title: 'Código', data: 'cve_cli' },
                { title: 'Nombre', data: 'n_cli', formatter: v => `<p class="limit-text" title="${v}">${v}</p>` },
                { title: 'RFC', data: 'rfc' },
                { title: 'Cuenta', data: 'codigo' },
                {
                    title: 'Saldo pendiente', data: 'saldo',
                    formatter: v => `<span style="font-weight:600;color:${v > 0 ? 'var(--warning-color)' : 'var(--success-color)'};">${Currency.format(v)}</span>`
                },
                { title: 'Saldo a favor', data: 'saldo_favor', formatter: v => v > 0 ? `<span style="color:var(--accent-blue);font-weight:600;">${Currency.format(v)}</span>` : '-' },
                {
                    title: 'Estado cobro',
                    data: null,
                    formatter: (_, row) => progressFormatter(row)
                },
            ],
            actions: [
                { icon: 'fa-circle-info', color: 'cyan-500', title: 'Ver Detalle', onClick: row => verDetalle(row) },
                { icon: 'fa-light fa-abacus', color: 'sky-600', title: 'Agregar Abono', onClick: row => agregarAbono(row) }
            ],
            RowsEvents: {
                onRowDblClick: row => verDetalle(row),
                onKeyPress: (event, row) => { if (event.key === 'F4') verDetalle(row); }
            },
            GlobalEvents: {
                onDataLoaded: (response) => {
                    document.getElementById('total-clientes').textContent = response.total;
                    document.getElementById('saldo_cobrar').textContent = Currency.format(response.saldoCobrar);

                    // Guardar datos para gráficos
                    allClientesData = response.data || [];

                    // Calcular totales para dona
                    const totalPendiente = allClientesData.reduce((a, c) => a + (c.saldo || 0), 0);
                    const totalPagado = allClientesData.reduce((a, c) => a + (c.total_pagado || 0), 0);
                    const totalFavor = allClientesData.reduce((a, c) => a + (c.saldo_favor || 0), 0);

                    buildDonutChart(totalPendiente, totalPagado, totalFavor);
                    buildBarTopChart(allClientesData);
                },
                onLoading: isLoading => {
                    document.querySelector('#tablaClientes').classList.toggle('opacity-50', isLoading);
                },
                onError: err => { alert('Error al cargar los datos: ' + err.message); }
            },
        });

        window.tablaClientes = tablaClientes;
    });
</script>