@{
    ViewBag.Title = "CarteraClientes";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    /* ── Métricas ── */
    .metrics-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
        gap: 10px;
        margin-bottom: 16px;
    }

    .metric-pill {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 14px 16px;
        display: flex;
        align-items: center;
        gap: 12px;
        box-shadow: var(--shadow);
        transition: transform 0.18s, box-shadow 0.18s;
    }

        .metric-pill:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow-lg);
        }

    .metric-pill-icon {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.1rem;
        flex-shrink: 0;
    }

        .metric-pill-icon.blue {
            background: rgba(59,130,246,0.1);
            color: var(--accent-blue);
        }

        .metric-pill-icon.green {
            background: rgba(5,150,105,0.1);
            color: var(--success-color);
        }

        .metric-pill-icon.orange {
            background: rgba(217,119,6,0.1);
            color: var(--warning-color);
        }

        .metric-pill-icon.purple {
            background: rgba(147,51,234,0.1);
            color: #9333ea;
        }

    .metric-pill-body {
        flex: 1;
        min-width: 0;
    }

    .metric-pill-label {
        font-size: 0.75rem;
        color: var(--text-light);
        font-weight: 500;
        margin-bottom: 2px;
    }

    .metric-pill-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: var(--text-dark);
        line-height: 1.2;
    }

    /* ── Charts header ── */
    .charts-header-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .chart-mini-card {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
        border-radius: 12px;
        padding: 14px 16px;
        box-shadow: var(--shadow);
    }

    .chart-mini-title {
        font-size: 0.75rem;
        font-weight: 600;
        color: var(--text-light);
        margin-bottom: 10px;
        text-transform: uppercase;
        letter-spacing: 0.04em;
    }

    .legend-row {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 10px;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 5px;
        font-size: 0.7rem;
        color: var(--text-light);
    }

    .legend-dot {
        width: 8px;
        height: 8px;
        border-radius: 2px;
        flex-shrink: 0;
    }

    /* ── Content Card ── */
    .content-card {
        background: var(--bg-light);
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: var(--shadow);
        border: 1px solid var(--border-light);
    }

    .limit-text {
        width: 300px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* ── Progress bar in table ── */
    .progress-bar-wrap {
        width: 80px;
        height: 5px;
        background: var(--border-light);
        border-radius: 3px;
        overflow: hidden;
        display: inline-block;
        vertical-align: middle;
    }

    .progress-bar-fill {
        height: 100%;
        border-radius: 3px;
    }

    /* ── Modal ── */
    .modal-subtitle {
        margin: 0;
        font-size: 0.875rem;
        color: var(--text-light);
        font-weight: 400;
    }

    .modal-content {
        background: var(--bg-light);
        border: 1px solid var(--border-light);
    }

    .modal-header {
        border-bottom: 1px solid var(--border-light);
        background: var(--bg-gray);
    }

    .modal-footer {
        border-top: 1px solid var(--border-light);
        background: var(--bg-gray);
    }

    .btn-close {
        filter: var(--bs-btn-close-filter, invert(1));
    }

    [data-theme="dark"] .btn-close {
        filter: invert(0);
    }

    /* ── Cartera summary ── */
    .cartera-summary {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
        gap: 10px;
        margin-bottom: 1.25rem;
    }

    .summary-card {
        background: var(--bg-gray);
        border-radius: 8px;
        padding: 0.9rem 1rem;
        display: flex;
        align-items: center;
        gap: 10px;
        border: 1px solid var(--border-light);
    }

    .summary-icon {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1rem;
        flex-shrink: 0;
    }

        .summary-icon.blue {
            background: rgba(59,130,246,0.1);
            color: var(--accent-blue);
        }

        .summary-icon.green {
            background: rgba(5,150,105,0.1);
            color: var(--success-color);
        }

        .summary-icon.orange {
            background: rgba(217,119,6,0.1);
            color: var(--warning-color);
        }

        .summary-icon.purple {
            background: rgba(147,51,234,0.1);
            color: #9333ea;
        }

    .summary-label {
        font-size: 0.7rem;
        color: var(--text-light);
        font-weight: 500;
        margin-bottom: 2px;
    }

    .summary-value {
        font-size: 1.15rem;
        font-weight: 700;
        color: var(--text-dark);
    }

    /* ── Fact progress chart card ── */
    .fact-progress-card {
        background: var(--bg-gray);
        border: 1px solid var(--border-light);
        border-radius: 8px;
        padding: 12px 14px;
        margin-bottom: 1rem;
    }

    .fact-progress-label {
        font-size: 0.7rem;
        font-weight: 600;
        color: var(--text-light);
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 8px;
    }

    /* ── Badges ── */
    .badge-estado {
        padding: 0.2rem 0.6rem;
        border-radius: 10px;
        font-size: 0.7rem;
        font-weight: 600;
        display: inline-block;
    }

    .badge-pagado {
        background: rgba(5,150,105,0.1);
        color: var(--success-color);
    }

    .badge-cobrado {
        background: rgba(5,150,105,0.1);
        color: var(--success-color);
    }

    .badge-pendiente {
        background: rgba(217,119,6,0.1);
        color: var(--warning-color);
    }

    .badge-parcial {
        background: rgba(59,130,246,0.1);
        color: var(--accent-blue);
    }

    .tipo-proceso-badge {
        padding: 0.2rem 0.5rem;
        border-radius: 4px;
        font-size: 0.7rem;
        font-weight: 500;
        background: var(--bg-gray);
        color: var(--text-dark);
        display: inline-block;
    }

    .uuid-text {
        font-family: 'Courier New', monospace;
        font-size: 0.75rem;
        color: var(--text-light);
        max-width: 220px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        display: inline-block;
    }

    /* ── Saldo warning ── */
    .cartera-table-wrapper {
        background: var(--bg-light);
        border-radius: 8px;
        border: 1px solid var(--border-light);
        padding: 1rem;
    }

    /* ── SweetAlert tabla ── */
    .swal-wide {
        max-width: 1200px !important;
    }

    .swal-no-padding .swal2-html-container {
        padding: 0 !important;
        margin: 0 !important;
        overflow: visible !important;
    }

    #tablaDetallesPagoSwal {
        width: 100%;
        min-height: 400px;
    }

    .swal2-popup #tablaDetallesPagoSwal .cartera-table-wrapper {
        background: transparent;
        border: none;
        padding: 0;
    }

    .swal2-html-container {
        max-height: 70vh;
        overflow-y: auto;
    }

    @@keyframes shake {
        0%, 100% {
            transform: translateX(0);
        }

        10%, 30%, 50%, 70%, 90% {
            transform: translateX(-10px);
        }

        20%, 40%, 60%, 80% {
            transform: translateX(10px);
        }
    }

    .shake-element {
        animation-name: shake;
        animation-duration: 0.5s;
        animation-iteration-count: infinite;
    }

    /* ── Responsive ── */
    @@media (max-width: 768px) {
        .charts-header-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

